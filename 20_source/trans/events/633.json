[
 {
  "key": "m0",
  "kind": 0,
  "chr": 8,
  "jh": "826099947a3f",
  "ko": "어라? 없나? 젠장, 하필 이럴 때…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 12,
  "jh": "d46db877c0fa",
  "ko": "이 몸이라면 여기 있다"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 9,
  "jh": "804c151a6eb1",
  "ko": "매번 이상하게 등장하는군"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 12,
  "jh": "6f0a1b5efeae",
  "ko": "갑자기 방에 들이닥쳐서 그만 숨어 버렸을 뿐이다"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 12,
  "jh": "53cfd95e1de8",
  "ko": "그래서 이 몸에게 무슨 볼일이냐?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 8,
  "jh": "ecd9e3557654",
  "ko": "아, 맞다. 당신 기계검 갖고 있지? 보여 줘!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 12,
  "jh": "939441740593",
  "ko": "호오, 기계검에 관심이 있나"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 8,
  "jh": "48f5911e5616",
  "ko": "아아. 한번 보고 싶었어. 언젠가 내가 직접 만들어 보고 싶고"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 12,
  "jh": "b7650d704187",
  "ko": "흠… 기계검이라면 저기 놓여 있다. 마음껏 봐라"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 8,
  "jh": "9160374a96b3",
  "ko": "오오오, 이게… 대단해! 진짜다!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "d25a9c53710a",
  "ko": "엄청 들떴네… 꼴사나워"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 6,
  "jh": "67d9a22be028",
  "ko": "아직 애네, 형은"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 8,
  "jh": "28f2a347b715",
  "ko": "그렇구나, 구동부가 이렇게 이어져서… 이러면 회전수를 올리면 그만큼 파괴력도…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 8,
  "jh": "033789a84252",
  "ko": "있잖아, 이거 손잡이 안은 어떻게 돼 있어? 분해해도 돼?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 12,
  "jh": "b435b7bb8e92",
  "ko": "분해는 곤란하다. 이 몸으로는 원래대로 못 돌려놓는다"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 9,
  "jh": "2ddc9219dcde",
  "ko": "오야, 네가 만든 게 아닌가?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 12,
  "jh": "14620f97cf95",
  "ko": "어느 정도는 직접 만들 수 있지만 이건 특주품이라서"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 8,
  "jh": "74de3f2b94f3",
  "ko": "특주? 그래도 요즘 기계검 만드는 녀석 같은 건…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 12,
  "jh": "1c40ec6264a8",
  "ko": "이 몸 정도 되면 전속 무기 장인 한둘쯤은 데리고 있는 법이다"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 8,
  "jh": "61abd0208824",
  "ko": "진짜냐… 그럼 그 사람 만나게 해 줘! 이것저것 물어보고 싶어"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 12,
  "jh": "d504b363f6e7",
  "ko": "물어봐 줄 수는 있다만 놈이 까다로워서. 순순히 만나 줄지…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 8,
  "jh": "fcd016d74632",
  "ko": "거기를 어떻게 좀! 응?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 12,
  "jh": "36258991e37c",
  "ko": "좋아. 그렇다면 시험을 하나 내 주마"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 12,
  "jh": "e1aad45f4a41",
  "ko": "이걸 만들어 와라"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 8,
  "jh": "5d8a86e0cbd2",
  "ko": "뭐야 이거? 기계 부품… 인가? 그런 것치곤 꽤 특수한…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 12,
  "jh": "aa677eaf2a11",
  "ko": "기계검을 만들기 위한 부품이다. 그 외의 용도는 없다만"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 8,
  "jh": "ebfc33cd17e2",
  "ko": "기계검의? 아아, 그렇구나! 이게 불규칙 회전해서 칼날 전체에 진동을… 중얼중얼"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 2,
  "jh": "6203da6a667a",
  "ko": "또 시작됐다… 수상한 사람 같아"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "3dfa21b72bc5",
  "ko": "자, 이런 데서 생각에 잠기지 마. 나중에 해"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 12,
  "jh": "4ff87565b5b6",
  "ko": "…자, 쓸 만한 남자면 좋겠다만. 개발 부문은 인재가 부족하니까"
 },
 {
  "key": "m30",
  "kind": 5,
  "chr": -1,
  "jh": "fd304d1d0b37",
  "ko": "레시피 『{CLGR}군나르 비밀 메모{CLNR}』를 손에 넣었습니다."
 },
 {
  "key": "m31",
  "kind": 5,
  "chr": -1,
  "jh": "3eeb765a2b30",
  "ko": "『{CLGR}블레이드 모터{CLNR}』를 조합할 수 있게 되었습니다."
 },
