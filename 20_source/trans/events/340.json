[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "af198dc97c68",
  "ko": "초조초조… 안절부절…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "453bca9d1083",
  "ko": "좀 진정해…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "05d37babb285",
  "ko": "진정 못 해! 아아 정말, 이러는 동안에도 우류가…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "ce1d4bafef27",
  "ko": "그 여자한테 안 잡혔을까. 몹쓸 짓 안 당했을까… 아아아아…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 8,
  "jh": "c85cff99ccd6",
  "ko": "무슨 말을 해도 소용없네…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 2,
  "jh": "0ed4a11b7f95",
  "ko": "짜증 나… 강제로 진정시킬 수밖에…"
 },
 {
  "key": "m6",
  "kind": 5,
  "chr": 6,
  "jh": "0d84cefa96be",
  "ko": "기다렸지! 늦어서 미안해~!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "0fa70e888d14",
  "ko": "페페론! 늦었잖아!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 8,
  "jh": "0e6c02be71c3",
  "ko": "뭐야, 멀쩡하잖아. 짜증 날 만큼"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 2,
  "jh": "8b2721704934",
  "ko": "걱정해서 손해 봤어…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 6,
  "jh": "2683f6324a14",
  "ko": "어, 어라~? 생각만큼 환영 분위기가 아니네…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "ac5659c90c50",
  "ko": "그래서, 그 녀석은 어떻게 됐어?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 6,
  "jh": "00eb6b5d2b98",
  "ko": "당연히 녹아웃시키고 왔지! 울면서 사과해서 용서해 줬지만"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "2757f55a5e21",
  "ko": "…거짓말 같은데"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 8,
  "jh": "b3c0e1d98055",
  "ko": "…거짓말 같은데"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 2,
  "jh": "bfc1565d3ead",
  "ko": "…거짓말이면 화낼 거야?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 6,
  "jh": "63b51dac54c6",
  "ko": "죄송합니다. 구사일생으로 도망쳐 왔습니다. 이길 것 같지 않았습니다"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "7350140304e1",
  "ko": "처음부터 그렇게 말하면 되잖아. …뭐, 무사해서 다행이야. 네 덕분에 살았고"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 6,
  "jh": "28d9f1e67f77",
  "ko": "당연한 일을 했을 뿐이야. 이 몸은 유능한 요정 씨니까!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "7477cd95d6cb",
  "ko": "자, 이제 고토만 돌아오면…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 8,
  "jh": "385400c5380e",
  "ko": "그러네. 지금 이것저것 준비해 둘까"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "f21aba728cd4",
  "ko": "어, 어라라? 이번엔 화려하게 무시야?"
 },
 {
  "key": "m22",
  "kind": 5,
  "chr": 9,
  "jh": "fe46a3f8993e",
  "ko": "착하지 착하지. 안아서 달래 주고 싶지만 공교롭게도 지금은 이 몸이라서"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "98e9ef9c4433",
  "ko": "호랑이도 제 말 하면 온다더니…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "441fa539596a",
  "ko": "돌아왔다! 기다렸어. 우류는 찾았어!?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 6,
  "jh": "89b9d7b560bd",
  "ko": "빨간 공이라도 괜찮아! 이 몸은 너의 몸이 아니라 상냥함에 안기고 싶은 거야!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 9,
  "jh": "85889e2a9337",
  "ko": "그렇다면 사양할 거 없지. 자, 뛰어들어 와!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "21d19ccec7d4",
  "ko": "아아아아! 장난칠 때가 아니잖아!! 우류는!? 찾았어!?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 9,
  "jh": "3d546f547552",
  "ko": "그렇게 재촉하지 말아 줘. 아무튼 한 번 몸으로 돌아가고 나서… 어라, 내 몸은?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 8,
  "jh": "2988360f3666",
  "ko": "두고 왔지 당연히. 그런 걸 옮길 여유 없었다고"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 2,
  "jh": "e2527014d5e8",
  "ko": "묘하게 냄새났으니까 만지기 싫었어…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 9,
  "jh": "a54387b6d5fb",
  "ko": "냄새났다…? 아아, 그렇군. 향수 취향이 안 맞았구나"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 2,
  "jh": "35c3a168edbf",
  "ko": "긍정적으로 해석했어… 짜증 나…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "747b8ac568f8",
  "ko": "…있잖아. 적당히 안 하면… 진~~~짜로 화낼 거야?"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 9,
  "jh": "0e8428330005",
  "ko": "아, 죄송합니다. 분위기를 누그러뜨리려고 했는데…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 9,
  "jh": "93c6200c962a",
  "ko": "그래서 아가씨의 마나 말인데, 지저 유적이라고 불리는 곳으로 도망친 모양이야"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 1,
  "jh": "652b32f4ae7d",
  "ko": "들어 본 적 없는 곳이네… 어디 있어?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 9,
  "jh": "05895d42f1a7",
  "ko": "그건 내가 안내할 테니 걱정 마. 다만 그 전에…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 1,
  "jh": "32a39eda596b",
  "ko": "그 전에?"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 9,
  "jh": "83f28c67371d",
  "ko": "몸을 가져올게. 이 공도 나쁘지 않지만 오래 들어가 있으면 눈이 돌아서"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 1,
  "jh": "a7921d04faf2",
  "ko": "5분 안에 가져와!"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 9,
  "jh": "145bb720fce9",
  "ko": "무리한 소리를… 뭐, 노력해 볼게"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 1,
  "jh": "bd5dac469daf",
  "ko": "아아, 정말… 언제쯤 출발할 수 있는 거야!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]