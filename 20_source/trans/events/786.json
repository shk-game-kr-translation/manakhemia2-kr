 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 20,
  "jh": "f80d3b0f9dee",
  "ko": "야, 거기 너. 평소에 장비는 어디서 구하냐?"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 81,
  "jh": "4050a3d73622",
