 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "ad59dfd86f24",
  "ko": "아무것도 안 했거든! 실례야!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 20,
  "jh": "3c99af22f2d2",
  "ko": "자자, 싸우면 안 돼. 그럼 시험 내용을 발표할게~"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 6,
  "jh": "771c9a305d42",
  "ko": "여기까진 대성공이네. 좋아, 아틀리에로 돌아가자. 너를 다들한테 소개해야지"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 35,
  "jh": "ffbf19db09e1",
