 {
  "key": "m28",
  "kind": 2,
  "chr": 11,
  "jh": "8177ca738b99",
  "ko": "아가씨가 퇴학이라니… 저, 주인어른께 뭐라고 변명해야 할지!?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 3,
  "jh": "5cc539d91253",
  "ko": "곧이곧대로 듣지 마! 뭔가 잘못된 게 뻔하잖아!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "d31b8c92914a",
