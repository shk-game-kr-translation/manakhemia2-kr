[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "03dcd7331999",
  "ko": "자, 오늘은 뭐 하고 놀까"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 10,
  "jh": "462e025f0e9d",
  "ko": "우~! 우~!"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 20,
  "jh": "6b85cfdf1ba7",
  "ko": "야, 기다려"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "ad32b17abf6c",
  "ko": "아, 선생님. 뭐예요?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 20,
  "jh": "9ed6f544642b",
  "ko": "너, 요즘 수업 제대로 듣고 있냐?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "ea7c11576708",
  "ko": "드, 듣고 있어요. 아이참, 그런…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 20,
  "jh": "9fe661d77449",
  "ko": "네 성적 꽤 위험하다. 이대로면 퇴학도 어쩔 수 없는 수준이야"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 20,
  "jh": "d1e20a3bf69a",
  "ko": "만약 그렇게 되면 창피당하는 건 담임인 나다… 그 점은 이해하고 있겠지?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "eba6ee8f2524",
  "ko": "무, 물론이죠! 봐요, 곧 기말고사잖아요? 거기서 만회할게요!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 20,
  "jh": "324525a5f4ea",
  "ko": "곧이라기보단 내일부터다만. 뭐, 거기까지 장담했으니"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 20,
  "jh": "e5be1474f018",
  "ko": "결과를 기대해 두지. …형편없는 성적 받으면 각오해 둬라"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 1,
  "jh": "0b004bb93170",
  "ko": "꽤 화났었네… 지금부터 공부해서 어떻게 될까…"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 6,
  "jh": "d33bff1f8f91",
  "ko": "누나의 위기다… 여기선 요정 씨인 이 몸이 어떻게든 해야지!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 35,
  "jh": "07dc0d1199ae",
  "ko": "어떻게든이라니, 어쩔 생각이야?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 6,
  "jh": "74a5e4a65957",
  "ko": "일단 그 선생님을 꽁꽁 묶어서 기억이 없어질 때까지 두들겨 패서…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 35,
  "jh": "3c93b68643ed",
  "ko": "스마트하지 않은 방법이군"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 6,
  "jh": "33b39ec6c96d",
  "ko": "그럼 달리 어떻게… 잠깐, 넌!? 드디어 와 줬구나!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 35,
  "jh": "30d750451f23",
  "ko": "오랜만이야. 그게, 페페론이라고 부르면 될까?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 6,
  "jh": "b2783bf3db40",
  "ko": "더 애정을 담아서 펫큥이라고 불러 줘도 상관없어"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 35,
  "jh": "765a3ee7d09d",
  "ko": "그건 정중히 사양할게. 그나저나 분위기가 꽤 바뀌었네, 넌"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "5f296d476b53",
  "ko": "그렇지. 마지막으로 만난 건 이 몸이 요정 씨가 되기 전이었으니까…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 35,
  "jh": "6600d96bfad7",
  "ko": "훌륭한 요정 씨가 돼서 안심했어. 겉모습도 말투도"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 6,
  "jh": "72a1df7ebf17",
  "ko": "에헤헤, 쑥스럽네"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 35,
  "jh": "9f0cf1af9f9f",
  "ko": "…그래서, 저 아가씨야? 네가 날 부른 이유는"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 6,
  "jh": "12fbcf1bd846",
  "ko": "응. 지금은 저 누나네서 일하고 있어"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 35,
  "jh": "54059e727f29",
  "ko": "흐응. 아직 어리지만 2, 3년 지나면 멋진 레이디가 될 것 같네"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 6,
  "jh": "53e46ff0c282",
  "ko": "아, 안 돼! 누나한테 손대면"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 35,
  "jh": "788b87f7f8a5",
  "ko": "이쪽에서 손댈 생각은 없지만 저쪽이 마음먹으면 보장 못 하지"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "977f497c9b4a",
  "ko": "으으, 있을 법하네. 넌 멋있고 댄디하니까…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 35,
  "jh": "e55ae8b0d19a",
  "ko": "뭐, 그 걱정은 나중에 하자. 우선 눈앞의 문제를 어떻게든 해야지"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 6,
  "jh": "cf6855792795",
  "ko": "도와주는 거야?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 35,
  "jh": "ecb53609863d",
  "ko": "그래, 너 혼자 맡겼다간 유혈 사태가 날 테니까. 일단 자세한 얘기를…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]