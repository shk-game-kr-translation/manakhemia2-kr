[
 {
  "key": "m0",
  "kind": 0,
  "chr": 0,
  "jh": "0cbcc9a8c4fd",
  "ko": "여긴가…? 그 녀석은 어디에…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 11,
  "jh": "0b0f53d172c1",
  "ko": "로제 씨, 저기…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 0,
  "jh": "b0baf0ecb99d",
  "ko": "자고 있잖아…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 4,
  "jh": "cfc9cd72b1a1",
  "ko": "어쩌지? 수단을 가리지 않는다면 지금 덮치는 것도…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "16fe6c221a7f",
  "ko": "기각이야. 이 내가 그런 염치없는 짓을 할 수 있을 리가 없잖아"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 5,
  "jh": "308f889868c2",
  "ko": "푸니니~…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 23,
  "jh": "6bcd8fd55d41",
  "ko": "여럿이서 싸움 걸러 온 시점에서 좀 그렇지 않나… 라고 여동생이 갸웃해요"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 3,
  "jh": "ed623020b5c0",
  "ko": "괘, 괜찮아, 그건! 로제가 혼자선 못 이긴다니까!"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 14,
  "jh": "544916522f06",
  "ko": "응… 후아아. 시끄럽네… 누구야?"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 0,
  "jh": "be969473591b",
  "ko": "…여"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 14,
  "jh": "79fc10571d36",
  "ko": "응…? 어라. 일부러 뭐 하러 왔어? 나한테 당하러?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "97c58f4a221f",
  "ko": "널 쓰러뜨리러 왔다"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 14,
  "jh": "81c222299b0d",
  "ko": "네? 어? 아, 아아! 새로운 농담인가!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 14,
  "jh": "14a5bab32182",
  "ko": "미안 미안, 몰랐어. 재밌어! 응, 엄청 재밌어"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 4,
  "jh": "c1aa08ac1acd",
  "ko": "불쾌한 남자군. 이것도 마음의 마나 영향인가?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 0,
  "jh": "c07fffbda006",
  "ko": "글쎄, 원래 장난스러운 남자니까… 미안하지만 이쪽은 아주 진지해"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 14,
  "jh": "3b185ef474b2",
  "ko": "아주 진지? 하하하! 그거 더 재밌네!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 14,
  "jh": "99c28649b28a",
  "ko": "무리인 게 뻔하잖아. 아까 처참하게 진 거 벌써 잊었어?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 0,
  "jh": "f82cd7fadf8d",
  "ko": "잊을 리가 없지. 그래서 동료를 데려왔다… 한심한 얘기지만"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "98cead916ea5",
  "ko": "어떻게든 당신을 날려 버려야 한다는군"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 5,
  "jh": "94aa2dfe460d",
  "ko": "푸니, 푸니니~!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 23,
  "jh": "e3efe87c619d",
  "ko": "푸니요는 로제 씨보다 훨씬 강하다! 라고 여동생이 주장하고 있어요"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 7,
  "jh": "c3098d54eede",
  "ko": "아~ 치사해! 푸니요. 그럼 나는 푸니요보다 강해!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 4,
  "jh": "e75b1fb1574c",
  "ko": "너희는 끼어들지 마라"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 14,
  "jh": "6d7fd6d26885",
  "ko": "흐응. 그 인원이면 나한테 이긴다고?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "32ec39b8ebe4",
  "ko": "…솔직히 이걸로도 아슬아슬하겠지"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 14,
  "jh": "376020cf6884",
  "ko": "아슬아슬, 이라. 알면서. 질 가능성이 더 높다는 거"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "9c790b93b103",
  "ko": "영감한테 부탁받아 버렸으니까. 게다가 개인적으로도 널 한 대 패 주고 싶어"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 14,
  "jh": "848b71b9d2ea",
  "ko": "…왠지 좋은 눈이 됐네. 요 1년 내내 가라앉은 눈이었는데…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 14,
  "jh": "0a8865c165e6",
  "ko": "후후, 좋아 좋아. 점점 즐거워졌어!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 0,
  "jh": "2981555ecfdf",
  "ko": "널 즐겁게 하는 건 본의가 아니다만"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 14,
  "jh": "ba7c3b4dcb4b",
  "ko": "…나 말이야, 이상해. 그 마나를 벤 뒤로"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 14,
  "jh": "3a8ce8d83a08",
  "ko": "마음뿐만 아니라 몸까지… 나도 잘 모르는 힘이 솟아나…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 14,
  "jh": "506d97b1d9fd",
  "ko": "뭐라고 하면 좋을까… 간단히 말하면 전보다 훨씬 강해져 버렸어"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 14,
  "jh": "d8916f12ffd4",
  "ko": "어때? 그래도 아슬아슬하게 이길 수 있다고 말할 수 있어?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 0,
  "jh": "cf3da2aa5b7d",
  "ko": "그런가. 그럼 이쪽도 인원수에 미안해할 필요는 없겠군"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 14,
  "jh": "3e648072331b",
  "ko": "허세도 부릴 줄 알게 됐네. 응, 재밌어. 그런데 그만큼 화도 나"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 0,
  "jh": "90534653ff57",
  "ko": "뭐?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 14,
  "jh": "86cbd8302ca5",
  "ko": "넌 아직 얼마든지 강해질 수 있는데 이렇게 약할 때 승부를 걸어오다니…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 14,
  "jh": "a9db6aeccad4",
  "ko": "모처럼 한동안은 내버려 두려고 했는데… 그런데…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 14,
  "jh": "46bc005cefed",
  "ko": "왜일까? 넌 내 즐거움을 뺏기만 해… 나한테 무슨 원한이라도 있어!?"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 3,
  "jh": "02c1ba14bac8",
  "ko": "미쳤네… 아까부터 말이 엉망진창이야"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 11,
  "jh": "a102067af314",
  "ko": "로제 씨도 한 발짝 잘못했으면 저렇게 됐을까요…?"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 0,
  "jh": "e182851e7bc4",
  "ko": "글쎄…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 0,
  "jh": "61d2e7ab0f30",
  "ko": "뭐, 내 주변엔 억지로 제정신으로 돌려놓는 오지랖쟁이가 몇 명 있었지만…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 3,
  "jh": "8c5101296a6f",
  "ko": "어머, 그건 누구 얘기니?"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 0,
  "jh": "2489934ee40c",
  "ko": "글쎄요… 자, 시작할까. 이쪽은 네 즐거움 따위 알 바 아니야"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 0,
  "jh": "cc68e98dacd4",
  "ko": "이런 시시한 일, 얼른 끝내 주마"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 14,
  "jh": "d40612795307",
  "ko": "쉽게는 안 끝내 줄 거야…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 14,
  "jh": "0d2fb94bc171",
  "ko": "네 할아버지처럼 천천히 듬뿍 괴롭혀 줄게!"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 14,
  "jh": "0ef2acb00f72",
  "ko": "…놀랐어. 아까보다 훨씬 강해졌잖아…"
 },
 {
  "key": "m51",
  "kind": 0,
  "chr": 0,
  "jh": "490dfb82aa15",
  "ko": "그러는 당신은 꽤 여유롭군. 이쪽은 필사적인데"
 },
 {
  "key": "m52",
  "kind": 0,
  "chr": 14,
  "jh": "12e122fbfde3",
  "ko": "그렇지도 않아. 이런 얼굴이라 알기 어려울지도 모르지만…"
 },
 {
  "key": "m53",
  "kind": 0,
  "chr": 14,
  "jh": "13d747cbcdd4",
  "ko": "…무섭다고 느끼고 있어. 지는 게 아닐까 하고"
 },
 {
  "key": "m54",
  "kind": 0,
  "chr": 0,
  "jh": "2a6a34cfaa5a",
  "ko": "이겨 주지, 반드시"
 },
 {
  "key": "m55",
  "kind": 0,
  "chr": 14,
  "jh": "c521d4ca842e",
  "ko": "아쉽네… 네가 이기든 내가 이기든 끝나 버리니까…"
 },
 {
  "key": "m56",
  "kind": 0,
  "chr": 14,
  "jh": "0fdec0af0015",
  "ko": "이렇게 즐거운데… 아아, 좀 더 제정신일 때 싸울 수 있었으면…"
 },
 {
  "key": "m57",
  "kind": 0,
  "chr": 0,
  "jh": "78578f3f1857",
  "ko": "응…? 너, 제정신으로 돌아왔나?"
 },
 {
  "key": "m58",
  "kind": 0,
  "chr": 14,
  "jh": "e1b26442d80c",
  "ko": "글쎄. 난 원래 어딘가 미쳐 있는 것 같으니까. 사람으로서"
 },
 {
  "key": "m59",
  "kind": 0,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m60",
  "kind": 0,
  "chr": 14,
  "jh": "ebb1f2b2a659",
  "ko": "아아, 미안. 싸우는 중에 수다라니 흥이 깨지지"
 },
 {
  "key": "m61",
  "kind": 0,
  "chr": 14,
  "jh": "dc4dd00f208b",
  "ko": "계속하자. 그리고… 끝내자"
 },
 {
  "key": "m62",
  "kind": 0,
  "chr": 0,
  "jh": "6bfa39031f24",
  "ko": "그래!"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 14,
  "jh": "0972a25a27ce",
  "ko": "졌다… 졌, 구나…"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 0,
  "jh": "46b6509af83b",
  "ko": "후우… 하아…"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 14,
  "jh": "ef45b417ac54",
  "ko": "…분하다. 지면 이런 기분이 드는구나…"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 14,
  "jh": "0d813513bdc0",
  "ko": "아아… 10년 전에 이런 싸움을 할 수 있었다면…"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 0,
  "jh": "2309a3ed6ffd",
  "ko": "영감이었다면 틀림없이 당신을 이겼을 거야"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 14,
  "jh": "dcc66b40f5b2",
  "ko": "너도 이겼잖아… 방금…"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 0,
  "jh": "ae893976426f",
  "ko": "내가 당신을 이긴 게 아니잖아"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 14,
  "jh": "8af53c2aa969",
  "ko": "그런가… 그럼 말이야, 내가 또 너랑 싸우고 싶다고 하면 어떡할래…?"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 0,
  "jh": "5c0f9f56adfb",
  "ko": "사양이다… 당분간은"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 14,
  "jh": "5f49efbc6b92",
  "ko": "당분간은, 이구나… 그럼 한동안 수행해서 더 강해지면 그때…"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 0,
  "jh": "d190d9eeca55",
  "ko": "아직도 강해질 셈이냐… 봐줘라…"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 14,
  "jh": "ce6184f0bbaf",
  "ko": "아아… 기대된다. 정말로………"
 },
 {
  "key": "m75",
  "kind": 2,
  "chr": 4,
  "jh": "200ade979dc5",
  "ko": "정신을 잃었군"
 },
 {
  "key": "m76",
  "kind": 2,
  "chr": 3,
  "jh": "58bc5d500f82",
  "ko": "괜찮겠어? 그런 말 해서… 또 쫓아다닐 거야?"
 },
 {
  "key": "m77",
  "kind": 2,
  "chr": 0,
  "jh": "45514e3efc18",
  "ko": "…이런 걸로 이기고 튀면 너무 한심하니까요"
 },
 {
  "key": "m78",
  "kind": 2,
  "chr": 3,
  "jh": "85434ddc2293",
  "ko": "그렇지도 않아. 그… 아주 조금은 멋있었다거나…"
 },
 {
  "key": "m79",
  "kind": 2,
  "chr": 11,
  "jh": "2e5e372199a2",
  "ko": "이 사람, 치료 같은 거 안 해도 괜찮을까요"
 },
 {
  "key": "m80",
  "kind": 2,
  "chr": 0,
  "jh": "a118e9e0570e",
  "ko": "이 정도로 뻗을 녀석이 아니잖아… 치료가 필요한 건 이쪽이야…"
 },
 {
  "key": "m81",
  "kind": 0,
  "chr": 7,
  "jh": "2e2a4852cad1",
  "ko": "앗, 위험해!"
 },
 {
  "key": "m82",
  "kind": 0,
  "chr": 5,
  "jh": "ee00abd1cc2f",
  "ko": "푸니!"
 },
 {
  "key": "m83",
  "kind": 0,
  "chr": 0,
  "jh": "c80b27edb29f",
  "ko": "아아, 미안…"
 },
 {
  "key": "m84",
  "kind": 2,
  "chr": 7,
  "jh": "58e9c8705c69",
  "ko": "정말. 칠칠치 못하네~ 이 정도로"
 },
 {
  "key": "m85",
  "kind": 2,
  "chr": 0,
  "jh": "17d6793acd89",
  "ko": "…왜 너희는 멀쩡한 거야"
 },
 {
  "key": "m86",
  "kind": 2,
  "chr": 5,
  "jh": "94aa2dfe460d",
  "ko": "푸니, 푸니니~!"
 },
 {
  "key": "m87",
  "kind": 2,
  "chr": 23,
  "jh": "3db7c0aa9699",
  "ko": "로제 씨와는 평소 단련이 다르다! 라고 여동생이 가슴을 펴고 있어요"
 },
 {
  "key": "m88",
  "kind": 2,
  "chr": 0,
  "jh": "c69dc52edd14",
  "ko": "…한심하군. 정말로… 난 아직 멀었어…"
 },
 {
  "key": "m89",
  "kind": 2,
  "chr": 3,
  "jh": "9192e9c1aad8",
  "ko": "돌아가면 너도 수행이 필요하겠네. 나의… 나, 남편은 좀 과했나…"
 },
 {
  "key": "m90",
  "kind": 2,
  "chr": 3,
  "jh": "6123798d09c1",
  "ko": "시종에 걸맞게 강해져 줘야겠어!"
 },
 {
  "key": "m91",
  "kind": 2,
  "chr": 11,
  "jh": "92cfd8e4c559",
  "ko": "저기… 로제 씨도 기절해서 못 들으시는 것 같은데요…"
 },
 {
  "key": "m92",
  "kind": 2,
  "chr": 7,
