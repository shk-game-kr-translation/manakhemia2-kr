  "jh": "9d7786340342",
  "ko": "있다 있어. 어이, 푸니요"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 5,
  "jh": "8b86926363e7",
  "ko": "푸니?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 23,
  "jh": "3517e0af7315",
  "ko": "푸니~! 푸니푸니!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "0fef091bf60c",
  "ko": "으, 아차. 무슨 말인지 모르겠어…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 2,
  "jh": "f5c1d2a88516",
  "ko": "그랬지… 그럼 울리카는 저쪽 가 있어. 방해되니까…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "1a75f729a5cd",
  "ko": "으으… 왠지 굴욕. 푸니푸니 말 모르는 것뿐인데…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 6,
  "jh": "32091bdde178",
  "ko": "자자, 기운 내. 이 몸이 말상대가 되어 줄게"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 10,
  "jh": "f4431bc1dbf5",
  "ko": "우, 우~"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 23,
  "jh": "7ef11a0051a5",
  "ko": "흠흠, 그러니까 에나 군들은 푸니푸니 구슬이 갖고 싶은 거군요"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 2,
  "jh": "4cdf0ec5ddc2",
  "ko": "애초에 푸니푸니 구슬이 뭐야…?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 23,
  "jh": "754f0ff43151",
  "ko": "인간이 말하는 푸니푸니 구슬엔 두 종류가 있어요. 하나는 푸니푸니가 흘리는 눈물…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "b4bd256c5beb",
  "ko": "왠지 시적이네… 푸니푸니 주제에…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 23,
  "jh": "191955f0e85e",
  "ko": "다른 하나는 푸니푸니의 산 간. 이쪽이 더 일반적이죠"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "f3e8a6f1e2bd",
  "ko": "산 간… 좋은 울림…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 8,
  "jh": "4248348546f8",
  "ko": "누나 감각도 꽤 이상하다… 그래도 역시 산 간은 못 받겠지…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 23,
  "jh": "73b935cce9d3",
  "ko": "아뇨, 산 간 한두 개 빼는 정도는 괜찮아요. 엄청 아프지만요"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 23,
  "jh": "988dc41c1aab",
  "ko": "에나 군한텐 푸니요가 신세 지고 있으니, 제 산 간이라도 괜찮다면"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 2,
  "jh": "f4ee430baef9",
  "ko": "어떻게 빼면 돼…? 입속에 손을 넣어서…?"
 },
 {
  "key": "m18",
  "kind": 5,
  "chr": 3,
  "jh": "27285e1ab959",
  "ko": "잠깐 기다려!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 5,
  "jh": "8b86926363e7",
  "ko": "푸니?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "e87ca9b8f88c",
  "ko": "걱정돼서 와 봤더니… 안 돼! 이 사람들한테 푸니푸니 구슬을 주면"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 23,
  "jh": "e595aa4ed822",
  "ko": "에에? 왜요?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 3,
  "jh": "8a5f683e64ec",
  "ko": "뭔가 잘못됐다곤 해도 나보다 좋은 성적을 받고 있는데…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "05a44d16963b",
  "ko": "더 이상 차이를 벌리게 둘까 보냐!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 2,
  "jh": "4614eb0ea6ec",
  "ko": "완전히 질투… 꼴사나워"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "c9aa5b06f895",
  "ko": "시시시, 시끄러워! 윤, 빨리 둘을 데려가"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 4,
  "jh": "f82d4d391c40",
  "ko": "알겠다"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 5,
  "jh": "7adf9ba468d3",
  "ko": "푸니! 푸니~!"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 23,
  "jh": "79cff0b9db8d",
  "ko": "앗. 난폭한 짓은 그만두세요!"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 8,
  "jh": "2241058723ae",
  "ko": "야! 잠깐 기다려!"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 4,
  "jh": "35ff34abb72f",
  "ko": "그쪽에서 손을 댄다면 가차 없다. 소년"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 3,
  "jh": "2050e2ab327e",
  "ko": "후후후, 너희에게 푸니푸니 구슬은 못 넘겨… 오~호호호!"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 11,
  "jh": "0a90ee3ee721",
  "ko": "아가씨, 완전히 악역이네요… 엄청 잘 어울리지만요"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 3,
  "jh": "00c7a62e84c4",
  "ko": "쓸데없는 말 하지 마! 자, 가자!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 2,
  "jh": "151ad2562198",
  "ko": "끌려가 버렸네… 어쩔래?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 8,
  "jh": "78b452f3b535",
  "ko": "어쩌긴, 쫓아가야지!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 2,
  "jh": "903ed9186c2d",
  "ko": "…에나는 푸니푸니 구슬이 아니라 푸니요가 걱정되는 거지…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 8,
  "jh": "4cafffa42c6b",
  "ko": "바, 바보! 이상한 짐작하지 마!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 2,
  "jh": "87b0d69f4cef",
  "ko": "네네… 킥킥…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 8,
  "jh": "e40e27542161",
  "ko": "우, 웃지 마!"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 1,
  "jh": "aafa9b845bc3",
  "ko": "…어, 어라? 왠지 나 완전히 잊혀졌는데"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 6,
  "jh": "7b893e5181b7",
  "ko": "마치 조연 1 같은 취급이네"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 1,
  "jh": "1674212f2474",
  "ko": "노, 농담하지 마! 잠깐~! 두고 가지 마~!"
 },
