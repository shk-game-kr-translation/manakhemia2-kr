[
 {
  "key": "m0",
  "kind": 5,
  "chr": 21,
  "jh": "a87ab8080e9d",
  "ko": "여, 실례하마"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 11,
  "jh": "3c00c8fe4aa5",
  "ko": "위르겐 씨, 몸은 이제 괜찮으세요?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 21,
  "jh": "20d8c70aa4b0",
  "ko": "그래. 사실 진작 나았는데 그 보건의가 자라고 시끄러워서 말이다"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 0,
  "jh": "acdd6ac9bb6c",
  "ko": "강한 척하지 마. 나이 좀 생각해"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 21,
  "jh": "30e82d7fcea5",
  "ko": "시끄러워. 뭐, 그런 거니까 난 한발 먼저 저택에 돌아가 있으마"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 3,
  "jh": "bbe7f76b0a0d",
  "ko": "어머. 기왕이면 졸업식까지 계시지 그래요"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 21,
  "jh": "b5a2d7d949aa",
  "ko": "아니, 그런 건 아무래도 질색이라… 나가 봤자 어차피 도중에 자 버릴 테고"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 21,
  "jh": "46fb20f1e4a0",
  "ko": "자… 이번엔 이래저래 신세를 졌구나"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 0,
  "jh": "8b04a13311ce",
  "ko": "…흥"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 21,
  "jh": "8a5ec49d2a5c",
  "ko": "돌아가면 오랜만에 검술 연습이나 할까. 얼마나 강해졌는지 봐 주마"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 0,
  "jh": "7bf3bf88b1c5",
  "ko": "…그러니까 나이 좀 생각하라고"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 21,
  "jh": "56f5c35c6af1",
  "ko": "뭘, 아직 너한테 질 만큼 쇠약하진 않았다. 그럼!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 11,
  "jh": "23f6dfdc1601",
  "ko": "잠깐이라지만 안 계시면 쓸쓸해지겠네요"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 0,
  "jh": "5ec0fed4eecb",
  "ko": "조용해져서 좋잖아. 병문안 가는 수고도 덜고"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 3,
  "jh": "1cb9aeda34a3",
  "ko": "넌 좀 더 솔직해지는 게 좋아"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "2455236cde5b",
  "ko": "할아버님한테도, 그, 저… 나, 나한테도…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 11,
  "jh": "e1255dbffab1",
  "ko": "아가씨한테는 충분히 솔직한 것 같은데요"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 3,
  "jh": "9bfa4603ed18",
  "ko": "왜 거기서 네가 대답하는 거니? 응?"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 11,
  "jh": "744ab04a5fd7",
  "ko": "아, 죄, 죄송해요! 그만 자연스럽게 입에서 말이… 아아아아!"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 4,
  "jh": "0f49c5f10782",
  "ko": "이걸로 전부 해결인가. 정신없는 1년이었군"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 0,
  "jh": "da0b07dfdaba",
  "ko": "정말이야. 뭐, 적어도 졸업까지는 느긋하게…"
 },
 {
  "key": "m21",
  "kind": 5,
  "chr": 7,
  "jh": "dece28282da0",
  "ko": "로제~! 큰일이야! 큰일 났어~!"
 },
 {
  "key": "m22",
  "kind": 5,
  "chr": 5,
  "jh": "af20d18f4a5a",
  "ko": "푸니니니~!"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 0,
  "jh": "526477ea6fcd",
  "ko": "느긋하게… 조용히…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 7,
  "jh": "2d4712e64785",
  "ko": "큰일이야! 큰일 났다고!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 7,
  "jh": "089095234611",
  "ko": "있잖아, 교감 선생님 기계검을 빌려서 칼싸움 놀이를 했는데…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 5,
  "jh": "ec6594d7f9a9",
  "ko": "푸니! 푸니니! 푸니~!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 23,
  "jh": "087d1c6e9606",
  "ko": "너무 기세가 붙어서 에토 씨가 형이랑 사부로를 두 동강 내 버렸어요!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "69470c967de7",
  "ko": "뭐…!? 푸니푸니를 두 동강이라고!?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 11,
  "jh": "d271a5778721",
  "ko": "괜찮은 거예요? 그거…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 7,
  "jh": "b9c83470765b",
  "ko": "일단 끈으로 묶어서 응급 처치는 했는데…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 4,
  "jh": "7e0b462cb9e0",
  "ko": "그건 치료 축에 안 든다"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 5,
  "jh": "a1cf78b91471",
  "ko": "푸니! 푸니니~!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 23,
  "jh": "356ac8cc2b5b",
  "ko": "빨리 어떻게 좀 해 줘! 라고 여동생도 눈물을 글썽이며 호소하고 있어요!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 0,
  "jh": "5f9385cc9bdb",
  "ko": "어떻게라니… 아아! 알았다고! 그 녀석들은 어디 있어?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 7,
  "jh": "9878dbcb0136",
  "ko": "괜찮아! 제대로 남의 눈에 안 띄는 곳에 숨겨 놨으니까!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 3,
  "jh": "257bd4d74ed7",
  "ko": "괜찮다는 의미를 모르겠어. 빨리 안내해"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 7,
  "jh": "d0fbe52976b5",
  "ko": "응, 이쪽이야 이쪽!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 5,
  "jh": "7ea7b0907d7f",
  "ko": "푸니~!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 4,
  "jh": "4820b4ce4554",
  "ko": "졸업까지 조용히 느긋하게… 라. 덧없는 꿈으로 끝난 모양이군"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 11,
  "jh": "6154600de576",
  "ko": "귀찮은 일에 휘말리는 게 특기잖아요. 로제 씨는"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 4,
  "jh": "097f99c3561c",
  "ko": "확실히 그 녀석답군… 어쩔 수 없지, 어울려 줄까"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 11,
  "jh": "b7e74bb4b1f4",
  "ko": "그러게요"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 15,
  "jh": "421f56789158",
  "ko": "아~ 역시 여기 있었다"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 14,
  "jh": "6dcc6d043d76",
  "ko": "뭐야, 또 왔어?"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 15,
  "jh": "480e9f6e796e",
  "ko": "또 왔어? 가 아니잖아!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 15,
  "jh": "8a77fd271ed6",
  "ko": "정말~ 겨우 상처가 나았나 했더니 수행만 하고!"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 15,
  "jh": "a1116e229c69",
  "ko": "나랑도 좀 놀아 줘! 누가 치료해 줬는데!"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 14,
  "jh": "b3675208734c",
  "ko": "고마워하고 있어. 하지만 더 강해지지 않으면 그를 이길 수 없으니까"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 15,
  "jh": "2e22e795ab0f",
  "ko": "상대는 여럿이었잖아? 일대일이었으면 무조건 이겼을 거야"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 14,
  "jh": "5515af6a51b2",
  "ko": "음~ 뭐, 그래도 진 건 진 거니까"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 15,
  "jh": "2700a0cd527e",
  "ko": "아, 그럼 말이야. 이쪽도 동료를 데려가면 되잖아."
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 15,
  "jh": "b789cc37074e",
  "ko": "그러면 낙승이야, 응!"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 14,
  "jh": "f08a6deec577",
  "ko": "동료라… 그건 생각 못 했네. 음~…"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 14,
  "jh": "fffebf9318a3",
  "ko": "그럼 말이야, 다음엔 너도 같이 싸워 줄래?"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 15,
  "jh": "3a8b9c9f8321",
  "ko": "어? 나? 물론이지! 루를 위해서라면 상대가 어떤 괴물이든…"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 14,
  "jh": "efefe0d7209a",
  "ko": "좋아. 그럼 같이 수행하자. 너도 강해져 줘야 하니까"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 15,
  "jh": "6890222db976",
  "ko": "어, 수행…? 으~음, 그런 열혈 같은 건 좀…"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 14,
  "jh": "2a3beed77587",
  "ko": "그래. 그럼 어쩔 수 없지. 다른 사람 꼬셔 볼게"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 15,
  "jh": "e232a1459791",
  "ko": "아~ 거짓말 거짓말! 나 열심히 할게! 응!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]