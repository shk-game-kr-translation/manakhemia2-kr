[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "abeeec10f791",
  "ko": "싫어"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 7,
  "jh": "6794f1c4fdd1",
  "ko": "에에에~! 왜~!?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 5,
  "jh": "c855dcd1797b",
  "ko": "푸니~… 푸니!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 23,
  "jh": "c37c7d4be333",
  "ko": "여동생도 학원제를 하고 싶대요… 어떻게 안 될까요?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "dc9b4845a465",
  "ko": "싫은 건 싫어. 돈으로 일을 해결하는 건 좋아하지 않아"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 22,
  "jh": "b751987a1fcb",
  "ko": "그럼 돈을 내 주면 사부로를 마음대로 해도 된다는 건 어떤가?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "4105798348d9",
  "ko": "그, 그건 매력적인 제안…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 24,
  "jh": "66fc20d1cf1a",
  "ko": "너, 너무해 형! 푸니푸니 매매라니 해도 너무해!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 11,
  "jh": "5a3ef9eef4f6",
  "ko": "하지만 아가씨, 생각하기 나름이에요"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 3,
  "jh": "e69280373277",
  "ko": "무슨 뜻이니?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 11,
  "jh": "26dfee2f19c5",
  "ko": "학원제라고 하면 남녀 사이가 깊어지는 빅 찬스 이벤트…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 11,
  "jh": "ca605a81169c",
  "ko": "같이 노점을 돌거나, 후야제에서 손을 잡고 포크 댄스를 추거나…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 11,
  "jh": "63d265b38ff8",
  "ko": "그리고 축제가 끝나면 두 사람은 초원에 앉아 별을 올려다보며…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 3,
  "jh": "8171af0dcfd4",
  "ko": "…다, 다음은? 그다음엔 어떻게 되는데?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 11,
  "jh": "4bc99743048b",
  "ko": "더 이상은 차마 제 입으로는…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 11,
  "jh": "d29c6dfbc51e",
  "ko": "그래서 어떠세요? 로제 씨와 그런 학원제를 보내 보시는 건…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 3,
  "jh": "a688bd759653",
  "ko": "뭐뭐뭐, 왜 거기서 로제 이름이 나오는 거야!?"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 11,
  "jh": "2a21e53997bb",
  "ko": "아아! 아, 아파요! 아가씨이이…"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 7,
  "jh": "54071302d800",
  "ko": "이제 와서 부끄러워할 거 없는데. 자, 해 버리자. 학원제!"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 3,
  "jh": "5c05f8ea90cc",
  "ko": "그, 그래. 왠지 나쁘지 않은 것 같기도 하네…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 3,
  "jh": "8697126dd382",
  "ko": "따, 딱히 너희가 말해서 그런 건 아니야!"
 },
 {
  "key": "m21",
  "kind": 5,
  "chr": 18,
  "jh": "cd9b9b1044f2",
  "ko": "어머어머! 그건 곤란하네요…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 3,
  "jh": "0045aaa71244",
  "ko": "어머, 이사장 선생님에 토니 선생님. 무슨 볼일이라도?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 20,
  "jh": "730c9d7a0b0b",
  "ko": "너희한테 부탁할 게 있었는데… 뭐, 어쩔 수 없지. 응"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 18,
  "jh": "d01395a8ecdd",
  "ko": "설마 여러분까지 학원제에 마음이 있으시다니… 어쩌면 좋을까요!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "625922a17ca6",
  "ko": "무슨 얘긴지 전혀 모르겠는데요"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 20,
  "jh": "cb2eebcf14bf",
  "ko": "그게 말이야. 학원제 중지에 반대하는 놈들이 모여서 시위대를 결성했다나 봐"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 7,
  "jh": "2af1abfa3031",
  "ko": "시위대! 왠지 멋있어 보여!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 4,
  "jh": "95c0b0c92c11",
  "ko": "그걸 막고 오라는 건가?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 18,
  "jh": "245d01c83c5b",
  "ko": "그럴 생각이었습니다만…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 18,
  "jh": "29da519d096a",
  "ko": "교사가 손을 대면 더 완강해질 테고. 세상 체면도 안 좋고…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 0,
  "jh": "a531fe810a58",
  "ko": "뭐, 다른 데 알아보세요"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 18,
  "jh": "2341bb7574ca",
  "ko": "유감이네요. 시위대를 이끄는 건 울리카라는 학생인데"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 18,
  "jh": "aa609b0db5bc",
  "ko": "여러분은 참가하지 않을 줄 알았는데…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 3,
  "jh": "48c99975b289",
  "ko": "할게요. 그 시위 활동, 제가 막아 보이겠어요!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 7,
  "jh": "8a221e404781",
  "ko": "잠, 릴리아!?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 18,
  "jh": "e9762c59b1f1",
  "ko": "어머! 그거 도움이 되겠네요. 그럼 자세한 협의는 나중에 제 방에서"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 20,
  "jh": "202074f6ae4c",
  "ko": "칫… 너희가 하겠다면 뭐, 상관없지만"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 11,
  "jh": "dc1c74bd86fe",
  "ko": "아가씨… 아무리 그래도 반사적으로 너무 나가셨어요…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 3,
  "jh": "172b39e08428",
  "ko": "시, 시끄러워! 작전대로야! 그냥 깜빡이야!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 23,
  "jh": "a1b97e71e9d6",
  "ko": "여동생도 화를 넘어 어이없어하고 있어요…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 0,
  "jh": "e51ec077adc1",
  "ko": "그래서, 정말 하실 거예요?"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 3,
  "jh": "2e490c514411",
  "ko": "어쩔 수 없잖아. 맡아 버렸으니까…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "bfbaf2a366a3",
  "ko": "그 시골뜨기를 혼내 줄 기회라고 생각하면 나쁘지 않잖아"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 4,
  "jh": "713562c2a3ce",
  "ko": "그걸 바라는 건 주인뿐인 것 같다만"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 3,
  "jh": "937e9a3caf3c",
  "ko": "정말, 불평하지 마! 자, 이사장실로 가자"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 7,
  "jh": "bed6bc1fc0f8",
  "ko": "아~… 학원제 하고 싶은데~"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]