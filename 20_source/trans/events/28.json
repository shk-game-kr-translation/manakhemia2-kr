  "jh": "87cc77d49bf1",
  "ko": "알았지. 일제히 붙잡는 거야!"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 11,
  "jh": "45fcbb793457",
  "ko": "네, 네. 아가씨"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 4,
  "jh": "c8473046735f",
  "ko": "…명령이라면"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 35,
  "jh": "a05b54852f2b",
  "ko": "그, 그만두세요! 뭘 하려는 거예요!?"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 3,
  "jh": "e33a4dda5e0a",
  "ko": "지금이야! 에잇~!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 35,
  "jh": "fe9a5e7d16b3",
  "ko": "으아아! 노, 놓아 주세요!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "c01af4026298",
  "ko": "아아, 푸니푸니… 진짜 푸니푸니…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 3,
  "jh": "24169f1d7134",
  "ko": "서늘하고 말랑말랑한 감촉… 우후후후후후…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 35,
  "jh": "9b9d81d36a4c",
  "ko": "그, 그런 음흉한 손놀림으로… 아, 안 돼요! 더 이상은!!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 3,
  "jh": "9b1702c014e2",
  "ko": "중독될 것 같아… 자~ 말랑말랑말랑…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 35,
  "jh": "054a60d60a35",
  "ko": "그, 그만둬 주세요… 거기는 민감해서… 아, 아아아아앗!!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 7,
  "jh": "6415320af73d",
  "ko": "우와아…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 35,
  "jh": "1baafbe4dea6",
  "ko": "사, 살려… 살려 주세요!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "88d462614acd",
  "ko": "뭐 하시는 거예요…?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "1688d94d64d4",
  "ko": "뭐 하냐니, 보면 알… 꺄악!! 너희, 언제부터 거기에!?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 4,
  "jh": "342bbc30376c",
  "ko": "일단 말해 두지만, 난 주인의 특이한 취미에 어울려 준 것뿐이다"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 11,
  "jh": "768bae42cfe9",
  "ko": "저도 마찬가지예요"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "3415569be496",
  "ko": "뭐! 조, 조금쯤은 편 좀 들어 줘!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 7,
  "jh": "1139d4529456",
  "ko": "릴리아는 푸니푸니를 좋아했구나"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "4769291f3fa5",
  "ko": "딱히 좋아하는 거 아니야! 뭐, 싫어하지도 않지만…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "7405d79ad736",
  "ko": "만지면 기분 좋고. 신나서 콕콕 찌르다 보면 점점 흥분돼서…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 7,
  "jh": "d49f8e6823a5",
  "ko": "왠지 야하다…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "e4694e54c5f4",
  "ko": "딱히 야하지 않거든! 저속한 상상하지 말아 줄래!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 7,
  "jh": "0c1b0012f158",
  "ko": "그럼 말이야, 로제랑 푸니푸니 중에 누가 더 좋아?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "e9ea0c201c36",
  "ko": "뭐, 바, 에에에에에!? 가, 갑자기 무슨 소리야!?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 0,
  "jh": "3aa27ae203a9",
  "ko": "시시한 얘기 그만하고 일단 놓아 주죠. 아시겠죠?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 3,
  "jh": "45deafc8c6d3",
  "ko": "그게, 그러니까… 로제랑 푸니푸니는 비교 대상이 너무 다르고…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "00c4df016416",
  "ko": "좋아하는 데도 여러 종류가 있고… 게다가 본인 앞에선 말하기 곤란하달까…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 35,
  "jh": "5b535338f75f",
  "ko": "후우… 어디 사는 누구신지 모르지만 감사했습니다"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 0,
  "jh": "d632eed080e7",
  "ko": "뭐, 신경 쓰지 마"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 3,
  "jh": "dac25c05d18e",
  "ko": "그래도 굳이 고르라고 한다면 답은 이미… 왜냐면 10년이나 같이 있었으니까…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 4,
  "jh": "ab3844ec6411",
  "ko": "이제 아무도 안 듣고 있는 것 같은데"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 3,
  "jh": "e63b36ddfc1f",
  "ko": "어…? ……………!?"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 11,
  "jh": "2466aa16f468",
  "ko": "앗, 아파! 저, 저한테 화풀이하지 마세요~!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 0,
  "jh": "abeb9cd9883f",
  "ko": "그래서, 뭘 하고 있던 거야, 이런 데서… 아까 복도에서도 만났지?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 35,
  "jh": "dc7d2bd90d05",
  "ko": "아까요? 당신을 만난 기억은 없는데요…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 35,
  "jh": "8411b28d40c6",
  "ko": "앗! 혹시 형이나 동생이랑 착각하신 거 아닐까요?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 0,
  "jh": "99e2120b55f6",
  "ko": "그래? 형이나 동생이라면…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 3,
  "jh": "55dc45eab757",
  "ko": "푸니푸니가 두 마리나 더 있다고!?"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 35,
  "jh": "1161f1aad82a",
  "ko": "네, 네 뭐… 그리고 또…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 3,
  "jh": "7dd8fe76b98d",
  "ko": "이러고 있을 때가 아니야…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 3,
  "jh": "066bb98cfa73",
  "ko": "그 두 마리도 서둘러 납치… 가 아니라 감금… 이 아니라 보호해야 해!"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 7,
  "jh": "c2058125448e",
  "ko": "가 버렸다… 기다려! 나도 갈래~!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 35,
  "jh": "21045aedf229",
  "ko": "아아, 큰일이다! 이대로라면 형과 동생 신변에 위험이…!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 0,
  "jh": "15096b252990",
  "ko": "…가능하면 먼저 사정을 듣고 싶은데"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 35,
  "jh": "26d301a859fd",
  "ko": "그건 걸으면서라도! 지금은 저 사람을 말려야 해요!"
 },
