[
 {
  "key": "m0",
  "kind": 2,
  "chr": 30,
  "jh": "148426ca40d1",
  "ko": "그렇군, 그 녀석이랑 싸우게 됐냐…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 6,
  "jh": "c75b1e46bc6f",
  "ko": "응. 무슨 일이 있어도 질 수 없어!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 30,
  "jh": "5fa725163eac",
  "ko": "하지만 그 녀석 실력도 상당하지… 정면으로 싸워도 승률은 반반…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 6,
  "jh": "43fec0d8d987",
  "ko": "응…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "c1aaceffe14f",
  "ko": "내가 왜 이런 데 있는 걸까…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 30,
  "jh": "2eec3107cba6",
  "ko": "무슨 소리냐. 자기네 요정 씨를 응원하는 건 고용주로서 당연하잖냐"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 6,
  "jh": "4f0fc1765c80",
  "ko": "맞아. 누나도 검은 누나한테 원한 풀 기회잖아"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "9c493e457d61",
  "ko": "원한 같은 건 딱히… 하아, 이제 됐어. 무슨 말을 해도 어울리게 될 테니까"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 30,
  "jh": "7b16353f8eb5",
  "ko": "그나저나 특훈이라 해도 시간이 너무 없군. 할 수 있는 건 한정돼 있다…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "be1047e18657",
  "ko": "응, 그래서 스승님한테 상담하러 온 거야. 이 몸은 뭘 하면 돼?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 30,
  "jh": "940383b8c68f",
  "ko": "…이제 와서 기책을 준비해 봤자 소용없지… 좋아, 너희 둘이 싸워 봐라"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "e29a5c54d743",
  "ko": "뭐? 나랑 페페론이?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 30,
  "jh": "92b7c6da516c",
  "ko": "다른 누가 있냐"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 6,
  "jh": "5ae0fed40ba2",
  "ko": "봐주기 없기야, 누나!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "6f9bf74b11e8",
  "ko": "농담이지!? 봐주지 않고 너랑 싸우면 죽는다고!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 30,
  "jh": "4a5c7183dd86",
  "ko": "안심해라. 페페론, 넌 손대는 거 엄금이다. 오로지 공격을 계속 버텨라"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 6,
  "jh": "57b26f79ddca",
  "ko": "에에? 왜? 이 몸은 그런 취미는…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 30,
  "jh": "2b4ed7042f3a",
  "ko": "취미 문제가 아니야. 이건 네 튼튼함을 단련하는 특훈이다"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 6,
  "jh": "d6173a780bf9",
  "ko": "튼튼함? 그 말은…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "a4096b9b64e5",
  "ko": "즉, 난 오로지 페페론을 계속 때리면 되는 거지?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 30,
  "jh": "96068c5e0086",
  "ko": "아아, 물론 진심으로. 죽일 생각으로 때려 줘"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "2a07cf00847b",
  "ko": "왠지 이 몸 혼자만 괴로운 것 같은…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 30,
  "jh": "6b79f6c94a45",
  "ko": "응석 부리지 마! 특훈이란 건 괴로운 거라고 정해져 있다!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 6,
  "jh": "14c91311b611",
  "ko": "으… 알았어…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
