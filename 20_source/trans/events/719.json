[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "325d41f7cb4b",
  "ko": "자, 재료 모으러 오긴 했는데…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 8,
  "jh": "9c11e4afc95c",
  "ko": "이제 와서 이런 데 와 봤자 대단한 건 안 떨어져 있잖아?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 2,
  "jh": "eadcda29104c",
  "ko": "어차피 초보자용 던전이고…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 6,
  "jh": "340d8a3f1e65",
  "ko": "그, 그렇지 않아! 누나들은 모르겠지만"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 6,
  "jh": "f1ff2cbe5b7c",
  "ko": "여긴 아직 멋진 재료가 잔뜩 떨어져 있다고!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "66c2ca22d680",
  "ko": "뭘 발끈해? 사실이잖아?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 2,
  "jh": "fcaec8e8edf4",
  "ko": "금방 들킬 거짓말은 꼴사나워…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 8,
  "jh": "4d87eb6e9d15",
  "ko": "뭐, 적당히 재료 줍고 다른 데 가자"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 6,
  "jh": "c098c16b227d",
  "ko": "으음… 그렇게까지 말한다면 증거를 보여 주지!"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 1,
  "jh": "bf700b6bc04b",
  "ko": "앗, 이놈! 어디 가!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 9,
  "jh": "132d9191df8b",
  "ko": "자자, 누구라도 자기가 나고 자란 곳을 무시당하면 화나는 법이야"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 9,
  "jh": "04f2163ec340",
  "ko": "여긴 하나 그가 하고 싶은 대로 하게 해 주자고"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "30ba9466f3e7",
  "ko": "…정말, 언제 돌아오는 거야!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "aaa2028aa0b8",
  "ko": "…이제 돌아가자. 기다리다 지쳤어…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 9,
  "jh": "505ba092dcfd",
  "ko": "그나저나 이렇게까지 늦다니… 설마 그의 몸에 무슨 일이!?"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 6,
  "jh": "a8c31743a708",
  "ko": "다, 다녀왔어… 늦어서 미안해…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "15046fbecab1",
  "ko": "아, 겨우 돌아왔다… 라니, 너덜너덜하잖아!? 무슨 일이야!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 6,
  "jh": "706f2326b988",
  "ko": "이 몸은 괜찮아… 그보다 이걸…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "2680e6b526ad",
  "ko": "이건… 어디 있었어?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 6,
  "jh": "3ab04b3f8c31",
  "ko": "으으… 스승님도 다가가지 않는 위험한 깎아지른 절벽 중간에…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "1ab28b200237",
  "ko": "이걸 캐려고 그렇게 다친 거야?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "de99aee58f78",
  "ko": "으으… 분했어… 이 몸이 자란 요정의 숲이 무시당하는 게…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 9,
  "jh": "01352fc13bae",
  "ko": "페페론… 넌 정말… 넌 정말!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "c25f446e3829",
  "ko": "흐응, 즉 페페론한테 부탁하면 언제든 이걸 손에 넣을 수 있다는 거네"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 6,
  "jh": "2dbe638cf728",
  "ko": "어? 에에에!? 아무리 그래도 언제나는… 이 몸 몸이 못 버텨…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "00a11ef12426",
  "ko": "요정 씨라면… 죽어도 안 죽으니까 괜찮아…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 6,
  "jh": "da68d4db9832",
  "ko": "괜찮은 이유를 전혀 모르겠어!!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "ab221c9598dc",
  "ko": "농담이야. 늦었으니까 오늘은 돌아가자. 진귀한 재료도 손에 넣었고"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 6,
  "jh": "711fd95ce7a9",
  "ko": "응… 이 몸도 너무 힘을 내서 녹초야"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "9cf1fa2376ef",
  "ko": "뭐, 오늘은 웬일로 도움이 됐네. 고마워"
 },
 {
  "key": "m30",
  "kind": 5,
  "chr": -1,
  "jh": "bf370f674922",
  "ko": "「{CLGR}황금 허브{CLNR}」를 손에 넣었습니다."
 },
