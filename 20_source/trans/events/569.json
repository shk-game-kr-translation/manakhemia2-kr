 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 22,
  "jh": "cf50bb3bf5d8",
  "ko": "아아, 미안하다… 훌쩍"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 62,
  "jh": "6f349b3a00e5",
  "ko": "그리고 하나 더…"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 0,
  "jh": "612f6299e08c",
  "ko": "응?"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 62,
  "jh": "9fead006b26d",
  "ko": "로제 씨, 라고 하셨던가요"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 62,
  "jh": "be2a8e7dce12",
  "ko": "지난 푸니푸니 순례에선 푸니요 님 대신 사자분신의 활약을 하셨다고…"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 62,
  "jh": "9a41048fdbd1",
  "ko": "따라서! 이번엔 특별히 당신에게도 푸니푸니증을 수여합니다!"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 0,
  "jh": "f8d169ffb117",
  "ko": "뭐, 뭐라고!?"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 5,
  "jh": "4c9e1a54c85b",
  "ko": "푸니!?"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 62,
  "jh": "5d29ce9bee24",
  "ko": "앞으로도 한 푸니푸니로서 변함없는 활약을 기대하겠습니다. 그럼"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 0,
  "jh": "dde88c2fb5d6",
  "ko": "기다려! 난 이런 거 필요 없…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 24,
  "jh": "58ac5c59189a",
  "ko": "우와~! 대단하다! 축하해!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 23,
  "jh": "103ddf671d7b",
  "ko": "이런 명예로운 일은 없어요!"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 7,
  "jh": "27843fb025e8",
  "ko": "좋겠다~ 로제. 나도 갖고 싶다~"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 3,
  "jh": "3bc53147c392",
  "ko": "로제가 푸니푸니에… 이 얼마나 파괴력 발군의 조합… 읏! 상상했더니 코피가…!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 22,
  "jh": "d0e9aa4d3dc5",
  "ko": "좋아. 지금까지의 답례로 푸니푸니의 마음가짐을 확실히 가르쳐 주마!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 0,
  "jh": "071be4790378",
  "ko": "너희, 멋대로 사람을 푸니푸니로 만들지 마!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 11,
  "jh": "07c3a0a0d1a2",
  "ko": "좋잖아요. 왠지 이제 거절할 분위기도 아니고"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 4,
  "jh": "09b93dd5a380",
  "ko": "푸니푸니가 된다고 딱히 불편할 건 없지 않나"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 0,
  "jh": "92de4d1581f0",
  "ko": "그 이전의 문제야!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 5,
  "jh": "473e42df498b",
  "ko": "푸니? 푸니니?"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 23,
  "jh": "87db3416c12e",
  "ko": "푸니푸니가 되는 건 싫어? 라며 여동생이 쓸쓸한 눈으로 올려다보고 있는데요…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 0,
  "jh": "ddc785688d9e",
  "ko": "그러니까 싫은 게 아니라, 그…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 5,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 0,
  "jh": "18dd80dcb833",
  "ko": "읏… 그런 눈으로 보지 마! 알았어! 고맙게 받아 주지!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 5,
  "jh": "7ea7b0907d7f",
  "ko": "푸니~!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 22,
  "jh": "a0194573d30f",
  "ko": "지로, 사부로! 축하연 준비다! 두 푸니푸니의 탄생을 축하하며 오늘 밤은 화끈하게 놀자!"
 },
 {
  "key": "m45",
  "kind": 5,
