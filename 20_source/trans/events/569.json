 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 23,
  "jh": "8397a8283256",
  "ko": "네? 보시다시피 푸니푸니 대사예요"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 23,
  "jh": "ef40ce62867c",
  "ko": "인간계의 외교나 식전 등의 전권을 맡은 아주 높은 분이에요"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 11,
  "jh": "60d1e136d74b",
  "ko": "전혀 그렇게 안 보이는데요"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 7,
  "jh": "385c6e8efc11",
  "ko": "푸니푸니 겉모습은 다 똑같으니까"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "b79e8e242ef2",
  "ko": "…그래서 그 녀석이, 뭐냐, 푸니푸니증? 그걸 주러 왔다는 거냐"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 23,
  "jh": "eb2c32c436f5",
  "ko": "네! 이걸로 푸니요도 당당히 정식 푸니푸니예요!"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 62,
  "jh": "a45236084bb9",
  "ko": "푸니요 님. 당신의 지금까지의 활약은 익히 들었습니다"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 62,
  "jh": "80661f635fb3",
  "ko": "당신은 어디에 내놔도 부끄럽지 않은 어엿한 푸니푸니입니다. 축하합니다!"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 5,
  "jh": "7ea7b0907d7f",
  "ko": "푸니~!"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 24,
  "jh": "3fb5afa0f702",
  "ko": "축하해! 푸니요!"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 22,
  "jh": "623e3afcb107",
  "ko": "으으으… 이날이 오기를 얼마나 손꼽아 기다렸던가…"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 23,
  "jh": "402f2c5dd285",
  "ko": "자, 형. 눈물 닦아"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 5,
  "jh": "6252663a688f",
  "ko": "푸니! 니!"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 23,
  "jh": "a45b91e4446f",
