[
 {
  "key": "m0",
  "kind": 2,
  "chr": 0,
  "jh": "a3f76e2a51f4",
  "ko": "…응?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 3,
  "jh": "78e2bbee6b96",
  "ko": "왜 그래, 로제?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 0,
  "jh": "10a90a623975",
  "ko": "아니, 방금 누가 있었던 것 같은데… 기분 탓인가"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 12,
  "jh": "7b45c86ede71",
  "ko": "호오, 눈치챘나. 기척은 완전히 지웠다고 생각했다만"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 7,
  "jh": "a5a8dbd6952b",
  "ko": "으악, 나왔다!?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "d067a80cc8f0",
  "ko": "…매번 무슨 등장 방식이에요. 오늘은 무슨 볼일이에요?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 12,
  "jh": "58a50af2c5a1",
  "ko": "이걸 주러 와 줬다. 감사해라"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "c98b89b23d44",
  "ko": "종이? 어디 보자… 바자 출점 허가서?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 12,
  "jh": "b4aac7ebee0b",
  "ko": "음. 올해부터 학생이 자유롭게 가게를 낼 수 있게 허가됐다"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 12,
  "jh": "a288186279da",
  "ko": "전원 교실에 있을 때 나눠 주면 됐겠지만 공교롭게도 여름 방학이라"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 12,
  "jh": "9b5c88bfca8a",
  "ko": "이렇게 일부러 찾아와 준 거다"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "3bb211a85cc5",
  "ko": "하아, 그건 감사합니다…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 12,
  "jh": "d020d4d43577",
  "ko": "그럼 이 몸은 이만 실례한다. 다음 학생한테 가야 해서"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 0,
  "jh": "26a63832c224",
  "ko": "바자라… 어떻게 할까"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 20,
  "jh": "adfe49f258cd",
  "ko": "실례한다"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "f0cbdb90ce7e",
  "ko": "아, 토니 선생님. 무슨 일이야?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 20,
  "jh": "604f6fe19141",
  "ko": "이걸 주러 왔을 뿐이다. 자"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "ecaa4dff6ee4",
  "ko": "뭐야 이 종이? …바자 출점 허가서?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 20,
  "jh": "dc85f0e33391",
  "ko": "아아, 뭐든 올해부터 학생이 자유롭게 가게를 내도 된다는군"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "4e35f3c8fe98",
  "ko": "헤에… 그래도 일부러 안 와도 교실에서 나눠 주면 됐잖아"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 20,
  "jh": "aa4c093e8707",
  "ko": "나도 그러고 싶었는데 여름 방학 중이니까 어쩔 수 없잖아"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "80be8b92534c",
  "ko": "아, 그렇구나"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 20,
  "jh": "0cac67e60100",
  "ko": "오늘 중에 전원한테 나눠 줘야 해. 아~ 귀찮아…"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 1,
  "jh": "d5a50da8f0c1",
  "ko": "바자라… 좀 재밌을 것 같아"
 },
 {
  "key": "m24",
  "kind": 5,
  "chr": -1,
  "jh": "556b8a34992d",
  "ko": "매점에서 {CLRE}바자{CLNR}를 열 수 있게 되었습니다."
 },
 {
  "key": "m25",
  "kind": 5,
  "chr": -1,
  "jh": "024a0cc80a89",
  "ko": "{CLRE}바자{CLNR} 도움말을 보시겠습니까?"
 },
 {
  "key": "m26",
  "kind": 5,
  "chr": -1,
  "jh": "76f28d833440",
  "ko": "바자에서는 직접 조합한 아이템을 팔아 돈을 얻을 수 있습니다."
 },
 {
  "key": "m27",
  "kind": 5,
  "chr": -1,
  "jh": "36d2cf0b5008",
  "ko": "바자를 할 때는 매점의 이 카운터에 접근하세요."
 },
 {
  "key": "m28",
  "kind": 5,
  "chr": -1,
  "jh": "8b3927704836",
  "ko": "단, 바자는 {CLRE}자유 시간에만 열 수 있고 시간도 경과{CLNR}하니 주의하세요."
 },
 {
  "key": "m29",
  "kind": 5,
  "chr": -1,
  "jh": "5e8db5319ab8",
  "ko": "다음으로 실제 바자 순서를 설명합니다."
 },
 {
  "key": "m30",
  "kind": 5,
  "chr": -1,
  "jh": "ee8d1ddd274d",
  "ko": "먼저 팔 아이템을 고르세요. {CLRE}최대 10종류{CLNR}까지 선택할 수 있습니다."
 },
 {
  "key": "m31",
  "kind": 5,
  "chr": -1,
  "jh": "a41404683e95",
  "ko": "팔 아이템을 정했으면 가게 당번을 고르세요."
 },
 {
  "key": "m32",
  "kind": 5,
  "chr": -1,
  "jh": "a9dbc116ae1c",
  "ko": "가게 당번 캐릭터에 따라 손님과의 궁합이나 판매 결과가 달라집니다."
 },
 {
  "key": "m33",
  "kind": 5,
  "chr": -1,
  "jh": "8e7befd5559b",
  "ko": "당번을 골랐으면 드디어 바자 시작입니다."
 },
 {
  "key": "m34",
  "kind": 5,
  "chr": -1,
  "jh": "1491bf3df01c",
  "ko": "가게에 온 손님은 뭔가 아이템을 사 가지만"
 },
 {
  "key": "m35",
  "kind": 5,
  "chr": -1,
  "jh": "00dccc1a727f",
  "ko": "손님이 좋아하는 종류의 아이템이 있으면 많이 사 가고 평가도 크게 변동합니다."
 },
 {
  "key": "m36",
  "kind": 5,
  "chr": -1,
  "jh": "210fccd941fe",
  "ko": "게다가 손님에게 {CLRE}팔린 조합 아이템은 다른 가게에서 판매{CLNR}되게 됩니다."
 },
 {
  "key": "m37",
  "kind": 5,
  "chr": -1,
  "jh": "cd88c00182b5",
  "ko": "가게마다 등록되는 아이템 카테고리가 다르니 조사해 보세요."
 },
 {
  "key": "m38",
  "kind": 5,
  "chr": -1,
  "jh": "883bf4bc0f4d",
  "ko": "많은 수가 필요한 아이템 등을 등록하는 등 잘 활용합시다!"
 },
 {
  "key": "m39",
  "kind": 5,
  "chr": -1,
  "jh": "5b1205610984",
  "ko": "「{CLRE}도움말{CLNR}」의 「{CLRE}시스템{CLNR}」에 새로운 항목이 추가되었습니다."
 },
 {
  "key": "m40",
  "kind": 5,
  "chr": -1,
  "jh": "55291ff330e5",
  "ko": "「{CLRE}도움말{CLNR}」은 메뉴의 「{CLRE}도감{CLNR}」에서 확인할 수 있습니다."
 },
 {
  "key": "g0s0",
