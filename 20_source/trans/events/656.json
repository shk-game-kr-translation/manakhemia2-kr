[
 {
  "key": "m0",
  "kind": 2,
  "chr": 9,
  "jh": "a8edd810f9eb",
  "ko": "무슨 일이야? 갑자기 불러내고"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 9,
  "jh": "80f5b4e03e6e",
  "ko": "혹시… 설마 아가씨까지 내 매력에 사로잡혀 버린 건가"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "c27ea19f0390",
  "ko": "네네. 헛소리는 됐으니까 이 목걸이 좀 차"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 9,
  "jh": "f788910c6574",
  "ko": "목걸이는 상대를 속박하는 상징. 역시 너도… 응? 이 목걸이는… 페페론?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 6,
  "jh": "ecfd3fa7ab97",
  "ko": "미안해. 누나가 너무 끈질겨서"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 9,
  "jh": "9a5626fd4240",
  "ko": "이런이런… 뭐, 어쩔 수 없지. 남녀 간의 오해는 확실히 풀어 두지 않으면 귀찮으니까"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "597939fd01f5",
  "ko": "일일이 이상한 표현 쓰지 마. 너 목 굵네… 좋아, 찼다"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "4a869d84c8bd",
  "ko": "알았지? 지금부터 내 질문에 전부 「네」로 대답하는 거야"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 9,
  "jh": "b0618e519dcb",
  "ko": "네네. 여기선 얌전히 따르지"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 1,
  "jh": "6a1e670bb456",
  "ko": "일단 테스트. 당신은 고토입니까?"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 9,
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 1,
  "jh": "1c9b2c15e262",
  "ko": "어라, 왜 빛나?"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 9,
  "jh": "8559f41b89e7",
  "ko": "그야 그렇지. 고토라는 건 가명이니까"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 1,
  "jh": "7477b1d2776b",
  "ko": "그랬어? …뭐, 됐어. 그럼 본 질문!"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 1,
  "jh": "39c2dc9bd3ae",
  "ko": "당신은 인기를 얻기 위해 학원 여자애들에게 뭔가 했습니까?"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 9,
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "9466b298790c",
  "ko": "안 빛나… 그렇다는 건 역시!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 9,
  "jh": "6397f3f0f7f6",
  "ko": "질문 범위가 너무 넓어. 인사하거나 얘기만 해도 뭔가 한 게 되니까"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "e6a44f598216",
  "ko": "아~ 그렇구나… 그럼… 여자애랑 친해지려고 이것저것 나쁜 짓을 했다든가"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 9,
  "jh": "6c87e38a2ab5",
  "ko": "말만 바꿨을 뿐 아까 질문이랑 같지 않나?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "b550a69e7463",
  "ko": "음~ 그럼… 여자애한테, 그, 야한 짓을 했다!?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 9,
  "jh": "eea51c1f3c74",
  "ko": "야한 짓이라니 구체적으로 어떤 거지?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "5a9cb6525064",
  "ko": "어? 에에!? 그건 그러니까… 단둘이서 그… 손을 잡는다든가…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 9,
  "jh": "3ee38cdc652f",
  "ko": "하하하. 아가씨는 얼굴에 비해 순진하군"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "fd4039a0126e",
  "ko": "얼굴에 비해는 뭐야! 아~ 정말! 뭐야 이 목걸이! 전혀 도움이 안 되잖아!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 6,
  "jh": "2706f7a4ad04",
  "ko": "아아아! 거칠게 다루지 말아 줘!"
 },
 {
  "key": "m26",
  "kind": 5,
  "chr": 2,
  "jh": "3f3ca373e834",
  "ko": "시끄러워… 밖까지 목소리가 다 새…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 2,
  "jh": "e0d894ee9373",
  "ko": "그 모양을 보니… 실패?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "d69bfad6a614",
  "ko": "응… 그쪽은 어땠어?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 8,
  "jh": "71f8ed1ad7e0",
  "ko": "일단 여기저기 있는 녀석들 붙잡아서 설문 조사를 해 봤는데"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "cd61b519c13b",
  "ko": "꼼꼼하네… 그래서 결과는?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 8,
  "jh": "2f9d5cc9167d",
  "ko": "듣고 놀라지 마… 고토가 멋있다고 생각하냐는 질문에 93%가 Yes다"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "3ced4f11f24a",
  "ko": "거의 전원이잖아!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 8,
  "jh": "c98be0be9552",
  "ko": "주요 의견은 「분하지만 멋있다」「저 녀석한테 졌다면 어쩔 수 없다」 등등…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "2132a41d386b",
  "ko": "믿을 수 없어…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 8,
  "jh": "88ef84a121ba",
  "ko": "다음으로 고토 같은 연인을 갖고 싶냐는 질문엔 65%가 Yes다"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 1,
  "jh": "218326e8adf9",
  "ko": "오. 꽤 떨어졌네"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 8,
  "jh": "d7d57cded3ed",
  "ko": "그런데 남녀별로 보면 여자는 거의 100%. 남자도 세 명 중 한 명은…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 1,
  "jh": "6ecfad5748cd",
  "ko": "잠깐! 더는 듣고 싶지 않은 것 같아!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 9,
  "jh": "d90b11e960de",
  "ko": "마음은 기쁘지만 난 그쪽 취향은 없거든"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 8,
  "jh": "20030fe5853d",
  "ko": "그런 이유로 여론은 완전히 고토 편이야"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 1,
  "jh": "6c65a0c20219",
  "ko": "큭… 아직이야! 클로에는? 클로에는 어땠어!?"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 2,
  "jh": "717c5505d965",
  "ko": "응… 난 좀 더 현실적인 방법으로…"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 2,
  "jh": "5fd50922ed74",
  "ko": "탈인형 씨를 좋아한다는 여자애한테서 약물 반응이 안 나오나 조사해 왔어…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 1,
  "jh": "cf8214193337",
  "ko": "오오… 뭐, 자세한 건 묻지 않을게. 그래서 결과는?"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 2,
  "jh": "75352c0ab8cd",
  "ko": "온갖 약품을 조사했지만 결과는 무죄…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 2,
  "jh": "82ad35c3ab0c",
  "ko": "사실 더 조사하고 싶었는데 피험자의 몸과 마음이 한계에…"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 1,
  "jh": "bcf0b9b995ef",
  "ko": "아니, 그건 그만둔 게 정답이었다고 생각해"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 9,
  "jh": "94c93cca1743",
  "ko": "자, 이제 속이 풀렸나?"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 1,
  "jh": "49f6e621208f",
  "ko": "…납득 못 해! 왜냐면 난 너를 전혀 멋있다고 생각 안 하는걸!"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 9,
  "jh": "f9b28ef7f598",
  "ko": "그렇게 딱 잘라 말하니 오히려 상쾌하군"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 9,
  "jh": "3e9890ecf768",
  "ko": "하지만 세상엔 어떤 꽃을 봐도 아름답다고 못 느끼는 사람도 있지… 그런 거야"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 1,
  "jh": "6115289dd84f",
  "ko": "그래도! 이 자리에 있는 전원이 같은 의견이라고? 이상하잖아!"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 9,
  "jh": "33a82427ab6e",
  "ko": "유유상종이라잖아. 우연히 비슷한 감성의 소유자가 모였을 뿐이야, 응"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 1,
  "jh": "afcb09d3776c",
  "ko": "내가 누구랑 닮았다는 거야!"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 8,
  "jh": "1de1390c96fd",
  "ko": "야, 적어도 난 정상이라고"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 2,
  "jh": "8ede34aa0194",
  "ko": "심한 모욕…"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 9,
  "jh": "77c7503b4d13",
  "ko": "하하하. 그런 반응하는 데가 꼭 닮았어"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 1,
  "jh": "cffcc6f770c6",
  "ko": "우아~! 그 위에서 내려다보는 시선이 열받아! 역시 납득 못 해~!"
 },
 {
  "key": "m59",
  "kind": 0,
  "chr": 9,
  "jh": "abaab4e28927",
  "ko": "음~ 그렇게까지 말한다면… 페페론, 잠깐 괜찮아?"
 },
 {
  "key": "m60",
  "kind": 0,
  "chr": 6,
  "jh": "f9343f11f5bc",
  "ko": "응… 그래도 봐줘"
 },
 {
  "key": "m61",
  "kind": 0,
  "chr": 9,
  "jh": "37a5c6ca244d",
  "ko": "알고 있어. 여성 다루는 데서 내가 실수할 것 같아?"
 },
 {
  "key": "m62",
  "kind": 0,
  "chr": 1,
  "jh": "d4c054afc441",
  "ko": "뭘 소곤소곤 얘기해"
 },
 {
  "key": "m63",
  "kind": 0,
  "chr": 9,
  "jh": "468cae7521b7",
  "ko": "남자끼리의 비밀 얘기야. 그보다 잠깐 이리 와 봐"
 },
 {
  "key": "m64",
  "kind": 0,
  "chr": 1,
  "jh": "07deac5fbf10",
  "ko": "어? 응…"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 9,
  "jh": "c16d965acd53",
  "ko": "그쯤에서. 자, 내 눈을 가만히 바라봐"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 1,
  "jh": "4debe710b975",
  "ko": "네 눈을? 이렇게?"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 9,
  "jh": "a238d5d5390a",
  "ko": "그래. 그대로 가만히…"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 1,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 9,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 1,
  "jh": "c0fd95ce2d87",
  "ko": "……으…"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 9,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 1,
  "jh": "36dce6f4022e",
  "ko": "으, 읏… 하아… 응… 아아…"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 9,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 1,
  "jh": "4899c46054f4",
  "ko": "으, 아아아… 아, 안 돼! 더 이상은…!!"
 },
 {
  "key": "m75",
  "kind": 2,
  "chr": 9,
  "jh": "5ddcad92caa6",
  "ko": "알아줬으려나? 그럼 난 실례하지. 여자애를 기다리게 하고 있어서"
 },
 {
  "key": "m76",
  "kind": 2,
  "chr": 1,
  "jh": "c0345928b608",
  "ko": "하아, 하아…"
 },
 {
  "key": "m77",
  "kind": 2,
  "chr": 8,
  "jh": "688f42f3a7c1",
  "ko": "어이어이, 괜찮냐?"
 },
 {
  "key": "m78",
  "kind": 2,
  "chr": 6,
  "jh": "dbba52288ecc",
  "ko": "위험했네. 그가 진심이었다면 지금쯤 누나도…"
 },
 {
  "key": "m79",
  "kind": 2,
  "chr": 1,
  "jh": "1ff98ddeb813",
  "ko": "부, 분해… 고토 따위한테 설레다니…!!"
 },
 {
  "key": "m80",
  "kind": 2,
  "chr": 2,
  "jh": "73d8c66d7760",
  "ko": "울리카랑 탈인형 씨랑 우류… 의외로 어울리는 가족이…"
 },
 {
  "key": "m81",
  "kind": 2,
  "chr": 1,
  "jh": "f8980dce5c95",
  "ko": "그만해! 말하지 마! 아~ 왠지 얼굴이 뜨거워… 찬물이라도 뒤집어쓰고 올게!"
 },
 {
  "key": "m82",
  "kind": 0,
  "chr": 8,
  "jh": "8c90607c241a",
  "ko": "즉 그건가. 우리랑 있을 때 고토는…"
 },
 {
  "key": "m83",
  "kind": 0,
  "chr": 6,
  "jh": "1beda8a47db9",
  "ko": "응. 힘을 아끼고 있는 거야. 미남력을!"
 },
 {
  "key": "m84",
  "kind": 0,
  "chr": 2,
  "jh": "fec979260e7e",
  "ko": "안이한 이름… 일단 탈인형 씨가 방심할 수 없다는 건 알았어…"
 },
 {
  "key": "m85",
  "kind": 0,
  "chr": 8,
  "jh": "8051e3491a28",
  "ko": "그 누나가 저렇게 될 정도니까…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]