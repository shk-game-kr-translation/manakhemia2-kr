 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 9,
  "jh": "f76bcafa6926",
  "ko": "…화났어?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 18,
  "jh": "78bdd861f1e5",
  "ko": "당연하죠. 눈앞에서 그런 행위를 보여 주시니 화도 나죠"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 9,
  "jh": "60317f6b5948",
  "ko": "보여 줄 생각은 없었는데. 하지만 그거야말로 나의 진짜…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 18,
  "jh": "9575dd4d0d46",
  "ko": "착각하지 마세요. 화가 난 건 당신이 아니라… 저 자신에게예요"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 9,
  "jh": "5590ff801110",
  "ko": "어?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 18,
  "jh": "cf1a22f5007e",
  "ko": "제가 경솔한 행동을 해서… 쓸데없는 신경을 쓰게 해서 그런 짓까지…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 9,
  "jh": "2bca05ad27af",
  "ko": "아니, 아니야. 그건 아니야"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 18,
  "jh": "6736cc1fca36",
  "ko": "얌전한 여자로 있었다면… 나잇값도 못 하고 독점욕 같은 걸 드러내지 않았다면…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 18,
  "jh": "650f3147a355",
  "ko": "…고토 님도 실망하셨죠?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 9,
  "jh": "1ee161ff7338",
  "ko": "넌 잘못 없어. 잘못한 건 나야. 내가 네 다정함에 기대서 제멋대로…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 18,
  "jh": "11753832ef10",
  "ko": "…고마워요. 그래도 이제 됐어요"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 9,
  "jh": "d63be4fb0282",
  "ko": "마루타…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 18,
  "jh": "a58b31ba48cc",
  "ko": "저는 당신에게 어울리는 여자가 아니었어요. 그뿐이에요"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 18,
  "jh": "d40ee0421f06",
  "ko": "충분히 즐거운 시간을 보냈어요. 그러니 이제… 저는 물러날게요"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 9,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 18,
  "jh": "25a8872a7893",
  "ko": "할 얘기는 그것뿐이에요. 돌아가 주세요"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 9,
  "jh": "be31143ee17d",
  "ko": "…난 못난 남자야. 이럴 때 해야 할 말을 못 찾다니…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 18,
  "jh": "11eadd9a4e7e",
  "ko": "아무 말도 하지 마세요. 제발… 부탁이니까…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 9,
  "jh": "e38626769030",
  "ko": "…미안해"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 18,
  "jh": "0ef94bb75156",
  "ko": "…아직, 뭔가?"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 9,
  "jh": "7d23af0f3256",
  "ko": "넌 이렇게 말했지. 나에게 어울리는 여자가 아니었다고"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 18,
  "jh": "19eb0edede97",
  "ko": "네…"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 9,
  "jh": "811eba61c807",
  "ko": "나도 마찬가지야. 난 아직 미숙해서 너에게 어울리는 남자가 되지 못했어…"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 18,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 9,
  "jh": "fdf873e054fd",
  "ko": "하지만 언젠가… 언젠가 너에게 해야 할 말을 찾으면…"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 9,
  "jh": "bf50f202c844",
  "ko": "그때까지 안녕. 마루타"
 },
