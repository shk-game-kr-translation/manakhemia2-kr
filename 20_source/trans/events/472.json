[
 {
  "key": "m0",
  "kind": 2,
  "chr": 43,
  "jh": "714a2623e729",
  "ko": "어머? 돌아왔어?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "c7f948bb7cf2",
  "ko": "응, 좀 신경 쓰여서… 에잇!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 43,
  "jh": "ab412c631014",
  "ko": "으악, 뭘…! 이, 이건… 소금이냐!?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "2a321db8fcb2",
  "ko": "아, 역시 효과 있다. 에잇, 에잇!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 43,
  "jh": "ab1acb341b35",
  "ko": "싫어! 그만해! 싫어어어어!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "615dab9fa8eb",
  "ko": "에잇! 얍! 하앗!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 43,
  "jh": "1440f4f87236",
  "ko": "이, 이제 그만… 아, 아아아아아아!!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 2,
  "jh": "a3e8a1e6910a",
  "ko": "음… 아. 원래대로 돌아…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "902f3dbf57f0",
  "ko": "우랴! 덤벼! 받아라아!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 2,
  "jh": "43bd05b6e600",
  "ko": "아얏… 이제 돌아왔으니까 그만해…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "1f68f3d7babb",
  "ko": "이래도냐! 으랴아아! 마무리이이!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "ab614b9ec978",
  "ko": "작작 좀 해"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "32451dc8dcf1",
  "ko": "아, 평소의 클로에다"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "cddf96e1dbb7",
  "ko": "소금 너무 뿌렸어… 짜"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "d1a200b76309",
  "ko": "…그래도 잘 알아챘네. 내가 아니란 걸…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "21cbb7730abf",
  "ko": "그야 그렇지. 10년 넘게 알고 지냈는데"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 2,
  "jh": "d20b62ebb524",
  "ko": "음… 조금은 기쁠지도…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "7e6844c9e26f",
  "ko": "애초에 클로에가 그런 서툰 거짓말을 할 리 없고… 그러게, 만약 진짜로 실패했다면…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "16362eacc2b2",
  "ko": "씐 척하면서 생각나는 대로 온갖 나쁜 짓을 할 것 같아. 악마 탓으로 돌리고"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 2,
  "jh": "2df0953613b2",
  "ko": "…방금 말 취소"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "76f42619e782",
  "ko": "어? 뭐라고 했어?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "00acb4975472",
  "ko": "아무것도 아니야… 일단 고맙다고는 해 둘게"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "e2705cde7cbf",
  "ko": "그래그래, 감사하라고. 내가 없었으면 어떻게 됐을지"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "2ae1f0f2bd02",
  "ko": "조금 칭찬하면 금방 우쭐해져… 그래도 고마워"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "293d0f74054f",
  "ko": "천만에. 이걸로 질렸으면 당분간 저주는 자제해"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "2050927b738b",
  "ko": "그건 무리…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "4049d85c4dcf",
  "ko": "왜? 실패했을 때 정도는 좀…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 2,
  "jh": "09c7431b6ebf",
  "ko": "날 못 알아본 세 사람한테 조금 벌을 줘야 해서…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "d85b077e126f",
  "ko": "아아, 뭐… 적당히 해"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 2,
  "jh": "11e705ddc358",
  "ko": "알고 있어… 우후후후…"
 },
 {
  "key": "m30",
  "kind": 5,
  "chr": 8,
  "jh": "70513859bd63",
  "ko": "으악! 아얏! 아야야야야!"
 },
 {
  "key": "m31",
  "kind": 5,
  "chr": 6,
  "jh": "8788014dd748",
  "ko": "누나! 아파! 잠, 드, 드, 등! 등은 안 돼!"
 },
 {
  "key": "m32",
  "kind": 5,
  "chr": 9,
  "jh": "2009df86d404",
  "ko": "난 그런 취미는… 노오오오오!"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 1,
  "jh": "b1e3db4e248d",
  "ko": "벌써 하고 있네… 전혀 조금이 아닌 게 클로에답다니까…"
 },
 {
  "key": "m34",
  "kind": 5,
  "chr": 8,
  "jh": "f1816ee2cced",
  "ko": "야, 진짜 봐줘!"
 },
 {
  "key": "m35",
  "kind": 5,
  "chr": 6,
  "jh": "10108487e583",
  "ko": "무서워, 검은 누나 눈이 무서워!"
 },
 {
  "key": "m36",
  "kind": 5,
  "chr": 9,
  "jh": "d867bb874b7c",
  "ko": "아아아! 왠지 쾌감이 되어 가… 오오오오!"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 1,
  "jh": "b2d5d4d73136",
  "ko": "슬슬 말리러 가는 게 좋으려나… 아이고"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]