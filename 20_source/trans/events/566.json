 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 23,
  "jh": "a0f65689d056",
  "ko": "와요! 정신 바짝 차려요!"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 0,
  "jh": "7ea7b0907d7f",
