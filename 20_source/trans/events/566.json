 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 22,
  "jh": "6fa0fa908624",
  "ko": "무슨 뜻이냐?"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 54,
  "jh": "46a1051d35f8",
