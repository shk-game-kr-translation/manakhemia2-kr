 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 22,
  "jh": "8a3443af9cb1",
  "ko": "한 명당 33.3명… 쉽지 않군"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "c6b3c443554f",
  "ko": "0.3마리 취급이 신경 쓰이는데… 푸니"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 23,
  "jh": "921da868125a",
  "ko": "말끝에 푸니를 붙인다고 되는 게 아니에요. 제대로 해 주세요"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "5af7a498a2e6",
