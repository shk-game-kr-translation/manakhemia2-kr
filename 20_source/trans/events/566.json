 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 22,
  "jh": "9967e3af2c1c",
  "ko": "방금 걸로 대략 스무 명쯤인가"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 23,
  "jh": "6c3328206c92",
  "ko": "이 상태라면 어떻게든 될 것 같아. 로제 씨가 협력해 준 덕분이에요"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 0,
  "jh": "a9c0158ea4cb",
