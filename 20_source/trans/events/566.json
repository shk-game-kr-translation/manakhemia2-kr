  "kind": 0,
  "chr": 54,
  "jh": "3fb5f122d9fa",
  "ko": "네놈들에게 반감을 가진 모든 푸니푸니를 모았다"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 54,
  "jh": "df59c42f320c",
