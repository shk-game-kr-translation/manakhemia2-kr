 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 107,
  "jh": "782d454be405",
  "ko": "젠장, 대체 어쩌란 거야…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 7,
  "jh": "a2824fe79267",
  "ko": "어, 어쩌지? 나 연금술 별로 잘 못하는데…"
