 },
 {
  "key": "m17",
  "kind": 5,
  "chr": 12,
  "jh": "df92071c19af",
  "ko": "크크크크크… 하~하하하!"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 81,
  "jh": "54f9923e3f0d",
