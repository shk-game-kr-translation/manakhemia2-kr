[
 {
  "key": "m0",
  "kind": 0,
  "chr": 2,
  "jh": "e560dad799ba",
  "ko": "…뭔가 시끄럽네"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 6,
  "jh": "f4dacf3772fe",
  "ko": "싸움이라도 하나?"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 1,
  "jh": "8667a45a56e3",
  "ko": "와앗!? 누구? 뭐야? 갑자기…"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 8,
  "jh": "78877fe6a3f1",
  "ko": "쉿! 조용히 해! 잠깐만 숨겨 줘!"
 },
 {
  "key": "m4",
  "kind": 5,
  "chr": 7,
  "jh": "7e9da31d3570",
  "ko": "이놈~ 에나~ 어디 갔어~? 킁킁킁… 여기다!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 7,
  "jh": "192fcc49b07d",
  "ko": "역시 있었다! 찾았다, 에나!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 8,
  "jh": "7c1b12b9d56b",
  "ko": "냄새로 쫓아오지 마! 진짜 인간 맞냐, 너!?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "fcb45d698e06",
  "ko": "잠깐, 남의 아틀리에에서 떠들지 마… 잠깐, 너 비아냥남의 동료!?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 7,
  "jh": "23e76efa015f",
  "ko": "아, 울리카였나? 안녕~"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "65eb84f13753",
  "ko": "아, 안녕… 이 아니라! 뭐 하러 왔어!?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 7,
  "jh": "7d320bf18672",
  "ko": "동생 쫓아왔어. 정말, 왜 내 얼굴만 보면 도망가~?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "aa5ca8322f6d",
  "ko": "…사이 나빠?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 7,
  "jh": "95a7bc4ac5a1",
  "ko": "전혀 안 그래. 이웃도 부러워하는 사이좋은 남매야"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 8,
  "jh": "958461ba3e9b",
  "ko": "그렇게 생각하는 건 너뿐이야! 자기 편한 대로 기억 날조하지 마!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 7,
  "jh": "36ac124206a2",
  "ko": "나, 날조…? 어려운 말 쓰지 마. 아무튼 자, 우리 아틀리에로 와"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 8,
  "jh": "5a80c68eef7a",
  "ko": "싫어! 절대 싫어! 죽어도 싫어!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 7,
  "jh": "3b619792e0f7",
  "ko": "정말, 부끄럼쟁이라니까~ 그렇게 부끄러워하지 않아도 되는데"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 8,
  "jh": "51fbcce786d9",
  "ko": "딱히 부끄러운 게 아니라… 그래, 맞다. 미안하지만 이제 무리야"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 8,
  "jh": "7affa806f719",
  "ko": "실은 나, 이 누나들 아틀리에에 들어와 버렸거든"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 7,
  "jh": "bc527a48cf6b",
  "ko": "에에? 언제!?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 8,
  "jh": "70db7568dfe1",
  "ko": "그게… 방금. 그러니까 포기해, 응?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 7,
  "jh": "00786f6f89d6",
  "ko": "방금이구나… 그럼 어쩔 수 없지…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 2,
  "jh": "e18147080634",
  "ko": "그걸로 납득하는구나…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 7,
  "jh": "7c6462e15b95",
  "ko": "으으… 부족한 동생이지만 잘 부탁드려요…"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 7,
  "jh": "71bcc4516c0a",
  "ko": "쓸쓸해지면 언제든 누나한테 돌아와야 해…"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 8,
  "jh": "92c192bbd3bb",
  "ko": "바~보. 누가 돌아가냐"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 2,
  "jh": "ca48f63c207b",
  "ko": "그게, 에나였나…? 누나를 싫어해…?"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 8,
  "jh": "f583dd7fe3f8",
  "ko": "보면 알잖아. 저 녀석이랑 떨어지려고 일부러 이 학교에 들어왔는데…"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 8,
  "jh": "6f96b4d0af56",
  "ko": "잠깐, 남한테 할 얘기는 아니지. 그럼, 소란 피워서 미안했다"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 1,
  "jh": "7953f72a4b1b",
  "ko": "페페론"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 6,
  "jh": "2c7631d48ae1",
  "ko": "맡겨 줘, 누나"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 8,
  "jh": "9ce856336589",
  "ko": "우왓! 뭐, 뭐야 너? 이상한 차림을 하고… 방해돼. 비켜"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 6,
  "jh": "95d69e2fa014",
  "ko": "왜 나가는 거야? 형은 이제 이 아틀리에 일원이잖아?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 8,
  "jh": "da116f503977",
  "ko": "기분 나쁘게 부르지 마! 애초에 그건 바보 누나를 속이려고…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "4d3babb09ee1",
  "ko": "설마 진짜로 동료가 되고 싶은 사람이 굴러 들어올 줄은 몰랐어"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 2,
  "jh": "b2e4da33921c",
  "ko": "이런 일도 있구나…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 8,
  "jh": "84db5f4397bb",
  "ko": "우, 웃기지 마! 이런 녀석이 있는 아틀리에는 사양이야!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 6,
  "jh": "8a961a87b3ba",
  "ko": "앞으로 잘 부탁해, 형"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 8,
  "jh": "0c36a4da4c28",
  "ko": "다, 다가오지 마! 크… 이것도 전부 바보 누나 탓이다~~~!"
 },
 {
  "key": "m39",
  "kind": 5,
  "chr": -1,
  "jh": "5316402bd62c",
  "ko": "「{CLRE}에나{CLNR}」가 동료가 되었습니다."
 },
 {
  "key": "m40",
  "kind": 5,
  "chr": -1,
  "jh": "3a86591804a4",
  "ko": "파티 멤버가 4명이 되어 {CLRE}대열{CLNR}을 변경할 수 있게 되었습니다."
 },
 {
  "key": "m41",
  "kind": 5,
  "chr": -1,
  "jh": "662d57b391b4",
  "ko": "{CLRE}대열{CLNR} 도움말을 보시겠습니까?"
 },
 {
  "key": "m42",
  "kind": 5,
  "chr": -1,
  "jh": "28e7f45a2a0a",
  "ko": "{CLRE}대열{CLNR}에서는 전투에 참가할 멤버를 전위와 서포트로 설정할 수 있습니다."
 },
 {
  "key": "m43",
  "kind": 5,
  "chr": -1,
  "jh": "9143ba221122",
  "ko": "전위 멤버는 처음부터 전투에 참가하는 멤버입니다."
 },
 {
  "key": "m44",
  "kind": 5,
  "chr": -1,
  "jh": "5db5b5aee40c",
  "ko": "최소 한 명의 멤버를 전위로 설정해야 합니다."
 },
 {
  "key": "m45",
  "kind": 5,
  "chr": -1,
  "jh": "0880bd93f3cf",
  "ko": "또 서포트로 설정된 멤버는 전위 멤버의 교대 요원이 되며,"
 },
 {
  "key": "m46",
  "kind": 5,
  "chr": -1,
  "jh": "cc097a288a2f",
  "ko": "{CLRE}서포트 액션{CLNR}으로 공방 중에 전위와 교대할 수 있습니다."
 },
 {
  "key": "m47",
  "kind": 5,
  "chr": -1,
  "jh": "61f5aa6677ef",
  "ko": "기본 구성은 {CLRE}전위에 세 명을 두고 나머지를 서포트로 하는{CLNR} 방법이지만,"
 },
 {
  "key": "m48",
  "kind": 5,
  "chr": -1,
  "jh": "97a8ce490b5b",
  "ko": "전투에 익숙해지면 다른 구성을 시험해 보는 것도 좋겠지요."
 },
 {
  "key": "m49",
  "kind": 5,
  "chr": -1,
  "jh": "406566478363",
  "ko": "{CLRE}서포트 액션{CLNR}에 대해서는 다음 전투에서 자세히 설명합니다."
 },
 {
  "key": "m50",
  "kind": 5,
  "chr": -1,
  "jh": "c6a550d79753",
  "ko": "「{CLRE}도움말{CLNR}」의 「{CLRE}시스템{CLNR}」에 새로운 항목이 추가되었습니다."
 },
 {
  "key": "m51",
  "kind": 5,
  "chr": -1,
  "jh": "79da7c8bf517",
  "ko": "「{CLRE}도움말{CLNR}」은 메뉴의 「{CLRE}도감{CLNR}」에서 확인할 수 있습니다."
 },
 {
  "key": "m52",
  "kind": 5,
  "chr": -1,
  "jh": "6c3c7e1e03e2",
  "ko": "대열은 메뉴에서 선택할 수 있습니다."
 },
 {
  "key": "m53",
  "kind": 5,
  "chr": -1,
  "jh": "0df8accc42c0",
  "ko": "대열을 고르면 선택한 멤버가 화면처럼 깜빡입니다."
 },
 {
  "key": "m54",
  "kind": 5,
  "chr": -1,
  "jh": "5e3646e5cb14",
  "ko": "멤버 얼굴이 {CLRE}왼쪽{CLNR}이면 전위, {CLRE}오른쪽{CLNR}이면 서포트입니다."
 },
 {
  "key": "m55",
  "kind": 5,
  "chr": -1,
  "jh": "dc1f97fd840d",
  "ko": "대열 전환은 바꿀 멤버에 맞춘 상태에서 방향키 좌우로 합니다."
 },
 {
  "key": "m56",
  "kind": 5,
  "chr": -1,
  "jh": "1fa1797d6864",
  "ko": "이렇게 전위와 서포트가 바뀝니다."
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]