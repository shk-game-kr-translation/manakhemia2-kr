[
 {
  "key": "m0",
  "kind": 2,
  "chr": 12,
  "jh": "d27a65208f82",
  "ko": "드디어 왔군. 늦었다, 울리 뭐시기"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "12fafac6af56",
  "ko": "울리카야! 울리카! 남의 이름 정도는 제대로 외워!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "30d1dbb01e9c",
  "ko": "여전히 시끄럽네. 네가 올 때까지 이쪽은 기다리고 있었거든"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "699ad381ad06",
  "ko": "흥… 애초에 왜 이 녀석들이랑 같이야"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "cd18cca7c768",
  "ko": "그건 내가 할 소리야. 왜 시골뜨기 같은 애랑 같이…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "b2e6bf39242e",
  "ko": "시골뜨기 그만하라고 했잖아!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 12,
  "jh": "31a0d3d5af48",
  "ko": "에잇, 조용히 해라! 언제까지고 얘기를 시작할 수가 없잖나"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "839c0725c18e",
  "ko": "뜸 들이지 말고 빨리 얘기해 줬으면 하는데…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 2,
  "jh": "e44a3b25a276",
  "ko": "싫은 일은 얼른 끝내고 싶어…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 12,
  "jh": "75d8eedddbb1",
  "ko": "에헴… 너희는 이 몸의 사랑스러운 제자들이다"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 12,
  "jh": "61cd76038188",
  "ko": "그 사랑스러운 제자들이 마음에 근심을 품은 채 졸업을 맞이하려 하고 있다…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 12,
  "jh": "22171618db71",
  "ko": "그에 마음 아파한 이 몸이 이런 걸 준비했다! 자, 봐라!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 7,
  "jh": "cd9d46179d6e",
  "ko": "…이게 뭐야? 뭔가의 입구?"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 12,
  "jh": "47f6de0be7bd",
  "ko": "듣고 놀라라. 이것이야말로 이 몸이 비밀리에 만든 숨겨진 통로…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 12,
  "jh": "183cc056687e",
  "ko": "그 끝은 무려 빛의 마나가 사는 곳으로 이어져 있다!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 0,
  "jh": "92cb81f936a2",
  "ko": "뭐, 라고…?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "cf7bf5199ac7",
  "ko": "빛의 마나의…? 정말로?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 9,
  "jh": "383e84909ed0",
  "ko": "여전히 하는 일이 스케일이 크군"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 6,
  "jh": "29e3c8ae1045",
  "ko": "대체 어떻게 만들었을까"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 2,
  "jh": "d17f739c2479",
  "ko": "이 사람한테 상식을 묻는 건 무의미…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 12,
  "jh": "0e46639f51a2",
  "ko": "자, 사양 마라. 여기를 지나 빛의 마나를 한 대 패고 와라!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "a5b8cf1e4548",
  "ko": "아니, 잠깐만요. 확실히 한 대 패고 싶다곤 생각했지만…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 0,
  "jh": "f60ccf8354b2",
  "ko": "갑자기 그러니까… 어안이 벙벙해서…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 12,
  "jh": "839cedb8622d",
  "ko": "왜 그러냐? 뭘 중얼거리고 있나"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 7,
  "jh": "96beda8cc87e",
  "ko": "맞아! 빨리 가자!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 5,
  "jh": "7adf9ba468d3",
  "ko": "푸니! 푸니~!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 23,
  "jh": "58eb7851f4e6",
  "ko": "여동생도 새로운 세계로의 여행에 흥분을 감추지 못하는 모양이에요"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 3,
  "jh": "021ea1376eae",
  "ko": "이거 정말 괜찮은 거겠지…?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 8,
  "jh": "eeb7a84645d8",
  "ko": "믿을 만한 게 아니잖아…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 2,
  "jh": "8c7668ab414b",
  "ko": "입구를 빠져나가면 거기는… 입으로는 말할 수 없는 세계가 펼쳐져서…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 0,
  "jh": "f890581b5b07",
  "ko": "애초에 빛의 마나는 다른 세계에 사는 거 아니었어?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 4,
  "jh": "94d9c2a13bec",
  "ko": "그 부분은 나도 자세히 알고 싶군"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 4,
  "jh": "326020cae221",
  "ko": "아무래도 이쪽 세계 출신이라 저쪽 세계라는 걸 모른다"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 11,
  "jh": "0625600f9e3d",
  "ko": "저도요… 그렇게 생각하니 역시 무섭네요…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 12,
  "jh": "bbcd3155e22e",
  "ko": "언제까지 중얼중얼… 에잇! 귀찮다! 이렇게 해 주마!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "a89d6245cf84",
  "ko": "어? 와아아!? 미, 밀지 마… 으아아아아!!"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 1,
  "jh": "9e397471ef30",
  "ko": "꺄아아아아!!"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 0,
  "jh": "3b8843c9d68a",
  "ko": "으, 으아아아!!"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 3,
  "jh": "0f7ec34579c4",
  "ko": "잠, 그만… 싫어어어어!"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 7,
  "jh": "e7f13bd5d44e",
  "ko": "와, 와… 아하하하하!"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 12,
  "jh": "44be4ac2d837",
  "ko": "후우… 겨우 갔군. 나머진 너희 노력에 달렸다! 힘내라!"
 },
 {
  "key": "m41",
  "kind": 5,
  "chr": 13,
  "jh": "7cea99191065",
  "ko": "이런이런… 학교 안에 너무 이상한 거 만들지 말아 줬으면 하는데"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 12,
  "jh": "e5934aa80834",
  "ko": "뭐냐, 있었나. 여전히 존재감 없는 남자로군"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 13,
  "jh": "a97accc60a74",
  "ko": "그렇지. 요즘은 점점 출번이… 잠깐 무슨 말을 시키는 거야!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 12,
  "jh": "86284c2ba457",
  "ko": "자각하고 있으니 다행이다"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 13,
  "jh": "c9dde7b0f8d6",
  "ko": "뭐, 그건 그렇다 치고… 그 애들 괜찮은 거겠지?"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 12,
  "jh": "189bfbe151d6",
  "ko": "당연하다. 이 몸이 단련시킨 학생들을 얕보지 마라"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 13,
  "jh": "5ab0a6a7473a",
  "ko": "아니, 그런 게 아니라… 하아, 뭐 됐나. 그런데 의외네"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 12,
  "jh": "684f722f77fa",
  "ko": "의외라니?"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 13,
  "jh": "e37d8d36d018",
  "ko": "그 애들, 빛의 마나를 만나러 가는 거잖아?"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 13,
  "jh": "7d64ed86b189",
  "ko": "그런 재밌어 보이는 얘기에 자네가 안 따라가다니"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 12,
  "jh": "923241f9492a",
  "ko": "그 녀석과의 승부는 이미 끝났으니까"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 13,
  "jh": "e9a3227749b9",
  "ko": "어? 승부가 끝났다니…?"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 12,
  "jh": "5ab1b384b74a",
  "ko": "자, 배나 채우러 갈까. 따라와라. 가끔은 얻어먹어 주마"
 },
 {
  "key": "m54",
  "kind": 0,
  "chr": 13,
  "jh": "25ee684a6bbf",
  "ko": "왜, 왜 내가 사야…"
 },
 {
  "key": "m55",
  "kind": 0,
  "chr": 13,
  "jh": "f474dbb95ce2",
  "ko": "가 아니라, 방금 그건 무슨 뜻이야? 응!?"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 1,
  "jh": "19c201851c93",
  "ko": "아야야야… 정말! 갑자기 집어던지지 마!"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 0,
  "jh": "74ba7fdd1ae4",
  "ko": "여기서 불평해도 안 들릴걸"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 9,
  "jh": "e0ad4606dfb9",
  "ko": "여전히 난폭하군, 그는… 자, 아가씨. 이제 어쩔 거야?"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 1,
  "jh": "7297934753c6",
  "ko": "그거야 뻔하잖아. 얼른 빛의 마나라는 녀석한테 가자"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 2,
  "jh": "fb90bf45867d",
  "ko": "이미 가는 건 결정이구나…"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 1,
  "jh": "133749d7fb2d",
  "ko": "당연하지. 너도 갈 거지?"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 0,
  "jh": "26adc92d6159",
  "ko": "…어쩔 수 없지. 어울려 주마"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 4,
  "jh": "be96a2cf0071",
  "ko": "어쩔 수 없다는 얼굴로는 안 보이는데"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 7,
  "jh": "ec2d80fdb40e",
  "ko": "물론 나도 갈래~!"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 5,
  "jh": "2801c58ba4f1",
  "ko": "푸니! 니~!"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 6,
  "jh": "efd53eb2c56d",
  "ko": "요정계, 인간계에 이어 다음은 마나 세계에 이 몸의 이름을 떨칠 기회!"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 3,
  "jh": "59982b9a0448",
  "ko": "아~ 정말! 좀 진정해! 너무 들떴어, 너희는!"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 3,
  "jh": "752364a93d99",
  "ko": "갈 거면 가는 대로 그만한 준비를 해야지"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 9,
  "jh": "4a51de1f3e99",
  "ko": "준비도 그렇지만 이만한 대인원이니 이것저것 정해 두는 게 좋겠어"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 2,
  "jh": "2b8f3abea130",
  "ko": "제멋대로인 사람들뿐이니까…"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 11,
  "jh": "d1c6cdc5e93d",
  "ko": "아가씨 너무 화나게 하지 마세요… 나중에 제가 힘들어요…"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 1,
  "jh": "39621d0f22bb",
  "ko": "으음… 답답하네. 그럼 얼른 정해 버리자"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 3,
  "jh": "e43ab07282fb",
  "ko": "일단 이 정도네…"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 3,
  "jh": "bf795ef14d8a",
  "ko": "학교엔 언제든 돌아갈 수 있는 모양이니 위험하다 싶으면 한 번 돌아가면 돼"
 },
 {
  "key": "m75",
  "kind": 2,
  "chr": 1,
  "jh": "52c5956921d9",
  "ko": "겨우 끝났어? 좋~아, 그럼 가자! 타도, 빛의 마나!"
 },
 {
  "key": "m76",
  "kind": 5,
  "chr": 36,
  "jh": "8bc4cb890d4e",
  "ko": "오~!"
 },
 {
  "key": "m77",
  "kind": 5,
  "chr": -1,
  "jh": "b5418b3c555c",
  "ko": "{CLRE}엑스트라 시나리오{CLNR}에서는 모든 멤버를 전투에 사용할 수 있습니다."
 },
 {
  "key": "m78",
  "kind": 5,
  "chr": -1,
  "jh": "fe53f8a99879",
  "ko": "단, 한 번에 {CLRE}선택할 수 있는 멤버는 6명까지{CLNR}입니다."
 },
 {
  "key": "m79",
  "kind": 5,
  "chr": -1,
  "jh": "73a1b8ca8959",
  "ko": "또 조작 중인 {CLRE}주인공은 뺄 수 없으니{CLNR} 주의하세요."
 },
 {
  "key": "m80",
  "kind": 5,
  "chr": -1,
  "jh": "a350d6f78e4f",
  "ko": "멤버를 변경하고 싶을 때는 한 번 학원으로 돌아가 {CLRE}군나르 교감{CLNR}과 대화하세요."
 },
 {
  "key": "m81",
  "kind": 5,
  "chr": -1,
  "jh": "5b1205610984",
  "ko": "「{CLRE}도움말{CLNR}」의 「{CLRE}시스템{CLNR}」에 새로운 항목이 추가되었습니다."
 },
 {
  "key": "m82",
  "kind": 5,
  "chr": -1,
  "jh": "55291ff330e5",
  "ko": "「{CLRE}도움말{CLNR}」은 메뉴의 「{CLRE}도감{CLNR}」에서 확인할 수 있습니다."
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]