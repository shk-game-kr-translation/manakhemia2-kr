[
 {
  "key": "m0",
  "kind": 0,
  "chr": 55,
  "jh": "192403b5fec4",
  "ko": "형님…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 54,
  "jh": "ed306d712f71",
  "ko": "뭔데?"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 55,
  "jh": "88dbada33267",
  "ko": "우리, 계속 지기만 하고 있슴다…"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 54,
  "jh": "f243224719d9",
  "ko": "말하지 마! 다음에야말로 놈들을 납작하게 만들어 주는 거다!"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 55,
  "jh": "31516c953b8a",
  "ko": "아무리 노력해 봤자 푸니푸니는 결국 당하는 역인 걸까요…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 54,
  "jh": "bda1d65e46e1",
  "ko": "그렇게 치면 저놈들도 푸니푸니잖냐!"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 55,
  "jh": "787537b97e82",
  "ko": "왠지 이제 허무해졌슴다. 솔직히 아무래도 좋달까…"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 54,
  "jh": "3566fc16d2e8",
  "ko": "약한 소리 하지 마! 포기하지 않으면 언젠가 반드시…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 3,
  "jh": "5c97134b7309",
  "ko": "어머?"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 0,
  "jh": "3f157c341b68",
  "ko": "이 급한 때에…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 54,
  "jh": "0a82af000569",
  "ko": "헤헤헤… 제 발로 불 속에 뛰어드는 뭐시기가 바로 이거로군"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 56,
  "jh": "e342fba4ddfa",
  "ko": "그래도 그 형제가 안 보이는뎁쇼?"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 54,
  "jh": "0731d80858ab",
  "ko": "음, 듣고 보니…"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 5,
  "jh": "50eb6b6bce3b",
  "ko": "푸니, 푸니니. 푸니!"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 54,
  "jh": "1c68f6634439",
  "ko": "뭐!? 푸니푸니성 감모로 앓아누웠다고?"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 55,
  "jh": "50c54a336a65",
  "ko": "진짜임까!?"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 56,
  "jh": "1d6738a38cf0",
  "ko": "으아아! 다가오지 마! 병 옮는다!"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 11,
  "jh": "1df41b6eb6c8",
  "ko": "아뇨, 병에 걸린 건 타로 씨네고 양호실에서 쉬고 있으니까…"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 54,
  "jh": "77b5a09a9d88",
  "ko": "아, 그렇군. 여기엔 없었지… 후우, 놀래키기는…"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 56,
  "jh": "033144757dd0",
  "ko": "괜히 쫄았네…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 7,
  "jh": "e114498a9e58",
  "ko": "우리 약 캐러 가는 길이야. 그러니까 오늘은 상대 못 해"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 4,
  "jh": "1d3ee5985c5a",
  "ko": "적에게 정보를 너무 흘리는 건 어떨까 싶다만"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 7,
  "jh": "99ee49d34c0b",
  "ko": "앗, 그렇구나! 안 되지"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 0,
  "jh": "81433fdf76e1",
  "ko": "…뭐, 그런 거다. 방해한다면 힘으로라도…"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 54,
  "jh": "6bc5ba8181fb",
  "ko": "…가라. 내 마음이 바뀌기 전에"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 11,
  "jh": "c19c8f4f874e",
  "ko": "네…? 괜찮아요?"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 54,
  "jh": "16315262d48b",
  "ko": "아플 때 손대는 꼴사나운 짓은 못 하지. 자, 얼른 가!"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 0,
  "jh": "bd45c5129750",
  "ko": "아, 아아…"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 11,
  "jh": "c428f5f77583",
  "ko": "로제 씨, 여긴 호의를 받아들이죠"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 3,
  "jh": "74659e56800a",
  "ko": "의외로 말이 통하네. 다시 봤어"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 54,
  "jh": "96f6f52a94b1",
  "ko": "…갔나"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 55,
  "jh": "b00e03fcdfb1",
  "ko": "형님! 멋있었슴다. 짜릿했슴다!"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 54,
  "jh": "67f909d5ee3e",
  "ko": "크크크… 드디어 돌아왔군. 절호의 기회가…"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 55,
  "jh": "7434aa11c106",
  "ko": "네? 형님… 무슨 소리 하시는 검까?"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 54,
  "jh": "0c6496864dd4",
  "ko": "앞질러 가서 푸니마이트 풀을 전부 베어 버리는 거다"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 54,
  "jh": "e3d9b566e650",
  "ko": "그러면 그 형제는 며칠 만에 바싹바싹이 되는 거지"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 56,
  "jh": "f87d4aee5ab0",
  "ko": "오오, 나쁜 생각이네요!"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 55,
  "jh": "79068a9fc49d",
  "ko": "그, 그래도 그 녀석들은 푸니푸니성 감모로…"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 54,
  "jh": "7216a79e4b62",
  "ko": "뭘 중얼거리는 거냐? 자, 얼른 가자!"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 55,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]