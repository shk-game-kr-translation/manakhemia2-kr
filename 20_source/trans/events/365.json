[
 {
  "key": "m0",
  "kind": 2,
  "chr": 16,
  "jh": "1f645d03e31f",
  "ko": "왔나…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "56e599f0f890",
  "ko": "네가 빛의 마나구나"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 7,
  "jh": "3e8155dffcaa",
  "ko": "딱 빛의 마나 같은 느낌이네. 하얗고, 금발이고"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 16,
  "jh": "3dd1640015fe",
  "ko": "원래는 인간에게 모습을 보이는 것도 불쾌하다만. 오늘은 특별히…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "03a6268f873e",
  "ko": "하얗고 금발이라… 좀 뻔한 느낌도 들지만"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 11,
  "jh": "f99ff1f08edd",
  "ko": "음~ 듣고 보니… 꽤 평범하네요"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 4,
  "jh": "debceba0066f",
  "ko": "이름과 겉모습의 갭이라는 건 중요하니까. 한 번 더 비틀어 줬으면 하는 부분이다"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 9,
  "jh": "f2998b6c8ebf",
  "ko": "후후후, 그 점에서는 나랑 페페론이 완벽하지"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 6,
  "jh": "d83696400270",
  "ko": "겉모습은 팬시. 속은 댄디한 게 이 몸들의 셀링 포인트니까!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 16,
  "jh": "64bb7db3d8bf",
  "ko": "…네놈들, 내 얘기를 듣고 있는 거냐!?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 0,
  "jh": "cc5bd82e1889",
  "ko": "뭐, 순순히 얘기 들을 녀석들이 아니라서"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "776da3e24903",
  "ko": "할 얘기가 있는 건 이쪽이야. 너 때문에 실컷 험한 꼴 당했다고!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 16,
  "jh": "852f0c1c915a",
  "ko": "흥. 인간이 무슨 꼴을 당하든 내 알 바 아니다"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 10,
  "jh": "7f4b8bd0201e",
  "ko": "우! 우~!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 16,
  "jh": "242dd5aae347",
  "ko": "흠, 확실히 너에겐 나쁜 짓을 했군"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 16,
  "jh": "94d5cc3fa810",
  "ko": "하지만 이쪽에도 이쪽 사정이 있다. 갓 태어난 마나가 끼어들 문제가 아니야"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "278acf5cf344",
  "ko": "뭐야, 그 태도! 순순히 사과하면 용서해 줄까 했는데"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 16,
  "jh": "84d30eaefb75",
  "ko": "이 내가 사과해? 바보 같은 소리도 작작 하는군"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 7,
  "jh": "9083bab9f9bd",
  "ko": "우와, 재수 없는 녀석~ 성격 나빠 보여"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 5,
  "jh": "75264012baa0",
  "ko": "푸니, 푸니니~…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 23,
  "jh": "bd48957e19cc",
  "ko": "분명 친구도 없겠지. 쓸쓸한 남자다… 라며 여동생은 화를 넘어 동정하고 있어요"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 2,
  "jh": "f7ea69508694",
  "ko": "친구 없는 걸로 치면 울리카도 뒤지지 않아…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "fdc3051b207f",
  "ko": "나한테 넘기지 마. 그쪽이 그럴 거면 억지로라도 사과하게 해 주지!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 16,
  "jh": "81575c691b20",
  "ko": "흥. 이 나를 이길 셈이냐. 인간 따위가 너무 우쭐…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 7,
  "jh": "a56411f6c0d8",
  "ko": "그래도 졌잖아? 인간한테"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 16,
  "jh": "06ef6de52bc6",
  "ko": "뭣!? 왜 그걸!?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 7,
  "jh": "4a01f840708a",
  "ko": "아까 어둠의 마나 할아버지가 알려 줬어"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 16,
  "jh": "0df7d0619568",
  "ko": "큭… 쓸데없는 짓을…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 3,
  "jh": "4f9c33ff41d8",
  "ko": "그러니까 당신은 인간한테 져서 인간 혐오가 돼서 인간을 괴롭히고 있었던 거지"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 8,
  "jh": "3dbef942fd28",
  "ko": "그렇게 정리하니 구제불능이네…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 2,
  "jh": "b5895f28ce07",
  "ko": "네거티브 사고구나… 빛의 마나 주제에…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 16,
  "jh": "1a6939d5a02e",
  "ko": "으… 시끄러워 시끄러워! 닥쳐라!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 6,
  "jh": "a915e223315f",
  "ko": "오, 이건 꽤 훌륭한 적반하장이야"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 9,
  "jh": "762b5fdb22df",
  "ko": "여유가 없군. 위트 있는 농담이라도 하나 돌려줄 줄 알았는데"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 0,
  "jh": "3b6238bb39fe",
  "ko": "너희를 상대하면 누구라도 화낼 것 같은데"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 16,
  "jh": "9b14c3443c95",
  "ko": "이제… 이제 용서 못 한다! 인간 따위 전부 지워 버리겠다! 아아아아아!!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 2,
  "jh": "17d70cee9427",
  "ko": "그래서 일부러 화나게 해서 진심이 되게 만드는 거구나…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 7,
  "jh": "0518a6d77345",
  "ko": "좋잖아, 승부할 거면 진심이어야지!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "ca54eb1952dd",
  "ko": "자, 언제까지 떠들고 있어. 온다!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 16,
  "jh": "91dd3ce87465",
  "ko": "졌다… 또 졌다고…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 1,
  "jh": "f7b1a95cb9be",
  "ko": "어때, 항복이야? 자, 우리가 이겼으니까 사과해"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 10,
  "jh": "9dc66ada9e64",
  "ko": "우!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 16,
  "jh": "f990b193fd9b",
  "ko": "인정 못 한다… 절대 인정 못 해. 이런…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 6,
  "jh": "1ad240a74ffa",
  "ko": "포기를 모르네"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 2,
  "jh": "a91182d20932",
  "ko": "꼭 사과하게 하고 싶다면… 비장의 수단이…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 0,
  "jh": "4eec0fc479c6",
  "ko": "이제 됐잖아. 억지로 사과시켜 봤자 소용없고…"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 0,
  "jh": "78f7337e9627",
  "ko": "게다가 이 녀석을 한 대 패니까 꽤 후련해졌어"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 3,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 11,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 0,
  "jh": "7af0e6c4b124",
  "ko": "뭐예요? 그렇게 놀란 얼굴을 하고"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 3,
  "jh": "a43038abb127",
  "ko": "아니… 너치곤 꽤 솔직한 감상이다 싶어서"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 11,
  "jh": "c2e3ec9f8814",
  "ko": "네… 깜짝 놀랐어요"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 0,
  "jh": "fb429a5a3f1b",
  "ko": "따, 딱히 그렇게 놀랄 일은…"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 4,
  "jh": "e096a5f91c8e",
  "ko": "역시 나이에 맞게 솔직한 쪽이 호감이 가는군. 평소 넌 너무 폼을 잡아"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 0,
  "jh": "3d4bbabb3e43",
  "ko": "시끄러워. 쓸데없는 말 하지 마"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 7,
  "jh": "2faf10111879",
  "ko": "아~ 로제 쑥스러워한다. 귀여워~"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 5,
  "jh": "540040807188",
  "ko": "푸니니니~"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 0,
  "jh": "df279015d297",
  "ko": "놀리지 마! 정말…"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 6,
  "jh": "26aac0a2fdcd",
  "ko": "야아, 또 이 몸들의 전설에 새로운 한 페이지가 더해져 버렸네"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 9,
  "jh": "0e502d873bcf",
  "ko": "빛의 마나를 쓰러뜨린 사내들이라… 음~ 나쁘지 않군"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 8,
  "jh": "5d81b3ce7aed",
  "ko": "아무래도 좋지만 너무 무시하는 것도 불쌍하지 않냐?"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 16,
  "jh": "fabbc88f4a31",
  "ko": "…인간 따위가 나에게 동정을 베풀지 마라"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 2,
  "jh": "8c80919964b3",
  "ko": "패배자는 마음껏 짖게 내버려 두면 돼…"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 7,
  "jh": "4264c2c09319",
  "ko": "와, 왠지 그 대사 멋있다!"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 5,
  "jh": "04a65431011a",
  "ko": "푸니, 푸니~…"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 23,
  "jh": "e9d9841c97ce",
  "ko": "결정 대사 타이밍을 뺏겼다… 라며 여동생이 입술을 깨물고 있어요"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 3,
  "jh": "f7e63d5784b3",
  "ko": "자, 그럼 돌아갈까. 목적도 이뤘으니"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 11,
  "jh": "1581d56114dc",
  "ko": "그러게요. 이러니저러니 해도 지쳤어요…"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 1,
  "jh": "1e83e1132aba",
  "ko": "아~ 이걸로 기분 좋게 졸업할 수 있겠다. 가끔은 교감한테도 감사해야지!"
 },
 {
  "key": "m70",
  "kind": 0,
  "chr": 16,
  "jh": "a46e11e17c9d",
  "ko": "큭… 이놈… 이놈 이놈! 인간 놈…!"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 17,
  "jh": "6c66771469a7",
  "ko": "꽤 멋지게 졌구먼"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 16,
  "jh": "dc8f7d5d324a",
  "ko": "…일부러 비웃으러 돌아온 거냐?"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 19,
  "jh": "4729f37f2d70",
  "ko": "웃을 수 없습니다. 저도 그녀들에게 졌으니까요"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 17,
  "jh": "5987d132d601",
  "ko": "슬슬 이해하게. 우리 마나는 인간과 함께 있어야 의미가 있는 거라네"
 },
 {
  "key": "m75",
  "kind": 2,
  "chr": 17,
  "jh": "e5ffd0b062c7",
  "ko": "아무리 자네가 강해도 혼자서는 인간에게도 진다. 그게 현실이야"
 },
 {
  "key": "m76",
  "kind": 2,
  "chr": 16,
  "jh": "6a59bd0681f4",
  "ko": "그런 건… 인정 못 한다! 이번엔 우연히 졌을 뿐이다!"
 },
 {
  "key": "m77",
  "kind": 2,
  "chr": 17,
  "jh": "3a70b41f7c9f",
  "ko": "머리가 굳었구먼, 여전히… 이런 고집쟁이 부하 노릇 하느라 안 지치나?"
 },
 {
  "key": "m78",
  "kind": 2,
  "chr": 19,
  "jh": "6bd7a6619be1",
  "ko": "이젠 익숙해졌습니다"
 },
 {
  "key": "m79",
  "kind": 2,
  "chr": 16,
  "jh": "dd515333b4ad",
  "ko": "인간 따위… 인간 따위… 정말 싫다아아!"
 },
 {
  "key": "m80",
  "kind": 2,
  "chr": 17,
  "jh": "1d7144d2a581",
  "ko": "…후우. 뭐, 됐네. 우리에겐 시간이 얼마든지 있으니까"
 },
 {
  "key": "m81",
  "kind": 2,
  "chr": 17,
  "jh": "f14a10150369",
  "ko": "언젠간 알게 될 날도 오겠지…"
 },
 {
  "key": "m82",
  "kind": 2,
  "chr": 7,
  "jh": "9add101d5fde",
  "ko": "다녀왔어~! 어라? 군나르 선생님은?"
 },
 {
  "key": "m83",
  "kind": 2,
  "chr": 0,
  "jh": "b598745d5039",
  "ko": "없는 것 같군"
 },
 {
  "key": "m84",
  "kind": 2,
  "chr": 1,
  "jh": "6ce56ba22b2c",
  "ko": "정말, 모처럼 고맙다고 해 주려 했는데"
 },
 {
  "key": "m85",
  "kind": 2,
  "chr": 2,
  "jh": "bbdfc57d5dea",
  "ko": "엄청 위에서 내려다보는 말투…"
 },
 {
  "key": "m86",
  "kind": 2,
  "chr": 8,
  "jh": "8e330b90fea1",
  "ko": "다음에 만났을 때 하면 되잖아. 그보다 빨리 돌아가서 자고 싶어…"
 },
 {
  "key": "m87",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m88",
  "kind": 2,
  "chr": 23,
  "jh": "3753867c6743",
  "ko": "푸니요도 슬슬 잘 시간… 이라며 여동생이 졸린 눈을 비비고 있어요"
 },
 {
  "key": "m89",
  "kind": 2,
  "chr": 3,
  "jh": "391479b2bf78",
  "ko": "그럼 오늘은 해산이려나"
 },
 {
  "key": "m90",
  "kind": 2,
  "chr": 11,
  "jh": "1a190172760a",
  "ko": "여러분, 수고하셨어요"
 },
 {
  "key": "m91",
  "kind": 2,
  "chr": 6,
  "jh": "575024f2852a",
  "ko": "형들이랑 싸우는 것도 꽤 즐거웠어"
 },
 {
  "key": "m92",
  "kind": 2,
  "chr": 7,
  "jh": "96b446ea1928",
