[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "bf29bc4d997e",
  "ko": "이 목소리… 우류!?"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 1,
  "jh": "712c1308f683",
  "ko": "우류!!"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 10,
  "jh": "5ee03a8ae81d",
  "ko": "힉!? …우, 우… 으아아아아앙!"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 1,
  "jh": "98e782572b72",
  "ko": "그렇게 울고… 네가 괴롭힌 거지!?"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 19,
  "jh": "0142d002acc5",
  "ko": "…부정은 안 하지만 좀 더 상황을 살펴 줄 수 없을까"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 1,
  "jh": "96372a033a9f",
  "ko": "이제 괜찮아. 자, 이리 와"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "37ae620d4c80",
  "ko": "왜 그래? 자!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 10,
  "jh": "ed3740e1561f",
  "ko": "우우우… 싫어… 무서워…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "16d6b810bf22",
  "ko": "왜? 나야!? 난 안 무섭잖아!?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "7be95eae8ab7",
  "ko": "누나. 아무 생각 없이 다가가면 위험해"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 19,
  "jh": "eb9f8e5eb9a5",
  "ko": "그 애는 지금 자기 힘을 제어 못 하는 상태다. 섣불리 자극했다간…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "d537d7fb3a81",
  "ko": "시끄러워! 넌 가만있어!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 19,
  "jh": "1c74170ffd51",
  "ko": "선의의 충고였는데 발언권조차 인정해 주지 않는 건가"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 10,
  "jh": "a3196612e35c",
  "ko": "으아아아앙! 으아아아앙!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "8f824206b76e",
  "ko": "큰 소리 내니까 더 울어 버렸어…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 8,
  "jh": "ea34778db83f",
  "ko": "어쩔 건데. 태평하게 떠들고 있는데 이거 꽤 위험한 거 아냐?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 9,
  "jh": "d46ebb634569",
  "ko": "폭주해서 아까 같은 힘을 내면 이 일대가 날아갈지도 모르겠군"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "124aa247372e",
  "ko": "아, 알고 있어. 알고 있지만, 그래도…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 9,
  "jh": "a1dca97910e5",
  "ko": "그 애는 겁먹은 거야. 아가씨"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "0ded5105682d",
  "ko": "어…?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 9,
  "jh": "7f27e07edb21",
  "ko": "인간에게 칼날을 찔려 몸이 아니라 마음이 깊이 상처받은 거야"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 9,
  "jh": "1098885d09f6",
  "ko": "그 상처를 치유할 수 있는 건 아가씨의 상냥함뿐이지 않을까"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "42fb6f361fcf",
  "ko": "나의, 상냥함…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 9,
  "jh": "d72d1ddb160b",
  "ko": "웃는 얼굴로 애정을 갖고 대하는 거야. 그러면 분명 알아줄 거야"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 6,
  "jh": "54d7b23632d6",
  "ko": "누나라면 괜찮아! 누나는 그 애의 엄마잖아?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "cff759f60ccf",
  "ko": "으, 응… 해 볼게!"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 10,
  "jh": "cbf6e93dc2c4",
  "ko": "움찔…"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 1,
  "jh": "93cb5b3dad6a",
  "ko": "무서워하지 마, 괜찮으니까. 내가 우류를 지켜 줄게…"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 10,
  "jh": "7321ed05a4ae",
  "ko": "우… 우!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "9217c379baab",
  "ko": "우류!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 9,
  "jh": "bd2a39646e38",
  "ko": "서두르면 안 돼. 겁주지 않도록. 상냥하게 상냥하게…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "5acb6042bb4b",
  "ko": "으, 응… 우류…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 10,
  "jh": "039e1534e479",
  "ko": "싫… 싫어…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "b45d02ca5c40",
  "ko": "괜찮으니까! 날 믿어. 부탁이야!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 10,
  "jh": "01030d83a61b",
  "ko": "우… 우… 싫어, 무서워…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "e20b22875dd8",
  "ko": "………뚝"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 2,
  "jh": "3e1433f71881",
  "ko": "아…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 8,
  "jh": "2a0a8a00c917",
  "ko": "왠지 불길한 소리가 들렸는데…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 1,
  "jh": "c0abe7a2a86c",
  "ko": "이… 언제까지 떼쓰고 있을 거야!"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 10,
  "jh": "a1a3bf1e9be9",
  "ko": "아웃!!"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 9,
  "jh": "6956a78434c6",
  "ko": "아아… 저질러 버렸네…"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 6,
  "jh": "b5896d689021",
  "ko": "저질러 버렸네…"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 1,
  "jh": "c335259b807a",
  "ko": "고집만 부리면 진짜로 화낼 거야! 자, 얼른 돌아가자!"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 10,
  "jh": "85cc05c01848",
  "ko": "우… 우… 괴롭혔어… 싫어… 이제 싫어어어어어!!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 1,
  "jh": "e42d4ec2b8c0",
  "ko": "앗!? 뭐, 뭐야… 잠깐! 너 때문에 우류가 삐뚤어졌잖아!!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 19,
  "jh": "8d7bf553ea04",
  "ko": "방금 건 네 잘못이다. 나한테 책임을 떠넘겨도 곤란하다"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 1,
  "jh": "9952e22e0954",
  "ko": "난 잘못 없잖아! 말 안 듣는 애를 혼낸 것뿐이야!"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 6,
  "jh": "8735ce2e4b21",
  "ko": "이런이런. 누나랑 있으면 정말 지루할 틈이 없네"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 2,
  "jh": "0dc8565e7fbe",
  "ko": "때와 장소에 따라 달라… 울리카는 늘 생각이 없으니까…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 9,
  "jh": "3d1ff8ff571b",
  "ko": "목숨 건 일을 태연하게 해 버리는 게 아가씨의 매력이야"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 8,
  "jh": "581880530a15",
  "ko": "목숨 건 상황인데 긴장감이 없네. 우리…"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 2,
  "jh": "55e9143ec11b",
  "ko": "…우리답다면 우리답지만…"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 1,
  "jh": "6f75e4fb2229",
  "ko": "중얼거리지 말고 도와줘! 이렇게 된 이상 묶어서라도 데려갈 거야!"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 10,
  "jh": "23c9d566e927",
  "ko": "우, 흐윽… 우아아아아아아앙!!"
 },
 {
  "key": "m54",
  "kind": 0,
  "chr": 1,
  "jh": "c76280bf65eb",
  "ko": "하앗! 하앗!"
 },
 {
  "key": "m55",
  "kind": 0,
  "chr": 10,
  "jh": "bec4b0fcb7d4",
  "ko": "우~… 우우우…"
 },
 {
  "key": "m56",
  "kind": 0,
  "chr": 19,
  "jh": "fca71cef4f1e",
  "ko": "믿을 수 없다… 그 아이의 힘을 웃돌았다는 건가…"
 },
 {
  "key": "m57",
  "kind": 0,
  "chr": 1,
  "jh": "b92364d0b05f",
  "ko": "이… 바보야!!"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 10,
  "jh": "afd805c88a48",
  "ko": "아우웃!!"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 1,
  "jh": "04272ce55e92",
  "ko": "이런 위험한 짓을 하고… 다치기라도 하면 어쩔 거야!?"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 10,
  "jh": "378f1ae3288a",
  "ko": "우… 우~…"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 8,
  "jh": "0aae95a506fc",
  "ko": "그런 수준의 문제가 아니잖아…"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 6,
  "jh": "ebe042295783",
  "ko": "자랑은 아니지만 이 몸은 만신창이야…"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 9,
  "jh": "a0a55011e01a",
  "ko": "나도 탈인형 아래는 꽤 대단한 일이 돼 있으려나…"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 1,
  "jh": "a9fbae45479d",
  "ko": "나쁜 짓 해서 죄송합니다는?"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 1,
  "jh": "612500097fa9",
  "ko": "죄・송・합・니・다・는?"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 10,
  "jh": "b8e4063fc29f",
  "ko": "아우우! …죄송함다"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 1,
  "jh": "d088ed0554f0",
  "ko": "좋아. 이제 이런 짓 하면 안 돼. 자, 돌아가자"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 10,
  "jh": "bd017cabb95a",
  "ko": "으…"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 1,
  "jh": "0d350009c766",
  "ko": "왜 그래? 아직 떼쓸 거야?"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 10,
  "jh": "9a7b4ae013b4",
  "ko": "이제… 화 안 났어…?"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 1,
  "jh": "20d70f0cf530",
  "ko": "화 안 났어. 자"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 10,
  "jh": "36732a0688aa",
  "ko": "우… 우아아아아앙!!"
 },
 {
  "key": "m74",
  "kind": 0,
  "chr": 1,
  "jh": "accc8f98934f",
  "ko": "앗!? 뭐, 뭐야… 정말, 울보라니까. 착하지 착하지…"
 },
 {
  "key": "m75",
  "kind": 0,
  "chr": 10,
  "jh": "fea749ade500",
  "ko": "우우우~… 우에에~…"
 },
 {
  "key": "m76",
  "kind": 2,
  "chr": 19,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m77",
  "kind": 2,
  "chr": 9,
  "jh": "5d5680e4a7ff",
  "ko": "너무 놀라서 말도 안 나오는 모양이군"
 },
 {
  "key": "m78",
  "kind": 2,
  "chr": 19,
  "jh": "52e2db235c6d",
  "ko": "놀라기도 하지. 그만한 힘을 인간 소녀가 진정시켜 버렸으니까"
 },
 {
  "key": "m79",
  "kind": 2,
  "chr": 19,
  "jh": "472120022287",
  "ko": "놀랐다기보다 이해할 수 없다는 쪽이 가깝다…"
 },
 {
  "key": "m80",
  "kind": 2,
  "chr": 9,
  "jh": "3b0696818071",
  "ko": "그 애는 사람의 마음에서 태어난 마음의 마나잖아?"
 },
 {
  "key": "m81",
  "kind": 2,
  "chr": 9,
  "jh": "af8b7ab23c08",
  "ko": "그러니까 아가씨의 마음에 끌린 거지… 그런 거 아닐까"
 },
 {
  "key": "m82",
  "kind": 2,
  "chr": 6,
  "jh": "0b19a44b68ca",
  "ko": "사람의 마음은 가끔 터무니없는 힘을 발휘하는 법이니까"
 },
 {
  "key": "m83",
  "kind": 2,
  "chr": 6,
  "jh": "6bb7a32f492b",
  "ko": "마나 세계에 사는 너는 모를지도 모르지만"
 },
 {
  "key": "m84",
  "kind": 2,
  "chr": 19,
  "jh": "83017887f29b",
  "ko": "그런 건가…"
 },
 {
  "key": "m85",
  "kind": 2,
  "chr": 2,
  "jh": "aa0f5c11d3e0",
  "ko": "인간도 아닌 둘이 사람 마음의 훌륭함을 말해도 설득력이 없어…"
 },
 {
  "key": "m86",
  "kind": 2,
  "chr": 6,
  "jh": "2834e3b7dbc8",
  "ko": "다른 입장에서 봐야 비로소 깨닫는 것도 있는 법이야"
 },
 {
  "key": "m87",
  "kind": 2,
  "chr": 9,
  "jh": "eb7e3437e0ab",
  "ko": "난 엄연한 인간인데… 뭐, 확실히 인간을 초월하긴 했지만"
 },
 {
  "key": "m88",
  "kind": 2,
  "chr": 19,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m89",
  "kind": 0,
  "chr": 6,
  "jh": "a99a1986ab48",
  "ko": "어라, 돌아가?"
 },
 {
  "key": "m90",
  "kind": 0,
  "chr": 19,
  "jh": "1d8dcf32889c",
  "ko": "보고하러 돌아가야 한다. 이번 일에 대해…"
 },
 {
  "key": "m91",
  "kind": 0,
  "chr": 19,
  "jh": "38e1e81ad214",
  "ko": "그리고 그 아이는 그 소녀에게 맡겨 두는 게 안전하다고"
 },
 {
  "key": "m92",
  "kind": 0,
  "chr": 6,
  "jh": "ee1ac787c5b8",
  "ko": "응. 안부 전해 줘"
 },
 {
  "key": "m93",
  "kind": 2,
  "chr": 8,
  "jh": "988e0cb5a6ad",
  "ko": "후우… 이걸로 끝이지?"
 },
 {
  "key": "m94",
  "kind": 2,
  "chr": 9,
  "jh": "6e4783f30e86",
  "ko": "당면한 문제는 해결됐다고 봐도 되겠지"
 },
 {
  "key": "m95",
  "kind": 2,
  "chr": 6,
  "jh": "a571f40ab641",
  "ko": "이 결과는 이 몸들의 활약 없이는 생각할 수 없었지!"
 },
 {
  "key": "m96",
  "kind": 2,
  "chr": 2,
  "jh": "cf6c40314281",
  "ko": "실컷 휘말려서 민폐…"
 },
 {
  "key": "m97",
  "kind": 2,
  "chr": 8,
  "jh": "d05de2aed0fc",
  "ko": "어라? 그러고 보니 누나는?"
 },
 {
  "key": "m98",
  "kind": 0,
  "chr": 1,
  "jh": "a183695f060d",
  "ko": "너희 뭐 하는 거야~! 얼른 돌아가자~!"
 },
 {
  "key": "m99",
