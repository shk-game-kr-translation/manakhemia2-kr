[
 {
  "key": "m0",
  "kind": 0,
  "chr": 0,
  "jh": "9617deba9486",
  "ko": "여기인가… 그럼 대충 따 올게요"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 3,
  "jh": "ce88e101ad25",
  "ko": "응, 부탁해. 재료 선별은 돌아가서 내가 할게"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 7,
  "jh": "9a69d1661aad",
  "ko": "나도 도울게~!"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 7,
  "jh": "f09d0f541542",
  "ko": "얍! 이얍! 에잇~!"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 11,
  "jh": "e3138814d66a",
  "ko": "아아, 에토 씨. 그렇게 막 따면… 어머? 누가 오네요"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 0,
  "jh": "612f6299e08c",
  "ko": "응?"
 },
 {
  "key": "m6",
  "kind": 5,
  "chr": 1,
  "jh": "8bea37a11df6",
  "ko": "겨우 도착했다~! 여기 재료를 캐 가면 되는 거지?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "edb8fd2e2cfb",
  "ko": "…윽! 재수 없는 남자랑 재수 없는 여자!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 3,
  "jh": "30311029ba35",
  "ko": "음… 뭐니, 너? 남의 얼굴을 보자마자 대뜸 재수 없는 여자라니…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 11,
  "jh": "3e10e017e52c",
  "ko": "아가씨 반 친구분이에요. 아까 교실에서 만났잖아요"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 3,
  "jh": "d16ffbd404f5",
  "ko": "…아아. 그러고 보니 본 것 같기도 하네"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 3,
  "jh": "9526f15054f1",
  "ko": "촌스러운 차림을 하고 있어서 왠지 기억나"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "b2066c6f8fe6",
  "ko": "누, 누가 촌스럽다는 거야! 실례야!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "be7c2f6e96f3",
  "ko": "…실례인 건 피차일반"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "e90395881980",
  "ko": "정했어! 너, 지금부터 거만녀라고 부를 거야!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "2d34319bceec",
  "ko": "뭐, 뭐라고!? 시골뜨기 주제에!!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "22e46c80e567",
  "ko": "…그래서 뭐야? 일부러 방해하러 온 거냐?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "b8db848193eb",
  "ko": "아니거든! 수업에 쓸 재료를 캐러 왔을 뿐이야!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 0,
  "jh": "5910965dd87f",
  "ko": "그럼 얼른 캐서 돌아가면…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "9ef9ca7d83f1",
  "ko": "…라고 생각했는데, 네 얼굴 보니까 마음이 바뀌었어"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "06651cd5115a",
  "ko": "방해해 줄 거야 방해해 줄 거야~!"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 3,
  "jh": "e20e53898937",
  "ko": "그, 그만둬! 재료가 전부 못 쓰게…"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 7,
  "jh": "d79b4547257e",
  "ko": "우와~ 재밌겠다! 나도 끼워 줘~!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "09fe90cccd01",
  "ko": "너까지 같이 뭐 하는 거니!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "d4bfeb4b005e",
  "ko": "하아, 하아… 후훗훗. 어때? 항복이야?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "a6600a23714d",
  "ko": "…즐거워 보여서 좋겠다, 넌"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "c3ec2e7761ec",
  "ko": "크아~! 뭐야! 그 시큰둥한 반응은!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "029e2dabad2c",
  "ko": "자, 돌아가죠. 필요한 재료는 다 캤으니까요"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "b782d7a3e414",
  "ko": "그래. 이런 시골뜨기한테 일일이 어울려 줄 수 없지"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 7,
  "jh": "48e96575898d",
  "ko": "에~ 벌써 가? 아직 덜 놀았는데~"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "d698cf18c0c6",
  "ko": "잠깐~! 좀 더 분해하란 말이야!"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 2,
  "jh": "a1c905c262e9",
  "ko": "…저기. 우리도 재료 캐러 온 거지…?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "01e4e59c9a76",
  "ko": "앗, 그랬지… 잠깐, 으악! 엉망진창이잖아!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 2,
  "jh": "ea55a96c7325",
  "ko": "…울리카가 한 거지만"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "406da4b4142e",
  "ko": "그 녀석들~! 이런 짓까지 하다니, 용서 못 해!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 2,
  "jh": "acc375b9754c",
  "ko": "자업자득에 적반하장…"
 },
 {
  "key": "m36",
  "kind": 5,
  "chr": -1,
  "jh": "8ee0b928e004",
  "ko": "맵에는 아이템을 입수할 수 있는 장소가 존재합니다."
 },
 {
  "key": "m37",
  "kind": 5,
  "chr": -1,
  "jh": "85d451b81fe6",
  "ko": "화면과 같은 아이콘이 표시된 장소에서 {IM00}버튼을 누르면,"
 },
 {
  "key": "m38",
  "kind": 5,
  "chr": -1,
  "jh": "bb50b4866a62",
  "ko": "채취 동작에 맞는 간단한 미니게임이 발생합니다."
 },
 {
  "key": "m39",
  "kind": 5,
  "chr": -1,
  "jh": "94471aba06f3",
  "ko": "성공하면 한 번에 많은 아이템을 얻을 수 있습니다."
 },
 {
  "key": "m40",
  "kind": 5,
  "chr": -1,
  "jh": "ab29881ffa25",
  "ko": "요령을 익혀서 많은 아이템을 얻어 봅시다!"
 },
 {
  "key": "m41",
  "kind": 5,
  "chr": -1,
  "jh": "d28ca82d1124",
  "ko": "과제 지급품으로 받은 「{CLG1}이카로스의 날개{CLNR}」를 쓰면 순식간에 학원으로 돌아갈 수 있습니다."
 },
 {
  "key": "m42",
  "kind": 5,
  "chr": -1,
  "jh": "cbdab358c9f5",
  "ko": "{CLG1}이카로스의 날개{CLNR}는 메뉴 아이템의 키 아이템에서 사용할 수 있습니다."
 },
 {
  "key": "m43",
  "kind": 5,
  "chr": -1,
  "jh": "534a410ae985",
  "ko": "던전에서 과제나 목적을 완료했을 때 등에 활용하세요."
 },
 {
  "key": "m44",
  "kind": 5,
  "chr": -1,
  "jh": "f61b8d8906e3",
  "ko": "단, 특수한 상황에서는 쓸 수 없는 경우도 있으니 주의하세요."
 },
 {
  "key": "m45",
  "kind": 5,
  "chr": -1,
  "jh": "b642a103cc69",
  "ko": "「{CLRE}도움말{CLNR}」의 「{CLRE}탐색{CLNR}」에 새로운 항목이 추가되었습니다."
 },
 {
  "key": "m46",
  "kind": 5,
  "chr": -1,
  "jh": "79da7c8bf517",
  "ko": "「{CLRE}도움말{CLNR}」은 메뉴의 「{CLRE}도감{CLNR}」에서 확인할 수 있습니다."
 },
 {
  "key": "m47",
  "kind": 5,
  "chr": -1,
  "jh": "4809bdcb546f",
  "ko": "채취 액션에 대한 도움말을 보시겠습니까?"
 },
 {
  "key": "m48",
  "kind": 5,
  "chr": -1,
  "jh": "369d505c2371",
  "ko": "이카로스의 날개 도움말을 보시겠습니까?"
 },
 {
  "key": "m49",
  "kind": 5,
  "chr": -1,
  "jh": "30ac2864f9dd",
  "ko": "채취 액션 {CLRE}채집{CLNR}이 가능해졌습니다."
 },
 {
  "key": "m50",
  "kind": 5,
  "chr": -1,
  "jh": "ef6539cd987f",
  "ko": "{CLRE}채집{CLNR} 도움말을 보시겠습니까?"
 },
 {
  "key": "m51",
  "kind": 5,
  "chr": -1,
  "jh": "2b9e9cf7daeb",
  "ko": "채집이 시작되면 화면에 슬롯이 표시되고 릴이 돌기 시작합니다."
 },
 {
  "key": "m52",
  "kind": 5,
  "chr": -1,
  "jh": "e7839f639446",
  "ko": "릴은 {IM00}버튼을 누르면 왼쪽부터 차례로 멈춥니다."
 },
 {
  "key": "m53",
  "kind": 5,
  "chr": -1,
  "jh": "758140955561",
  "ko": "모든 릴을 멈추면 각 릴에 표시된 재료를 얻을 수 있습니다."
 },
 {
  "key": "m54",
  "kind": 5,
  "chr": -1,
  "jh": "19b870b09091",
  "ko": "또, 모든 릴을 같은 그림으로 맞추면 보너스가 발생합니다."
 },
 {
  "key": "m55",
  "kind": 5,
  "chr": -1,
  "jh": "014e6d0bdb92",
  "ko": "보너스가 발생하면 희귀한 재료를 얻을 수도 있습니다."
 },
 {
  "key": "m56",
  "kind": 5,
  "chr": -1,
  "jh": "752cf77dab3b",
  "ko": "캘 수 있는 재료는 장소마다 다릅니다. 여러 채취지를 돌아봅시다."
 },
 {
  "key": "m57",
  "kind": 5,
  "chr": -1,
  "jh": "b642a103cc69",
  "ko": "「{CLRE}도움말{CLNR}」의 「{CLRE}탐색{CLNR}」에 새로운 항목이 추가되었습니다."
 },
 {
  "key": "m58",
  "kind": 5,
  "chr": -1,
  "jh": "79da7c8bf517",
  "ko": "「{CLRE}도움말{CLNR}」은 메뉴의 「{CLRE}도감{CLNR}」에서 확인할 수 있습니다."
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]