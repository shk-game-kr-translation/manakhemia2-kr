[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "c65c8b3a5c86",
  "ko": "자, 여기서부턴 너 혼자 가는 거야"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 8,
  "jh": "8a0a96d91b4e",
  "ko": "하아… 알았어! 가면 되잖아! 젠장!"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 8,
  "jh": "5f162ebbc680",
  "ko": "바~보 바~보! 너희 같은 거 정말 싫어!!"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 6,
  "jh": "98b0849d87af",
  "ko": "의외로 애 같은 방식으로 폭발하네"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 9,
  "jh": "213c2dcbd1e9",
  "ko": "어른인 척해도 아직 소년이니까"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 1,
  "jh": "2cfa3d00e54a",
  "ko": "누, 누가 바보라고!? 이놈~!!"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 2,
  "jh": "dad61da2a562",
  "ko": "애가 하는 말에 일일이 반응하지 마…"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 8,
  "jh": "fd80063e3ad9",
  "ko": "젠장… 얼른 건네주고… 그래도 일단 제대로 사과해야 하는 거지…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 8,
  "jh": "b2600ea518c4",
  "ko": "저쪽 아틀리에에서 사과하는 거 어색하겠다… 으으, 왠지 긴장되네…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 8,
  "jh": "4341942aa2f1",
  "ko": "오. 마침 잘됐다"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 7,
  "jh": "077e35b0cf2f",
  "ko": "라니, 으아아! 에나!? 왜!?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 8,
  "jh": "74bbed18c776",
  "ko": "아, 아니, 뭐랄까… 잠깐 볼일이 있어서"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 7,
  "jh": "7224caa769eb",
  "ko": "그, 그렇게 갑자기 나타나면 마음의 준비가…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 8,
  "jh": "aa195b02c484",
  "ko": "아까는 그, 뭐랄까, 나도 말이 좀 지나쳤을지도 모르는 것 같기도 해서…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 7,
  "jh": "de3362a6a3fd",
  "ko": "아, 안 돼 안 돼! 다들한테 들은 걸 떠올려야…!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 8,
  "jh": "801282796ba9",
  "ko": "사과하는 대신은 아니지만. 일단 선물 같은 걸 말이지…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 7,
  "jh": "b945febab948",
  "ko": "와, 와아! 오빠, 에토 만나러 와 줬구나!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 8,
  "jh": "24f16bd988b6",
  "ko": "………뭐?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 7,
  "jh": "0568898756c1",
  "ko": "전혀 안 놀아 주니까 에토 엄청 외로웠단 말이야!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 8,
  "jh": "11777ad3279e",
  "ko": "…새로운 괴롭힘이냐?"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 1,
  "jh": "2442e57eb186",
  "ko": "…왠지 이상하게 됐네"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 6,
  "jh": "bb6def9fc7c0",
  "ko": "형의 누나도 꽤 이상한 사람이니까"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 2,
  "jh": "33c014636e45",
  "ko": "순순히 사과하는 것조차 못 하게 해… 그게 에나 군의 대단함…"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 8,
  "jh": "8463429a48b3",
  "ko": "그렇군. 사람이 어쩔 수 없이 마지못해 사과하러 와 줬는데 그런 태도를 취한다 이거지…"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 7,
  "jh": "859a0a2ce603",
  "ko": "으… 이제 승부를 걸 수밖에… 에잇!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 7,
  "jh": "498a81fa0900",
  "ko": "꺄하! 아야~"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 8,
  "jh": "539a7d7db02e",
  "ko": "와, 갑자기 왜 넘어지고… 아직도 놀리는 거냐?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 7,
  "jh": "179fb3f08bd8",
  "ko": "싫다~ 넘어져 버렸어. 난 정말 덜렁이라서… 훌쩍"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 8,
  "jh": "dbd72cda2fd4",
  "ko": "이봐, 설마… 바보 바보 했지만 드디어 본격적으로…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 7,
  "jh": "c2c98b45a88f",
  "ko": "이런 모습을 주인님께 보이다니… 부끄러워!!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 8,
  "jh": "834c5976380b",
  "ko": "갑자기 주인님이냐!?"
 },
 {
  "key": "m31",
  "kind": 5,
  "chr": 42,
  "jh": "6f697b79eba8",
  "ko": "게햐! 구후후후! 아~하하하하하!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 8,
  "jh": "326c88114467",
  "ko": "으아!? 갑자기 움직이기 시작했다!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 7,
  "jh": "9b85d59e8370",
  "ko": "아… 먹혔다! 해냈다, 잘됐어!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 8,
  "jh": "6521c36ddbce",
  "ko": "안 먹혔어! 내가 웃는 게 아니라…"
 },
 {
  "key": "m35",
  "kind": 5,
  "chr": 42,
  "jh": "76d0a5bc2a83",
  "ko": "아하하하하! 이히히히히! 케~켓케켓케!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 8,
  "jh": "5bfbfd49b093",
  "ko": "아~! 멈춰! 젠장! 급하게 만들어서…"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 9,
  "jh": "cc53db8fc361",
  "ko": "오, 여기서 웃기 시작하다니"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 2,
  "jh": "0cf78b3ba93f",
  "ko": "초현실적인 그림…"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 6,
  "jh": "2cab4093658a",
  "ko": "이걸 계산해서 했다면 형도 대단한 거네"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 2,
  "jh": "bee407a5eae6",
  "ko": "천연인 데다 크게 미끄러지니까 질이 나빠…"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 1,
  "jh": "150a0b1368e0",
  "ko": "저쪽도 헛돌고 있어서 어떻게든 되고 있지만… 보고 있기 괴로워졌어"
 },
 {
  "key": "m42",
  "kind": 5,
  "chr": 42,
  "jh": "f2aacaa6974c",
  "ko": "쿠케케케케! 카~캇카카! 우히, 우히히히…"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 8,
  "jh": "98e197167067",
  "ko": "아아, 이제 됐어! 아무튼 말이지! 이걸 너한테…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 7,
  "jh": "9a13a21ab588",
  "ko": "들어 줘 에나! 사실 우리… 진짜 남매가 아니야!!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 8,
  "jh": "aa78fd1b0920",
  "ko": "뭐, 뭐라고!?"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 7,
  "jh": "f924610dc9d6",
  "ko": "그러니까 나! 오래전부터 에나를 동생이 아니라 한 남자로…!"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 8,
  "jh": "37f9f32488ba",
  "ko": "기다려! 그럴 리 없잖아! 집에 사진도 남아 있고… 정말 어떻게 된 거냐?"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 7,
  "jh": "6650d4b350ee",
  "ko": "이제 참을 수 없어! 하아~, 하아~…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 8,
  "jh": "fde6b3700549",
  "ko": "눈이 무서워… 오지 마! 더 다가오지 마!"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 8,
  "jh": "78de096f5cd6",
  "ko": "내가 잘못했으니까! 자, 이거 줄 테니까! 잘 있어!"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 7,
  "jh": "4b0187f66e8a",
  "ko": "어? 주는 거야? 뭘까, 이거?"
 },
 {
  "key": "m52",
  "kind": 5,
  "chr": 42,
  "jh": "d3c22c97325a",
  "ko": "우후후… 킥킥… 풉, 쿡쿡…"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 1,
  "jh": "e90e2a0e8d6b",
  "ko": "이야~… 뭐랄까, 수고했어"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 8,
  "jh": "8c8eaee9a09d",
  "ko": "하아, 하아… 이런 정신적 공격은 처음이야… 그러니까 가기 싫었던 거라고!"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 6,
  "jh": "94cdb16da922",
  "ko": "우리가 잘못했어. 방금 걸 보니 진심으로 그렇게 생각해"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 9,
  "jh": "e41277f71428",
  "ko": "그래도 넌 정말 잘했다고 생각해, 응"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 2,
  "jh": "aa17e6dd330b",
  "ko": "설마 그런 충격적 사실까지 튀어나올 줄이야…"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 8,
  "jh": "89c42c81a9c9",
  "ko": "거짓말이니까! 절대 믿지 마! 아아… 이제 글렀어. 돌아가서 잘래…"
 },
 {
  "key": "m59",
  "kind": 0,
  "chr": 6,
  "jh": "fc203ecb403e",
  "ko": "화해시킬 생각이었는데 역효과였네"
 },
 {
  "key": "m60",
  "kind": 0,
  "chr": 9,
  "jh": "f2bdb77b5ce9",
  "ko": "괜찮지 않을까. 저쪽도 생각만큼 풀 죽어 보이진 않았고"
 },
 {
  "key": "m61",
  "kind": 0,
  "chr": 2,
  "jh": "ed712bc0f638",
  "ko": "결국 두 사람 문제는 두 사람 사이에서 해결할 수밖에 없는 거야…"
 },
 {
  "key": "m62",
  "kind": 0,
  "chr": 6,
  "jh": "11a98123ab97",
  "ko": "하하하. 지금까지의 행동을 전부 부정하네"
 },
 {
  "key": "m63",
  "kind": 0,
  "chr": 1,
  "jh": "432cd9316f69",
  "ko": "뭐, 당분간은 가만 놔두자…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]