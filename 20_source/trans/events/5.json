[
 {
  "key": "m0",
  "kind": 5,
  "chr": 3,
  "jh": "fbde5832ccac",
  "ko": "로제! 로제~!"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 0,
  "jh": "f47db4a26211",
  "ko": "응, 아가씨…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "eabb6e67f53d",
  "ko": "날 데리러 오지도 않고, 대체 어디 가려는 거니?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 0,
  "jh": "4d6b4117cf25",
  "ko": "어디긴요, 교실이죠. 데리러 오라는 말도 안 하셨잖아요"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "0abf46a3c0af",
  "ko": "말 안 해도! 그 정도는 알아서 눈치껏 하렴!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "3604b4a7f5c6",
  "ko": "…죄송합니다"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 11,
  "jh": "0821c4dbfebd",
  "ko": "정말, 이쪽은 큰일이었다고요"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 11,
  "jh": "bb569fee215d",
  "ko": "로제 씨가 데리러 와 주지 않으니까 아가씨가 토라져서 저한테 화풀이를…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 3,
  "jh": "203678e911fe",
  "ko": "쓸데없는 소리 하지 마!"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 11,
  "jh": "093b62371cb6",
  "ko": "악! 아파! 아파요! 죄, 죄송해요~!"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 0,
  "jh": "3c1b12b0f492",
  "ko": "저기, 무슨 볼일이 있으셨던 거 아니에요…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 3,
  "jh": "43fcc826276f",
  "ko": "아차, 그랬지"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 3,
  "jh": "4a5ca29436a2",
  "ko": "넌 먼저 교실에 가 있으렴. 난 이사장님께 할 얘기가 있으니까"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 0,
  "jh": "fe605b88f80c",
  "ko": "…그게 다예요?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 3,
  "jh": "d74b3a96628b",
  "ko": "그게 다라니, 이건 중요한 일이야"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "f8e9cd7afb24",
  "ko": "아버님의 대리로서 베렌도르프 가문의 의향을 학원 측에 전하고, 나아가…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "c33ae01a4d93",
  "ko": "그런 게 아니라, 아가씨와는 학과가 다르니까 교실도 다르잖아요…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "281f4ea5cac7",
  "ko": "어? 아, 아아! 그런 얘기구나…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 0,
  "jh": "29c40e7f9d17",
  "ko": "…완전히 잊고 계셨나 보네요"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "b8a5323c54a0",
  "ko": "…시, 시시시끄러워! 내가 하는 일에 일일이 토 달지 마!"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 3,
  "jh": "a82fca08f089",
  "ko": "…네가 날 찾아 헤매거나, 하염없이 기다리면 불쌍하니까…"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 3,
  "jh": "63c656812ab0",
  "ko": "그래서 일부러 이쪽에서 와 준 건데…"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 11,
  "jh": "0c1c7995180d",
  "ko": "그런 건 확실히 말하지 않으면 전해지지 않아요?"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 3,
  "jh": "40295a6495b7",
  "ko": "드, 듣지 마! 그냥 혼잣말이야, 혼잣말!"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 11,
  "jh": "6a46807f34a1",
  "ko": "그리고, 로제 씨가 자진해서 아가씨를 찾는 일은 우선 없을 것 같은데요"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 3,
  "jh": "b4fda1578799",
  "ko": "무, 무슨 뜻이야!?"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 11,
  "jh": "c33b37194d3f",
  "ko": "아, 아아아아…뇌가…뇌가 흔들려…!"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 0,
  "jh": "40388e2d9868",
  "ko": "저기…이제 가 봐도 될까요?"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 3,
  "jh": "7288be3a4bce",
  "ko": "으, 응…좋아. 가 보렴"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 0,
  "jh": "e6aaf97331e4",
  "ko": "여전히 알 수 없는 사람이야… 앗, 좀 서둘러야겠군"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 0,
  "jh": "f3d5f7dec471",
  "ko": "으악!!"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 0,
  "jh": "828f744cd0e8",
  "ko": "큭…왜 이런 데에 돌이…"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 35,
  "jh": "c0281f5d17e3",
  "ko": "아앗! 내 돌이! …다행이다. 멀쩡해"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 0,
  "jh": "e382593581a6",
  "ko": "…네 거냐? 그거…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 35,
  "jh": "25fe517691bd",
  "ko": "응? 그런데? 예쁘지? 게다가 그냥 예쁘기만 한 게 아니라 이게 무려…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 0,
  "jh": "e3c4d2584bfa",
  "ko": "달리 할 말이 있을 텐데… 난 그 돌을 밟고 넘어졌다고?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 35,
  "jh": "8089ef4cd6e5",
  "ko": "할 말…? 아, 맞다!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 35,
  "jh": "9dc664e18a3d",
  "ko": "감히 남의 돌을 밟다니! 깨지면 어쩔 건데!?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 0,
  "jh": "a9d1e7e722c2",
  "ko": "왜 네가 화를 내! 사과 한마디 하라는 거잖아!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 35,
  "jh": "c121eb89d0f6",
  "ko": "내가 왜 사과해야 하는데! 네가 멋대로 넘어진 거잖아"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 0,
  "jh": "c1aa621630ee",
  "ko": "그 돌을 굴린 건 너잖아!"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 35,
  "jh": "617a8abcbb7d",
  "ko": "애들 말싸움이네…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 35,
  "jh": "d4d931c5ce88",
  "ko": "이렇게 말하면 저렇게 말하고… 뭐야, 남자가 지난 일을 갖고 꽁해서는!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 0,
  "jh": "efb178536925",
  "ko": "멋대로 지난 일로 만들지 마!"
 },
 {
  "key": "m44",
  "kind": 5,
  "chr": 20,
  "jh": "7c16fa41e354",
  "ko": "야, 뭘 떠들고 있냐?"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 35,
  "jh": "ed051352fab6",
  "ko": "으악, 입학식에서 난동 부리던 선생님이다…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 20,
  "jh": "76bbf1d1fd60",
  "ko": "입학하자마자 기운이 넘치는구먼. 너희, 이름은?"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 1,
  "jh": "e726998bd13c",
  "ko": "울리카, 예요…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 0,
  "jh": "e96da9ae39d6",
  "ko": "…로제류크스"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 20,
  "jh": "d375d531e87e",
  "ko": "울리카에 로제류… 부르기 힘드네. 로제면 되겠지"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 20,
  "jh": "089795078375",
  "ko": "똑똑히 기억해 두마. 자, 얼른 교실로 가"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 1,
  "jh": "2c30a7cd31af",
  "ko": "네~…"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]