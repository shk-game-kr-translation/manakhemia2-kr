  "ko": "………"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 83,
  "jh": "3c2f763d4f52",
  "ko": "꺄아아아아! 빨리 도망쳐야 해!"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 96,
  "jh": "32eb4513c120",
