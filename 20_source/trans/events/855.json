[
 {
  "key": "m0",
  "kind": 2,
  "chr": 12,
  "jh": "707c521fe235",
  "ko": "돌아왔군. 어땠나, 물속 세계는?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 7,
  "jh": "64290158eaed",
  "ko": "엄청 재밌었어!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 0,
  "jh": "9ff34ec1cc4e",
  "ko": "이번엔 순순히 대단하다고 생각했어요"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 12,
  "jh": "36db8cb15a9c",
  "ko": "마음에 들었다니 다행이다만, 과제를 소홀히 하면 아무 의미 없다"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 12,
  "jh": "236d529559af",
  "ko": "자, 이번 네놈들의 평가다만…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 12,
  "jh": "b22006fb527d",
  "ko": "호오, 대단하군. 움직이기 힘든 물속에서 이만한 전과를 올리다니"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 7,
  "jh": "c758f302de73",
  "ko": "에헤헤~ 수영은 꽤 자신 있거든"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 12,
  "jh": "680cf940a6a9",
  "ko": "과연. 수중 적성 있음인가… 국지전에 파견해도 이 정도면 충분한…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 0,
  "jh": "3713ae2b4c93",
  "ko": "…무슨 말씀이세요?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 12,
  "jh": "37d26a9adb58",
  "ko": "뭘, 이쪽 얘기다. 이번엔 최상급 평가를 주마. 수고했다!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 12,
  "jh": "578b6a4d9367",
  "ko": "흠, 몇 마리 놓쳤나. 마무리가 허술했군"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 7,
  "jh": "aaa61c6268cb",
  "ko": "에에? 아직 남아 있었어?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 12,
  "jh": "356f27c46d10",
  "ko": "주의력이 부족하다. 전장에선 그 작은 허술함이 목숨을 앗아 간다. 잘 기억해 둬라"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 0,
  "jh": "746263bb44b1",
  "ko": "네…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 12,
  "jh": "c1aed5b6d39d",
  "ko": "뭐, 첫 수중 전투치곤 잘했다. 다음을 기대하마"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 12,
  "jh": "5cda0f8dd0c4",
  "ko": "뭐냐, 꽤 많이 놓쳤군"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 7,
  "jh": "9008cc30e16f",
  "ko": "그치만~ 물속은 움직이기 힘들고"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 12,
  "jh": "ad859e4c2626",
  "ko": "당연하다. 그걸 위한 훈련이니까. 훈련 취지 정도는 미리 이해해 둬라!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 7,
  "jh": "47a71ee28ba5",
  "ko": "그런~ 처음부터 말해 주면 좋았을 텐데…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 12,
  "jh": "fc0c275b89e1",
  "ko": "이래선 제대로 된 평가는 못 준다. 졸업까지 날도 얼마 없다. 귀중한 훈련을 낭비하지 마라"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 0,
  "jh": "746263bb44b1",
  "ko": "네…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 12,
  "jh": "a020d859bd9c",
  "ko": "논외로군…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 7,
  "jh": "504e15bdd6cd",
  "ko": "아, 아하하… 역시?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 12,
  "jh": "9240d549ff42",
  "ko": "졸업을 앞두고 이 성적이라니. 어떤 의미로 배짱 좋군"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 12,
  "jh": "426e4c33e357",
  "ko": "알겠냐, 이 몸에게도 인내의 한계라는 게 있다. 잘 기억해 둬라"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "746263bb44b1",
  "ko": "네…"
 },
