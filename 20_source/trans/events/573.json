[
 {
  "key": "m0",
  "kind": 2,
  "chr": 30,
  "jh": "04c85bd581df",
  "ko": "오, 이건… 너도 좀 알게 됐구나"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 6,
  "jh": "41fd004539cb",
  "ko": "후훗, 스승님 취향은 확실히 파악하고 있지!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 30,
  "jh": "4543264f92b4",
  "ko": "이건 당신이 만든 거냐?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "e7d1fea64aaf",
  "ko": "응, 뭐"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 6,
  "jh": "28c11ec639bd",
  "ko": "이 몸도 도왔어! 이 몸도!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 30,
  "jh": "180705e5e3f9",
  "ko": "그렇군… 좋아, 오늘 밤은 마신다. 페페론, 너도 어울려라"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 6,
  "jh": "6f01e76c5b29",
  "ko": "에에? 안 돼, 이 몸은 아직 애라서"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 30,
  "jh": "46dc4a962952",
  "ko": "까불지 마. 진짜 나이 까발린다"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 6,
  "jh": "f68c277aa966",
  "ko": "와아아! 그것만은 봐줘!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 30,
  "jh": "90a02e9caf7b",
  "ko": "당신한텐 마시게 할 수 없겠군. 뭐, 밥 정도는 먹고 가"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "5b5bd751964c",
  "ko": "어, 나도? 뭐, 상관없지만…"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 6,
  "jh": "76e12fb29f0c",
  "ko": "그아~… 드르렁…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "3b019aa47e2b",
  "ko": "자 버렸다… 그나저나 엄청난 코골이"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 30,
  "jh": "318a40661b87",
  "ko": "이 녀석은 술에 익숙하지 않으니까. 자, 늦게까지 붙잡아서 미안했다"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "20ba2c86f0f1",
  "ko": "괜찮아. 밥 꽤 맛있었고"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 30,
  "jh": "aae3503988d3",
  "ko": "그야 그렇지. 몇십 년이나 인간 밑에서 밥을 지어 왔으니까"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 30,
  "jh": "b6c6e4084316",
  "ko": "…있잖아, 당신한테 말해 두고 싶은 게 있는데"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "fbe4801c4560",
  "ko": "뭐야, 새삼스럽게"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 30,
  "jh": "000d1ee09379",
  "ko": "놀라지 말고 들어 줘. 실은… 페페론은 요정 씨가 아니야"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "9f73b062a28c",
  "ko": "아, 그래? 어렴풋이 눈치채고 있었지만"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 30,
  "jh": "64a34d581e54",
  "ko": "처음 만났을 때 이 녀석은 부모에게도 세상에게도 버림받아 잔뜩 삐뚤어져 있었어"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 30,
  "jh": "0dc2c1802d24",
  "ko": "그게 인간에게 이용당한 끝에 버려진 나랑 겹쳐 보여서…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 30,
  "jh": "a9c7efc2e9c8",
  "ko": "정신 차려 보니 주워 와 있었지"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 30,
  "jh": "30998f725b1f",
  "ko": "그리고 혼자 살아갈 방법으로 요정 씨의 기술을 가르쳐 줬다"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "876695124c9e",
  "ko": "그렇구나. 페페론은 자기가 요정 씨가 아니란 건…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 30,
  "jh": "d56a9504062d",
  "ko": "당연히 알고 있지. 그걸 알고도 요정 씨가 되려고 하는 거야"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 30,
  "jh": "6b48b294c6ec",
  "ko": "뭐, 덩치 큰 것만은 속일 수 없지만"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "4c94696ba8c5",
  "ko": "본인은 속이고 있다고 생각하겠지…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 30,
  "jh": "eae74715789c",
  "ko": "페페론이 인간 밑에서 일하는 건 이번이 처음이야"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 30,
  "jh": "984947bbb1cc",
  "ko": "이 녀석 잘 부탁한다. 행여나 버리거나 하는 일은…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "9bb3ffb2e568",
  "ko": "딱히 버리거나 하진… 그래도 좀 그런 얘기는 나한텐 무거울지도…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 30,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 1,
  "jh": "e88e74448e9b",
  "ko": "잠깐, 갑자기 조용해지지 마"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 30,
  "jh": "38e3cec9d4ab",
  "ko": "쿠우… 새근…"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 1,
  "jh": "0a7f32e56a49",
  "ko": "이쪽도 자 버렸다… 어떡하지, 두고 돌아가도 되려나?"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 6,
  "jh": "a51977a8c61c",
  "ko": "그가아아… 드르르르…"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 30,
  "jh": "09dbf5fd44b6",
  "ko": "새근새근…"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 1,
  "jh": "9073068dfe14",
  "ko": "…후우, 손이 많이 가네. 누가 누굴 돌보는 건지 모르겠어"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]