[
 {
  "key": "m0",
  "kind": 2,
  "chr": 11,
  "jh": "9a73db313aef",
  "ko": "으, 으으으… 으으~"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "20857edeafe9",
  "ko": "…뭘 신음하고 있어?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 11,
  "jh": "13b76a41ceb4",
  "ko": "신음하는 게 아니에요! 우는 거예요!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 0,
  "jh": "4f609850c4a4",
  "ko": "아아, 그랬나… 그래서 왜 울어?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 11,
  "jh": "c13a8e822e8d",
  "ko": "아가씨 일이에요…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 11,
  "jh": "32173065c9fa",
  "ko": "제 몸에 이상한 액체를 바르고, 뿌리고, 먹이고… 심지어 주입까지…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 0,
  "jh": "72b0e614eb7b",
  "ko": "주입?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 11,
  "jh": "9f27eb2f0f67",
  "ko": "으으으… 저 더럽혀져 버렸어요… 이제 시집 못 가요…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 0,
  "jh": "cb0c8a5ffc48",
  "ko": "오해 살 말투 쓰지 마. 뭐, 확실히 그건 지나쳤지…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 11,
  "jh": "96e019804e6e",
  "ko": "그렇죠! 로제 씨도 한마디 해 주세요!"
 },
 {
  "key": "m10",
  "kind": 5,
  "chr": 3,
  "jh": "0014caebdeaa",
  "ko": "그럴 필요 없어"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 11,
  "jh": "37a724a8bfda",
  "ko": "아가씨!? 언제부터 거기에…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 3,
  "jh": "e8f5ada4ef3f",
  "ko": "얘기는 다 들었어. 네가 그렇게 상처받고 있었다니… 미안해"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 11,
  "jh": "a6c2df4b08ec",
  "ko": "그런… 아가씨가 사과해 주시다니…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 3,
  "jh": "f55156395789",
  "ko": "나도 신경은 쓰고 있었어. 그래서 오늘은 이걸 가져왔어"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 11,
  "jh": "ca5152a654a5",
  "ko": "뭐예요? 이 깨끗한 물은?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 3,
  "jh": "ae6e5edb052b",
  "ko": "초순수야. 이걸 쓰면 네 몸도 금세 깨끗하게 돌아갈 거야"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 11,
  "jh": "cc704557405d",
  "ko": "아가씨… 기뻐요! 아가씨가 절 위해 이렇게까지…!!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "c3871ed263e5",
  "ko": "호들갑이네. 뭐, 이게 있으면 아무리 더러워져도 괜찮겠지"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 11,
  "jh": "fa6c5fb4f679",
  "ko": "…네?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "346dafb39cc6",
  "ko": "이걸로 사양 없이 이상한 액체를 바르고 뿌리고 먹일 수 있겠네"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 11,
  "jh": "b0c391809f28",
  "ko": "그런… 지금까지도 사양 같은 거 안 하셨잖아요!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 0,
  "jh": "a756f693e4ad",
  "ko": "뭐, 잘됐잖아. 깨끗하게 돌아가는 것만으로도"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 11,
  "jh": "f7a27d67fcc4",
  "ko": "전혀 안 잘됐어요! 이, 이제 싫어요~!"
 },
