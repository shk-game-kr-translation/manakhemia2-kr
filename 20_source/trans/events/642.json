[
 {
  "key": "m0",
  "kind": 5,
  "chr": 6,
  "jh": "6875f29b0ada",
  "ko": "거기 서어어!"
 },
 {
  "key": "m1",
  "kind": 5,
  "chr": 9,
  "jh": "234134203c88",
  "ko": "하하하. 우리한테서 도망치려 하다니 백 년 일러"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 8,
  "jh": "a5e254f24fe6",
  "ko": "벌써 따라잡혔나. 빨리 기계를… 라니, 고장 났지…"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 8,
  "jh": "2a962792428d",
  "ko": "응? 고쳐져 있어? 고장 난 부품이 새것으로… 왜지?"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 8,
  "jh": "172cfdc615cb",
  "ko": "젠장, 생각할 시간 없어!"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 6,
  "jh": "6e21476ec490",
  "ko": "후후후. 따라잡았다, 형…"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 9,
  "jh": "9b41dac4b989",
  "ko": "자, 수행으로 돌아가자. 아까보다 하드하게 공략해 주지…"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 8,
  "jh": "14401b6c15af",
  "ko": "웃기지 마! 그런 거 어울려 줄 수 있겠냐! 너희를 쓰러뜨려서라도…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 8,
  "jh": "293c75ab99a4",
  "ko": "응? 뭐야… 출력이 말도 안 돼…! 으아아아!?"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 6,
  "jh": "0256b25fa170",
  "ko": "우오옷!?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 8,
  "jh": "290bb6bab1d4",
  "ko": "뭐, 뭐야 이건…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 9,
  "jh": "c47a34db1382",
  "ko": "굉장한 펀치군… 아무리 나라도 간담이 서늘했어"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 6,
  "jh": "b426c09063ad",
  "ko": "설마 벌써 수행의 성과가!?"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 8,
  "jh": "cebbdc08f056",
  "ko": "그럴 리가 있냐! 라기보다 전혀 제어가 안 돼… 으아아아! 피, 피해!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 6,
  "jh": "e0b45dd14de1",
  "ko": "어? 잠, 형?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 9,
  "jh": "3822d9807f51",
  "ko": "살기가 담겨 있군… 그쪽이 그럴 생각이라면…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 8,
  "jh": "466b0e042561",
  "ko": "아니야! 이게 멋대로 움직인다고! 크아아!! 파, 팔이 빠져어어!!"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 9,
  "jh": "353024624da6",
  "ko": "고호옷! 말도 안 돼… 내가 밀리고 있어!?"
 },
 {
  "key": "m18",
  "kind": 5,
  "chr": 6,
  "jh": "a58527eb8aa4",
  "ko": "아파! 얼굴은, 얼굴은 하지 마아아!"
 },
 {
  "key": "m19",
  "kind": 5,
  "chr": 8,
  "jh": "133efdb988e0",
  "ko": "피해! 죽을 각오로 피해! 젠장, 멈춰… 크아앗! 어, 어깨가 빠져…!!"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 1,
  "jh": "87397ad24e69",
  "ko": "아~아… 아틀리에가 엉망… 에나는 굉장하게 폭발하네"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 2,
  "jh": "1b61c1d5e4f0",
  "ko": "응… 문명에 너무 의존한 인간의 슬픈 말로를 보는 것 같아…"
 },
 {
  "key": "m22",
  "kind": 5,
  "chr": 8,
  "jh": "91ce606a166d",
  "ko": "아, 아니야… 그러니까 기계가 멋대로 움직여서… 아아아아!"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 1,
  "jh": "21dc07fc4039",
  "ko": "뒷수습이 힘들겠네. 정말…"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 2,
  "jh": "fa9e39bb5e18",
  "ko": "저기서 맞고 있는 사람들보단 나을지도 모르지만…"
 },
 {
  "key": "m25",
  "kind": 5,
  "chr": 8,
  "jh": "3c7e0b46595e",
  "ko": "으갸아아아! 팔이, 내 팔이이이!!"
 },
 {
  "key": "m26",
  "kind": 5,
  "chr": 6,
  "jh": "cc68b4ba8868",
  "ko": "대, 대단해! 형 팔이 두 배쯤 늘어났어!"
 },
 {
  "key": "m27",
  "kind": 5,
  "chr": 9,
  "jh": "cd7518f03f8b",
  "ko": "요즘 과학은 여기까지… 이거 참, 기술의 진보는 놀라울 만큼 빠르군"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 1,
  "jh": "1a48a8e6b2f1",
  "ko": "정말, 작작 좀 해! 안 멈추면 힘으로라도 멈추는 거야!!"
 },
 {
  "key": "g0s0",
