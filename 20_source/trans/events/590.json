[
 {
  "key": "m0",
  "kind": 2,
  "chr": 6,
  "jh": "dd7f8d3fb42c",
  "ko": "스승님~ 밥 다 됐어"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 30,
  "jh": "bec293b19f27",
  "ko": "오, 수고했다. 너도 먹고 갈 거냐?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 6,
  "jh": "3c7bf7ee4391",
  "ko": "그러고 싶은데 이따가 누나를 도와야 하거든"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 30,
  "jh": "951813c0a67b",
  "ko": "그렇군… 뭐, 바쁜 건 좋은 거다. 무능한 놈한텐 일이 안 들어오니까"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 6,
  "jh": "59896cf90aa5",
  "ko": "하하하. 이 몸만큼 우수한 인재는 흔치 않으니까"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 6,
  "jh": "a01b43728a84",
  "ko": "…어라? 요정 씨니까 요재? 요정재? 어감이 별로네…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 30,
  "jh": "186df4a1d95c",
  "ko": "너무 우쭐대지 마라. 넌 일한 지 이제 겨우 1년. 아직 풋내기다"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "ef7e9d1675f7",
  "ko": "으으. 스승님은 여전히 엄하네…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 30,
  "jh": "a183d42de49f",
  "ko": "그나저나 그렇군. 1년이라… 그만큼 일했으면 꽤 모았겠지?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "12ea8ed98c6d",
  "ko": "모았다니, 뭘?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 30,
  "jh": "0bc467d45e9e",
  "ko": "뭐긴 돈이지. 결국 요정 씨 일의 가치는 보수로밖에 말할 수 없으니까"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 30,
  "jh": "884cd788527f",
  "ko": "전설의 칠색 요정쯤 되면 잠깐 일하기만 해도 만 단위 돈이 움직인다던가…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 6,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 30,
  "jh": "5e6ba2653f41",
  "ko": "뭐냐, 갑자기 입 다물고"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 6,
  "jh": "d7b51ec872bc",
  "ko": "이 몸, 1콜도 안 받았어…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 30,
  "jh": "e440799462b0",
  "ko": "…뭐? 무슨 소리냐? 설마… 이 1년 동안 공짜로 일했다는 거냐?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 6,
  "jh": "a613793f625d",
  "ko": "그렇게… 되는 건가…?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 30,
  "jh": "f726abf542ae",
  "ko": "바… 바보 자식! 얼마나 태평한 거냐! 네 머리는!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 6,
  "jh": "4c730cc9eedf",
  "ko": "미, 미안해. 애초에 돈을 받는다는 발상이 없어서…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 30,
  "jh": "41805eb0697a",
  "ko": "네 멍청함에도 기가 막히지만, 내 제자를 공짜로 부려 먹었다는 것도 용서 못 한다…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 6,
  "jh": "2737e6d52da7",
  "ko": "이 몸, 꽤 심한 취급을 받았네… 공짜인데…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 30,
  "jh": "d09e608a7336",
  "ko": "이건 한마디 해 줘야겠군. 따라와라!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 6,
  "jh": "5c7c5ebc6128",
  "ko": "으, 응!"
 },
