 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "ea966c13a50e",
  "ko": "헉! 클로에, 있었어?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 2,
  "jh": "a8cf12972f8e",
  "ko": "…그 반응은 아무래도 실례라고 생각해…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "1036b4b46e0d",
  "ko": "아니, 네가 혼자 아틀리에에 있으면 그만… 뭘 만들고 있던 건 아닌 것 같네"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 2,
  "jh": "b1992f9003ca",
  "ko": "잠깐 생각에 잠겨 있었을 뿐…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 9,
  "jh": "c6354053a803",
  "ko": "흠… 전부터 묻고 싶었는데, 넌 왜 저주에 흥미를 가진 거지?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 2,
  "jh": "58e27f81b92e",
  "ko": "…저주가 아니라 주술인데…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 2,
  "jh": "11520a35bfec",
  "ko": "…나, 어릴 때 정말 몸이 약해서… 집 안에서 책만 읽으며 지냈어"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 6,
  "jh": "4a1064430a77",
  "ko": "하하~ 그때 읽던 책이 주술 책이었구나?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 2,
  "jh": "791cab486bc2",
  "ko": "아니… 평범한 동화 같은 거…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 6,
  "jh": "e3282845166f",
  "ko": "어라~ 틀렸나…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "136b471af481",
  "ko": "내가 책을 읽을 때 밖에서 늘 다른 애들 노는 소리가 들려와서…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 6,
  "jh": "5935bff233bd",
  "ko": "이번엔 알았다! 그 애들처럼 건강해지고 싶어서 주술을 시작한 거구나!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "f97c1bde03e7",
  "ko": "…틀려"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 6,
  "jh": "1add9b03bc28",
  "ko": "으아아! 또 빗나갔어. 좋아, 이번에야말로…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 2,
  "jh": "618273f765b7",
  "ko": "일일이 끼어들지 마"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 6,
  "jh": "69c6efdee621",
  "ko": "아, 죄송했습니다…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 9,
  "jh": "b748ba22c369",
  "ko": "그래서, 지금 얘기랑 주술이 어떻게 이어지는 거지?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 2,
  "jh": "46da2e0302f7",
  "ko": "그 애들 목소리가 시끄러워서 신경에 거슬려서…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 2,
  "jh": "0f3a8649260f",
  "ko": "저런 녀석들은 사라져 버리면 좋겠다고 생각해서, 그래서…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 9,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m21",
  "kind": 2,
