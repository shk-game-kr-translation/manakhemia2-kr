  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "883a0dd7dced",
  "ko": "…방금 거, 웃을 데야?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "cc694c15f6ce",
  "ko": "못 웃겠거든… 그래도 그때에 비하면 클로에도 많이 건강해졌지"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "12f9568876c3",
  "ko": "울리카한테 매일 억지로 끌려다녀서…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "42ba77c1a82e",
  "ko": "좋잖아. 덕분에 건강해졌으니까"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 2,
  "jh": "779d56ce06a3",
  "ko": "그러네… 자, 건강 얘기가 나온 김에 오늘의 주술은 이겁니다"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 8,
  "jh": "2ae67de86248",
  "ko": "준비해 놨던 거냐!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "58c68a56e8d2",
  "ko": "뭐야? 그 짙은 초록색 액체는…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 2,
  "jh": "ab66df5be210",
  "ko": "이 약을 마시면 쑥쑥 건강해진다는 획기적인 주술…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 9,
  "jh": "c7c165458097",
  "ko": "그런 약 같은 건 주술이라고 안 하지 않나…?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 2,
  "jh": "1d0ed04fe596",
  "ko": "사소한 건 신경 쓰지 마… 자…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "b73a71f2d5e3",
  "ko": "아, 난 엄청 건강하거든!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 8,
  "jh": "7986b801c324",
  "ko": "나도! 야~ 오늘은 유난히 컨디션이 좋네!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 6,
  "jh": "2a35902a5f66",
  "ko": "이 몸은 태어나서 지금까지 병에 걸린 적도 없어!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 9,
  "jh": "d7d65eccad0b",
  "ko": "나도 필요 없어. 많은 여자애들을 상대하기 위해 평소부터 단련하고 있으니까"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 2,
  "jh": "26826d3356e1",
  "ko": "체력 바보들의 모임… 지원자가 없으면…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 2,
  "jh": "79d7627d650d",
  "ko": "초록 약이니까 초록 연결로 요정 씨로…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 6,
  "jh": "d773b5b62c38",
  "ko": "에에에!? 그런 단순한 이유로!?"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 1,
  "jh": "7955d1e90470",
  "ko": "좋아! 힘내, 페페론"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 8,
  "jh": "9d27363c885e",
  "ko": "너라면 뭘 마셔도 안 죽잖아"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 9,
  "jh": "7281b0e052bb",
  "ko": "이번만큼은 주인공 자리를 너한테 양보하지"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 6,
  "jh": "2958da52cddc",
  "ko": "아아, 다들 시선이 평소보다 다정한 것 같아…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 6,
  "jh": "cdf539670f9a",
  "ko": "싫어! 이 몸도 이런 정체 모를 거 마시기 싫다고!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 2,
  "jh": "058d86877ce9",
