[
 {
  "key": "m0",
  "kind": 2,
  "chr": 12,
  "jh": "a4f2e89e056c",
  "ko": "수고했다. 꽤 좋은 싸움을 보여 줬다. 음, 실로 만족스럽다!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "5459ded71a15",
  "ko": "남이 싸우는 걸 보고 즐기다니 악취미…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 8,
  "jh": "2637b3cf8974",
  "ko": "결국 우린 그 교감한테 놀아났을 뿐이네…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 12,
  "jh": "6386c3b0a43d",
  "ko": "하지만 싸움에는 항상 승자와 패자가 존재한다…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 12,
  "jh": "7967aebf7805",
  "ko": "승자에게는 아낌없는 찬사와 명예가 주어지지만, 패자에게 줄 것은 아무것도 없다"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 12,
  "jh": "438eb19e3c17",
  "ko": "그럼! 이번 우승자를 발표한다!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 12,
  "jh": "70652ccdfe01",
  "ko": "아~ 연금술과 울리카와 그 외 한 명이로군"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "663961c8fa3c",
  "ko": "오… 어? 우리가 우승? 그런데 왠지 텐션이 너무 낮지 않아?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 2,
  "jh": "661281572ea5",
  "ko": "그 외 한 명 취급…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 8,
  "jh": "e52dc31ad1de",
  "ko": "난 그 외 한 명 취급이냐…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 12,
  "jh": "199b2c880429",
  "ko": "싸움 자체는 재밌었지만 결과는 대단히 유감이다"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 12,
  "jh": "b72528dc2e10",
  "ko": "이 몸의 전투기술과 녀석들이 설마 이 녀석들한테 뒤처질 줄이야…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "8dfe07ffc5f2",
  "ko": "잠깐! 좀 더 제대로 소개해! 모처럼 우승했는데!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 12,
  "jh": "4b00f2350af5",
  "ko": "다시 처음부터 단련시켜야겠군"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 12,
  "jh": "c886015f3248",
  "ko": "마침 곧 겨울방학도 시작되니…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "970791fc4160",
  "ko": "야! 듣고 있어!?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 12,
  "jh": "8ea8ecd0f797",
  "ko": "시끄럽다. 됐으니까 냉큼 올라와라. 시상식이 진행이 안 되잖나"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "01cf8d1c70ef",
  "ko": "크… 나중에 실컷 불평해 줄 거야…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 12,
  "jh": "9734a915a2c5",
  "ko": "뭐, 아무튼 잘했다. 네놈들은 틀림없는 학원 최강의 콤비다"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 12,
  "jh": "cf5163c1a4d4",
  "ko": "자, 가슴을 펴고 성원에 응해 줘라"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "b203e987e630",
  "ko": "아, 응… 새삼 들으니 쑥스럽네, 이런 거…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "87c1fc93d28e",
  "ko": "남 앞에 나서는 거 질색인데…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 8,
  "jh": "7c465ca38994",
  "ko": "뭐, 가끔은 이런 것도 괜찮지 않냐"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 12,
  "jh": "8501bc2980e2",
  "ko": "그리고 기다리던 이 몸의 부상이다. 자, 받아라"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "4a7f9e3d8733",
  "ko": "어? 수표…? 그러니까, 일, 십, 백, 천… 어? 오, 오천만!?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "140347e29f66",
  "ko": "진짜…? 뭔가 더러운 돈 아니야…?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 8,
  "jh": "3065ac9dccd2",
  "ko": "아니, 아무래도 잘못 봤겠지… 윽, 진짜 5000만이다!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "6864632f2434",
  "ko": "잠깐, 여기선 진정하고… 응? 이게 뭐야, 단위가 GP라고 되어 있는데…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 12,
  "jh": "bae6b5e100e5",
  "ko": "군나르 포인트의 약자다"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 12,
  "jh": "5ed966a5e48c",
  "ko": "장래 전 세계에 전개할 예정인 군나르 그룹 가게라면 어디서든 쓸 수 있다"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "21816ed83aa5",
  "ko": "군나르… 포인트?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 2,
  "jh": "66a7e3a30882",
  "ko": "즉… 현시점에선 그냥 쓰레기…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 8,
  "jh": "8349a0ad489e",
  "ko": "가까운 장래라니… 뭐, 이럴 줄은 알았지만"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "3681189de4ac",
  "ko": "크… 아~ 정말! 뭐야! 헛기대하게 만들고!!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 12,
  "jh": "0736d5bc4217",
  "ko": "하하하. 기뻐해 줘서 다행이다"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "d8166e9ec9df",
  "ko": "안 기뻐하거든! 엄청 화났거든! 야! 듣고 있어!?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 12,
  "jh": "31cd65c8f2f1",
  "ko": "이상으로 시상식은 종료다! 각자 얼마 남지 않은 학원제의 한때를 즐겨라!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 1,
  "jh": "79b903fff66c",
  "ko": "그러니까, 남의 말 좀 들어~~!!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 12,
  "jh": "0a01765aac40",
  "ko": "우리 전투기술과의 에이스이자 이 몸의 수제자 로제!!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 12,
  "jh": "ea73eea1038b",
  "ko": "…와 그 외 한 명의 콤비다"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 1,
  "jh": "96bea0ed9de7",
  "ko": "에에? 그 녀석들?"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 2,
  "jh": "93b092a48d87",
  "ko": "아쉽다… 미리 확실히 짓밟아 둘 걸 그랬어…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 8,
  "jh": "099484023c3e",
  "ko": "뭐, 저쪽은 전투 전문가니까. 어쩔 수 없지"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 1,
  "jh": "25850272f2af",
  "ko": "으음… 분하지만 어쩔 수 없나. 아~아, 이제 돌아가자"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 2,
  "jh": "c1dcc8a8d472",
  "ko": "하아… 역시 울리카가 발목을 잡았나…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 8,
  "jh": "ebc1032533b5",
  "ko": "그러네. 더 봐 봤자 의미 없고"
 },
 {
  "key": "g0s0",
