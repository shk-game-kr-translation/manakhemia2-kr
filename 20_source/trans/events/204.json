[
 {
  "key": "m0",
  "kind": 2,
  "chr": 20,
  "jh": "3d942543dccf",
  "ko": "뭐? 요정 씨의 영수 만드는 법을 가르쳐 달라고?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "a4b118dcf9f8",
  "ko": "으, 응… 역시 안 돼요?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 20,
  "jh": "26382131c2bb",
  "ko": "…뭐, 순순히 물으러 왔으니 가르쳐 줄까"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 20,
  "jh": "66bc80d46852",
  "ko": "단, 내가 직접 가르쳐 주는 거다. 이러고도 형편없는 걸 만들었다간…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "24d9ac88c99d",
  "ko": "아, 알아요! 안다니까요!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 20,
  "jh": "d73e41ead7ec",
  "ko": "뭐, 실제로 그렇게 어려운 건 아니야"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 20,
  "jh": "06d1c0471ac3",
  "ko": "수수 열매랑 쓴 포도, 생수를 가마에 처넣고 끓이기만 하면 돼"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 20,
  "jh": "b69155af12a2",
  "ko": "수수 열매만은 물이 사는 숲에 가야 구할 수 있지만"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "ef3e8328eb18",
  "ko": "그렇구나… 좋아, 그럼 바로 재료 캐러…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 20,
  "jh": "cd9b36f7c971",
  "ko": "아아 잠깐. 요즘 학원 밖에서 수상한 녀석을 봤다는 소문이 있다"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 20,
  "jh": "ee52c7c6de32",
  "ko": "너희도 일단 여자니까. 둘이서만 멀리 나가지 마라"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "de2a4770f04e",
  "ko": "그럼 재료 캐러 못 가는데…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 20,
  "jh": "8713af41ee0c",
  "ko": "남자 친구 누구 꼬셔서 가면 되잖아"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "f7099bd53bc4",
  "ko": "…같이 가 줄 만한 친구 있어?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "7f30634fb24e",
  "ko": "난 혼자 있는 걸 좋아하니까…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 20,
  "jh": "3d002920e8da",
  "ko": "너희 말이야… 친구가 없다니 얼마나 쓸쓸한 학원 생활이냐"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 2,
  "jh": "5b814bb493fc",
  "ko": "…선생님도 친구 적을 것 같아"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 20,
  "jh": "51a257572542",
  "ko": "시끄러워! 내 얘긴 아무래도 좋아!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 20,
  "jh": "450bbeb1176a",
  "ko": "아무튼 누구랑 같이 가라. 알았지"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 1,
  "jh": "0125e9b4e6b6",
  "ko": "곤란하네… 둘이서만 가 버릴까?"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 2,
  "jh": "1c7a35496a96",
  "ko": "들키면 혼나…? 토니 선생님 집요해 보이고…"
 },
 {
  "key": "m21",
  "kind": 5,
  "chr": 12,
  "jh": "d2a869a42111",
  "ko": "후훗훗. 얘기는 잘 들었다"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "c699d6b95051",
  "ko": "앗!? 군나르… 선생님? 방금 어디서…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 12,
  "jh": "3bf6054e4976",
  "ko": "사소한 건 신경 쓰지 마라. 일부러 네놈들에게 도움 될 정보를 가져와 줬다"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 2,
  "jh": "38b632e64548",
  "ko": "…도움 될 정보? 누구 도와줄 사람이…?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 12,
  "jh": "a5829ffe7cdc",
  "ko": "그렇게 재촉하지 마라. 네놈들은 요정 씨라는 녀석들을 아나?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 2,
  "jh": "2e7bfee4aa40",
  "ko": "요정 씨…?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 12,
  "jh": "5d3deeeb8f99",
  "ko": "음. 예로부터 연금술사를 돕기 위해 존재해 온 종족이다"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 12,
  "jh": "f1fa9f3cb05a",
  "ko": "최근엔 통 모습을 안 보여서 멸종설도 나왔다만…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 12,
  "jh": "110c7eb49aa3",
  "ko": "요즘 학원 근처 요정의 나무에서 그 모습이 목격됐다고 한다"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "4b44c5b5e428",
  "ko": "그, 그런 편리한 종족이!"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 2,
  "jh": "a957eae2692c",
  "ko": "상당히 수상한 것 같은데…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 12,
  "jh": "cf82d26e82e7",
  "ko": "요정 씨는 은근히 호색이라. 젊은 여자를 즐겨 섬기는 습성이 있다더군"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 12,
  "jh": "5e5f5e4cb6c1",
  "ko": "찾아볼 가치는 있다고 생각하지 않나?"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "c2e4d5002073",
  "ko": "그런데 왜 그런 걸 가르쳐 주는 거예요? 우린 토니 선생님 반인데…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 12,
  "jh": "76e2bd9bb290",
  "ko": "후… 이 몸은 토니처럼 그릇 작은 남자가 아니다"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 12,
  "jh": "99af7ca581ab",
  "ko": "모든 학생에게 널리 사랑을 쏟아야 진정한 교사!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 1,
  "jh": "14bad4d3f977",
  "ko": "선생님… 고마워요! 토니 선생님이랑 달리 좋은 사람이었구나!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 12,
  "jh": "7dce757af2f9",
  "ko": "하하하! 그 말대로, 이 몸은 좋은 사람이다"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 12,
  "jh": "70ca7a2ff310",
  "ko": "자, 시간이 없겠지. 빨리 요정 씨를 찾으러 가라"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 1,
  "jh": "e9280167f542",
  "ko": "네! 끝내주는 요정 씨를 찾아올게요!"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 2,
  "jh": "8df0b26cdd25",
  "ko": "좀 더 잘 생각하는 게… 가 버렸네. 어쩔 수 없지…"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 12,
  "jh": "4dc9d678480a",
  "ko": "사자는 토끼를 잡을 때도 전력을 다한다고 했다…"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 12,
  "jh": "b17725c7f74b",
  "ko": "적의 세력은 조금이라도 깎아 둬야지. 나쁘게 생각하지 마라…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]