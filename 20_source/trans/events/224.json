[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "f75755c96519",
  "ko": "흐응, 이게 푸니푸니 구슬이구나… 자, 돌아가서 기말고사에 착수하자"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 22,
  "jh": "e25d76d90a4f",
  "ko": "우린 아직 못 돌아가나?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 11,
  "jh": "d92d7c0f1e60",
  "ko": "죄송해요. 조금만 더 아가씨 고집에 어울려 주세요"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 3,
  "jh": "2f7811cedb6e",
  "ko": "누가 고집이야! 작전이라고 해, 작전!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 11,
  "jh": "a7bb99e8dabd",
  "ko": "한 번 졌으니까 필사적이시거든요, 이번엔"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 3,
  "jh": "4cd1e1811357",
  "ko": "매번 한마디가 많아, 넌…!"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 11,
  "jh": "537ded9cfb98",
  "ko": "아파! 아가씨! 거기, 정통으로 관자놀이… 아아아아아!!"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 3,
  "jh": "7b2918661b1a",
  "ko": "흥. 그럼 여긴 맡길게"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 4,
  "jh": "ac9e684bb67e",
  "ko": "알겠다"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 1,
  "jh": "efea435465c8",
  "ko": "혼자가 됐네… 지금이 기회야!"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 2,
  "jh": "d10d6a1c35fd",
  "ko": "넷이서 한 명을 몰매 놓는구나…"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 8,
  "jh": "b6c6b33a8fc6",
  "ko": "일부러 듣기 싫은 말투 쓰지 마…"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 4,
  "jh": "02b9522c8542",
  "ko": "마음 쓸 것 없다. 넷이면 오히려 적은 편이다"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 6,
  "jh": "0800362bdc3b",
  "ko": "어라?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 8,
  "jh": "ca1c571fdc69",
  "ko": "으아아아!? 어, 어느새!?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 4,
  "jh": "958dc39ade55",
  "ko": "비밀 얘기를 할 땐 좀 더 작은 소리로 하는 게 좋다"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 4,
  "jh": "4ac6b72ccdfd",
  "ko": "자… 주인의 명령이라서 말이다. 나쁘게 생각하지 마라"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "9889bb82d90e",
  "ko": "자, 잠깐! 아직 이쪽은 준비가…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 8,
  "jh": "eee0a803cd45",
  "ko": "앗 뜨거! 부, 불이!?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "fc214cef7c45",
  "ko": "크… 갑자기 덮치다니 비겁한 거 아냐!?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 4,
  "jh": "d0dc12fc47d5",
  "ko": "넷이서 몰매를 꾸미던 녀석들의 대사라곤 생각할 수 없군"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "9864981bb336",
  "ko": "이런이런, 이거 위기일지도 모르겠네"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 4,
  "jh": "5aa93f1955f3",
  "ko": "…넌 힘을 아끼고 있는 모양이군. 무슨 꿍꿍이냐?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 6,
  "jh": "f4ac98c2d002",
  "ko": "아무 꿍꿍이도 없어~ 듣기 안 좋네"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 6,
  "jh": "cf181ffdb344",
  "ko": "그냥 이런 위기 땐 정의의 사도가 도와주지 않을까 해서"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 4,
  "jh": "0e385b85cc29",
  "ko": "정의의 사도라고…? 큿!?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 35,
  "jh": "d91ac253c188",
  "ko": "이런… 피해 버렸나. 아쉽네 아쉬워"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 4,
  "jh": "d489f75b4e20",
  "ko": "뭐냐, 네놈…?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "66ae84224311",
  "ko": "공이 말을 하고 있어…?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "027c26909df6",
  "ko": "안 되잖아, 한 방에 끝내야지. 모처럼 활약할 무대를 준비해 줬는데"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 35,
  "jh": "a7f695299b00",
  "ko": "여기선 적을 칭찬해야 하지 않을까. 순간적으로 그걸 반응해서 피했으니까"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 2,
  "jh": "1a892ae969fa",
  "ko": "…아는 사이야?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 6,
  "jh": "b13808f47050",
  "ko": "응, 수십 년 지기 친구야!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 9,
  "jh": "65f2a2aba5d9",
  "ko": "자기소개가 늦었군. 내 이름은 고토. 사람들은 날 떠돌이 사랑의 사냥꾼이라 부르지!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 2,
  "jh": "2cd21be9feea",
  "ko": "사랑의 사냥꾼…? 빨간 공 주제에…?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 9,
  "jh": "8ff4f75bcb19",
  "ko": "이건 세상을 속이는 임시 모습이야. 어떤 때는 빨간 공. 또 어떤 때는 크림슨 볼…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 8,
  "jh": "9fbefb43eff2",
  "ko": "아니, 그거 둘 다 같은 거잖아"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 9,
  "jh": "7827d92c1c0f",
  "ko": "그러나 그 정체는… 컴온! 마이 바디!"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 9,
  "jh": "3546aa848221",
  "ko": "아름다운 하얀 신수! 고토는 바로 나라네!!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 6,
  "jh": "b1b729b1213b",
  "ko": "오오오오! 멋있다~! 짜릿해~!!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 1,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 2,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 8,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 9,
  "jh": "af9926477106",
  "ko": "야아, 모두의 뜨거운 시선이 기분 좋군"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 9,
  "jh": "9d89282f5aff",
  "ko": "앞으로 오래 함께하겠지만 잘 부탁해. 아가씨"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 1,
  "jh": "41881135b435",
  "ko": "어? 오래 함께라니…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 9,
  "jh": "5b47c57c8323",
  "ko": "뭘, 사양할 필요 없어. 다름 아닌 페페론의 부탁이니까"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 6,
  "jh": "1f17d0cc80d0",
  "ko": "이 몸과 그가 손잡으면 천하무적. 세계 제패도 머지않았어!"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 8,
  "jh": "f2d9a6dd187a",
  "ko": "…야, 나 역시 이 아틀리에 그만둬도 될까?"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 2,
  "jh": "5ec486aab3b4",
  "ko": "…혼자 도망치는 건 절대 용서 안 해"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 4,
  "jh": "b12db01b5f0f",
  "ko": "…서두는 끝났나?"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 9,
  "jh": "f833484368ee",
  "ko": "아아, 미안 미안. 한참 기다리게 했군"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 4,
  "jh": "59ebaae2482c",
  "ko": "너나 그 남자나, 장난스러운 겉모습으로 실력을 숨기려는 건가?"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 9,
  "jh": "3a5b3e6e0166",
  "ko": "숨긴다고? 당치도 않아… 난 내가 가장 아름답다고 생각하는 차림을 했을 뿐이야"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 6,
  "jh": "4a434ff3b921",
  "ko": "물론 이 몸은 제일 귀엽다고 생각하는 차림이야!"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 4,
  "jh": "c6e94e1d5b4b",
  "ko": "…만만치 않은 녀석들이군. 뭐 됐다. 넷이 다섯이 됐다고 대세엔 영향 없다"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 1,
  "jh": "83561873ba92",
  "ko": "…왠지 나, 완전히 의욕이 꺾였는데"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 2,
  "jh": "e556d45c83af",
  "ko": "…솔직히 너무 장난스러운 것 같아"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 8,
  "jh": "2bb42bbc40e6",
  "ko": "…기분은 알지만 일단 상대는 하자. 응?"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 9,
  "jh": "53bf4ba1c701",
  "ko": "페페론! 오랜만에 우리의 콤비 플레이를 보여 주자고!"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 6,
  "jh": "e6b3a65610f4",
  "ko": "알겠습니다요!"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 4,
  "jh": "fb0d4b2d2cbe",
  "ko": "아무래도 불리했나…"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 9,
  "jh": "58e7435f4979",
  "ko": "너도 꽤 강했어. 일대일이었다면 승부는 어떻게 될지 몰랐지…"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 6,
  "jh": "c0ead10349f6",
  "ko": "네 패인을 꼽자면 이 몸의 귀여움에 방심해 버린 거겠지"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 4,
  "jh": "3bc983d827ca",
  "ko": "귀여운지는 모르겠지만 다소 방심이 있었던 건 인정하지"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 4,
  "jh": "ac11ef4a48c2",
  "ko": "하지만 다음엔 이렇게 안 된다. 기억해 둬라"
 },
 {
  "key": "m66",
  "kind": 0,
  "chr": 1,
  "jh": "6b5c393ee2a2",
  "ko": "저쪽은 끝까지 진지했네"
 },
 {
  "key": "m67",
  "kind": 0,
  "chr": 2,
  "jh": "9d92cd37b542",
  "ko": "응… 왠지 미안한 기분이 들어…"
 },
 {
  "key": "m68",
  "kind": 0,
  "chr": 8,
  "jh": "5b9a322e43e3",
  "ko": "왠지 확 지쳤다… 아아, 일단 푸니요네 구하러 갔다 올게"
 },
 {
  "key": "m69",
  "kind": 0,
  "chr": 9,
  "jh": "a2491adb74fd",
  "ko": "그럼 우린 아틀리에로 돌아갈까. 아가씨랑은 천천히 얘기를 나눠야겠어"
 },
 {
  "key": "m70",
  "kind": 0,
  "chr": 1,
  "jh": "e8de0cb22598",
  "ko": "어? 난 딱히 하고 싶은 얘기 없는데…"
 },
 {
  "key": "m71",
  "kind": 0,
  "chr": 2,
  "jh": "50cdf2957dfa",
  "ko": "난 기말고사 하고 있을게… 울리카는 천천히 즐기시길…"
 },
 {
  "key": "m72",
  "kind": 0,
  "chr": 6,
  "jh": "2fb1a2ede7de",
  "ko": "그렇게 정했으면 빨리 돌아가자, 누나!"
 },
 {
  "key": "m73",
  "kind": 0,
  "chr": 9,
  "jh": "a68ed224d209",
  "ko": "서로에 대해 실컷 이야기해 보자고… 자!"
 },
 {
  "key": "m74",
  "kind": 0,
  "chr": 1,
  "jh": "865e66712cca",
  "ko": "어, 잠깐… 싫어어어! 놔 줘어어!"
 },
 {
  "key": "m75",
  "kind": 0,
  "chr": 8,
  "jh": "b11e03937c02",
  "ko": "어라? 누나는?"
 },
 {
  "key": "m76",
  "kind": 0,
  "chr": 2,
  "jh": "dc5843700310",
  "ko": "…제물로 바쳐졌어"
 },
 {
  "key": "m77",
  "kind": 0,
  "chr": 5,
  "jh": "d7c62f75273f",
  "ko": "푸니~?"
 },
 {
  "key": "m78",
  "kind": 5,
  "chr": 1,
  "jh": "0e23f6ac91aa",
  "ko": "클로에에에에! 두고 봐아아아!!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]