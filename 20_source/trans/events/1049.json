[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "5988d752bb18",
  "ko": "깜깜하네…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "04dfcf052f37",
  "ko": "이러면… 학생 하나가 행방불명돼도 아무도 모를 거야…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "4911bb87428f",
  "ko": "그러니까 그런 말 하지 마!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 8,
  "jh": "0ea048eae945",
  "ko": "…그래서 우리도 당연하다는 듯 끌려왔고…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 8,
  "jh": "0595cbfc9574",
  "ko": "뭐, 이제 여러 의미로 포기했지만"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 6,
  "jh": "f9e7603fe63e",
  "ko": "마지막의 마지막까지 누나 뒤치다꺼리를 하게 되다니"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 9,
  "jh": "4ef4aad77159",
  "ko": "손이 많이 가는 딸일수록 귀엽다지만 아가씨는 좀 손이 너무 가는군"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "7da53b29defb",
  "ko": "거기, 시끄러워! 언제까지 꿍얼꿍얼…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 2,
  "jh": "8f2621cd524d",
  "ko": "쉿…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "aafa45e9140f",
  "ko": "응? 왜 그래"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "2884a16fe63c",
  "ko": "누가 있어…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 9,
  "jh": "e5c896f9f419",
  "ko": "응. 모습은 안 보이지만 뚜렷한 살의가 느껴지는군"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "f65beda75173",
  "ko": "에에에? 어디 있는데? 이놈! 숨지 말고 나와!"
 },
 {
  "key": "m13",
  "kind": 5,
  "chr": 35,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 6,
  "jh": "73ab22511742",
  "ko": "얘기할 생각은 없나 봐. 온다, 누나!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "80f6cb7a4734",
  "ko": "어? 어? 정말! 대체 뭐야!?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "76cfc55294f9",
  "ko": "하아, 하아… 어라? 적은 어디 갔어?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 2,
  "jh": "9c91236c07ee",
  "ko": "도망간 것 같아…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 9,
  "jh": "9bfd54b5fea0",
  "ko": "그만한 대미지를 받고 저 도주 속도… 적은 상당히 도망치는 데 익숙한 모양이군"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 8,
  "jh": "3075269ffc89",
  "ko": "뭐야, 도망치는 데 익숙하다는 건"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "460b4ab10468",
  "ko": "영문을 모르겠어! 토니 선생님은 안 오고! 이상한 건 덮쳐 오고!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "1d0e0ef5477b",
  "ko": "이제 됐어! 돌아가서 잘래!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 6,
  "jh": "2003c0c40e4f",
  "ko": "에에에, 괜찮아? 나중에 선생님한테 혼날걸?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "813b2d8a1ee7",
  "ko": "몰라! 언제까지고 안 오는 토니 선생님이 나빠!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 8,
  "jh": "d69060f3da6e",
  "ko": "가 버렸다… 괜찮아? 내버려 둬도"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "f93fdc13ded6",
  "ko": "아마 괜찮아… 왜냐면 방금 그림자…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 9,
  "jh": "ad1866c4bae6",
  "ko": "이런. 그 이상은 말하지 않는 게 배려야. 그의 명예를 위해서라도"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 8,
  "jh": "a12590db8e70",
  "ko": "뭐? 무슨 소리야?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 9,
  "jh": "5b33d2e95f90",
  "ko": "세상엔 모르는 게 나은 것도 있어. 자, 우리도 돌아가서 쉬자"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 8,
  "jh": "20ed983a68cc",
  "ko": "앗, 야! 기다려!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "70c4d2a5f326",
  "ko": "음~… 역시 사과해 두는 게 좋겠지"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "1ab1ea0d90af",
  "ko": "엄청 화났겠지… 에잇, 될 대로 되라! 실례합니다!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 20,
  "jh": "536c3a9862a0",
  "ko": "…뭐야, 너냐"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "c3e8022ba17e",
  "ko": "있잖아, 선생님. 어제 일인데… 나 제대로 교정에 갔었어?"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "41c77538e367",
  "ko": "그런데 토니 선생님이 전혀 안 와서 그래서…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 20,
  "jh": "17daf6c229a7",
  "ko": "아아, 그건 이제 됐다…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 20,
  "jh": "4292ed1f9c56",
  "ko": "그보다 너무 가까이서 큰 소리 내지 마. 네 목소리가 울려서 온몸이 아프다고…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 1,
  "jh": "45b9444b9c7b",
  "ko": "온몸이? 다쳤어?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 20,
  "jh": "85b0308bf946",
  "ko": "아무것도 아니야… 됐으니까 이제 돌아가. 보충 수업은 끝이다"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "ede32ff58ea5",
  "ko": "끝이라니, 나 아무것도 안 했는데…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 20,
  "jh": "b88d597c65eb",
  "ko": "됐으니까 군말 말고 돌아가! …아얏! 바보 자식, 소리 지르게 하지 마…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 1,
  "jh": "6b8fda34903c",
  "ko": "돌아가도 된다면 돌아가겠지만… 나중에 역시 보충 수업이라거나 안 하겠지?"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 20,
  "jh": "ea69a708c3f3",
  "ko": "안 해. 너무 끈질기면…"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 1,
  "jh": "9c78cdd1e17c",
  "ko": "와, 거짓말 거짓말! 그럼 이만!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 20,
  "jh": "33842208708b",
  "ko": "젠장… 그렇게 강해졌을 줄이야… 성적은 최저인 주제에…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 20,
  "jh": "db9003b3d150",
  "ko": "아야야야! …젠장, 못 해 먹겠다…"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 1,
  "jh": "d322ac74f818",
  "ko": "으, 으으으…"
 },
 {
  "key": "m47",
  "kind": 5,
  "chr": 35,
  "jh": "fb56f7d9c48c",
  "ko": "후후후, 손들었냐? 이걸로 질렸으면 다음부턴 성실하게 수업 들어라"
 },
 {
  "key": "m48",
  "kind": 0,
  "chr": 1,
  "jh": "eb77f3c9219b",
  "ko": "수업, 이라고… 당신, 대체 정체가…?"
 },
 {
  "key": "m49",
  "kind": 5,
  "chr": 35,
  "jh": "7db7cd8dd8d8",
  "ko": "나 말이냐? 난 지나가던… 사랑과 정의와 공부의 사자다!"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 1,
  "jh": "827072a45afe",
  "ko": "사랑과, 정의와… 공부…?"
 },
 {
  "key": "m51",
  "kind": 5,
  "chr": 35,
  "jh": "b66ebfcb73a9",
  "ko": "그렇다. 공부 안 하는 나쁜 학생에게 벌을 주는 게 주된 임무다"
 },
 {
  "key": "m52",
  "kind": 5,
  "chr": 35,
  "jh": "6a8c3e162a73",
  "ko": "오늘은 이걸로 봐주겠지만 네가 공부 안 하는 한 몇 번이고 와 주마"
 },
 {
  "key": "m53",
  "kind": 0,
  "chr": 1,
  "jh": "dcc8c97a034a",
  "ko": "으으… 공부의 사자… 얼마나 무서운… 털썩"
 },
 {
  "key": "m54",
  "kind": 5,
  "chr": 35,
  "jh": "b6ba77e215f4",
  "ko": "정신을 잃었나… 뭐, 오늘 밤은 거기서 머리를 식혀라. 하~하하하!"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 9,
  "jh": "a4ff49a44476",
  "ko": "…이야. 기습이라지만 내가 지다니"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 6,
  "jh": "79d95608f6bc",
  "ko": "…곤란하네… 그런데 방금 사람 역시…"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 2,
  "jh": "15d0be0bebaf",
  "ko": "그 이상 말하지 마… 그 사람한테 졌다니 자존심이 용납 못 해…"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 9,
  "jh": "89af2a9a276b",
  "ko": "아아, 그건 완전히 동감이야… 이런이런…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]