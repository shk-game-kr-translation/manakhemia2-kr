[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "5275f090d512",
  "ko": "이거면 되지? 그래서, 이번엔 뭘 저지를 생각이야?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "890f7bd1d1df",
  "ko": "응… 이걸 써서…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 6,
  "jh": "2be731f83132",
  "ko": "싫어어! 어둑한 감옥에서 맛없는 밥 먹는 건 이제 싫다고오!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 9,
  "jh": "077a395acce3",
  "ko": "하하하. 완전히 트라우마가 된 모양이군"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 2,
  "jh": "0724b821b323",
  "ko": "계속 생각했어… 나한테 뭐가 부족한지… 그건 바로 마스코트 캐릭터…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "1c29d0f0ef89",
  "ko": "…뭐?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 2,
  "jh": "d7487f9ba363",
  "ko": "예를 들면 우류 같은… 그게 없어서 난 음침하고 으스스한 애로 여겨져서…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 8,
  "jh": "dfd70fd8abbc",
  "ko": "그 이전의 문제잖아… 그래서 마스코트 캐릭터를 어떻게 구하는데"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 2,
  "jh": "1b6ae4cca629",
  "ko": "악마를 소환할까 해서…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 9,
  "jh": "2b2b6a9857d9",
  "ko": "아아. 그 발상은 무척 너답군"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "d532393f29f3",
  "ko": "시간 걸리니까 다들 먼저 돌아가… 방해되고"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "c4df15d37cda",
  "ko": "부탁 안 해도 돌아갈 거야. 괜히 휘말리기 싫으니까"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 6,
  "jh": "42e2248d6431",
  "ko": "싫어어어! 감옥은, 감옥은 싫어어!!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 9,
  "jh": "ce358fc50920",
  "ko": "자, 너도 언제까지 소리 지르지 말고. 간다"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 2,
  "jh": "10d76e331526",
  "ko": "자… 시작해 볼까…"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 2,
  "jh": "be3e22176ab9",
  "ko": "이걸로 준비 완료… 이제 주문을 외우면…"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 2,
  "jh": "ba386fe6a801",
  "ko": "…어라? 무슨 주문이었더라… 됐다, 대충 하자"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 2,
  "jh": "91d39ee6fb38",
  "ko": "악마 쿠마쿠마 아쿠마쿠마~ 루루루~…"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 2,
  "jh": "5fb0d716334c",
  "ko": "………어라? 실패했나… 악마가 없어…"
 },
 {
  "key": "m19",
  "kind": 5,
  "chr": 43,
  "jh": "b7644c3f86df",
  "ko": "있거든. 여기에"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 2,
  "jh": "e9b56998a187",
  "ko": "어… 어디…?"
 },
 {
  "key": "m21",
  "kind": 5,
  "chr": 43,
  "jh": "736a2ff7d57a",
  "ko": "여기. 너의 몸속"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 2,
  "jh": "e80d089e0f0c",
  "ko": "………!?"
 },
 {
  "key": "m23",
  "kind": 5,
  "chr": 43,
  "jh": "e65fe2645804",
  "ko": "후후, 초보자가 소환 같은 걸 하니까… 네 몸을 빼앗아 버렸어"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 2,
  "jh": "d4c641fb93ff",
  "ko": "그건 좀 곤란한데…"
 },
 {
  "key": "m25",
  "kind": 5,
  "chr": 43,
  "jh": "bda0327b2578",
  "ko": "별로 곤란해 보이지 않는데… 뭐 됐어"
 },
 {
  "key": "m26",
  "kind": 5,
  "chr": 43,
  "jh": "33202a411c48",
  "ko": "자, 이 몸으로 마음대로… 어머, 누가 온 모양이네"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "7f15421581ef",
  "ko": "클로에, 괜찮아? 왠지 엄청난 소리가 났는데"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 8,
  "jh": "994355c025d9",
  "ko": "악마는… 없네. 실패했어?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 43,
  "jh": "a6a3aacac484",
  "ko": "…후훗, 유감이네. 여기 있어"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 6,
  "jh": "240f735826b3",
  "ko": "어? 어디?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 43,
  "jh": "f0b1d41a44a2",
  "ko": "이 아이 몸속. 이 아이 몸은 내가 빼앗아 버렸어"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 8,
  "jh": "6a185c24b22c",
  "ko": "…무슨 소리야? 머리 괜찮냐?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 43,
  "jh": "9f6abcef5092",
  "ko": "후후, 못 믿는 것도 무리는 아니지만… 그래"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 43,
  "jh": "c3d13776446f",
  "ko": "인간 한둘쯤 말살해 보이면 알아주려나?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 6,
  "jh": "87766cd4614c",
  "ko": "…하는 말은 평소 검은 누나랑 다를 게 없네"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 43,
  "jh": "5590ff801110",
  "ko": "어?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 9,
  "jh": "482704daf11d",
  "ko": "응. 차이라면 평소보다 말투가 유창하다는 정도일까"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 6,
  "jh": "9731c099378c",
  "ko": "보아하니 악마 소환에 실패해서 쑥스러움을 감추는 거구나. 귀여운 데가 있네"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 43,
  "jh": "e4b33aa392fc",
  "ko": "아니, 그게…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 1,
  "jh": "b72b1fa9c3b5",
  "ko": "정말이지 무슨 일인가 했잖아. 괜히 소란 피우기는"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 9,
  "jh": "ab272bd78bdd",
  "ko": "자자. 아무 일도 없었던 걸 다행으로 여겨야 하지 않을까, 여기선"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 43,
  "jh": "da013ec84f70",
  "ko": "자, 잠깐. 기다려!"
 },
 {
  "key": "m43",
  "kind": 5,
  "chr": 43,
  "jh": "91564c255046",
  "ko": "…너, 친구들한테 어떻게 여겨지는 거야?"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 2,
  "jh": "8211830fcdb8",
  "ko": "다들 편견 덩어리라서… 있잖아, 나도 묻고 싶은 게 있는데…"
 },
 {
  "key": "m45",
  "kind": 5,
  "chr": 43,
  "jh": "5f01f6d76eeb",
  "ko": "뭔데?"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 2,
  "jh": "2b9dcb1c34d9",
  "ko": "어떻게 인간을 말살할 생각이었어…?"
 },
 {
  "key": "m47",
  "kind": 5,
  "chr": 43,
  "jh": "420814a12fff",
  "ko": "그건 그냥 협박이야. 진짜로 말살 같은 거 하면 아프고 불쌍하잖아"
 },
 {
  "key": "m48",
  "kind": 0,
  "chr": 2,
  "jh": "7371bd560358",
  "ko": "허세…? 뭐야, 기대해서 손해 봤네…"
 },
 {
  "key": "m49",
  "kind": 5,
  "chr": 43,
  "jh": "92256f4f7e69",
  "ko": "…그렇구나, 친구들이 왜 그런 반응을 했는지 잘 알겠어"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 2,
  "jh": "bbbb27ba1c93",
  "ko": "이제 어떡할까…?"
 },
 {
  "key": "m51",
  "kind": 5,
  "chr": 43,
  "jh": "d851f3d47f17",
  "ko": "어떡할까… 인간이 놀라 주지 않으면 악마 할 맛도 안 나고…"
 },
 {
  "key": "m52",
  "kind": 0,
  "chr": 2,
  "jh": "f5f115f0716b",
  "ko": "왠지 엄청 어중간한 상황이 돼 버렸어…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]