[
 {
  "key": "m0",
  "kind": 0,
  "chr": 86,
  "jh": "440dd6f85ce3",
  "ko": "저기! 이거 저희 반에서 만든 건데요, 괜찮으시면…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 88,
  "jh": "760859b66a93",
  "ko": "저희 반은 가면을 만들었어요! 고토 님께 어울릴 것 같아서!"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 83,
  "jh": "714303d85f4c",
  "ko": "저, 저기. 이거 제가 구운 쿠키인데요…"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 87,
  "jh": "c5f0e85d3451",
  "ko": "아앗! 혼란한 틈을 타서 무슨 혼자만 주고 있어!"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 9,
  "jh": "4b3a8c91de5d",
  "ko": "날 위해 다투지 말아 줘. 너희의 사랑은 전부 고맙게 받을 테니까"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "3c29ebf9dbcd",
  "ko": "여전한 인기네"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 8,
  "jh": "521dfae0bf9b",
  "ko": "그래, 납득은 안 가지만"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "d8e0ac0a7733",
  "ko": "형, 남자의 질투는 꼴사나워?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 8,
  "jh": "643cb6d39a80",
  "ko": "질투 같은 거 안 해!"
 },
 {
  "key": "m9",
  "kind": 5,
  "chr": 18,
  "jh": "a4f561196e4d",
  "ko": "무슨 소란이에요!?"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 88,
  "jh": "55b78434e38e",
  "ko": "꺅! 이사장이야!"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 87,
  "jh": "609e738d7a09",
  "ko": "잡히면 몇 시간이나 설교 들을지… 도망치자!"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 86,
  "jh": "6da280f1ca3e",
  "ko": "죄송해요, 고토 님. 저희는 이만…"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 18,
  "jh": "1b8cf3c3401f",
  "ko": "기다리세요! 정말이지, 학원제라고 들떠서는… 앗!? 고, 고토 님!?"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 9,
  "jh": "90c1868fb229",
  "ko": "야아, 마루타. 화난 얼굴도 매력적이군"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 8,
  "jh": "5a76e148bbb2",
  "ko": "있잖아, 저 둘을 만나게 하는 거 위험하지 않아?"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 1,
  "jh": "eee367524c61",
  "ko": "아, 그렇지. 요전의 도청이…"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 2,
  "jh": "483d8d842ff5",
  "ko": "수라장이 되려나… 두근두근…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 18,
  "jh": "081a8a9df176",
  "ko": "저, 그게… 지난번엔 큰 실례를!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 18,
  "jh": "a77cad78d69e",
  "ko": "설마 제 방이 도청되고 있었을 줄이야. 고토 님께 큰 폐를…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 9,
  "jh": "a0222b1610c0",
  "ko": "신경 쓸 거 없어. 떳떳하지 못한 짓을 한 것도 아니니까"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 9,
  "jh": "5dc12d94b940",
  "ko": "오히려 온 세상 사람들에게 들려주고 싶을 정도야"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 18,
  "jh": "3ecc77face19",
  "ko": "아아… 어쩜 이리 다정한 말씀을…"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 1,
  "jh": "4dde697e592d",
  "ko": "이사장 머릿속에선 그렇게 된 거구나…"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 8,
  "jh": "f24f9ca79ce7",
  "ko": "원만하게 수습된 모양이네… 이것저것 틀렸지만"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 2,
  "jh": "dbe44b1ec9b4",
  "ko": "칫…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]