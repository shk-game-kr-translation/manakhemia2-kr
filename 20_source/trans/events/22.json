 {
  "key": "m20",
  "kind": 2,
  "chr": 35,
  "jh": "10e6755c60de",
  "ko": "정확히는 검이 빛나는 게 아니라 이 반지의 마력이 검에서 나올 뿐이지만"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 35,
  "jh": "93483065f06d",
