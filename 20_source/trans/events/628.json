[
 {
  "key": "m0",
  "kind": 2,
  "chr": 7,
  "jh": "785f537553dc",
  "ko": "곧 밖이야! 이걸로 자유의 몸이네!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 7,
  "jh": "58844749b74e",
  "ko": "어라, 안 기뻐?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 0,
  "jh": "c10b0bbbeab5",
  "ko": "원래 도망치고 싶었던 게 아니니까. 게다가 이렇게 순순히 될 리가…"
 },
 {
  "key": "m4",
  "kind": 5,
  "chr": 3,
  "jh": "55529a23b569",
  "ko": "그 말대로야. 역시 잘 알고 있네"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 7,
  "jh": "b3aa08acb202",
  "ko": "나왔다! 최종 보스!!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "f23db9a344fb",
  "ko": "누가 최종 보스야! 오히려 정의의 히로인이라고 불러 줬으면 해"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 3,
  "jh": "076e0295a188",
  "ko": "남의 종자를 채 가는 악의 도둑고양이를 퇴치하러 온 거니까"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 7,
  "jh": "c7e685fb1e65",
  "ko": "에~ 치사해. 나도 정의의 편이 좋아~"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "456088b088f5",
  "ko": "…야, 아가씨 텐션 이상해지지 않았냐?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 11,
  "jh": "dd17559cfe1b",
  "ko": "아무래도 너무 화가 나서 감정이 한 바퀴 돌아 버린 것 같아요…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "a0cf1ecb7933",
  "ko": "그렇군… 뭐, 내가 피해자라는 걸 이해해 준다면 다행인데"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 11,
  "jh": "9aaaa1f7c3e8",
  "ko": "안심할 순 없어요. 지금 아가씨에겐 논리가 안 통하니까요"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 3,
  "jh": "a298c2bd2d5e",
  "ko": "자, 얌전히 로제를 돌려줘"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 3,
  "jh": "8ec2a206c9b6",
  "ko": "순순히 따르면 한 방에. 거스르면 서서히 괴롭히며 보내 줄게"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 7,
  "jh": "364ba0a5f903",
  "ko": "에에? 어떡하지… 앗! 어느 쪽이든 당하잖아!?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 3,
  "jh": "76ff02dbae71",
  "ko": "후후후, 로제에게 손댄 시점에 네 운명은 정해져 있었어"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 7,
  "jh": "29378647dd31",
  "ko": "릴리아 하는 말이 엉망진창…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 7,
  "jh": "cde0cd21a718",
  "ko": "애초에 난 채 간 거 아니야. 로제가 스스로 따라온 거야"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "4ea32a274b80",
  "ko": "야. 슬쩍 엄청난 거짓말 하지 마"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "977a18fd3c1f",
  "ko": "…그게 사실이라면 로제에게도 상당한 벌이 필요하겠네"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "bc72787cacf0",
  "ko": "아니에요! 라기보다 아가씨도 보셨잖아요!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 7,
  "jh": "1ce7874a4760",
  "ko": "이제 포기하고 둘이서 릴리아를 해치워 버리자"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "e7bc6ce88771",
  "ko": "앗, 이놈! 누구 허락받고 로제한테 달라붙어 있어!? 떨어져!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 7,
  "jh": "0e9687ec905e",
  "ko": "싫~어. 왜냐면 나랑 로제는 연인 사이인걸~"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "3947fe4752e0",
  "ko": "끼이이이! 나도 아직, 그런… 끼이이이!!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 11,
  "jh": "8b7fc09c336b",
  "ko": "이야~ 근래 보기 드문 분노네요"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "a2f74be6d4c9",
  "ko": "태평하게 보지 말고 좀 도와줘…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "a0c202d9218a",
  "ko": "애초에 로제가 다 잘못했어! 우유부단하게 언제까지고 태도를 분명히 안 하니까!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 0,
  "jh": "8dfbc70b8183",
  "ko": "뭐, 뭐예요 갑자기?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "9fa66e49d678",
  "ko": "이참에 확실히 말해!"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 3,
  "jh": "48f319ae3541",
  "ko": "나랑 에토. 어느 쪽을 그, 그러니까, 그게… 조, 조조조, 좋… 아해…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 7,
  "jh": "878eeb83b6f1",
  "ko": "무슨 말 하는지 전혀 안 들려"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 11,
  "jh": "165f98956493",
  "ko": "풉… 쿡쿡… 아가씨, 귀여워…!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 0,
  "jh": "7323889ebbf1",
  "ko": "즐기고 있지. 너 절대 즐기고 있지"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 3,
  "jh": "f84a3ea56557",
  "ko": "아~ 정말! 답답한 건 그만!!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 3,
  "jh": "603b9dfcc0d7",
  "ko": "나랑 너, 싸워서 이긴 쪽이 로제를 갖는 거야. 그렇게 하자. 알았지!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 7,
  "jh": "ad8e5ba37537",
  "ko": "아, 그거 좋을지도. 왠지 알기 쉽고"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 11,
  "jh": "a8fbb542f8c6",
  "ko": "완전히 상품 취급이네요"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 0,
  "jh": "290e126698ad",
  "ko": "…흠씬 두들겨 맞을 각오를 했으니 아직 나은 편이군"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 11,
  "jh": "88ccefc2aa5f",
  "ko": "상품 취급이 나은 편… 로제 씨 불쌍하네요…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 3,
  "jh": "d9b653e702c3",
  "ko": "윔! 떠들지 말고 빨리 이리 와!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 11,
  "jh": "9c7678ed5563",
  "ko": "아, 네~ 그럼 잠깐 다녀올게요"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 7,
  "jh": "0ed63b20668c",
  "ko": "릴리아라고 봐주지 않을 거야!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "fbaa024a56b2",
  "ko": "당연하지. 봐주고 나한테 이길 생각이야?"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 7,
  "jh": "625a5f0e7131",
  "ko": "좋~아, 간다~~!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 3,
  "jh": "1d96e0652e49",
  "ko": "와. 로제에게 꼬이는 벌레는 내가 전부 없애 줄게!"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 7,
  "jh": "9ca9077319cc",
  "ko": "해… 해냈다~~! 이겼다~~!!"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 3,
  "jh": "c3cbc473c1d7",
  "ko": "그, 그런… 내가, 졌어…?"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 11,
  "jh": "68e71f5c9531",
  "ko": "아야야… 당해 버렸네요"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 0,
  "jh": "60252d00ec02",
  "ko": "놀랐네. 진심인 아가씨가 지다니…"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 7,
  "jh": "a94b234190d5",
  "ko": "사랑의 힘은 위대한 거야!"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 3,
  "jh": "f2f332edc555",
  "ko": "큭… 그래, 이게… 사랑의 힘…"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 0,
  "jh": "12a18c0fec7e",
  "ko": "그러니까 이 녀석이랑 사이에 사랑 같은 건…"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 3,
  "jh": "c829b08ede98",
  "ko": "위로 따윈 필요 없어! 져 버린 이상 약속대로 로제는 너에게…"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 3,
  "jh": "504a0fc81fc8",
  "ko": "너에게 주… 주… 으으으으… 싫어~! 역시 주기 싫어~!!"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 7,
  "jh": "1f37f349f792",
  "ko": "아, 괜찮아. 딱히 필요 없고"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 3,
  "jh": "aef48060a3e5",
  "ko": "…뭐?"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 11,
  "jh": "257ff8807e16",
  "ko": "…네?"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 0,
  "jh": "8819493163b5",
  "ko": "…뭐라고?"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 7,
  "jh": "15fc63c7e66f",
  "ko": "딱히 로제 같은 거 필요 없다고. 그러니까 릴리아한테 돌려줄게"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 7,
  "jh": "a54dcd445283",
  "ko": "재밌었고 연인 기분도 맛봤으니까 이제 배불러!"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 3,
  "jh": "46aea8d99c96",
  "ko": "어, 그럼… 이 소동은 대체…"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 0,
  "jh": "e99edf5f10e2",
  "ko": "…화내도 되는 데죠? 여긴…"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 11,
  "jh": "e2e39fff999b",
  "ko": "전 화를 넘어서 어이가 없네요…"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 7,
  "jh": "3af094feedba",
  "ko": "자! 운동 많이 했더니 지쳤어. 돌아가서 낮잠 자야지"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 0,
  "jh": "5d0edc07ef97",
  "ko": "야, 기다려! 아직 할 말이…"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 7,
  "jh": "72145dd390c1",
  "ko": "로제 덕분에 엄청 재밌었어! 다음에 또 연인 하자! 그럼!"
 },
 {
  "key": "m68",
  "kind": 0,
  "chr": 0,
  "jh": "2910b3414381",
  "ko": "뭐… 야, 이봐!"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 11,
  "jh": "8875b05f2890",
  "ko": "연인 하자라니, 엄청난 말이네요…"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 3,
  "jh": "fb49254d42fd",
  "ko": "………. 큭… 저, 저 바보 계집애애애!!"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 11,
  "jh": "d8ff2fd71925",
  "ko": "와. 아, 아가씨, 제발 진정하세요…"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 3,
  "jh": "08dedc9d0318",
  "ko": "이 상황에서 어떻게 진정하라는 거야!! 아아아아!!"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 0,
  "jh": "4668529f1283",
  "ko": "마음은 알겠지만…"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 3,
  "jh": "4dd6198fb942",
  "ko": "애초에 네가 똑바로 안 하니까 이렇게 됐잖아!!"
 },
 {
  "key": "m75",
  "kind": 2,
  "chr": 0,
  "jh": "944584dcbf6e",
  "ko": "아차. 이쪽으로 불똥이 튀었다…"
 },
 {
  "key": "m76",
  "kind": 2,
  "chr": 3,
  "jh": "3ab0899e9190",
  "ko": "너한텐 새삼 주종의 마음가짐을 가르쳐 줄게… 자, 따라와!"
 },
 {
  "key": "m77",
  "kind": 2,
  "chr": 0,
  "jh": "ec8a2ab6757f",
  "ko": "기다려, 기다려 주세… 결국 이렇게 되는 거냐아아!!"
 },
 {
  "key": "m78",
  "kind": 0,
  "chr": 11,
  "jh": "3435fffa18aa",
  "ko": "힘내세요~… 자, 상처 약이나 준비해 둘까…"
 },
 {
  "key": "m79",
  "kind": 5,
  "chr": 0,
  "jh": "1bbf4a7164a4",
  "ko": "아… 아… 아아아아아아아아!!!?"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]