 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 23,
  "jh": "4f99710c1c03",
  "ko": "왠지 가슴이 술렁여… 라며 여동생이 불온한 공기를 감지하고 있어요"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "c44bad6ee1f9",
