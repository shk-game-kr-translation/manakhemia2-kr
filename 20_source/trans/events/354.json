 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 2,
  "jh": "131ef0f9084a",
  "ko": "자자… 그만큼 울리카 인상이 흐리다는 거야…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "01daea51ec9f",
  "ko": "전혀 위로가 안 되거든!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 8,
  "jh": "e1ce02772d79",
  "ko": "그래서, 갈 거야? 가능하면 그 교감이랑은 엮이고 싶지 않은데…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "f63e9e5e7094",
