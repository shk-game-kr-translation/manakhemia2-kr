[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "225e0d666c55",
  "ko": "자, 다음엔 어디 갈까"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 8,
  "jh": "9be9ed2f0baa",
  "ko": "너무 들뜨지 마. 꼴사나워"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 1,
  "jh": "438251eccc76",
  "ko": "축제 때 안 들뜨면 언제 들떠. 애초에 너는…"
 },
 {
  "key": "m3",
  "kind": 5,
  "chr": 12,
  "jh": "ca26ba284579",
  "ko": "아~ 아~ 들리나"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 6,
  "jh": "c250bf44c3c7",
  "ko": "어라? 이 목소리는…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 2,
  "jh": "25b4fc99d695",
  "ko": "군나르 선생님 목소리… 불길한 예감…"
 },
 {
  "key": "m6",
  "kind": 5,
  "chr": 12,
  "jh": "564e7be1d146",
  "ko": "각자 학원제를 즐기고 있는 모양이군. 이 몸도 고생한 보람이 있다는 것…"
 },
 {
  "key": "m7",
  "kind": 5,
  "chr": 12,
  "jh": "c843bd0f8ca5",
  "ko": "하지만 올해 학원제는 이걸로 끝이 아니다"
 },
 {
  "key": "m8",
  "kind": 5,
  "chr": 12,
  "jh": "f4c04843f47d",
  "ko": "이제부터 드디어 메인 이벤트의 시작이다!"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 9,
  "jh": "d75c0cc1f6e3",
  "ko": "메인 이벤트라… 역시 뭔가 꾸미고 있었군"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 18,
  "jh": "bd3a31155cca",
  "ko": "메인 이벤트…? 교장, 뭔가 들은 거 있나요?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 13,
  "jh": "204f8ae83622",
  "ko": "아뇨, 저는 아무것도…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 18,
  "jh": "86d20e4ecd9b",
  "ko": "또 뭔가 무모한 일을 시작할 생각은 아니겠죠…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 13,
  "jh": "91a6a258de88",
  "ko": "군나르가 하는 일이니 무모한 게 뻔하다고 생각하는데요"
 },
 {
  "key": "m14",
  "kind": 5,
  "chr": 12,
  "jh": "b946a933edea",
  "ko": "궁금한 메인 이벤트의 내용은… 바로! 학생 전원의 배틀 로열이다!"
 },
 {
  "key": "m15",
  "kind": 5,
  "chr": 12,
  "jh": "176723e1d5d4",
  "ko": "지금부터 네놈들에겐 학생끼리 피로 피를 씻는 싸움을 벌여 받겠다!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 13,
  "jh": "b067510a9d60",
  "ko": "거봐요, 역시 무모하잖아. 그쵸, 내 말대로죠?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 18,
  "jh": "8a376ebd9a7f",
  "ko": "뭘 기뻐하고 있어요! 빨리 가서 말리세요!!"
 },
 {
  "key": "m18",
  "kind": 5,
  "chr": 12,
  "jh": "3f0e87be32fa",
  "ko": "싸움은 2인 1조 팀끼리 하게 된다"
 },
 {
  "key": "m19",
  "kind": 5,
  "chr": 12,
  "jh": "0ce01cf9d81b",
  "ko": "물론 혼자 싸우고 싶다면 그래도 상관없다"
 },
 {
  "key": "m20",
  "kind": 5,
  "chr": 12,
  "jh": "6715d84d62d5",
  "ko": "각자 제한 시간 내에 10번 전투를 해서 가장 많이 이긴 자를 우승으로 한다"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "05fbf93732b2",
  "ko": "또 살벌한 걸 생각해 냈네…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 8,
  "jh": "bb0e926fd90b",
  "ko": "봐줘라… 끝날 때까지 어디 숨어 있을까"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "de6403e785d2",
  "ko": "숨어도 들켜서 쓰러질 거야… 나한테…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 8,
  "jh": "3c180fd20efc",
  "ko": "누나한테냐고!?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 6,
  "jh": "55141190dbc4",
  "ko": "배틀 로열이라… 이 몸, 불타오르는걸!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 9,
  "jh": "f9b306f99469",
  "ko": "하하하, 이건 오랜만에 나랑 페페론의 골든 콤비가 부활하려나"
 },
 {
  "key": "m27",
  "kind": 5,
  "chr": 12,
  "jh": "a4d57fe160cf",
  "ko": "참가 자격이 있는 건 본교 학생뿐"
 },
 {
  "key": "m28",
  "kind": 5,
  "chr": 12,
  "jh": "b04acceb39b8",
  "ko": "떠돌이 마나나 요정 씨, 탈인형 부류는 참가 불가다"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "1f121088d48f",
  "ko": "그, 그런!?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 9,
  "jh": "6a92d6448a17",
  "ko": "이런… 꽤나 핀포인트인 참가 금지령이군"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 11,
  "jh": "86f0a8fd5e63",
  "ko": "저는 떠돌이 마나가 아니니까 문제없죠"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 5,
  "jh": "0738d4a7bd34",
  "ko": "푸니! 푸니니~!?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 23,
  "jh": "5481a4667727",
  "ko": "탈것으로 삼고 있는 형제는 어떻게 되냐고!? 여동생이 묻고 있는데요~!!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 0,
  "jh": "d4089f73529f",
  "ko": "있잖아, 여기서 소리쳐 봤자 들릴 리가…"
 },
 {
  "key": "m35",
  "kind": 5,
  "chr": 12,
  "jh": "f8a77f3e75eb",
  "ko": "그렇군. 탈것으로 삼은 형제나 푸니푸니에 관해서는 특별히 허가해 주마"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 4,
  "jh": "b642fcff0a22",
  "ko": "들렸던 모양이군"
 },
 {
  "key": "m37",
  "kind": 5,
  "chr": 12,
  "jh": "1559933b7749",
  "ko": "우승자에겐 학원 최강의 명예와 이 몸이 준비한 비장의 부상을 선물해 주마"
 },
 {
  "key": "m38",
  "kind": 5,
  "chr": 12,
  "jh": "57b8bfed2a8d",
  "ko": "항의, 불만은 일절 받지 않는다. 이상이다… 자, 마음껏 싸워라!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "a6a98b997ebf",
  "ko": "배틀 로열이라…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 6,
  "jh": "bd6c865fc8f7",
  "ko": "좋겠다. 치사해. 누나들만…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 8,
  "jh": "6fab0314a380",
  "ko": "가능하면 바꿔 주고 싶다. 이쪽은…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 2,
  "jh": "8e8f67b4f6a2",
  "ko": "어쩌면… 재밌을지도…"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 8,
  "jh": "94122d34503c",
  "ko": "뭐, 적당히 넘기자. 누나도 별로 내키지 않지?"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 1,
  "jh": "f909d52427f8",
  "ko": "아니, 할 거야! 모처럼의 축제인걸. 안 하면 손해 본 기분이잖아"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 9,
  "jh": "069880d8fca0",
  "ko": "춤추는 바보에 구경하는 바보라는 거로군. 뭐, 긍정적인 건 좋은 거지"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 1,
  "jh": "05416f14006d",
  "ko": "그래서, 문제는 누구랑 참가하느냐인데…"
 },
 {
  "key": "m47",
  "kind": 5,
  "chr": -1,
  "jh": "dd90b5633120",
  "ko": "누구와 짝을 짓겠습니까?"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "32faac002a47",
  "ko": "클로에와 짝짓기"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "8cd0106922e3",
  "ko": "에나와 짝짓기"
 },
 {
  "key": "g0s2",
  "kind": "sel",
  "jh": "67543bc52967",
  "ko": "페페론과 짝짓기"
 },
 {
  "key": "g0s3",
  "kind": "sel",
  "jh": "0f8901baca1f",
  "ko": "고토와 짝짓기"
 }
]