[
 {
  "key": "m0",
  "kind": 2,
  "chr": 13,
  "jh": "ef2f9f2a58a6",
  "ko": "오, 돌아왔구나. 책은 제대로 읽고 왔니?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "f0213741a177",
  "ko": "물론이지! 뭐든 물어봐"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 13,
  "jh": "0786930ac485",
  "ko": "자신만만하네. 그럼 바로 첫 번째 질문이야"
 },
 {
  "key": "m3",
  "kind": 5,
  "chr": 13,
  "jh": "cf2a0c914f93",
  "ko": "더 나은 연금술사가 되려면 뭐가 필요하다고 쓰여 있었을까?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 13,
  "jh": "ebb5944f009d",
  "ko": "응, 정답. 그럼 다음 질문"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 13,
  "jh": "4788c5d4c90a",
  "ko": "어라? 그랬나… 뭐 됐어, 그럼 다음 질문"
 },
 {
  "key": "m6",
  "kind": 5,
  "chr": 13,
  "jh": "7adb8abd4c49",
  "ko": "많은 책을 읽고, 신께 기도를 드리고… 그다음에 이어지는 문장은 뭐였을까?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 13,
  "jh": "3af7fbb09ee0",
  "ko": "오, 정답. 그럼 다음은 마지막 질문"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 13,
  "jh": "cea5bf4f108c",
  "ko": "음~ 아쉽다. 정답은 필사적으로 일한다, 야. 자, 그럼 마지막 질문"
 },
 {
  "key": "m9",
  "kind": 5,
  "chr": 13,
  "jh": "c5fe0638a17f",
  "ko": "연금술사에게 특히 필요한 지식은 뭐라고 쓰여 있었을까?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 13,
  "jh": "850203da2014",
  "ko": "응, 훌륭해. 그 말대로야"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 13,
  "jh": "131d7d1c9115",
  "ko": "아닌데. 정답은 대장 일이나 유리에 관한 지식이었는데…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 13,
  "jh": "0dd622dacdf0",
  "ko": "자, 이걸로 모든 질문이 끝났는데, 궁금한 성적은…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 13,
  "jh": "d04d9cf22697",
  "ko": "훌륭하게 전부 정답! 아무래도 제대로 책을 읽고 온 모양이네"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "ea7b6be7345c",
  "ko": "헤헤~ 이 정도는 식은 죽 먹기지"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 2,
  "jh": "e2365ef42959",
  "ko": "그런 대충 읽기로 만점이라니 과제로서 어떤가 싶은데…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "9b2d7ab8751c",
  "ko": "쉿! 쓸데없는 말 하지 마!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 13,
  "jh": "0635ed47938b",
  "ko": "그럼 도장 찍을게. 다음 수업도 그 기세로 힘내"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 13,
  "jh": "1031449c86b5",
  "ko": "아깝네, 한 문제만 틀렸어. 다음엔 좀 더 힘내"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "f81c5cfca784",
  "ko": "네~ 봐, 거의 안 읽어도 어떻게든 됐잖아?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 2,
  "jh": "05a4f442353b",
  "ko": "…이 정도 질문이면 전부 맞히는 게 당연한 거 아닌가…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "cd4fec4cdef4",
  "ko": "으… 뭐 됐잖아. 다음에 힘내면. 응?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 13,
  "jh": "3fe9ce587ec3",
  "ko": "한 문제밖에 못 맞혔네. 그렇게 어려운 질문도 아니었는데…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "8b98339f545a",
  "ko": "후우… 하마터면 전부 틀릴 뻔했어…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 2,
  "jh": "ee5f567d0879",
  "ko": "감으로 하나 맞힌 것만으로도 만족해야 해…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 13,
  "jh": "db7e3a7c0f50",
  "ko": "다음엔 더 힘내야 해. 그럼 도장 찍을게"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 13,
  "jh": "38a9a3cabc62",
  "ko": "전부 틀렸네… 대충 대답해도 하나는 맞을 텐데…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "8bce59a5525c",
  "ko": "음~… 내 감이 전부 빗나가다니…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 2,
  "jh": "3ce9f6e93cb3",
  "ko": "감으로 하는 게 애초에 틀렸어… 그렇게 어려운 질문도 아닌데…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 13,
  "jh": "a58904c716c8",
  "ko": "이런 성적이 계속되면 퇴학당해. 조심해"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "2c30a7cd31af",
  "ko": "네~…"
 },
