[
 {
  "key": "m0",
  "kind": 0,
  "chr": 11,
  "jh": "c3fb6ea21836",
  "ko": "하아, 하아… 해냈다! 제가 일등이네요!"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 3,
  "jh": "59985233f1fd",
  "ko": "뭐!? 그, 그럴 리가…"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 11,
  "jh": "8432a9a18fd3",
  "ko": "그렇게까지 놀랄 건… 저도 진심을 내면 이 정도는 할 수 있다고요!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 4,
  "jh": "2a41e2f377ee",
  "ko": "이런, 져 버렸나. 이래 봬도 서둘렀다만"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 0,
  "jh": "bd109deeb93d",
  "ko": "잘도 말하네…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 11,
  "jh": "78d15b8d61f6",
  "ko": "어머어머. 늦으셨네요, 두 분"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "78039f917512",
  "ko": "완전히 이긴 줄 아나 본데, 재료는 제대로 캐 왔겠지?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 11,
  "jh": "a7086305e7c9",
  "ko": "물론이죠. 자, 이거예요"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 3,
  "jh": "be360fab2e23",
  "ko": "…이건 호펜이잖아. 내가 말한 건 톤이야"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 11,
  "jh": "310bb57419a2",
  "ko": "네? 어라라? 그럼 이쪽이에요?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 3,
  "jh": "1c9e60dc04f0",
  "ko": "…이것도 아니야. 너 내 말 제대로 들었어?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 4,
  "jh": "9661ec514303",
  "ko": "왠지 분위기가 수상해지는 것 같다만"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "ba064e169008",
  "ko": "뭐, 늘 있는 일이야"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 11,
  "jh": "599db616ac82",
  "ko": "그, 그러니까… 그럼 이건요!?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 3,
  "jh": "2a897b65b00b",
  "ko": "…응, 확실히 톤이네"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 11,
  "jh": "2ac16f14638b",
  "ko": "다행이다! 그럼 역시 제가 이긴 거네요!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 3,
  "jh": "fc38d30f9e69",
  "ko": "힘으로 억지로 뽑았지? 이렇게 쭈글쭈글해선 못 써"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 11,
  "jh": "21b6c0f914b6",
  "ko": "네에!? 죄, 죄송해요. 힘 조절을 몰라서…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "a5983c24908f",
  "ko": "정말, 이러니까 너한텐 못 맡기는 거야"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "44a0f0a23c5b",
  "ko": "넌 얌전히 지금까지처럼 내 신변 시중만 들면 돼"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 11,
  "jh": "182b2fc07bf8",
  "ko": "지금까지처럼이라니, 차 내오기 같은 거요…?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "e85ab8d099d1",
  "ko": "그래. 그리고 어깨 두드리기라든가"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 11,
  "jh": "184808be837e",
  "ko": "아가씨, 어깨 결릴 만큼 가슴 없으시잖아요"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "5500ab7aea3e",
  "ko": "가슴 없어도 어깨쯤 결리거든! 이 아니라! 가슴도 남들만큼은 있거든!"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 11,
  "jh": "7ec8909b1a37",
  "ko": "아얏! 아가씨… 과, 관자놀이가 함몰돼요… 으아아아아아!!"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 4,
  "jh": "0df70a023027",
  "ko": "이젠 승부 따윈 아무래도 좋아진 모양이군"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 0,
  "jh": "df48a23fc475",
  "ko": "휘말리기 전에 돌아가는 게 좋아. 아아, 재료는 일단 아틀리에에 둬"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 4,
  "jh": "35c1f29e7a80",
  "ko": "침착하군"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 0,
  "jh": "c2f3759ac1ff",
  "ko": "당신도 그중 익숙해질 거야"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 4,
  "jh": "b9e4e3e9ddab",
  "ko": "흠…"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 4,
  "jh": "f7a598f8253e",
  "ko": "이것에 익숙해진다, 라… 생각해 볼 문제군"
 },
 {
