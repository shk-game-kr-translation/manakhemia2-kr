[
 {
  "key": "m0",
  "kind": 0,
  "chr": 0,
  "jh": "f2df1ea07981",
  "ko": "진짜, 입학하자마자 기분 잡쳤네… 대체 뭐야, 그 여자는…!!"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 35,
  "jh": "c21c68baea70",
  "ko": "뭐야? 뭐야? 무슨 일이야? 무서운 얼굴을 하고"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 0,
  "jh": "24f16bd988b6",
  "ko": "………뭐?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 35,
  "jh": "efb32becf4bf",
  "ko": "안 돼! 입학 첫날부터 그런 얼굴 하면!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 35,
  "jh": "8d3fb6c7cf76",
  "ko": "나는 계속 두근두근해서 말이야~ 그저께부터 잠을 한숨도 못 잤어!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "ac760a072cd9",
  "ko": "…뭐야, 너"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 7,
  "jh": "9616ff872b41",
  "ko": "나? 나는 에토!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 7,
  "jh": "7fdfea25038f",
  "ko": "원래는 에토왈드인데 부르기 힘들잖아? 그러니까 에토라고 불러!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 7,
  "jh": "5c424f634f43",
  "ko": "그래서, 네 이름은?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "6f0436ec4fe3",
  "ko": "…일단 말 걸지 말아 줄래"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 7,
  "jh": "630c530ce747",
  "ko": "그러지 말고, 사양하지 마. 모처럼 옆자리인데"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "779138b787ea",
  "ko": "…옆자리가 너 같은 녀석인 줄 알았으면 여기 안 앉았어"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 7,
  "jh": "101cda4cd489",
  "ko": "너가 아니라 에토야. 자, 말해 봐. 에・토"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 0,
  "jh": "003d987f5732",
  "ko": "…짜증 나"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 7,
  "jh": "65f3d8955bc0",
  "ko": "응? 어라? 으으응?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 7,
  "jh": "0418af308960",
  "ko": "있잖아 있잖아, 우리 어디서 만난 적 있지? 어디서 만났더라?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "685d331e9478",
  "ko": "있을 리가 없잖아. 너 같은 녀석은 한 번 보면 잊을 수가 없지"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 7,
  "jh": "82fb3148caea",
  "ko": "있다니까! 분명 어디선가… 으음, 어디였더라…?"
 },
 {
  "key": "m18",
  "kind": 5,
  "chr": 12,
  "jh": "a948c58c153e",
  "ko": "후훗훗. 올해 신입생은 꽤나 기운이 넘치는 모양이군"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 81,
  "jh": "ecb9fe6ba6a2",
  "ko": "앗!? 서, 선생님?"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 95,
  "jh": "106861bface6",
  "ko": "방금, 어디서 나오신 거예요…?"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 12,
  "jh": "4b26f7d8b9fe",
  "ko": "이 몸 밑에서 1년간 배우면 네놈들도 이 정도는 할 수 있게 된다"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 81,
  "jh": "70c7cc0b392f",
  "ko": "정말!? 우와~ 기대된다!"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 83,
  "jh": "aa948dade3b8",
  "ko": "저는 그런 거 할 수 있게 되고 싶지 않은데요…"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 12,
  "jh": "619cdd2602bd",
  "ko": "자기소개는 입학식에서 끝냈으니까. 단도직입적으로 용건만 전해 주지"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 12,
  "jh": "e7832dbcabf8",
  "ko": "네놈들은 앞으로 훌륭한 전투원이 되기 위해 특훈에 힘쓰게 되겠지만…"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 12,
  "jh": "7e67652a0522",
  "ko": "당분간은 연금술을 공부하게 된다"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 81,
  "jh": "19dd09d86b37",
  "ko": "에…? 연금술? 왜?"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 12,
  "jh": "58d471901c1a",
  "ko": "아무래도 급한 얘기였거든. 이 몸도 제대로 준비를 못 했다"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 12,
  "jh": "1d6fa391d1be",
  "ko": "쉽게 말해, 이 몸의 준비가 끝날 때까지 연금술이나 하고 있으라는 거다"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 106,
  "jh": "29552853d7f7",
  "ko": "농담하지 마! 우린 강해지려고 이 학교에 왔단 말이야"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 107,
  "jh": "f8d900a0f305",
  "ko": "그래 그래! 연금술 같은 어중간한 거, 할 수 있겠냐고!"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 12,
  "jh": "c83bb230372d",
  "ko": "어디 가려는 거냐?"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 106,
  "jh": "fb2e745617d0",
  "ko": "쳇! 그만둘 거야. 이런 학교!"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 107,
  "jh": "56f9e3705d5c",
  "ko": "그래, 마을에서 싸움질이나 하는 게 낫겠어"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 12,
  "jh": "f3fcc9587e69",
  "ko": "호오, 그 반골 기질은 칭찬할 만하군. …하지만!"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 106,
  "jh": "74e9da43f964",
  "ko": "크억!"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 107,
  "jh": "6720081e3de7",
  "ko": "커헉!"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 12,
  "jh": "ff5423b947ce",
  "ko": "이 몸이 고마운 말씀을 하고 있는데 자리를 뜨다니, 괘씸하군"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 106,
  "jh": "4fd8e3bb99f9",
  "ko": "세, 세다… 뭐야, 이 녀석…"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 12,
  "jh": "60807e76bd58",
  "ko": "그럼 시작해 볼까. 기념할 만한 이 몸의 첫 수업이다. 명심해서 들어라!"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 0,
  "jh": "0b659fb0d7bc",
  "ko": "과제 형식의 수업인가… 귀찮군"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 7,
  "jh": "f6cd83615758",
  "ko": "있잖아 있잖아, 나랑 같이 가지 않을래? 혼자 가는 것보다 낫잖아?"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 7,
  "jh": "b531e6c9c90f",
  "ko": "그렇게 정했으면 당장 출발! 서두르지 않으면 다른 애들이 재료 다 캐 간다고!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 0,
  "jh": "95b8b110d0cd",
  "ko": "멋대로 정하지 마! 난 혼자서…"
 },
 {
  "key": "m45",
  "kind": 5,
  "chr": 3,
  "jh": "5eb9a29d6527",
  "ko": "로제! 있지?"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 3,
  "jh": "996d9743f03a",
  "ko": "어이가 없어… 전투기술과나 연금술과나 수업 내용이 거의 똑같다니"
 },
 {
  "key": "m47",
  "kind": 0,
  "chr": 3,
  "jh": "10df0aff671a",
  "ko": "그럴 거면 굳이 너랑 다른 반이 아니어도 됐잖아…"
 },
 {
  "key": "m48",
  "kind": 0,
  "chr": 3,
  "jh": "0f6e91153be0",
  "ko": "같은 교실이면 수업 중에 쪽지를 돌리거나, 교과서를 같이 보거나, 이것저것…"
 },
 {
  "key": "m49",
  "kind": 0,
  "chr": 0,
  "jh": "b58bd7f8ab0d",
  "ko": "뭘 중얼거리시는 거예요?"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 3,
  "jh": "35c2611b6afb",
  "ko": "아, 아무것도 아니야! 그보다 지금부터…응?"
 },
 {
  "key": "m51",
  "kind": 0,
  "chr": 7,
  "jh": "612f6299e08c",
  "ko": "응?"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 3,
  "jh": "ed761a75e23a",
  "ko": "…그 여자는 누구니?"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 0,
  "jh": "c66663322a9a",
  "ko": "저한테 물으셔도 곤란한데요…"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 3,
  "jh": "2c28f8e49ff3",
  "ko": "그래, 그런 거구나…"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 3,
  "jh": "a80e1c70dd5d",
  "ko": "내가 고작 한 시간 눈을 뗀 사이에 벌써 다른 여자한테 손을 댔다는 거지…"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 0,
  "jh": "5bea36d855c1",
  "ko": "무슨 말씀이세요. 그럴 리가 없잖아요"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 3,
  "jh": "bd6e07429678",
  "ko": "변명은 필요 없어! 넌 한번 네 처지란 걸 똑똑히 깨닫게 해 줘야겠어!"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 0,
  "jh": "d0d2f5af7855",
  "ko": "아가씨, 진정하고 얘기를… 아, 아파!"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 11,
  "jh": "7c38d929318c",
  "ko": "저기, 두 분 다… 주위에 민폐니까 좀 더 조용히…"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 7,
  "jh": "7bc760c8eb85",
  "ko": "빤히……"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 11,
  "jh": "f248526ae271",
  "ko": "네? 뭐, 뭐예요? 제 얼굴에 뭐가…"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 7,
  "jh": "b07863fb7ce0",
  "ko": "윔, 맞지? 우와~ 오랜만이야!"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 11,
  "jh": "59db417d3b79",
  "ko": "네? 네? 저기, 누구시죠?"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 7,
  "jh": "eb6151ee323a",
  "ko": "잊어버린 거야? 나야, 에토야!"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 11,
  "jh": "fb95910887e0",
  "ko": "네…? 어머, 에토 씨! 몰라보게 크셨네요…"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 7,
  "jh": "fe9fbd9db7df",
  "ko": "응, 많이 컸지! 윔은 하나도 안 변했네"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 11,
  "jh": "20feb939691a",
  "ko": "저는 인간 여러분처럼 성장하지 않으니까요…"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 11,
  "jh": "914ac02b88b9",
  "ko": "대신 영원히 젊고 아름다운 모습 그대로지만요"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 7,
  "jh": "af5f71448ddd",
  "ko": "아하하. 여전히 아무렇지 않게 얄미운 말을 하네"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 7,
  "jh": "c321f30df1d0",
  "ko": "윔이 있다는 건… 저기서 날뛰는 게 릴리아?"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 7,
  "jh": "26b4d2e62adc",
  "ko": "그리고 필사적으로 도망치려는 게…"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 11,
  "jh": "4b254e5d2832",
  "ko": "네, 로제 씨예요. 아가씨, 에토 씨예요"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 3,
  "jh": "95d875a3e333",
  "ko": "지금 한창 좋을 때니까 나중에 해! 어때, 로제. 이제 알겠니?"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 11,
  "jh": "97da5d0ca12f",
  "ko": "아뇨, 그러니까 에토 씨라니까요. 소꿉친구인. 아가씨가 오해하신 거예요"
 },
 {
  "key": "m75",
  "kind": 2,
  "chr": 3,
  "jh": "98382ea98d8f",
  "ko": "…어? 에토?"
 },
 {
  "key": "m76",
  "kind": 2,
  "chr": 7,
  "jh": "198fb058b368",
  "ko": "에헤헤. 오랜만이야"
 },
 {
  "key": "m77",
  "kind": 2,
  "chr": 3,
  "jh": "3d232c589083",
  "ko": "세상에, 이게 몇 년 만이야!"
 },
 {
  "key": "m78",
  "kind": 2,
  "chr": 7,
  "jh": "beff18ee950e",
  "ko": "10년 만쯤? 그립다. 설마 릴리아도 이 학교에 와 있을 줄이야!"
 },
 {
  "key": "m79",
  "kind": 2,
  "chr": 3,
  "jh": "06fd8369f6c5",
  "ko": "그건 내가 할 소리야! 정말, 미리 연락 좀 주지 그랬어"
 },
 {
  "key": "m80",
  "kind": 2,
  "chr": 0,
  "jh": "456df86b94b3",
  "ko": "…아는 사이…였어요…?"
 },
 {
  "key": "m81",
  "kind": 2,
  "chr": 3,
  "jh": "bd2f47c440d7",
  "ko": "기억 안 나? 옛날에 남매끼리 자주 놀러 왔었잖아"
 },
 {
  "key": "m82",
  "kind": 2,
  "chr": 7,
  "jh": "3c5abea4df14",
  "ko": "거봐~ 그러니까 말했잖아. 분명히 본 적 있다고 생각했다니까"
 },
 {
  "key": "m83",
  "kind": 2,
  "chr": 0,
  "jh": "b32314844d0c",
  "ko": "…기억 안 나"
 },
 {
  "key": "m84",
  "kind": 2,
  "chr": 3,
  "jh": "001f25da3a66",
  "ko": "뭐, 마침 잘됐어. 에토, 너도 같이 가자"
 },
 {
  "key": "m85",
  "kind": 2,
  "chr": 7,
  "jh": "15f677129225",
  "ko": "응? 어디 가는데? 과제?"
 },
 {
  "key": "m86",
  "kind": 2,
  "chr": 3,
  "jh": "8c2072fe8815",
  "ko": "과제 전에 잠깐, 응. 나머지는 가서 보면 알아"
 },
 {
  "key": "m87",
  "kind": 2,
  "chr": 7,
  "jh": "54180c100f46",
  "ko": "에~ 뭔데 뭔데? 궁금해~"
 },
 {
  "key": "m88",
  "kind": 2,
  "chr": 3,
  "jh": "44d18f82bf33",
  "ko": "자, 너도. 언제까지 누워 있을 생각이니?"
 },
 {
  "key": "m89",
  "kind": 2,
  "chr": 0,
  "jh": "25cf9722bdad",
  "ko": "아니… 대미지가 안 빠져서…"
 },
 {
  "key": "m90",
  "kind": 2,
  "chr": 3,
  "jh": "baee963cea6d",
  "ko": "그나저나 많이 컸구나. 옛날엔 내가 키도 더 컸는데…"
 },
 {
  "key": "m91",
  "kind": 2,
  "chr": 7,
  "jh": "06abc6ac5bc3",
