[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "c7dfc2d4493a",
  "ko": "울리카야. 울리카. 자, 말해 봐"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 10,
  "jh": "e9f19928eb62",
  "ko": "우~… 우류리카?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "21ecbee8308d",
  "ko": "아~ 아깝다! 그래도 귀여우니까 용서! 맞다, 과일 먹을래? 가져다줄게"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 10,
  "jh": "9dc66ada9e64",
  "ko": "우!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 6,
  "jh": "a766bb3784f7",
  "ko": "야아, 엄청난 응석 받아주기네"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 2,
  "jh": "01735660a0a8",
  "ko": "확실히 말해서 기분 나빠… 구역질 나"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 6,
  "jh": "c6f4efdc8ae6",
  "ko": "검은 누나는 표현이 직설적이네"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 2,
  "jh": "9d1b32310a9c",
  "ko": "엄청 순화한 건데… 그러는 요정 씨는?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 6,
  "jh": "af13f79c9076",
  "ko": "그렇지, 비유하자면…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "4c110f9e80bd",
  "ko": "우리 집 고양이가 엄청 귀여워서~"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 6,
  "jh": "b9b7c6f37b90",
  "ko": "이젠 애완동물이라기보다 애인? 같은 느낌? 에헤헤!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 6,
  "jh": "ad7f773947e4",
  "ko": "…라고 말하는 사람한테 느끼는 것과 같은 정도의 살의를 느끼고 있어"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 2,
  "jh": "7dcb16eef417",
  "ko": "요정 씨는 마음이 좁구나…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 6,
  "jh": "3b7ae17605a1",
  "ko": "그렇지 않아. 세상 사람 80%는 동의해 줄 거야"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "0a6c3a2ef6bd",
  "ko": "그 근거 없는 자신감은 어디서…"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 6,
  "jh": "b35581722787",
  "ko": "아무튼 한마디 해 줘야겠어. 야, 누나!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "79cc53db233f",
  "ko": "뭐야? 우류랑 놀고 있으니까 방해하지 마"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 6,
  "jh": "de1ce9424a73",
  "ko": "그런 하얀 털뭉치보다 이 몸을 더 귀여워해 줘~!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "d934dcff5373",
  "ko": "싫어. 짜증 나. 사라져."
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 6,
  "jh": "8201a1b606b8",
  "ko": "우와. 예상보다 냉담한 반응인데요…?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 6,
  "jh": "31ec284d5b44",
  "ko": "왜! 아무리 좋게 봐줘도 이 몸이 더 귀엽잖아!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "f891d3b74b2e",
  "ko": "네네, 그럼 클로에랑 놀아"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 6,
  "jh": "7dc5f3b27247",
  "ko": "검은 누나는 검은 파동이 느껴져서 싫단 말이야…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "4745b6e056e3",
  "ko": "내가 거절당하는 쪽이구나… 근육 덩어리 주제에…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 6,
  "jh": "88897a3d9851",
  "ko": "우와. 이쪽에서도 신랄한 말이 날아왔어요…?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 6,
  "jh": "f72abaf3734d",
  "ko": "젠장, 네가 온 탓에 아틀리에 분위기가 험악해져서…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 6,
  "jh": "64e5dc6ad417",
  "ko": "네가 누나들을 미치게 만든 거야! 너만 없어지면…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "49ca25df7a12",
  "ko": "이 애한테 뭔가 하면 널 쫓아낼 거야… 이 세상에서"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "7af51bdde8d5",
  "ko": "으아아. 눈이 진심이야…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 6,
  "jh": "ee5ebc7784c2",
  "ko": "아아… 바로 얼마 전까지만 해도 이 몸을 그렇게 의지해 줬는데…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 2,
  "jh": "f9df03ec1945",
  "ko": "어쩔 수 없어… 저 마나랑 변태 코스프레 근육 덩어리는 비교할 것도 없으니까…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 6,
  "jh": "18724349809e",
  "ko": "으아아아. 욕설이 파워 업했어!"
 },
 {
  "key": "m33",
  "kind": 5,
  "chr": 18,
  "jh": "2954de799749",
  "ko": "꽤나 시끄럽군요"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 2,
  "jh": "6f4467c9d0d9",
  "ko": "이사장님… 이랑 교장 선생님"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 13,
  "jh": "be2c21842503",
  "ko": "야아, 잠깐 실례할게"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 18,
  "jh": "b1b8ad6cb193",
  "ko": "그게 당신의 마나군요? 보여 주세요"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 1,
  "jh": "33e786357d6e",
  "ko": "아아! 거칠게 다루지 마세요!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 10,
  "jh": "9b5019ac19fa",
  "ko": "우우~!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 18,
  "jh": "6bd0a6d534c7",
  "ko": "정말 마나인가요? 몬스터 새끼가 아니라?"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 1,
  "jh": "927122808131",
  "ko": "제대로 된 마나예요! 이제 돌려줘요!"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 18,
  "jh": "e895268911ab",
  "ko": "…흥, 뭐 좋아요"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 18,
  "jh": "c49167e0c77f",
  "ko": "당신 정도 성적이면 제대로 된 연금술사가 될 일도 없겠죠"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 1,
  "jh": "cd7f0bcff5f9",
  "ko": "뭐!? 무슨 뜻이에요!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 13,
  "jh": "ebfd80431c32",
  "ko": "자, 자자 진정해. 악의는 없… 다고는 단언 못 하지만 여기선 원만하게…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 18,
  "jh": "38994ed8eb33",
  "ko": "그보다 여러분. 둘이서 이 아틀리에를 쓰고 있다고요?"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 6,
  "jh": "db3be72ec0d0",
  "ko": "둘이 아니야! 이 몸 포함해서 셋이야!"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 18,
  "jh": "279bdb73c847",
  "ko": "교칙에는 원칙적으로 5명 이상이 사용하도록 적혀 있네요"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 18,
  "jh": "abab026fefff",
  "ko": "인원이 안 차면 즉시 비워 주세요. 그럼"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 13,
  "jh": "67ca813bbe03",
  "ko": "자자, 그렇게 싸우자는 식으로 말 안 해도… 아, 이사장님?"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 1,
  "jh": "6ccc2826ff75",
  "ko": "뭐야!? 갑자기 와서 할 말 다 하고!!"
 },
 {
  "key": "m51",
  "kind": 0,
  "chr": 13,
  "jh": "60e74fe6fc80",
  "ko": "아아, 미안하네. 아무래도 기분이 안 좋은 것 같아… 히스테리인가"
 },
 {
  "key": "m52",
  "kind": 0,
  "chr": 18,
  "jh": "1e7857a888a3",
  "ko": "다 들려요. 교장 선생님"
 },
 {
  "key": "m53",
  "kind": 0,
  "chr": 13,
  "jh": "94fd101d89be",
  "ko": "히야아아! 바, 방금 건 말이 헛나온 거라!"
 },
 {
  "key": "m54",
  "kind": 0,
  "chr": 18,
  "jh": "5e599498892f",
  "ko": "그런 태도는 본인에게 좋지 않을 거예요"
 },
 {
  "key": "m55",
  "kind": 0,
  "chr": 13,
  "jh": "6bb9fa57fdde",
  "ko": "알고 있습니다! 아주 잘 알고 있으니까요!"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 13,
  "jh": "78d6eef90beb",
  "ko": "후우. 수명이 10년은 줄었네"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 2,
  "jh": "95bd3997e957",
  "ko": "결국 비꼬러 온 것뿐…?"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 13,
  "jh": "ac09fc2d6674",
  "ko": "아아, 미안하네. 아까도 말했지만 반은 히스테리로 화풀이고…"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 13,
  "jh": "32bed8b32a76",
  "ko": "아, 그래도 아틀리에 인원만은 진지하게 어떻게 하는 게 좋을 거야"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 13,
  "jh": "6246a627d990",
  "ko": "아무래도 둘뿐이면 정말 몰수당할 테니까"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 6,
  "jh": "f9f7d75bab35",
  "ko": "그러니까 둘이 아니라 셋이라니까!"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 13,
  "jh": "1cb23e00699f",
  "ko": "어, 아니… 그럼 그렇게 알고!"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 6,
  "jh": "2838b618a17b",
  "ko": "뭐야, 저 둘. 이 몸이 작고 귀여워서 안 보였나?"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 1,
  "jh": "349ea40fcdc5",
  "ko": "철저하게 없는 걸로 취급했네"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 2,
  "jh": "4e38e0a07139",
  "ko": "저게 현명한 어른의 대응이겠지…"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 1,
  "jh": "48f40921a59c",
  "ko": "그래도 어떡하지? 아틀리에 멤버"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 2,
  "jh": "95f26c088c44",
  "ko": "어떡하고 자시고… 우린 친구가 없잖아…"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 1,
  "jh": "cd60b6c2f974",
  "ko": "뭐, 어떻게든 되겠지. 언젠간 누가 동료로 넣어 달라고 올지도 모르고"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 2,
  "jh": "a849d9d13055",
  "ko": "그런 편리한 일이… 아직 세 명이나 부족한데…"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 6,
  "jh": "7b872cc8c2f2",
  "ko": "두 명이야! 두 명 더!"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 2,
  "jh": "f6cd981a7ef8",
  "ko": "…끝까지 안 모이면 요정 씨를 숫자에 넣는 것도 검토해야겠네…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]