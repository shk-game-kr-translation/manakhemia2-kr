[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "671ef6c0ba6b",
  "ko": "재료가 이거야?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "d5c5a78ba364",
  "ko": "그게… 응. 이 풀인 것 같아"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 6,
  "jh": "71e844d9d7b6",
  "ko": "좋아, 두 손 가득 따서 돌아가자!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 2,
  "jh": "593852a09a25",
  "ko": "그렇게 많이는 필요 없어… 두세 개 따고… 자, 끝"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 6,
  "jh": "706c14772e6a",
  "ko": "에에? 이 몸 차례는? 이 몸의 대활약 무대는?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 2,
  "jh": "7e89e0975fe3",
  "ko": "그런 건 처음부터 없어…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 9,
  "jh": "2786ce584707",
  "ko": "후후… 너의 시대는 끝났다는 거야…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "896fbc2a8217",
  "ko": "뭐, 뭐라고오오오오!!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 8,
  "jh": "b21ee96f3126",
  "ko": "쓸데없이 흥분하지 말고 얼른 돌아가자"
 },
 {
  "key": "m9",
  "kind": 5,
  "chr": 19,
  "jh": "5f917211dfa1",
  "ko": "기다려라. 돌아가면 곤란하다"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "15509ed4c9c4",
  "ko": "앗, 또 너!? 두 번 다시 다가오지 말라고 했잖아!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "a551ac15cedb",
  "ko": "…아는 사람?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "3819eb4660b4",
  "ko": "스토커 여자 2호야. 이 녀석도 우류를 노리고 있어!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 8,
  "jh": "468fe4a1ab2d",
  "ko": "또냐… 엄청난 인기네"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 9,
  "jh": "6cc1b0cb8d82",
  "ko": "너무 인기 있어서 질투가 날 것 같아"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 19,
  "jh": "ba2a74e48d99",
  "ko": "스토커라는 호칭은 다소 불만이다. 넌 날 오해하고 있다"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "53e9e607548b",
  "ko": "오해? 그럼 우류가 갖고 싶어서 온 게 아니야?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 19,
  "jh": "1ee41cc20323",
  "ko": "아니, 그 마나를 양보받으러 왔다"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "6debc97c1e25",
  "ko": "오해고 뭐고 아니잖아!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 19,
  "jh": "2d17a4a5b6da",
  "ko": "사정이 있다고 했다. 오늘이야말로 제대로 설명하게 해 줘라"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "b8f85979c008",
  "ko": "싫어! 듣기 싫어! 난 돌아갈래!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 9,
  "jh": "7cb063bff77a",
  "ko": "자자, 듣기만이라도 해 줘도 되지 않을까"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "14644c36e627",
  "ko": "…무슨 말을 해도 이 애는 안 줄 거야. 말해 봤자 소용없어"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 19,
  "jh": "05edaf07263e",
  "ko": "그건 듣고 나서 판단해 주면 된다. 조금 긴 얘기가 되겠지만"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "d9832b4858dc",
  "ko": "…알았어. 그렇게까지 말한다면 들어 줄게"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 19,
  "jh": "c125454712f4",
  "ko": "그럼… 얼마 전부터 이 세계에서 마나가 줄고 있다는 건 알고 있겠지"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "7d038ea92790",
  "ko": "그야, 뭐… 수업에서도 들었고"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 19,
  "jh": "450abedcdafa",
  "ko": "그 근본 원인이 마나와 인간 사이에 아이가 태어나 버린 것이라는 건?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 2,
  "jh": "040f74f25ca1",
  "ko": "…그런 게 가능해?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 19,
  "jh": "2791b6cb7bd1",
  "ko": "마나와 인간의 긴 역사 속에서 처음 있는 일이었다. 우리로서도 충격이었지"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 8,
  "jh": "3ff83f6ed217",
  "ko": "그래도 그게 뭐가 문제야?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 19,
  "jh": "fd2c7fb78df9",
  "ko": "…아이를 낳은 마나는 힘을 전부 아이에게 빼앗겨 세계에서 소멸해 버렸다"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 19,
  "jh": "bcbdd0cb1e5a",
  "ko": "그리고 그 아이는 마나도 인간도 아닌 존재가 되어 버렸다"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 6,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 9,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 19,
  "jh": "ed69fd733687",
  "ko": "이 일을 안 마나의 왕, 빛의 마나는 모든 마나를 인간과 엮이지 않게 하려 했다"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 19,
  "jh": "78910ef59350",
  "ko": "마나가 인간의 아이를 계속 낳으면 언젠가 모든 마나가 소멸한다고 생각했기 때문이다"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 19,
  "jh": "52004800b340",
  "ko": "하지만 또 한 명의 왕인 어둠의 마나는 이에 강하게 반대했다"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 19,
  "jh": "653f5de5ebcd",
  "ko": "마나 중엔 인간의 감정을 관장하는 것, 인간의 감정에서 태어난 것도 많이 존재한다"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 19,
  "jh": "ac7053717a54",
  "ko": "따라서 인간과의 관계를 끊으면 새로운 마나가 탄생하지 않게 된다고 생각했기 때문이다…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 19,
  "jh": "fc621e40dbd0",
  "ko": "여기까지 이해했나?"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 1,
  "jh": "0de04b61e01d",
  "ko": "신경 안 써 줘도 괜찮아. 그보다 빨리 계속해"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 19,
  "jh": "e7077dee0533",
  "ko": "실례했다. 두 사람의 의견은 평행선을 달려 언제까지고 결론이 나지 않았다"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 19,
  "jh": "9b1c82bbda6d",
  "ko": "그래서 어둠의 마나가 제안한 내기로 결판을 내기로 했다"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 19,
  "jh": "923d1f0b1fa9",
  "ko": "태어나기 전의 마나를 인간에게 맡겨 훌륭하게 키워 낼 수 있는가. 그 결과로 모든 걸 정하자고"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 2,
  "jh": "215650372c71",
  "ko": "그게 울리카의 마나…?"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 10,
  "jh": "55f72891b2c3",
  "ko": "우~…?"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 9,
  "jh": "9085eb0e875d",
  "ko": "하나 괜찮을까? 왜 넌 그런 얘기를 알고 있지?"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 9,
  "jh": "39e3992c22f6",
  "ko": "도저히 인간이 알 수 있는 얘기가 아닌 것 같은데"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 19,
  "jh": "2c570bd897db",
  "ko": "그건 나 자신이 마나이기 때문이다. 그러고 보니 자기소개가 아직이었군"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 19,
  "jh": "3de37318f911",
  "ko": "난 티트리. 빛의 마나를 보좌하는 입장에 있는 마나다"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 9,
  "jh": "f1fb3c6ba8d0",
  "ko": "…터무니없는 얘기지만 일단 믿기로 하지"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 19,
  "jh": "c9cf2396c6bb",
  "ko": "그럼 얘기로 돌아가지. 내기가 끝날 때까지 두 왕은 서로 손대지 않기로 약정했다"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 19,
  "jh": "41438b4de079",
  "ko": "하지만 빛의 마나는 그… 다소 비겁한 분이라. 인간끼리 손대는 건 상관없지 않느냐며"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 19,
  "jh": "5a88598e4088",
  "ko": "인간에게 자신의 힘을 빌려줘 마나를 사냥하게 했다. 전에 너희를 덮친 건 그런 부류다"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 1,
  "jh": "00cd24326dd7",
  "ko": "그 여자 말이구나…"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 2,
  "jh": "4468b7da7162",
  "ko": "지금 얘기가 사실이라면… 왜 우류를 빼앗으려고…?"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 2,
  "jh": "0e647ff553c1",
  "ko": "울리카가 키울 수 있느냐는 내기인데…"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 1,
  "jh": "8f40c8038c5c",
  "ko": "아, 그렇지. 역시 그럴듯하게 말해서 속이려는 거구나!?"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 19,
  "jh": "f52f53ce9d5f",
  "ko": "끝까지 들어 줬으면 한다. 그에 대해선 이쪽에도 착오가 있었다"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 19,
  "jh": "3cfbb4e2425c",
  "ko": "너에게 마나의 알을 건넨 어둠의 마나는 그… 한마디로 말하자면 덜렁대는 분이라"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 19,
  "jh": "a4947704bf81",
  "ko": "그게 무엇을 관장하는 마나인지 조사도 안 하고 너에게 알을 맡겨 버렸다"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 8,
  "jh": "c582c1ce8a10",
  "ko": "듣고 보니… 이 녀석은 무슨 마나일까?"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 1,
  "jh": "fd5bca26f546",
  "ko": "…글쎄? 생각해 본 적도 없어"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 10,
  "jh": "c0fdd1ff2d83",
  "ko": "우~?"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 19,
  "jh": "727b538d5333",
  "ko": "이건 아직 추론이지만, 그 애는 아마 모든 감정을 관장하는 마음의 마나로 여겨진다"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 19,
  "jh": "8f4d86f7404b",
  "ko": "빛이나 어둠에조차 필적하는 힘을 가진 강대한 마나다"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 1,
  "jh": "9c51a6ced2bb",
  "ko": "마음의… 너, 그렇게 대단한 애였어!?"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 10,
  "jh": "d4cc4b1b87cf",
  "ko": "…우~?"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 9,
  "jh": "c1a1fdcf57f5",
  "ko": "과연. 그 힘을 써서 모두의 인기인이 됐던 거로군"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 2,
  "jh": "b40a9b7c891c",
  "ko": "…이럴 때도 농담할 수 있는 탈인형 씨를 조금은 존경해…"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 19,
  "jh": "509e594aef58",
  "ko": "그 아이는 한 인간에게 맡겨 두기엔 너무 위험한 힘을 갖고 있다"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 19,
  "jh": "4e69888262ec",
  "ko": "그래서 빛과 어둠의 마나는 내기를 일시 중단하고 그 아이를 회수하기로 결정했다"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 19,
  "jh": "8e01ed242513",
  "ko": "이걸로 납득해 주겠지?"
 },
 {
  "key": "m75",
  "kind": 2,
  "chr": 6,
  "jh": "39fe3ead2d4d",
  "ko": "…어쩔 거야, 누나?"
 },
 {
  "key": "m76",
  "kind": 2,
  "chr": 1,
  "jh": "3fb9f9429a92",
  "ko": "………싫어"
 },
 {
  "key": "m77",
  "kind": 2,
  "chr": 19,
  "jh": "678e7385df5c",
  "ko": "음, 알기 쉽게 설명한 것 같은데 아직 이해하기 어려웠나"
 },
 {
  "key": "m78",
  "kind": 2,
  "chr": 1,
  "jh": "b4c17845f236",
  "ko": "네 얘기는 알았어! 알았지만 그래도 싫어!"
 },
 {
  "key": "m79",
  "kind": 2,
  "chr": 1,
  "jh": "2cc3e22e4756",
  "ko": "전부 그쪽 사정이잖아! 나랑은 상관없어! 이 애도 싫어하고 있어!"
 },
 {
  "key": "m80",
  "kind": 2,
  "chr": 10,
  "jh": "3c998d1a070a",
  "ko": "우~…!"
 },
 {
  "key": "m81",
  "kind": 2,
  "chr": 19,
  "jh": "3f87ca4a4daa",
  "ko": "떼를 써도 곤란하다. 그 아이를 노린 여자가 돌변한 건 알고 있겠지?"
 },
 {
  "key": "m82",
  "kind": 2,
  "chr": 1,
  "jh": "f1882c040e29",
  "ko": "아… 그렇구나, 그래서 그 사람이 이상하게…"
 },
 {
  "key": "m83",
  "kind": 2,
  "chr": 19,
  "jh": "50c85fb9ad8b",
  "ko": "그 아이는 자기 힘을 이해하지 못하고 있다. 무슨 계기로 대사건이 될지도 모른다"
 },
 {
  "key": "m84",
  "kind": 2,
  "chr": 1,
  "jh": "f3a0dd11f261",
  "ko": "…그럼! 내가 제대로 이 애를 돌볼게! 문제도 안 일으키게 할게!"
 },
 {
  "key": "m85",
  "kind": 2,
  "chr": 1,
  "jh": "586d827e1aa9",
  "ko": "그럼 불만 없지!?"
 },
 {
  "key": "m86",
  "kind": 2,
  "chr": 19,
  "jh": "d51440767b37",
  "ko": "그 말에 얼마나 설득력이 있지. 알아들어 줬으면 한다"
 },
 {
  "key": "m87",
  "kind": 2,
  "chr": 19,
  "jh": "52387d8674d6",
  "ko": "끝내 이해해 주지 않는다면 강경 수단을 쓸 수밖에 없다"
 },
 {
  "key": "m88",
  "kind": 2,
  "chr": 1,
  "jh": "b4792759a300",
  "ko": "바라던 바야. 너 같은 거한테 절대 안 질 거야!"
 },
 {
  "key": "m89",
  "kind": 2,
  "chr": 10,
  "jh": "9dc66ada9e64",
  "ko": "우!"
 },
 {
  "key": "m90",
  "kind": 2,
  "chr": 2,
  "jh": "4d6554e63475",
  "ko": "…우린 어떡할까?"
 },
 {
  "key": "m91",
  "kind": 2,
  "chr": 8,
  "jh": "4bb4eb15c161",
  "ko": "힘으로 하겠다는 건 마음에 안 들어. 저 녀석 말이 사실이라는 증거도 없고"
 },
 {
  "key": "m92",
  "kind": 2,
  "chr": 9,
  "jh": "a06ece28c2a6",
  "ko": "넌 물어볼 것도 없겠지"
 },
 {
  "key": "m93",
  "kind": 2,
  "chr": 6,
  "jh": "8db915d635e3",
  "ko": "물론! 이 몸은 언제나 누나 편이야!"
 },
 {
  "key": "m94",
  "kind": 2,
  "chr": 2,
  "jh": "34258c0f291a",
  "ko": "…울리카랑 있으면 귀찮은 일뿐. 어쩔 수 없지…"
 },
 {
  "key": "m95",
  "kind": 2,
  "chr": 19,
  "jh": "9428aeea7a69",
  "ko": "…너희 마음은 알았다. 하지만 이쪽도 사정이 사정이다"
 },
 {
  "key": "m96",
  "kind": 2,
  "chr": 19,
  "jh": "f276a0ef2c4b",
  "ko": "봐줄 수는 없다… 나쁘게 생각하지 마라"
 },
 {
  "key": "m97",
  "kind": 2,
  "chr": 19,
  "jh": "1266dab4d7e2",
  "ko": "음… 설마…"
 },
 {
  "key": "m98",
  "kind": 2,
  "chr": 1,
  "jh": "f30a32349b8b",
  "ko": "하아, 하아… 어때, 항복이야?"
 },
 {
  "key": "m99",
  "kind": 2,
  "chr": 10,
  "jh": "b7190356a4de",
  "ko": "우~!"
 },
 {
  "key": "m100",
  "kind": 2,
  "chr": 19,
  "jh": "df178c3b3e46",
  "ko": "…솔직히 놀랐다. 이 내가 설마 인간에게 질 줄이야"
 },
 {
  "key": "m101",
  "kind": 2,
  "chr": 1,
  "jh": "2590f2d34f2d",
  "ko": "이제 포기하고 돌아가. 몇 번을 와도 이 애는 내가 지킬 거야!"
 },
 {
  "key": "m102",
  "kind": 2,
  "chr": 19,
  "jh": "2313e23a2707",
  "ko": "그럴 수는 없다고 아까 말했지"
 },
 {
  "key": "m103",
  "kind": 2,
  "chr": 19,
  "jh": "e014720add57",
  "ko": "진 건 계산 밖이지만 일이 예정대로 진행되면 문제없다"
 },
 {
  "key": "m104",
  "kind": 2,
  "chr": 1,
  "jh": "d72edef0c559",
  "ko": "뭐야 그거, 억지 쓰는 거야…"
 },
 {
  "key": "m105",
  "kind": 2,
  "chr": 19,
  "jh": "fd0ba5ae30ee",
  "ko": "지금이다. 부탁한다"
