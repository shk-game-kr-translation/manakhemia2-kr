[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "56492c939416",
  "ko": "선생님~!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 28,
  "jh": "069077dbb258",
  "ko": "앗!? 버, 벌써 끝났어? 빠, 빨랐네"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "f1dc60b97d3e",
  "ko": "왜 그렇게 떨어?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 28,
  "jh": "46f91bd72c48",
  "ko": "그, 그치만… 수업 때 엄청 화냈잖아…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "00ad150cc225",
  "ko": "어…? 아~! 그러고 보니!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 2,
  "jh": "6e09c2465246",
  "ko": "말 안 했으면 잊었을 텐데…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "cd62f2b81561",
  "ko": "정말! 떠올리니까 또 화나잖아! 어떻게 할 거야!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 28,
  "jh": "dcb38a391d10",
  "ko": "와아! 미, 미안… 그, 그렇지. 과제 평가를 해야지! 그, 그러니까…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 28,
  "jh": "ea1a543b595b",
  "ko": "…응. 흠잡을 데가 없네. 완벽해!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 2,
  "jh": "13aa6e108d3c",
  "ko": "정말…? 울리카가 화나서 그런 게 아니라…?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 28,
  "jh": "09fbba2b71f5",
  "ko": "아, 아니야! 아무리 나라도 혼났다고 성적을 바꾸진 않아!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "7ab9fa3cdec5",
  "ko": "그래도… 울리카가 완벽한 성적이라니…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "79e0acb7fbc2",
  "ko": "뭐야! 내가 좋은 성적 받는 게 그렇게 이상해!?"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 28,
  "jh": "c1ca97e23a34",
  "ko": "아아아, 또 화내고… 도장은 찍어 둘게! 그럼 난 이만!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 28,
  "jh": "720ea45e6599",
  "ko": "음~ 나쁘진 않은데 한 걸음 모자라려나…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "61219b7c062b",
  "ko": "에~ 조금쯤 덤으로 줘도 되잖아!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 28,
  "jh": "ab30880102ad",
  "ko": "그, 그럴 순 없어. 성적만은 공평하게 매겨야…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 2,
  "jh": "197b251b03c3",
  "ko": "의외로 융통성이 없네… 이용하기 어려운 타입인가…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "ab2a08517a6d",
  "ko": "아~! 왠지 납득 안 가~!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 28,
  "jh": "42d6a41bc5d8",
  "ko": "그렇게 큰 소리 내도… 아무튼 도장은 찍어 둘게. 난 이만!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 28,
  "jh": "a0411ff2e6de",
  "ko": "보통이네. 좋지도 나쁘지도 않다고 할까…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "748dd16abfcf",
  "ko": "에에? 꽤 열심히 했다고 생각하는데…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "039bf4d165db",
  "ko": "정말! 선생님이 화나게 해서 집중을 못 한 거야!!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 28,
  "jh": "10fde71d0619",
  "ko": "에에에? 내, 내 탓이야?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 2,
  "jh": "956d4e0ac3dd",
  "ko": "…아까까진 화난 것도 잊고 있었으면서…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "a6ec1ceeed0b",
  "ko": "시끄러워! 선생님 탓이라면 선생님 탓이야!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 28,
  "jh": "292cd6c6736c",
  "ko": "그, 그렇게 말해도… 아무튼 도장은 찍어 둘게! 난 이만!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "831c2c3baed4",
  "ko": "앗, 이놈! 거기 서~!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 28,
  "jh": "fd913cb88cad",
  "ko": "이건… 전혀 안 되겠네. 이래선 평가를 줄 수 없어…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "29d1501e45a9",
  "ko": "우~… 이것도 저것도 선생님이 날 화나게 해서!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "cb097b75c855",
  "ko": "그래서 집중을 못 한 거야!"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 28,
  "jh": "10fde71d0619",
  "ko": "에에에? 내, 내 탓이야?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 2,
  "jh": "956d4e0ac3dd",
  "ko": "…아까까진 화난 것도 잊고 있었으면서…"
 },
