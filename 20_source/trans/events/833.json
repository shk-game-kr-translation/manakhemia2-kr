[
 {
  "key": "m0",
  "kind": 2,
  "chr": 12,
  "jh": "c1cc49fa9ac7",
  "ko": "오, 돌아왔군. 어떠냐, 이 몸이 고안한 구조 훈련은?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "3a8dc1ae1aca",
  "ko": "구조 훈련이 아니라 방재 훈련 아니었어요…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 12,
  "jh": "a454e66aebaa",
  "ko": "음, 그랬나? 뭐, 말의 차이 따윈 사소한 거다. 신경 쓰지 마라"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 12,
  "jh": "325d0f6b68f4",
  "ko": "그보다 네놈들 훈련 결과다만…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 12,
  "jh": "1a20b6fbd356",
  "ko": "다섯 명인가… 그 짧은 시간에 잘도 이만큼 구출했군. 훌륭하다!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "cebe94ce2a23",
  "ko": "꾸물대며 구할 상황이 아니었으니까요…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 12,
  "jh": "65c2211a2dfe",
  "ko": "당연하다. 훈련이라도 진심으로 하지 않으면 의미가 없으니까"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 12,
  "jh": "e181eb59c4ed",
  "ko": "하지만 네놈들 활약은 예상 이상이었다. 앞으로도 이 기세로 정진하도록!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 12,
  "jh": "0aa4bc8e8a3b",
  "ko": "그럭저럭이군. 욕심을 말하자면 한두 명은 더 구출했으면 했다만"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 7,
  "jh": "dfce5c7bbd0c",
  "ko": "에~ 그 이상은 무리였어~"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 12,
  "jh": "6885da4e43b1",
  "ko": "무리라고 생각하니까 무리인 거다! 새로운 세계는 한계를 넘은 곳에 펼쳐져 있는 법…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "dcfdc5a2a57c",
  "ko": "아니… 전혀 무슨 뜻인지 모르겠는데요…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 12,
  "jh": "6147793544ad",
  "ko": "언젠가 너도 알 때가 올 거다. 다음 훈련에선 더 분발하길 기대하겠다"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 12,
  "jh": "7fe6251498db",
  "ko": "…이 정도인가. 네놈들은 좀 더 할 줄 아는 녀석들이라 생각했다만"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "30a631c0ebb0",
  "ko": "설산엔 좀 싫은 추억이 있어서…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 12,
  "jh": "602f78b1c4dd",
  "ko": "변명하지 마라! 이번엔 아슬아슬한 합격점을 주겠다만…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 12,
  "jh": "0f652c3675a6",
  "ko": "다음에도 이런 결과라면 그땐 용서 없다!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 7,
  "jh": "2c30a7cd31af",
  "ko": "네~…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 12,
  "jh": "dff212f8ea14",
  "ko": "…뭔가 해명이 있다면 들어 주지 못할 것도 없다만?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "37bea98f1038",
  "ko": "아뇨, 딱히 없어요…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 12,
  "jh": "68a8a7f4c611",
  "ko": "각오한 거라는 건가. 그 깨끗함은 인정해 주지 못할 것도 없다만"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 12,
  "jh": "d6bae0f41f50",
  "ko": "이 결과로는 당연히 평가를 줄 수 없다"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 7,
  "jh": "d26aa92021f4",
  "ko": "으으… 역시…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 12,
  "jh": "b20096ed19a4",
  "ko": "이 몸이 언제까지나 무른 얼굴을 할 거라 생각하지 마라"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 12,
  "jh": "bf32cce3ce38",
  "ko": "다음에도 이런 꼴이라면… 그땐 각오해 둬라!"
 },
