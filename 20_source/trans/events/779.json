 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 12,
  "jh": "24da3851258f",
  "ko": "네놈들은 언젠가 기초부터 확실히 가르쳐 줘야겠군"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 12,
  "jh": "c799260d23ef",
  "ko": "뭐 됐다, 오늘은 돌아가라"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "d52992839202",
  "ko": "안 됐나… 열심히 했다고 생각했는데…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 12,
  "jh": "92d0afa7a404",
  "ko": "…논외로군"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 7,
  "jh": "bfd4cad3b8e1",
  "ko": "에에에? 왜? 제대로 필살기 했는데…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 12,
  "jh": "eacae8c96e29",
  "ko": "바보 녀석! 네놈들은 전투에 시간을 너무 들인다!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 12,
  "jh": "33446379b8ea",
