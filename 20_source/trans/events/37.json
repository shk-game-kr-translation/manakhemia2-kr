[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "2b864ad80209",
  "ko": "…그래서, 어떻게 된 거야?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 22,
  "jh": "07a9eb2a9b2f",
  "ko": "…실은 그 애, 푸니요는… 우리와 피가 이어진 형제가 아니다!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 0,
  "jh": "e7f00ea2e61c",
  "ko": "아니, 그건 보면 알지만"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 22,
  "jh": "3d158c31f040",
  "ko": "벌써 5년 전인가… 여행지에서 버려진 갓난아기를 주운 건"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 22,
  "jh": "d62f77d7c291",
  "ko": "인간 아이를 키워 본 경험이 없으니 처음엔 고생의 연속이었다…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 22,
  "jh": "42cbf8167d6f",
  "ko": "그래도 훌륭한 푸니푸니가 되도록 형제 모두 열심히 키워 왔다"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "743bf4eae80a",
  "ko": "그래… 고생했구나…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "465e7692bdb6",
  "ko": "훌륭한 푸니푸니란 대목이 걸리는군…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 7,
  "jh": "361507237f21",
  "ko": "그래도 그래도, 그럼 왜 이 학교에 데려온 거야?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 22,
  "jh": "e4d06e8ff74d",
  "ko": "…푸니요도 언젠가 자기가 푸니푸니가 아니란 걸 깨닫는 날이 오겠지"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 22,
  "jh": "ad0166bf23ad",
  "ko": "그날을 위해 일반 교양을 배워 둘 필요가 있으니까"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 4,
  "jh": "d5a080350618",
  "ko": "사람으로서의 교육을 하면 그날이 빨라질지도 모른다"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 22,
  "jh": "9a90b208481a",
  "ko": "…각오한 바다"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 4,
  "jh": "65b16728d5e1",
  "ko": "그런가. 그렇다면 아무 말 않겠다"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 5,
  "jh": "d7c62f75273f",
  "ko": "푸니~?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "6e382e1a0da0",
  "ko": "푸니푸니 위에 타고 있어…!? 얼마나 부러운지…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 23,
  "jh": "d296817de84d",
  "ko": "얘기 끝났어? 라고 여동생이 묻고 있어요"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 22,
  "jh": "3217b63ed30e",
  "ko": "음, 기다리게 했구나. 자, 같이 놀자!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 23,
  "jh": "65d45946a24f",
  "ko": "딱히 타로 형이랑은 놀고 싶지 않대요…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 22,
  "jh": "40678bbc49d0",
  "ko": "왜, 왜냐!? 사양하지 마라! 자!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "ddd9849dec4e",
  "ko": "…혹시 말을 못 하는 건가?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 23,
  "jh": "13cf2881ac64",
  "ko": "네. 이쪽 말은 알아듣지만… 말할 수 있는 건 푸니푸니 공용어뿐이라"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 7,
  "jh": "b263859b878d",
  "ko": "그럼 곤란하지 않아? 수업도 제대로 못 받잖아?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 22,
  "jh": "53b51343ff3a",
  "ko": "그건… 우리 삼 형제가 항상 같이 다니며 커버를…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "6a11ca071950",
  "ko": "…다들 익숙해질 때까지 대소동이 나겠군"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 22,
  "jh": "ca1dbcf4e062",
  "ko": "으음… 그럼 어떻게 하면…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 3,
  "jh": "ffadcc7ba60e",
  "ko": "빤히…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 5,
  "jh": "8b86926363e7",
  "ko": "푸니?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 5,
  "jh": "097f6449a3e0",
  "ko": "푸니닛?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "2adc991960ea",
  "ko": "좋아. 이 애는 내 아틀리에에서 돌봐 줄게"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 11,
  "jh": "1e725c18ac2a",
  "ko": "좋아라니, 뭐가 좋다는 거예요?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 3,
  "jh": "5549646b01ba",
  "ko": "볼이 말랑말랑하잖아. 자격은 충분해"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 4,
  "jh": "e2cf5377d914",
  "ko": "무슨 판단 기준이냐"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 22,
  "jh": "b8225a8a65f1",
  "ko": "바라 마지않던 제안이긴 하다만…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 23,
  "jh": "21031de7b9b1",
  "ko": "응… 일말의 불안이 스치네"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 22,
  "jh": "bcfae813fcbb",
  "ko": "사부로. 여차하면 네가 몸을 던져 푸니요를 지켜라"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 24,
  "jh": "5312fccfb42c",
  "ko": "에에!? 나?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 23,
  "jh": "8d73918286af",
  "ko": "푸니요도 고맙다고 해야지. 그리고 잘 부탁드린다고"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 5,
  "jh": "5af7a498a2e6",
  "ko": "…푸니"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 3,
  "jh": "c461f8b2dfc4",
  "ko": "신경 쓰지 마. 덤으로 푸니푸니 세 마리가 따라와서 언제든 만지기 무제한…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 3,
  "jh": "88c2a62cc75d",
  "ko": "내가 고맙다고 하고 싶을 정도야!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 11,
  "jh": "025f04d17488",
  "ko": "그런 속셈은 좀 더 숨기시는 게…"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 0,
  "jh": "dcec98bdd057",
  "ko": "한꺼번에 넷이나 느는 건가… 시끄러워지겠군"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 7,
  "jh": "4d302942da4b",
  "ko": "한 명이랑 세 마리야. 좋잖아. 많은 게 더 재밌고!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 0,
  "jh": "fabff7b9ba45",
  "ko": "뭐, 사람이 느는 건 상관없지만…"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 0,
  "jh": "4c8b2a6c3cdd",
  "ko": "제대로 된 인간 남자가 나 하나뿐인 건 좀 아니라고 본다…"
 },
 {
  "key": "m47",
  "kind": 5,
  "chr": -1,
  "jh": "799604aface7",
  "ko": "「{CLRE}푸니요{CLNR}」가 동료가 되었습니다."
 },
