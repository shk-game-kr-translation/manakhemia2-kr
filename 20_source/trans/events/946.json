[
 {
  "key": "m0",
  "kind": 0,
  "chr": 20,
  "jh": "0b83af9b7dad",
  "ko": "오, 벌써 과제 끝났냐?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 20,
  "jh": "f722ab1473db",
  "ko": "포기한다? 설마 아무것도 못 만들었냐?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "3f8b1ae56dac",
  "ko": "아니, 그게, 뭐… 네"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 20,
  "jh": "cc8a707fa16e",
  "ko": "너 수업 내용 이해했다고 했지? 분명 그랬지?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "06d82fcaccba",
  "ko": "했는데요… 그게…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 20,
  "jh": "6de0d6f7d3d6",
  "ko": "어이가 없어서 말이 안 나온다는 게 이거군…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 20,
  "jh": "6776d11c9809",
  "ko": "이제 됐다, 돌아가! 당분간 그 얼굴 보이지 마!!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "f4d0fbe3d39e",
  "ko": "네, 네에!"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 1,
  "jh": "c9ee6ba901ff",
  "ko": "하아, 엄청 화났네… 실패했다…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "cd71aae1d849",
  "ko": "그러니까… 이런 장난 같은 것도 되려나…?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 20,
  "jh": "b289671f9b1d",
  "ko": "꿍얼대지 말고 됐으니까 보여 봐"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 20,
  "jh": "42270e59824b",
  "ko": "…뭐야. 제대로 됐잖아. 재미없군"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "f18bf1abef5e",
  "ko": "어? 이거면 됐어?"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 20,
  "jh": "f3db1f9a9b7e",
  "ko": "당연하지. 파생 레시피랑 발상 레시피 과제니까"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 20,
  "jh": "aff5b48cb434",
  "ko": "뭐, 만약 멋진 장비를 만들어 오라는 과제였다면 틀림없이 0점이겠지만"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "b3521677c911",
  "ko": "아, 아하하… 역시"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 20,
  "jh": "cb2edf1652d2",
  "ko": "뭐, 일단 내 수업은 듣고 있는 것 같아 좀 안심했다"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 20,
  "jh": "a7c524989edf",
  "ko": "앞으로도 이 기세로 힘내라"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 20,
  "jh": "7a3382d0a0c3",
  "ko": "스틸 코트인가…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 20,
  "jh": "cc8f82c894bf",
  "ko": "뭐, 틀린 건 아니지만 이쪽은 발상 레시피 쪽을 기대했거든"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "11e1c66a34d8",
  "ko": "에에? 그런 말 안 했잖아!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 20,
  "jh": "d09e047134f7",
  "ko": "당연하지. 시킨 걸 그대로 만들어 오면 과제가 안 되잖아"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 20,
  "jh": "8dc12e78d06a",
  "ko": "좀 제 머리로 생각해"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "fb10005d71cc",
  "ko": "그런~… 납득 못 해!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 20,
  "jh": "b105a2344aba",
  "ko": "흥, 분하면 다음엔 좀 더 머리를 써"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 20,
  "jh": "137985ac5b59",
  "ko": "뭐, 이것도 나쁘진 않으니까 그 나름의 평가는 주지. 자"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 20,
  "jh": "a2a331e41411",
  "ko": "…너, 이거 그냥 클로스 코트잖아"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "fb17f8a3d645",
  "ko": "아, 아하하… 다른 걸 만들려고 했는데 좀처럼 안 돼서…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 20,
  "jh": "aedd7e22bee1",
  "ko": "진짜로 만들려고 했겠지? 대충 한 건 아니지?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "2d52f5e6ddb2",
  "ko": "아, 아니야! 그치, 클로에. 나 성실하게 했지"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 2,
  "jh": "4657f9d86b8f",
  "ko": "…울리카치곤 열심히 한 편이야…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 20,
  "jh": "56d13844de3f",
  "ko": "울리카치곤, 이라… 그럼 어쩔 수 없지"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "24c02c923a54",
  "ko": "그렇게 납득되는 것도 왠지 싫은데…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 20,
  "jh": "3a85e8fb8c83",
  "ko": "칫, 이번 평가는 동정이니까. 다음엔 좀 더 나은 걸 가져와"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "2c30a7cd31af",
  "ko": "네~…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
