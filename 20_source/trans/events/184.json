[
 {
  "key": "m0",
  "kind": 5,
  "chr": -1,
  "jh": "b54a265c8bc0",
  "ko": "알레비스 학원－"
 },
 {
  "key": "m1",
  "kind": 5,
  "chr": -1,
  "jh": "8214ff946185",
  "ko": "아득한 하늘에 떠 있는 외딴섬에 세워진 연금술의 최고 학부"
 },
 {
  "key": "m2",
  "kind": 5,
  "chr": -1,
  "jh": "a9b190e14b88",
  "ko": "과거 수많은 위대한 연금술사를 배출한 명문교로 알려져 있다"
 },
 {
  "key": "m3",
  "kind": 5,
  "chr": -1,
  "jh": "0601eb1dc053",
  "ko": "그러나 최근－"
 },
 {
  "key": "m4",
  "kind": 5,
  "chr": -1,
  "jh": "bf240ba8a819",
  "ko": "너무나 엉성한 수업 내용과 교육자의 질 저하로 제대로 된 졸업생이 해마다 감소"
 },
 {
  "key": "m5",
  "kind": 5,
  "chr": -1,
  "jh": "bc350a601f4f",
  "ko": "설상가상으로 같은 시기, 세계에서 마나의 힘이 감소하는 사태가 발생"
 },
 {
  "key": "m6",
  "kind": 5,
  "chr": -1,
  "jh": "77aaca3c7099",
  "ko": "마나의 힘으로 하늘에 떠 있던 학원은 지상으로 추락"
 },
 {
  "key": "m7",
  "kind": 5,
  "chr": -1,
  "jh": "d7fe1c9398af",
  "ko": "예전의 권위는 흔적조차 느낄 수 없는 그 모습에 입학 희망자도 격감"
 },
 {
  "key": "m8",
  "kind": 5,
  "chr": -1,
  "jh": "d11e1a2a7d6f",
  "ko": "학원 경영을 지탱하던 출자자들도 하나둘씩 손을 떼어 가고"
 },
 {
  "key": "m9",
  "kind": 5,
  "chr": -1,
  "jh": "ff6dcddd082b",
  "ko": "학원은 심각한 경영난에 직면해 있었다"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 13,
  "jh": "56d4c0909ae4",
  "ko": "아아… 큰일이야, 큰일.\n어째서 내가 교장일 때\n이런 문제만 잔뜩…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 13,
  "jh": "0bf78caa0c75",
  "ko": "이대로는…\n이대로는 정말로\n학원이 망하고 말 거야…"
 },
 {
  "key": "m12",
  "kind": 5,
  "chr": 35,
  "jh": "c188e84d8d8d",
  "ko": "곤란하신 모양이군요"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 13,
  "jh": "1139b1687c67",
  "ko": "누, 누구냐!?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 35,
  "jh": "f076b686d44e",
  "ko": "이거 실례.\n놀라게 해 드린 것 같군요"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 35,
  "jh": "a694648f46c7",
  "ko": "문 너머까지 푸념하는 소리가 들려와서 그만…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 13,
  "jh": "013f901d18aa",
  "ko": "으음, 그렇게 큰 소리로\n푸념하고 있었나…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 18,
  "jh": "c73fb1965599",
  "ko": "인사가 늦었습니다.\n저는 마루타 셰베스티라고 합니다"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 13,
  "jh": "da049c7e1af8",
  "ko": "셰베스티라면,\n학원 최대 후원자인…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 13,
  "jh": "1bbedd927f94",
  "ko": "서, 설마!\n또 후원을 끊겠다는 얘기는!?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 18,
  "jh": "56cb34ca85ac",
  "ko": "아니요, 당치도 않습니다. …뭐, 이 학원의 현 상황에는 큰 불만을 갖고 있습니다만…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 13,
  "jh": "4d6de7c27e91",
  "ko": "으…그럼, 오늘은 무슨 용건으로?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 18,
  "jh": "362e0aaa7ceb",
  "ko": "재건이 가능할 때 경영에 참견을 좀 해 볼까 해서요"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 13,
  "jh": "9cd6de08f5fc",
  "ko": "재건…정말 가능한 겁니까?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 18,
  "jh": "a05cc131e77e",
  "ko": "네. 오늘은 그걸 위한 시안을 몇 가지 준비해 왔어요"
 },
 {
  "key": "m25",
  "kind": 5,
  "chr": -1,
  "jh": "4e840f0bf78a",
  "ko": "이리하여 알레비스 학원의 교장 제플은 마루타를 이사장으로 맞아들여"
 },
 {
  "key": "m26",
  "kind": 5,
  "chr": -1,
  "jh": "31d4da956876",
  "ko": "그녀가 시키는 대로 학원 재건에 착수했다"
 },
 {
  "key": "m27",
  "kind": 5,
  "chr": -1,
  "jh": "1d0393ae2d21",
  "ko": "3년제였던 수업 커리큘럼은 1년제로 변경."
 },
 {
  "key": "m28",
  "kind": 5,
  "chr": -1,
  "jh": "52410ef9d459",
  "ko": "과목도 연금술뿐 아니라 일반 교양부터 법률, 정치까지 폭넓게"
 },
 {
  "key": "m29",
  "kind": 5,
  "chr": -1,
  "jh": "f18da6b988c8",
  "ko": "지금까지는 연금술의 재능이 없는 사람은 입학조차 할 수 없었지만,"
 },
 {
  "key": "m30",
  "kind": 5,
  "chr": -1,
  "jh": "75d4a53cf74a",
  "ko": "원하는 사람은 누구나 입학할 수 있게 되었다"
 },
 {
  "key": "m31",
  "kind": 5,
  "chr": -1,
  "jh": "cee363a5b942",
  "ko": "그에 따라 지금까지 학원이 부담하던 입학금과 수업료는"
 },
 {
  "key": "m32",
  "kind": 5,
  "chr": -1,
  "jh": "570d3afb86ae",
  "ko": "전액 학생 부담이 되었다"
 },
 {
  "key": "m33",
  "kind": 5,
  "chr": -1,
  "jh": "0701b8107a52",
  "ko": "갑작스러운 학원의 방침 전환에 한때는 반발도 꽤 있었지만"
 },
 {
  "key": "m34",
  "kind": 5,
  "chr": -1,
  "jh": "7eb0816efb0f",
  "ko": "그와는 반대로 입학 희망자는 해가 갈수록 점점 늘어나"
 },
 {
  "key": "m35",
  "kind": 5,
  "chr": -1,
  "jh": "062e78ea2d33",
  "ko": "몇 년 뒤, 학원은 보란 듯이 흑자 경영을 이루었다"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 13,
  "jh": "660005ead78e",
  "ko": "이야! 드디어 흑자예요, 흑자!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 18,
  "jh": "2742a05c5003",
  "ko": "생각보다 시간은 걸렸지만, 일단은 성공이군요"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 13,
  "jh": "9ed546304a2f",
  "ko": "성공 정도가 아니죠! 한때는 폐교 직전이었는데…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 13,
  "jh": "5762ad61fe7f",
  "ko": "이것도 다 이사장님 덕분입니다!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 18,
  "jh": "4a55ace91dee",
  "ko": "제 덕분인지는 둘째 치고…슬슬 다음 단계로 넘어갈 때로군요"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 13,
  "jh": "87fe29ae2e5c",
  "ko": "오오, 아직 뭔가 생각이 있으신가요? 얼마든지 하십시오"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 13,
  "jh": "63b1f0719523",
  "ko": "이사장님 아이디어라면 성공은 따 놓은 당상이죠!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 18,
  "jh": "593a195dba35",
  "ko": "그럼…연금술 수업을 폐지합시다"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 13,
  "jh": "bc382ee4df82",
  "ko": "호오, 연금술을 폐지! 그건 생각도 못 했…잠깐, 에에에에에!?"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 18,
  "jh": "4c23c1d5bfa1",
  "ko": "놀랄 일도 아니잖아요. 연금술 수업은 이래저래 비용도 들고요"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 18,
  "jh": "731ed5e4aff4",
  "ko": "게다가 마나가 줄어든 지금, 일류 연금술사를 키우는 건 불가능해요"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 18,
  "jh": "4bf4693bdff6",
  "ko": "실제로 연금술과 입학 희망자도 해마다 줄고 있고요"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 13,
  "jh": "d94805007fa9",
  "ko": "그, 그건 확실히 그럴지도 모르지만…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 13,
  "jh": "5aa25f72878d",
  "ko": "하, 하지만 알레비스 학원은 수많은 연금술사를 배출해 온 전통 있는…"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 18,
  "jh": "558404432391",
  "ko": "전통이니 권위니 하는 건 관심 없어요. 학원 경영에 필요한지 아닌지…"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 18,
  "jh": "629c2e96249a",
  "ko": "더 말하자면, 돈이 되느냐 마느냐…그것만이 중요하죠"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 18,
  "jh": "e0647c4aa7ea",
  "ko": "그렇다고는 해도, 올해는 입학 희망자를 이미 모집해 버렸으니…"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 18,
  "jh": "fb8a59b5f34a",
  "ko": "폐지는 내년부터가 되겠군요"
 },
 {
  "key": "m54",
  "kind": 0,
  "chr": 13,
  "jh": "d465d28ee767",
  "ko": "연금술을 폐지…어, 어쩌지…"
 },
 {
  "key": "m55",
  "kind": 0,
  "chr": 13,
  "jh": "a65c68674fd6",
  "ko": "그런 일이 생기면 선대 교감님께 무슨 꾸중을 들을지…"
 },
 {
  "key": "m56",
  "kind": 0,
  "chr": 13,
  "jh": "2377dacb6f3d",
  "ko": "하지만 이사장님한테도 고개를 못 들고… 아아, 큰일이다 큰일!"
 },
 {
  "key": "m57",
  "kind": 0,
  "chr": 13,
  "jh": "bc5da28eb7ce",
  "ko": "겨우 폐교 위기를 넘겼다고 생각했는데… 하아…"
 },
 {
  "key": "m58",
  "kind": 0,
  "chr": 13,
  "jh": "4fecdadb055b",
  "ko": "……그래! 이렇게 된 이상, 그 남자에게 기댈 수밖에…"
 },
 {
  "key": "m59",
  "kind": 5,
  "chr": 35,
  "jh": "636d05ab3b28",
  "ko": "…그렇군. 그래서 이 몸에게 머리를 숙이러 왔다는 건가"
 },
 {
  "key": "m60",
  "kind": 0,
  "chr": 13,
  "jh": "f13d46d73c22",
  "ko": "그래, 부탁하네. 이렇게 빌게! 달리 기댈 사람이 없어"
 },
 {
  "key": "m61",
  "kind": 5,
  "chr": 35,
  "jh": "0081bf6f3fd2",
  "ko": "요컨대 그 여자를 입 다물게 하면 된다는 거로군. 알았다, 해 주지"
 },
 {
  "key": "m62",
  "kind": 0,
  "chr": 13,
  "jh": "b96c58c16105",
  "ko": "저, 정말인가!?"
 },
 {
  "key": "m63",
  "kind": 5,
  "chr": 35,
  "jh": "43db0a88ce3a",
  "ko": "음. 모교의 위기를 못 본 척할 수는 없으니까"
 },
 {
  "key": "m64",
  "kind": 0,
  "chr": 35,
  "jh": "ac08209e77e5",
  "ko": "단, 몇 가지 조건이 있다…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]