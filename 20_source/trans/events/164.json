[
 {
  "key": "m0",
  "kind": 2,
  "chr": 7,
  "jh": "59c3cc19cd3e",
  "ko": "후아… 심심해. 릴리아, 나도 도울게"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 3,
  "jh": "0608144a22ee",
  "ko": "필요 없어. 네가 도우면 엉망진창이 되니까"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 7,
  "jh": "11379c031813",
  "ko": "그렇지 않아. 난 하면 되는 애라고!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 3,
  "jh": "dbc092ee98b2",
  "ko": "시끄러워! 지금 중요한 참이니까 방해하지 마!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 7,
  "jh": "2c454e3c089a",
  "ko": "혼났다… 으으~ 심심해…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 0,
  "jh": "5a514faa9598",
  "ko": "(안 되겠어… 가만히 있으면 자꾸 시시한 생각을 하게 돼…)"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 0,
  "jh": "428df328cd49",
  "ko": "(젠장… 한 번 더 그 녀석을 만나서… 하지만 어디 있는지도 모르고…)"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 5,
  "jh": "d7c62f75273f",
  "ko": "푸니~?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 23,
  "jh": "877f18a8dc7f",
  "ko": "무서운 얼굴로 무슨 생각을 하고 있냐? 라고 여동생이 걱정하고 있어요"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 0,
  "jh": "1f6445cf9a28",
  "ko": "딱히, 아무것도 아니야"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 4,
  "jh": "cc77c95fdb04",
  "ko": "아무것도 아니라면 그런 얼굴 하지 마라"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "6119c22c848f",
  "ko": "…무슨 얼굴을 하든 내 마음이야"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 4,
  "jh": "4daf8e688023",
  "ko": "아이를 걱정시켜 놓고 내 마음이고 뭐고 없다"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "d343c3f65f00",
  "ko": "뭐…?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 11,
  "jh": "320081fac415",
  "ko": "저기… 로제 씨"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "612a67545745",
  "ko": "이번엔 너냐! 대체 뭐야!?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 11,
  "jh": "7aa3bad76ec8",
  "ko": "죄, 죄송해요! 저, 엄청 고민했는데, 역시 말씀드리는 게…"
 },
 {
  "key": "m18",
  "kind": 5,
  "chr": 13,
  "jh": "79b6a55eabe0",
  "ko": "아~… 미안. 바쁜 것 같은데 잠깐 괜찮을까?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 4,
  "jh": "23b189a57329",
  "ko": "별난 손님이군"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 11,
  "jh": "4d960f9a1a4e",
  "ko": "흐흑… 교장 선생님한테까지 말허리를 잘리다니…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 13,
  "jh": "8d6c10edcbcd",
  "ko": "그, 그렇게 풀 죽지 마! 미안하다고 했잖아!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 0,
  "jh": "ee9df787c010",
  "ko": "…아가씨라면 보시다시피 손을 뗄 수 없는 것 같은데요"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 13,
  "jh": "257b9c32e8a1",
  "ko": "아니아니, 볼일이 있는 건 자네야"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 0,
  "jh": "3bf5cb6875fb",
  "ko": "저한테요?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 13,
  "jh": "0ef5bddc3eb4",
  "ko": "응… 자네 할아버님 말인데. 참관 때부터 집에 안 돌아갔다는 얘기를 들어서…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 11,
  "jh": "601380e48947",
  "ko": "위르겐 씨가!?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "e9f4e9d3f43c",
  "ko": "…그 영감이라면 또 길이라도 잃었겠죠"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 11,
  "jh": "01e7150b91c0",
  "ko": "그런, 로제 씨! 걱정 안 되세요!?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 13,
  "jh": "7afa9701f686",
  "ko": "아아아, 진정해 진정해."
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 13,
  "jh": "ed3c4890eb3d",
  "ko": "그렇게 믿을 만한 얘기도 아니야. 그래도 일단 귀에 넣어 두려고 해서"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 4,
  "jh": "306b2dd8a606",
  "ko": "믿을 만한 얘기가 아니다?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 13,
  "jh": "8326059dee11",
  "ko": "이 얘기를 해 준 사람이 말이지, 영 미덥지 못하달까…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 13,
  "jh": "8433b88c5fbb",
  "ko": "처음 본 사람인데, 이렇게 긴 머리를 뒤로 묶고 경박해 보이는 느낌으로…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 0,
  "jh": "275bdbd60a83",
  "ko": "…!?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 23,
  "jh": "b4f99f392923",
  "ko": "교장 선생님한테 경박하단 소릴 듣다니 상당하군. 하고 푸니요가 중얼거리고 있어요"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 13,
  "jh": "03c8741eb87a",
  "ko": "무, 무슨 뜻이야!? 내가 경박하다는 거야!?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 0,
  "jh": "0ef0b9dfa00e",
  "ko": "…그 녀석이다… 큭!"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 11,
  "jh": "3a7abef2da1c",
  "ko": "기다려 주세요!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 0,
  "jh": "4d8442cff36a",
  "ko": "비켜! 너랑 얘기할 시간은…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 11,
  "jh": "e395c2ae7692",
  "ko": "그 사람, 루리히라는 사람 아니에요? 저, 위르겐 씨한테 들어서…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 0,
  "jh": "be0f5774c4ec",
  "ko": "뭐…? 왜 영감이 그 녀석을 알고 있는 거야!?"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 11,
  "jh": "6b1c20761585",
  "ko": "그것만이 아니에요. 그, 로제 씨의… 반지에 대해서도 들었어요"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 0,
  "jh": "6a4b46453ec0",
  "ko": "!?"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 11,
  "jh": "fecf3be5b3d7",
  "ko": "그 반지는 마나를 이 세계에서 지우는 힘을 갖고 있다… 그렇죠?"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 4,
  "jh": "4d916a60ceee",
  "ko": "…호오"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 3,
  "jh": "ae7791d8c11b",
  "ko": "뭐, 뭐야? 무슨 소란이야?"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 0,
  "jh": "2ee87739b988",
  "ko": "…그래서, 뭐? 내가 너희의 적이라고, 그렇게 말하고 싶은 거냐?"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 11,
  "jh": "d3392a2f7c34",
  "ko": "아, 아니에요! 로제 씨는 그런 사람이 아니고"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 11,
  "jh": "f5369b2f9ccb",
  "ko": "아아, 그게, 어디서부터 말씀드려야 할지…"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 3,
  "jh": "f48b99902f2a",
  "ko": "진정해! 제대로 설명해!"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 0,
  "jh": "c61d4c32111b",
  "ko": "(뭐야… 왜 영감이 그 녀석이나 반지에 대해…)"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 11,
  "jh": "05da202d9174",
  "ko": "그, 그게… 위르겐 씨는 엄청 걱정하고 계셨어요"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 11,
  "jh": "da5bb66398bb",
  "ko": "로제 씨가 마나를 원망하고 있는 게 아닐까 하고…"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 0,
  "jh": "68b2cca7f542",
  "ko": "(그래, 마나가… 그 마나가 영감을 배신했으니까…)"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 11,
  "jh": "f5399cdc8b47",
  "ko": "그렇다면 그건 자기 탓이라고. 자기 탓에 로제 씨가 마나를…"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 0,
  "jh": "1f3db95b7288",
  "ko": "(…그 마나가 배신했으니까 영감은 그렇게 약해져 버려서…)"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 11,
  "jh": "57f78af0feb8",
  "ko": "…건 아니래요. 그게… 맞아! 위르겐 씨도 예전에 그 반지를 받았다고…"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 0,
  "jh": "a43b28b9a47d",
  "ko": "(그래서 나도 아가씨네 집을 섬기게 돼서…)"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 0,
  "jh": "f7ddc4f4f73e",
  "ko": "(난 할아버지와 마나, 셋이서 사는 생활이 마음에 들었는데…)"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 11,
  "jh": "af4f9f759fc8",
  "ko": "…시절 위르겐 씨는 젊은 검사와 알게 되어서, 그게…"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 11,
  "jh": "11fcc16f2fe5",
  "ko": "얘기가 좀 새는데요, 그 사람이 루리히라는 사람이고, 음…"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 5,
  "jh": "3469954e8c63",
  "ko": "푸니, 니~!"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 23,
  "jh": "902c7dd313cc",
  "ko": "좀 더 조리 있게 말 못 해? 라고 여동생이 짜증을 감추지 못하고 있어요"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 0,
  "jh": "520db1fc6b82",
  "ko": "(그래. 강한 할아버지에게 검술을 배우는 게 무엇보다 기뻐서…)"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 0,
  "jh": "867b161e0f2f",
  "ko": "(하지만 할아버지는 마나에게 배신당한 뒤로 검을 들지 않게 됐다…)"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 11,
  "jh": "821b4a819f64",
  "ko": "…니까 마나는 나쁘지 않아요. 나쁜 건 전부 그 반지를 가진…"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 0,
  "jh": "c5a52e1d5140",
  "ko": "(…젠장… 이런… 벌써 10년이나 지난 일을… 왜 이제 와서…)"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 11,
  "jh": "dd53adaecc9b",
  "ko": "…계속 비밀로 하셨는데, 로제 씨 상태가 이상하다고 말씀드렸더니, 그럼…"
 },
 {
  "key": "m72",
  "kind": 5,
  "chr": 35,
  "jh": "56f1972fa43b",
  "ko": "…시끄러워"
 },
 {
  "key": "m73",
  "kind": 0,
  "chr": 0,
  "jh": "65e2c32c5c18",
  "ko": "…끄러워"
 },
 {
  "key": "m74",
  "kind": 0,
  "chr": 11,
  "jh": "263194ac6acf",
  "ko": "그래서 위르겐 씨는 혼자서 아마 그 사람한테…"
 },
 {
  "key": "m75",
  "kind": 5,
  "chr": 35,
  "jh": "c5dd7926b27b",
  "ko": "닥쳐… 마나 주제에…"
 },
 {
  "key": "m76",
  "kind": 0,
  "chr": 0,
  "jh": "38d6f1965d37",
  "ko": "시끄러워! 닥쳐!!"
 },
 {
  "key": "m77",
  "kind": 0,
  "chr": 11,
  "jh": "ddbee1e891f5",
  "ko": "꺅!"
 },
 {
  "key": "m78",
  "kind": 0,
  "chr": 3,
  "jh": "3f5be4b7dfbb",
  "ko": "…로제?"
 },
 {
  "key": "m79",
  "kind": 0,
  "chr": 0,
  "jh": "fd3684d4898d",
  "ko": "그래, 마나가… 그 녀석이 할아버지를 배신하고! 버리고! 그래서…!"
 },
 {
  "key": "m80",
  "kind": 0,
  "chr": 4,
  "jh": "3116653200c1",
  "ko": "성질부리지 마라"
 },
 {
  "key": "m81",
  "kind": 0,
  "chr": 11,
  "jh": "01b1e543526a",
  "ko": "그, 그러니까 그게 아니라니까요. 제 얘기를…"
 },
 {
  "key": "m82",
  "kind": 5,
  "chr": 35,
  "jh": "d40cf77da728",
  "ko": "할아버지를 배신한, 마나 주제에…"
 },
 {
  "key": "m83",
  "kind": 0,
  "chr": 0,
  "jh": "088efa1a5803",
  "ko": "시끄러워! 시끄러워! 아무 말도 하지 마! 너희가 말하지 마!"
 },
 {
  "key": "m84",
  "kind": 0,
  "chr": 3,
  "jh": "872a9ec5771e",
  "ko": "자, 잠깐 로제… 왜 그래…?"
 },
 {
  "key": "m85",
  "kind": 0,
  "chr": 7,
  "jh": "c3632aa37bfd",
  "ko": "진정하자. 왠지 로제답지 않아"
 },
 {
  "key": "m86",
  "kind": 0,
  "chr": 11,
  "jh": "7a0d4e53d846",
  "ko": "아니에요! 그러니까 마나는 나쁘지 않아요. 나쁜 건…"
 },
 {
  "key": "m87",
  "kind": 5,
  "chr": 35,
  "jh": "f946694ab922",
  "ko": "날 버린, 마나 주제에…!!"
 },
 {
  "key": "m88",
  "kind": 0,
  "chr": 0,
  "jh": "846bacfe0862",
  "ko": "시끄럽다고 했잖아아아!!"
 },
 {
  "key": "m89",
  "kind": 0,
  "chr": 11,
  "jh": "0df869fe4983",
  "ko": "꺄앗!!"
 },
 {
  "key": "m90",
  "kind": 0,
  "chr": 0,
  "jh": "3e1433f71881",
  "ko": "아…"
 },
 {
  "key": "m91",
  "kind": 0,
  "chr": 3,
  "jh": "fb50bf03032f",
  "ko": "윔!?"
 },
 {
  "key": "m92",
  "kind": 0,
  "chr": 7,
  "jh": "ba92bf066997",
  "ko": "로제! 뭐 하는 거야!!"
 },
 {
  "key": "m93",
  "kind": 0,
  "chr": 11,
  "jh": "4328baa1f037",
  "ko": "으… 으으…"
 },
 {
  "key": "m94",
  "kind": 0,
  "chr": 0,
  "jh": "8d4d6240c0f3",
  "ko": "아………큭!!"
 },
 {
  "key": "m95",
  "kind": 2,
  "chr": 5,
  "jh": "ee00abd1cc2f",
  "ko": "푸니!"
 },
 {
  "key": "m96",
  "kind": 2,
  "chr": 23,
  "jh": "8c0dffca1aad",
