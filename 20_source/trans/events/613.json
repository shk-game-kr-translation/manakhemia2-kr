[
 {
  "key": "m0",
  "kind": 2,
  "chr": 7,
  "jh": "b95ac50c1601",
  "ko": "에나~! 봐 봐. 선물 가져왔어~!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 7,
  "jh": "e02e0616b0d8",
  "ko": "…라니, 어라? 아무도 없어?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 0,
  "jh": "8af28df2c098",
  "ko": "외출한 것 같군. 허술하기는…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 7,
  "jh": "bce7aa8127ac",
  "ko": "칫~ 모처럼 기뻐해 주길 바랐는데… 앗! 에나 기계 발견!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 7,
  "jh": "209ef5173fcb",
  "ko": "있잖아, 몰래 고쳐 두면 에나 깜짝 놀랄까?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "f6a5ed937a68",
  "ko": "초보자가 만지지 않는 게 좋을 것 같은데"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 7,
  "jh": "a1ce96d83619",
  "ko": "초보자 아니야. 나도 어릴 땐 같이 기계 만졌었다고"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "a2c1da27f224",
  "ko": "어릴 때라니, 언제 얘기야? 라니, 또 안 듣네…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 7,
  "jh": "cd55441080fc",
  "ko": "분명 여길 열고… 다음은, 그러니까… 맞다, 분명 이 부품이랑 바꾸면… 얍!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "42630d91c40a",
  "ko": "…왠지 위험한 소리 나지 않았냐?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 7,
  "jh": "a3e8f0d89bac",
  "ko": "그래? 내가 기계 만질 땐 늘 이런 소리 났는데"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "576edc5ed4bf",
  "ko": "…너 기계 만지는 거 그만둔 거, 주변에서 말려서지?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 7,
  "jh": "784dc00d3680",
  "ko": "어? 대단하다, 잘 알았네!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 7,
  "jh": "e985ad69fb96",
  "ko": "아빠가 넌 여자애니까 기계 같은 거 만지지 마~ 하고 말을 꺼내서"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "e2ac508290e3",
  "ko": "역시 만지지 마. 돌이킬 수 없게 될 거다…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 7,
  "jh": "b9436099e1fa",
  "ko": "좋아, 이걸로 오케이! 이제 전원 넣고, 하고…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "d4f257115d56",
  "ko": "늦었나… 응? 야, 누가 돌아온다"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 7,
  "jh": "ab8a0bbdd5da",
  "ko": "와, 큰일! 어디 숨어야 해!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 7,
  "jh": "cb2e0bae35e2",
  "ko": "후우, 아슬아슬했네"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 7,
  "jh": "b66be961233b",
  "ko": "응? 왜 그래?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "44f9d9277a0c",
  "ko": "아니, 왠지 상태가 이상했던 것 같은데…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 7,
  "jh": "eedb63bdb182",
  "ko": "그래? 아~ 그보다 에나, 빨리 기계 눈치채 주려나"
 },
 {
  "key": "m23",
  "kind": 5,
  "chr": 8,
  "jh": "293c75ab99a4",
  "ko": "응? 뭐야… 출력이 말도 안 돼…! 으아아아!?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 7,
  "jh": "744b08b1517a",
  "ko": "눈치채 줬다! 아하하, 기뻐한다 기뻐한다!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "2f54f5d285bf",
  "ko": "아무리 봐도 안 기뻐하는데…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 7,
  "jh": "61dd7adbe6d8",
  "ko": "꺅!?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "2fe981ada063",
  "ko": "뭐, 뭐야!?"
 },
 {
  "key": "m28",
  "kind": 5,
  "chr": 8,
  "jh": "48ec3555c98d",
  "ko": "전혀 제어가 안 돼… 으아아아! 피, 피해!"
 },
 {
  "key": "m29",
  "kind": 5,
  "chr": 6,
  "jh": "e0b45dd14de1",
  "ko": "어? 잠, 형?"
 },
 {
  "key": "m30",
  "kind": 5,
  "chr": 9,
  "jh": "3822d9807f51",
  "ko": "살기가 담겨 있군… 그쪽이 그럴 생각이라면…"
 },
 {
  "key": "m31",
  "kind": 5,
  "chr": 8,
  "jh": "466b0e042561",
  "ko": "아니야! 이게 멋대로 움직인다고! 크아아!! 파, 팔이 빠져어어!!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "60d33ab22432",
  "ko": "…야"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 7,
  "jh": "7769611be0f2",
  "ko": "아, 아하하하… 너무 파워업했나?"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 0,
  "jh": "b7947fbb3819",
  "ko": "그러니까 하지 말라고 했잖아…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 7,
  "jh": "8288f2bf2fdd",
  "ko": "응, 뭐… 조금 실패했네!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 0,
  "jh": "7a1dc0765a02",
  "ko": "이게 조금이냐… 그래서 어쩔 건데? 저거"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 7,
  "jh": "5aa717f3d05c",
  "ko": "어떡하지… 이럴 땐… 그러니까… 좋아! 못 본 걸로 하자!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 0,
  "jh": "aef48060a3e5",
  "ko": "…뭐?"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 7,
  "jh": "8b7705a70752",
  "ko": "괜찮아! 에나는 강한 애니까 스스로 어떻게든 할 거야~!"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 0,
  "jh": "faca4871ef70",
  "ko": "야! 기다려! …난 모른다!"
 },
 {
  "key": "m41",
  "kind": 5,
  "chr": 8,
  "jh": "3c7e0b46595e",
  "ko": "으갸아아아! 팔이, 내 팔이이이!!"
 },
 {
  "key": "m42",
  "kind": 5,
  "chr": 6,
  "jh": "cc68b4ba8868",
  "ko": "대, 대단해! 형 팔이 두 배쯤 늘어났어!"
 },
 {
  "key": "m43",
  "kind": 5,
  "chr": 9,
  "jh": "cd7518f03f8b",
  "ko": "요즘 과학은 여기까지… 이거 참, 기술의 진보는 놀라울 만큼 빠르군"
 },
 {
  "key": "m44",
  "kind": 5,
  "chr": 1,
  "jh": "1a48a8e6b2f1",
  "ko": "정말, 작작 좀 해! 안 멈추면 힘으로라도 멈추는 거야!!"
 },
 {
