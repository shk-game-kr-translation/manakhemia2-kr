[
 {
  "key": "m0",
  "kind": 2,
  "chr": 9,
  "jh": "3584f837660a",
  "ko": "찾았다! 페페론!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 6,
  "jh": "ec847a5ce8d1",
  "ko": "그가아…?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "f8ef2cd1b462",
  "ko": "너 작작 좀 해. 스승님까지 다치게 하고…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 6,
  "jh": "a33b9f8595d7",
  "ko": "고게가아아아아아아!!!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 8,
  "jh": "7351248ee2f8",
  "ko": "읏… 가까이서 들으니 엄청난 목소리네"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 2,
  "jh": "76754e7c8246",
  "ko": "더 다가오면 죽인다… 요정 씨가 그렇게 말하고 있어…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "ba44623adeae",
  "ko": "넌 또 아무 말이나…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "bb4bfb38e606",
  "ko": "그게아아아! 고오오오오!!!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "a3af1bd7518d",
  "ko": "으으… 고토, 네가 설득하고 와. 친구잖아!?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 9,
  "jh": "e32e5993c504",
  "ko": "난 여자와의 애증 속에서 목숨을 잃기로 정했거든. 우정에 순사하는 건 좀"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "a3854a3e349f",
  "ko": "얄팍한 우정…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 6,
  "jh": "ae7dc97b10d3",
  "ko": "그가! 고! 가아아아!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "279b4f9f9217",
  "ko": "와, 다가온다!? 어, 어떡하지…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "5e52e5aa4eca",
  "ko": "아… 생각났다"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "b04db1122947",
  "ko": "뭐? 뭐든 좋으니까 말해 봐!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 2,
  "jh": "10a4877c70be",
  "ko": "전에 책에서 읽은 적이 있어…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 2,
  "jh": "dff686052ab0",
  "ko": "남쪽 바다 외딴섬에서 날뛰는 괴수 이야기. 한 여자애가 그 괴수의 분노를 가라앉혀서…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 9,
  "jh": "4c45d489506a",
  "ko": "딱 지금이랑 같은 상황이군. 그래서?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 2,
  "jh": "b50b60d290de",
  "ko": "…이야기 자체는 B급. 애초에 작가는 연애 소설이 특기인 사람이라…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 2,
  "jh": "ddc7a1c770a1",
  "ko": "그런데 결혼 생활이 잘 안 풀려서 자포자기해서 쓴 게 그 작품이라고…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 8,
  "jh": "4fbb11105c11",
  "ko": "작가 뒷사정은 아무래도 좋으니까! 결말을 말해!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "a5b4a97b9627",
  "ko": "…책 내용보다 작가의 식은 부부 생활 쪽이 재밌는데…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "5db5ec5ba59f",
  "ko": "그건 나중에 천천히 들어 줄 테니까!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "e8672e6c41e2",
  "ko": "음… 괴수의 분노를 가라앉힌 건 소녀의 순진한 기도… 그리고 눈물…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "6d9980fead45",
  "ko": "…눈물? 그 녀석을 위해 나보고 울라는 거야?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 9,
  "jh": "cd16a6325834",
  "ko": "과연, 스승님이 말한 게 그거였군…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 8,
  "jh": "1861f27a3429",
  "ko": "누나, 망설일 틈 없어!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "bdc1317dd5e5",
  "ko": "그런… 소녀의 눈물이면 클로에도 되잖아!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 2,
  "jh": "81c1d839eebf",
  "ko": "난 순진하지 않으니까…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "d1ac4dde506a",
  "ko": "아아, 그렇지. 더럽혀졌으니까, 너"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 2,
  "jh": "5e57c4c9d800",
  "ko": "…내가 말하는 건 괜찮지만 남이 말하면 화나…"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 6,
  "jh": "f5505309d112",
  "ko": "고르르르르… 구고아아아!!!"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 9,
  "jh": "cbd11c07807d",
  "ko": "자, 이제 체념하고… 얍!"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 1,
  "jh": "fe02561e001e",
  "ko": "꺅, 등 밀지 마! …읏"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "1607db35fe28",
  "ko": "아, 아하하하… 거, 건강해 보이네"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 6,
  "jh": "3e5d7b21c455",
  "ko": "규르르르르… 고후우"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 9,
  "jh": "eaccfea104e2",
  "ko": "스스럼없이 인사 나눌 때가 아니야. 자, 울면서 기도해!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 2,
  "jh": "9072c2c8d678",
  "ko": "요정 씨를 생각하면서. 거기가 중요하니까…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 1,
  "jh": "fb5f78d72778",
  "ko": "이 녀석을 생각하라니… 그렇게 울 만한 추억은 없고…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "5a604eee1838",
  "ko": "아. 한심한 추억뿐이라 다른 의미로 눈물이 날 것 같기도"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 8,
  "jh": "b06195dc4eaa",
  "ko": "이 마당에 울기만 하면 뭐든 되겠지"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 9,
  "jh": "ba6a32383253",
  "ko": "응, 이제 기도만 하면 돼"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 1,
  "jh": "562605239a9e",
  "ko": "기도하라고 해도…"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 6,
  "jh": "a04f4d18ab75",
  "ko": "구르르르르… 고호오오!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 1,
  "jh": "e51a49da78c5",
  "ko": "힉! …에잇, 이렇게 된 이상 될 대로 되라야! 후우, 하아…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 1,
  "jh": "560f87973fdc",
  "ko": "분노에 몸을 맡기면 안 돼… 그 시절의 다정했던 너로 돌아와… 부탁이야!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 6,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 1,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 6,
  "jh": "b9751eb00dbc",
  "ko": "………흥"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 1,
  "jh": "6a4b46453ec0",
  "ko": "!?"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 8,
  "jh": "73d9971d82d8",
  "ko": "으악! 이쪽으로 온다!"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 9,
  "jh": "409b88c21927",
  "ko": "역시 아가씨 눈물로는 무리였나"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 2,
  "jh": "ecd80d0e8d52",
  "ko": "울리카… 코웃음 당했어… 풉"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 1,
  "jh": "cb3a70906bf2",
  "ko": "…아~ 그래. 그렇게 나오시겠다. 사람이 저자세로 나가니까… 페페론 주제에…"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 1,
  "jh": "8a5ccc1acf00",
  "ko": "열받았어!! 이렇게 된 이상 두들겨 패서 정신 차리게 해 줄 거야!"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 8,
  "jh": "75f844d2d26d",
  "ko": "오, 누나가 폭발했다"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 2,
  "jh": "3c80996641fc",
  "ko": "결국 이렇게 힘으로…"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 9,
  "jh": "2019585e1b56",
  "ko": "처음부터 이렇게 했으면 좋았을걸"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 6,
  "jh": "404da1fe7a2f",
  "ko": "구고아! 아구아아아아아!!"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 1,
  "jh": "2492741af803",
  "ko": "시끄러워! 일일이 울부짖지 마~!"
 },
 {
  "key": "m60",
  "kind": 0,
  "chr": 6,
  "jh": "8624551352b6",
  "ko": "아규… 끄으응…"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 8,
  "jh": "2c596183ffc8",
  "ko": "오오… 어떻게든 이겼네…"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 1,
  "jh": "fcff0602dc05",
  "ko": "흥. 소녀를 망신 주니까 이런 꼴을 당하는 거야"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 9,
  "jh": "d02043b040b4",
  "ko": "여자애를 화나게 하면 무섭군… 새삼 깨달았어"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 6,
  "jh": "48606c0bdb37",
  "ko": "으… 으으? 여긴…"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 8,
  "jh": "47d1f267c174",
  "ko": "오, 정신 돌아온 것 같네"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 2,
  "jh": "da0be520c5e3",
  "ko": "이것도 울리카의 기도 덕분… 풉…"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 1,
  "jh": "929cf3c743ff",
  "ko": "너도 한 대 맞고 싶은가 보네…"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 6,
  "jh": "69e146210701",
  "ko": "이 몸은 대체… 아아, 나쁜 꿈을 꾼 것 같아…"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 8,
  "jh": "4e2ae3602605",
  "ko": "정말 꿈이었으면 좋았을 텐데…"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 9,
  "jh": "63fae073c614",
  "ko": "전부 현실이야, 페페론. 너의 약한 마음이 만들어 낸…"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 6,
  "jh": "dc0bfe695b6b",
  "ko": "에…? 그럴 리 없어. 왜냐면…"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 6,
  "jh": "924bf7e6edf3",
  "ko": "꿈속의 누나가 엄청 웃긴 얼굴로 이 몸한테 울면서 기도하고 있었거든"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 6,
  "jh": "a6b85d1bf450",
  "ko": "그게 현실이었다면 정말 우스운…"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 1,
  "jh": "5a4c39e1d8d8",
  "ko": "다시 자라!"
 },
 {
  "key": "m75",
  "kind": 0,
  "chr": 6,
  "jh": "097a653a6eb9",
  "ko": "고후!"
 },
 {
  "key": "m76",
  "kind": 0,
  "chr": 8,
  "jh": "172c05bf56a3",
  "ko": "오오, 결정타를…"
 },
 {
  "key": "m77",
  "kind": 0,
  "chr": 9,
  "jh": "eafd6a7112b2",
  "ko": "좋은 각도로 들어갔군"
 },
 {
  "key": "m78",
  "kind": 0,
  "chr": 1,
  "jh": "019aa49c3fef",
  "ko": "아~ 정말! 이런 녀석 몰라! 이제 갈래!"
 },
 {
  "key": "m79",
  "kind": 0,
  "chr": 9,
  "jh": "2de591bf79eb",
  "ko": "페페론, 넌 정말…"
 },
 {
  "key": "m80",
  "kind": 0,
  "chr": 8,
  "jh": "8fba236c24fb",
  "ko": "뭐, 방금 건 차여도 할 말 없지…"
 },
 {
  "key": "m81",
  "kind": 0,
  "chr": 2,
  "jh": "7e7c80f1eaf9",
  "ko": "…재밌는 걸 봤으니까 개인적으로 요정 씨 평가가 급상승…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
