[
 {
  "key": "m0",
  "kind": 2,
  "chr": 7,
  "jh": "78861de7b92e",
  "ko": "푸니요네는 어떻게 생각해? 어떻게 하면 에나가 좋아해 줄까?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "f7b09292a9b0",
  "ko": "이 녀석들한테 묻는 건 인간으로서 어떨까 싶은데…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 5,
  "jh": "68159c57be62",
  "ko": "푸니! 푸니니!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 23,
  "jh": "e8b9986dec11",
  "ko": "실례다! 여자 마음도 모르는 남자가 무슨 소리냐! 라며 여동생이 격분하고 있어요"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 0,
  "jh": "626d24f7cdae",
  "ko": "아아, 미안하다 미안해…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 24,
  "jh": "cd5dff9dd1a2",
  "ko": "음~ 난 굳이 말하자면 말랑말랑한 여자가 좋은데"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 22,
  "jh": "9b92da28b428",
  "ko": "나도 그렇다. 네 몸은 너무 단단하다"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 7,
  "jh": "b8c26f1f85c0",
  "ko": "어, 그럼 살이 말랑말랑할 만큼 찌면 된다는 거야?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 23,
  "jh": "408dd0c43bbb",
  "ko": "아뇨, 그건 어디까지나 저희 푸니푸니 취향이니까요"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 7,
  "jh": "d7ef5210d71c",
  "ko": "다행이다~ 난 아무리 먹어도 살이 안 쪄서 어떡하나 했어"
 },
 {
  "key": "m10",
  "kind": 5,
  "chr": 3,
  "jh": "56e038501d44",
  "ko": "…칫"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "6fdb1d4ad117",
  "ko": "응, 어디서 혀 차는 소리가…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 5,
  "jh": "b09a3d001daf",
  "ko": "푸니. 푸니니니, 푸니!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 23,
  "jh": "f28415ecc95c",
  "ko": "결점을 극복하려는 건 좋지만, 단점만 없애면 개성 없는 인간이 된다"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 23,
  "jh": "ca3e5135ba31",
  "ko": "장점을 키우는 걸 생각하는 게 좋지 않겠나, 라며 여동생이 사견을 말하고 있어요"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 7,
  "jh": "fcb22bac55f3",
  "ko": "오오오, 뭔가 어려운 말을 들었다!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "69d7b8368f35",
  "ko": "…그거 정말 그 녀석이 말한 거야?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 23,
  "jh": "3822c370b96f",
  "ko": "당연하죠. 설마 제가 푸니요 입을 빌려 멋대로 의견을 말한다고?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 0,
  "jh": "8b5010d32625",
  "ko": "아니… 뭐, 어느 쪽이든 상관없지만"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 7,
  "jh": "7876443d5743",
  "ko": "장점, 내 장점… 음~… 아아! 그렇구나!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 7,
  "jh": "98dad7b91eba",
  "ko": "고마워, 푸니요! 나 왠지 알 것 같아!"
 },
 {
  "key": "m21",
