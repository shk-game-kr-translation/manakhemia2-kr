[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "d3ba92691ce2",
  "ko": "자, 앞으로의 구체적인 작전을 생각해야겠네"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 9,
  "jh": "9d479ae91225",
  "ko": "그 전에 잠깐 괜찮을까. 어떤 인물한테서 맡은 물건이 있어"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "be064713b286",
  "ko": "맡은 물건? …잠깐, 이게 뭐야?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 9,
  "jh": "9195e878827b",
  "ko": "원격식 음성 송수신 장치… 트랜시버라고 하는 모양이야"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 9,
  "jh": "c62f22ea1024",
  "ko": "무슨 일 있으면 이걸로 지시를 준대"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 6,
  "jh": "4811c7ae3346",
  "ko": "지시? 대체 누구한테 받았어?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 9,
  "jh": "980a77cf0451",
  "ko": "이름은 밝힐 수 없어. 일단 'G'라고 해 두지"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 2,
  "jh": "2197dae09287",
  "ko": "G… 나, 딱 한 명 엄청 짚이는 사람이 있어…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 8,
  "jh": "f672ff689bd1",
  "ko": "…우연이네, 나도야"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 1,
  "jh": "a5b31e7f3f6a",
  "ko": "와와, 울리기 시작했어! 여기 누르면 되나… 여보세요?"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 35,
  "jh": "e828f6042bf0",
  "ko": "아~ 테스트 테스트. 여기는 군나르. 들리나?"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 8,
  "jh": "8b2dfce4160c",
  "ko": "대뜸 밝히냐고!"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 1,
  "jh": "9d99937b7144",
  "ko": "어? 어? 군나르 선생님이에요?"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 35,
  "jh": "ee2418232c15",
  "ko": "음, 아차… 아니다! 이 몸은 결단코 군나르가 아니다!"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 51,
  "jh": "a3799284c906",
  "ko": "이 몸은… 그렇지. 미스터 X라고 불러 다오"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 2,
  "jh": "3b93ab3441f7",
  "ko": "탈인형 씨는 G라고 부르라던데…"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 52,
  "jh": "bae152f3e044",
  "ko": "뭐라, 센스 없는 네이밍을… 에잇, 알았다! 그럼 G로 하마!"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 8,
  "jh": "d658232c8e53",
  "ko": "엉망진창이네…"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 1,
  "jh": "244076b1aae4",
  "ko": "그래서, 일부러 이런 걸로 연락해서 무슨 볼일이에요?"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 52,
  "jh": "c2f9246a849b",
  "ko": "나쁜 소식이다. 학생 일부가 이사장 편에 서서 이쪽을 뭉개기 위한 자경단을 결성했다"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 52,
  "jh": "5409de7b772b",
  "ko": "그 중심에 있는 건 릴리아라는 여자의 아틀리에 멤버인 모양이다"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 1,
  "jh": "814a7fda93ab",
  "ko": "또 그 녀석들이야!? 정말, 맨날맨날 방해만 하고!"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 52,
  "jh": "9b769bdff689",
  "ko": "진정해라. 흥분하면 적의 생각대로다"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 1,
  "jh": "23e0e1f95466",
  "ko": "그, 그렇지… 그럼 이제 어떻게 하면 돼요?"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 52,
  "jh": "db4571ef21fb",
  "ko": "적이 대비하기 전에 움직일 필요가 있다… 우선 강당을 제압해라"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 52,
  "jh": "bc6ba7673eb9",
  "ko": "거기라면 상당수 인원이 대기할 수 있다. 앞으로의 거점으론 충분하겠지"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 1,
  "jh": "417999c8067e",
  "ko": "과연… 페페론! 다들 집합시켜! 강당을 제압하자!"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 6,
  "jh": "dfceee4b4949",
  "ko": "알겠습니다요! 선봉은 이 몸이 맡을게!"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 8,
  "jh": "6d6a1dbefaef",
  "ko": "…완전히 마음대로 조종당하고 있네"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 2,
  "jh": "d91249898609",
  "ko": "울리카만큼 조종하기 쉬운 애도 없으니까…"
 },
