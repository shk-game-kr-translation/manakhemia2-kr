[
 {
  "key": "m0",
  "kind": 2,
  "chr": 9,
  "jh": "e51f365cd314",
  "ko": "음~… 이건 곤란하군…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "7dfa6164593f",
  "ko": "왜 곤란해? 이사장 성격이 나쁘다는 얘기일 뿐이잖아. 그런 건 전부터였어"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 9,
  "jh": "576cffe43114",
  "ko": "…아가씨는 정말 이런 얘기엔 약하군"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 6,
  "jh": "3846eb64a300",
  "ko": "약하네, 누나는"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "4b4714ca5666",
  "ko": "뭐, 왜? 잠깐, 그렇게 불쌍하다는 눈으로 보지 마!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 2,
  "jh": "21e705562664",
  "ko": "즉, 이사장이 탈인형 씨한테 진심이 돼 버렸다는 거…?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 9,
  "jh": "c9b1446667ec",
  "ko": "아마도. 그리고 마루타와 여학생들 사이엔 알력이 생기기 시작했지…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 2,
  "jh": "7645a8e1eb62",
  "ko": "교사랑 학생은 그렇지 않아도 사이가 나쁜데… 연애 감정까지 끼면…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 6,
  "jh": "9491f22cbf8c",
  "ko": "오오이런. 슬쩍 문제 발언이네"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 8,
  "jh": "8134625024a4",
  "ko": "이사장이랑 학생이 싸우든 말든 우리랑은 상관없다… 고 할 수는 없겠지"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 9,
  "jh": "f6575c6bb6c9",
  "ko": "당연하지. 원인은 나고, 무엇보다 사랑하는 여자애들이 다투는 모습은 보고 싶지 않아"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 6,
  "jh": "fe849dea09c6",
  "ko": "그래도 지금까진 괜찮았는데 왜 갑자기 이렇게 된 걸까?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 9,
  "jh": "657dd45ed6bc",
  "ko": "마루타는 늘 한발 물러선 입장에서 참아 줬어. 내가 거기에 너무 기댔던 거야"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 9,
  "jh": "72e46c078dfe",
  "ko": "그녀는 그녀 나름대로 상처받았을 텐데…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "ca72a671200d",
  "ko": "저기~ 미안. 전혀 얘기를 못 따라가겠는데…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 2,
  "jh": "fb3252469c00",
  "ko": "울리카한텐 아직 이를지도…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 8,
  "jh": "abbde607fba7",
  "ko": "연인이라도 하나 생기면 또 다르겠지만"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "72247cfe2cda",
  "ko": "으… 왠지 엄청 무시당한 기분…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 9,
  "jh": "acebcb6b3275",
  "ko": "하지만 곤란하군. 어떻게 하면 원만히 수습될지 전혀 짐작이 안 가"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 2,
  "jh": "48b283e695d2",
  "ko": "…이사장이 포기해 주면 만사 해결이야"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 9,
  "jh": "957eae1ae9ec",
  "ko": "그건 그렇지만… 그녀의 마음은 어떻게 되지?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "b6caa3a1aa37",
  "ko": "다수와 한 사람… 양쪽을 행복하게 할 수 없다면 어느 쪽을 자를지는 자명한 이치…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 9,
  "jh": "8e5bb2cb0c2c",
  "ko": "이론상으론 그럴지도 몰라. 하지만 사람 감정을 이론으로 헤아린다는 건…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "7cdc28a77b57",
  "ko": "…탈인형 씨한텐 양쪽을 만족시킬 능력은 없잖아…?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 9,
  "jh": "5e0ce1ddadfc",
  "ko": "크윽! 아픈 데를… 하, 하지만…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "f634dc5ab59e",
  "ko": "설령 이번엔 얼버무린다 해도 언젠가 또 같은 일이 일어나…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 6,
  "jh": "dfe5fba1dceb",
  "ko": "대단해… 그가 저렇게 밀리는 거 처음 봤어…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 8,
  "jh": "8674bf1cf533",
  "ko": "오늘 검은 누나, 한층 무섭네…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "afd404c723e9",
  "ko": "아니야. 무서운 게 아니야. …저건 즐기고 있는 거야. 진심으로…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 9,
  "jh": "df74a57a3b4c",
  "ko": "으으으… 알았어. 확실히 네 말이 맞아…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 9,
  "jh": "2e5ff7e06391",
  "ko": "하지만 마루타를 포기시킨다 해도 구체적으로 어떻게 하면…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 9,
  "jh": "26a042cc1579",
  "ko": "여자를 꼬신 적은 수백 번 있지만 찬 적은 한 번도 없고…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 2,
  "jh": "8296c6514196",
  "ko": "…사실 직접 말하는 게 제일 빠르겠지만…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 9,
  "jh": "0848acdc1020",
  "ko": "그건 봐줬으면 해. 여성을 차다니 악마 같은 소행, 나한텐…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "59ee0136940e",
  "ko": "그럼 이런 건? 적당한 여자애랑 이사장 앞에서 대놓고 꽁냥대는 거야"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 9,
  "jh": "e09206e5028d",
  "ko": "또 낡은 수단을 생각해 내는군"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 8,
  "jh": "de8821304248",
  "ko": "그 정도론 무리지… 그렇지 않아도 바람둥이로 통하는데"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 6,
  "jh": "1a2bffd094f8",
  "ko": "누나는 정~말 안 되네"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 1,
  "jh": "ca689edeccb6",
  "ko": "뭐, 뭐야! 모처럼 아이디어 내 줬는데!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 2,
  "jh": "f8d608e9a16e",
  "ko": "아니… 착안점은 나쁘지 않아… 그래도 한 번 더 비틀었으면…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 9,
  "jh": "42ecf2967704",
  "ko": "한 번 더 비틀기?"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 2,
  "jh": "96aa370c228b",
  "ko": "응… 이렇게 하면 될 것 같아…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]