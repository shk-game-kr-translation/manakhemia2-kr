 {
  "key": "m26",
  "kind": 2,
  "chr": 23,
  "jh": "01c91713efb2",
  "ko": "릴리아 씨 병문안을 가라고… 그 외의 요구는 없다고 여동생이 말해요"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "e3c0ddfa0662",
  "ko": "…알았어. 가면 되잖아, 가면. 그 대신 방금 얘기는…"
