 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 5,
  "jh": "87156a1f9715",
  "ko": "푸니푸니… 소곤소곤…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 23,
  "jh": "c2991d521b33",
  "ko": "그러니까, 여동생은… 수군수군… 쑥덕쑥덕… 이라고 해요"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "93cb22f13fb8",
  "ko": "…뭣!? 너, 어디서 본 거야!?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 5,
  "jh": "9dada0d47b9c",
