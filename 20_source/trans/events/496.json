 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 23,
  "jh": "f7105e8bfc52",
  "ko": "당연히 푸니요의 가슴속에 묻어 두겠다, 래요"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 23,
  "jh": "8ee57e31c55b",
