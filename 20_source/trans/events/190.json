[
 {
  "key": "m0",
  "kind": 2,
  "chr": 20,
  "jh": "b84421117912",
  "ko": "자, 여기다"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "1d96efa0a57f",
  "ko": "어? 여기는… 아틀리에?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 20,
  "jh": "5578707548a2",
  "ko": "그래, 아틀리에다. 당분간 여길 써라"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 2,
  "jh": "f899fec298b3",
  "ko": "뭐야… 호출인 줄 알고 기대했는데…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "3d5843c4553e",
  "ko": "이상한 거 기대하지 마. 있잖아, 여기 우리가 마음대로 써도 돼?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 20,
  "jh": "3d5df428e079",
  "ko": "당분간은. 언제까지나 둘이서만 쓸 만큼 숫자에 여유가 없으니까"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 20,
  "jh": "814f4d2a7d16",
  "ko": "언젠간 다른 녀석들이랑 공동으로 쓰게 될 거다"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 20,
  "jh": "ffdb1bb7c51c",
  "ko": "일단 사용법을 설명할 테니 잘 들어 둬라"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 20,
  "jh": "b553a6050907",
  "ko": "이 정도다. 나머진 쓰다 보면 익히겠지. 그럼"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "6114d5575cb9",
  "ko": "앗, 잠깐만요! 선생님한테 물어볼 게"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 20,
  "jh": "a79bd23d7cfc",
  "ko": "다음에 해라. 다른 녀석들도 아틀리에에 데려가야 한다고!"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 1,
  "jh": "f89720cb672d",
  "ko": "아, 잠깐… 가 버렸다"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 2,
  "jh": "677d3c1aba1f",
  "ko": "지금은 일단 과제 생각하자…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "07a7fd62368e",
  "ko": "과제 같은 건 별거 아니잖아. 재료 캐 와서 섞기만 하면 되고"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "caf0000524d4",
  "ko": "하지만 학원 밖엔 몬스터 같은 것도 나오고…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "2b9dff1fd171",
  "ko": "괜찮다니까. 나한텐 이 돌이 있고. 클로에는 저주 같은 거 쓸 수 있잖아"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 2,
  "jh": "f1e520483ed9",
  "ko": "저주가 아니라 주술…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "3e85bf9299e0",
  "ko": "어느 쪽이든 똑같잖아. 아무튼 빨리 끝내자"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 2,
  "jh": "1d8b343ede4d",
  "ko": "역시 불안해…"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 2,
  "jh": "f09077fe53e8",
  "ko": "아… 마침 잘됐다…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 1,
  "jh": "b0644f546518",
  "ko": "어? 클로에?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "d85fedb5d845",
  "ko": "저기…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 3,
  "jh": "ee5d5d066f3c",
  "ko": "응? 나한테 뭔가 볼일이라도?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "4af90261e73f",
  "ko": "…괜찮으면 같이 과제 하지 않을래…?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "b04349213ee2",
  "ko": "클로에! 무슨 멋대로…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "f751beb1d612",
  "ko": "너희가? 나랑? …사양할게"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 2,
  "jh": "81aa1ed6b97d",
  "ko": "그래…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 3,
  "jh": "72351984e695",
  "ko": "선약이 있고… 게다가 별로 교양 없는 분들과는 어울리고 싶지 않거든"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "61136c77da3d",
  "ko": "누, 누가 교양이 없다는 거야!?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 3,
  "jh": "53103cf5bac5",
  "ko": "어머, 들렸니. 미안해, 차림새가 너무 촌스러워서 그만"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "030e3a19737d",
  "ko": "뭐… 잠깐 너!"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 1,
  "jh": "4b7e517c2ef7",
  "ko": "뭐야… 뭐야 저거!?"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 2,
  "jh": "9e7049d4972c",
  "ko": "아~아… 울리카 때문에 차였어"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 1,
  "jh": "f8765fb3ebf5",
  "ko": "내 탓이 아니잖아! 누가 봐도!"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 2,
  "jh": "c15df4f543bf",
  "ko": "어쩔 수 없으니까 둘이서 갈 수밖에… 엄청 불안하지만"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 1,
  "jh": "5bdfc3cb21f0",
  "ko": "한마디가 많아, 넌!"
 },
 {
  "key": "m36",
  "kind": 5,
  "chr": -1,
  "jh": "9a0480b2cb5d",
  "ko": "이곳이 울리카 일행의 활동 거점이 될 아틀리에입니다."
 },
 {
  "key": "m37",
  "kind": 5,
  "chr": -1,
  "jh": "95dc75d45cd7",
  "ko": "아틀리에에서는 데이터 {CLRE}세이브・로드{CLNR}와 {CLRE}조합{CLNR}이 가능합니다."
 },
 {
  "key": "m38",
  "kind": 5,
  "chr": -1,
  "jh": "a8d8c2ca8813",
  "ko": "액세스 포인트를 확인하시겠습니까?"
 },
 {
  "key": "m39",
  "kind": 5,
  "chr": -1,
  "jh": "50169268a93b",
  "ko": "이곳에 액세스하면 데이터 {CLRE}세이브・로드{CLNR}가,"
 },
 {
  "key": "m40",
  "kind": 5,
  "chr": -1,
  "jh": "9cfb33024f26",
  "ko": "이곳에 액세스하면 {CLRE}조합{CLNR}을 할 수 있습니다."
 },
 {
  "key": "m41",
  "kind": 5,
  "chr": -1,
  "jh": "c4286cbb932f",
  "ko": "스토리가 진행되면 다른 기능도 추가됩니다."
 },
 {
  "key": "m42",
  "kind": 5,
  "chr": -1,
  "jh": "1318d915676a",
  "ko": "또한 지금은 재료와 레시피가 없어서 조합할 수 없습니다."
 },
 {
  "key": "m43",
  "kind": 5,
  "chr": -1,
  "jh": "954f8a8d5785",
  "ko": "과제를 달성하기 위해 「{CLRE}배움의 다리{CLNR}」에 가서 재료를 모읍시다."
 },
 {
  "key": "m44",
  "kind": 5,
  "chr": -1,
  "jh": "7248318f9ac5",
  "ko": "「{CLRE}배움의 다리{CLNR}」에는 학원 맵의 「{CLRE}학원 밖{CLNR}」에서 갈 수 있습니다."
 },
 {
  "key": "m45",
  "kind": 5,
  "chr": -1,
  "jh": "0bcf2d28df6c",
  "ko": "「{CLRE}도움말{CLNR}」의 「{CLRE}기타{CLNR}」에 새로운 항목이 추가되었습니다."
 },
 {
  "key": "m46",
  "kind": 5,
  "chr": -1,
  "jh": "79da7c8bf517",
  "ko": "「{CLRE}도움말{CLNR}」은 메뉴의 「{CLRE}도감{CLNR}」에서 확인할 수 있습니다."
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
