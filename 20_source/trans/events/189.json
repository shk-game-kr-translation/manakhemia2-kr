[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "da35e2e2dbd3",
  "ko": "아~ 기분 나빠! 입학하자마자 그런 녀석을 만나다니!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "32e6c043e57a",
  "ko": "그러니까 이런 학교 안 왔으면 좋았잖아…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "19a10c0c8646",
  "ko": "너도 적당히 좀 해, 끈질기게!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 2,
  "jh": "58da210a5d2b",
  "ko": "화풀이하지 말아 줬으면 좋겠어…"
 },
 {
  "key": "m4",
  "kind": 5,
  "chr": 20,
  "jh": "6df1b64eae05",
  "ko": "시끄럽다! 조용히 해!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "54ab8681a627",
  "ko": "으악!? 아까 그 선생님!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 2,
  "jh": "7c3a09714e48",
  "ko": "우리 담임이었구나…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 20,
  "jh": "fccf6cb3a750",
  "ko": "정말이지, 어느 놈이고 입학하자마자 들떠서는…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 20,
  "jh": "330a90bc95fc",
  "ko": "뭐 됐다. 난 토니. 앞으로 1년 동안 너희를 빡세게 굴려서… 가 아니라"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 20,
  "jh": "9eaa93880e7e",
  "ko": "교육해 줄 테니 각오해 둬라"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 89,
  "jh": "63eb5da239d8",
  "ko": "저기, 선생님"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 20,
  "jh": "3ce8aebf7edc",
  "ko": "응? 뭐냐"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 89,
  "jh": "0a5d7a564ed2",
  "ko": "입학식에서 교감 선생님이랑, 그, 싸우셨던데…"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 20,
  "jh": "238d8ca34c7c",
  "ko": "아아… 꼴사나운 모습을 보였군. 그 녀석이랑은 옛날부터 이래저래 있어서…"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 20,
  "jh": "186100851632",
  "ko": "젠장! 생각하니까 또 열 받네. 잘 들어라, 너희!"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 20,
  "jh": "28777f8c3920",
  "ko": "군나르네 반 녀석들한테 성적이든 뭐든 지기라도 해 봐라"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 20,
  "jh": "0b9abfe59448",
  "ko": "졸업하기 전에 당장 학원에서 쫓아내 줄 테니까!"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 96,
  "jh": "e3b7a33d8b28",
  "ko": "쫓아낸다니, 진짜냐…"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 87,
  "jh": "59093622af5d",
  "ko": "괜찮은 거야? 이 선생님…"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 20,
  "jh": "5f19bd33b73b",
  "ko": "그런 거니까 내 인사는 이상이다"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 20,
  "jh": "4ee3187d576a",
  "ko": "그럼 바로 수업을 시작…"
 },
 {
  "key": "m21",
  "kind": 5,
  "chr": 18,
  "jh": "ca11101fedf2",
  "ko": "실례할게요"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 20,
  "jh": "b43098dead42",
  "ko": "…무슨 일입니까. 수업 중인데요"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 18,
  "jh": "4d9faf7e7ee2",
  "ko": "신입생을 안내해 왔을 뿐이에요. 금방 끝나요"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 18,
  "jh": "023488d15b68",
  "ko": "어떤가요, 릴리아 양? 제가 말하긴 뭣하지만 형편없는 교실이죠?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "9ff04861989d",
  "ko": "…빈말로도 훌륭한 교실이라곤 할 수 없겠네요"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 3,
  "jh": "3f0fb3ee85e2",
  "ko": "알겠어요. 자금 원조에 대해서는 제가 아버님께 전해 둘게요"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 18,
  "jh": "f73ee4e4f62e",
  "ko": "어머어머! 정말 도움이 돼요!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 18,
  "jh": "b55466006d1d",
  "ko": "학원 예산만으로는 아무래도 한계가 있어서요"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 18,
  "jh": "64a2f3aceb48",
  "ko": "당신 같은 학생이 입학해 줘서 정말 기뻐요"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "19829b44f738",
  "ko": "천만에요… 그럼 전 수업이 있어서"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 18,
  "jh": "90f36918b141",
  "ko": "네. 그럼 저도 이만 실례할게요"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 18,
  "jh": "f80ba30b22f6",
  "ko": "토니 선생, 아무쪼록 그녀에게 실례가 없도록"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 18,
  "jh": "d2e13e77ae02",
  "ko": "(저 애한테서 원조금을 뜯어내고 연금술과를 없애면 그야말로 일석이조)"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 18,
  "jh": "486e98bf126e",
  "ko": "(세상 물정 모르는 아가씨. 넌 어차피 돈줄에 불과해… 우후후…)"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 18,
  "jh": "5ae7810f4338",
  "ko": "오~호호호!"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 3,
  "jh": "21a963d5e223",
  "ko": "갑자기 웃기 시작하다니… 별난 사람이네"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 11,
  "jh": "d888489b4668",
  "ko": "너무 신경 쓰지 않으시는 게 좋아요. 자, 이쪽으로"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 3,
  "jh": "3744c8d264d0",
  "ko": "응, 수고했어"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "781abcac7e1a",
  "ko": "우와… 저거 메이드? 처음 봤어"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 2,
  "jh": "51c2fbb4544e",
  "ko": "나도… 나이 든 가정부 아줌마라면 우리 집에도 있었지만…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 1,
  "jh": "537be672f69c",
  "ko": "진짜 부자라는 느낌이네… 좋아, 정했어. 저 녀석은 지금부터 우리의 적이야!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 2,
  "jh": "0f6c67ccf9f3",
  "ko": "멋대로 '우리'로 묶지 마…"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 20,
  "jh": "fa5641af4bc6",
  "ko": "아~… 완전히 말허리가 잘렸지만 마음 다잡고 수업 시작한다"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 20,
  "jh": "2de42abcca2a",
  "ko": "자, 이 정도인가. 다음은… 야, 울리카!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 1,
  "jh": "8d595b9037b9",
  "ko": "응? 나?"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 20,
  "jh": "9b8fd908d42a",
  "ko": "그래, 우선 너부터다. 따라와라"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 1,
  "jh": "ad787b689880",
  "ko": "따라오라고 해도… 어, 어떡하지?"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 2,
  "jh": "d6503246d742",
  "ko": "입학 첫날부터 호출이라니… 끝났네. 여러 의미로…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 1,
  "jh": "563a733870e1",
  "ko": "그, 그런! 저기, 클로에도 같이 가 줘! 부탁이야!"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 2,
  "jh": "b40e91e2887d",
  "ko": "에~… 뭐, 됐어. 울리카가 괴롭힘당하는 거 볼 수 있을지도 모르고…"
 },
 {
  "key": "m51",
  "kind": 5,
  "chr": -1,
  "jh": "175ebad13f5a",
  "ko": "이 게임은 학원 수업인 「{CLRE}과제{CLNR}」를 해내는 것으로 진행됩니다."
 },
 {
  "key": "m52",
  "kind": 5,
  "chr": -1,
  "jh": "3422f2f1dfc7",
  "ko": "과제에 대한 도움말을 보시겠습니까?"
 },
 {
  "key": "m53",
  "kind": 5,
  "chr": -1,
  "jh": "959dd8afe2ba",
  "ko": "「{CLRE}과제{CLNR}」의 내용은 게임의 다양한 요소가 주제가 됩니다."
 },
 {
  "key": "m54",
  "kind": 5,
  "chr": -1,
  "jh": "b165bd43fd8f",
  "ko": "이번 과제는 아이템 「{CLG1}리퓨얼 포트{CLNR}」의 조합입니다."
 },
 {
  "key": "m55",
  "kind": 5,
  "chr": -1,
  "jh": "5b414ddbab45",
  "ko": "과제 내용과 목적지는 과제를 받았을 때 이런 형태로 표시됩니다."
 },
 {
  "key": "m56",
  "kind": 5,
  "chr": -1,
  "jh": "936d439464f6",
  "ko": "이번 내용은 「{CLRE}배움의 다리{CLNR}」에 가서 리퓨얼 포트의 재료인"
 },
 {
  "key": "m57",
  "kind": 5,
  "chr": -1,
  "jh": "a6ec243f9c0f",
  "ko": "「{CLG1}무언가의 나무뿌리{CLNR}」「{CLG1}생수{CLNR}」「{CLG1}톤{CLNR}」을 모으는 것이 목적입니다."
 },
 {
  "key": "m58",
  "kind": 5,
  "chr": -1,
  "jh": "7123fee314b5",
  "ko": "또, 과제에 따라서는 지급품이 배부되는 경우가 있습니다."
 },
 {
  "key": "m59",
  "kind": 5,
  "chr": -1,
  "jh": "c1702249d171",
  "ko": "과제를 달성하기 위해 유용하게 활용하세요."
 },
 {
  "key": "m60",
  "kind": 5,
  "chr": -1,
  "jh": "ab92e3df0bbc",
  "ko": "「{CLRE}도움말{CLNR}」의 「{CLRE}퀘스트{CLNR}」에 새로운 항목이 추가되었습니다."
 },
 {
  "key": "m61",
  "kind": 5,
  "chr": -1,
  "jh": "79da7c8bf517",
  "ko": "「{CLRE}도움말{CLNR}」은 메뉴의 「{CLRE}도감{CLNR}」에서 확인할 수 있습니다."
 },
 {
  "key": "g0s0",
