[
 {
  "key": "m0",
  "kind": 5,
  "chr": 1,
  "jh": "8bea37a11df6",
  "ko": "겨우 도착했다~! 여기 재료를 캐 가면 되는 거지?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "edb8fd2e2cfb",
  "ko": "…윽! 재수 없는 남자랑 재수 없는 여자!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "30311029ba35",
  "ko": "음… 뭐니, 너? 남의 얼굴을 보자마자 대뜸 재수 없는 여자라니…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 11,
  "jh": "3e10e017e52c",
  "ko": "아가씨 반 친구분이에요. 아까 교실에서 만났잖아요"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "d16ffbd404f5",
  "ko": "…아아. 그러고 보니 본 것 같기도 하네"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 3,
  "jh": "9526f15054f1",
  "ko": "촌스러운 차림을 하고 있어서 왠지 기억나"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "b2066c6f8fe6",
  "ko": "누, 누가 촌스럽다는 거야! 실례야!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 2,
  "jh": "be7c2f6e96f3",
  "ko": "…실례인 건 피차일반"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "e90395881980",
  "ko": "정했어! 너, 지금부터 거만녀라고 부를 거야!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 3,
  "jh": "2d34319bceec",
  "ko": "뭐, 뭐라고!? 시골뜨기 주제에!!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 0,
  "jh": "22e46c80e567",
  "ko": "…그래서 뭐야? 일부러 방해하러 온 거냐?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "b8db848193eb",
  "ko": "아니거든! 수업에 쓸 재료를 캐러 왔을 뿐이야!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "5910965dd87f",
  "ko": "그럼 얼른 캐서 돌아가면…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "9ef9ca7d83f1",
  "ko": "…라고 생각했는데, 네 얼굴 보니까 마음이 바뀌었어"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "06651cd5115a",
  "ko": "방해해 줄 거야 방해해 줄 거야~!"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 3,
  "jh": "e20e53898937",
  "ko": "그, 그만둬! 재료가 전부 못 쓰게…"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 7,
  "jh": "d79b4547257e",
  "ko": "우와~ 재밌겠다! 나도 끼워 줘~!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "09fe90cccd01",
  "ko": "너까지 같이 뭐 하는 거니!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "d4bfeb4b005e",
  "ko": "하아, 하아… 후훗훗. 어때? 항복이야?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "a6600a23714d",
  "ko": "…즐거워 보여서 좋겠다, 넌"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "c3ec2e7761ec",
  "ko": "크아~! 뭐야! 그 시큰둥한 반응은!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "029e2dabad2c",
  "ko": "자, 돌아가죠. 필요한 재료는 다 캤으니까요"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 3,
  "jh": "b782d7a3e414",
  "ko": "그래. 이런 시골뜨기한테 일일이 어울려 줄 수 없지"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 7,
  "jh": "48e96575898d",
  "ko": "에~ 벌써 가? 아직 덜 놀았는데~"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "d698cf18c0c6",
  "ko": "잠깐~! 좀 더 분해하란 말이야!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "a1c905c262e9",
  "ko": "…저기. 우리도 재료 캐러 온 거지…?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "01e4e59c9a76",
  "ko": "앗, 그랬지… 잠깐, 으악! 엉망진창이잖아!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 2,
  "jh": "ea55a96c7325",
  "ko": "…울리카가 한 거지만"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "406da4b4142e",
  "ko": "그 녀석들~! 이런 짓까지 하다니, 용서 못 해!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 2,
