  "kind": 2,
  "chr": 0,
  "jh": "486ccd7ed5eb",
  "ko": "그런 녀석일수록 믿을 수가 없다고…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 7,
  "jh": "0fbeed6f7638",
