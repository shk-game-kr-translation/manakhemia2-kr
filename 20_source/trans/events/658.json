[
 {
  "key": "m0",
  "kind": 2,
  "chr": 2,
  "jh": "871214712cc7",
  "ko": "…그래서 도망쳐 왔구나"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "d8cffc1eb383",
  "ko": "응… 아~ 오랜만에 힘껏 달렸어"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 6,
  "jh": "3e867b077e37",
  "ko": "누나는 켕기는 거라도 있어?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "8ba81d4395ce",
  "ko": "딱히 없지만 경찰이라고 들으면 왠지 도망치고 싶어지지 않아?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 2,
  "jh": "980e8f7cb681",
  "ko": "털면 먼지 나는 몸이니까…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "e1c7120e5704",
  "ko": "먼지 같은 거 안 나거든!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 8,
  "jh": "51af627dd797",
  "ko": "실은 나도 말 걸렸어. 아마 같은 녀석일 거야"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "5f470a4092e1",
  "ko": "어, 그래?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 2,
  "jh": "b5d2bb0cb3f6",
  "ko": "나도 이것저것 질문받았어…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "2c40aed47b5c",
  "ko": "이 몸은 다짜고짜 수상한 사람 취급이었어…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 9,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "f7403bfac2bf",
  "ko": "그래서 뭐라고 했어? 난 자세히 안 듣고 와서"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 8,
  "jh": "36dcb80aa22f",
  "ko": "몇 달 전부터 이 학원에 지명수배범이 잠입해 있대"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "97776320a419",
  "ko": "마치 짐승 같은 남자로, 교묘한 말로 여성을 속인다던가…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "4b1253b54d9a",
  "ko": "그런 녀석이 이 학원에… 흉흉한 얘기네"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 8,
  "jh": "6f9042249b92",
  "ko": "뭐, 뭔가 잘못된 거겠지. 그런 녀석 본 적도 들은 적도 없어"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 9,
  "jh": "dd041e13338e",
  "ko": "아니, 그 정보는 확실해… 그 사람은 날 찾으러 온 거야"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 6,
  "jh": "38cb4dddcc04",
  "ko": "역시 그렇구나… 얘기 들은 순간 딱 감이 왔어"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "28b8381898aa",
  "ko": "어? 그래도 짐승 같은 모습을 한 여자 속이는 남자라고… 아"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 2,
  "jh": "7fcf7c25c8ad",
  "ko": "듣고 보니 딱 맞아…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "304044912f29",
  "ko": "그, 그래도 쫓기는 건 지명수배범이잖아? 설마 너…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 9,
  "jh": "290b7fbc22de",
  "ko": "이야. 젊을 땐 이래저래 장난을 쳤으니까"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "1e7b3e6ea6ec",
  "ko": "자, 농담하지 마! 그럼 우리 범죄자의 동료라는 거야?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 9,
  "jh": "28cd5744131e",
  "ko": "대부분은 시효가 지났지만"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 6,
  "jh": "19188f70545f",
  "ko": "그는 잡힐 위험을 무릅쓰고 우릴 돕기 위해 일부러 와 준 거야"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "9312694843c4",
  "ko": "뭐… 범죄는 잡히기 전까진 범죄가 아니고…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "63199b994b56",
  "ko": "음, 그렇게 말하니…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 8,
  "jh": "b7e2b19a68ff",
  "ko": "아니, 거기서 납득하면 안 되지"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 6,
  "jh": "c5f1bd549db3",
  "ko": "즉, 그 경찰이 이대로 돌아가 주면 문제없다는 거네"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "b244334a45da",
  "ko": "그럼 어떻게든 그 사람이 돌아가게 할 방법을 생각해 볼까"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 9,
  "jh": "3797d3c0e88b",
  "ko": "후후후. 이럴 때를 대비해 이미 작전을 세워 뒀지"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "245a89075d77",
  "ko": "준비성 좋네. 어떤 작전?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 8,
  "jh": "dfb825607c15",
  "ko": "있잖아, 정말 괜찮냐? 이거 우리도 공범이 되는 거 아냐…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 2,
  "jh": "e7d7d34dd87f",
  "ko": "…여차하면 저쪽에 넘겨 버리면 돼…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 8,
  "jh": "f8f627c41535",
  "ko": "…누나, 정말 검구나"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 9,
  "jh": "f61d0b1908a0",
  "ko": "자, 너희도. 작전 설명할 테니까 잘 들어"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
