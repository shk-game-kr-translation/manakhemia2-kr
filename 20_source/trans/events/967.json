 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 13,
  "jh": "9bd585ab05e1",
  "ko": "다들 수고했어! 그럼 기다리던 시상식으로 넘어가겠습니다!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 13,
  "jh": "a5e015010df0",
