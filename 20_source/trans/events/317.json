[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "5df7a2ba653a",
  "ko": "이 소리… 벌써 시작한 모양이네"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 6,
  "jh": "317a828c692b",
  "ko": "응. 이 몸들도 서둘러야지!"
 },
 {
  "key": "m2",
  "kind": 5,
  "chr": 96,
  "jh": "e461f8791840",
  "ko": "젠장, 뭐야 이 녀석… 세…"
 },
 {
  "key": "m3",
  "kind": 5,
  "chr": 98,
  "jh": "de16ec5a51fe",
  "ko": "이쪽에 부상자 발생! 일시 후퇴한다!"
 },
 {
  "key": "m4",
  "kind": 5,
  "chr": 81,
  "jh": "c139ad48578f",
  "ko": "오른쪽 수비가 약해! 손 빈 사람, 도와줘!"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 1,
  "jh": "c173e23d6145",
  "ko": "저 녀석이구나. 크다… 좋~아, 그럼"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 2,
  "jh": "646779912d3b",
  "ko": "…잠시 상황을 보다가 다른 학생들이 약하게 만들면 맛있는 부분만 챙기는 거구나"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 1,
  "jh": "96331df7cfe3",
  "ko": "그런 쩨쩨한 짓 안 해! 자, 가자!"
 },
 {
  "key": "m8",
  "kind": 5,
  "chr": 95,
  "jh": "1c6bb75159fa",
  "ko": "으아아아! 안 돼, 방어선이 뚫렸다!"
 },
 {
  "key": "m9",
  "kind": 5,
  "chr": 106,
  "jh": "8f0f23188968",
  "ko": "막아! 목숨 걸고 막는 거야!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "7b435991a640",
  "ko": "왠지 전혀 안 먹히는 것 같은데…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 9,
  "jh": "1b3b3f8b490f",
  "ko": "이런 생물 병기까지 만들어 내다니 속을 알 수 없는 사람이군"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 6,
  "jh": "4e4f3aee42ae",
  "ko": "응. 게다가 이 녀석이 마지막일 것 같지 않아. 언젠가 제2, 제3의…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "a21b8177b647",
  "ko": "바보 같은 소리 하지 말고 아무튼 쫓아가자!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "b8f558a2aef3",
  "ko": "쫓아가도 어쩔 도리가 없을 것 같은데…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 8,
  "jh": "125c99e30813",
  "ko": "무작정 돌진하는 것보다 뭔가 방법을 생각하는 게 낫지 않냐?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 9,
  "jh": "77e52bc2cd7c",
  "ko": "도움이 될지는 모르겠지만 하나 알아챈 게 있어"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "104a11ddb8f7",
  "ko": "어? 뭔데 뭔데?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 9,
  "jh": "f8eb5b1b5d9c",
  "ko": "저 몬스터는 수컷이야. 내 매력을 못 알아보니까"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "ff6691f7833e",
  "ko": "…기대한 내가 바보였어. 에잇, 이렇게 된 이상 부딪쳐서 깨져 보자!"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 1,
  "jh": "98fdfc0a7426",
  "ko": "아"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "0e8867554699",
  "ko": "어머… 누가 몬스터를 놓쳤나 했더니 너희였구나"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "0faf0f829a44",
  "ko": "따, 딱히 우리만의 탓은 아니야!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 7,
  "jh": "f1ba49425e64",
  "ko": "맞아, 릴리아. 우리도 전혀 못 당했잖아"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 3,
  "jh": "ccb061571829",
  "ko": "쓸데없는 말 하지 마!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "47dc90920b6c",
  "ko": "…이 녀석은 상대하지 말고 빨리 쫓아가죠"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 4,
  "jh": "a6fd46d9390c",
  "ko": "기다려라. 여기선 차라리 협력하는 게 상책 아닌가?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 7,
  "jh": "5ed2f7d5b16e",
  "ko": "오~ 명안이다!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 9,
  "jh": "d29be9b0a886",
  "ko": "확실히 우리와 너희가 손잡으면 백인력이지"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "5174b88b2560",
  "ko": "이 몸은 요정 씨라 도와 달라고 하면 쉽게 거절 못 하지"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 8,
  "jh": "e5d6e4ce6880",
  "ko": "멋대로 얘기 진행하지 마! 난 싫어, 바보 누나랑 짜는 거"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "0e94def8e373",
  "ko": "그래 그래! 비아냥남이나 거만녀랑 짜는 건 사양이야!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 3,
  "jh": "d643c98e6fee",
  "ko": "윤, 이상한 소리 하지 마. 협력 같은 걸 할 수 있을 리가 없잖아"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 4,
  "jh": "68b3450a1a9d",
  "ko": "하지만 교내엔 부모도 남아 있는 거 아닌가?"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 3,
  "jh": "6d4a9bcea0e2",
  "ko": "으, 그건…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "72694d74453e",
  "ko": "우리 부모님은 안 왔으니까 딱히 상관없어"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 2,
  "jh": "ee36c5782d6e",
  "ko": "울리카는 친구 부모가 죽어도 눈썹 하나 까딱 안 하는 사람이니까…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 0,
  "jh": "090db17344b3",
  "ko": "지독한 여자로군…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 6,
  "jh": "3ea9b663c36b",
  "ko": "인간으로서 실격이네"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "b247eae6ebd0",
  "ko": "듣기 안 좋은 소리 하지 마! …알았어. 이번만 협력해 줄게"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 3,
  "jh": "be1e1302cd62",
  "ko": "그건 내가 할 소리야. 부디 내 발목은 잡지 말도록"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 3,
  "jh": "b842f870753b",
  "ko": "자, 그럼… 너희는 앞으로 내 지휘하에 움직이도록 해"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 1,
  "jh": "a2b88a50ea87",
  "ko": "왜 그렇게 되는 건데! 협력만 하는 거잖아!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 3,
  "jh": "2b7dec545f53",
  "ko": "내 말대로 움직이는 게 안전하고 확실하잖아. 불평하지 말고 따라"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 1,
  "jh": "24450f92bcc5",
  "ko": "싫어! 절대 싫어!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 8,
  "jh": "36f1d29a7ea3",
  "ko": "…앞날이 험난하군"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 4,
  "jh": "d95bd373fbb1",
  "ko": "묘안이라고 생각했다만…"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 11,
  "jh": "da2ab70b6cc7",
  "ko": "로제 씨, 멍하니 있지 말고 두 분 좀 말려 주세요!"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 0,
  "jh": "bd45c5129750",
  "ko": "아, 아아…"
 },
 {
  "key": "m50",
  "kind": 5,
  "chr": -1,
  "jh": "87a4894a90b2",
  "ko": "거대 몬스터를 쓰러뜨릴 때까지 로제 일행과 협력하게 되었습니다!"
 },
 {
  "key": "m51",
  "kind": 5,
  "chr": -1,
  "jh": "793c9d6ece02",
  "ko": "로제 파티에서 한 명만 게스트 캐릭터로 파티에 참가할 수 있습니다."
 },
 {
  "key": "m52",
  "kind": 5,
  "chr": -1,
  "jh": "4064a7734066",
  "ko": "참가시킬 캐릭터를 한 명 선택하세요."
 },
 {
  "key": "m53",
  "kind": 5,
  "chr": -1,
  "jh": "43a7b1daae59",
  "ko": "이후 이 맵으로 돌아오면 참가 캐릭터를 변경할 수 있으니 기억해 두세요."
 },
 {
  "key": "m54",
  "kind": 5,
  "chr": -1,
  "jh": "68919a0a0870",
  "ko": "「{CLRE}로제{CLNR}」가 동료가 되었습니다."
 },
 {
  "key": "m55",
  "kind": 5,
  "chr": -1,
  "jh": "d0cac34049c4",
  "ko": "「{CLRE}릴리아{CLNR}」가 동료가 되었습니다."
 },
 {
  "key": "m56",
  "kind": 5,
  "chr": -1,
  "jh": "d362711cca07",
  "ko": "「{CLRE}윤{CLNR}」이 동료가 되었습니다."
 },
 {
  "key": "m57",
  "kind": 5,
  "chr": -1,
  "jh": "799604aface7",
  "ko": "「{CLRE}푸니요{CLNR}」가 동료가 되었습니다."
 },
 {
