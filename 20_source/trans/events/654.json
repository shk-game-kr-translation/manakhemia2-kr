[
 {
  "key": "m0",
  "kind": 0,
  "chr": 88,
  "jh": "f8f4ab027f33",
  "ko": "고토 씨. 이거 저 일찍 일어나서 만들어 왔어요!"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 9,
  "jh": "8ff362534386",
  "ko": "어디 보자… 이거 맛있어 보이는군. 너를 닮아 화사한 빛깔이야"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 88,
  "jh": "72881282c2d8",
  "ko": "아~ 해 주세요. 아~"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 87,
  "jh": "5b056d1e1a8f",
  "ko": "치사해~! 내 것도, 내 것도 먹어 줘!"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 9,
  "jh": "fdfc5eb8ee32",
  "ko": "서두르지 마. 모처럼 너희가 만들어 준 거야. 음미하며 먹지 않으면 아깝지"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 86,
  "jh": "f4d39a496bab",
  "ko": "둘 다 너무 고토 님을 곤란하게 하면 안 돼"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 1,
  "jh": "aa227cf808a3",
  "ko": "좋은 아침~… 와!? 뭐, 뭐야, 그 애들?"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 88,
  "jh": "bbc744d33d46",
  "ko": "아~아. 시끄러운 게 왔다"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 87,
  "jh": "985545fdd423",
  "ko": "오늘은 여기까지인가… 또 봐요, 고토 씨"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 1,
  "jh": "d6f6799462c3",
  "ko": "왜 내가 방해꾼 취급이야? 그보다 너희…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 86,
  "jh": "a4a3c9cfc82f",
  "ko": "당신들에겐 폐를 끼치지 말라고 고토 님께서 엄하게 말씀하셨어요"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 86,
  "jh": "51630318786c",
  "ko": "그렇다고 고토 님을 독점하고 있다고 생각하진 마세요"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 1,
  "jh": "8a7e1cc0f505",
  "ko": "어, 에에?"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "591c9d67fc16",
  "ko": "뭐, 뭐야? 좀 무서웠어…?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 9,
  "jh": "5ac113499586",
  "ko": "팬인 애들이야. 꼭 같이 식사하자고 해서"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 6,
  "jh": "e890d069e08a",
  "ko": "여전히 손이 빠르네"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 9,
  "jh": "871eb3ed9937",
  "ko": "내가 먼저 손댄 게 아니야. 저쪽에서 다가오는 거지"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "533cce6afe0e",
  "ko": "어, 그러니까, 즉… 저 세 명이 고토를 좋아한다는 거야?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 9,
  "jh": "f9e157aca2b6",
  "ko": "세 명만이 아니지만. 아침 점심 저녁 다른 여자애가 오거든"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 9,
  "jh": "c0160e663de0",
  "ko": "게다가 요일별 로테이션이라 같은 애는 일주일에 한 번밖에 못 만나서…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "5c7bed09f4d7",
  "ko": "에에? 그 말은 세 명씩 세 끼에 일주일이 7일이니까…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 8,
  "jh": "43ec3bba30ea",
  "ko": "대략 60명이라는 거냐…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 9,
  "jh": "6ad96290a85d",
  "ko": "날마다 인원이 늘어서 정확한 건 나도 모르지만"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "57fc1dc014bc",
  "ko": "왜… 어째서 네가 그런…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 6,
  "jh": "bf0d48a242a0",
  "ko": "옛날부터 여자애 인기만은 이 몸보다 높았거든"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "20b1b1934d40",
  "ko": "그러니까 왜냐고? 여자애한테 인기 있을 요소가 하나도 없잖아"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 9,
  "jh": "4e6ef500b425",
  "ko": "그건 네가 모를 뿐이야. 그래, 넌 아직 사랑을 모르니까…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "52fedba1c991",
  "ko": "우와… 그 한마디, 지금까지 중에 제일 열받았을지도"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 9,
  "jh": "f0825975f26f",
  "ko": "화난 얼굴도 멋있어. 자, 다른 애랑 약속이 있어서 난 이만 실례하지"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "7f5d26175e59",
  "ko": "…어떻게 생각해?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 8,
  "jh": "a4e8fb19ede4",
  "ko": "어떻게라니?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 2,
  "jh": "7f4cc7c60a10",
  "ko": "…범죄의 냄새가 나"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "2fe43b53fd22",
  "ko": "그치? 그렇지 않으면 설명이 안 되잖아. 고토가 인기 있다니!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 8,
  "jh": "b037fdcb2256",
  "ko": "범죄는 지나쳐도 확실히 수상하긴 하지"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 6,
  "jh": "843e203fdc0d",
  "ko": "그렇게 멋있으니까 인기 있어도 하나도 이상할 거 없지 않아?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "efd7163a8a5a",
  "ko": "그 탈인형 어디가 멋있다는 거야!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 8,
  "jh": "c5bb50c8fc0a",
  "ko": "솔직히 저건 아니지…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 2,
  "jh": "f20ce63102c0",
  "ko": "쓸데없이 매끈매끈해서 오히려 징그러워…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 6,
  "jh": "ee9b280fe7c2",
  "ko": "이런이런. 누나들은 취향이 특이하니까"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "b995398181be",
  "ko": "아무튼 아틀리에에 범죄자를 둘 순 없어. 철저하게 조사해야지"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 8,
  "jh": "d20382528884",
  "ko": "아직 범죄자라고 정해진 건 아니지만"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 2,
  "jh": "491bf7633288",
  "ko": "나도 신경 쓰이니까… 도와줘도 될까"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 1,
  "jh": "6d53cf0046b6",
  "ko": "그럼 각자 고토에 대해 조사해 오는 걸로. 알았지"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]