[
 {
  "key": "m0",
  "kind": 0,
  "chr": 4,
  "jh": "1f348ec9f778",
  "ko": "이미 시작된 모양이군"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 3,
  "jh": "467ba6b210a6",
  "ko": "크, 이 내가 뒤처지다니… 서두르자!"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 96,
  "jh": "e461f8791840",
  "ko": "젠장, 뭐야 이 녀석… 세…"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 98,
  "jh": "de16ec5a51fe",
  "ko": "이쪽에 부상자 발생! 일시 후퇴한다!"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 81,
  "jh": "c139ad48578f",
  "ko": "오른쪽 수비가 약해! 손 빈 사람, 도와줘!"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 0,
  "jh": "9b3a4b8e687b",
  "ko": "크군…"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 5,
  "jh": "7fb188ad387d",
  "ko": "푸니! 푸니~!!"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 23,
  "jh": "17b5f85b107e",
  "ko": "크기가 강함과 직결되는 건 아니다! 라고 여동생이 대항심을 불태우고 있어요"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 7,
  "jh": "2fcb8496f0bc",
  "ko": "그런 건 싸워 보면 알지! 좋~아, 간다~!"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 3,
  "jh": "e9558a3a61b8",
  "ko": "앗, 정말! 넌 또 멋대로…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 4,
  "jh": "5e6f5aa9ee9e",
  "ko": "하지만 일단 적의 역량을 재 보는 건 옳은 판단이다"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 3,
  "jh": "8da8263b2c33",
  "ko": "너한테 안 들어도 알아! 자, 우리도 가자!"
 },
 {
  "key": "m12",
  "kind": 5,
  "chr": 95,
  "jh": "1c6bb75159fa",
  "ko": "으아아아! 안 돼, 방어선이 뚫렸다!"
 },
 {
  "key": "m13",
  "kind": 5,
  "chr": 106,
  "jh": "8f0f23188968",
  "ko": "막아! 목숨 걸고 막는 거야!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "1873ec7992cb",
  "ko": "…전혀 안 먹히는군"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "d349b4cb6926",
  "ko": "너, 진심으로 싸운 거 맞지?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 11,
  "jh": "c6218ad1866d",
  "ko": "싸웠어요!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 7,
  "jh": "02056db14946",
  "ko": "우와~ 세다. 왠지 불타오른다~!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 4,
  "jh": "ef7966aeed15",
  "ko": "손맛은 있었다만…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 4,
  "jh": "9ba1b92e71a6",
  "ko": "수비가 단단하다기보다 비정상적인 생명력을 가졌다고 할까"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 5,
  "jh": "cd164419518d",
  "ko": "푸니! 푸니니!!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 23,
  "jh": "0e49c607ee8b",
  "ko": "그럼 쓰러질 때까지 몇 번이고 싸워 주마! 라고 여동생이 흥분하고 있어요"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 0,
  "jh": "cc4e2cb303f6",
  "ko": "실제로 그것밖에 방법이 없을 것 같군…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 7,
  "jh": "7011b8b566ee",
  "ko": "그렇게 정했으면 쫓아가자! 서두르지 않으면 놓쳐!"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 1,
  "jh": "98fdfc0a7426",
  "ko": "아"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "0e8867554699",
  "ko": "어머… 누가 몬스터를 놓쳤나 했더니 너희였구나"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "0faf0f829a44",
  "ko": "따, 딱히 우리만의 탓은 아니야!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 7,
  "jh": "f1ba49425e64",
  "ko": "맞아, 릴리아. 우리도 전혀 못 당했잖아"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "ccb061571829",
  "ko": "쓸데없는 말 하지 마!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 0,
  "jh": "47dc90920b6c",
  "ko": "…이 녀석은 상대하지 말고 빨리 쫓아가죠"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 4,
  "jh": "a6fd46d9390c",
  "ko": "기다려라. 여기선 차라리 협력하는 게 상책 아닌가?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 7,
  "jh": "5ed2f7d5b16e",
  "ko": "오~ 명안이다!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 9,
  "jh": "d29be9b0a886",
  "ko": "확실히 우리와 너희가 손잡으면 백인력이지"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 6,
  "jh": "5174b88b2560",
  "ko": "이 몸은 요정 씨라 도와 달라고 하면 쉽게 거절 못 하지"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 8,
  "jh": "e5d6e4ce6880",
  "ko": "멋대로 얘기 진행하지 마! 난 싫어, 바보 누나랑 짜는 거"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "0e94def8e373",
  "ko": "그래 그래! 비아냥남이나 거만녀랑 짜는 건 사양이야!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 3,
  "jh": "d643c98e6fee",
  "ko": "윤, 이상한 소리 하지 마. 협력 같은 걸 할 수 있을 리가 없잖아"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 4,
  "jh": "68b3450a1a9d",
  "ko": "하지만 교내엔 부모도 남아 있는 거 아닌가?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 3,
  "jh": "6d4a9bcea0e2",
  "ko": "으, 그건…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "72694d74453e",
  "ko": "우리 부모님은 안 왔으니까 딱히 상관없어"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 2,
  "jh": "ee36c5782d6e",
  "ko": "울리카는 친구 부모가 죽어도 눈썹 하나 까딱 안 하는 사람이니까…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 0,
  "jh": "090db17344b3",
  "ko": "지독한 여자로군…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 6,
  "jh": "3ea9b663c36b",
  "ko": "인간으로서 실격이네"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 1,
  "jh": "b247eae6ebd0",
  "ko": "듣기 안 좋은 소리 하지 마! …알았어. 이번만 협력해 줄게"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "be1e1302cd62",
  "ko": "그건 내가 할 소리야. 부디 내 발목은 잡지 말도록"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 3,
  "jh": "b842f870753b",
  "ko": "자, 그럼… 너희는 앞으로 내 지휘하에 움직이도록 해"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 1,
  "jh": "a2b88a50ea87",
  "ko": "왜 그렇게 되는 건데! 협력만 하는 거잖아!"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 3,
  "jh": "2b7dec545f53",
  "ko": "내 말대로 움직이는 게 안전하고 확실하잖아. 불평하지 말고 따라"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 1,
  "jh": "24450f92bcc5",
  "ko": "싫어! 절대 싫어!"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 8,
  "jh": "36f1d29a7ea3",
  "ko": "…앞날이 험난하군"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 4,
  "jh": "d95bd373fbb1",
  "ko": "묘안이라고 생각했다만…"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 11,
  "jh": "da2ab70b6cc7",
  "ko": "로제 씨, 멍하니 있지 말고 두 분 좀 말려 주세요!"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 0,
  "jh": "bd45c5129750",
  "ko": "아, 아아…"
 },
 {
  "key": "m54",
  "kind": 5,
  "chr": -1,
  "jh": "b27cd08efd25",
  "ko": "거대 몬스터를 쓰러뜨릴 때까지 울리카 일행과 협력하게 되었습니다!"
 },
 {
  "key": "m55",
  "kind": 5,
  "chr": -1,
  "jh": "ddcb2b36c705",
  "ko": "울리카 파티에서 한 명만 게스트 캐릭터로 파티에 참가할 수 있습니다."
 },
 {
  "key": "m56",
  "kind": 5,
  "chr": -1,
  "jh": "e282a6cbc365",
  "ko": "참가할 캐릭터를 선택하세요."
 },
 {
  "key": "m57",
  "kind": 5,
  "chr": -1,
  "jh": "43a7b1daae59",
  "ko": "이후 이 맵으로 돌아오면 참가 캐릭터를 변경할 수 있으니 기억해 두세요."
 },
 {
  "key": "m58",
  "kind": 5,
  "chr": -1,
  "jh": "c9698da40b34",
  "ko": "「{CLRE}울리카{CLNR}」가 동료가 되었습니다."
 },
 {
  "key": "m59",
  "kind": 5,
  "chr": -1,
  "jh": "6aeca71b61a8",
  "ko": "「{CLRE}클로에{CLNR}」가 동료가 되었습니다."
 },
 {
  "key": "m60",
  "kind": 5,
  "chr": -1,
  "jh": "cc5b16c7b2a0",
  "ko": "「{CLRE}페페론{CLNR}」이 동료가 되었습니다."
 },
 {
  "key": "m61",
  "kind": 5,
  "chr": -1,
  "jh": "5316402bd62c",
  "ko": "「{CLRE}에나{CLNR}」가 동료가 되었습니다."
 },
 {
  "key": "m62",
  "kind": 5,
  "chr": -1,
  "jh": "cce669faba5f",
  "ko": "「{CLRE}고토{CLNR}」가 동료가 되었습니다."
 },
