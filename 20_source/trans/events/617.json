[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "5e8b20e279d1",
  "ko": "너를 여자답게… 자, 어디서부터 손을 대야 할까"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 11,
  "jh": "e6e14dad2b19",
  "ko": "옷이나 머리 모양만 바꿔도 꽤 다를 것 같은데요"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 7,
  "jh": "ea873517acb4",
  "ko": "그래도 옷은 이것밖에 없고, 머리도 이거 말고는 움직이기 불편해서…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 3,
  "jh": "8e50d6aa0229",
  "ko": "우선 그 생각부터 바꿔야 해. 원래 괜찮으니까 노력 여하에 따라선…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 11,
  "jh": "9a79116826d0",
  "ko": "앗… 그래도 괜찮으세요? 아가씨…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 3,
  "jh": "c1f0ce9f2437",
  "ko": "괜찮다니, 뭐가?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 11,
  "jh": "4292af450edd",
  "ko": "문득 생각했는데요… 에토 씨가 여자다워지면 아가씨에게 승산은…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 3,
  "jh": "9aa50324d176",
  "ko": "뭣!? 그건 그냥 넘길 수 없어!!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 11,
  "jh": "4163c2d8dab3",
  "ko": "그치만 에토 씨, 키도 크고 운동해서 몸매도 좋잖아요"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 3,
  "jh": "fb95b17726d0",
  "ko": "뭐, 그건 그렇지…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 11,
  "jh": "1741ee6584fc",
  "ko": "성격도 지나친 점만 고치면 솔직하고 밝고요"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 3,
  "jh": "1ae7b320a634",
  "ko": "솔직… 뭐, 확실히…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 11,
  "jh": "7bc2bf892c28",
  "ko": "집도 그럭저럭 부유하고 아가씨 댁만큼 엄격하지도 않고요"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 3,
  "jh": "3ce0bf5d5ca7",
  "ko": "으… 그렇구나…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 11,
  "jh": "b61c1381fcde",
  "ko": "무엇보다 가슴 크기가 결정적이죠"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "6805b27559dd",
  "ko": "가슴 얘기는 하지 마!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 11,
  "jh": "963bf6e1ce74",
  "ko": "죄, 죄송해요! 그래도 이렇게 늘어놓고 보니 역시 아가씨에게 승산은…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "4bf6b862b762",
  "ko": "큭… 스펙이 높다는 건 인정할 수밖에 없지만…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 11,
  "jh": "76e626079af2",
  "ko": "에토 씨가 마음먹으면 로제 씨쯤은 순식간에…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "b6aa144524c5",
  "ko": "왜 거기서 로제가 나오는 거야!?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 11,
  "jh": "c07e9e03112d",
  "ko": "두 분 다 같은 반이고 이러니저러니 사이가 좋잖아요. 아아, 불쌍한 아가씨…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "5cf13ad97175",
  "ko": "멋대로 상상하고 멋대로 동정하지 마!!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 0,
  "jh": "c599e9c56edc",
  "ko": "저기… 뭔가 분위기가 달아오른 것 같은데요…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 7,
  "jh": "0d36a9de2d73",
  "ko": "있잖아~ 내가 여자다워지는 방법은~?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 3,
  "jh": "624dfcce52b0",
  "ko": "시끄러워! 지금 중요한 얘기 하는 중이니까!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 7,
  "jh": "609acff205d9",
  "ko": "와!? 혼났다…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 3,
  "jh": "bf2c66b01429",
  "ko": "…흠흠, 결론이 났어"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "5abb06847a09",
  "ko": "꽤 오래 얘기하셨네요"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 7,
  "jh": "c436b7b13a82",
  "ko": "그래서? 그래서? 난 어떻게 하면 돼!?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 3,
  "jh": "ded28ebc7aba",
  "ko": "넌 지금 그대로 충분해! 언제까지나 그대로의 에토로 있어!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 7,
  "jh": "6f3117d231ef",
  "ko": "어? 지금 그대로면 돼?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 3,
  "jh": "0f4e042356de",
  "ko": "넌 지금 그대로도 충분히 매력적이야"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 3,
  "jh": "4a014ca5b266",
  "ko": "여자다워져서 내 지위를 위협할 필요는 없어"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 11,
  "jh": "90e0317baaf8",
  "ko": "아가씨! 본심이 새고 있어요!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 7,
  "jh": "a2bf64e75391",
  "ko": "그렇구나, 지금 그대로면 돼… 응! 왠지 자신감이 생겼을지도!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 0,
  "jh": "331c0b725510",
  "ko": "아니… 명백히 다른 속셈이 작용했다고. 방금 건…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]