[
 {
  "key": "m0",
  "kind": 0,
  "chr": 0,
  "jh": "612f6299e08c",
  "ko": "응?"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 1,
  "jh": "ee812c881b0e",
  "ko": "앗…나왔다! 거만녀에 비아냥남!"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 3,
  "jh": "de3a4533da69",
  "ko": "그 호칭은 그만둬! 또 질리지도 않고 방해하러 온 거니!?"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 11,
  "jh": "25b24879150f",
  "ko": "로제 씨한테도 별명이 붙었나 봐요"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 7,
  "jh": "c96cd09f300a",
  "ko": "좋겠다~ 나도 갖고 싶은데…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 0,
  "jh": "8fe7036a576e",
  "ko": "이런 거라도 괜찮으면 나중에 얼마든지 붙여 주마. 그보다 저건 뭐냐?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 6,
  "jh": "4a30d9a898fd",
  "ko": "후훗훗. 눈치채 버렸군"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "330a73bc69fc",
  "ko": "누나 아틀리에의 최종 병기인 이 몸에게…!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "873c6f8ef68e",
  "ko": "후훗훗. 우리가 고용한 요정 씨 페페론이야. 어때? 부럽지?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 7,
  "jh": "d87331557f35",
  "ko": "부, 부러워…! 뭔가 재밌어 보여, 저 사람!!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 3,
  "jh": "c89cbc7ef805",
  "ko": "…저런 거랑 같이 다니면서 창피하지도 않니?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "2cc49fd8dcfa",
  "ko": "…창피해… 엄청나게"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 6,
  "jh": "b3531bd7c4cd",
  "ko": "검은 누나는 보기와 달리 수줍음을 많이 타거든"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "c1df29933a2a",
  "ko": "아는 척 떠들지 마"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 6,
  "jh": "3af5c2679bee",
  "ko": "아, 죄송합니다. 좀 우쭐했네요…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "de225a1cd5e2",
  "ko": "너희 쪽에도 메이드 마나가 있는 것 같지만, 이걸로 막상막하야!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 11,
  "jh": "9a9fa53d593a",
  "ko": "네… 제가 저거랑 같은 취급인가요…?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 0,
  "jh": "ef51ca88c43a",
  "ko": "…그래서, 일부러 바보 같은 소리 하러 이런 데까지 온 거냐? 한가한 녀석들이군"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "5c31ff4d84a0",
  "ko": "아니거든! 시험 재료 캐러 온 거야! 그랬더니 너희가 방해를…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "c835a14c5365",
  "ko": "누가 언제 방해했는데. 우리도 너희 콩트 구경할 만큼 한가하지 않아"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 2,
  "jh": "f46d04191da2",
  "ko": "요정 씨 탓에 콩트 취급…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "da43315d8fd1",
  "ko": "틀린 말은 아니지. 사람들에게 웃음을 퍼뜨리는 게 이 몸의 일이니까!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "e06c8252a8ec",
  "ko": "크… 바보 같은 소리니 콩트니… 더는 못 참아! 이렇게 된 이상 승부야!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 0,
  "jh": "aef48060a3e5",
  "ko": "…뭐?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "83dfb22dff6b",
  "ko": "뭐? 가 아니야! 진 쪽은 재료를 포기하고 돌아간다. 어때?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "87ea906711b9",
  "ko": "대체 어떻게 하면 그런 결론이 나오는 거냐…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 7,
  "jh": "efc4bf484a5b",
  "ko": "오오! 승부! 좋아, 하자 하자!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "37aa369b863f",
  "ko": "넌 끼어들지 마. 일이 복잡해지니까"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "766f26179271",
  "ko": "좋잖아. 상대해 줄게"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 0,
  "jh": "2aa263e5d92a",
  "ko": "아가씨까지 무슨 말씀이세요!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "79755f08d46a",
  "ko": "이런 시골뜨기한테는 한번 분수라는 걸 가르쳐 주는 게 좋아!"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "0a61ad4d1eef",
  "ko": "아~! 또 시골뜨기라고 했어!!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 6,
  "jh": "9ef922b0f965",
  "ko": "하하하! 이 몸의 단련된 근육을 이길 수 있을까?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 11,
  "jh": "84b338e194f5",
  "ko": "저, 당신한테만은 안 질 거예요!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 0,
  "jh": "15d7daf6e55f",
  "ko": "아아 정말, 엉망진창이군…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 2,
  "jh": "fb6f3a9c4582",
  "ko": "고생이네… 서로…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 1,
  "jh": "e9a2e8c2c8e8",
  "ko": "자, 얼른 시작하자. 아니면 겁먹었어?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 0,
  "jh": "aa98ac6da74d",
  "ko": "…알았다, 상대해 주지. 나도 슬슬 화가 나기 시작했거든!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 0,
  "jh": "6500bea42789",
  "ko": "크…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "5dd5a666674a",
  "ko": "해냈다~! 이겼어, 이겼다고!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 3,
  "jh": "b621099eeb2a",
  "ko": "말도 안 돼… 말도 안 돼, 이런 거!! 절대 인정 못 해!!"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 6,
  "jh": "cda4882db61c",
  "ko": "뭐, 이 몸의 존재가 승부를 결정지었다고 해도 과언이 아니지"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 11,
  "jh": "e5248ae29774",
  "ko": "그런 힘 자랑, 반칙이에요…"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 7,
  "jh": "ea0cfa8ccd96",
  "ko": "굉장하다~ 저 근육… 때린 내 손이 더 아팠어…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "f29a1cfd056d",
  "ko": "뭐…!? 크, 오늘은 얌전히 물러나지만… 착각하지 마!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 3,
  "jh": "b0300031228d",
  "ko": "우연히 컨디션이 안 좋고 피곤했던 데다 봐주면서 자비를 베풀었을 뿐이니까!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 7,
  "jh": "88a1fa871a18",
  "ko": "졌지만 즐거웠어~! 또 승부하자~!"
 },
 {
  "key": "m47",
  "kind": 0,
  "chr": 6,
  "jh": "7e5e3341704c",
  "ko": "하하하! 역시 정의는 승리하는군!"
 },
 {
  "key": "m48",
  "kind": 0,
  "chr": 2,
  "jh": "a892f243550b",
  "ko": "정의인지는 심히 의문이지만…"
 },
 {
  "key": "m49",
  "kind": 0,
  "chr": 1,
  "jh": "36864086a8bc",
  "ko": "됐어, 이긴 쪽이 정의니까. 자, 재료 캐서 돌아가자"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]