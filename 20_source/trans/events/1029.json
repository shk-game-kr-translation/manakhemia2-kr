 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 20,
  "jh": "58a9a9dd7ed9",
  "ko": "자기 입으로 말하지 마. 뭐 됐다, 졸업해도 이 기세로 해 나가. 자, 도장이다"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 20,
  "jh": "70fe06b70fe0",
