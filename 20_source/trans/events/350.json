[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "3fdcef29e124",
  "ko": "우류~ 부비부비, 꼬옥~!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 10,
  "jh": "8fdd369c52ac",
  "ko": "우~… 답답해…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "d42a0e4fd3f9",
  "ko": "아하하. 이것저것 힘들었지만 우류가 조금 말할 수 있게 된 건 큰 수확이야"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 10,
  "jh": "2a8fb29811c2",
  "ko": "놔 줘, 우류이카…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "0ddae399e8a4",
  "ko": "음~ 그럼… 엄마, 라고 불러 주면 놔 줄게"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 10,
  "jh": "dbefb3974c5a",
  "ko": "시러~"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "c6d242b8fb97",
  "ko": "왜, 왜 싫어해?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 10,
  "jh": "53b995668e9d",
  "ko": "…부끄러어"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "200fc712d328",
  "ko": "크윽…!! 귀, 귀여워! 뭘 부끄러워하는 거야, 정말!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 10,
  "jh": "49f762a3cc9f",
  "ko": "우~! 답답해…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 8,
  "jh": "3bace5524a30",
  "ko": "그래서 또 저 상태로 돌아간다, 라…"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 2,
  "jh": "416bdc058124",
  "ko": "남자의 질투는 꼴사나워…?"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 8,
  "jh": "7b7e78427cb9",
  "ko": "질투 아니야! 어이없어했을 뿐이야!"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 6,
  "jh": "86995f1f6765",
  "ko": "형, 마음이 맞네. 실은 이 몸도 질투로 가슴이 찢어질 것 같았어!"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 8,
  "jh": "3517bef0ce46",
  "ko": "그러니까 질투 아니라고 했잖아!"
 },
 {
  "key": "m15",
  "kind": 5,
  "chr": 19,
  "jh": "4d0817d50680",
  "ko": "실례하겠다. 뭔가 떠들썩하군"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 10,
  "jh": "4e0eb7515036",
  "ko": "우~!?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "b4cd72d24400",
  "ko": "와앗!? 왜, 왜 네가!?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 19,
  "jh": "5fa7516bea9f",
  "ko": "허가는 받았다. 일부러 안내까지 해 줘서 감사한다"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 20,
  "jh": "4143a9b603a9",
  "ko": "아~ 신경 쓰지 마. 어차피 가는 길이었으니까"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 20,
  "jh": "92220d88cdf2",
  "ko": "그보다 너희, 너무 이상한 지인 만들지 마라"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 19,
  "jh": "f115a9148c92",
  "ko": "이상하다는 건 날 말하는 건가? 확실히 인간이 보기엔 특이한 존재일지도 모르지만…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "28c0f2532482",
  "ko": "잠깐! 뭐 하러 왔냐고 묻잖아! 설마 또…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 19,
  "jh": "6724b24143ce",
  "ko": "사과하러 왔다. 지난번엔 큰 폐를 끼쳤다. 미안하다"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "387924ec3f3d",
  "ko": "어, 으? 아~… 그렇게 순순히 사과하면…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 19,
  "jh": "8f6d6ec84eeb",
  "ko": "빛과 어둠의 마나도 실패를 인정하고 당분간 이쪽 세계엔 간섭하지 않기로 하셨다"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 19,
  "jh": "f2ae8c85d1fc",
  "ko": "내가 말하긴 이상하지만 평온한 생활을 보내 줬으면 한다"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "1ca750d29281",
  "ko": "아, 그런… 정중하게 감사합니다"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 8,
  "jh": "72b79e563193",
  "ko": "왠지 누나가 묘하게 순순하네"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 2,
  "jh": "7f77a97638cb",
  "ko": "저자세로 나오면 의외로 약하거든. 울리카는…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 8,
  "jh": "90c67e43c423",
  "ko": "그런 건 1년 전에 가르쳐 줘…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 19,
  "jh": "1d540bcf1e1d",
  "ko": "너에겐 무서운 꼴을 보이게 했다. 정말 미안하다"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 19,
  "jh": "1d7311019d90",
  "ko": "아직 내가 무섭나? 자업자득이라지만 괴로운 기분이 드는군"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "eab19ddc0d57",
  "ko": "이제 용서해 주지 그래? 반성하는 것 같은데"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 10,
  "jh": "e6f96b3478c0",
  "ko": "우~… 우!"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 19,
  "jh": "745ee221af9e",
  "ko": "용서해 주는 건가?"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 10,
  "jh": "3218c6994c56",
  "ko": "…응"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 19,
  "jh": "f4f20714081c",
  "ko": "…그럼 염치없는 줄 알지만 부탁이 하나 있는데"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 10,
  "jh": "ea065d8d41fd",
  "ko": "우?"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 19,
  "jh": "346cab6e1796",
  "ko": "그, 그러니까… 한 번 더 머리를 쓰다듬게 해 줬으면 하는데…"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 10,
  "jh": "9dc66ada9e64",
  "ko": "우!"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 19,
  "jh": "0af8d114c72d",
  "ko": "괜찮나? 고맙다… 아아, 넌 정말 복슬복슬하구나"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 10,
  "jh": "075a3677f879",
  "ko": "우우~…"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 19,
  "jh": "4ffd127036f6",
  "ko": "………좋아, 만족했다. 그럼 난 이만 실례하겠다"
 },
 {
  "key": "m45",
  "kind": 0,
  "chr": 10,
  "jh": "d0a2311a2573",
  "ko": "우~… 빠이빠이"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 19,
  "jh": "3f74773bc45b",
  "ko": "그래. 또 보자"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 2,
  "jh": "435c46c54658",
  "ko": "…별로 나쁜 사람으론 안 보였네"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 9,
  "jh": "8a2574c993c7",
  "ko": "뭐, 선악이란 입장에 따라 바뀌는 거니까"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 20,
  "jh": "f9c5b9289fce",
  "ko": "야, 이제 됐냐? 이쪽은 계속 기다리고 있는데"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 1,
  "jh": "859b4bc6c41a",
  "ko": "앗, 선생님 아직 있었구나"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 20,
  "jh": "4d5dbc80432f",
  "ko": "볼일 있다고 했잖아. 잊은 것 같아서 일부러 와 줬는데…"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 1,
  "jh": "f97129008970",
  "ko": "잊었다고? 내가? 뭐지…"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 20,
  "jh": "1039dc9d16b6",
  "ko": "기말고사 제출. 마감은 진작 지났다만"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 1,
  "jh": "0c62a6950fec",
  "ko": "어……… 아~~~!!"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 20,
  "jh": "7a4205f91403",
  "ko": "이런이런. 졸업 직전에 낙제 결정이냐. 구제불능이군"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 1,
  "jh": "7a10bf8ef32a",
  "ko": "기다려요! 기다려요! 지금 당장 할게요, 네?"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 2,
  "jh": "2fff70be2702",
  "ko": "낙제도 경력에 무게가 붙는다고 생각하면 나쁘지 않아…"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 1,
  "jh": "a7e0445a4e95",
  "ko": "절대 싫어! 애초에 너도 제출 안 했잖아? 뭘 침착하게 있어!"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 20,
  "jh": "95ed7bbe7c06",
  "ko": "아니. 이 녀석은 제출했다"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 1,
  "jh": "6c5bcd3ddb19",
  "ko": "어? 왜, 왜? 언제!?"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 2,
  "jh": "8b283ca479b4",
  "ko": "그 대소동 다음 날에 몰래…"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 1,
  "jh": "0a7d40efb04a",
  "ko": "왜 몰래 하는 건데! 나한테도 알려 줘!"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 2,
  "jh": "137ee4cb7082",
  "ko": "………. …깜빡 잊었어"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 1,
  "jh": "e4a110a3452b",
  "ko": "거짓말! 절대 일부러지!"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 20,
  "jh": "f53bf6047e1f",
  "ko": "떠들지 말고 냉큼 만들어. 크게 봐줘서 저녁까진 기다려 주마"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 1,
  "jh": "781ad2dab35f",
  "ko": "정말요!? …잠깐, 그렇게 시간 없잖아요! 서둘러야 해~!"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 6,
  "jh": "8f8a27666f61",
  "ko": "야아. 완전히 평소의 일상이네"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 9,
  "jh": "4ec6d3a7da0f",
  "ko": "잘됐잖아. 대체로 네가 바랐던 대로지?"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 6,
  "jh": "385333a2cac5",
  "ko": "그렇지. 마나니 인간이니 해서 불행해지는 사람은 보고 싶지 않으니까"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 9,
  "jh": "fca123dc4117",
  "ko": "네가 노력한 성과야. 한동안은 이 상황을 히죽히죽 지켜보자고"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 6,
  "jh": "e07ab46a6786",
  "ko": "그거 좋은 제안이네. 히죽히죽…"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 9,
  "jh": "24c90b21f98f",
  "ko": "히죽히죽…"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 1,
  "jh": "a2e7f3620a6b",
  "ko": "거기! 기분 나쁜 얼굴 하지 말고 도와!!"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 20,
  "jh": "3090b6348768",
  "ko": "저녁까지 두 시간쯤인가… 자, 끝나면 좋겠네"
 },
 {
  "key": "m75",
  "kind": 2,
  "chr": 1,
  "jh": "f20127ea6909",
  "ko": "와~ 기다려요 기다려요~!!"
 },
 {
  "key": "m76",
  "kind": 5,
  "chr": -1,
  "jh": "f3e1e55baaa8",
  "ko": "―1주일 후―"
 },
