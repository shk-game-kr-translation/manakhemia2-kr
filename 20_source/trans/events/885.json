[
 {
  "key": "m0",
  "kind": 2,
  "chr": 7,
  "jh": "73a153e02403",
  "ko": "…안 오네~ 군나르 선생님"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 3,
  "jh": "94477ac8dccb",
  "ko": "정말이지, 이 나를 기다리게 하다니 무례에도 정도가 있지!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 0,
  "jh": "6c939c62e8a3",
  "ko": "차라리 이대로 안 와 주면 살겠는데요…"
 },
 {
  "key": "m3",
  "kind": 5,
  "chr": 12,
  "jh": "1e6788bb4e84",
  "ko": "수고. 전원 모인 것 같군"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 0,
  "jh": "a1045ea5dffe",
  "ko": "그렇게 무를 리 없지…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 3,
  "jh": "7a33e5659049",
  "ko": "늦었잖아! 대체 지금 몇 시라고… 어머?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 5,
  "jh": "83582ea84318",
  "ko": "푸니? 니니니?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 23,
  "jh": "89f6805e2338",
  "ko": "그 몬스터는 뭐냐? 라며 여동생이 질문하고 있어요"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 12,
  "jh": "74de5f8f70b6",
  "ko": "후후후, 잘 물어봐 줬다"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 12,
  "jh": "a1282af188fe",
  "ko": "이 녀석이야말로 이 몸이 만들어 낸 궁극의 몬스터형 생물 병기!!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 0,
  "jh": "b897cb68c50f",
  "ko": "…생물 병기?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 12,
  "jh": "93a394094b7a",
  "ko": "그렇다, 가진 모든 기술을 투입해 만들어 낸 최고 걸작이다"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 12,
  "jh": "c3e979ffa0d3",
  "ko": "영광으로 알아라. 네놈들은 이 녀석의 실전 테스트 상대로 뽑혔으니까!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 7,
  "jh": "998885a691f8",
  "ko": "오오오, 그렇게 세구나… 야호~!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 3,
  "jh": "3d9f3e953060",
  "ko": "야호~가 아니야! 뭐야, 실전 테스트라니!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 12,
  "jh": "d023557d4d62",
  "ko": "어느 정도 살상 능력이 있는지 확인해 두지 않으면 나중에 곤란하지 않겠나?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 11,
  "jh": "c67e0d84b672",
  "ko": "…슬쩍 엄청난 말을 하셨네요"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 12,
  "jh": "542ae47fc54b",
  "ko": "게다가 네놈들은 보충 수업 신세. 거부권은 없다. 자, 각오하고 싸워라!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 4,
  "jh": "75197ffd657c",
  "ko": "네 보충 수업 탓에 엄청난 일이 됐군"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "3df782bec06c",
  "ko": "미안하게 됐다… 젠장, 하면 되잖아, 하면!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 0,
  "jh": "6dcd0485c3ec",
  "ko": "하아, 하아… 이겼나…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 7,
  "jh": "7fb57c35041a",
  "ko": "아하하, 꽤 위험했네~…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 12,
  "jh": "5f92d00528f7",
  "ko": "음… 져 버렸나. 아무래도 이 녀석은 아직 개량의 여지가 있군"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 12,
  "jh": "174e5ea8f66a",
  "ko": "하지만 귀중한 데이터를 얻었다. 후후후… 이 녀석은 아직 더 강해진다!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 0,
  "jh": "281de526d84b",
  "ko": "농담이지… 그보다 더 강해지면 감당 못 해…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 12,
  "jh": "44c6a355c4f7",
  "ko": "그리고 네놈들의 높은 전투 능력을 다시 확인한 것도 수확이군"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 12,
  "jh": "504d70cc02c8",
  "ko": "어떠냐, 졸업 후니 뭐니 느긋한 소리 말고 지금 당장 이 몸 밑에서 일하지 않겠나?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 3,
  "jh": "b320bb8dc414",
  "ko": "웃기지 마! 누가 당신 밑에서…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 4,
  "jh": "b090ba2cf8c5",
  "ko": "음. 얼마를 받아도 수지가 안 맞는다"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 12,
  "jh": "af426451c0b9",
  "ko": "그런가… 뭐 좋다. 네놈들을 구워삶을 시간과 수단은 얼마든지 있으니까"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 12,
  "jh": "88486c26eadb",
  "ko": "당분간은 이 녀석 개량에 힘을 쏟기로 하지"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 0,
  "jh": "0d7633e1c398",
  "ko": "성가신 사람한테 찍혔군…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 7,
  "jh": "4f10950ffda1",
  "ko": "군나르 선생님 밑에서 일하기… 의외로 재밌을지도!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 0,
  "jh": "a2c311720ee4",
  "ko": "갈 거면 혼자 가… 난 절대 싫으니까…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 12,
  "jh": "254d9ca2e2fb",
  "ko": "오오, 이건 예상 이상의 성과군"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 12,
  "jh": "ca105c48f24b",
  "ko": "설마 이놈들을 완전히 두들겨 패 버릴 줄이야…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 12,
  "jh": "fcd309eec3d8",
  "ko": "후후후후. 이 녀석을 양산하면 생각보다 빨리 이 몸의 야망이 달성되겠군"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 12,
  "jh": "9637d5e0de82",
  "ko": "후후후후후… 하~하하하하!!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 0,
  "jh": "4cb2557d0147",
  "ko": "…야, 살아 있냐…?"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 7,
  "jh": "bc26ef58788e",
  "ko": "…어떻게든~…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 0,
  "jh": "ecebd6605aa2",
  "ko": "…그러니까 말했잖아… 보충 수업 같은 거 받는 게 아니라고…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 7,
  "jh": "8733ca46bca5",
  "ko": "응… 미안해…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 0,
  "jh": "5dc0a29e4619",
  "ko": "하아… 이게 마지막이면 좋겠는데…"
 },
 {
  "key": "g0s0",
