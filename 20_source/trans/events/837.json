 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 28,
  "jh": "517e5d28544e",
  "ko": "어렵지 않았다… 그거 혹시 내 수업이 도움이 돼서라거나…?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 0,
  "jh": "796decd6a9a6",
