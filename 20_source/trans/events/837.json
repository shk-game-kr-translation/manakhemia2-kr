 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 28,
  "jh": "b6b2dbefa708",
  "ko": "…응. 잘 모아 왔네. 꽤 우수한 것 같아"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 7,
  "jh": "4de667db1f29",
