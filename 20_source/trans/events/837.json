  "kind": 0,
  "chr": 0,
  "jh": "51f4fb3cacf3",
  "ko": "좀 더 자신감을 가져도 될 것 같은데. 저 선생님은…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 28,
  "jh": "d6d64e127f29",
  "ko": "음~… 보통, 이네"
 },
