 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "9a7015cc3c0b",
  "ko": "그, 그러니까 해고 같은 거 안 했다니까!"
 },
 {
  "key": "m3",
  "kind": 5,
  "chr": 7,
  "jh": "e2e3da9415b4",
  "ko": "좋은 아침~!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 7,
  "jh": "db757de05bc6",
  "ko": "어라? 로제, 여기도 안 왔어?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 11,
  "jh": "d8b7074ca305",
  "ko": "여기도라니… 무슨 말이에요?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 7,
  "jh": "fc1460bef5b5",
  "ko": "오늘 수업에 안 나왔어"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 7,
  "jh": "81576c66cb60",
  "ko": "방에도 없길래 아틀리에에 왔나 했는데"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 11,
  "jh": "a49b689932b8",
  "ko": "그런… 어디로 가 버린 걸까요?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 3,
  "jh": "8852e6609465",
  "ko": "설마… 충격받아서 가출…? 분명 그래! 틀림없어!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 5,
  "jh": "4b18b4c425fc",
  "ko": "…푸니~"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 23,
  "jh": "276e25b2cb4e",
  "ko": "아무래도 그건 너무 성급한 게 아닐까… 라며 여동생이 의문을 제기하는데요…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 3,
  "jh": "2b9d0b3085a5",
  "ko": "아아, 내 탓이야… 로제 마음도 생각 안 하고…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 3,
  "jh": "5803ae91ea02",
  "ko": "그렇지, 남몰래 마음을 품던 주인에게 갑자기 그런 말을 들으면…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 11,
  "jh": "26e2d167468f",
  "ko": "마음을 품던, 부분은 꽤 의문이 남지만요…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "101d35e69daf",
  "ko": "학교를 뛰쳐나가도 저택엔 못 돌아가고, 달리 갈 곳도 없을 텐데…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 3,
  "jh": "591a5ff0cc3e",
  "ko": "그리고 세상을 비관한 로제는… 아, 안 돼! 섣부른 짓은! 지금 내가 갈게!"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 11,
  "jh": "70eb64ab3483",
  "ko": "앗! 아가씨!!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 4,
  "jh": "a1bd5ce55ad2",
