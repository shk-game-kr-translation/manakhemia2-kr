[
 {
  "key": "m0",
  "kind": 2,
  "chr": 7,
  "jh": "6f4f2b4cb764",
  "ko": "…좋아! 그럼 에나한테 다녀올게!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "b6363be22fe3",
  "ko": "…괜찮은 거냐?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 7,
  "jh": "c2faa07bf1f8",
  "ko": "괜찮다니까! 다들한테 조언도 받았고!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 7,
  "jh": "94cb33b810c0",
  "ko": "에나~! 지금 갈게~!"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 0,
  "jh": "fc7d7677f01d",
  "ko": "가 버렸나…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 11,
  "jh": "056713ee231b",
  "ko": "정말 괜찮을까요… 주로 에나 씨가 걱정돼요"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 4,
  "jh": "32ef687aba08",
  "ko": "상황을 보러 갈까. 내 가르침을 실천할 수 있을지 지켜봐야 하니까"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 8,
  "jh": "4341942aa2f1",
  "ko": "오. 마침 잘됐다"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 7,
  "jh": "077e35b0cf2f",
  "ko": "라니, 으아아! 에나!? 왜!?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 8,
  "jh": "74bbed18c776",
  "ko": "아, 아니, 뭐랄까… 잠깐 볼일이 있어서"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 7,
  "jh": "7224caa769eb",
  "ko": "그, 그렇게 갑자기 나타나면 마음의 준비가…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 8,
  "jh": "aa195b02c484",
  "ko": "아까는 그, 뭐랄까, 나도 말이 좀 지나쳤을지도 모르는 것 같기도 해서…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 7,
  "jh": "de3362a6a3fd",
  "ko": "아, 안 돼 안 돼! 다들한테 들은 걸 떠올려야…!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 8,
  "jh": "801282796ba9",
  "ko": "사과하는 대신은 아니지만. 일단 선물 같은 걸 말이지…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 7,
  "jh": "b945febab948",
  "ko": "와, 와아! 오빠, 에토 만나러 와 줬구나!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 8,
  "jh": "24f16bd988b6",
  "ko": "………뭐?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 7,
  "jh": "0568898756c1",
  "ko": "전혀 안 놀아 주니까 에토 엄청 외로웠단 말이야!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 8,
  "jh": "11777ad3279e",
  "ko": "…새로운 괴롭힘이냐?"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 7,
  "jh": "9048e3fbe6a9",
  "ko": "어, 어라? 안 먹혀… 오히려 화났어? 사부! 다음엔 어떻게 하면…?"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 0,
  "jh": "f8d7420cd1e1",
  "ko": "당신 어느새 사부 소리 듣고 있네"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 4,
  "jh": "ecb2a481cff7",
  "ko": "아아. 나의 오랜 지식을 전수해 줬다. 어엿한 사제 관계라 할 수 있지"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 11,
  "jh": "a37c64d3ead4",
  "ko": "아무래도 도움을 청하는 것 같은데요…"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 4,
  "jh": "877e70e0eca8",
  "ko": "이 정도로 도움을 청해서야 말이 안 되지. 좀 더 자기 힘으로 노력해 봐라"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 8,
  "jh": "8463429a48b3",
  "ko": "그렇군. 사람이 어쩔 수 없이 마지못해 사과하러 와 줬는데 그런 태도를 취한다 이거지…"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 7,
  "jh": "859a0a2ce603",
  "ko": "으… 이제 승부를 걸 수밖에… 에잇!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 7,
  "jh": "498a81fa0900",
  "ko": "꺄하! 아야~"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 8,
  "jh": "539a7d7db02e",
  "ko": "와, 갑자기 왜 넘어지고… 아직도 놀리는 거냐?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 7,
  "jh": "179fb3f08bd8",
  "ko": "싫다~ 넘어져 버렸어. 난 정말 덜렁이라서… 훌쩍"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 8,
  "jh": "dbd72cda2fd4",
  "ko": "이봐, 설마… 바보 바보 했지만 드디어 본격적으로…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 7,
  "jh": "c2c98b45a88f",
  "ko": "이런 모습을 주인님께 보이다니… 부끄러워!!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 8,
  "jh": "834c5976380b",
  "ko": "갑자기 주인님이냐!?"
 },
 {
  "key": "m31",
  "kind": 5,
  "chr": 35,
  "jh": "6f697b79eba8",
  "ko": "게햐! 구후후후! 아~하하하하하!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 8,
  "jh": "326c88114467",
  "ko": "으아!? 갑자기 움직이기 시작했다!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 7,
  "jh": "9b85d59e8370",
  "ko": "아… 먹혔다! 해냈다, 잘됐어!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 8,
  "jh": "6521c36ddbce",
  "ko": "안 먹혔어! 내가 웃는 게 아니라…"
 },
 {
  "key": "m35",
  "kind": 5,
  "chr": 35,
  "jh": "76d0a5bc2a83",
  "ko": "아하하하하! 이히히히히! 케~켓케켓케!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 8,
  "jh": "5bfbfd49b093",
  "ko": "아~! 멈춰! 젠장! 급하게 만들어서…"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 4,
  "jh": "5ac887fe60b6",
  "ko": "자기 힘으로 전기를 불러들였나. 훌륭하다"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 3,
  "jh": "26ba6b2e7764",
  "ko": "영문 모를 전개가 됐네…"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 11,
  "jh": "c6b35d1e6a06",
  "ko": "신난 건 에토 씨랑 윤 씨뿐이네요…"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 4,
  "jh": "a6906251a925",
  "ko": "지금이다! 여기서 비장의 카드를 써라!"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 0,
  "jh": "b952db697d12",
  "ko": "비장의 카드…?"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 7,
  "jh": "801e06a58ad0",
  "ko": "알겠습니다! 지금이야말로 수행의 성과를…!!"
 },
 {
  "key": "m43",
  "kind": 5,
  "chr": 35,
  "jh": "f2aacaa6974c",
  "ko": "쿠케케케케! 카~캇카카! 우히, 우히히히…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 8,
  "jh": "98e197167067",
  "ko": "아아, 이제 됐어! 아무튼 말이지! 이걸 너한테…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 7,
  "jh": "9a13a21ab588",
  "ko": "들어 줘 에나! 사실 우리… 진짜 남매가 아니야!!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 8,
  "jh": "aa78fd1b0920",
  "ko": "뭐, 뭐라고!?"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 0,
  "jh": "dda15d2e727d",
  "ko": "저게 비장의 카드냐…?"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 4,
  "jh": "7088f1da222a",
  "ko": "아아, 예로부터 전해지는 필살 오의다. 이걸로 안 넘어오는 남자는 없다"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 11,
  "jh": "3eef2a05dbbd",
  "ko": "저… 애초의 목적은 넘어오게 하는 게 아니라 화해 아니었나요…"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 4,
  "jh": "546eb01c48ca",
  "ko": "미움받은 남자를 넘어오게 하는 것도 화해하는 것도 큰 차이 없겠지"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 3,
  "jh": "76dbf9b0ec59",
  "ko": "차이 크거든…"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 0,
  "jh": "491c31e72f70",
  "ko": "당신만은 멀쩡한 녀석이라 생각했는데…"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 7,
  "jh": "f924610dc9d6",
  "ko": "그러니까 나! 오래전부터 에나를 동생이 아니라 한 남자로…!"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 8,
  "jh": "37f9f32488ba",
  "ko": "기다려! 그럴 리 없잖아! 집에 사진도 남아 있고… 정말 어떻게 된 거냐?"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 7,
  "jh": "6650d4b350ee",
  "ko": "이제 참을 수 없어! 하아~, 하아~…"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 8,
  "jh": "fde6b3700549",
  "ko": "눈이 무서워… 오지 마! 더 다가오지 마!"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 8,
  "jh": "78de096f5cd6",
  "ko": "내가 잘못했으니까! 자, 이거 줄 테니까! 잘 있어!"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 7,
  "jh": "4b0187f66e8a",
  "ko": "어? 주는 거야? 뭘까, 이거?"
 },
 {
  "key": "m59",
  "kind": 5,
  "chr": 42,
  "jh": "d3c22c97325a",
  "ko": "우후후… 킥킥… 풉, 쿡쿡…"
 },
 {
  "key": "m60",
  "kind": 0,
  "chr": 7,
  "jh": "c5269c0370c6",
  "ko": "어라? 에나… 그러니까… 이건 즉…"
 },
 {
  "key": "m61",
  "kind": 0,
  "chr": 4,
  "jh": "7cb4d551a213",
  "ko": "네 승리다"
 },
 {
  "key": "m62",
  "kind": 0,
  "chr": 7,
  "jh": "fb1b3314bcf5",
  "ko": "사부!"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 4,
  "jh": "ae35d03a2af9",
  "ko": "훌륭했다. 설마 단기간에 여기까지 할 수 있게 될 줄이야"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 7,
  "jh": "f81048f360a4",
  "ko": "아이~ 뭘요… 맞다! 나중에 이거 답례하러 가야지"
 },
 {
  "key": "m65",
  "kind": 5,
  "chr": 42,
  "jh": "d3fcb018eb29",
  "ko": "이햐햐햐! 게햐햐햐…"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 0,
  "jh": "ddb91d123a2c",
  "ko": "저 녀석도 저 녀석대로 영문 모를 걸 두고 갔네…"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 3,
  "jh": "72f2551d2315",
  "ko": "멀쩡한 애였는데… 저쪽 아틀리에에서 나쁜 영향을 받았나 봐"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 4,
  "jh": "7e42d49e108e",
  "ko": "당분간은 가만 놔둬라. 남자는 여자보다 마음 정리에 시간이 걸리니까"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 7,
  "jh": "34cd7beeb91f",
  "ko": "그, 그렇구나! 역시 사부!"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 11,
  "jh": "7d0abe05c3a5",
  "ko": "…결과적으로 에나 씨에겐 잘된 걸지도 모르겠네요"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 0,
  "jh": "fb6f4ca343a9",
  "ko": "그럴지도. 정신적으론 힘들었겠지만"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 3,
  "jh": "57c4f16f4a7a",
  "ko": "불쌍한 애…"
 },
 {
  "key": "m73",
  "kind": 5,
  "chr": 42,
  "jh": "23d678608eaa",
  "ko": "우햐! 아햐햐햐햐! 히~힛히히…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]