[
 {
  "key": "m0",
  "kind": 0,
  "chr": 3,
  "jh": "856d43071141",
  "ko": "후우…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 11,
  "jh": "79fa2111056a",
  "ko": "왜 그러세요? 한숨이라니 안 어울리게"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "b2f7eee15ac5",
  "ko": "…한마디가 많아. 잠깐 생각 좀 하고 있었을 뿐이야"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 11,
  "jh": "b5a54d5fccb8",
  "ko": "저라도 괜찮으시다면 상담해 드릴까요?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "7cf380673c9b",
  "ko": "너한테 상담해 봤자… 음… 그래도…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 11,
  "jh": "f7171ec26ab2",
  "ko": "어차피 로제 씨 일이죠?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "595dbd8273f3",
  "ko": "어, 어떻게 알았어!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 11,
  "jh": "0cb032e8ef28",
  "ko": "아가씨가 고민할 일이라곤 그것밖에 없잖아요"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 11,
  "jh": "8fea1514ebc3",
  "ko": "로제 씨 입학 이후로 왠지 서먹해지셨으니까요"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 3,
  "jh": "1f225751d037",
  "ko": "너도 그렇게 생각해!?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 3,
  "jh": "4ff996926474",
  "ko": "그렇다니까. 이래선 뭘 위해 이 학원에 왔는지…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 11,
  "jh": "dc4b77a8014f",
  "ko": "저택에 있을 땐 주인어른 감시만 조심하면 어떻게든 둘만 있을 수 있었죠"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 3,
  "jh": "1f7943c58a80",
  "ko": "로제도 로제야. 여자 친구들을 잔뜩 만들고 싫지도 않은 눈치고…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 11,
  "jh": "5fd9d2fdc0b3",
  "ko": "일방적으로 들이대서 곤란해하는 걸로 보이던데요"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 11,
  "jh": "c7f241619d8e",
  "ko": "이러니저러니 해도 잘 챙겨 주는 사람이니까요"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "7b7a3a44b140",
  "ko": "그렇다고 그 때문에 주인 상대를 소홀히 하다니 말도 안 돼!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 11,
  "jh": "fb4daa98a85e",
  "ko": "아가씨가 얼마나 소중히 여겨지지 않는지 알겠네요"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "589b016f111d",
  "ko": "아니거든! 로제는 쑥스러움을 타서 솔직해지지 못할 뿐이고…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "cacb1f731ee9",
  "ko": "그래도 그런 점이 또 귀엽기도 하지만"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 11,
  "jh": "d92dafdf83ab",
  "ko": "아가씨에게 특별한 감정은 없다고 생각하는 게 자연스럽지 않을까요?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "a8bbfdb898f1",
  "ko": "그럴 리 없어! 10년 넘게 같은 저택에서 살았는데 나한테 마음이 없다니…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 11,
  "jh": "424c41c334ca",
  "ko": "뭐, 아가씨의 착각은 아무래도 상관없지만"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 11,
  "jh": "0a12d1266e10",
  "ko": "역시 아가씨 쪽에서 좋아한다고 말해 버려야 해요"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "4786a8b02248",
  "ko": "뭣!? 벼, 별로 난 로제 따위 좋아하지 않거든!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 3,
  "jh": "bf1b470bd1f4",
  "ko": "다만 로제 쪽에서 말해 온다면 뭐 어쩔 수 없겠다 싶어서…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 11,
  "jh": "3d2d847cd4f3",
  "ko": "…그래서야 평생 진전이 없을지도 몰라요"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 3,
  "jh": "23e17048ed68",
  "ko": "그, 그건 곤란해… 뭔가 손을 써야…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
