 {
  "key": "m8",
  "kind": 2,
  "chr": 8,
  "jh": "60412cfeb3c9",
  "ko": "그래서 말인데. 누나가 잘 그 녀석들을 꾀어내 와 주지 않을래?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 8,
  "jh": "c2dcb3c3ffa9",
