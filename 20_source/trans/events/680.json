  "kind": 2,
  "chr": 8,
  "jh": "f522e273fec6",
  "ko": "그게 곤란했어. 전원 한꺼번에 잡지 않으면 의미가 없잖아?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "d1540ce59e6c",
