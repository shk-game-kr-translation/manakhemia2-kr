[
 {
  "key": "m0",
  "kind": 0,
  "chr": 74,
  "jh": "b14637240a6a",
  "ko": "에나! 에나!! 다행이다, 이제 평생 못 만나는 줄… 흑…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 8,
  "jh": "1535b09f22c0",
  "ko": "으악, 울지 마! 안기지 마! 정말, 또 길 잃었었냐?"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 6,
  "jh": "8a45cebb8bc4",
  "ko": "야아! 이 몸은 페페론. 조금 장난꾸러기에 짓궂은 요정 씨야!"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 75,
  "jh": "594c0309a30e",
  "ko": "이거 정중하게도. 아이고, 이렇게 듬직한 분이 딸의 힘이 되어 주다니 든든하군"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 9,
  "jh": "39c9ab5c36ec",
  "ko": "저는 고토라고 합니다. 앞으로 잘 부탁드립니다… 아버님"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 75,
  "jh": "c4f22ec320d7",
  "ko": "아, 아버님이라니…!? 클로에! 설마 이 남자랑"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 2,
  "jh": "564b6f3a38b0",
  "ko": "아무리 나라도 상대는 인간이 좋아…"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 1,
  "jh": "30ae75b4b3e3",
  "ko": "괜찮아요, 아저씨. 클로에는 이래 봬도 남자 취향이 까다롭거든요"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 75,
  "jh": "9b353aab622e",
  "ko": "저 에나라는 소년도 동료니?"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 2,
  "jh": "4727630add88",
  "ko": "응… 몇 안 되는 상식적인 애…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 1,
  "jh": "b498854e08c3",
  "ko": "크, 역시 무시당했어. 슬쩍 대화에 끼었는데…"
 },
 {
  "key": "m11",
  "kind": 5,
  "chr": -1,
  "jh": "c3ec00ea22ef",
  "ko": "곧 학부모 참관 특별 수업을 시작합니다. 학생은 집합해 주세요"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 8,
  "jh": "d4da832517ed",
  "ko": "이런, 시간이다"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 74,
  "jh": "0ffcba2b69b7",
  "ko": "아아, 에나… 엄마를 두고 가 버리는구나…"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 8,
  "jh": "8024aa9fa740",
  "ko": "영영 이별하는 것처럼 말하지 마"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 2,
  "jh": "6a7fe77bdde9",
  "ko": "그럼 이따 봐…"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 75,
  "jh": "e9381c0550f2",
  "ko": "힘내거라. 페페론 군, 고토 군, 에나 군. 딸을 잘 부탁하네"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 1,
  "jh": "2843130b4f55",
  "ko": "숫자에도 안 들어가…"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 10,
  "jh": "131a69576a8e",
  "ko": "우~우"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 18,
  "jh": "bcfdd5f9551d",
  "ko": "흠흠. 학부모 여러분, 바쁘신 와중에 와 주셔서 대단히 감사합니다"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 18,
  "jh": "5b4ff4ed32b0",
  "ko": "오늘은 저희 학교의 1년간 교육 성과를 보여 드리고자 이런 자리를 마련…"
 },
 {
  "key": "m21",
  "kind": 5,
  "chr": 12,
  "jh": "fe019b17fa1f",
  "ko": "시시한 서두는 거기까지다. 비켜라 비켜!"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 18,
  "jh": "d5d57bf10a28",
  "ko": "뭐, 뭐예요!? 지금 제가 인사를…"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 12,
  "jh": "80062a694329",
  "ko": "기뻐해라! 오늘도 네놈들을 위해 특별한 수업을 준비해 줬다"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 95,
  "jh": "83cb661a41b9",
  "ko": "으아… 또야…"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 106,
  "jh": "a83b7d082e40",
  "ko": "봐줘라. 아버지가 보러 왔다고…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 20,
  "jh": "c8f39ed497cc",
  "ko": "너무 멋대로 하게 두는 거 아냐?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 13,
  "jh": "6af5f021a051",
  "ko": "그렇게 말해도… 내가 말릴 수는 없잖아"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 20,
  "jh": "2bcc83c36da8",
  "ko": "이사장이 얌전해졌는데 이래서야 역효과로군"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 13,
  "jh": "4ff64a14fff4",
  "ko": "말씀하신 대로… 면목 없어"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 20,
  "jh": "ef1384bb48b3",
  "ko": "그래서, 특별 수업이란 건 이번엔 무슨 짓을 하는 거야?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 13,
  "jh": "105ba48b72a0",
  "ko": "나도 내용은 못 들었어. 기세로 허가해 버렸는데… 괜찮겠지?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 20,
  "jh": "78375a6afe4e",
  "ko": "…어떻게 돼도 난 모른다"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 12,
  "jh": "fbfa55f827ad",
  "ko": "이것저것 생각했다만, 학부모 앞에서 너무 거친 수업도 좀 그런 것 같아서…"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 12,
  "jh": "213fcf02ce1f",
  "ko": "그래서 이번엔 이거다!"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 12,
  "jh": "83cacbc41728",
  "ko": "「거대 몬스터 습격!? 학생들이여 일어서라. 학원을 지키기 위해!!」"
 },
 {
  "key": "m36",
  "kind": 5,
  "chr": 39,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m37",
  "kind": 5,
  "chr": 40,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 12,
  "jh": "4de170260271",
  "ko": "그럼 수업 시작!!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "967ec36e8743",
  "ko": "자, 잠깐만! 그것만으로는 무슨 소린지 전혀 모르겠잖아!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 12,
  "jh": "2223cf7c6a0a",
  "ko": "이해력이 부족한 녀석이군."
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 12,
  "jh": "a7f46c116607",
  "ko": "즉, 이날을 위해 이 몸이 몬스터 한 마리를 준비했다는 거다"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 12,
  "jh": "f47f8e131369",
  "ko": "무시무시하게 튼튼한 녀석이라. 한두 번 싸운 정도로는 절대 쓰러뜨릴 수 없다"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 12,
  "jh": "c8f51f31fc4e",
  "ko": "그 녀석이 지금 학원을 향해 진격해 오고 있다. 멋지게 막으면 네놈들의 승리다"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 12,
  "jh": "41564182a3d1",
  "ko": "하지만 만약 실패하면 이 학원은 몬스터에 의해 파괴되고 만다…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 12,
  "jh": "a32950dc7cfa",
  "ko": "어떠냐? 꽤 스릴 있는 수업이지"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 18,
  "jh": "86a30594db8a",
  "ko": "뭐, 뭐… 무슨 바보 같은 짓을!! 중지예요! 당장 중지하세요!!"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 12,
  "jh": "0856767beca5",
  "ko": "그게 튼튼하게 만든 만큼 머리가 좀 나빠져서 말이다. 전혀 제어가 안 된다"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 12,
  "jh": "e4ca6653f3f4",
  "ko": "녀석을 막으려면 쓰러뜨리는 수밖에 없다"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 18,
  "jh": "5c40ce59957a",
  "ko": "뭣… 그럼 만약 못 쓰러뜨리면…?"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 12,
  "jh": "66275bf9e6ed",
  "ko": "몇 번이나 말하게 하지 마라. 이 학원이 파괴될 뿐이다"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 18,
  "jh": "434641bc4e3f",
  "ko": "으~음…"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 13,
  "jh": "b3e6948a2085",
  "ko": "이사장님! 정신 차리세요!"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 12,
  "jh": "5b263945391a",
  "ko": "자, 시간이 별로 없다. 녀석은 겨울 고요의 설산에서 이 학원으로 오고 있다!"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 12,
  "jh": "25b56b58c284",
  "ko": "서둘러 현장으로 가서 몸을 던져 몬스터를 막고 오는 거다!!"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 9,
  "jh": "da7603c6be1f",
  "ko": "학원 전체를 인질로 잡다니… 스케일이 크군"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 2,
  "jh": "4980aca92647",
  "ko": "…차라리 부서져 버리면 좋을 것 같아"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 8,
  "jh": "45905b29b60a",
  "ko": "그럴 수는 없잖아…"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 6,
  "jh": "26f6551321de",
  "ko": "여기서 활약하면 학원을 구한 요정 씨들로 영원히 전해지겠네!"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 1,
  "jh": "ca534de85cbd",
  "ko": "왜 네가 주인공 취급이야!"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 8,
  "jh": "9db97be6533a",
  "ko": "야. 다른 녀석들 다 이동하고 있어"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 1,
  "jh": "90ddfe394c2b",
  "ko": "이런, 바보 상대할 때가 아니지. 우리도 가자"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]