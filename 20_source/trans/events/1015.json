  "ko": "그런! 모처럼 선물했는데!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 20,
  "jh": "36ae0fcaaa2d",
  "ko": "바보. 필요 없는 걸 받아도 방해만 될 뿐이잖아"
 },
 {
  "key": "m37",
