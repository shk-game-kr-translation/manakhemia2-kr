[
 {
  "key": "m0",
  "kind": 2,
  "chr": 20,
  "jh": "8190f9926653",
  "ko": "오, 벌써 선물 돌리고 왔냐?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 20,
  "jh": "c91188d83974",
  "ko": "라니, 너. 아무한테도 안 줬잖아!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "4a6a508cdf11",
  "ko": "응, 그치만 귀찮고"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 20,
  "jh": "1cfe10169f7d",
  "ko": "귀찮다니… 하아, 너한텐 감사하는 마음이라는 게 없나 보군"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 20,
  "jh": "108c6746fb16",
  "ko": "알았다. 무리해서 할 필요 없어. 얼른 돌아가"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 20,
  "jh": "55233b3b6293",
  "ko": "라니, 너 아직 전원한테 안 줬잖아"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "877f3687e99d",
  "ko": "그치만 다들 어려운 것만 요구하는걸"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 20,
  "jh": "21ddf3cd93b7",
  "ko": "…아무래도 너한텐 감사하는 마음이 부족한 것 같군"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 20,
  "jh": "9cf90a28ffad",
  "ko": "알았다, 이 시점에서 평가해 주지"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 20,
  "jh": "8a6dc21b1594",
  "ko": "뭐, 받은 선생님은 둘 다 만족한 것 같군"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 20,
  "jh": "33b042381264",
  "ko": "이왕이면 나머지 한 명한테도 줬으면 좋았을 걸…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "f013de34206f",
  "ko": "그치만 귀찮았고…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 20,
  "jh": "748242b0945f",
  "ko": "귀찮았다니… 뭐, 넌 그런 녀석이지"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 20,
  "jh": "511aff0dd3d7",
  "ko": "왠지 개운치 않지만 평가로는 그럭저럭이다. 자"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 20,
  "jh": "0549fb49cea7",
  "ko": "…한 명밖에 만족 안 한 것 같군"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "59e1d7fd0b02",
  "ko": "아, 아하하… 뭐, 한 명이라도 만족해 줬으면 된 거 아니야?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 20,
  "jh": "97d8387ceca2",
  "ko": "선생님 전원에게 감사하는 마음을 전하는 과제였는데…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 20,
  "jh": "7041f4de146c",
  "ko": "뭐 됐다, 최소한의 평가만은 주지. 자"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 20,
  "jh": "c1271e869e1d",
  "ko": "…한 명도 만족 안 했군"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "32acc2001d08",
  "ko": "그런! 모처럼 선물했는데!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 20,
  "jh": "36ae0fcaaa2d",
  "ko": "바보. 필요 없는 걸 받아도 방해만 될 뿐이잖아"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 20,
  "jh": "b6af7ae46ecc",
  "ko": "아무튼 이래선 평가 못 준다. 넌 인간으로서 한번 반성하는 게 좋겠다"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "e801b9e28cb1",
  "ko": "아~아. 이럴 줄 알았으면 아무한테도 선물 안 할걸…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "92d6bf577d78",
  "ko": "그러니까 그런 생각이 안 된다는 거야…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 20,
  "jh": "43b6a2e13315",
  "ko": "흥, 일단 전원한테는 건넨 것 같군"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 20,
  "jh": "2b779f984780",
  "ko": "하지만 문제는 상대가 기뻐했느냐다. 자…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 20,
  "jh": "d62597bf7c6c",
  "ko": "…오, 전원이 기뻐한 것 같군. 제법인데"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "b26f9e84844a",
  "ko": "그야 그렇지. 나의 마음이 담긴 선물인걸"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 20,
  "jh": "28a42c92e604",
  "ko": "…뭐, 됐다. 전원이 만족했으면 트집 잡을 데도 없지"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 20,
  "jh": "26e39ab94efd",
  "ko": "졸업해도 주변에 대한 감사하는 마음을 잊지 마라. 자"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 20,
  "jh": "ab9a50826ca6",
  "ko": "…두 명은 만족한 것 같군"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 20,
  "jh": "6b60d9d403f1",
  "ko": "이왕이면 나머지 한 명한테도 제대로 된 걸 줬으면 좋았을 걸…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "925f12e0b519",
  "ko": "으… 제대로 생각해서 선물했다고 생각했는데…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 20,
  "jh": "f752ed500795",
  "ko": "뭐, 너치곤 힘낸 편이군. 그 나름의 평가는 매겨 주지"
 },
 {
  "key": "m34",
