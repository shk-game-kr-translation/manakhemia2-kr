[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "db53d90497ae",
  "ko": "실례합니다~ 교장 선생… 윽! 이사장"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 18,
  "jh": "6a11d18c8d02",
  "ko": "…꽤나 대단한 인사군요. 제가 있으면 곤란한 일이라도?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "2c0552ab8257",
  "ko": "아니, 좀 놀랐을 뿐이에요… 뭐 그건 그렇고, 교장 선생님한테 볼일이 있어요"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 13,
  "jh": "06f427b21b87",
  "ko": "나한테? 이야, 기쁘네. 학생이 찾아와 주다니 좀처럼 없는 일이거든"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 2,
  "jh": "0d4d5b5b0c95",
  "ko": "그건 아주 납득이 가…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 13,
  "jh": "123e5778400c",
  "ko": "아니, 거기선 납득하지 말아 줬으면 하는데… 그래서 볼일이라는 건?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "4c28f2c2f880",
  "ko": "이 애 특훈을 시키려는데 방법을 몰라서…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 13,
  "jh": "8026f09471e6",
  "ko": "뭐? 마나 특훈?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 18,
  "jh": "6ed0316433fa",
  "ko": "또 시시한 소리를… 마나보다 본인을 단련하는 게 먼저 아닌가요?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "8cd3ab88b99d",
  "ko": "윽… 그, 그건…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 6,
  "jh": "2b75660efdde",
  "ko": "누나, 아픈 데를 찔렸네"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 9,
  "jh": "b3c90b2a3ebb",
  "ko": "여기서 어떻게 반격하느냐… 이거 볼만하겠군"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 18,
  "jh": "5a33ab33a277",
  "ko": "여름방학에 놀기만 하다가 새 학기 시작하자마자 퇴학당한 학생은 과거에 많아요"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 18,
  "jh": "579c6e171c0a",
  "ko": "뭐, 당신 같은 학생은 빨리 없어져 주는 편이 고맙지만요"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "bb64979954bd",
  "ko": "으… 시끄러워 시끄러워! 내 얘긴 됐어! 지금은 마나 얘기 중이야!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 6,
  "jh": "c2bfb07b44d0",
  "ko": "우와, 하필이면 적반하장으로 받아쳤어"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 9,
  "jh": "875875972a1c",
  "ko": "최악의 반격이군. 뭐, 감정적인 여자애도 나쁘지 않지만"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 2,
  "jh": "0d1f56743970",
  "ko": "완전히 얘기가 샜는데… 어때요? 교장 선생님…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 13,
  "jh": "796f73cc323a",
  "ko": "아니, 나한테 물어봐도… 봐, 난 마나가 없잖아…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 2,
  "jh": "650e4673f10d",
  "ko": "없어요…? 교장인데…?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 13,
  "jh": "fbff3ab35575",
  "ko": "응… 아, 아니 그게 아니라. 이건 이래저래 사정이 있어서…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "c2590b919eee",
  "ko": "제일 높은 사람인데. 믿을 수가 없네…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 2,
  "jh": "e52aaad48817",
  "ko": "왜 교장을 하는 걸까, 이 사람…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 9,
  "jh": "697f01f4e625",
  "ko": "꼭두각시 아닐까. 인망도 없어 보이고"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "0799a5ab31e1",
  "ko": "시간 낭비만 했어! 이사장한텐 비꼼 듣고… 최악! 정말, 가자 가자!"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 18,
  "jh": "476ffd099eb2",
  "ko": "…당신한텐 별 기대 안 하지만 학생들한테 너무 얕보이는 것도 문제예요"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 13,
  "jh": "ed6389ec929b",
  "ko": "네, 넵… 왜 이렇게까지 들어야 하는 거지…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 18,
  "jh": "a695ad306637",
  "ko": "뭐죠? 볼일은 끝난 거 아니었나요?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 9,
  "jh": "7b17fdca4996",
  "ko": "당신처럼 아름다운 분께 말도 걸지 않고 떠나는 건 용서받지 못할 죄라 생각해서요"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 18,
  "jh": "b9b5098eeb43",
  "ko": "네? 아, 아름답다…?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 9,
  "jh": "0edb507d4e51",
  "ko": "제 이름은 고토. 당신 마음 한구석에라도 남겨 주신다면 과분한 영광입니다"
 },
 {
  "key": "m31",
  "kind": 5,
  "chr": 6,
  "jh": "79cbd9cfd788",
  "ko": "어이~ 빨리 안 오면 두고 간대~!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 9,
  "jh": "6188fe0c422a",
  "ko": "…유감스럽게도 오늘은 시간이 없는 모양이군요… 다시 만날 날을 기대하겠습니다"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 18,
  "jh": "e5f308b0ab38",
  "ko": "고토… 님…"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 13,
  "jh": "eff117e9bd25",
  "ko": "이, 이사장님? 얼굴이 소녀가 됐는데요… 저기~?"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 6,
  "jh": "0d09c4d2f259",
  "ko": "정말 넌 가리는 게 없구나"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 9,
  "jh": "edef42df94a1",
  "ko": "내 잘못이 아니야. 세상 여성들이 하나같이 아름다운 게 잘못이지"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 6,
  "jh": "e5aac8e57373",
  "ko": "이 몸은 전혀 이해가 안 돼"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 9,
  "jh": "debc28136116",
  "ko": "넌 아직 어린애라는 거지. 자, 너무 기다리게 하면 또 혼나겠다"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]