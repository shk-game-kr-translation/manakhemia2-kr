[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "367a9cf12078",
  "ko": "…좋아. 제대로 따라오고 있네"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 24,
  "jh": "2c82379e8a68",
  "ko": "무슨 일 있어? 아까부터 뒤를 신경 쓰고"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "515eec49bf38",
  "ko": "아, 아무것도 아니야"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 24,
  "jh": "87de82780bc4",
  "ko": "역시 돌아가자. 몬스터가 나오면 우리끼리는…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "89f89cb38884",
  "ko": "괜찮아. 그것도 작전의 일부니까"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 24,
  "jh": "5590ff801110",
  "ko": "어?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "a69e54026295",
  "ko": "읏, 이쪽 얘기야. 뭐, 그렇게 되면 전력으로 도망치자"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 24,
  "jh": "4e13f7ffb96b",
  "ko": "으으, 무서워…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 7,
  "jh": "223be2c2387b",
  "ko": "릴리아, 좀 페이스가 떨어졌나?"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 4,
  "jh": "bb0755b1c2cf",
  "ko": "주인은 쉽게 질리는 면이 있으니까"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 11,
  "jh": "a4740bf9baae",
  "ko": "푸니요 씨… 이 다음 전개도 생각해 뒀나요?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 5,
  "jh": "e6c40535aa02",
  "ko": "푸니~, 니…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 23,
  "jh": "a5c62c1d817b",
  "ko": "여기까지 왔으면 이제 흐름에 몸을 맡길 뿐… 이래요"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 11,
  "jh": "2a1ebe75477f",
  "ko": "그거 아무 생각도 없다는 거 아니에요…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 5,
  "jh": "d1d3a19456a0",
  "ko": "푸니! 푸니니니!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 23,
  "jh": "048aaac6e945",
  "ko": "연애는 각본 없는 드라마다! …라며 여동생이 힘차게 말하고 있어요"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 11,
  "jh": "12acfbbb2ffa",
  "ko": "하는 말은 멋있는데요…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 24,
  "jh": "8a542ae39e1b",
  "ko": "릴리아 씨, 오늘 이상하네. 무슨 일 있었어?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "80e70b2ee8cb",
  "ko": "어? 난 평소대로야. 이상한 건 하나도…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 24,
  "jh": "dbb2505ebd37",
  "ko": "평소엔 좀 더 부드럽게 찌르고, 정말 싫어하기 직전에 멈춰 주고…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "b4ed929fe7e7",
  "ko": "그, 그랬던가…?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 24,
  "jh": "3899cc0c31cf",
  "ko": "왠지 짜증 난 것 같은 느낌이야"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 24,
  "jh": "915cc2c43915",
  "ko": "날 찔러서 기분이 풀린다면 찔려도 괜찮을까 싶지만…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 3,
  "jh": "aab5364e038d",
  "ko": "읏! 이 얼마나 기특한 말을…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 24,
  "jh": "a108168c7744",
  "ko": "사실은 찌르기 전에 상담해 주면 제일 기쁘겠지만"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 24,
  "jh": "8c8bb8fd5c3e",
  "ko": "아아, 그래도 나 같은 건 미덥지 않으려나…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 3,
  "jh": "fcb3a34fd2c9",
  "ko": "으으으… 그렇게 촉촉한 눈으로 바라보면…!"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 7,
  "jh": "987fe7035e6e",
  "ko": "왠지… 릴리아가 꼬셔지고 있어!?"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 0,
  "jh": "da135634a9c6",
  "ko": "정말이냐…?"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 5,
  "jh": "458c535d2a1a",
  "ko": "푸니… 푸니~!"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 23,
  "jh": "90d85537c396",
  "ko": "사부로의 천연이 기적을 일으키려 하고 있다… 라며 여동생도 흥분을 감추지 못해요"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 11,
  "jh": "0d74cd07a2a7",
  "ko": "이대로 아가씨가 넘어가면 엄청나게 재밌어지겠네요…"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 24,
  "jh": "518280ed1ddb",
  "ko": "그러니까 앞으로는 찌르기 전에… 저기, 듣고 있어?"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 3,
  "jh": "9ab3be154cc9",
  "ko": "(뭐, 뭐야? 이 가슴의 두근거림은… 안 돼! 나에겐 로제가…!)"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 3,
  "jh": "0224aae83945",
  "ko": "(그래도 언제까지고 미적지근한 상대보다 진심으로 걱정해 주는 사람 쪽이)"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 3,
  "jh": "a178cc56ade6",
  "ko": "(촉감만 따지면 발군이고… 장래를 생각하면 인간 쪽이…)"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 3,
  "jh": "9c31460b3319",
  "ko": "(아아! 어째서!? 어째서 당신은 푸니푸니인 거야!?)"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 3,
  "jh": "cebd8bff0a93",
  "ko": "으으… 난… 에잇! 정했어!"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 3,
  "jh": "d9574495af32",
  "ko": "어? 아, 어머…"
 },
 {
  "key": "m40",
  "kind": 5,
  "chr": 24,
  "jh": "06167a0700a7",
  "ko": "위험해! 릴리아 씨도 빨리 도망쳐~!"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 3,
  "jh": "bd5d0156fb58",
  "ko": "…뭐? 잠깐! 왜 먼저 도망… 야!?"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 0,
  "jh": "9afd3b15b3fa",
  "ko": "정말 손이 많이 가는…"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 3,
  "jh": "e85e284cb1a3",
  "ko": "로제!"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 11,
  "jh": "fee230b10903",
  "ko": "아가씨… 망상하실 땐 주변 안전을 확인해 주세요"
 },
 {
  "key": "m45",
  "kind": 0,
  "chr": 7,
  "jh": "c375465d6421",
  "ko": "아~아, 모처럼 재밌는 데였는데~"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 5,
  "jh": "68159c57be62",
  "ko": "푸니! 푸니니!"
 },
 {
  "key": "m47",
  "kind": 0,
  "chr": 23,
  "jh": "8195da058ddc",
  "ko": "다음 전개를 기대하던 여동생도 드물게 진심으로 화났어요"
 },
 {
  "key": "m48",
  "kind": 0,
  "chr": 58,
  "jh": "16e9938da994",
  "ko": "기? 기… 기~!?"
 },
 {
  "key": "m49",
  "kind": 0,
  "chr": 0,
  "jh": "1680756593b3",
  "ko": "아가씨는 물러나 계세요. 그 상태론 못 싸우실 테니까"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 3,
  "jh": "680903a65609",
  "ko": "으, 응…"
 },
 {
  "key": "m51",
  "kind": 0,
  "chr": 0,
  "jh": "7afc7f4fe0ec",
  "ko": "후우… 대단한 몬스터는 아니었군"
 },
 {
  "key": "m52",
  "kind": 0,
  "chr": 3,
  "jh": "a335726a350e",
  "ko": "저, 저기… 로제…"
 },
 {
  "key": "m53",
  "kind": 0,
  "chr": 0,
  "jh": "f1deb6aa5765",
  "ko": "혼자 밖에 나가지 말라고 했잖아요. 뒤를 밟았으니 망정이지…"
 },
 {
  "key": "m54",
  "kind": 0,
  "chr": 3,
  "jh": "8b7b772314ae",
  "ko": "그건, 그치만… 네가 너무, 그…"
 },
 {
  "key": "m55",
  "kind": 0,
  "chr": 0,
  "jh": "1cfd5e5f863d",
  "ko": "그치만이 아니에요! 아가씨 몸에 무슨 일이 생기면 제가…"
 },
 {
  "key": "m56",
  "kind": 0,
  "chr": 3,
  "jh": "f5618623cb9c",
  "ko": "힉… 으… 훌쩍… 미안해애…"
 },
 {
  "key": "m57",
  "kind": 0,
  "chr": 0,
  "jh": "a58d9464899d",
  "ko": "주인어른께 혼나… 라니, 울 것까진 없잖아요"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 3,
  "jh": "faee6c05591c",
  "ko": "내가 어떻게 됐었나 봐… 푸니푸니의 감촉에 홀려서. …으, 으아아앙!"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 0,
  "jh": "0771151085c0",
  "ko": "그, 그렇게 세게 혼내지 않았잖아요"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 11,
  "jh": "0c2d293045c9",
  "ko": "아마 다른 이유로 우시는 것 같아요"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 0,
  "jh": "72636f54d334",
  "ko": "뭐야! 다른 이유라니"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 5,
  "jh": "15256a921724",
  "ko": "푸니~… 푸니니니…"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 23,
  "jh": "b1a1f61e840d",
  "ko": "구해진 기쁨, 혼난 슬픔, 스스로 저지른 정신적 배신…"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 23,
  "jh": "724b4513daf3",
  "ko": "여러 감정이 뒤얽혀 눈물이 되어 흘러넘친 거겠지… 라고 여동생은 분석하고 있어요"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 0,
  "jh": "5e4a10bf6fa1",
  "ko": "전혀 무슨 뜻인지 모르겠는데…"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 11,
  "jh": "b4da727ea4b6",
  "ko": "몰라도 되니까 일단 달래 드리세요"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 5,
  "jh": "fdec7651cf32",
  "ko": "푸니~… 푸니니"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 23,
  "jh": "34933c9fe922",
  "ko": "나머진 젊은 두 사람에게 맡기고… 라며 여동생이 자리를 뜨자고 해요"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 4,
  "jh": "5c6e07f40215",
  "ko": "그러도록 하지. 아무래도 여자 울음소리는 질색이다"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 7,
  "jh": "6c5f00861072",
  "ko": "그러네. 이제 충분히 재밌었고. 그럼 힘내!"
 },
 {
  "key": "m71",
  "kind": 0,
  "chr": 0,
  "jh": "cd84dbbc8645",
  "ko": "어, 야! 이 상태로 두고 가지 마"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 3,
  "jh": "039bdba5cea1",
  "ko": "으으으… 히끅… 으앙…"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 0,
  "jh": "79f95fb0085c",
  "ko": "아아, 정말… 빨리 그쳐 주세요"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 3,
  "jh": "0fe2a736bbfb",
  "ko": "으윽… 히끅…"
 },
 {
  "key": "m75",
  "kind": 2,
  "chr": 0,
  "jh": "ea16702e24b2",
  "ko": "그러고 보니 아가씨는 한번 울면 오래 가셨죠… 오랜만이라 잊고 있었네"
 },
 {
  "key": "m76",
  "kind": 2,
  "chr": 3,
  "jh": "d2701b57faf3",
  "ko": "훌쩍… 으아아앙…"
 },
 {
  "key": "m77",
  "kind": 2,
  "chr": 0,
  "jh": "4872bf0006b9",
  "ko": "느긋하게 기다릴 수밖에 없나…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]