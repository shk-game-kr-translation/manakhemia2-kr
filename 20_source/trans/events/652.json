 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 8,
  "jh": "86b9488e9f32",
  "ko": "마음은 고맙지만 이제 나만 만질 수 있는 부분이라서"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 8,
  "jh": "adb5907dd04a",
  "ko": "아직 시간 걸리니까 먼저 돌아가"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 2,
  "jh": "5f982a9971a5",
  "ko": "그럼 말씀에 따라…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "e446ea04d154",
  "ko": "내일을 대비해서 푹 쉬어 둬야지!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 9,
  "jh": "f9d091e023ff",
  "ko": "하하하. 싸우는 건 네가 아니지만"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "bd2d436d8161",
  "ko": "그럼 나도 돌아가지만… 너도 일찍 쉬어"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 8,
  "jh": "6b0ea8924ffd",
  "ko": "아~ 네네. 알고 있다니까"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "f4678d126295",
  "ko": "정말 알고 있는 걸까…"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 1,
  "jh": "ba881aafb353",
  "ko": "…그래서 신경 쓰여서 와 봤더니"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 1,
  "jh": "fcd94f08b92e",
  "ko": "이놈! 언제까지 할 생각이야!?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 8,
  "jh": "9de62e695212",
  "ko": "으악!? 깜짝이야… 벌써 그런 시간이야?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "34d5023c9e4a",
  "ko": "진작 한밤중이야! 애들은 잘 시간!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "c48420f49fd3",
  "ko": "내일 잠 부족으로 제대로 못 싸워도 난 몰라"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 8,
  "jh": "c5c5068babaf",
  "ko": "그건 괜찮겠지. 내 경우 기계 성능이 전부니까. 컨디션 같은 건 상관없어"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "2f6bdde75d75",
  "ko": "…방금 엄청 한심한 소리 한 거 알아?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 8,
  "jh": "8f5ab3055178",
  "ko": "으… 어쩔 수 없잖아. 사실이니까!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "9be92a4a2278",
  "ko": "상대는 그 교감이잖아. 성실하게 해도 이길 리가 없을 것 같은데"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 8,
  "jh": "699788604868",
  "ko": "…있잖아, 남의 노력을 전부 부정하지 말아 줘"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "9c1979f9c7bd",
  "ko": "사실이니까 어쩔 수 없잖아"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 8,
  "jh": "cc7d81c245b7",
  "ko": "으… 뭐, 나도 진심으로 이길 거라곤 생각 안 하지만. 다만…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 8,
  "jh": "3cb7fba1f701",
  "ko": "지더라도 쉽게 지면 꼴사납잖아? 그렇게 큰소리쳐 놓고…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "1de8b40a5d04",
  "ko": "네가 꼴사나운 건 늘 있는 일이잖아"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 8,
  "jh": "2cb00559953c",
  "ko": "…큰일이다, 울고 싶어졌어. 울어도 돼?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "c1a8fdddb1c7",
  "ko": "귀찮으니까 하지 마. 자, 됐으니까 빨리 자. 나도 못 자잖아"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 8,
  "jh": "af969db1d988",
  "ko": "왜? 얼른 자면 되잖아"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "4759d82d8b40",
  "ko": "신경 쓰여서 못 자. 네가 잘 때까지 지켜볼 거야"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 8,
  "jh": "0ed39d61e74c",
  "ko": "보고 있으면 집중이 안 되는데…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "ffadcc7ba60e",
  "ko": "빤히…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 8,
  "jh": "b7dbb40cbc1d",
  "ko": "아니, 그러니까. 집중이 안 된다고"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "befd2c1019d6",
  "ko": "그쪽이 아니라 네 머리 보고 있었어. 어디에 기계가 묻혀 있나 해서"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 8,
  "jh": "b03994621aca",
  "ko": "아아, 그쪽이냐… 전혀 감각이 없어서 나도 모르겠어"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 1,
  "jh": "77aaba62d7d6",
  "ko": "앗, 잘 보니 딱지가 남아 있네. 꾹꾹"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 8,
  "jh": "785223931e70",
  "ko": "와! 그만해! 간지럽잖아!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "27ca0ddb7716",
  "ko": "이런 건 괜히 떼고 싶어지지~"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 8,
  "jh": "33ec3a3d84cd",
  "ko": "자기 딱지로 해! 그런 건!"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 1,
  "jh": "0f40b06ea486",
  "ko": "괜찮잖아, 쩨쩨하게 굴지 않아도… 어라?"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 1,
  "jh": "a1726f227310",
  "ko": "뭐가 떨어졌어?"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 8,
  "jh": "9798b84d578d",
  "ko": "아아… 응? 이건…"
 },
