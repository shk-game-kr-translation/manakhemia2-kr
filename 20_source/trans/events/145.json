[
 {
  "key": "m0",
  "kind": 0,
  "chr": 12,
  "jh": "22f384cfdef7",
  "ko": "또 학생이 줄었군. 방학이 끝나면 퇴학자가 나오는 건 어느 시대나 똑같군"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 95,
  "jh": "fee3e67f95e7",
  "ko": "대부분은 선생님 수업 탓인 것 같은데요…"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 12,
  "jh": "2e0cb23dcf17",
  "ko": "그 정도로 그만두는 녀석은 애초에 볼일 없다"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 12,
  "jh": "81c3abaf5e91",
  "ko": "그런 의미에서 지금 남은 네놈들은 다소 가망이 있다는 거다"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 83,
  "jh": "70859ce6a0b4",
  "ko": "별로 안 기뻐요… 저도 방학 동안 그만둘 걸 그랬나"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 12,
  "jh": "56b7d8f0382c",
  "ko": "뭐냐, 패기 없는 녀석이군. 그래서야 견학 오시는 부모님이 슬퍼하신다"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 95,
  "jh": "10b45d268924",
  "ko": "부모님이… 견학?"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 12,
  "jh": "b16712788afd",
  "ko": "음. 이른바 학부모 참관이다. 전교생을 모아 부모 앞에서 합동 수업을 할 예정이다"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 106,
  "jh": "75912a7cdc59",
  "ko": "진짜냐… 최악이야. 부모가 보러 오다니…"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 81,
  "jh": "e5caa083a723",
  "ko": "전… 조금 기쁠지도. 방학 때도 집에 전혀 못 갔거든요"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 12,
  "jh": "c1835e60fcaa",
  "ko": "부디 꼴사나운 모습 안 보이게 열심히 해라. 그럼 오늘은 이것으로 해산!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 7,
  "jh": "5dfcf071c4c4",
  "ko": "학부모 참관이라~ 아빠들 와 줄까~… 우와~ 기대된다!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "ff96a75f09a2",
  "ko": "…큰 소리 안 내도 들려"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 7,
  "jh": "e30456930415",
  "ko": "좋잖아, 큰 소리쯤! 로제네는 아빠랑 엄마가… 아"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "470a89e23151",
  "ko": "아아, 우리 집은 둘 다 없어. 철들기 전부터"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 7,
  "jh": "edf9c533f4a9",
  "ko": "그랬지… 미안"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "f036aab140ae",
  "ko": "딱히 신경 안 써. 그보다 좀 조용히 있어 줘"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 7,
  "jh": "939161ed0210",
  "ko": "으, 얼굴 무서워… 으악~! 로제가 화났다~!"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 0,
  "jh": "5305a8223e10",
  "ko": "합동 수업이라… 그 녀석들도 나오겠지…"
 },
 {
  "key": "m19",
  "kind": 5,
  "chr": 14,
  "jh": "9ee22cf27462",
  "ko": "그럼 말이야, 시험 삼아 한번 마나를 베어 보면 되지 않을까?"
 },
 {
  "key": "m20",
  "kind": 5,
  "chr": 14,
  "jh": "9e19d77772d2",
  "ko": "울리카라고 했던가. 그 애 마나라면 딱 좋지 않아?"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 0,
  "jh": "d0f5b39be692",
  "ko": "만약 기회가 있다면… 라니. 바보 같군"
 },
