[
 {
  "key": "m0",
  "kind": 2,
  "chr": 0,
  "jh": "739c5b96f9b4",
  "ko": "얼마나 걸었을까… 젠장, 왜 이런 일이…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 7,
  "jh": "8fe3bcd1bd64",
  "ko": "자자, 그건 말 안 하기로 약속했잖아~"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "e4ee48829615",
  "ko": "약속? 나 몰래 무슨 약속을!?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 0,
  "jh": "e27244a9a739",
  "ko": "이 녀석 말에 일일이 반응하지 마세요!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "2c9de8dd2e97",
  "ko": "어? 그런… 소리 안 질러도…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 11,
  "jh": "949b2be896a4",
  "ko": "평소 대우 탓 아닐까요? 이것저것 쌓인 것도 있을 테고요"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "bf0363936cde",
  "ko": "그, 그래? 내가 뭔가 화나게 할 만한 일을…?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "ddb5ada8974e",
  "ko": "그런 건 아니고… 아무튼 좀 조용히 해 주세요"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 3,
  "jh": "c98223f0da72",
  "ko": "알았어…"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 0,
  "jh": "44abc13ef973",
  "ko": "(뭘 짜증 내는 거야, 난… 역시 이 반지의…)"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 14,
  "jh": "0ca06b405cfc",
  "ko": "왜 그래? 기분 나쁜 얼굴인데"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "8f3dd1a98890",
  "ko": "딱히, 안 그래"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 14,
  "jh": "50d1c845559a",
  "ko": "그런가? 전에 만났을 때는… 아아, 역시 기분 나쁜 얼굴이었네"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 7,
  "jh": "7980417db8cd",
  "ko": "있잖아 있잖아. 그 사람 아는 사이야?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "d010d3df9ce5",
  "ko": "아는 사이라고 할 정도는… 우와아!?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 14,
  "jh": "9dd223fe868a",
  "ko": "그렇게 놀랄 것까진. 상처받네"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "c373d39721bc",
  "ko": "놀라지, 보통! 뭘 자연스럽게 끼어 있는 거야!?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 14,
  "jh": "d469e79184dd",
  "ko": "멀리서 보여서. 말 정도는 거는 게 예의일 것 같아서"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 0,
  "jh": "7c992599b777",
  "ko": "…아니, 마침 잘됐다. 당신한테 물어볼 게 있었어"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 7,
  "jh": "5c1b5c605d22",
  "ko": "맞아! 우리 길을 잃어버렸어. 돌아가는 길 알아?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 14,
  "jh": "2eade39b519c",
  "ko": "응, 뭐. 이 근처는 자주 돌아다니니까"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 7,
  "jh": "b5223f07f91e",
  "ko": "정말? 해냈다!"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 0,
  "jh": "5ee8ef92db07",
  "ko": "아니, 내가 묻고 싶은 건 길이 아니라…"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 14,
  "jh": "06d83fa2d939",
  "ko": "자자. 지금은 그럴 상황이 아닌 것 같으니 얘기는 나중에"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 0,
  "jh": "0957720fdcc5",
  "ko": "…나중에, 로군. 알았다"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 14,
  "jh": "e2dee19e801e",
  "ko": "그렇게 노려보지 않아도 돼. 괜찮아, 도망 안 가"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 3,
  "jh": "c45037337f38",
  "ko": "뭐야, 저 사람. 로제랑 저렇게 친해 보이고… 서, 설마!?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 11,
  "jh": "b9f4e15cb94f",
  "ko": "오늘 아가씨는 상상력이 풍부하시네요…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "d09ed123b57c",
  "ko": "그래도 엄청 잘 어울린다고 할까, 그림이 된다고 할까…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 5,
  "jh": "c855dcd1797b",
  "ko": "푸니~… 푸니!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 23,
  "jh": "22171587f3dd",
  "ko": "여동생은 로제 씨가 당하는 쪽인 게 취향인가 봐요"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 3,
  "jh": "972c2a173efe",
  "ko": "역시? 마음이 맞네!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 4,
  "jh": "ce83e3555005",
  "ko": "…인간 여자는 이런 얘기를 좋아하는군"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 22,
  "jh": "2facea9c4766",
  "ko": "후… 푸니요도 사람의 자식이라는 건가…"
 },
 {
  "key": "g0s0",
