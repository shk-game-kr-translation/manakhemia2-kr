[
 {
  "key": "m0",
  "kind": 0,
  "chr": 8,
  "jh": "1e8e272c11b6",
  "ko": "으악… 뭐야, 저 인파는…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 6,
  "jh": "116f7d03c8b9",
  "ko": "다들 형이 목적인가?"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 88,
  "jh": "7f0a8182ce1e",
  "ko": "에나 군, 빨리 안 돌아오려나…"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 87,
  "jh": "5ad8d6220329",
  "ko": "잠깐, 친한 척 부르지 마. 에나 군은 내 거니까"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 86,
  "jh": "952eafbf302a",
  "ko": "어머? 언제 당신 거가 됐나요?"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 88,
  "jh": "923c92113a9c",
  "ko": "맞아 맞아! 에나 군은 내가 제일 먼저 찜했다고!"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 87,
  "jh": "026d8abac96d",
  "ko": "끼잇! 이렇게 된 이상 누가 에나 군에게 어울리는지 승부야!"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 86,
  "jh": "9ae46ae5f084",
  "ko": "바라던 바예요!!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "0fdf34b50bb6",
  "ko": "왠지 분위기가 험악하네"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 8,
  "jh": "61f2946e6c74",
  "ko": "무슨 주술이야… 저만한 인원을 이상하게 만들다니…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "f5215df542b0",
  "ko": "그렇게 칭찬하면 쑥스러워…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 8,
  "jh": "069c4e570435",
  "ko": "칭찬한 거 아니거든! 그보다 어쩔 거야. 저래선 아틀리에에 못 가잖아"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 2,
  "jh": "246144253777",
  "ko": "곤란한 건 에나 군뿐이고…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 8,
  "jh": "223a21c563c4",
  "ko": "야!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 9,
  "jh": "01a0b37a4eff",
  "ko": "여자끼리 다투는 모습은 보고 싶지 않군… 여긴 내게 맡겨 주게"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 6,
  "jh": "c11d6d55a7f7",
  "ko": "괜찮겠어?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 9,
  "jh": "0e67363083f7",
  "ko": "아아, 내가 타이르면 여자애들은 알아줄 거야"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 9,
  "jh": "6da972d3d710",
  "ko": "결코 에나 군에게 인기를 빼앗겨서 질투하는 건 아니야?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 6,
  "jh": "8266d9d8868c",
  "ko": "하하하. 살짝 본심이 나왔네"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 9,
  "jh": "bf24de51f0ab",
  "ko": "그럼, 잠깐 다녀오지"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 9,
  "jh": "9b35a5d30adc",
  "ko": "여어, 자네들. 잠깐 내 얘기 좀 들어 주지 않겠나"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 86,
  "jh": "ebb488d857a0",
  "ko": "뭐예요? 이 더러운 탈인형은?"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 87,
  "jh": "08074057a498",
  "ko": "이 녀석, 에나 군 아틀리에에 눌러사는 탈인형이야!"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 88,
  "jh": "8dbf0920c175",
  "ko": "못생긴 탈인형이네. 징그러워!"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 9,
  "jh": "ceb2a53be962",
  "ko": "모, 못생겼다니!?"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 86,
  "jh": "227170b629f6",
  "ko": "수세미 같은 얼굴로… 이런 게 에나 군이랑 같이 있다니!!"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 87,
  "jh": "da5792f811b6",
  "ko": "다가오지 마! 더러워!"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 9,
  "jh": "6e39c8de424f",
  "ko": "기다려 주게! 자네들은 냉정함을 잃은 거야"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 9,
  "jh": "f9bbaa9cd016",
  "ko": "자, 잘 보라고? 이 초롱초롱한 눈동자와 어른의 멋이 담긴 입가…"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 88,
  "jh": "b5def2e49b09",
  "ko": "싫어, 징그러워!"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 86,
  "jh": "674ddef94b21",
  "ko": "여러분. 협력해서 먼저 이 녀석을 해치워 버려요"
 },
 {
  "key": "m31",
  "kind": 5,
  "chr": 9,
  "jh": "f6b07f8cb2da",
  "ko": "자, 더 잘 보라니까! 라니, 오오오오오!?"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 6,
  "jh": "66567a5e18ca",
  "ko": "오오이런! 이건 혹시 친구의 위기!? 지금 구하러 갈게!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 8,
  "jh": "1681f7278e30",
  "ko": "으아… 괜찮냐, 저 녀석들"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 2,
  "jh": "41f000cfdd4b",
  "ko": "…지금이 기회네"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "ea3c525c23d7",
  "ko": "어? 하지만 구해야…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 2,
  "jh": "13e6596f068e",
  "ko": "…저 둘이 발을 묶어 두는 지금이 찬스"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 8,
  "jh": "9a620cb418bf",
  "ko": "그야 그럴지도 모르지만…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 2,
  "jh": "bc717c38c21c",
  "ko": "서두르지 않으면 들켜…"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 8,
  "jh": "2b959ffc957d",
  "ko": "인정사정없네…"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 1,
  "jh": "a6f016eb3240",
  "ko": "뭐, 클로에는 옛날부터 저랬으니까…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]