[
 {
  "key": "m0",
  "kind": 2,
  "chr": 28,
  "jh": "ea8fea692263",
  "ko": "음, 오늘은 효율 좋은 채취에 대해 가르쳐 보려고 해요"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 28,
  "jh": "2952f2e41af9",
  "ko": "다들 곡괭이나 낚싯바늘, 돋보기 같은 아이템을 써 본 적 있니?"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 1,
  "jh": "a9720cb22e0a",
  "ko": "없는데… 어떤 아이템이야?"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 28,
  "jh": "43c9ac0ff743",
  "ko": "이건 채취 작업 효율을 올리기 위한 아이템이야"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 28,
  "jh": "357b691d97c2",
  "ko": "곡괭이면 광석이, 낚싯바늘이면 사냥감이 잔뜩 잡히는 식으로…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 1,
  "jh": "83df9552f50c",
  "ko": "그런 편리한 게…!? 왜 좀 더 빨리 안 가르쳐 준 거야!"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 28,
  "jh": "0b7aad9e9e53",
  "ko": "죄, 죄송해요! 일단 그, 수업에도 순서가 있어서…"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 2,
  "jh": "76a5f43e9338",
  "ko": "울리카… 수업이 안 나가니까 조용히 해…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 1,
  "jh": "470c2eb2cd5a",
  "ko": "우~… 어쩔 수 없네. 오늘은 봐줄게"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 28,
  "jh": "f3ffca4f0980",
  "ko": "가, 감사합니다…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 28,
  "jh": "d2fa0833cecf",
  "ko": "그래서 이번 수업인데, 이 아이템들을 직접 만들어서 실제로 채취 작업을…"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 1,
  "jh": "09f970659011",
  "ko": "직접 만들어? 레시피는?"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 28,
  "jh": "dcd5fb23ad54",
  "ko": "레시피는… 매점에서 사 주시면…"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 1,
  "jh": "d3ccdba1ae12",
  "ko": "왜? 수업에 쓰는데… 그 정도는 공짜로 나눠 줘!"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 28,
  "jh": "5c86c36e2484",
  "ko": "죄, 죄송해요! 저도 그러고 싶은데 이사장님 명령으로…"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 2,
  "jh": "2fe0bf8c236d",
  "ko": "약한 입장의 인간은 어느 시대든 계속 착취당할 운명이지…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 28,
  "jh": "8d85ce251ec2",
  "ko": "으, 그렇게 말하면…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 28,
  "jh": "b6db7c7bd23b",
  "ko": "어, 그러니까, 아무튼 이번엔 연타 곡괭이를 직접 만들어서…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 28,
  "jh": "9c4424263fe5",
  "ko": "그 뒤 낡은 채석장에서 실제로 채취를 하고 와. 그럼 오늘은 여기까지!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "eda091a6eb84",
  "ko": "앗, 도망갔다!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 2,
  "jh": "44b338db3bc3",
  "ko": "정말 멀쩡한 선생님이 없는 학교… 어쩔래?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "4198827f95f1",
  "ko": "어쩌냐고 해도 안 할 수도 없고…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "c86ba5aaa390",
  "ko": "어쩔 수 없네. 일단 해 볼 만큼 해 보자"
 },
 {
  "key": "g0s0",
