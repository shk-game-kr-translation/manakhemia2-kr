[
 {
  "key": "m0",
  "kind": 0,
  "chr": 13,
  "jh": "f0bab7496651",
  "ko": "다들 모였니? 그럼 바로 수업을 시작할게"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 89,
  "jh": "a0e66edbf2c1",
  "ko": "어라? 교장 선생님이 수업하시는 거예요?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 13,
  "jh": "d3262bcf372a",
  "ko": "아아, 응. 예산 문제로 교직원도 일손이 부족해서… 하아"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 13,
  "jh": "f860ac41c156",
  "ko": "교장이 되면 거만하게 교장실에서 거드름 피울 수 있을 줄 알았는데…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 13,
  "jh": "cd0e0cf60904",
  "ko": "이런, 상관없는 얘기를 했네. 수업 수업, 하고"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 13,
  "jh": "11d0b8b32543",
  "ko": "올해 이 학원엔 전투기술과가 생겼는데"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 13,
  "jh": "86b5ec00aa0d",
  "ko": "그 전부터 전투에 관한 수업은 제대로 하고 있었어"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 89,
  "jh": "75403c2d3bfa",
  "ko": "네… 그래요…?"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 13,
  "jh": "b68328d9ff2a",
  "ko": "응. 연금술이란 건 여러모로 위험이 따르는 학문이니까"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 13,
  "jh": "a0a5b96b5a8d",
  "ko": "재료 캐러 가면 몬스터랑 싸워야 하고"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 13,
  "jh": "7c6bf1eff066",
  "ko": "어쩌면 지식을 노린 악당에게 습격당할지도 몰라…"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 13,
  "jh": "0656e4b6eeb5",
  "ko": "그런 이유로. 오늘은 전투의 기본인 유나이트에 대해 가르쳐 줄게"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 87,
  "jh": "867e107c76a7",
  "ko": "유나이트…? 그게 뭔데요?"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 13,
  "jh": "0227bcfd57d7",
  "ko": "유나이트란 전투를 효율적으로 해 나가면 발생하는 어떤 상태를 말해"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 87,
  "jh": "2e32651f9aba",
  "ko": "전투를 효율적으로…"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 13,
  "jh": "bb00d0e480d5",
  "ko": "응, 예를 들어 연속으로 대미지를 주거나 적의 약점을 공격하거나…"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 13,
  "jh": "79af59cf02d3",
  "ko": "그렇게 유나이트 상태가 되면 점점 동료와 호흡이 맞아서"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 13,
  "jh": "0f77adb89662",
  "ko": "동료의 서포트나 공격 타이밍이 빨라지거나 해"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 13,
  "jh": "3299332d7b30",
  "ko": "간단히 말하면 전투 스피드가 올라서 그동안 적을 마구 때린다! 는 거지"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 96,
  "jh": "22927786b6d9",
  "ko": "오오, 왠지 대단할 것 같아!"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 13,
  "jh": "7d79889fb092",
  "ko": "그것만이 아니라 다른 효과도 이것저것 있지만…"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 13,
  "jh": "7df1ab14c052",
  "ko": "오늘은 우선 유나이트를 체험해 보는 데까지 할까"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 13,
  "jh": "9c7b6eb8a047",
  "ko": "그럼 다들 물이 사는 숲에 가서 코다치랑 싸우고 오도록"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 98,
  "jh": "770561bc6ede",
  "ko": "갑자기 전투예요? 괜찮을까…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 13,
  "jh": "c3292e8381dc",
  "ko": "괜찮아. 그렇게 강한 적은 아니니까"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 13,
  "jh": "9ef353561e8b",
  "ko": "그냥 쓰러뜨리는 게 아니라 유나이트가 발생하도록 의식해"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 13,
  "jh": "8083d8119116",
  "ko": "끝나면 교장실로 보고하러 오도록. 그럼 오늘은 여기까지"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "9f4759071822",
  "ko": "전투 과제라… 그럼 페페론도 데려가는 게 좋겠네"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 2,
  "jh": "d2a1573db016",
  "ko": "그렇긴 한데… 그래도…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "a2f03effc4dd",
  "ko": "응? 뭐야"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 2,
  "jh": "d484718ce4b4",
  "ko": "유나이트는 동료랑 호흡을 맞추는 거라… 요정 씨랑은 좀…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "4c55374dcb49",
  "ko": "아아, 확실히… 그래도 성적엔 바꿀 수 없어. 참자"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]