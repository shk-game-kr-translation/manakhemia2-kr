[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "76cfc55294f9",
  "ko": "하아, 하아… 어라? 적은 어디 갔어?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "9c91236c07ee",
  "ko": "도망간 것 같아…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 9,
  "jh": "9bfd54b5fea0",
  "ko": "그만한 대미지를 받고 저 도주 속도… 적은 상당히 도망치는 데 익숙한 모양이군"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 8,
  "jh": "3075269ffc89",
  "ko": "뭐야, 도망치는 데 익숙하다는 건"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "460b4ab10468",
  "ko": "영문을 모르겠어! 토니 선생님은 안 오고! 이상한 건 덮쳐 오고!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "1d0e0ef5477b",
  "ko": "이제 됐어! 돌아가서 잘래!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 6,
  "jh": "2003c0c40e4f",
  "ko": "에에에, 괜찮아? 나중에 선생님한테 혼날걸?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "813b2d8a1ee7",
  "ko": "몰라! 언제까지고 안 오는 토니 선생님이 나빠!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 8,
  "jh": "d69060f3da6e",
  "ko": "가 버렸다… 괜찮아? 내버려 둬도"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 2,
  "jh": "f93fdc13ded6",
  "ko": "아마 괜찮아… 왜냐면 방금 그림자…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 9,
  "jh": "ad1866c4bae6",
  "ko": "이런. 그 이상은 말하지 않는 게 배려야. 그의 명예를 위해서라도"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 8,
  "jh": "a12590db8e70",
  "ko": "뭐? 무슨 소리야?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 9,
  "jh": "5b33d2e95f90",
  "ko": "세상엔 모르는 게 나은 것도 있어. 자, 우리도 돌아가서 쉬자"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 8,
  "jh": "20ed983a68cc",
  "ko": "앗, 야! 기다려!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "70c4d2a5f326",
  "ko": "음~… 역시 사과해 두는 게 좋겠지"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "1ab1ea0d90af",
  "ko": "엄청 화났겠지… 에잇, 될 대로 되라! 실례합니다!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 20,
  "jh": "536c3a9862a0",
  "ko": "…뭐야, 너냐"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "c3e8022ba17e",
  "ko": "있잖아, 선생님. 어제 일인데… 나 제대로 교정에 갔었어?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "41c77538e367",
  "ko": "그런데 토니 선생님이 전혀 안 와서 그래서…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 20,
  "jh": "17daf6c229a7",
  "ko": "아아, 그건 이제 됐다…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 20,
  "jh": "4292ed1f9c56",
  "ko": "그보다 너무 가까이서 큰 소리 내지 마. 네 목소리가 울려서 온몸이 아프다고…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "45b9444b9c7b",
  "ko": "온몸이? 다쳤어?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 20,
  "jh": "85b0308bf946",
  "ko": "아무것도 아니야… 됐으니까 이제 돌아가. 보충 수업은 끝이다"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "ede32ff58ea5",
  "ko": "끝이라니, 나 아무것도 안 했는데…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 20,
  "jh": "b88d597c65eb",
  "ko": "됐으니까 군말 말고 돌아가! …아얏! 바보 자식, 소리 지르게 하지 마…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "6b8fda34903c",
  "ko": "돌아가도 된다면 돌아가겠지만… 나중에 역시 보충 수업이라거나 안 하겠지?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 20,
  "jh": "ea69a708c3f3",
  "ko": "안 해. 너무 끈질기면…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "9c78cdd1e17c",
  "ko": "와, 거짓말 거짓말! 그럼 이만!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 20,
  "jh": "33842208708b",
  "ko": "젠장… 그렇게 강해졌을 줄이야… 성적은 최저인 주제에…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 20,
  "jh": "db9003b3d150",
  "ko": "아야야야! …젠장, 못 해 먹겠다…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]