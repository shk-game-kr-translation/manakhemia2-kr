 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 9,
  "jh": "47f9e02fa487",
  "ko": "아아 정말! 귀엽다! 냠 먹어 버리고 싶어져"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 18,
  "jh": "5ebb4ac44c8c",
