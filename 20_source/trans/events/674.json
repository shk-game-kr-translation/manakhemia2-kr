  "kind": 2,
  "chr": 9,
  "jh": "b7ea50baae79",
  "ko": "물론. 내 몸을 스펀지 삼아 그 작은 몸을 구석구석 깨끗하게 해 주지"
 },
 {
  "key": "m25",
