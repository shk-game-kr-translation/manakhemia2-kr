 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 8,
  "jh": "9d7734df1a77",
  "ko": "아~ 잔뜩 뛰어다녀서 땀났네. 오빠"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 9,
  "jh": "7e117454196d",
  "ko": "그렇군. 그럼 오늘도 같이 목욕할까"
 },
 {
