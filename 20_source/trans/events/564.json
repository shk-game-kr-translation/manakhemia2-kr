[
 {
  "key": "m0",
  "kind": 2,
  "chr": 0,
  "jh": "f4485edf4a77",
  "ko": "물어본다는 걸 깜박했는데… 구체적으로 뭘 하는 거야? 푸니푸니 순례라는 건"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 23,
  "jh": "104176a1d112",
  "ko": "승부를 신청한 쪽이 세 가지 시련을 준비해요"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 23,
  "jh": "8cc8acb21fec",
  "ko": "내용이나 순서도 상대 마음대로, 그걸 전부 통과하면 저희가 이기는 거예요"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 0,
  "jh": "65ec054d3b90",
  "ko": "…꽤 상대에게 유리한 조건이네"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 23,
  "jh": "f200e33a5542",
  "ko": "그래요. 그래서 승부를 신청한 쪽은 지면 웃음거리"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 23,
  "jh": "fdd10ab27ad8",
  "ko": "이겨도 비겁자 소리를 듣는 거예요"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 22,
  "jh": "03198162b055",
  "ko": "하긴 진 쪽은 대개 목숨을 잃으니 나중 일은 쓸데없는 걱정이지만"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "5fb68478788c",
  "ko": "목숨을 걸 만한 일로는 안 보이는데…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 24,
  "jh": "19c997666f1d",
  "ko": "쉿! 곧 도착하니까 푸니~ 말고는 말하면 안 돼"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 54,
  "jh": "f9a7c5bf7d45",
  "ko": "도망치지 않고 왔군. 그 배짱은 칭찬해 주마"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 22,
  "jh": "ac4e7590dcd5",
  "ko": "푸니푸니 순례를 신청받고 도망칠 순 없지. 그보다 약속 잊지 마라"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 54,
  "jh": "d5a2dd39805c",
  "ko": "알고 있다. 네놈들이 이기면 앞으로 두 번 다시 손대지 않는다"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 54,
  "jh": "04766d3f9424",
  "ko": "…응? 여동생이 꽤 커지지 않았냐?"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 23,
  "jh": "5e8e012a3871",
  "ko": "그, 그건 봐, 성장기라서! 그치? 푸니요"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 0,
  "jh": "4b18b4c425fc",
  "ko": "…푸니~"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 54,
  "jh": "0a9e78091d79",
  "ko": "흠, 인간의 성장 속도는 무섭군… 뭐 됐다. 이제 각오는 됐겠지"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 22,
  "jh": "b905a7157396",
  "ko": "당연하다. 언제든 시작해라"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 54,
  "jh": "58d221c753f6",
  "ko": "후후후, 그 기세가 언제까지 갈까. …처음은 이거다! 푸니 겨루기!"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 22,
  "jh": "9d2435ffc626",
  "ko": "호오, 처음부터 그걸 가져왔나…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 0,
  "jh": "20c9e94a1051",
  "ko": "뭐야, 푸니 겨루기라는 건?"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 54,
  "jh": "084813c5942c",
  "ko": "응? 인간 말이 들린 것 같은데…"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 24,
  "jh": "b16653a1d347",
  "ko": "기, 기분 탓이야! 정말, 조심해야지"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 0,
  "jh": "4b18b4c425fc",
  "ko": "…푸니~"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 23,
  "jh": "958b6bbf1a3c",
  "ko": "푸니 겨루기란 간단히 말해 일대일 싸움에 의한 순수한 힘겨루기예요"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 23,
  "jh": "3894a632030f",
  "ko": "이 경우 저희 네 명이 각자 상대와 싸운다는 거겠죠"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 22,
  "jh": "dbbcf6525352",
  "ko": "분명히 푸니요를 짓밟는 걸 노린 승부로군"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 22,
  "jh": "381c71322792",
  "ko": "푸니요가 안 온 건 불행 중 다행이었을지도 모르겠군"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 54,
  "jh": "eae4c83eeb58",
  "ko": "뭘 꿍얼대는 거냐. 설마 겁먹은 건 아니겠지"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 22,
  "jh": "d6aba7bf437f",
  "ko": "작전 회의를 했을 뿐이다"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 22,
  "jh": "6f0e35fd312d",
  "ko": "알겠냐, 한 명이라도 지면 그 시점에 우리의 패배다. 방심하지 마라"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 24,
  "jh": "1d70b0c1966e",
  "ko": "으, 응"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 0,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 54,
  "jh": "086fdf07e390",
  "ko": "그럼 시작한다. 이 몸이 직접 엄선한 네 명의 전사여… 덤벼라!"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 22,
  "jh": "9bc0322bb288",
  "ko": "지로! 그쪽은 끝났냐"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 23,
  "jh": "bce21516feb1",
  "ko": "응, 간신히. 나머지는…"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 22,
  "jh": "937627b798c1",
  "ko": "사부로뿐이군"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 0,
  "jh": "5f64c667a622",
  "ko": "그러니까… 푸니~, 푸니푸니?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 22,
  "jh": "88fa81995b2d",
  "ko": "음. 사부로도 결코 약한 건 아니지만 실전 경험이 적어서…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 0,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 22,
  "jh": "95fc16becc51",
  "ko": "상대 실력도 대단친 않지만 저쪽은 거친 플레이에 익숙하군"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 22,
  "jh": "97badf22d92b",
  "ko": "이기기 위해서가 아니라 괴롭히는 데 철저한 싸움 방식이다"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 23,
  "jh": "5d46863f2769",
  "ko": "로제 씨, 훌륭하게 푸니푸니어를 구사하시네요. 좋은 느낌이에요!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 0,
  "jh": "5af7a498a2e6",
  "ko": "…푸니"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 24,
  "jh": "9e8f8b7f5a36",
  "ko": "크, 하… 에이이이잇!"
 },
 {
  "key": "m45",
  "kind": 5,
  "chr": 35,
  "jh": "50f5a381da87",
  "ko": "크아아아아아아!"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 22,
  "jh": "18cd1a6866ba",
  "ko": "오, 결정났나!"
 },
 {
  "key": "m47",
  "kind": 0,
  "chr": 24,
  "jh": "75188e0b88ca",
  "ko": "후우… 위험했다…"
 },
 {
  "key": "m48",
  "kind": 0,
  "chr": 22,
  "jh": "9d1fa1c14e08",
  "ko": "훌륭했다. 너도 성장했구나, 사부로!"
 },
 {
  "key": "m49",
  "kind": 0,
  "chr": 24,
  "jh": "07e73f1f5fd6",
  "ko": "에헤헤, 뭘 그 정도로… 아얏!"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 23,
  "jh": "761eafca9db9",
  "ko": "왜 그래?"
 },
 {
  "key": "m51",
  "kind": 0,
  "chr": 24,
  "jh": "4952f3977fa2",
  "ko": "어깨가… 안 올라가… 아야야!"
 },
 {
  "key": "m52",
  "kind": 0,
  "chr": 22,
  "jh": "1c17177a7032",
  "ko": "이건 심하군. 시퍼렇게 부어올랐다… 집중적으로 노려졌나"
 },
 {
  "key": "m53",
  "kind": 0,
  "chr": 23,
  "jh": "1a877c6a770f",
  "ko": "더 싸우는 건 무리겠네…"
 },
 {
  "key": "m54",
  "kind": 0,
  "chr": 24,
  "jh": "bf8dc42a89cf",
  "ko": "으으… 미안해 형…"
 },
 {
  "key": "m55",
  "kind": 0,
  "chr": 54,
  "jh": "701570e1aed3",
  "ko": "깎아 낸 건 한 명뿐인가… 여동생의 강함은 예상 밖이었군"
 },
 {
  "key": "m56",
  "kind": 0,
  "chr": 55,
  "jh": "bbccd91b9424",
  "ko": "형님~! 다음 준비 됐슴다! 다들 대기 중임다!"
 },
 {
  "key": "m57",
  "kind": 0,
  "chr": 54,
  "jh": "25674d2a1d2e",
  "ko": "오, 그러냐. 크크크… 다음엔 이렇게 안 될 거다"
 },
 {
  "key": "m58",
  "kind": 0,
  "chr": 54,
  "jh": "09cd49f92e61",
  "ko": "어이, 언제까지 쉴 틈 없다! 다음 장소로 이동이다!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]