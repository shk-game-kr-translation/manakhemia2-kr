[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "0e525d09c77f",
  "ko": "내가 왜 이런 걸 하고 있지… 바보 같아. 그냥 돌아갈까"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 1,
  "jh": "1a298cb4f8c5",
  "ko": "헉, 이럴 때. 잠깐, 이쪽으로 오지 마!"
 },
 {
  "key": "m2",
  "kind": 5,
  "chr": 6,
  "jh": "e69fb1728179",
  "ko": "위험해, 누나!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 6,
  "jh": "0e56a21ad474",
  "ko": "누나, 여긴 이 몸한테 맡기고 도망쳐!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "a2d65021e7c1",
  "ko": "페페론! 그래도…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 6,
  "jh": "500c8da7f588",
  "ko": "걱정 마. 이 정도 상대는 이 몸이 알몸이 되면 식은 죽 먹기야!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "0da807c83fce",
  "ko": "그러니까 왜 알몸인데! 상관없잖아!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "9e24c7eb24a5",
  "ko": "그건 봐, 마음가짐의 문제라고나 할까, 응"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "a7cb5c0d9987",
  "ko": "무슨 소린지 모르겠어! 됐어, 나도 같이 싸울게"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "16a6b9d53b40",
  "ko": "에에? 앗, 설마… 이 몸 알몸이 보고 싶은 거야? 누나, 응큼하네"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "5316d71449ae",
  "ko": "아니거든! 벗는 건 절대 금지. 그러면 아틀리에에서 쫓아낼 거야"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 6,
  "jh": "11b67af5469a",
  "ko": "으으, 엄하네… 알았어, 참을게"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 6,
  "jh": "9795c942b3b7",
  "ko": "역시 둘이서 덤비니까 식은 죽 먹기네!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "9c8a7a29a5a8",
  "ko": "응… 그래도 페페론이 안 와 줬으면 솔직히 위험했을지도"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 6,
  "jh": "9caab275d97e",
  "ko": "하하하! 이 몸의 고마움을 알겠어?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 6,
  "jh": "117dabb39d27",
  "ko": "뭐, 앞으론 방심하지 말라고. 재료 캐기도 목숨 걸린 일이니까"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "310152149f12",
  "ko": "…그렇게 생각하면 네 괴력도 요정 씨한테 필요한 건지도 모르겠네"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 6,
  "jh": "ccaac76ee72d",
  "ko": "…그렇구나! 스승님은 그걸 알고 맨손으로 곰을 쓰러뜨리는 수행을!?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "4678ba01c5d3",
  "ko": "절대 거기까진 생각 안 했을 거야… 자, 이제 돌아가자"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 6,
  "jh": "0363b861baf7",
  "ko": "에에? 아직 승부 시간 남았는데?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "4c76824b7936",
  "ko": "승부 같은 거 아무래도 좋아. 지쳤으니까 돌아가서 잘래. 자, 간다"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "a4a25bbbc6e6",
  "ko": "음, 누나는 막무가내네"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
