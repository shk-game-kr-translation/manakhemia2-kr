[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "7fc0563f139e",
  "ko": "역시 혼자서는 힘드네. 체력적으로도 정신적으로도…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 1,
  "jh": "ae0ffe99f6d5",
  "ko": "아니, 꺾이면 안 돼! 우류가 날 기다리고 있으니까!"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 0,
  "jh": "77bfaf8cac5e",
  "ko": "누구 있나…?"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 1,
  "jh": "f0cc6673cf1e",
  "ko": "와햐아아!?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 0,
  "jh": "5e0737a5fa43",
  "ko": "누군가 했더니 너냐…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "c3742660fe95",
  "ko": "노, 노노놀래키지 마!!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 0,
  "jh": "6fdb634b222c",
  "ko": "하필이면 제일 만나기 싫은 녀석을 만나다니…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "c0395af6aacd",
  "ko": "미안하지만 너랑 어울릴 시간 없어."
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 1,
  "jh": "168f98c5f831",
  "ko": "앗! 잠깐만! 이쪽도 큰일이란 말이야!"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 0,
  "jh": "97b251a7b1da",
  "ko": "큰일…? …응? 마나는 같이 아니냐"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 1,
  "jh": "488a5b52e778",
  "ko": "맞아! 그것까지 포함해서 큰일이야!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "e00e1197746d",
  "ko": "…얘기만 듣는 거다"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "74950b2aea58",
  "ko": "응! 그게, 어디서부터 얘기하면 좋을까…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 0,
  "jh": "1482ea70737b",
  "ko": "복잡한 설명은 하지 마. 또 폭발할지도 모르니까"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "5a7714f1659c",
  "ko": "어? 뭐?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 0,
  "jh": "6a763db6bd5b",
  "ko": "이쪽 얘기야. 빨리 시작해"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "26ee78038605",
  "ko": "응… 우선 말이야, 빛의 마나와 어둠의 마나라는 마나의 왕이 있었어"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 0,
  "jh": "10b3214fe542",
  "ko": "…대뜸 스케일이 큰 얘기로군"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "cb60d7828afc",
  "ko": "그래서, 빛의 마나는 이 세계에 사는 마나를 전부 자기들 세계로 돌려보내려 해서…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "8f04c01303fa",
  "ko": "그런데 어둠의 마나가 거기에 반대해서, 그러니까… 맞다, 승부를 걸었어!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "5755e224393e",
  "ko": "만약 인간 여자애가 마나 아기를 훌륭하게 키워 내면 그런 짓 그만두라고"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "436b84f95f2f",
  "ko": "…그래서, 그 마나 아기라는 게 네 마나라는 거냐?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "62b4d1df415d",
  "ko": "그래! 눈치 빠르네"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "b7a860469376",
  "ko": "그래서 말이야, 그 승부가 끝날 때까지 싸움은 중지라는 약속이었는데"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "9162b468a35c",
  "ko": "빛의 마나는 인간에게 힘을 빌려줘서 몰래 마나를 사냥하게 했고…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "2d45c71043d6",
  "ko": "마나를 사냥하는 인간…?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "67a6d3400246",
  "ko": "우리 애도 몇 번이나 노려졌어. 다 역으로 혼내 줬지만"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "dfb2de899778",
  "ko": "그랬더니 이번엔 그 마나가 엄청난 힘을 가졌으니 돌려줘~! 이러질 않나…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "a9a5e4f4f43f",
  "ko": "아~ 생각하니까 또 화가 나네!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 0,
  "jh": "a34eb5c9e73d",
  "ko": "화내는 건 나중에 해. 네 마나, 그렇게 대단한 녀석으론 안 보였는데"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "9392740f31fa",
  "ko": "그게 말이지, 실은 마음을 관장하는 마나래. 사람 마음을 어떻게 해 버린다나…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 0,
  "jh": "7b12ecf8245a",
  "ko": "…!? 야, 자세히 얘기해!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "1649c825d187",
  "ko": "어? 아니, 나도 들은 얘기라 잘 모르겠어"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "f8eaae750d79",
  "ko": "그래도 확실히 우류를 유괴하러 왔던 여자는 점점 이상해졌고…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 0,
  "jh": "60af0273a2ea",
  "ko": "(나도 그런 건가… 반지 탓이 아니라… 아니면 그 녀석은 알고서…?)"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 1,
  "jh": "4cd13cde197e",
  "ko": "그래서 말이야, 아까 모르는 남자가 나타나서 우류를 검으로 벴어!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 1,
  "jh": "21ad879cb60d",
  "ko": "그랬더니 뭔가 대폭발이 나서 우류는 어디론가 가 버리고, 난 혼자 헤매고…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 0,
  "jh": "2451a24772fd",
  "ko": "…대충 이어지기 시작했나… 하지만 아직…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "0aa8c6711468",
  "ko": "…듣고 있어?"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 0,
  "jh": "296609a7dbe2",
  "ko": "그래, 제대로 듣고 있어"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 1,
  "jh": "d4ba1e665f6d",
  "ko": "앗! 너 의심하고 있지!? 그 눈은 의심하는 눈이야!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 1,
  "jh": "bc5097574daf",
  "ko": "그야 내가 말하면서도 좀 거짓말 같긴 하지만, 전부 진짜라고!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 0,
  "jh": "e2a08ad0a98f",
  "ko": "이 눈은 타고난 거다. 제대로 믿고 있어"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 0,
  "jh": "a795e091bcd6",
  "ko": "그 마나의 힘 때문에 나도 이 꼴이니까… 전혀 무관하진 않은 모양이야"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 1,
  "jh": "9e2f28df3db4",
  "ko": "어? 무슨 뜻이야?"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 0,
  "jh": "3620571f7f24",
  "ko": "이 반지. 아마 이게 마나를 사냥하는 인간의 힘이라는 거겠지"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 1,
  "jh": "684f214cef6f",
  "ko": "어… 에에에에에!? 그럼 너도… 그래서 우류를 노린 거야!?"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 0,
  "jh": "580bcae821fc",
  "ko": "사정은 몰랐고, 휘말렸을 뿐이야… 변명밖에 안 되겠지만"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 1,
  "jh": "7919bfe1c456",
  "ko": "그래서는 모르겠잖아. 제대로 설명해!"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 0,
  "jh": "97dcb30ccd1d",
  "ko": "아마 네 마나를 벴다는 남자. 그 녀석한테 꼬드김을 당한 거야"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 0,
  "jh": "e3e824660ba7",
  "ko": "마나를 사냥하지 않으면 이 반지는 안 빠지고 머리가 이상해진다고"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 0,
  "jh": "51ca9c4a87cc",
  "ko": "더 자세한 건… 그 녀석이나 영감한테 물어봐야겠지"
 },
 {
  "key": "m53",
  "kind": 0,
  "chr": 1,
  "jh": "59f6d0393648",
  "ko": "어디 가는 거야!?"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 0,
  "jh": "a44f2a91b287",
  "ko": "우리 영감도 행방불명이라. 찾아야 해"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 1,
  "jh": "0c392959689a",
  "ko": "행방불명이라니, 어디 있는지 모른다는 거야?"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 0,
  "jh": "1c7f8637b07c",
  "ko": "그래… 닥치는 대로 찾을 거야"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 1,
  "jh": "23b34437e446",
  "ko": "그럼 겸사겸사 내 쪽도 도와줘"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 1,
  "jh": "de07bb3a7aaa",
  "ko": "어쩌면 그 도중에 할아버님을 찾을지도 모르잖아"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 0,
  "jh": "cf2c39fc628f",
  "ko": "…왜 내가 널 도와야 하는데"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 1,
  "jh": "df6ac604487c",
  "ko": "이런 몬스터가 우글거리는 데에 여자애 혼자 두고 갈 거야?"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 0,
  "jh": "50cbd56b742c",
  "ko": "동료한테 돌아가면 되잖아"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 1,
  "jh": "a957fce25f6e",
  "ko": "돌아가려 해도 혼자선 위험하잖아! 우류도 빨리 찾아 줘야 하고…"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 0,
  "jh": "1915041ab731",
  "ko": "…내 얘기 들었지. 난 마나를 사냥하는 힘을 가진 네 적이라고?"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 1,
  "jh": "24419cde85e7",
  "ko": "아, 그렇구나… 뭐, 괜찮겠지. 너, 왠지 악당은 못 될 것 같은 느낌이고"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 0,
  "jh": "e07252256c06",
  "ko": "…멋대로 사람을 분석하지 마"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 1,
  "jh": "ee4f1905a1c7",
  "ko": "부탁이야! 지금은 너밖에 의지할 데가 없어! 응?"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 0,
  "jh": "2781e6efb5ed",
  "ko": "…후우. 알았어"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 1,
  "jh": "13426d60fe69",
  "ko": "정말? 해냈다, 고마워!"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 0,
  "jh": "e3c199ce8a9b",
  "ko": "단, 영감을 찾을 때까지다. 나도 이것저것…"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 1,
  "jh": "aca8923fea65",
  "ko": "그럼 당장 가자! 기다려, 우류! 지금 갈게!"
 },
 {
  "key": "m72",
  "kind": 0,
  "chr": 0,
  "jh": "ee63dc382737",
  "ko": "야! …정말이지, 침착하지 못한 녀석이군"
 },
 {
  "key": "m73",
  "kind": 0,
  "chr": 0,
  "jh": "47d74d594973",
  "ko": "그래도 저 녀석이랑 얘기하다 보니 내 쪽이 꽤 진정됐나… 이상한 여자야"
 },
 {
  "key": "m74",
  "kind": 5,
  "chr": -1,
  "jh": "68919a0a0870",
  "ko": "「{CLRE}로제{CLNR}」가 동료가 되었습니다."
 },
 {
  "key": "m75",
  "kind": 5,
  "chr": 1,
  "jh": "7fc0563f139e",
  "ko": "역시 혼자서는 힘드네. 체력적으로도 정신적으로도…"
 },
 {
  "key": "m76",
  "kind": 5,
  "chr": 1,
  "jh": "ae0ffe99f6d5",
  "ko": "아니, 꺾이면 안 돼! 우류가 날 기다리고 있으니까!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]