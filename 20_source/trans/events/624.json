[
 {
  "key": "m0",
  "kind": 0,
  "chr": 7,
  "jh": "555b76fb7055",
  "ko": "우~… 음~… 아~우~…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 3,
  "jh": "c80a2388459d",
  "ko": "거슬리네. 바닥에서 데굴데굴데굴데굴…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 7,
  "jh": "2f90c8295ab5",
  "ko": "그치만~ 심심한걸. 요즘 에나랑도 안 놀았고~"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 4,
  "jh": "66502f98231e",
  "ko": "도저히 졸업을 앞둔 학생의 말로는 안 들리는군"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 0,
  "jh": "bd9c2c4574a3",
  "ko": "뭐, 아무 생각 없이 동생한테 엉겨 붙던 때보단 성장한 거 아닌가"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 11,
  "jh": "9cfba5760fb5",
  "ko": "그렇죠. 문제를 일으키는 것보단 훨씬 낫죠"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 7,
  "jh": "41efc1a95452",
  "ko": "오늘은 얌전히 있을까… 아~ 그래도 심심해~…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 3,
  "jh": "5bfb6526483a",
  "ko": "그러니까 거슬린다고! 시간 때울 거면 좀 더 건설적인 걸 해"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 7,
  "jh": "abaad3794612",
  "ko": "건설적? 어려운 말 해도 모르겠어"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 11,
  "jh": "3c7ab84ee13a",
  "ko": "그러게요… 보통 이 나이대 여자애라면 사랑이니 연애니 바쁠 텐데요"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 7,
  "jh": "31da16df5061",
  "ko": "연애…?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "c044f57cc388",
  "ko": "이 녀석한텐 제일 거리가 먼 거 아냐?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 3,
  "jh": "c8745f9c2788",
  "ko": "그래. 나도 아직… 연인이… 못 돼서…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 7,
  "jh": "c28dd5e84a58",
  "ko": "연인… 연인… 연인!!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 4,
  "jh": "932551ce07af",
  "ko": "오? 의외군. 네가 거기에 반응을 보이다니"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 7,
  "jh": "7c640d8897c0",
  "ko": "그렇지 않아! 관심 엄청 많아!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 7,
  "jh": "bb1a766d5575",
  "ko": "연인이란 그거지? 매일 같이 놀거나"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 7,
  "jh": "165a4c1dc5d2",
  "ko": "여자가 무슨 짓을 해도 남자가 웃으며 용서해 주는 그거지?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 11,
  "jh": "1e6538305cc6",
  "ko": "꽤 비약했지만 대체로는…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 11,
  "jh": "38cf3cdaa1d2",
  "ko": "에토 씨, 누구 마음에 둔 사람이라도 있어요?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 7,
  "jh": "56b2e4771a50",
  "ko": "아니~ 그건 전혀… 에나라고 할 수도 없고…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "9fcd9d2346c6",
  "ko": "뭐, 그럴 줄 알았지만…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 3,
  "jh": "b8a42e4a8e5e",
  "ko": "연인을 찾을 거면 지금이야. 졸업하면 만남도 줄 테니까"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 11,
  "jh": "4eda537d648c",
  "ko": "그 점에서 아가씨는 졸업 후에도 매일 만날 수 있으니 안심이네요"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 3,
  "jh": "ea9ee307b99f",
  "ko": "그래그래. 그래서 좀처럼 타이밍이… 라니, 무슨 말을 시키는 거야!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 7,
  "jh": "58a41fcaa183",
  "ko": "그렇구나, 지금이구나… 음~… 좋아! 나 오늘부터 로제 연인 할래!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 0,
  "jh": "aef48060a3e5",
  "ko": "…뭐?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 3,
  "jh": "5590ff801110",
  "ko": "어?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 4,
  "jh": "061e47f77568",
  "ko": "호오"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 5,
  "jh": "8b86926363e7",
  "ko": "푸니?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 0,
  "jh": "6e8949ac3ec4",
  "ko": "너 말이야… 아무렇게나 말하는 것도 정도껏…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 7,
  "jh": "76dfa908d421",
  "ko": "괜찮지? 로제도 연인 없으니까 딱 좋잖아"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "a0f8d926c07c",
  "ko": "없으면 아무나 되는 게 아니잖아"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 3,
  "jh": "f9b11a09538d",
  "ko": "안 돼~!! 절대로 안 돼~~!!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 7,
  "jh": "c95057353cdc",
  "ko": "와!? 깜짝이야. 딱히 괜찮잖아, 닳는 것도 아니고"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 3,
  "jh": "a8560c3dec46",
  "ko": "닳거든! 엄청 닳거든!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 3,
  "jh": "3617ce21385e",
  "ko": "게다가 로제는 내 종자니까! 안 된다면 안 된다면 안 되는 거야!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 0,
  "jh": "79c2351d27c6",
  "ko": "아가씨. 이 녀석 농담에 진심이 되시면 끝이 없어요"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 3,
  "jh": "7bfe896dc0d8",
  "ko": "넌 상관없으니까 가만히 있어!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 0,
  "jh": "b5fc9c689f4d",
  "ko": "아니, 완전 당사자인데요…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 7,
  "jh": "05946b39e2ac",
  "ko": "릴리아가 심술궂어… 이게 며느리를 괴롭히는 시어머니라는 거구나!"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 11,
  "jh": "87dab82b6cab",
  "ko": "그런 쓸데없는 지식은 있네요…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 3,
  "jh": "96cae31a2e12",
  "ko": "누가 시어머니야! 누가!!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 0,
  "jh": "31225daffb59",
  "ko": "야. 화나게 하면 내가 나중에 힘들어. 빨리 사과하고…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 7,
  "jh": "aaa2f517817d",
  "ko": "이렇게 된 이상 사랑의 도피야!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 0,
  "jh": "4d1b949603fb",
  "ko": "뭐? 어… 야, 이봐!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 3,
  "jh": "043643f88b03",
  "ko": "앗, 이놈! 절대 안 놓쳐. 지옥 끝까지라도 쫓아갈 거야!!"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 4,
  "jh": "4b9635a39e11",
  "ko": "그 발언은 그야말로 시어머니답군"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 23,
  "jh": "287339e16981",
  "ko": "릴리아 씨 형상에 겁먹어서 여동생이 당장이라도 울 것 같아요"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 3,
  "jh": "3d3f08849393",
  "ko": "느긋하게 있지 말고 너희도 쫓아가! 자!"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 11,
  "jh": "c1e62f99fa31",
  "ko": "아하하하. 일이 커졌네요"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 4,
  "jh": "fc9326032c54",
  "ko": "네 경솔한 발언이 모든 발단이다만"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]