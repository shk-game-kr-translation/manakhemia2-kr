[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "6710bd961987",
  "ko": "아~ 피곤해… 그래도 즐거웠다, 학원제"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 10,
  "jh": "9dc66ada9e64",
  "ko": "우!"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 1,
  "jh": "d1a87ea59f8e",
  "ko": "우류도 즐거웠지. 응, 다행이다 다행이야. 그래도…"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 1,
  "jh": "75a93d9ee2e0",
  "ko": "뭐였을까, 그 둘… 왠지 눈이 정상이 아니었어…"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 1,
  "jh": "f3e5ffccbb5b",
  "ko": "아~ 미안. 어두운 얼굴 해서"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 1,
  "jh": "2040c3e486f4",
  "ko": "괜찮아! 무슨 일이 있어도 넌 내가 지켜 줄게!"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 1,
  "jh": "989f2c25656b",
  "ko": "아아… 그래도 오늘은 지쳐서… 후아아…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 1,
  "jh": "9b51faa5cd5f",
  "ko": "안 되겠다… 머리 썼더니 졸… 려… 쿠울…"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 10,
  "jh": "ea065d8d41fd",
  "ko": "우?"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m11",
  "kind": 5,
  "chr": 35,
  "jh": "fa288fd4c911",
  "ko": "방심하는 계약주로군"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 10,
  "jh": "01b7def58a76",
  "ko": "우!?"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 35,
  "jh": "4e531939fb5e",
  "ko": "겁낼 필요 없다. 난 아무것도 안 한다. 그저 감시하러 왔을 뿐이다"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 10,
  "jh": "604ad7df2901",
  "ko": "…우?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 35,
  "jh": "2cf3ca5d0e72",
  "ko": "감시다. 감・시. 모르겠나? 그렇게 어려운 말도 아닌 것 같은데"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 35,
  "jh": "1960190fd1c2",
  "ko": "풀 죽지 마라. 넌 아직 깨어난 지 얼마 안 돼서 충분한 교양을 못 쌓았을 테니까"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 19,
  "jh": "773fd55a4a21",
  "ko": "오오, 인사하는 걸 깜빡했군. 난 티트리. 잘 부탁한다"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 10,
  "jh": "245333059f68",
  "ko": "…잘 부탁"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 19,
  "jh": "274f2e62ceee",
  "ko": "꽤 예의 바르구나. 장하다. 머리를 쓰다듬어 주마"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 10,
  "jh": "c79cd1d68e17",
  "ko": "우~"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 19,
  "jh": "7995c350b6b9",
  "ko": "음, 복슬복슬하구나. 칭찬해 줄 생각이었는데 내 쪽이 치유될 것 같다"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 10,
  "jh": "462e025f0e9d",
  "ko": "우~! 우~!"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 1,
  "jh": "c6fd55acc779",
  "ko": "음냐… 시끄러…"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 19,
  "jh": "c3aa6a34dfbd",
  "ko": "일어났나. 어린 마나를 내버려 두고 자 버리다니 좋지 않군"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 1,
  "jh": "5d22ff81d273",
  "ko": "응…? 와앗!? 누구야 너! 우리 애한테 뭐 하는 거야!"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 19,
  "jh": "36eba103850c",
  "ko": "인사를 나누고 있었다. 꽤 영리해 보이는 아이로군"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 1,
  "jh": "5933769de07b",
  "ko": "그야 그렇지. 뭐니 뭐니 해도 내 자랑인… 이 아니라! 멋대로 만지지 마!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 19,
  "jh": "fb0977d2ec51",
  "ko": "음, 뺏겨 버렸다. 복슬복슬해서 기분 좋았는데…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 19,
  "jh": "e030b4c8aea6",
  "ko": "그렇게 서두르지 않아도 된다. 그 애한테도 말했지만 난 그저 감시하러 왔을 뿐이다"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "1399ca18e64c",
  "ko": "감시…?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 19,
  "jh": "241cf9865844",
  "ko": "경계하면서 지켜보는 거다. 키운 부모가 모르니 자식이 모르는 것도 무리가 아니군"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "a94413b3c549",
  "ko": "말 뜻은 알거든! 내가 묻고 싶은 건…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 19,
  "jh": "086c829c7ec3",
  "ko": "그 애 상태도 확인했으니 오늘은 이만 실례하겠다. 그럼"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "2f8669a6686d",
  "ko": "기다려! 묻고 싶은 게 있다니까!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 19,
  "jh": "79688f9704ca",
  "ko": "미안하지만 대답할 수 없다. 지금의 난 중립을 지키라는 명을 받았으니까"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 19,
  "jh": "07ff6f4a102d",
  "ko": "다만 그 애는 건강하게 자라고 있다. 현 상황으론 저쪽 분이 우세하다고 할 수 있겠군"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 1,
  "jh": "892d461830b1",
  "ko": "…뭐? 무슨 소리야. 잠깐!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "f314b6620b2c",
  "ko": "정말! 영문 모를 소리만 하고 그냥 돌아가지 마!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 10,
  "jh": "f4431bc1dbf5",
  "ko": "우, 우~"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 1,
  "jh": "ff25d3bce3a5",
  "ko": "너도 모르는 사람이랑 얘기하면 안 되잖아!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 1,
  "jh": "e80916c96d45",
  "ko": "아~ 미안. 소리 지를 생각은…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 1,
  "jh": "0b31fa4b9eeb",
  "ko": "신경이 예민해졌나. 나답지 않아… 왠지 기분 나빠"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
