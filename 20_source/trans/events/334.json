[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "28952c4a70fa",
  "ko": "으… 아야야야…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 1,
  "jh": "27437145ed4b",
  "ko": "대체 무슨… 앗!? 우류는!? 우류는 어디 있어?"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 19,
  "jh": "43ae25850fdf",
  "ko": "저쪽으로 날아가 버린 모양이다"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 1,
  "jh": "28f25f29d4fe",
  "ko": "우류… 너의… 너 때문에…!!"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 19,
  "jh": "752abdc68046",
  "ko": "미안하다. 완전히 내 실수다. 벌써 그만한 힘을 갖고 있었을 줄이야"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 1,
  "jh": "f11701d1f0af",
  "ko": "지금 그런 얘긴 아무래도 좋아. 우류는 저쪽으로 간 거지?"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 19,
  "jh": "3b4041e27c27",
  "ko": "음, 기다려라. 남의 얘기는 끝까지 듣는 법이다"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 8,
  "jh": "e1d445c04ee6",
  "ko": "우린 안중에도 없냐…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 2,
  "jh": "4ac3845b09ec",
  "ko": "…울리카는 한 번에 두 가지를 생각 못 하는 애니까…"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 9,
  "jh": "3aa7f9e9bcc7",
  "ko": "좋든 나쁘든 단순하니까. 자, 페페론… 어라? 벌써 가 버렸나"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 9,
  "jh": "9eab9ca12424",
  "ko": "…후우. 그럼 나도 내가 할 수 있는 일을 해 둘까"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 8,
  "jh": "50368e6fd599",
  "ko": "야, 기다려. 이쪽은 아직 못 움직이는데…"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 9,
  "jh": "813da98381ff",
  "ko": "아아, 난 혼자서 은밀 행동을 하게 해 줘"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 9,
  "jh": "b1b88cd985e7",
  "ko": "좀 늦을 것 같으니 아가씨한테 전언 좀 부탁할 수 있을까"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 14,
  "jh": "49140767c164",
  "ko": "…이게 마음의 마나의 힘… 후, 후후후… 하하하하하하하하!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 14,
  "jh": "8951e447002a",
  "ko": "머리가 개운해졌어… 이것저것 생각하던 게 바보 같아"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 14,
  "jh": "83a70e63c931",
  "ko": "마음에 안 드는 녀석은, 약한 녀석은… 닥치는 대로 죽여 버리면 되잖아!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 14,
  "jh": "f0ca8b9db4af",
  "ko": "그러면 강한 사람만 남아. 강한 사람과 싸울 수 있어… 우후후후, 아하하하하하!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "3ae463de2003",
  "ko": "왜 따라오는 거야!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 19,
  "jh": "a58ad35a9ff2",
  "ko": "가는 곳이 같으니 어쩔 수 없잖나. 나도 아직 목적을 이루지 못했으니까"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "b78ddb0ba8e5",
  "ko": "아직도 그런 소리를… 포기를 모르네!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 19,
  "jh": "0edd1a51d936",
  "ko": "너야말로 그 애한테 가서 어쩔 생각이냐. 지금 다가가는 건 매우 위험하다"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "840fd696d528",
  "ko": "그런 거 몰라! 내 아이니까 내가 가는 거야! 그게 다야!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 19,
  "jh": "1f08f6d1c234",
  "ko": "좀 더 논리적인 답을 기대했는데… 말려도 소용없다는 건 알았다"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 19,
  "jh": "e82ef877b739",
  "ko": "더 할 얘기도 없다. 먼저 가겠다"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "2f92ce0a8590",
  "ko": "뭐? 기, 기다려!"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 1,
  "jh": "57f54933a911",
  "ko": "이봐~! 속도위반이야! 크, 전혀 못 따라잡겠어… 응?"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 1,
  "jh": "eb9198a181ee",
  "ko": "으… 이거 좀 위험할지도…? 우류도 아무도 없는데…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
