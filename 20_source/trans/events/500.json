[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "cdb20042f072",
  "ko": "앗! 기다렸어! 어때? 다 됐어!?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "474d44fe1d48",
  "ko": "…유감이지만"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "3a182717980a",
  "ko": "그, 그런!!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 11,
  "jh": "ed53078d812a",
  "ko": "아까 성공했다고 하셨잖아요. 너무 괴롭히지 말아 주세요"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "3a21aff41c37",
  "ko": "자… 너 말이야!!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 2,
  "jh": "1112c3fb68d0",
  "ko": "미안해… 귀여워서 그만 괴롭히고 싶어져서…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "22e014f54f13",
  "ko": "어, 어머 싫다. 귀엽다니, 그런 뻔한 소리를…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "22401a5a435e",
  "ko": "칭찬받는 건 푸니푸니 모습이지만요"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 2,
  "jh": "3d012e1ae3a0",
  "ko": "그럼 바로… 이 약을 먹으면 아마 괜찮을 거야…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 3,
  "jh": "503b76dea4c9",
  "ko": "어머, 이번 건 알약이구나"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 11,
  "jh": "c706afa0cdb2",
  "ko": "참고로 이건 어떤 주술이에요?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "88086c979cdb",
  "ko": "…자신이 가장 빛나던 시절로 돌아가는 주술"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "356b2fab28c4",
  "ko": "빛나던 시절… 미묘한 표현이군"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 11,
  "jh": "345d73d2179b",
  "ko": "만약 지금 푸니푸니 모습이 가장 빛나는 거라면…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "9abf21e9ee25",
  "ko": "…빛나고 있다면 그건 그대로가 좋다는 거…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "e5d7d469fcc9",
  "ko": "…왠지 먹기 무서워졌어"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 11,
  "jh": "32fad81c55fd",
  "ko": "뭐, 뭐 먹어 보지 않으면 시작도 안 되잖아요"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 5,
  "jh": "7ea7b0907d7f",
  "ko": "푸니~!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 23,
  "jh": "a4c0ad697170",
  "ko": "어떻게 되든 뼈는 수습해 주마. 라고 여동생도 말해요"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "8130d262170d",
  "ko": "아, 알았어… 에잇!"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 11,
  "jh": "0cf39a6a6a66",
  "ko": "아가씨… 바닥에 흘리지 마세요. 애도 아니고"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 3,
  "jh": "ce154fb10cda",
  "ko": "어, 어라? 이상하네. 한 번 더… 에잇!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 0,
  "jh": "dc99de48318b",
  "ko": "아가씨…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "fa6635f4f32e",
  "ko": "아, 아니야! 제대로 먹으려는데 잘 안 돼서…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 23,
  "jh": "7cadf6cfb911",
  "ko": "아아, 그렇구나!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "1b93758f9fdc",
  "ko": "그렇구나라니, 뭐가?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 23,
  "jh": "3dddc3e90039",
  "ko": "릴리아 씨는 푸니푸니가 된 지 얼마 안 돼서 입 쓰는 법을 모르는 거예요"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 23,
  "jh": "4c445a22970c",
  "ko": "봐요, 저희 푸니푸니 입은 인간과 달리 옆으로 크니까요"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 0,
  "jh": "83017887f29b",
  "ko": "그런 건가…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 23,
  "jh": "84339f4ef160",
  "ko": "뭐, 이것만은 푸니푸니가 돼 보지 않으면 모르겠죠"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "c5a318648c5d",
  "ko": "에잇! …얍! …하앗! …안 돼, 몇 번을 해도 입에서 흘러서…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 2,
  "jh": "1380f908cec5",
  "ko": "…설마 이런 데서 걸려 넘어질 줄이야"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 11,
  "jh": "82861cf5bae6",
  "ko": "곤란하네요…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 3,
  "jh": "96d0e5371739",
  "ko": "으으으… 굴욕이야. 이 내가 약도 제대로 못 먹다니…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 5,
  "jh": "8d4617b53922",
  "ko": "푸니~! 푸니!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 23,
  "jh": "22404b7181f0",
  "ko": "푸니요에게 제안이 있다! 라며 여동생이 목소리를 높이고 있어요"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 3,
  "jh": "2972dd17a856",
  "ko": "뭐? 뭐든 좋으니까 말해 봐!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 5,
  "jh": "bc77c95dc03b",
  "ko": "푸니~… 푸니니!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 23,
  "jh": "bc7599cce3e0",
  "ko": "예로부터 공주님의 저주를 푸는 건 왕자님의 입맞춤으로 정해져 있다. 즉…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 3,
  "jh": "8876106f4c49",
  "ko": "그, 그렇구나! 그런 방법이!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 11,
  "jh": "19b30994db07",
  "ko": "푸니요 씨! 훌륭한 제안이에요!"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 0,
  "jh": "816b3807c00e",
  "ko": "…잠깐, 왕자님이란 게 누구야?"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 11,
  "jh": "7ac45d9d7cb8",
  "ko": "정말. 그런 거 뻔하잖아요"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 2,
  "jh": "3f982cf95304",
  "ko": "…좋겠네"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 0,
  "jh": "1b4f32bebbb2",
  "ko": "있잖아, 푸니푸니 모습이라곤 해도 상대는 아가씨라고?"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 3,
  "jh": "e762e4f93dd0",
  "ko": "나, 나도 사실은 싫어! 로제랑 이, 입맞춤이라니…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 3,
  "jh": "6c3eedb72270",
  "ko": "그, 그래도 상황이 상황이니까 어쩔 수 없이 특별히 허락해 줄까, 해서…"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 11,
  "jh": "637bc1ce9ecd",
  "ko": "봐요, 모처럼 아가씨도 이렇게 말씀하시잖아요!"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 5,
  "jh": "7ea7b0907d7f",
  "ko": "푸니~!"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 23,
  "jh": "0dd5ab5e4e90",
  "ko": "이제 로제 씨 마음에 달렸다! 라며 여동생도 응원하고 있어요"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 0,
  "jh": "b27b33fe4440",
  "ko": "…일단 나도 처음인데"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 2,
  "jh": "fc627cbeb522",
  "ko": "무슨 낭만적인 소리를… 망가지는 캐릭터 주제에…"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 0,
  "jh": "f04f9c43cb9d",
  "ko": "누, 누가 망가지는 캐릭터야!?"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 3,
  "jh": "8874cb30d3e1",
  "ko": "저, 정말! 꾸물대지 말고 빠, 빨리 해!"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 0,
  "jh": "5851a80b4ddb",
  "ko": "…절대 나중에 불평하지 마세요"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 3,
  "jh": "ad28f5bd6251",
  "ko": "가, 각오는 됐어! 언제든 와!"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 0,
  "jh": "548eee93026f",
  "ko": "저… 눈을 감아 주시면 좋겠는데요…"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 3,
  "jh": "2d75d85e1f3a",
  "ko": "감고 싶은데 감는 법을 모르겠어! 아, 그래도 넌 제대로 감아야 해"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 0,
  "jh": "6553d41812f3",
  "ko": "알겠어요… 그럼…"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 3,
  "jh": "9bbc123ab676",
  "ko": "꿀꺽…"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 11,
  "jh": "ca9cf679f2dd",
  "ko": "두근두근…"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 5,
  "jh": "cc13b7c5892b",
  "ko": "푸니푸니…"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 2,
  "jh": "6cca4420f8c7",
  "ko": "아… 문득 생각났는데…"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 11,
  "jh": "bb62ea463e16",
  "ko": "쉿! 좋은 장면이니까 조용히 해 주세요!"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 2,
  "jh": "44c5a9f39fd2",
  "ko": "손으로 약을 배 속에 억지로 밀어 넣어도 될 것 같은데…"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 3,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 11,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 0,
  "jh": "5b7782339104",
  "ko": "아가씨, 실례합니다"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 3,
  "jh": "1b80114ba3bd",
  "ko": "어…? 읍, 우물우물~!!"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 0,
  "jh": "5d166c2184ee",
  "ko": "좋아, 들어갔다!"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 11,
  "jh": "9244722a2687",
  "ko": "아아아… 정말! 클로에 씨!"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 2,
  "jh": "99480e33a1df",
  "ko": "미안… 생각한 건 입 밖에 내 버리는 성격이라…"
 },
 {
  "key": "m73",
  "kind": 0,
  "chr": 3,
  "jh": "ca9561b1d28e",
  "ko": "으아? 으, 크윽… 아, 하아아…"
 },
 {
  "key": "m74",
  "kind": 0,
  "chr": 0,
  "jh": "957113aa81f4",
  "ko": "이건… 잘될 것 같나?"
 },
 {
  "key": "m75",
  "kind": 0,
  "chr": 11,
  "jh": "67cddaeca325",
  "ko": "점점 아가씨 모습으로… 앗! 안 돼요!"
 },
 {
  "key": "m76",
  "kind": 0,
  "chr": 0,
  "jh": "5590ff801110",
  "ko": "어?"
 },
 {
  "key": "m77",
  "kind": 0,
  "chr": 0,
  "jh": "0d0098831ed1",
  "ko": "야, 갑자기 무슨…!"
 },
 {
  "key": "m78",
  "kind": 0,
  "chr": 11,
  "jh": "8c6aef56d521",
  "ko": "죄, 죄송해요. 그래도…"
 },
 {
  "key": "m79",
  "kind": 0,
  "chr": 3,
  "jh": "1e626491f7da",
  "ko": "아… 앗! 돌아왔다! 원래대로 돌아왔어! 봐! 있잖아, 봐!!"
 },
 {
  "key": "m80",
  "kind": 0,
  "chr": 0,
  "jh": "d92493e268d3",
  "ko": "아니… 보려 해도 눈이 가려져 있는데요…"
 },
 {
  "key": "m81",
  "kind": 0,
  "chr": 3,
  "jh": "7b5f64b64b8b",
  "ko": "윔! 뭐 하는 거야! 내 모습을 한시라도 빨리 보여 주고 싶은데…"
 },
 {
  "key": "m82",
  "kind": 0,
  "chr": 11,
  "jh": "c99fc390671e",
  "ko": "마음은 알겠지만 그… 아가씨, 아무것도 안 입으셨으니까…"
 },
 {
  "key": "m83",
  "kind": 0,
  "chr": 3,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m84",
  "kind": 0,
  "chr": 3,
  "jh": "08ec0a685238",
  "ko": "꺄아아아아!! 바보! 변태! 빠, 빨리 나가아!!"
 },
 {
  "key": "m85",
  "kind": 0,
  "chr": 0,
  "jh": "30d7d72c5115",
  "ko": "아얏! 그, 그만하세요!"
 },
 {
  "key": "m86",
  "kind": 0,
  "chr": 2,
  "jh": "d79183ad3462",
  "ko": "…애쓴 상으로 알몸 정도는 보여 줘도 될 텐데…"
 },
 {
  "key": "m87",
  "kind": 0,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m88",
  "kind": 0,
  "chr": 23,
  "jh": "3ac088389ad3",
  "ko": "부끄러워할 만큼 나쁜 몸매는 아니다. 라며 여동생이 칭찬하고 있어요"
 },
 {
  "key": "m89",
  "kind": 0,
  "chr": 3,
  "jh": "7a3529ef7055",
  "ko": "꺄아아!! 뭘 똑똑히 보고 있어! 나가아아!!"
 },
 {
  "key": "m90",
  "kind": 2,
  "chr": 3,
  "jh": "7d980c1b623f",
  "ko": "아아… 왜 나만 이런 꼴을…"
 },
 {
  "key": "m91",
  "kind": 2,
  "chr": 11,
  "jh": "6b65e1a08ac6",
  "ko": "매번 자업자득이지만요"
 },
 {
  "key": "m92",
  "kind": 2,
  "chr": 3,
  "jh": "cd9ce4e8a728",
  "ko": "한 걸음만 더 가면 키스할 수 있었는데… 게다가 알몸까지 보이고…"
 },
 {
  "key": "m93",
  "kind": 2,
  "chr": 11,
  "jh": "837c5cedb323",
  "ko": "알몸은 안 보였을 거예요"
 },
 {
  "key": "m94",
  "kind": 2,
  "chr": 3,
  "jh": "9e09b3b6b08e",
  "ko": "정말? 정말 안 보였어?"
 },
 {
  "key": "m95",
  "kind": 2,
  "chr": 11,
  "jh": "5a5a7f689073",
  "ko": "…아, 역시 손가락 틈이 조금 벌어져 있었던 것 같기도 해요"
 },
 {
  "key": "m96",
  "kind": 2,
  "chr": 3,
  "jh": "28306174781d",
  "ko": "으… 으아아앙! 역시 보였구나~!"
 },
 {
  "key": "m97",
  "kind": 2,
  "chr": 11,
  "jh": "ca5936a7ba02",
  "ko": "…뭐, 이 정도 거짓말은 괜찮겠죠. 가벼운 벌로…"
 },
 {
  "key": "m98",
  "kind": 2,
