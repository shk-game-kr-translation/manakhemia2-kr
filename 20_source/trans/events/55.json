[
 {
  "key": "m0",
  "kind": 0,
  "chr": 0,
  "jh": "82985108155d",
  "ko": "아직 있으면 좋겠는데. 아까 이 근처에… 있다"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 0,
  "jh": "6d87e17575fc",
  "ko": "말소리… 저건 마나인가?"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 71,
  "jh": "eef8253736b6",
  "ko": "대체 뭐야, 넌! 끈질기네!"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 35,
  "jh": "041ea082e70f",
  "ko": "네가 포기를 안 하니까 그렇지. 이제 그만 체념해 주지 않을래?"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 71,
  "jh": "d2356ea3ed59",
  "ko": "그런다고 체념하는 바보가 어디 있냐!"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 35,
  "jh": "7e2bd6107c3f",
  "ko": "뭐, 상관없지만. 조금은 저항해 주는 편이 나도 즐겁고"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 71,
  "jh": "e8dc8472da61",
  "ko": "뭐, 뭐야 그 검은?"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 35,
  "jh": "b4aa8fc23ad5",
  "ko": "미안하지만 이것도 일이라서. 원망은 저쪽에 해 줘"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 71,
  "jh": "9022d1de492a",
  "ko": "으악, 바보야! 그만둬!!"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 71,
  "jh": "379eb24616b8",
  "ko": "으아아아아아!!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 0,
  "jh": "a7584d0b8d67",
  "ko": "마나가… 사라졌다!?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 35,
  "jh": "8673b7dd5999",
  "ko": "어라? 또 보고 있었구나"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "aebc26fc3192",
  "ko": "…어차피 눈치챘겠지"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 35,
  "jh": "14d80e61f2ab",
  "ko": "설마. 네 기척 같은 건 전혀, 하나도, 조금도 못 느꼈어"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "b77e5c9b5a8c",
  "ko": "…죽인 거냐?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 35,
  "jh": "e01088aa0991",
  "ko": "방금 마나? 죽지는 않았을 거야. 원래 세계로 돌려보낼 뿐이라고 했으니까"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 35,
  "jh": "c0f42c3e4fec",
  "ko": "뭐, 나도 들은 얘기라 진짜인지는 모르지만"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 35,
  "jh": "f2236b66fe49",
  "ko": "이 반지에는 그런 힘이 있대. 마나를 이 세계에서 지워 버리는"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "c23c48ff6147",
  "ko": "…왜 이 반지를 나한테 준 거지?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 35,
  "jh": "5359951f4c89",
  "ko": "왜냐면 너도 마나를 싫어하잖아?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "96abe18d7156",
  "ko": "…!? 누구한테 들었어!?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 35,
  "jh": "32cefb749bf7",
  "ko": "어라, 맞혀 버렸어? 그냥 찍어 본 건데"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 0,
  "jh": "07e24b264b3f",
  "ko": "웃기지 마! 너 대체… 정체가 뭐야?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 35,
  "jh": "236140ef355e",
  "ko": "잠깐. 너만 질문하는 건 치사해. 나도 묻고 싶은 게 있는데"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 35,
  "jh": "679ffafa930b",
  "ko": "네 이름. 아직 못 들었지"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 0,
  "jh": "9b9627c1ef71",
  "ko": "………로제다. 로제류크스 마이첸"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 35,
  "jh": "55bbfd9d7fe0",
  "ko": "아, 역시"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 0,
  "jh": "38815de5612c",
  "ko": "역시?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 14,
  "jh": "763664630441",
  "ko": "이쪽 얘기야. 아, 참고로 내 이름은 루리히"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 14,
  "jh": "5506d01223ef",
  "ko": "친근하게 '루'라고 불러 주면 기쁠 것 같은데"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 0,
  "jh": "f08a9858f336",
  "ko": "…루리히, 로군"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 14,
  "jh": "6e0b36eda6aa",
  "ko": "분위기 못 맞추네… 뭐, 됐어. 약속이 있어서 오늘은 이만 실례할게"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 0,
  "jh": "198e9540c923",
  "ko": "기다려! 아직 물어볼 게…"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 0,
  "jh": "c191f41083ae",
  "ko": "벌써 안 보여… 무슨 속도야"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 0,
  "jh": "d584baec12e7",
  "ko": "누가 마나를 싫어한다는 거야… 마나를 지우는 반지는 무슨… 젠장!"
 },
 {
