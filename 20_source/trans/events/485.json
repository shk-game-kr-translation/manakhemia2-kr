[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "054db5b25d8c",
  "ko": "콕, 콕콕. 푸니푸니~"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 24,
  "jh": "a37b8bcfbeab",
  "ko": "으으으… 너무 찌르지 말아 줘…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "f6c31fb64f91",
  "ko": "이렇게 말랑말랑하면 안 찌르고는 못 배기잖아?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 3,
  "jh": "c6962b5807db",
  "ko": "…아아, 바늘로 찌르면 어떻게 될까. 터지거나 할까…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 24,
  "jh": "c12efd7b18fd",
  "ko": "아아아, 안 돼! 뾰족한 건 절대 안 돼!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 3,
  "jh": "1452714a2fda",
  "ko": "농담이야. 그런 심한 짓은 안 해… 콕콕, 꾹꾹"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 24,
  "jh": "535a875b6b28",
  "ko": "아아아, 지금도 나름 심한 짓을…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 7,
  "jh": "5d408d5262a5",
  "ko": "오늘도 달리네~ 릴리아"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 4,
  "jh": "1a5222b23a48",
  "ko": "주인은 푸니푸니 앞에서 성격이 돌변하는 게 골칫거리군"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "e5bd1457ea1f",
  "ko": "그런데 평소보다 더 심하지 않냐? 뭐랄까 이렇게…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 22,
  "jh": "43c2b0ef1661",
  "ko": "가학적인 느낌이군. 너무 심하면 말려야겠다만"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 7,
  "jh": "5be37c69d664",
  "ko": "안 하는 게 좋아~ 분명 둘 다 같이 당할 테니까"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 5,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 11,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 5,
  "jh": "c511225cbf69",
  "ko": "푸니. 푸니니~니, 푸니!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 23,
  "jh": "34ee5e1f2917",
  "ko": "남자 마음을 간질이는 포인트는 질투심을 부추기는 거다! 라며 여동생이 열변을 토하고 있어요"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 3,
  "jh": "a1c39e25a08a",
  "ko": "질투심… 그렇구나. 다른 남자한테 마음 있는 척하면 분명 로제도…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 11,
  "jh": "396f3151b1f4",
  "ko": "다른 남자라니, 누구 있어요?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "132ea70ec47a",
  "ko": "음… 윤은 마나고, 토니 선생님은 말도 안 되고… 교감, 아니, 허를 찔러 교장…?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "32c16601101c",
  "ko": "아, 안 돼! 변변한 남자가 없어!!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 11,
  "jh": "d32191fff552",
  "ko": "푸니요 씨, 아쉽지만 실현 불가능해요. 아이디어는 좋았을지도 모르지만…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 5,
  "jh": "69d1ac565a2f",
  "ko": "푸니~. 푸니니"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 23,
  "jh": "8cb43dd71d1a",
  "ko": "문제없다. 릴리아 씨에겐 안성맞춤인 상대가 있다. 라며 여동생이 의미심장해요"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 11,
  "jh": "7c4eb00c2e30",
  "ko": "안성맞춤인 상대? 누구요?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 5,
  "jh": "68159c57be62",
  "ko": "푸니! 푸니니!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 23,
  "jh": "bb8864ad0044",
  "ko": "네? 그래도 푸니요, 그건…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 3,
  "jh": "f6508ed09bec",
  "ko": "둘이서만 얘기하지 말고 제대로 통역해"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 23,
  "jh": "b9fdc0f37984",
  "ko": "으, 그래도… 알겠어요"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 23,
  "jh": "c559e12cc719",
  "ko": "특별히 우리 사부로를 빌려주겠다. 마음껏 만지작거려라… 래요"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 3,
  "jh": "d39f86dde74d",
  "ko": "뭣… 푸니 사부로 만지기 무제한!?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 11,
  "jh": "fa0e9b52f375",
  "ko": "그런 수가!! 확실히 아가씨와 푸니푸니라면 아무 위화감 없이…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 11,
  "jh": "e9112a93cc4d",
  "ko": "무서운… 무서운 분이에요, 푸니요 씨… 자기 가족까지 이용하다니…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 5,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 23,
  "jh": "e921c9d99786",
  "ko": "여동생은 짓궂은 미소를 띠고 있어요…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 11,
  "jh": "69d9afd8186e",
  "ko": "저, 푸니요 씨… 이거 사부로 씨한텐…?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 5,
  "jh": "7811c8225995",
  "ko": "푸니, 푸니니. 푸니~"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 23,
  "jh": "12da848ee4fe",
  "ko": "사부로는 연기를 할 줄 아는 타입이 아니라서 당연히 비밀이다"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 23,
  "jh": "216a74354bdf",
  "ko": "본 작전은 사부로의 꾸밈없는 반응에 기대하는 부분이 크다… 래요"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 3,
  "jh": "cf6a23a56beb",
  "ko": "아아, 너무 만지작거렸더니 배고파졌어… 깨물어도 될까?"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 24,
  "jh": "ff1bed10f070",
  "ko": "안 돼! 봐, 난 무미무취고! 혀에 닿는 촉감 말고는 좋은 데가 없다고!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 3,
  "jh": "4d2fbee3f406",
  "ko": "촉감만으로도 충분한데…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 24,
  "jh": "4b064ece406c",
  "ko": "안 된다니까! 깨, 깨물지 마!!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 3,
  "jh": "bea55b78d164",
  "ko": "후후, 농담이야. 그럼 식당에라도 갈까. 단둘이서"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 24,
  "jh": "e0a648dbc242",
  "ko": "아니, 난 배 안 고프니까…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "e0470b1df7b6",
  "ko": "단둘이서. 알았지?"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 24,
  "jh": "1b825951e9b6",
  "ko": "으… 네…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 5,
  "jh": "360a25ea32a9",
  "ko": "푸니~, 니니…"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 23,
  "jh": "03b7c5abd6f2",
  "ko": "릴리아 씨의 훌륭한 연기에 여동생도 감탄하고 있어요"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 11,
  "jh": "a8fee8990c3a",
  "ko": "어디까지가 연기인지 모르겠지만요…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 7,
  "jh": "81bc8517ec56",
  "ko": "나가 버렸네… 좋아, 쫓아가자!"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 22,
  "jh": "29be89eb8c85",
  "ko": "음. 이대로라면 사부로의 몸에 위험이 닥칠 가능성이 있다"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 0,
  "jh": "7c33a3b0a7d7",
  "ko": "난 됐어. 너희끼리 알아서 가"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 7,
  "jh": "17541ed948b5",
  "ko": "그렇게 말하면서 사실은 신경 쓰이면서. 자, 가자!"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 0,
  "jh": "a41ca4bccf02",
  "ko": "야, 잡아당기지 마!"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 4,
  "jh": "a1e27a59dd96",
  "ko": "…이대로면 주인의 평판, 나아가 내 평판에도 흠이 가나… 이런이런"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 11,
  "jh": "d0ee208b5f9b",
  "ko": "로제 씨, 전혀 관심 없어 보이는데요"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 5,
  "jh": "2c6636270009",
  "ko": "푸니~. 푸니"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 23,
  "jh": "43d8a83b102a",
  "ko": "그 나이 또래 남자는 비뚤어진 말투를 쓰는 법이다. 푸니요는 안다… 래요"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 11,
  "jh": "7f801b051a1f",
  "ko": "하아… 푸니요 씨가 그렇게 말씀하신다면"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
