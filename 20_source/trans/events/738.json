[
 {
  "key": "m0",
  "kind": 0,
  "chr": 12,
  "jh": "d8826722a8bd",
  "ko": "후우, 드디어 완성했나. 생각보다 시간이 걸려 버렸군"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 12,
  "jh": "19749f2e2a25",
  "ko": "올해 학생들은 늦었지만 내년 신입생 놈들은"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 12,
  "jh": "ca3b791c8ce8",
  "ko": "1년간 여기서 단련하면 필시 훌륭한 전투원이…"
 },
 {
  "key": "m3",
  "kind": 5,
  "chr": 0,
  "jh": "fe14e8fc0925",
  "ko": "저… 군나르 선생님?"
 },
 {
  "key": "m4",
  "kind": 5,
  "chr": 1,
  "jh": "a7a6f870ef2f",
  "ko": "저기~ 군나르 선생님?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 12,
  "jh": "0cb007c5b7d4",
  "ko": "응…? 누옷!? 왜 네놈들이 여기에!?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 0,
  "jh": "f077488e5dd9",
  "ko": "왜냐니, 평범하게 내려왔는데요"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "4d110564eded",
  "ko": "왜냐니, 평범하게 내려온 게 당연하잖아"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 12,
  "jh": "c7e66ffef2a7",
  "ko": "평범하게, 라고? 말도 안 돼!? 그럼 군나르 굿즈도 전부 모아 왔다는 거냐!?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "e20a45f8612e",
  "ko": "군나르 굿즈? 아아, 이거 말인가요"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 3,
  "jh": "e650e354220b",
  "ko": "정말이지, 이런 시시한 걸 모으게 하고 무슨 생각이야"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "d906b4c98670",
  "ko": "군나르 굿즈? 아아, 혹시 이거?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "7b341f22f5ef",
  "ko": "이왕이면 좀 더 좋은 아이템을 둬 주면 좋을 텐데"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 12,
  "jh": "3e1901c03347",
  "ko": "으음, 각 계층 보스도 전부 격파하고 왔다는 건가…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 12,
  "jh": "1f8ae3d32d09",
  "ko": "난이도 조정을 잘못했나? 아니, 이 몸의 계산은 완벽했을 텐데…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 12,
  "jh": "44e81947706b",
  "ko": "그렇다면 이놈들의 전투력이 예상 이상이었다는 건가. 그렇다면… 아니 하지만…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 11,
  "jh": "5b194c7f6f1d",
  "ko": "뭔가 중얼거리고 계시네요…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 4,
  "jh": "920537778ac0",
  "ko": "아아. 안 좋은 일이 일어날 전조군"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "3dc61676a314",
  "ko": "잠깐. 뭘 중얼거려? 남의 말 듣고 있어?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 12,
  "jh": "e67edbc48a0c",
  "ko": "좋아! 이렇게 된 이상 이 몸이 직접 네놈들의 실력을 확인해 주마!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 0,
  "jh": "737e9c5e50e8",
  "ko": "…네? 갑자기 무슨… 무리한 말씀 마세요"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "7ff691414d5c",
  "ko": "이건 또 갑자기 무리한 소릴 꺼냈네"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 12,
  "jh": "f7914c429904",
  "ko": "뭐가 무리냐. 이 몸의 계산이 틀렸는지, 네놈들이 너무 강했는지"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 12,
  "jh": "7fbbf205b78f",
  "ko": "확인하려면 이 방법밖에 없지 않겠나"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 4,
  "jh": "17b312a91f44",
  "ko": "왠지 이렇게 될 것 같긴 했다"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 9,
  "jh": "59fa47c19c16",
  "ko": "이런이런. 뭐, 이렇게 될 거라고는 생각했지만"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 12,
  "jh": "670130c9f0a6",
  "ko": "이번만은 이 몸도 조금 진심을 내 주마… 누웅!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 7,
  "jh": "8ff76d6cea67",
  "ko": "와와!? 군나르 선생님이 둘이 됐어!?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 0,
  "jh": "0b042def4198",
  "ko": "이제 뭐든지 다 되네, 이 사람은…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "3f2d5a27dbfe",
  "ko": "뭐, 뭐야 그거? 왜 둘이 된 거야!?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 2,
  "jh": "275562d7f859",
  "ko": "이제 뭐든 다 되네…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 12,
  "jh": "0f32fde7b969",
  "ko": "이 몸이 두 번째를 꺼내게 한 건 네놈들이 처음이다"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 12,
  "jh": "4d2576aecd20",
  "ko": "영광으로 알아라… 그럼 간다!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 12,
  "jh": "b32c4992d634",
  "ko": "하하하! 역시 그런가. 네놈들이 너무 강했을 뿐인가"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 12,
  "jh": "b0ec07c89c63",
  "ko": "음, 이 몸의 계산이 틀릴 리가 없으니까"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 0,
  "jh": "03384dc90be3",
  "ko": "라니, 왜 쓰러뜨렸는데 멀쩡한 거예요…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 1,
  "jh": "95290634692c",
  "ko": "라니, 왜 쓰러뜨렸는데 멀쩡한 거야!?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 12,
  "jh": "b86c2b23dc98",
  "ko": "말했잖나. 「조금」 진심을 낸다고. 이 몸은 아직 여력이 충분하다"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 23,
  "jh": "ebcea70b8c9c",
  "ko": "저걸로 여력 충분이라니… 라며 여동생은 놀랍고도 어이없는 복잡한 심경이에요"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 8,
  "jh": "2e44109101fd",
  "ko": "저걸로 여력 충분이냐… 봐줘"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 12,
  "jh": "210ec28ed7c4",
  "ko": "하지만 학생 중엔 네놈들 같은 규격 외가 드물게 섞여 있지"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 12,
  "jh": "7c00589b69a0",
  "ko": "예전의 이 몸이 그랬듯이. 그 사실을 까맣게 잊고 있었다"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 12,
  "jh": "e11e9a2ad888",
  "ko": "자, 내년도를 위해 다시 이 던전을 조정해야겠군"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 12,
  "jh": "b19bb0d8d990",
  "ko": "더 흉악하게, 더 난이도 높게… 후후후, 재밌어졌다!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 0,
  "jh": "289fba222873",
  "ko": "저 선생님한텐 평생 이길 것 같지 않아…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 11,
  "jh": "2512133bed8a",
  "ko": "여기서 더 흉악하게라니… 내년도 학생들한테 못할 짓 했네요"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 0,
  "jh": "538ce67fca8f",
  "ko": "거기까지 책임질 수 있겠냐…"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 1,
  "jh": "82e1c35d4b69",
  "ko": "하아… 이제 됐어. 제대로 상대하는 것도 바보 같아…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 2,
  "jh": "ebc231fe8ce0",
  "ko": "내년 학생들은 더한 지옥을 맛보게 되겠네… 울리카 탓에…"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 1,
  "jh": "be6730d27c13",
  "ko": "몰라. 거기까지 책임 못 져"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]