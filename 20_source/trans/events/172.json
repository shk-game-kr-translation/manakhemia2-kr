[
 {
  "key": "m0",
  "kind": 2,
  "chr": 21,
  "jh": "3db9e2077e0d",
  "ko": "여, 왔냐"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "2f4b9efd3632",
  "ko": "이제 괜찮아?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 21,
  "jh": "972e302669ab",
  "ko": "흥, 그 정도 상처는 별거 아니다"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 0,
  "jh": "4ebe8deda0d3",
  "ko": "강한 척하지 마. 죽을 뻔했으면서"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 21,
  "jh": "b19e0cdca30a",
  "ko": "가만히 당하고만 있었던 건 아니야. 저쪽에도 상당한 대미지를…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "800c6bc6915f",
  "ko": "멀쩡하던데… 그보다 이런 잡담할 때가 아니잖아"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 21,
  "jh": "22497a4292c5",
  "ko": "그랬지… 어디까지 들었냐?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "b93ba5f77881",
  "ko": "그 녀석이 마나 사냥 일을 하고 있었고… 영감 마나를 사냥한 것도 그 녀석이라고…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 21,
  "jh": "a5bec6b995b8",
  "ko": "그런가. 나랑 루 꼬마… 그 녀석의 관계는?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "e3491b6d44b9",
  "ko": "그건 못 들었어"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 21,
  "jh": "5e324ffaa058",
  "ko": "그럼 거기서부터 얘기할까. 벌써 10년은 된 얘기다"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 21,
  "jh": "f61960d8c648",
  "ko": "그 시절 난 엄청나게 강했지. 이 나라에선 따를 자가 없다고 칭송받았어"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "4635dae5fed7",
  "ko": "그 얘기라면 어릴 때 몇 번이나 들었어"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 21,
  "jh": "e0236b470895",
  "ko": "뭐 들어 봐라. 그래서 그만큼 강하다 보니 빛의 마나라는 녀석 눈에도 띄었는데"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 21,
  "jh": "0564d46631f1",
  "ko": "어느 날 마나 사냥 일을 도와 달라고 하더군. 물론 거절했지만"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 21,
  "jh": "3b3b2fe6d5e8",
  "ko": "그래서 나 대신 뽑힌 게 루 꼬마… 루리히였던 거다"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "bb1135e05ee8",
  "ko": "그 녀석이랑 아는 사이였어?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 21,
  "jh": "7a741015e010",
  "ko": "조금 안면이 있었던 정도지만. 그때 그 녀석은 지금 너랑 비슷한 나이였나"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 21,
  "jh": "f565b434db8b",
  "ko": "천재 검사라 불렸지. 바보같이 강했어… 내가 더 강했지만"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "335d596c6310",
  "ko": "그러니까 일일이 자랑을 끼워 넣지 마"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 21,
  "jh": "8eddfec828dd",
  "ko": "좋잖냐. 조금쯤…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 21,
  "jh": "69b148847dbd",
  "ko": "다만 강한 것치고 어딘가 위태로운 구석이 있었어"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 21,
  "jh": "60f81093390f",
  "ko": "그저 강해지고 싶다. 강한 녀석과 싸우고 싶다. 그런 생각만 하고 있었지"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 21,
  "jh": "219f8b7cfa97",
  "ko": "나한테도 볼 때마다 승부를 신청해 왔지만 전부 거절했다"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 21,
  "jh": "7c256a7f9f3f",
  "ko": "그런 녀석이랑 싸우면 어느 한쪽이 크게 다칠 게 뻔했으니까"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "8d287e913ec3",
  "ko": "그래서 애가 타서 영감 마나를… 이라는 건가"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 21,
  "jh": "e9b4496e7eb1",
  "ko": "그런 모양이야. 그러면 내가 화나서 승부에 응할 거라 생각했겠지"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 11,
  "jh": "c35d2764df81",
  "ko": "그런 제멋대로인 이유로…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 21,
  "jh": "80b8586cb67f",
  "ko": "그런 녀석이야. 지금 생각하면 한번 제대로 이겨 놨어야 했어"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 7,
  "jh": "633d621d89a5",
  "ko": "음~ 그러니까… 할아버지랑 못 싸워서 분해서 로제랑 싸우고 싶어 했던 거야?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 21,
  "jh": "f7322b089e51",
  "ko": "그런 거겠지. 정말이지, 천재라는 놈들 생각은 모르겠구먼"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 0,
  "jh": "3e733218cf47",
  "ko": "나로선 정말 민폐야"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 21,
  "jh": "8e94940d6cb3",
  "ko": "미안하다고 생각해. …미안한 김에 부탁이 하나 있는데"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 0,
  "jh": "8dcc91d7489b",
  "ko": "…뭔데"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 21,
  "jh": "ad7c950920cc",
  "ko": "10년 전의 나 대신 그 녀석을 날려 버리고 와 줘"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 0,
  "jh": "399e71ae279e",
  "ko": "무리야"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 21,
  "jh": "869525d18b4c",
  "ko": "즉답이냐!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 0,
  "jh": "d114aaf17989",
  "ko": "방금 지고 온 참이라고!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 0,
  "jh": "12d263aa7248",
  "ko": "보통으로 해도 못 이기는데 제정신까지 잃었다고… 그런 놈을 어떻게 상대해!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 21,
  "jh": "37f6e6ff61af",
  "ko": "거기를 어떻게 좀 부탁한다. 그 녀석이 저렇게 된 건 반은 내 책임이니까…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 21,
  "jh": "535e280cfbf5",
  "ko": "아니, 반은 좀 과했나. 3분의 1, 5분의 1… 뭐, 그건 아무래도 좋아"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 21,
  "jh": "5bc490decd06",
  "ko": "아무리 네가 싫어해도 언젠가 저쪽에서 올 거다. 평생 도망 다닐 셈이냐?"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 0,
  "jh": "1814333059c8",
  "ko": "크… 그러니까 누구 탓인데…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "e6011d6df255",
  "ko": "정말, 아까부터 듣자 하니 한심하네"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 3,
  "jh": "202a27a0cd56",
  "ko": "혼자 못 이기겠다면 내가 도와줄게"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 0,
  "jh": "320c6966336e",
  "ko": "무슨 말씀이세요!?"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 3,
  "jh": "56777d6d6e41",
  "ko": "네가 졌다는 건 주인인 내가 졌다는 것…"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 3,
  "jh": "4a4c59d82f1e",
  "ko": "이 내가 지기만 한 채 가만히 있을 것 같니?"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 0,
  "jh": "3e858a067e40",
  "ko": "무슨 논리예요. 애초에 아가씨랑 둘이서도…"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 4,
  "jh": "6924c0634896",
  "ko": "주인이 싸운다면 나에겐 선택권이 없군"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 11,
  "jh": "d2ce69b52f77",
  "ko": "저도… 실제로 싸우는 건 저니까요"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 7,
  "jh": "8188d5ca28a5",
  "ko": "나도 갈래~! 로제보다 세지, 그 사람?! 우와~ 재밌겠다!"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 5,
  "jh": "75264012baa0",
  "ko": "푸니, 푸니니~…"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 23,
  "jh": "f4a3fc8a33b9",
  "ko": "드디어 푸니요의 진심을 보여 줄 때가 왔나… 라며 여동생은 벌써 투기가 넘쳐요"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 0,
  "jh": "81715e5daed5",
  "ko": "…너희 말이야"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 21,
  "jh": "546da7831e14",
  "ko": "이제 네 마음 하나구먼"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 11,
  "jh": "1238a3dc199e",
  "ko": "농담처럼 말씀하시지만 위르겐 씨도 진지하신 거예요. 그러니까…"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 0,
  "jh": "fd24a1792366",
  "ko": "그런 건 너한테 안 들어도 알아"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 11,
  "jh": "6b8a07d6f1ff",
  "ko": "아, 그럼 이렇게 해요"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 11,
  "jh": "b85b47d2e7c0",
  "ko": "그 루라는 사람을 쓰러뜨려 주면 아까 일은 용서해 드릴게요"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 0,
  "jh": "66347adb0243",
  "ko": "뭐!? …왜 너까지 날 그 녀석이랑 싸우게 하려는 거야"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 11,
  "jh": "89bb731cc427",
  "ko": "로제 씨도 사실은 싸우고 싶은 거 아니에요?"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 11,
  "jh": "7c7c0700db48",
  "ko": "하지만 혼자선 못 이기니까 포기한 척하는 것뿐이고"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 0,
  "jh": "d4033294ae0c",
  "ko": "아는 척하기는…"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 11,
  "jh": "928457478776",
  "ko": "게다가 제대로 결판을 안 내면 로제 씨 분명 질질 끌 테고…"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 11,
  "jh": "f127c053610b",
  "ko": "그러면 제가 힘들어요. 아가씨 상대만으로도 벅찬데…"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 11,
  "jh": "544cb5eb3018",
  "ko": "거기에 기분 나쁜 로제 씨까지 돌봐야 하니까요"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 0,
  "jh": "7b9c700062b2",
  "ko": "………알았어. 하면 되잖아. 져도 불평하지 마"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 11,
  "jh": "11e35b8b36f3",
  "ko": "네!"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 3,
  "jh": "effb623d200e",
  "ko": "그런데… 누구 상대하는 게 힘들다고?"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 11,
  "jh": "90ba4bb1a85e",
  "ko": "아… 아, 아니에요! 방금 건 로제 씨를 설득하기 위한 말의 표현이랄까…"
 },
 {
  "key": "m72",
  "kind": 0,
  "chr": 3,
  "jh": "d7a96958abf0",
  "ko": "다친 사람이라고 상냥하게 대해 줬더니 기어오르기는…"
 },
 {
  "key": "m73",
  "kind": 0,
  "chr": 11,
  "jh": "469c220d9693",
  "ko": "그, 그렇지 않아요! 아, 뭐예요? 그 손놀림은. …그, 그만두세요오오!"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 0,
  "jh": "45b61c8cce49",
  "ko": "그렇게 됐어. 바라던 대로 돼서 좋겠다"
 },
 {
  "key": "m75",
  "kind": 2,
  "chr": 21,
  "jh": "96d4443d0f82",
  "ko": "그렇게 비꼬는 말투 쓰지 마라. 뭐, 부탁한다"
 },
 {
  "key": "m76",
  "kind": 2,
  "chr": 0,
  "jh": "b3db6d5ef262",
  "ko": "…하나 더 묻고 싶은 게 있는데"
 },
 {
  "key": "m77",
  "kind": 2,
  "chr": 21,
  "jh": "ed306d712f71",
  "ko": "뭔데?"
 },
 {
  "key": "m78",
  "kind": 2,
  "chr": 0,
  "jh": "1393e98b4158",
  "ko": "마나가 사라졌을 때… 왜 나한테 거짓말했어?"
 },
 {
  "key": "m79",
  "kind": 2,
  "chr": 0,
  "jh": "468f8c9f01d9",
  "ko": "왜 그 녀석한테 사냥당했다고 말 안 했어?"
 },
 {
  "key": "m80",
  "kind": 2,
  "chr": 21,
  "jh": "50c1b058df9d",
  "ko": "…누가 지웠다고 말하면 너, 그놈을 원망했을 거 아니냐?"
 },
 {
  "key": "m81",
  "kind": 2,
  "chr": 21,
  "jh": "8bcc8d2ac8c6",
  "ko": "누군가를 원망하면서 자라면 변변한 녀석이 못 될 것 같아서 말이다"
 },
 {
  "key": "m82",
  "kind": 2,
  "chr": 21,
  "jh": "ad53f88237a4",
  "ko": "설마 더 비뚤어져서 마나 쪽을 원망하게 될 줄은 몰랐다만"
 },
 {
  "key": "m83",
  "kind": 2,
  "chr": 0,
  "jh": "bf466b8b95c0",
  "ko": "…당신을 닮은 거야"
 },
 {
  "key": "m84",
  "kind": 0,
  "chr": 21,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m85",
  "kind": 0,
  "chr": 0,
  "jh": "b2c5012443d1",
  "ko": "응, 야. 영감"
 },
 {
  "key": "m86",
  "kind": 0,
  "chr": 29,
  "jh": "466c7d348d46",
  "ko": "잠들어 버린 모양이네. 자자, 오늘은 여기까지"
 },
 {
  "key": "m87",
  "kind": 0,
  "chr": 29,
  "jh": "becd889e462c",
  "ko": "의연하게 얘기했지만 큰 부상을 입었으니까"
 },
 {
  "key": "m88",
  "kind": 0,
  "chr": 3,
  "jh": "7c10fdc96216",
  "ko": "가자, 로제"
 },
 {
  "key": "m89",
  "kind": 0,
  "chr": 0,
  "jh": "746263bb44b1",
  "ko": "네…"
 },
 {
  "key": "g0s0",
