[
 {
  "key": "m0",
  "kind": 0,
  "chr": 8,
  "jh": "d6b6810af3f9",
  "ko": "꽤 걸었다고. 어디까지 데려갈 거야"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 12,
  "jh": "5b520b75a91a",
  "ko": "그렇게 재촉하지 마라. 남의 눈에 띄면 이래저래 곤란해서… 이 근처면 되겠지"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 12,
  "jh": "8e07fb028abb",
  "ko": "잠시 자 줘야겠다"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 8,
  "jh": "c96e3c45f5de",
  "ko": "어, 이봐, 뭘 할 생각… 컥!?"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 35,
  "jh": "65e7b35e63d7",
  "ko": "…그래서 기절시켜서 데려왔다고. 여전히 난폭하네"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 12,
  "jh": "6fa797f56a10",
  "ko": "이 방법이 제일 빠르니까"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 35,
  "jh": "f2d976fa3faa",
  "ko": "말은 잘하네… 그래서 이 애가 이걸 만들었다고. 흠… 호오… 헤에에…"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 12,
  "jh": "21548c03aaf0",
  "ko": "뜸 들이지 마. 좋은지 나쁜지 확실히 말해라"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 35,
  "jh": "021db39bec26",
  "ko": "나쁘지 않네. 이 나이에 여기까지 하면 대단한 거야"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 12,
  "jh": "8f75a855de7e",
  "ko": "호오. 그럼 지금 당장이라도 네 밑에 붙일까"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 35,
  "jh": "98d23cb25054",
  "ko": "그건 시기상조려나. 내 밑에선 지식은 늘어도 재능은 안 자라거든"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 35,
  "jh": "2b7c6ba06c14",
  "ko": "좀 더 독학으로 수행시키는 게 재밌어질 것 같아"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 12,
  "jh": "ba9b5369675e",
  "ko": "호오. 예상 이상의 재능을 가졌다는 건가?"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 35,
  "jh": "dd2f68f4669f",
  "ko": "그 해석은 마음대로. 그래도 빈손으로 돌려보내긴 불쌍하네…"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 35,
  "jh": "43e0ab0d635b",
  "ko": "그래. 그걸 선물할까"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 12,
  "jh": "f0ddca22c9cc",
  "ko": "호오, 그건가. 어지간히 이 꼬마가 마음에 든 모양이군"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 35,
  "jh": "6dc00b55f322",
  "ko": "잠시 이 애 머리 좀 잡아 줄래"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 35,
  "jh": "3711b2a55f38",
  "ko": "기절해 있어도 아픔에 반응할지도 모르니까. 히힛히…"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 1,
  "jh": "7e09dbdf124c",
  "ko": "…어이! 에나! 어이~! 일어나~!"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 8,
  "jh": "8a7e637a12c7",
  "ko": "응아?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 8,
  "jh": "dbeb3c7ff2fb",
  "ko": "어, 어라? …왜 내가 이런 데서 자고 있지?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "1021f54eaac1",
  "ko": "그건 내가 할 말이야. 언제 돌아온 거야"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 2,
  "jh": "c6ec946619a9",
  "ko": "군나르 선생님한테… 뭔가 당했어…? 하아하아…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 8,
  "jh": "edc814a4a25c",
  "ko": "그러니까, 교감이랑 둘이 걷다가 그 도중에… 아아!?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 6,
  "jh": "78b34e832e55",
  "ko": "뭐야? 뭘 당했어?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 8,
  "jh": "7227a922cb4d",
  "ko": "…머릿속에 본 적도 없는 계산식이랑 설계도가 떠올라…"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 8,
  "jh": "6ceae0bac098",
  "ko": "으아아아! 안 돼! 가만히 못 있겠어!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 9,
  "jh": "0bdf02c56b0e",
  "ko": "왜 그래? 갑자기…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 8,
  "jh": "e91bcf6e03b5",
  "ko": "말 걸지 마! 잊기 전에 형태로 만들어야… 큰일이다! 머리가 터질 것 같아!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 9,
  "jh": "087a00e166d1",
  "ko": "마치 사람이 바뀐 것 같군"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 2,
  "jh": "9a1f7d57d245",
  "ko": "응… 다른 의미로 무서워…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 6,
  "jh": "e4fd4d74c876",
  "ko": "응? 형, 머리카락에 피가 묻었어"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 8,
  "jh": "690dc7e2ffa7",
  "ko": "응? 진짜네, 딱지가… 뭐, 별 상처 아니야"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "515876672a4f",
  "ko": "결국 뭐야… 영문을 모르겠어"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 9,
  "jh": "50a37a5046ba",
  "ko": "「뭔가」를 당한 거겠지. 그 선생님한테"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 2,
  "jh": "a728db31f8b6",
  "ko": "내가 기대한 쪽은 아닌 것 같지만…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]