[
 {
  "key": "m0",
  "kind": 0,
  "chr": 5,
  "jh": "8eb3ff4599b5",
  "ko": "푸니~… 쿨~…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 22,
  "jh": "237308fda85b",
  "ko": "푸니요는 잠들었나"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 24,
  "jh": "39bbb0ed439f",
  "ko": "낮잠 시간이고. 게다가 지쳤나 봐"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 3,
  "jh": "68e435d6e51d",
  "ko": "그래서 뭔데? 일부러 다 모아 놓고 하고 싶은 얘기가"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 22,
  "jh": "7ac54d52c35f",
  "ko": "…우리 푸니푸니와 인간의 꺼림칙한 과거의 악연에 대해서다"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "e3903aa040b2",
  "ko": "과거의 악연…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 7,
  "jh": "c1e96e6d2da5",
  "ko": "애초에 인간이랑 푸니푸니는 사이가 나쁜 거야?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 23,
  "jh": "0e346fa6151f",
  "ko": "이 지방은 푸니푸니가 적어서 모르는 것도 무리는 아니지만…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 23,
  "jh": "5ce6a2232464",
  "ko": "심한 곳에선 얼굴만 마주쳐도 서로 침을 뱉을 정도로 음습한 관계라던가"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 11,
  "jh": "49d5b298afe2",
  "ko": "그건… 싫네요"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 23,
  "jh": "91b778e51d49",
  "ko": "아득한 옛날엔 서로 지혜 있는 생물로서 아주 우호적인 관계였다던데…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 7,
  "jh": "de3d456f6ad9",
  "ko": "그게 왜 사이가 나빠진 거야?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 23,
  "jh": "3c79b42344a1",
  "ko": "그에 대해선 여러 설이 있지만, 한 설에 따르면…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 22,
  "jh": "d92123ec21f4",
  "ko": "인간이 우리 푸니푸니를 뼈도 없는 녀석들이라고 모욕했기 때문이다"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 3,
  "jh": "85cb8dbe906c",
  "ko": "…그런 시시한 일로?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 23,
  "jh": "dfa21231a77f",
  "ko": "시시하지 않아요. 뼈가 없다는 건 즉 무척추동물이라는 건데"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 23,
  "jh": "72b6d9a8a30b",
  "ko": "이는 인간과 다른 뇌신경 전달 방식이 형성되어 있다는 증거이며…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 23,
  "jh": "caaf2747cac5",
  "ko": "이는 생물학적으로도 매우 중요하고 의의 깊은 것으로…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 7,
  "jh": "7309f6fe6c86",
  "ko": "무, 무척추…? 우~ 어려운 얘기는 그만~!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 4,
  "jh": "21d65edaaa04",
  "ko": "간단히 말하면 용서하기 힘든 폭언을 들었다는 거군"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 23,
  "jh": "22c81e56eef5",
  "ko": "네. 개중엔 인간과 말만 섞어도 원수 취급하는 과격파까지 있어서"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 23,
  "jh": "859caeb3e80e",
  "ko": "하물며 인간 아이를 키우다니…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 3,
  "jh": "4275455fb4ca",
  "ko": "그건 심상치 않네"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 24,
  "jh": "86a7a62f1b36",
  "ko": "착한 푸니푸니도 많은데…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 7,
  "jh": "ad9a60252f46",
  "ko": "그래도 푸니요를 괴롭히는 건 나쁜 푸니푸니지?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 24,
  "jh": "43fec0d8d987",
  "ko": "응…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 0,
  "jh": "2c36eb143e9c",
  "ko": "그렇다면 너희랑 같이 있으면 우리도…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 3,
  "jh": "b835641ec951",
  "ko": "응, 이 기척은?"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 7,
  "jh": "8a3e164c79c5",
  "ko": "와, 뭔가 잔뜩 왔다!"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 0,
  "jh": "249a58ae91d6",
  "ko": "이 녀석들한테 하루 종일 노려진다는 거군"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 23,
  "jh": "ddba5d8ea80e",
  "ko": "폐를 끼칩니다… 푸니요, 일어나"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 5,
  "jh": "1f6d9b90f287",
  "ko": "푸니~…?"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 54,
  "jh": "12a798fda8fa",
  "ko": "헤헤헤. 아까는 잘도 해 줬겠다"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 55,
  "jh": "e8edc8985b62",
  "ko": "이번엔 두 배 인원으로 왔슴다. 각오하십쇼!"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 3,
  "jh": "fa1aeeca9ad6",
  "ko": "이럴 수가… 내 아틀리에가 푸니푸니 투성이…!"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 4,
  "jh": "bde7b461cfc6",
  "ko": "알고 있겠지만 저건 적이다"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 3,
  "jh": "2985fcd7d276",
  "ko": "아, 알고 있어! 알고는 있지만…"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 55,
  "jh": "9caa933bb76f",
  "ko": "형님! 인간 놈들도 딱 좋게 모여 있슴다"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 54,
  "jh": "faffcf226326",
  "ko": "아아. 녀석들, 한꺼번에 해치워라!"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 0,
  "jh": "653e0051ccf6",
  "ko": "후우… 푸니푸니라 해도 이만한 수를 상대하면 지치는군"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 55,
  "jh": "f279456ce172",
  "ko": "형님… 저 이제 글렀슴다…"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 54,
  "jh": "59a7bbf80d54",
  "ko": "제, 제기랄… 오늘은 봐주마! 하지만 다음엔 각오해 둬라!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 3,
  "jh": "d3203c63c1df",
  "ko": "질 나쁜 푸니푸니들이네… 모처럼의 촉감도 저래선 엉망이야"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 11,
  "jh": "65235daa19ac",
  "ko": "저 모양이면 또 언제 습격해 올지 모르겠네요. 조심해야…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 7,
  "jh": "aea5432aea63",
  "ko": "푸니푸니의 습격에 떠는 나날이라~ 좀 멋있다!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 0,
  "jh": "0e55e80acccb",
  "ko": "정말 평온한 생활과는 인연이 없나 보군. 난…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 5,
  "jh": "5af7a498a2e6",
  "ko": "…푸니"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 0,
  "jh": "bfbc6be97300",
  "ko": "응? 뭐야"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 23,
  "jh": "3bd136f410d1",
  "ko": "폐를 끼치는 것 같아 죄송하다며 여동생이 사과하고 있어요"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 0,
  "jh": "efbb5ed42053",
  "ko": "…신경 쓰지 마. 꼬맹이는 꼬맹이답게 태평하게 있어"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
