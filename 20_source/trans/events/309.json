[
 {
  "key": "m0",
  "kind": 2,
  "chr": 4,
  "jh": "d42c4dc5a94a",
  "ko": "도착했다. 여기다"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "c029533247a3",
  "ko": "우와, 왠지 싱겁다"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 6,
  "jh": "2b79de05319d",
  "ko": "이 몸이 진심으로 도우면 이 정도지!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 8,
  "jh": "e5f7324ae506",
  "ko": "제정신인 사람 하나 있는 것만으로 이렇게 다르구나…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 2,
  "jh": "7e25f55cad17",
  "ko": "우리 아틀리에는… 꽝을 두 마리나 떠안았고"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 9,
  "jh": "fcc0b3811dc6",
  "ko": "그가 도우러 와 준 건 내 매력 덕분이야? 그 점을 평가해 줬으면 해"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 6,
  "jh": "bb6975f61273",
  "ko": "그런 너를 아틀리에에 꼬신 건 이 몸이라고!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 2,
  "jh": "322ec0964395",
  "ko": "하는 말이 쩨쩨해… 있잖아, 차라리 우리 아틀리에에 오지 않을래?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 4,
  "jh": "1734b4709319",
  "ko": "지금 주인보다 더 많이 준다면 생각해 보지 않을 수도 있다만"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "3248bfc318f2",
  "ko": "윽, 돈 받아? 그럼… 저 둘이랑 트레이드로"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 4,
  "jh": "3f00c1512d1a",
  "ko": "그런 얘기는 주인과 협상해라. 고개를 끄덕일 것 같진 않지만"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 4,
  "jh": "89cb2593ef0a",
  "ko": "자, 잡담은 이쯤 하고 볼일을 마치는 게 어떠냐"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "051bfeebb0d3",
  "ko": "아, 그랬지"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "4a80e831a809",
  "ko": "대충 끝났으려나…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "02e43c497795",
  "ko": "생각보다 빨리 끝날 것 같네. 뭐 하고 놀다 갈래?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 2,
  "jh": "6e502d730e6e",
  "ko": "지쳤으니까 이제 돌아가고 싶어…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 8,
  "jh": "171b71e3179b",
  "ko": "동감"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 6,
  "jh": "0188168432d4",
  "ko": "이 몸이 어울려 줄게, 누나!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 9,
  "jh": "c9684e261579",
  "ko": "그럼 나도. 가끔은 조금 어른스러운 놀이 같은 것도 괜찮겠지"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 4,
  "jh": "9bcf4f58da65",
  "ko": "난 슬슬 돌아가 보겠다"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "816ae4e2ea63",
  "ko": "흐음, 다들 의리 없네… 어쩔 수 없지, 돌아갈까"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "c252a807281b",
  "ko": "어라? 왠지 화려하게 무시당했는데?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 9,
  "jh": "f4395e9cffda",
  "ko": "꼬시는 방법이 좀 대담했나. 이제 와서 부끄러워할 사이도 아닌데"
 },
 {
  "key": "m23",
  "kind": 5,
  "chr": 15,
  "jh": "7c9ac84e457e",
  "ko": "찾… 았다"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 1,
  "jh": "eaafdb8ee28e",
  "ko": "와앗!? 스토커 여자!"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 10,
  "jh": "01b7def58a76",
  "ko": "우!?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 4,
  "jh": "1568b0bc23f7",
  "ko": "아는 사이냐?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "bb2c81eec854",
  "ko": "우리 애를 노리는 이상한 여자야! 이런 데까지 나타나다니…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 4,
  "jh": "8f6597daec38",
  "ko": "흠… 확실히 제정신으로 보이진 않는군"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 15,
  "jh": "a8f1b6926f20",
  "ko": "마나… 결혼… 마나…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 8,
  "jh": "575fc0258ffc",
  "ko": "전에 만났을 땐 더 멀쩡하지 않았냐?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "6225a89c0fd9",
  "ko": "응… 잠깐, 괜찮아? 안색이 엄청 나쁜데"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 6,
  "jh": "7a4846c07649",
  "ko": "누나, 다가가면 위험해. 물릴 거야"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "c8ccc063b715",
  "ko": "괜찮겠지. 개나 고양이도 아니고"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 2,
  "jh": "3ac396931669",
  "ko": "그 미약하게 보인 상냥함이 울리카의 운명을 미치게 했던 것이다…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 15,
  "jh": "b4f16420a188",
  "ko": "으… 으아아아~~~! 마나, 내놔아아아~!!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 1,
  "jh": "9add4a8dd1a8",
  "ko": "으아앗!?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 2,
  "jh": "076f4f074a95",
  "ko": "아아… 그러니까 말했는데…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "fa4207c8387c",
  "ko": "지지지, 진정하지 말고 도와줘!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 6,
  "jh": "d1744d707994",
  "ko": "오오, 그렇지. 지금 갈게!"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 4,
  "jh": "850dd6581e36",
  "ko": "대단한 휴일이 돼 버렸군…"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 15,
  "jh": "1475db4ad2c0",
  "ko": "으, 으…"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 10,
  "jh": "b7190356a4de",
  "ko": "우~!"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 15,
  "jh": "bd017cabb95a",
  "ko": "으…"
 },
 {
  "key": "m45",
  "kind": 0,
  "chr": 4,
  "jh": "85b9b170c44f",
  "ko": "…움직이지 않게 됐나"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 8,
  "jh": "1cd21108f31a",
  "ko": "죽은 척하는 것뿐일지도 몰라"
 },
 {
  "key": "m47",
  "kind": 0,
  "chr": 2,
  "jh": "1e089aa8bc6d",
  "ko": "요정 씨… 숨통은 맡길게…"
 },
 {
  "key": "m48",
  "kind": 0,
  "chr": 6,
  "jh": "8d35625cda49",
  "ko": "싫어~ 이 몸, 벌레도 못 죽이는 성격인데"
 },
 {
  "key": "m49",
  "kind": 0,
  "chr": 15,
  "jh": "76475b26ec40",
  "ko": "으아아아아아앙!"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 1,
  "jh": "8245b754c034",
  "ko": "와아아! 이번엔 또 뭐야!?"
 },
 {
  "key": "m51",
  "kind": 0,
  "chr": 15,
  "jh": "4378e7105a62",
  "ko": "졌… 져 버렸어… 아아아아앙!!"
 },
 {
  "key": "m52",
  "kind": 0,
  "chr": 1,
  "jh": "3c318f418866",
  "ko": "그, 그렇게 큰 소리로 안 울어도… 앗, 잠깐!"
 },
 {
  "key": "m53",
  "kind": 0,
  "chr": 15,
  "jh": "489b90167af2",
  "ko": "흐윽, 훌쩍… 으아아아앙!"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 8,
  "jh": "e92b57725c6c",
  "ko": "가 버렸네… 괜찮은 거냐? 저거…"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 2,
  "jh": "7537b3e89217",
  "ko": "아무리 봐도 안 괜찮은 것 같아…"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 1,
  "jh": "97ec1be47cad",
  "ko": "더 내버려 둘 순 없겠네… 일단 선생님한테 말해 둬야지"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 4,
  "jh": "2b5747ed6fa4",
  "ko": "보통은 제일 먼저 교사한테 상의하러 가지 않나?"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 2,
  "jh": "2bb1a23f44e8",
  "ko": "우리 선생님들은 다들 저 모양이니까…"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 4,
  "jh": "1b4790424552",
  "ko": "그랬지… 대처가 정해졌으면 난 돌아가 보겠다"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 9,
  "jh": "a95cc92d57ee",
  "ko": "왠지 미안하네. 모처럼 놀러 와 줬는데"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 4,
  "jh": "57605484b294",
  "ko": "신경 쓸 거 없다… 그 마나, 부디 잘 지켜 줘라"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 1,
  "jh": "a7e33cbbc416",
  "ko": "말 안 해도 그럴 생각이야"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 9,
  "jh": "a72e8eddced8",
  "ko": "또 여자애를 울려 버렸어. 뒷맛이 개운치 않네"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 6,
  "jh": "dfdd8691713e",
  "ko": "다음에 둘이서 달래 주면 되잖아"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 9,
  "jh": "6fe04c7aa462",
  "ko": "거기선 눈치 좀 챙겨서 나 혼자 가게 해 줬으면 하는데"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 6,
  "jh": "c0474c07f0da",
  "ko": "뭐야~ 이 몸을 따돌리는 거야?"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 9,
  "jh": "7845ddd69656",
  "ko": "그럴 생각은 없어. 다만 넌 그럴 상황이 아닐지도 몰라서"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 6,
  "jh": "63b5ba17ffde",
  "ko": "그렇지… 아무 일도 안 일어나는 게 제일 좋았는데"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]