[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "9c8755e8471c",
  "ko": "…후우, 어떻게든 도망쳤어"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "0b6c6220ea13",
  "ko": "군나르 선생님, 언제 이런 데를 만들었을까…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "015288eb2599",
  "ko": "응? 왜 군나르 선생님?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 8,
  "jh": "d8df33c51be7",
  "ko": "됐으니까 좀 쉬자… 태클 걸 기운도 없어…"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 1,
  "jh": "367362e3bda2",
  "ko": "결국 우리만 남았네…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 8,
  "jh": "f39f6f205d2d",
  "ko": "뭐, 원래 무리였지"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 1,
  "jh": "27e6c3ac90e2",
  "ko": "무리 아니야! 우리가 살아 있는 한 진 게 아니야!"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 2,
  "jh": "cc125640eabf",
  "ko": "차라리 울리카가 당해 주면 난 해방될 텐데…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 1,
  "jh": "99fed268c14a",
  "ko": "그래도 이제 어떡하지… 다음 지시도 안 오고…"
 },
 {
  "key": "m9",
  "kind": 5,
  "chr": 6,
  "jh": "dbf5a859bc96",
  "ko": "적습! 적습~~!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 6,
  "jh": "87a365859b5a",
  "ko": "누나! 적이야! 적이 왔어!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "38a8c045440a",
  "ko": "정말! 진짜 끈질기다니까!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 8,
  "jh": "f3bc4dd17af0",
  "ko": "그보다… 그렇게 큰 소리 내면 여기까지 들키잖아"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 6,
  "jh": "8fbf30fdac45",
  "ko": "앗, 이런 실수를! 페페론 대실패야!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "f57b660ce13d",
  "ko": "이제 도망칠 곳도 없는데… 책임지고 적한테 돌격해서 난도질당하고 와…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 6,
  "jh": "2c5634908c62",
  "ko": "에에에!? 난도질당하는 것까지 확정이야?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 8,
  "jh": "67516c4d6b0e",
  "ko": "잠깐, 바보 얘기 하는 사이에…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "cb6f2ac6fc34",
  "ko": "드디어 몰아넣었다, 시골뜨기!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "ff963418cca8",
  "ko": "크읏… 응? 아~! 에토! 너 왜 그쪽에 있는 거야!?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 7,
  "jh": "07b57e81b0ad",
  "ko": "아, 아하하하… 미안! 왜냐면 릴리아가 도깨비 같은 얼굴로 노려보는걸!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "6d150a0df225",
  "ko": "어머, 부처님 같은 넓은 마음으로 용서해 줬는데… 그래, 그런 말을 하는구나"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 7,
  "jh": "c5c9ed80e6c4",
  "ko": "아, 거짓말이에요. 죄송해요. 릴리아는 내 마음에 내려온 천사예요"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 0,
  "jh": "7d6be8dfaa2d",
  "ko": "…아가씨, 잡담은 나중에"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "8874e0f81ba1",
  "ko": "앗, 그렇지… 쌓이고 쌓인 원한, 한꺼번에 풀어 주겠어!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "263eca53e53f",
  "ko": "그건 내가 할 소리야! 너희 따위한테 절대 안 질 거야!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "40ed0d8575a9",
  "ko": "…적당히 체념해"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "47d11c4961e9",
  "ko": "싫어! 너한테만은 절대 안 질 거야!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 10,
  "jh": "b7190356a4de",
  "ko": "우~!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 7,
  "jh": "0d53b237a620",
  "ko": "왜 그래? 왠지 얼굴 무서워"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 0,
  "jh": "efb2242a4a7d",
  "ko": "…그 마나, 10년 걸려서 손에 넣었다고 했지"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "0f75ac46c223",
  "ko": "뭐야, 갑자기? 아, 혹시 부러워졌어?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "3a7c29f979e1",
  "ko": "설마. 아주 소중하겠구나 싶었을 뿐이야"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "5e182c0f4ea3",
  "ko": "당연하지. 이렇게 귀여운걸"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 0,
  "jh": "18525304d383",
  "ko": "…마나 쪽은 널 어떻게 생각할까"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "5590ff801110",
  "ko": "어?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 3,
  "jh": "5aee058daf80",
  "ko": "로제, 왜 그래? 아까부터 이상해"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 0,
  "jh": "ca462321c535",
  "ko": "별로… 문득 떠오른 건데요…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 0,
  "jh": "a5a09f32dbe5",
  "ko": "저 마나를 쓰러뜨리면 이 녀석도 얌전해지지 않을까요"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "fa887249d536",
  "ko": "뭐, 뭐라고!?"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 4,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 11,
  "jh": "c7479bd7f6ae",
  "ko": "로제 씨… 진심으로 하시는 말씀이에요?"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 0,
  "jh": "38d13825c8b3",
  "ko": "…농담이 당연하잖아"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 4,
  "jh": "d57f7b26f7e9",
  "ko": "기분 좋은 농담은 아니군"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 1,
  "jh": "ecb1a6314f8e",
  "ko": "너 말이야! 농담이라도 해도 되는 말과 안 되는 말이…"
 },
 {
  "key": "m45",
  "kind": 0,
  "chr": 0,
  "jh": "63c4f06df940",
  "ko": "무슨 소리지?"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 1,
  "jh": "962f530c8bc0",
  "ko": "으아아… 정말! 이럴 때!"
 },
 {
  "key": "m47",
  "kind": 5,
  "chr": 9,
  "jh": "51da83521ace",
  "ko": "야아, 기다리게 했군. 화났어, 마루타…"
 },
 {
  "key": "m48",
  "kind": 5,
  "chr": 18,
  "jh": "836fd442d5aa",
  "ko": "화낼 리가 없잖아요. 모처럼 당신과 단둘이 만날 수 있는데…"
 },
 {
  "key": "m49",
  "kind": 0,
  "chr": 2,
  "jh": "8f5be5054bf7",
  "ko": "이 목소리, 탈인형 씨랑…"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 3,
  "jh": "753e85b1db1e",
  "ko": "이사장… 맞지?"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 9,
  "jh": "07328d250764",
  "ko": "그런데 괜찮았던 걸까? 지금쯤 학생들은 필사적으로 싸우고 있을 텐데…"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 18,
  "jh": "bdd923f3b599",
  "ko": "전혀 상관없어요. 입학금과 수업료만 내 주면 학생 따위 볼일 없는걸요"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 9,
  "jh": "38d23f793fc2",
  "ko": "그래? 분명 거액의 원조를 해 주는 학생도 있다고 들었는데"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 18,
  "jh": "ed435159cb40",
  "ko": "아아, 그 애는 다루기 쉽죠"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 18,
  "jh": "d0a83c7bb8d4",
  "ko": "돈도 내 주고 치켜세우면 시키는 대로 일해 주고… 정말 편리한 애예요"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 9,
  "jh": "a407649584d0",
  "ko": "나쁜 여자로군. 그렇게 학생을 속이듯 세상 남자들도 속여 온 걸까"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 18,
  "jh": "31ac0dc1ddb3",
  "ko": "어머, 속고 있는 건 저예요. 눈앞의 신사분에게요…"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 9,
  "jh": "6cf0e9d13cad",
  "ko": "영광이군… 하지만 난 어느 학생의 아틀리에에서 일하는 몸…"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 9,
  "jh": "151623fe6dc4",
  "ko": "이런 게 그녀한테 들키기라도 하면…"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 18,
  "jh": "3db6f0420e2f",
  "ko": "걱정 마세요. 그 애에겐 이번 일의 책임을 지고 퇴학해 달라고 할 테니까요"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 18,
  "jh": "c6e69bd15ed4",
  "ko": "그렇게 되면 당신은 저만의 것이…"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 9,
  "jh": "4e1127976bf7",
  "ko": "만약 그렇게 되면 당신이 평생 날 돌봐 주는 걸까"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 18,
  "jh": "d644886272ef",
  "ko": "당연하죠. 내년엔 연금술과도 없애서 학원 이익도 오를 테니까요"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 18,
  "jh": "65f296be7bed",
  "ko": "당신은 그저 제 곁에 있어 주면 돼요…"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 9,
  "jh": "bc7b23c1b919",
  "ko": "흐응… 이만큼 알아냈으면 충분하려나"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 18,
  "jh": "b097467fc0e6",
  "ko": "뭐라고 하셨나요?"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 9,
  "jh": "11cdf7f0af46",
  "ko": "아니, 그냥 혼잣말이야"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 18,
  "jh": "f9d7f62b355c",
  "ko": "…저기, 이제 얼굴 좀 보여 주시지 않겠어요?"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 9,
  "jh": "c929540ba571",
  "ko": "아아… 보여 주고 싶지만 공교롭게도 등 지퍼에 손이 안 닿아서…"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 18,
  "jh": "20973637c9ab",
  "ko": "그럼 제가 벗겨 드릴게요… 자, 더 가까이…"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 7,
  "jh": "92c43a1d58b8",
  "ko": "아~! 왜 끊어 버리는 거야?"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 1,
  "jh": "7ee50609f885",
  "ko": "더 이상 안 듣는 게 좋아… 분명"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 2,
  "jh": "1a626f2fb0d6",
  "ko": "여러 의미로 재밌어질 것 같았는데…"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 3,
  "jh": "22f7bf700c21",
  "ko": "흥미로운 얘기를 들었네… 이 내가 싸울 상대를 착각하고 있었어"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]