[
 {
  "key": "m0",
  "kind": 2,
  "chr": 12,
  "jh": "4d6d95b55ebb",
  "ko": "도망치지 않고 왔나. 그 배짱은 칭찬해 주마"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 12,
  "jh": "1b58c0b22da5",
  "ko": "동료와의 작별은 이미 끝냈나?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 8,
  "jh": "796ab71064a8",
  "ko": "필요 없어. 내가 이기면 되니까"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 12,
  "jh": "473d842190f6",
  "ko": "호오, 강하게 나오는군. 좋아, 점점 마음에 든다"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 8,
  "jh": "3679b98a734a",
  "ko": "군소리 말고 얼른… 응? 당신 무기는 어쨌어?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 12,
  "jh": "122bb15e38c0",
  "ko": "무기 따윈 필요 없다. 네놈 상대는 이 몸이 아니니까"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 8,
  "jh": "6a5e17c1865d",
  "ko": "무슨 소리야!? 난 당신이랑 싸울 생각으로…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 12,
  "jh": "095289cfdd37",
  "ko": "자만하지 마라. 네놈 따위가 이 몸 상대가 될 거라 생각했나?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 12,
  "jh": "577be3f364ae",
  "ko": "네놈에겐 제대로 그릇에 맞는 상대를 준비해 뒀다. 이 녀석이다!"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 8,
  "jh": "4bbce78f51b4",
  "ko": "뭣!? 이 녀석은…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 1,
  "jh": "d2bfd9f77b82",
  "ko": "…토니 선생님?"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 2,
  "jh": "01a719d343cb",
  "ko": "치고는 꽤 젊은데…"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 35,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 12,
  "jh": "1f576e085e39",
  "ko": "후후후, 놀랐군"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 12,
  "jh": "03d327f09802",
  "ko": "이 녀석이야말로 토니의 머리카락을 빌려 몰래 만들어 낸 비밀 병기…"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 12,
  "jh": "1183c94d51c0",
  "ko": "그 이름도 토니 클론!"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 2,
  "jh": "aab1c77715a1",
  "ko": "너무 뻔한 네이밍…"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 9,
  "jh": "d6c119614acc",
  "ko": "그나저나 정말 엉망진창인 짓을 하는 사람이군…"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 6,
  "jh": "60d217c353af",
  "ko": "그러게. 기계로 학생을 조종하질 않나, 클론을 만들어 내질 않나…"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 2,
  "jh": "354e93d5c383",
  "ko": "윤리관이라곤 없어…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 12,
  "jh": "14598081d6ca",
  "ko": "급조라서 지능은 좀 부족하다만 전투력은 원본을 넘는다"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 8,
  "jh": "c9089b3a56db",
  "ko": "이 녀석을 이기면 약속대로 난 자유인 거지?"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 12,
  "jh": "8387b143301e",
  "ko": "이길 수 있다면 말이지"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 8,
  "jh": "bb27e42543b3",
  "ko": "…솔직히 좀 안심했어. 당신을 상대하는 것보단 나을 테니까"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 1,
  "jh": "d81348eb42c5",
  "ko": "그러게. 게다가 토니 선생님은 때리기 좋은 얼굴이고"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 6,
  "jh": "48dd825daa04",
  "ko": "누나도 은근히 심한 말 하네"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 9,
  "jh": "cc559108d897",
  "ko": "일부러 적당한 상대를 준비해 왔다는 건 역시…"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 60,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 12,
  "jh": "cbaed4221481",
  "ko": "이미 토니 클론은 의욕 충만이다. 각오는 됐나, 꼬마?"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 8,
  "jh": "5817275d5bec",
  "ko": "언제든 와라! 이 1년 동안 단련한 내 기계의 힘을 보여 주지!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 8,
  "jh": "dd29ad072e78",
  "ko": "하아… 이겼다! 이겼다아아!!"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "aa0441ccfa1d",
  "ko": "해냈다! 에나 대단해!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 6,
  "jh": "e307f7567d8f",
  "ko": "형이 처음으로 빛나 보여!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 2,
  "jh": "b6366a419317",
  "ko": "…그건 촛불이 꺼지기 전 한순간의 빛과도 닮은…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 9,
  "jh": "afe6d3417169",
  "ko": "여긴 순순히 축하해 줄 데 아닌가?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 12,
  "jh": "2e04807ebbe3",
  "ko": "호오, 이건… 이 몸의 예상 이상의 실력이었다는 건가"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 1,
  "jh": "2eba6fd90884",
  "ko": "아쉽게 됐네! 당신 같은 사람한테 에나는 안 줄 거야!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 8,
  "jh": "c903086b1b70",
  "ko": "약속은 약속이다. 그럼 난 돌아가겠…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 12,
  "jh": "adde705388d9",
  "ko": "약속이란 깨기 위해 있는 것… 위대한 선인이 남긴 말이다"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 8,
  "jh": "15ed6ff1b90c",
  "ko": "뭐라고!?"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 12,
  "jh": "b9ba2a6bd75e",
  "ko": "여흥으로는 충분히 즐겼다"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 12,
  "jh": "3ca9fd940400",
  "ko": "하지만 네놈 머리에 칩이 심어져 있는 이상 처음부터 승부에 의미 따윈 없다"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 1,
  "jh": "c7f7093b3185",
  "ko": "당신 명색이 교사잖아! 그게 약속을 깨다니…"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 12,
  "jh": "97e187b5cef5",
  "ko": "교사는 교사라도 이 몸은 악의 교사다. 아무 문제 없겠지"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 6,
  "jh": "b69fd0120e94",
  "ko": "오오. 왠지 엄청난 설득력이야!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 12,
  "jh": "ed9120685622",
  "ko": "네놈의 두뇌는 이 몸이 고맙게 써 주마! 체념해라!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 8,
  "jh": "878f40e443da",
  "ko": "그! 게! 고고고고…"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 6,
  "jh": "3978238c664a",
  "ko": "아아아, 형!"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 12,
  "jh": "f2f2779601be",
  "ko": "자, 이 몸 발밑에 무릎 꿇고 영원한 충성을 맹세해라!"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 8,
  "jh": "3aec743a3b6e",
  "ko": "그가가가…… 라고 할 줄 알았지"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 12,
  "jh": "c049ae053c83",
  "ko": "뭐!?"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 1,
  "jh": "bed26e4987c9",
  "ko": "아쉽게 됐네. 에나 머리 기계라면 어제 내가 떼어 버렸어. 봐!"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 8,
  "jh": "42bbd54d095c",
  "ko": "딱지를 떼니까 같이 빠져 버렸어"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 12,
  "jh": "706fe4b97dc3",
  "ko": "뭐라? 고작 딱지 따위로!"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 1,
  "jh": "c1e202f3a979",
  "ko": "자, 돌아가자 돌아가! 아~ 방금 교감 얼굴 보니까 속 시원하다!"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 2,
  "jh": "4b8b82a61622",
  "ko": "악의 교감 격파. 최약 소년이 일으킨 기적… 오랜만의 특종…"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 8,
  "jh": "e42d1f2c0346",
  "ko": "야, 기다려. 방금 최약이라고 했냐?"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 6,
  "jh": "860b7f02a724",
  "ko": "돌아가면 축승회야! 특제 요정 씨 전골 만들어 줄게!"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 8,
  "jh": "b07c987ae9a3",
  "ko": "뭐, 그래도 이긴 건 누나들이 도와줘서야… 고마워"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 1,
  "jh": "11128f332acb",
  "ko": "뭐, 뭐야 갑자기!? 징그럽게"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 8,
  "jh": "84b823b7074e",
  "ko": "뭐야, 그렇게 쑥스러워하지 않아도 되잖아"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 6,
  "jh": "790e50dc93a5",
  "ko": "누나도 의외로 수줍음이 많네"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 2,
  "jh": "7ab55af95ada",
  "ko": "두 사람 사이에 플래그가 섰다…"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 1,
  "jh": "0bb5b99a8c30",
  "ko": "영문 모를 소리 하지 마!"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 12,
  "jh": "cb368fd6c9c6",
  "ko": "…후, 후후후"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 12,
  "jh": "5123929c0c5a",
  "ko": "하~하하하! 재밌다. 최고로 재밌군!"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 9,
  "jh": "ffbefe20f79b",
  "ko": "처음부터 계산대로… 라는 건가?"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 12,
  "jh": "9161a6c6a3ab",
  "ko": "아니, 보다시피다. 이 몸의 계산을 뛰어넘었다… 실로 유쾌하군!"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 9,
  "jh": "b2781b8005d0",
  "ko": "그냥 즐기고 싶었을 뿐이라는 건가… 정말 소란스럽군"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 12,
  "jh": "6cdb0579907a",
  "ko": "부정은 안 하마. 하지만 그 꼬마가 꼭 갖고 싶어졌다"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 9,
  "jh": "0b0b47fb0366",
  "ko": "너한테 찍히다니 에나 군도 고생이군…"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 9,
  "jh": "51e5ce1a4dd2",
  "ko": "뭐, 다음에 뭔가 꾸미는 건 아가씨들이 졸업한 뒤로 부탁해"
 },
 {
  "key": "m72",
  "kind": 0,
  "chr": 12,
  "jh": "4ccd66b93b38",
  "ko": "자, 다음엔 어떤 수로 갈까…"
 },
 {
  "key": "m73",
  "kind": 5,
  "chr": 35,
  "jh": "ef02684e7ebf",
  "ko": "아무래도 넌 악역이 다 못 되는군…"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 12,
  "jh": "bfa74516e9f5",
  "ko": "또 보고 있었나. 어떠냐, 네가 보기에 그 꼬마는?"
 },
 {
  "key": "m75",
  "kind": 5,
  "chr": 35,
  "jh": "4d7cdf554480",
  "ko": "꽤 실력이 늘었네. 당장이라도 갖고 싶다고 하고 싶지만…"
 },
 {
  "key": "m76",
  "kind": 2,
  "chr": 12,
  "jh": "95e543b53704",
  "ko": "당분간 참아라. 이 몸이 다음 책략을 짜낼 때까지"
 },
 {
  "key": "m77",
  "kind": 5,
  "chr": 35,
  "jh": "3f30752953f3",
  "ko": "흐응… 뭐, 기대 안 하고 기다릴게"
 },
 {
  "key": "m78",
  "kind": 2,
  "chr": 12,
  "jh": "f3d3fbe3ac5c",
  "ko": "…그런데 하나 묻고 싶은 게 있다만"
 },
 {
  "key": "m79",
  "kind": 5,
  "chr": 35,
  "jh": "9a03b69538fa",
  "ko": "응? 뭔데?"
 },
 {
  "key": "m80",
  "kind": 2,
  "chr": 12,
  "jh": "3f2c64e72342",
  "ko": "전부터 이상하게 생각했는데, 어디서 이 몸에게 말을 거는 거냐?"
 },
 {
  "key": "m81",
  "kind": 5,
  "chr": 35,
  "jh": "2fa42ee8b061",
  "ko": "…몰랐어? 여기야, 여기"
 },
 {
  "key": "m82",
  "kind": 2,
  "chr": 12,
  "jh": "1496c99dd790",
  "ko": "여기라고 해도… 이 몸이 기척조차 못 느낀다는 건…"
 },
 {
  "key": "m83",
  "kind": 5,
  "chr": 35,
  "jh": "08bd38cdf569",
  "ko": "잘 귀를 기울여서… 아니, 차라리 귀를 막아 봐"
 },
 {
  "key": "m84",
  "kind": 2,
  "chr": 12,
  "jh": "50d1b7011fa4",
  "ko": "귀를… 음? 막아도 들리… 설마!?"
 },
 {
  "key": "m85",
  "kind": 5,
  "chr": 35,
  "jh": "e61e61dc4d48",
  "ko": "그래, 네 머릿속이야. 요전에 만취했을 때 심었거든"
 },
 {
  "key": "m86",
  "kind": 5,
  "chr": 35,
  "jh": "d35e75a89df7",
  "ko": "당연히 알면서 무시하는 줄 알았어"
 },
 {
  "key": "m87",
  "kind": 2,
  "chr": 12,
  "jh": "c9073507c8c5",
  "ko": "뭐! 이 몸은 못 들었다! 빼라, 당장 빼라!"
 },
 {
  "key": "m88",
  "kind": 5,
  "chr": 35,
  "jh": "88feac485903",
  "ko": "괜찮아. 언젠가 딱지랑 같이 빠질 거야… 히힛히히히…"
 },
 {
  "key": "m89",
  "kind": 2,
  "chr": 12,
  "jh": "828baae2d269",
  "ko": "이 몸이 이런 불찰을… 누가아아아!!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]