[
 {
  "key": "m0",
  "kind": 2,
  "chr": 5,
  "jh": "3216e54a2d86",
  "ko": "푸니~~~!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "9d7340ce3f85",
  "ko": "와!? 뭐야, 갑자기…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 5,
  "jh": "2cf49a2437df",
  "ko": "푸니! 니! 푸니!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 0,
  "jh": "02f8ae8c77ab",
  "ko": "뭐라는지 도무지 모르겠는데… 오늘은 통역 없어?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 11,
  "jh": "01e13212c9e2",
  "ko": "그게 아무래도 행방불명인 것 같아요"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "6e99be32ac3f",
  "ko": "행방불명?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "2c0d92ca2172",
  "ko": "일어났을 때 늘 베개 삼던 타로네가 안 보였대"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "01e627b8865b",
  "ko": "용케 거기까지 알아내셨네요… 미안하지만 난 아무것도 몰라"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 5,
  "jh": "60dda55a629b",
  "ko": "푸니… 푸니이~…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "1b76ad119ec6",
  "ko": "어, 이봐. 울지 마. 곤란하네…"
 },
 {
  "key": "m10",
  "kind": 5,
  "chr": 7,
  "jh": "e2e3da9415b4",
  "ko": "좋은 아침~!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "2179c51f1639",
  "ko": "오, 마침 잘 왔다. 이 녀석 좀 부탁해"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 5,
  "jh": "1475b074de97",
  "ko": "푸니이~!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 7,
  "jh": "b0a232ad14ef",
  "ko": "와와. 왜 푸니요가 울어?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 7,
  "jh": "a2a0e1a941e8",
  "ko": "난 푸니푸니가 어디 갔는지 같은 거 몰라?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 0,
  "jh": "179262c403a0",
  "ko": "…아직 아무 말도 안 했는데"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 7,
  "jh": "b2bae5ad928a",
  "ko": "앗, 아차! 그러니까… 혹시 나 예지 능력에 눈뜬 걸지도!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "28578ea6133c",
  "ko": "너 말이야, 이왕이면 좀 더 그럴듯한 거짓말을 해"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 7,
  "jh": "260b71b7c3af",
  "ko": "거, 거짓말 아니야! 어릴 때 신선을 만나서 혹독한 수행 끝에 드디어…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "df6131061898",
  "ko": "그런 지어낸 얘긴 됐으니까 내 푸니푸니들을 어디 보냈는지 말해!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 4,
  "jh": "8729e9110a34",
  "ko": "어수선한 틈에 점유권을 주장하는 건 어떨까 싶다만"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 7,
  "jh": "7f8634b3e026",
  "ko": "그, 그러니까 정말 내가 아니라니까…"
 },
 {
  "key": "m22",
  "kind": 5,
  "chr": 23,
  "jh": "5a722c322f40",
  "ko": "아뇨… 전부 에토 씨 짓이에요…"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 7,
  "jh": "2cf9edcd4e1b",
  "ko": "와아!? 살아 있었어?"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 5,
  "jh": "4c9e1a54c85b",
  "ko": "푸니!?"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 23,
  "jh": "0de694f73b79",
  "ko": "미안해, 푸니요. 걱정 끼쳐서…"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 7,
  "jh": "51ab5ea392a4",
  "ko": "살금살금… 슬금슬금…"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 0,
  "jh": "13ba876658f3",
  "ko": "어디 가려고?"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 7,
  "jh": "dc1cc2f64d8d",
  "ko": "와~! 놔 줘~!"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 3,
  "jh": "1840d92f1aee",
  "ko": "그래서, 저 애는 대체 뭘 저지른 거야?"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 23,
  "jh": "fba6fec795a4",
  "ko": "네… 어젯밤 다들 잠든 무렵 에토 씨한테 불려 나가서…"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 23,
  "jh": "bb68988e05a6",
  "ko": "대체 뭐예요. 이런 시간에 불러내다니"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 22,
  "jh": "1cdb9301a295",
  "ko": "수면 부족은 피부 윤기에 안 좋다만…"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 24,
  "jh": "65895b470fea",
  "ko": "후아아… 졸려…"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 7,
  "jh": "3238f1f8243b",
  "ko": "단도직입적으로 말할게. 두 번 다시 에나한테 다가가지 마!"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 22,
  "jh": "281ae1f7f465",
  "ko": "어? 다가가지 말라고 해도…"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 23,
  "jh": "616d66f5790d",
  "ko": "여동생이랑 같은 반에서 공부하고 있으니까…"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 7,
  "jh": "5330bd760fe0",
  "ko": "안 된다면 안 되는 거야! 굳이 그러겠다면!"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 24,
  "jh": "444ccf539fca",
  "ko": "와와? 뭐 하는 거야?"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 22,
  "jh": "146c936275e1",
  "ko": "그, 그만둬~!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 0,
  "jh": "9144d4cc8934",
  "ko": "그래서 힘껏 푸니푸니를 내던졌다고…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 7,
  "jh": "b1a63bbc6927",
  "ko": "그만 기세로… 데헷!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 3,
  "jh": "405c66939c9d",
  "ko": "데헷이 아니야! 너 무슨 짓을!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 7,
  "jh": "638f74b3341a",
  "ko": "그치만 그치만… 동생 애인이 푸니푸니라니 누나로서 그냥 넘길 수 없었는걸!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "fa6c5fb4f679",
  "ko": "…네?"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 11,
  "jh": "db6266d2339d",
  "ko": "그러니까, 에토 씨는 에나 씨와 푸니 타로 씨네가 그런 관계라고?"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 7,
  "jh": "38bdb511eeb6",
  "ko": "다들 봤잖아?"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 7,
  "jh": "76832629fb5e",
  "ko": "에나도 기뻐 보였고 푸니푸니는 음흉한 눈빛이었고!"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 23,
  "jh": "442d8858afbf",
  "ko": "실례네요. 저흰 원래 이런 얼굴이에요…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 4,
  "jh": "e78d85818321",
  "ko": "그걸 보고 어떻게 그런 결론에 도달하는지"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 0,
  "jh": "e9d35a074050",
  "ko": "그러게. 아무리 생각해도 상대는 푸니요잖아"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 7,
  "jh": "ba1e496ca4a1",
  "ko": "어? 푸니요? …아. 아아아아아!!"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 0,
  "jh": "0ca340973c09",
  "ko": "겨우 알아챘나…"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 7,
  "jh": "72c9971084c8",
  "ko": "우와~ 그랬구나! 어떡해, 나 푸니푸니 던져 버렸어!"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 5,
  "jh": "7adf9ba468d3",
  "ko": "푸니! 푸니~!"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 7,
  "jh": "a1344ff8d801",
  "ko": "와~ 미안. 미안하다니까. 아, 아무튼 찾으러 가야지"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 3,
  "jh": "929749ec924b",
  "ko": "어디로 던졌는지 기억해?"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 7,
  "jh": "efcaffb79234",
  "ko": "음~… 학교 어딘가일 텐데. 힘껏 던져 버려서…"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 0,
  "jh": "234967458b8b",
  "ko": "닥치는 대로 찾을 수밖에 없겠군…"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 11,
  "jh": "3a0c38d72e73",
  "ko": "아가씨의 푸니푸니 레이더만이 믿을 구석이네요"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 3,
  "jh": "29d76ce48ea0",
  "ko": "응. 푸니푸니 찾기라면 나한테 맡겨!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]