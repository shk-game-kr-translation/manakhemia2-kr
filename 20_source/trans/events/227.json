[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "4a67fea02f7a",
  "ko": "안녕하세요. 자, 말해 봐"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 10,
  "jh": "8279a79105b5",
  "ko": "아아아~우"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "cd2152c5ec4a",
  "ko": "좋아, 그건 그거대로 귀여워. 그럼… 내 이름은 말할 수 있게 됐어?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 10,
  "jh": "f956428940f6",
  "ko": "우류리카"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "411e6af8da2b",
  "ko": "아~… 아직 무리인가. 뭐, 됐어. 조만간 조만간, 응"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 10,
  "jh": "9dc66ada9e64",
  "ko": "우!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 8,
  "jh": "2fce1857d9cc",
  "ko": "…못 봐주겠다"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 2,
  "jh": "f57d1c46607c",
  "ko": "그치… 에나도 한마디 해 줘… 죽으라고"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 8,
  "jh": "b845904fbf25",
  "ko": "그렇게까진 생각 안 해. …그보다 저건 무슨 말을 해도 소용없잖아"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 9,
  "jh": "55c806432518",
  "ko": "으~음… 이건 곤란한 사태로군"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 6,
  "jh": "5d89e6eee896",
  "ko": "너도 그렇게 생각해?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 9,
  "jh": "319c5af58a98",
  "ko": "이렇게 댄디하고 코케티시한 탈인형이 왔는데?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 9,
  "jh": "f7c7066eec9c",
  "ko": "보통 여자애라면 만사 제치고 안겨 올 텐데…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 6,
  "jh": "234a1516c5af",
  "ko": "누나는 이 몸의 매력도 모르는 사람이니까"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 9,
  "jh": "37a9e0e2c504",
  "ko": "흠… 거기서 도출되는 가설은 두 가지로군"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 9,
  "jh": "3de612d47da4",
  "ko": "하나는 네 귀여움에 너무 익숙해져서 내 매력을 못 알아본다는 것"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 6,
  "jh": "0f4cd9ec2393",
  "ko": "우와! 그거 참신하고 가슴 뛰는 새 해석이네!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 9,
  "jh": "2dc81750a2bb",
  "ko": "다른 하나는… 말하기 어렵지만 아가씨에게 특수한 취미나 성벽이 있을 가능성…!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 6,
  "jh": "2347d8fd9114",
  "ko": "그런! 그런 사람 밑에서 일하다간… 우리 장난당하는 거 아냐!?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 2,
  "jh": "ae9c80f44e4b",
  "ko": "…에나. 뭐라고 좀 해 줘…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 8,
  "jh": "06a212ef0663",
  "ko": "…뭘 말해도 소용없잖아"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 1,
  "jh": "5a200582fb19",
  "ko": "정말, 시끄러워! 뭘 중얼거리는 거야?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 2,
  "jh": "c2ec06b41e5d",
  "ko": "아무것도 아니야… 이 둘이 울리카를 변태 취급하고 있었을 뿐…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "bba3412d9b96",
  "ko": "뭐라고오!?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 9,
  "jh": "e6cd5ded5f66",
  "ko": "오, 오해야! 우린 그저 너의 특수한 취미를 우려해서…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 6,
  "jh": "f259e4aa4dc1",
  "ko": "맞아! 그래서 망상을 펼쳐서 신변의 위험을 느끼고 있었을 뿐이야!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "7dbe1d0afcd1",
  "ko": "오해고 뭐고 아니잖아! 정말, 오늘이야말로 화났어!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 8,
  "jh": "14073afbee32",
  "ko": "일부러 소란 피울 소리 하지 마…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 2,
  "jh": "ed7909d77875",
  "ko": "그럴 생각은 없었는데… 우후후후…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 8,
  "jh": "7b93a6c9ff75",
  "ko": "제정신인 건 나뿐인가… 어쩔 수 없지. 야, 누나"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "77897e70a823",
  "ko": "뭐야! 너까지 날 변태 취급할 거야!?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 8,
  "jh": "05ecf3d1dccb",
  "ko": "아니야. 전부터 생각했는데. 그 마나, 아무 도움도 안 되지 않냐?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "9892846de498",
  "ko": "윽… 그, 그렇지 않, 잖아? 봐, 엄청 귀엽고…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 8,
  "jh": "c8b06952e501",
  "ko": "귀엽기만 해서야…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 6,
  "jh": "5f20040cfb09",
  "ko": "맞아 맞아! 이 몸은 귀여운 데다 강하고 튼튼하다고!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 9,
  "jh": "3ed4e8120655",
  "ko": "그럼 난 귀여운 데다 프리티하고 큐트하지"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 2,
  "jh": "984549b006f0",
  "ko": "그거 전부 뜻이 같아…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 1,
  "jh": "250ff755faac",
  "ko": "으… 어쩔 수 없잖아! 이 애, 아직 막 태어났는데!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 2,
  "jh": "39326c462d6f",
  "ko": "마나를 손에 넣으면 평생 부려 먹으면서 떵떵거리며 살 거라고 호언장담했으면서…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "2085bb2efa2b",
  "ko": "그렇게까지 말한 기억은 없는데…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 6,
  "jh": "540c32435620",
  "ko": "이대로면 졸업해도 훌륭한 연금술사는 못 되겠네…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 9,
  "jh": "fd769934eddf",
  "ko": "평생 귀엽기만 한 마나를 먹여 살리며 사는 건가… 애달프군"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 1,
  "jh": "ad00ed8c4f8a",
  "ko": "그, 그건 싫어… 가난은, 가난은 싫어어어!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 8,
  "jh": "b8a9a5cca599",
  "ko": "…가난에 무슨 안 좋은 추억이라도 있냐?"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 2,
  "jh": "866adbb197e5",
  "ko": "입학금 마련하려고 엄청 절약하며 살았으니까…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 1,
  "jh": "eca48c6171e5",
  "ko": "이, 이렇게 된 이상… 특훈이야! 특훈!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 10,
  "jh": "5d647772a277",
  "ko": "특후?"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 1,
  "jh": "192301e563cd",
  "ko": "응. 두 번 다시 너를 귀엽기만 한 쓸모없는 애라고 못 하게 해 줄 거야"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 1,
  "jh": "5e2a7720a781",
  "ko": "기다려! 금방 특훈 메뉴를 생각할 테니까!"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 10,
  "jh": "9dc66ada9e64",
  "ko": "우!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]