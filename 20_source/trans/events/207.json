[
 {
  "key": "m0",
  "kind": 0,
  "chr": 2,
  "jh": "c60c2d4cf107",
  "ko": "두고 가다니 너무해…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 1,
  "jh": "b2211c73edb1",
  "ko": "그러니까 미안하다니까. 그보다 봐. 여기 들어간 것 같아."
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 2,
  "jh": "f83a9cee349d",
  "ko": "…진짜 있었어? 잘못 본 거 아냐?"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 1,
  "jh": "ece2879cd29a",
  "ko": "가 보면 알아. 실례합니다~"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 1,
  "jh": "bc5f12d1a2eb",
  "ko": "…어라? 아무도 없어?"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 2,
  "jh": "d5065a14eed2",
  "ko": "…잘못 본 거야. 울리카는 덜렁대고. 경솔하고, 허둥대고…"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 1,
  "jh": "a9391ee01222",
  "ko": "분명히 있었다니까! 확실히 초록색 조그만 게…"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 31,
  "jh": "6628e7a0b382",
  "ko": "남의 집에서 뭘 떠드는 거냐?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 2,
  "jh": "97b044f89e32",
  "ko": "아… 진짜 있었다… 작아서 몰랐어…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "4632327d6787",
  "ko": "봐, 이거야! 내가 본 거!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "075cf093b4d7",
  "ko": "…당신이 요정 씨?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 31,
  "jh": "5af155f3f227",
  "ko": "…전직 요정 씨다. 난 이제 요정 씨에선 손을 씻었어"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "5d7240184c31",
  "ko": "우리, 연금술을 도와줄 사람을 찾고 있어. 있잖아, 도와줘"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 31,
  "jh": "33994d618ae0",
  "ko": "…남의 말 들었냐? 다른 데 알아봐라"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "6eeef6afbc93",
  "ko": "…왜 요정 씨를 그만뒀어?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 31,
  "jh": "36e09d1382b8",
  "ko": "이제 지쳤어. 인간에게 아첨하며 사는 삶에는…"
 },
 {
  "key": "m16",
  "kind": 5,
  "chr": 35,
  "jh": "4dcf65ae7777",
  "ko": "스승님~! 성게 다 주웠어~!"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 30,
  "jh": "ba963d0337f2",
  "ko": "늦어! 고작 성게 줍는 데 몇 시간이 걸리는 거냐!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 35,
  "jh": "b453a473ed66",
  "ko": "미, 미안해~ 소리 지르지 말아 줘~…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "82b6032ac8a9",
  "ko": "으악! 커다랗다!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 30,
  "jh": "ad0f28edbf9c",
  "ko": "그리고 그 기분 나쁜 말투 그만두라고 몇 번을 말해야 알아듣냐!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 35,
  "jh": "eea2b9b99105",
  "ko": "에~ 왜냐면 요정 씨는 이렇게 말하는 거잖아?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 30,
  "jh": "dd3a2268bc94",
  "ko": "칫, 요즘 젊은 것들은 금방 형식부터 들어가려 해…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "db73b286fa7b",
  "ko": "당신도 요정 씨…?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 6,
  "jh": "8013faece028",
  "ko": "응. 이 몸은 페페론치노. 페페론이라고 불러 줘!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "1e682852cf39",
  "ko": "크기가 꽤 다르네…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 6,
  "jh": "514fa4a316d8",
  "ko": "이 몸은 아직 반쪽짜리라서. 빨리 스승님처럼 조그맣고 귀여워지고 싶어"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 6,
  "jh": "ea57f82b48d6",
  "ko": "뭐, 지금 그대로도 충분히 귀엽지만!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 2,
  "jh": "5a5175d2e1b8",
  "ko": "………왠지 짜증 나"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "16fe2f3e4f48",
  "ko": "있잖아 있잖아. 이쪽 사람이 더 낫지 않아? 크고 세 보이고"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 2,
  "jh": "38e5375674d8",
  "ko": "어… 제정신…?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 6,
  "jh": "74a33a7ea7e8",
  "ko": "무슨 얘기야? 누나?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "ba9d589be742",
  "ko": "있잖아, 너. 우리 연금술 좀 도와줄래?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 6,
  "jh": "0fffc5414de4",
  "ko": "우와! 이 몸이라도 괜찮아? 기꺼이 갈게. 물론이지!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 2,
  "jh": "49dea6d42de3",
  "ko": "거기선 거절해 줬으면 했는데…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 30,
  "jh": "cd85f10e0fae",
  "ko": "야! 무슨 멋대로 소리를 하는 거냐. 넌 아직 수행 중인 몸이잖아!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 30,
  "jh": "83ed5662aec9",
  "ko": "인간을 돕다니 10년은 이르다!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 2,
  "jh": "9d04995dd859",
  "ko": "그렇지… 수행 방해하면 안 되지. 응…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 6,
  "jh": "a46d62214ebf",
  "ko": "응? 누나, 멋진 돌 갖고 있네"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "fbb7f912ff20",
  "ko": "아, 이거? 헤헤~ 좋지? 실은 이거 마나의 알이야!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 6,
  "jh": "eaaaff18949c",
  "ko": "헤에~! 대단하다!"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 30,
  "jh": "5b9eff3f08af",
  "ko": "야! 듣고 있냐!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 6,
  "jh": "2ea0a8225c47",
  "ko": "뭐야~ 스승님. 시끄럽네"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 30,
  "jh": "9429008c0398",
  "ko": "…그 인간을 따라가겠다면 넌 파문이다. 두 번 다시 이 집 문턱을 넘지 못하게 하겠다"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 6,
  "jh": "01baf60803cd",
  "ko": "에에? 그건 곤란한데~…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 1,
  "jh": "25cd4d5be5d2",
  "ko": "심술궂은 소리 하지 마!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 30,
  "jh": "932f7353ada6",
  "ko": "외부인은 끼어들지 마라! 자, 어쩔 거냐 페페론"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 6,
  "jh": "7a7998f4a297",
  "ko": "으~음 으~음…"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 6,
  "jh": "568378caa0a8",
  "ko": "미안 스승님! 이 몸, 누나들이랑 같이 갈게!"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 30,
  "jh": "536f5271956a",
  "ko": "뭐, 뭐라고…"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 6,
  "jh": "95ab13e23b42",
  "ko": "이 몸은 요정 씨인걸! 인간에게 도움이 되고 싶어!"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 30,
  "jh": "796f0d0e62ea",
  "ko": "…알았다. 그럼 냉큼 나가라. 두 번 다시 얼굴 보이지 마"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 6,
  "jh": "07bed91dbc3c",
  "ko": "스승님…"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 30,
  "jh": "ab50ccd3d857",
  "ko": "이제 스승도 제자도 아니다! 얼른 가! 너희도 나가!"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 1,
  "jh": "fb77850fc505",
  "ko": "…있잖아, 괜찮았어?"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 2,
  "jh": "32e0bac75158",
  "ko": "사과하는 게 좋을 것 같아… 무리해서 우리랑 올 필요 없으니까… 응?"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 6,
  "jh": "aff4fc4500dc",
  "ko": "아니, 괜찮아. 스승님도 분명 언젠간 알아주실 거야…"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 1,
  "jh": "5c20656cbc28",
  "ko": "그래… 좋아! 그럼 더는 안 말릴게. 시간도 없으니 바로 도와줘야겠어"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 6,
  "jh": "9b0776c3d968",
  "ko": "바라던 바야!"
 },
 {
  "key": "m59",
  "kind": 0,
  "chr": 30,
  "jh": "7cd8367ca663",
  "ko": "…인간에게 도움이 되고 싶다라. 반쪽짜리 주제에 제법 어른 같은 소리를 하는군…"
 },
 {
  "key": "m60",
  "kind": 5,
  "chr": -1,
  "jh": "cc5b16c7b2a0",
  "ko": "「{CLRE}페페론{CLNR}」이 동료가 되었습니다."
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]