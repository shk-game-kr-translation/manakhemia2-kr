[
 {
  "key": "m0",
  "kind": 0,
  "chr": 63,
  "jh": "987940c4ed5c",
  "ko": "후우, 후우… 의외로 무겁군. 이봐! 슬슬 자기 발로 걷는 게 어때!?"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 9,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 63,
  "jh": "73480199a94b",
  "ko": "또 입 다물기냐… 뭐 됐어. 그렇게 여유 부릴 수 있는 것도 지금뿐…"
 },
 {
  "key": "m3",
  "kind": 5,
  "chr": 9,
  "jh": "0224ccd7d1d1",
  "ko": "이야. 평생 말 안 할 것 같은데. 그건 그냥 탈인형이니까"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 63,
  "jh": "6c0ca5091f34",
  "ko": "탈인형? 하하, 그런 바보 같은… 아아아! 진짜다! 속이 비었어!!"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 63,
  "jh": "7a50c589a446",
  "ko": "라니, 방금 목소리는… 누구냐!? 어디 있어!?"
 },
 {
  "key": "m6",
  "kind": 5,
  "chr": 9,
  "jh": "2a5139a30b3b",
  "ko": "여기야, 여기"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 63,
  "jh": "d6a89c4f4e94",
  "ko": "여기라니, 아무도… 설마!?"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 9,
  "jh": "0cace9157f72",
  "ko": "응, 그 설마야. 이 모습으론 말하기 불편하니 그쪽으로 돌아가도 될까?"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 9,
  "jh": "7e9176253c5c",
  "ko": "후우… 역시 탈인형 안은 편안하군"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 63,
  "jh": "1916422dbd8e",
  "ko": "네, 네놈…!"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 9,
  "jh": "9e5b3195c14a",
  "ko": "처음 뵙겠습니다… 아니, 오랜만이라고 해야 하나"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 63,
  "jh": "5370738a4ee6",
  "ko": "무슨 생각이냐!? 뻔뻔하게 내 앞에 얼굴을 내밀고…"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 63,
  "jh": "fab52d4264ff",
  "ko": "그렇군! 탈인형으로 들떠 있던 나를 일부러 비웃으러 왔구나!?"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 9,
  "jh": "dee2385d9eae",
  "ko": "천만에. 부탁이 있어서 왔어"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 63,
  "jh": "4f43b837bb81",
  "ko": "부탁? 뭐냐. 봐 달라고 말할 셈이냐"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 9,
  "jh": "1cb09c7fc24e",
  "ko": "맞진 않아도 멀지도 않으려나. 조금만 유예가 필요해서"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 63,
  "jh": "b82ed5d001a9",
  "ko": "유예… 라고?"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 9,
  "jh": "be2beaa959f2",
  "ko": "조금이면 돼… 그러면 난 반드시 자수할게. 약속하지"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 63,
  "jh": "bba1feb8b2c5",
  "ko": "바보 같은! 네놈 말 따위 믿을 수 있을 리가…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 9,
  "jh": "214012dd1a88",
  "ko": "부탁해. 그녀들이 졸업할 때까지… 그때까지면 돼"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 63,
  "jh": "297111f374fe",
  "ko": "졸업이라고…? 영문 모를 소리를. 뭘 노리는 거냐!?"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 9,
  "jh": "1a65d6f3c4e9",
  "ko": "…난 범죄자야. 아무리 말로 꾸며도 그 사실은 사라지지 않아"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 63,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 9,
  "jh": "417c91ebff36",
  "ko": "그리고 범죄자인 이상 그녀들과 대등한 관계로 있을 수 없어… 그게 괴로워"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 9,
  "jh": "a32afe847a3b",
  "ko": "그러니까 졸업을 지켜보면 제대로 죗값을 치르고 싶어…"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 63,
  "jh": "b309d604f727",
  "ko": "…진심이냐?"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 9,
  "jh": "3727b697c1c5",
  "ko": "진심이고말고. 이 초롱초롱한 눈을 봐 줘. 거짓말하는 것처럼 보여?"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 63,
  "jh": "13283641b04d",
  "ko": "어디 보자… 응? …큭… 이, 이건…!!"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 9,
  "jh": "9f1303e16240",
  "ko": "어때?"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 63,
  "jh": "07884402b9f2",
  "ko": "크… 하아, 하아…"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 9,
  "jh": "e7315f972eec",
  "ko": "아직 부족한가. 자, 더 잘 봐…"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 63,
  "jh": "db8c147c29ce",
  "ko": "으아아! 이제 됐어! 잘 알았으니까! 네놈은 거짓말을 안 했다!"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 9,
  "jh": "341b1b11ba92",
  "ko": "알아줘서 기쁘군. 그럼…"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 63,
  "jh": "d42a95266be0",
  "ko": "그렇다고 완전히 믿은 것도 아니다…"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 9,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 63,
  "jh": "636bb8af26e5",
  "ko": "…그러니까 졸업식엔 나도 참석하겠다. 알겠지"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 9,
  "jh": "c2a21f591416",
  "ko": "…물론. 환영하지"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 63,
  "jh": "7da8e8ea81c3",
  "ko": "젠장, 페이스가 흐트러지는 녀석이군…"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 63,
  "jh": "0fc072a21ad3",
  "ko": "자수한 뒤엔 각오해 둬라! 오랜 원한, 실컷 풀어 줄 테니까!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 9,
  "jh": "28155bf6fcfd",
  "ko": "후우… 최악의 사태는 면했나…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 9,
  "jh": "8f092ab0993c",
  "ko": "졸업식… 이별의 계절인가. 이 나이에 그런 기분을 맛보다니…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 9,
  "jh": "a1b022695cbe",
  "ko": "자, 돌아갈까. 다들 있는 곳으로…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]