 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 8,
  "jh": "0565781d01ba",
  "ko": "아직도 뒹굴고 있냐. 누나는…"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 2,
  "jh": "520e033ff67e",
  "ko": "슬슬 질릴 때가 됐으려나… 도망치는 게 좋을지도"
 },
 {
  "key": "m4",
  "kind": 5,
  "chr": 4,
  "jh": "ca4c1ce29211",
  "ko": "실례하지"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 2,
  "jh": "4af75a2d32f2",
  "ko": "아… 별일이네…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 6,
  "jh": "b694e0ae7f91",
  "ko": "야아야아, 오랜만이야. 갑자기 오다니 무슨 바람이 분 거야?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 4,
  "jh": "bd88b8ff4a7d",
  "ko": "휴일을 받아서. 너희한테 술 상대라도 부탁할까 했다만"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 9,
  "jh": "7185b61a4d59",
  "ko": "그거 반가운 초대로군. 그런데… 날 취하게 해서 어쩔 셈이지?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 4,
  "jh": "71c154fed453",
  "ko": "원한다면 몽땅 벗겨 주마"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 9,
  "jh": "603b47acee37",
  "ko": "하하하. 넌 강압적인 타입이구나"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "3cfcc4fc8492",
  "ko": "그런 관계였구나… 왠지 묘하게 납득…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 4,
  "jh": "e962963caf77",
  "ko": "진지하게 받아들이지 마라"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 8,
  "jh": "679a467e948b",
  "ko": "그보다 당신들 언제 친해진 거야"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 6,
  "jh": "41a54309de25",
  "ko": "학원제 때 친해졌어. 유유상종이라는 거지"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 2,
  "jh": "5f43911fc84a",
  "ko": "…제정신인 사람인 줄 알았는데"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 4,
  "jh": "7dfc3e95a3d8",
  "ko": "너희랑 친하게 지내면 주변에서 따가운 눈으로 보는 모양이군"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 9,
  "jh": "2961d80affa0",
  "ko": "남의 눈 따위 신경 쓰면 안 돼. 사랑의 형태는 사람마다 다른 거야"
 },
 {
  "key": "m18",
  "kind": 5,
  "chr": 1,
  "jh": "508b04cd20b9",
  "ko": "질렸다~~~!!"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 8,
  "jh": "ac88044f4e68",
  "ko": "우왓!?"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 2,
  "jh": "6b19447b0975",
  "ko": "아… 움직이기 시작했어…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "300a15b9a8c9",
  "ko": "뒹굴뒹굴하는 거 질렸어! 뭐 좀 하자! 놀러 가자!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 6,
  "jh": "8d6bd268121b",
  "ko": "타이밍이 나쁘네, 누나. 오늘은 친구가 놀러 왔다고"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "2a61c1ed04be",
  "ko": "괜찮아. 친구도 같이. 여럿이 더 재밌잖아"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 4,
  "jh": "c1921a6123e2",
  "ko": "흠… 모처럼의 제안이다. 뭘 할지는 모르지만 참가하지"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 8,
  "jh": "6efaa6f3a83f",
  "ko": "그래서 뭐 할 건데?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "680d491e6b72",
  "ko": "뭐든 좋아. 심심풀이만 되면"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 2,
  "jh": "f744c1977973",
  "ko": "그럼 숙제…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "23841b08125f",
  "ko": "그거 말고!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 4,
  "jh": "093ea14e4e4c",
  "ko": "아직 안 끝냈나? 주인은 첫날에 끝냈다"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 6,
  "jh": "ef4d175ca500",
  "ko": "누나는 첫날부터 줄곧 뒹굴기만 했거든"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 4,
  "jh": "78c478340664",
  "ko": "그런가… 곤란한 주인이군"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 6,
  "jh": "1b567eb87e1a",
  "ko": "요즘 잊혀진 감이 있지만 이 몸은 요정 씨니까 가끔은 돕고 싶다고"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 9,
  "jh": "a76b222854c1",
  "ko": "그럼 오늘은 페페론을 위해서라도 숙제로 결정이려나?"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "fb1fca37a60b",
  "ko": "에에~ 페페론을 위해서~?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 2,
  "jh": "114ee9f8e65c",
  "ko": "도움받는 건 우리 숙제지만…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 1,
  "jh": "325026972762",
  "ko": "그런데… 숙제가 뭐였더라?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 4,
  "jh": "877ed456ba11",
  "ko": "{CLNR}결실의 언덕{CLNR}에서의 {CLNR}유우바나 열매{CLNR} 채취와 생태 관찰이다"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 1,
  "jh": "9f59fd88bf81",
  "ko": "어? 그렇게 딱딱한 거였어? 왠지 토니 선생님답지 않은데"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 2,
  "jh": "2a426316d7ad",
  "ko": "쉽게 말하면 적당히 재료 주워 오라는 거야…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 1,
  "jh": "4dac4aa1aa42",
  "ko": "뭐야, 깜짝 놀랐네… 뭐, 윤은 한 번 해 봤으니 금방 끝나겠지"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 4,
