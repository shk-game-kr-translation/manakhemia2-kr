[
 {
  "key": "m0",
  "kind": 0,
  "chr": 13,
  "jh": "5e9cd3e115ad",
  "ko": "다들 모였니? 그럼 바로 수업을 시작할게"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 81,
  "jh": "a0e66edbf2c1",
  "ko": "어라? 교장 선생님이 수업하시는 거예요?"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 13,
  "jh": "d3262bcf372a",
  "ko": "아아, 응. 예산 문제로 교직원도 일손이 부족해서… 하아"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 13,
  "jh": "f860ac41c156",
  "ko": "교장이 되면 거만하게 교장실에서 거드름 피울 수 있을 줄 알았는데…"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 13,
  "jh": "cd0e0cf60904",
  "ko": "이런, 상관없는 얘기를 했네. 수업 수업, 하고"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 13,
  "jh": "94e676d6f72c",
  "ko": "올해 이 학원엔 너희가 있는 전투기술과가 생겼는데"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 13,
  "jh": "86b5ec00aa0d",
  "ko": "그 전부터 전투에 관한 수업은 제대로 하고 있었어"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 95,
  "jh": "f02e06fdaad6",
  "ko": "헤에, 그렇구나…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 83,
  "jh": "6e97e0c61841",
  "ko": "그래도 왜 연금술 학교에서 전투 수업을?"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 13,
  "jh": "b3993e301532",
  "ko": "연금술이란 건 여러모로 위험이 따르는 학문이니까"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 13,
  "jh": "82f4367ba7b3",
  "ko": "재료 캐러 가면 몬스터랑 싸워야 하고"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 13,
  "jh": "0be1b33b1aba",
  "ko": "때로는 연금술 지식을 노린 악당에게 습격당할지도 모르고…"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 13,
  "jh": "9e96adb84c46",
  "ko": "뭐, 그런 이유로. 전문적인 건 나중에 군나르 선생님께 배우기로 하고"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 13,
  "jh": "8e94804956e1",
  "ko": "오늘은 전투의 기본인 유나이트에 대해 가르쳐 줄게"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 106,
  "jh": "5f2573a1978c",
  "ko": "유나이트… 왠지 멋있어 보이는 이름이네"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 107,
  "jh": "e496de5c5c08",
  "ko": "교장! 빨리 가르쳐 줘!"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 13,
  "jh": "4493c54abcbe",
  "ko": "자자, 진정해"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 13,
  "jh": "0227bcfd57d7",
  "ko": "유나이트란 전투를 효율적으로 해 나가면 발생하는 어떤 상태를 말해"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 101,
  "jh": "9622db227dd1",
  "ko": "효율적으로?"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 13,
  "jh": "241a0a6f026b",
  "ko": "응. 예를 들어 연속으로 대미지를 주거나 적의 약점을 공격하거나…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 13,
  "jh": "79af59cf02d3",
  "ko": "그렇게 유나이트 상태가 되면 점점 동료와 호흡이 맞아서"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 13,
  "jh": "0f77adb89662",
  "ko": "동료의 서포트나 공격 타이밍이 빨라지거나 해"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 13,
  "jh": "3299332d7b30",
  "ko": "간단히 말하면 전투 스피드가 올라서 그동안 적을 마구 때린다! 는 거지"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 81,
  "jh": "6764b30bcb54",
  "ko": "와~! 왠지 대단할 것 같아!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 13,
  "jh": "7d79889fb092",
  "ko": "그것만이 아니라 다른 효과도 이것저것 있지만…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 13,
  "jh": "7df1ab14c052",
  "ko": "오늘은 우선 유나이트를 체험해 보는 데까지 할까"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 13,
  "jh": "9c7b6eb8a047",
  "ko": "그럼 다들 물이 사는 숲에 가서 코다치랑 싸우고 오도록"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 13,
  "jh": "5db6ee762a0f",
  "ko": "물론 그냥 쓰러뜨리는 게 아니라 유나이트가 발생하도록 의식해"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 13,
  "jh": "8083d8119116",
  "ko": "끝나면 교장실로 보고하러 오도록. 그럼 오늘은 여기까지"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 7,
  "jh": "fd494748e25d",
  "ko": "우~ 왠지 어려울 것 같아. 그냥 쓰러뜨리기만 하면 쉬운데…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 0,
  "jh": "0ad6c94d0996",
  "ko": "마침 좋은 기회잖아. 너도 슬슬 머리 써서 싸우는 걸 배워"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 7,
  "jh": "50bb813813e2",
  "ko": "음~… 그런 건 로제한테 맡길게!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "f713d0335141",
  "ko": "맡겨도 말이지… 일단 물이 사는 숲에 갈까"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 7,
  "jh": "ad6a4e5e9b3a",
  "ko": "그러자. 릴리아도 불러서 후딱 끝내 버리자"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]