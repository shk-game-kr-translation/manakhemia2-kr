[
 {
  "key": "m0",
  "kind": 0,
  "chr": 4,
  "jh": "b5d8edf5a0bd",
  "ko": "기다려라. 누가 온다"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 1,
  "jh": "dfd46c63e7af",
  "ko": "어? 설마 빛의 마나?"
 },
 {
  "key": "m2",
  "kind": 5,
  "chr": 17,
  "jh": "825ac3db96fc",
  "ko": "아~ 그렇게 경계하지 말아 주게"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 17,
  "jh": "b13293b8b9a9",
  "ko": "오랜만이구먼. 아가씨"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 19,
  "jh": "76f386b6f1ed",
  "ko": "난 오랜만이랄 것까진 없군. 다시 만나서 기쁘다"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "be3b35b4cc9c",
  "ko": "뭐야. 너였구나… 놀래키지 마"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 10,
  "jh": "9dc66ada9e64",
  "ko": "우!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 19,
  "jh": "00aba3c12c54",
  "ko": "오오, 기억해 줬구나. 착하지 착하지"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 3,
  "jh": "ffe735687179",
  "ko": "…누구야? 이 사람은"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 2,
  "jh": "96bd3b953919",
  "ko": "빛의 마나 부하인 사람…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 7,
  "jh": "41d4573a41df",
  "ko": "에에!? 그럼 적이잖아!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 6,
  "jh": "3d7d0d235d58",
  "ko": "괜찮아. 지금은 완전히 이 몸들이랑 사이좋으니까"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 9,
  "jh": "db7afca82f75",
  "ko": "응. 아름다운 여성 중에 나쁜 사람은 없으니까"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 17,
  "jh": "c0f0816d5b17",
  "ko": "어이~ 날 무시하지 말아 주게…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "607b3004324f",
  "ko": "누구야, 이 할아버지? 묘하게 친한 척하는데…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 17,
  "jh": "a4ce961edb7f",
  "ko": "나라네, 나! 왜, 10년 전에 마나의 알을 준…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "bdec2053f88d",
  "ko": "어…? 아~! 그때 그 할아버지!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 17,
  "jh": "f8a66cb06ce7",
  "ko": "완전히 잊고 있었던 모양이구먼…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "809656b9ea13",
  "ko": "어, 어쩔 수 없잖아. 10년이나 전 일은 보통 기억 못 한다고"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 4,
  "jh": "39b1a7971faa",
  "ko": "10년 전 원한을 끈질기게 기억하는 녀석이라면 알고 있다만"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 0,
  "jh": "05d96a751bc4",
  "ko": "…당신 요즘 비꼬는 투가 늘지 않았어?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 19,
  "jh": "1bf9cfed1941",
  "ko": "이분은 빛의 마나와 나란히 하는 마나의 왕, 어둠의 마나시다. 자, 인사해 둬라"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 10,
  "jh": "5cae11085a9e",
  "ko": "우~… 안녕하세여"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 17,
  "jh": "cce90f465b31",
  "ko": "오, 자네가 마음의 마나로구먼. 안녕"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "4ef6db7e8830",
  "ko": "어? 할아버지가 어둠의 마나야?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 17,
  "jh": "1350cf043139",
  "ko": "음, 그렇다네"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 7,
  "jh": "39dad0f02bf2",
  "ko": "거짓말! 전혀 안 세 보여? 그런~ 기대했는데…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 5,
  "jh": "75264012baa0",
  "ko": "푸니, 푸니니~…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 23,
  "jh": "cf2daadfb336",
  "ko": "푸니요가 상대할 것도 없이 사부로 혼자로 충분하겠다… 라고 여동생도 낙담하고 있어요"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 11,
  "jh": "92bf9cba6d7f",
  "ko": "그런, 마나의 왕이신데 약할 리가…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 17,
  "jh": "02b7ec076ab8",
  "ko": "아니, 실제로 난 약하다네. 그 근처 인간 노인과 다를 바 없지"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 11,
  "jh": "d0dd1ec7e5f0",
  "ko": "네, 에에? 그런가요?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "df49f1b3c070",
  "ko": "왜 그런 녀석이 마나의 왕이야…?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 19,
  "jh": "58c9f19aa654",
  "ko": "이분은 특수하시다. 어둠이란 존재하는 것 자체에 의미가 있는 것이니까"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 7,
  "jh": "388578bd2d3d",
  "ko": "응? 응? …오오, 그렇구나!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 8,
  "jh": "944b09955472",
  "ko": "아니, 무리해서 아는 척 안 해도 돼"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 17,
  "jh": "33f0c276f222",
  "ko": "뭐, 내 얘긴 아무래도 좋아. 아가씨, 그리고 거기 소년"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 17,
  "jh": "e5eae3bbeb46",
  "ko": "이번엔 이래저래 휘말리게 한 것 같아 미안하구먼"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 1,
  "jh": "ae1e4fb6188f",
  "ko": "어? 딱히 할아버지가 잘못한 건 아니잖아요"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 0,
  "jh": "4882b460e35f",
  "ko": "그렇지. 들은 바로는 내가 불평하고 싶은 건 빛의 마나 쪽뿐이야"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 1,
  "jh": "39ff3b358e28",
  "ko": "게다가 할아버지 덕분에 우류를 만났으니까. 그치?"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 10,
  "jh": "9dc66ada9e64",
  "ko": "우!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 17,
  "jh": "ac8fc77cf2b0",
  "ko": "…그렇게 말해 주니 마음이 편해지는구먼"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 17,
  "jh": "7b3112dd2964",
  "ko": "우연이라지만 아가씨에게 마나의 알을 맡긴 건 실수가 아니었던 모양이야"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 7,
  "jh": "471d2eac3356",
  "ko": "언제까지 떠들지 말고~ 빨리 가자! 나 빨리 싸우고 싶어!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 5,
  "jh": "af20d18f4a5a",
  "ko": "푸니니니~!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 3,
  "jh": "eee782e67116",
  "ko": "재촉하지 마. 모처럼의 재회니까 느긋하게 하게 해 줘"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 17,
  "jh": "6daeeee0cddd",
  "ko": "상관없네. 확실히 너무 길게 얘기할 때는 아니지"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 17,
  "jh": "33406a2f4112",
  "ko": "게다가 빛의 마나도 바로 저기서 애타게 기다리고 있다네"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 1,
  "jh": "ce73f32ba2b0",
  "ko": "바로 저기 있구나, 좋아…"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 19,
  "jh": "8e80037b12d3",
  "ko": "하나 충고해 두지. 빛의 마나는 인간을 몹시 싫어한다"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 19,
  "jh": "59e78dbb8892",
  "ko": "봐줄 거란 안이한 기대는 하지 않는 게 좋다"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 0,
  "jh": "a574948ac5cf",
  "ko": "그런 기대는 처음부터 안 했지만… 왜 인간을?"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 19,
  "jh": "ba9351274dab",
  "ko": "그건 빛의 마나의 명예에 관련된 일이라서. 내 입으로는…"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 17,
  "jh": "ea4e35230919",
  "ko": "인간에게 진 적이 있다네. 그 녀석은"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 19,
  "jh": "2bf6a90893a2",
  "ko": "음. 비밀로 하려 했는데 너무 쉽게 들켜 버렸다"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 4,
  "jh": "a74d6626bfe4",
  "ko": "호오, 마나의 왕이 인간에게 졌단 말인가"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 7,
  "jh": "0bd9a4f3aea2",
  "ko": "에~ 혹시 빛의 마나도 약해?"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 17,
  "jh": "1bc030d53a50",
  "ko": "아니아니. 그 인간이 바보같이 강했을 뿐이야"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 17,
  "jh": "a4341a1aa1cd",
  "ko": "보통 인간이 백 명, 천 명 덤벼도 빛의 마나는 못 이기지"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 6,
  "jh": "6ab30ec9cd8c",
  "ko": "천 명이라… 이 몸 혼자서 오백 명분이라 치면…"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 9,
  "jh": "a9d4ad3961b9",
  "ko": "나를 더하면 천백 명분이군. 응, 충분히 승산이 있지 않을까"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 6,
  "jh": "2bbe4647450b",
  "ko": "어라? 네 쪽이 백 명 더 많아?"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 9,
  "jh": "36b6d3dd57c1",
  "ko": "하하하, 이런 건 나중에 말하는 쪽이 유리하거든"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 7,
  "jh": "a9d3b1502eff",
  "ko": "그럼 나 혼자서 칠백 명분이니까 더하면 그러니까… 이천 명분이네!"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 8,
  "jh": "689005e2b84b",
  "ko": "왠지 이제 일일이 태클 거는 것도 귀찮다…"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 2,
  "jh": "7595dcb9ecf4",
  "ko": "상대 안 하는 게 제일…"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 0,
  "jh": "ef2ebc3a8842",
  "ko": "그럼 가 볼까"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 17,
  "jh": "4fcbb7ebd6e7",
  "ko": "음. 조심하게"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 1,
  "jh": "3f453f1b5578",
  "ko": "다음에 천천히 놀러 와요. 안녕~!"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 17,
  "jh": "ebc487df972f",
  "ko": "자네에게도 이래저래 고생을 시킨 것 같구먼. 미안하네"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 6,
  "jh": "d4b5b1e7a8b6",
  "ko": "신경 안 써도 돼. 이 몸은 지금 생활을 최고로 즐기고 있으니까!"
 },
 {
  "key": "m72",
  "kind": 5,
  "chr": 1,
  "jh": "ebde0ad21e88",
  "ko": "페페론, 두고 간다!"
 },
 {
  "key": "m73",
  "kind": 0,
  "chr": 6,
  "jh": "5de6d142d321",
  "ko": "와아, 기다려~! 지금 갈게~!"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 19,
  "jh": "3953a45d09e4",
  "ko": "자, 저도 가 보겠습니다. 그들이 걱정되니까요"
 },
 {
  "key": "m75",
  "kind": 2,
  "chr": 17,
  "jh": "eccc1707e955",
  "ko": "그건 쓸데없는 걱정 아닐까"
 },
 {
  "key": "m76",
  "kind": 2,
  "chr": 19,
  "jh": "afd185596c57",
  "ko": "그럼 빛의 마나가 진다는 겁니까?"
 },
 {
  "key": "m77",
  "kind": 2,
  "chr": 17,
  "jh": "b87c7ceeacea",
  "ko": "글쎄글쎄. 뭐, 승부는 해 봐야 안다는 거지"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]