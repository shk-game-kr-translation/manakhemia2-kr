[
 {
  "key": "m0",
  "kind": 2,
  "chr": 7,
  "jh": "77ba25f8107d",
  "ko": "드디어 내일이네, 학부모 참관. 뭘 할까~"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 3,
  "jh": "41b7e22fbabf",
  "ko": "어차피 또 변변찮은 수업일 거야"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 5,
  "jh": "7ea7b0907d7f",
  "ko": "푸니~!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 23,
  "jh": "02d532930eef",
  "ko": "아빠랑 엄마가 와 주냐고? 글쎄, 둘 다 바쁠 테니까…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 22,
  "jh": "b96c8776f9e0",
  "ko": "야! 푸니요를 슬프게 하는 소리 하지 마라!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 23,
  "jh": "50b0865ca67b",
  "ko": "미, 미안! 그럴 생각은…"
 },
 {
  "key": "m7",
  "kind": 5,
  "chr": 76,
  "jh": "f57c7b18fa24",
  "ko": "하하하. 걱정 마라, 아이들아"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 7,
  "jh": "428a54283cb5",
  "ko": "앗!? 커다란 푸니푸니…?"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 5,
  "jh": "8d4617b53922",
  "ko": "푸니~! 푸니!"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 24,
  "jh": "80e953040589",
  "ko": "아빠! 엄마까지! 어떻게…"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 77,
  "jh": "7b6d52fc3a83",
  "ko": "아빠가 하루라도 빨리 너희를 보고 싶다고 고집을 부려서"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 77,
  "jh": "ffe3a2a2a0ed",
  "ko": "조금 일찍 오기로 했단다"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 76,
  "jh": "afdb035fcdca",
  "ko": "여, 여보. 창피하니까 그건 비밀이라고 했잖소"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 72,
  "jh": "f4e32c484cba",
  "ko": "잘 지내는 모양이구나"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 73,
  "jh": "3c2b3493a312",
  "ko": "오랜만이구나, 에토"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 3,
  "jh": "311a6e165dbb",
  "ko": "아버님!"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 7,
  "jh": "e9958cf25828",
  "ko": "와, 아빠다! 엄마는 안 왔어?"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 73,
  "jh": "2d924c99410a",
  "ko": "에나한테 갔단다… 무사히 만나면 좋겠는데"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 11,
  "jh": "1b4f509ff672",
  "ko": "주인어른… 어째서, 그… 푸니푸니와 같이…?"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 72,
  "jh": "9c1c05fb8b4e",
  "ko": "여기 오는 길에 동행하게 되어서 말이야"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 72,
  "jh": "9d0e6da3a7c9",
  "ko": "꽤 촉감이 좋은 분들이더구나. 덕분에 오는 길이 심심하지 않았어"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 11,
  "jh": "7532f22681ff",
  "ko": "촉감, 말인가요…"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 72,
  "jh": "09c6e41c1a35",
  "ko": "로제. 그리고 윤 군이었던가. 제멋대로인 딸이 신세를 지는구나"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 3,
  "jh": "d6326655d053",
  "ko": "아, 아버님! 제멋대로인 딸이라니!"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 0,
  "jh": "d304f23d5cc7",
  "ko": "늘 있는 일이니까요…"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 4,
  "jh": "3cb924d02f17",
  "ko": "그것도 일이다. 신경 쓸 것 없다"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 3,
  "jh": "17548ea0e747",
  "ko": "너희도 좀 부정 좀 해!"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 7,
  "jh": "349421599ba4",
  "ko": "아하하. 왠지 엄청 시끌벅적해졌네~"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 0,
  "jh": "64c0a2c4bc38",
  "ko": "그러게… 잠깐 밖에 나갔다 올게"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 72,
  "jh": "c5fdfe811325",
  "ko": "아아, 그렇지. 로제… 이런, 가 버렸나"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 0,
  "jh": "8347b39c26cf",
  "ko": "후우… 안 되겠다. 아무래도 짜증이 나서…"
 },
 {
  "key": "m32",
  "kind": 5,
  "chr": 21,
  "jh": "244de6d65aac",
  "ko": "후후후, 역시 나왔구나"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 0,
  "jh": "d3f04efc212f",
  "ko": "…! 와 있었냐, 망할 영감"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 21,
  "jh": "9f58e155b045",
  "ko": "그게 무슨 말버릇이냐. 할아버님이라고 불러, 할아버님"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 0,
  "jh": "dfcbf24300c6",
  "ko": "할아버님이라 부를 꼴이냐"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 21,
  "jh": "2d8f00554d4c",
  "ko": "여전히 입이 안 다물어지는 꼬맹이로군. 뭐냐, 아직도 시끄러운 건 질색이냐?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 0,
  "jh": "ddd6ed553567",
  "ko": "…오늘은 어쩌다 보니. 당신이야말로 왜 이런 데 있어?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 21,
  "jh": "5a0d9a6b3b67",
  "ko": "기다리면 나올 줄 알았지. 얘기를 하려면 조용한 데가 낫잖냐?"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 0,
  "jh": "b79aa5534523",
  "ko": "딱히 할 얘기 없어"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 21,
  "jh": "9682480425c3",
  "ko": "매정한 녀석. 1년 만의 감동의 재회인데… 응? 안색이 나쁘구나"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 0,
  "jh": "e5587757eb78",
  "ko": "…요즘 컨디션이 안 좋아서. 오늘은 일찍 쉴게"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 21,
  "jh": "63833019c9a3",
  "ko": "아아, 그래라. 내일 앓아누우면 모처럼의 참관이 엉망이야"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 0,
  "jh": "9883a3e1dbac",
  "ko": "부탁도 안 했는데 멋대로 온 거잖아. 그렇게 돼도 불평하지 마"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 21,
  "jh": "36db2e4addae",
  "ko": "그렇게 건방진 소리 하는 걸 보니 괜찮겠구먼. 자, 냉큼 자라"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 0,
  "jh": "c8a682e80749",
  "ko": "말 안 해도 그렇게 할 거야"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 0,
  "jh": "12e1cf38352a",
  "ko": "아… 하나 물어봐도 될까?"
 },
 {
  "key": "m47",
  "kind": 0,
  "chr": 21,
  "jh": "ed306d712f71",
  "ko": "뭔데?"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 0,
  "jh": "6fade742e524",
  "ko": "당신이랑 같이 있던 마나 말인데…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 21,
  "jh": "2e9c88d637cb",
  "ko": "또 꽤 옛날 얘기로구먼… 그 녀석이 왜?"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 0,
  "jh": "7d1b3f88f4a0",
  "ko": "…역시 아무것도 아니야. 그럼"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 21,
  "jh": "32b909de8dc2",
  "ko": "도중에 멈추지 마라, 신경 쓰이잖냐… 응? 잠깐 기다려라"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 0,
  "jh": "5c6fec01bb03",
  "ko": "뭐야. 난 이제 물어볼 건…"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 21,
  "jh": "b759389726ab",
  "ko": "그 반지, 어디서 났냐?"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 0,
  "jh": "2245f1059397",
  "ko": "어, 아아… 아는 사람한테 받았어. 안 어울리지?"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 21,
  "jh": "c50824f8d60c",
  "ko": "…뭐, 확실히 안 어울리는구먼. 네가 멋을 부리다니 백 년은 일러"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 0,
  "jh": "55a6f24e6254",
  "ko": "쓸데없는 참견이야. 그럼"
 },
 {
  "key": "m57",
  "kind": 0,
  "chr": 21,
  "jh": "7085b8abbc2f",
  "ko": "그 반지… 설마, 아니겠지"
 },
 {
  "key": "m58",
  "kind": 0,
  "chr": 11,
  "jh": "f8deffbaa891",
  "ko": "위르겐 씨, 와 계셨군요"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 21,
  "jh": "3aa85160a266",
  "ko": "여, 오랜만이구나. 어떠냐, 학교생활은?"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 11,
  "jh": "17515b114f47",
  "ko": "뭐, 이래저래 힘들어요… 주인어른이 안 보시니 아가씨도 폭주 기미라서…"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 21,
  "jh": "5df64ae9ef7f",
  "ko": "아아, 그거 큰일이구먼… 그 녀석도 저 꼴이면 너한테 폐를 끼치고 있겠지?"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 11,
  "jh": "82731db93694",
  "ko": "그렇지도 않아요. 투덜대면서도 결국은 돌봐 주거든요, 로제 씨는"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 21,
  "jh": "b33dada75440",
  "ko": "그래? 여전히 건방지고 입 험한 꼬맹이던데"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 11,
  "jh": "baa235be05ad",
  "ko": "로제 씨가 그런 태도를 보이는 건 위르겐 씨한테만이에요"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 11,
  "jh": "1c96115837ab",
  "ko": "비뚤어진 애정 표현 아닐까요?"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 21,
  "jh": "71285f70b9fe",
  "ko": "반갑지 않은 애정 표현이구먼… 그런데 요즘 그 녀석, 상태가 이상하지 않냐?"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 11,
  "jh": "7a0c1d1d2f86",
  "ko": "로제 씨 말인가요? …실은 조금 신경 쓰였는데…"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 21,
  "jh": "bdf99b1d1319",
  "ko": "자세히 들려줄 수 있겠냐. 뭐, 기분 탓이겠지만…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]