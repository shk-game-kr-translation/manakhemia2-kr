[
 {
  "key": "m0",
  "kind": 0,
  "chr": 22,
  "jh": "7043afb440d0",
  "ko": "기다려 푸니요! 아니 네가 멈춰, 지로!"
 },
 {
  "key": "m1",
  "kind": 5,
  "chr": 23,
  "jh": "8adda7df6b32",
  "ko": "아, 응"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 24,
  "jh": "8948709e2b82",
  "ko": "충격받은 건 알지만 기운 내. 응?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 23,
  "jh": "2e95e83b1442",
  "ko": "이제 거기엔 돌아가고 싶지 않다… 라고 여동생이 말해요"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 22,
  "jh": "a0366aa93d7a",
  "ko": "지로, 우리한텐 통역 필요 없다?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 23,
  "jh": "0d55d3a37465",
  "ko": "아, 그만 평소 버릇이"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 24,
  "jh": "a6d650f39b2b",
  "ko": "괴롭겠지… 이러니저러니 해도 믿던 사람한테 배신당해서…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 22,
  "jh": "0aee70ae07b5",
  "ko": "아아… 역시 푸니푸니와 인간은 서로 어울릴 수 없는 존재인 걸까"
 },
 {
  "key": "m9",
  "kind": 5,
  "chr": 54,
  "jh": "4c8d96bb774c",
  "ko": "그런 건 당연하잖냐. 이제야 깨달았냐?"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 22,
  "jh": "b3339e795fa9",
  "ko": "누구냐!?"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 23,
  "jh": "bb00bb1ff602",
  "ko": "이건… 대체!?"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 24,
  "jh": "1bc8ddee20a5",
  "ko": "포위당했어! 타로 형!"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 54,
  "jh": "31f1385c6f5c",
  "ko": "그나저나 이렇게 잘될 줄이야. 푸니푸니와 인간의 유대 따위 약해 빠졌군"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 22,
  "jh": "993941fa9072",
  "ko": "뭐… 네놈, 설마!?"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 54,
  "jh": "640a554d079e",
  "ko": "그래, 맞다. 전부 이쪽 책략이다. 너희를 인간한테서 떼어 놓기 위한!"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 22,
  "jh": "893d7ca13850",
  "ko": "비열한 짓을… 너희에겐 푸니푸니로서의 긍지가 없나!?"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 54,
  "jh": "1f9a3ae02896",
  "ko": "인간한테 아첨하는 놈이 할 소린 아니지. 자, 지금까지의 원한 한꺼번에 풀어 주마!"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 55,
  "jh": "6f8dc518c570",
  "ko": "인간이 없어도 꽤 셈다…"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 54,
  "jh": "c3eb72b857de",
  "ko": "뭘, 서두를 거 없다. 천천히 괴롭혀 죽여라!"
 },
 {
  "key": "m20",
  "kind": 5,
  "chr": 44,
  "jh": "8bc4cb890d4e",
  "ko": "오~!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 22,
  "jh": "98783bd6f6f8",
  "ko": "수가 너무 많군. 이대로면… 하다못해 푸니요만이라도…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 5,
  "jh": "e91b733738a8",
  "ko": "푸니, 니… 푸니~!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 23,
  "jh": "57c2702ba4a9",
  "ko": "이건 동료를 믿지 못한 푸니요에 대한 벌… 그러니 푸니요도 싸우겠대요"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 24,
  "jh": "a14086b8327a",
  "ko": "그러니까 일일이 통역 안 해도 돼"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 23,
  "jh": "92ac3bbce6f3",
  "ko": "미, 미안. 왠지 말해야 할 것 같아서…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 22,
  "jh": "7f3e8867fe40",
  "ko": "그 응석받이 푸니요가 그런 말을 하다니…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 22,
  "jh": "5fdf6f3ea546",
  "ko": "역시 이 학원에 데려오길 잘했어"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 22,
  "jh": "c4235aa04ff3",
  "ko": "알았다. 이제 도망치라고는 안 하마. 함께 싸우자!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 5,
  "jh": "7ea7b0907d7f",
  "ko": "푸니~!"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 54,
  "jh": "75fa50f50f45",
  "ko": "하! 웃기는군. 이 수를 상대로 너희끼리 어떻게 될 줄…"
 },
 {
  "key": "m31",
  "kind": 5,
  "chr": 0,
  "jh": "ef3e36c24848",
  "ko": "어떻게든 되지 않을까. 이 정도 수라면"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 54,
  "jh": "112fce482a30",
  "ko": "뭣!?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 3,
  "jh": "88f6441346c9",
  "ko": "봐, 거봐! 그러니까 난 무죄라고 했잖아!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 7,
  "jh": "9f741a41ead3",
  "ko": "그건 이미 사과했잖아. 그보다 다들 괜찮아?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 23,
  "jh": "78e438184424",
  "ko": "여러분, 와 주셨군요…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 5,
  "jh": "1f6d9b90f287",
  "ko": "푸니~…?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 23,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 11,
  "jh": "dced383831ff",
  "ko": "저, 푸니요 씨는 뭐라고?"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 23,
  "jh": "c3e8ab401086",
  "ko": "아아, 이거 실례"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 23,
  "jh": "9cf7dab5b5cc",
  "ko": "푸니요는 릴리아 씨를 안 믿었는데 왜…? 라고 여동생이 묻고 있어요"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 3,
  "jh": "2b7cdb70d177",
  "ko": "그런 걸 신경 쓸 만큼 속 좁은 여자가 아니야"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 11,
  "jh": "e3aa59ce798d",
  "ko": "저희도 그 뒤에 바로 깨달았어요. 아가씨가 범인일 리 없다고"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 7,
  "jh": "52aaeb66238a",
  "ko": "욕심 많은 릴리아가 작은 푸니푸니로 만족할 리 없잖아~"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "32d32b746977",
  "ko": "누가 욕심 많아! 넌 한마디가 많다고!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 4,
  "jh": "fa05f143c509",
  "ko": "주인이 의심받은 건 평소 행실이 나빠서다. 네가 마음 쓸 필요 없다"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 0,
  "jh": "ea1b437e0108",
  "ko": "뭐, 그런 거야"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 3,
  "jh": "94a9ef0ff8e6",
  "ko": "있잖아, 너희…"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 7,
  "jh": "53dbd3721b73",
  "ko": "자자~ 우선 푸니요네를 구하는 게 먼저. 응?"
 },
 {
  "key": "m49",
  "kind": 0,
  "chr": 54,
  "jh": "a1fe84326583",
  "ko": "제기랄…… 이렇게 된 이상 한꺼번에 피의 제물이다아!!"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 55,
  "jh": "003a45f755d0",
  "ko": "역시 져 버렸슴다…"
 },
 {
  "key": "m51",
  "kind": 0,
  "chr": 54,
  "jh": "4d28abbcf0e3",
  "ko": "제기랄, 도중까진 좋았는데… 두고 보자~!!"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 7,
  "jh": "6da746444b68",
  "ko": "후우, 위험했다~"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 0,
  "jh": "b8d2fb18a1ea",
  "ko": "빨리 알아채서 다행이군"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 23,
  "jh": "279dcca76d9a",
  "ko": "감사의 말씀도 드릴 수 없을 정도예요… 자, 푸니요"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 5,
  "jh": "ca8abfe217dc",
  "ko": "푸니~… 푸니"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 23,
  "jh": "bfb64981f35a",
  "ko": "여동생도 쭈뼛거리며 사과하고 있어요"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 3,
  "jh": "01f4844c8c7f",
  "ko": "괜찮아. 네가 잘못한 게 아니니까"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 3,
  "jh": "78603ca1cf6e",
  "ko": "잘못한 건 날 범인 취급한… 약 두 명"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 7,
  "jh": "2ced0a5afbb6",
  "ko": "어, 그런!? 이대로 해피엔딩이면 되잖아!"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 11,
  "jh": "dbe911844924",
  "ko": "맞아요. 푸니요 씨도 무사했으니까…"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 3,
  "jh": "49d1a9ed7f3f",
  "ko": "너희에겐 자기 처지를 확실히 이해시켜 줄 거야!"
 },
 {
  "key": "m62",
  "kind": 0,
  "chr": 7,
  "jh": "51f13cb46bcc",
  "ko": "싫어어어~!"
 },
 {
  "key": "m63",
  "kind": 0,
  "chr": 11,
  "jh": "49e56bc9d98d",
  "ko": "죄, 죄송해요오오오!"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 23,
  "jh": "64b0ad691642",
  "ko": "저, 내버려 둬도 돼요? 저거"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 0,
  "jh": "82edb66bfc1f",
  "ko": "일일이 상대하다간 이쪽 몸이 못 버티니까"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 4,
  "jh": "d67bb571d5be",
  "ko": "그나저나 적도 수단을 가리지 않게 됐군"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 22,
  "jh": "ddc50715f9b6",
  "ko": "음. 솔직히 이번엔 위험했다…"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 0,
  "jh": "5dad4e814452",
  "ko": "이제 멋대로 뛰쳐나가지 마. 구하러 오는 쪽도 지친다"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 5,
  "jh": "bc77c95dc03b",
  "ko": "푸니~… 푸니니!"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 23,
  "jh": "14a1fdbefee8",
  "ko": "그럼 앞으로는 로제 씨 곁을 떠나지 않겠다! 라고 여동생이 말해요"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 0,
  "jh": "240d1950a762",
  "ko": "…왜 나야. 형이 셋이나 붙어 있잖아"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 5,
  "jh": "d7c62f75273f",
  "ko": "푸니~?"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 0,
  "jh": "fc9166d3fa50",
  "ko": "그런 눈으로 보지 마… 알았어, 생각해 두지"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 5,
  "jh": "ee00abd1cc2f",
  "ko": "푸니!"
 },
 {
  "key": "m75",
  "kind": 0,
  "chr": 23,
  "jh": "98fdfc0a7426",
  "ko": "아"
 },
 {
  "key": "m76",
  "kind": 0,
  "chr": 0,
  "jh": "1ae93a7748e8",
  "ko": "이번엔 뭐야?"
 },
 {
  "key": "m77",
  "kind": 0,
  "chr": 23,
  "jh": "edb19aca52f3",
  "ko": "멀리서 에토 씨랑 윔 씨의 비명이 들렸어요…"
 },
 {
  "key": "m78",
  "kind": 0,
  "chr": 4,
  "jh": "b1fce94f4b88",
  "ko": "슬슬 구해 줄까"
 },
 {
  "key": "m79",
  "kind": 0,
  "chr": 0,
  "jh": "9615c7a69052",
  "ko": "아아… 귀찮지만…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
