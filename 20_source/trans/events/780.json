[
 {
  "key": "m0",
  "kind": 0,
  "chr": 28,
  "jh": "1521b4d3dcf4",
  "ko": "음… 슬슬 수업을 시작하고 싶은데… 괜찮을까?"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 83,
  "jh": "e26da80acef4",
  "ko": "그야… 물론 괜찮은데요"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 28,
  "jh": "e9ab9ea5bfca",
  "ko": "아, 고마워. 그럼 오늘은 교과서 80쪽부터…"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 81,
  "jh": "8f6dbb30a4de",
  "ko": "왠지 선생님 점점 소심해지는 거 아니야?"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 83,
  "jh": "29c332533402",
  "ko": "이런 상태로 1년 버틸 수 있을까… 걱정이야"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 28,
  "jh": "3aa7554fb393",
  "ko": "아, 저… 잡담은 작은 목소리로 부탁해…"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 28,
  "jh": "75e43521ded0",
  "ko": "음, 오늘 수업은 몬스터가 떨어뜨리는 드롭 아이템에 대해서예요"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 107,
  "jh": "72042bdd1eb7",
  "ko": "드롭 아이템이라니… 이제 와서?"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 28,
  "jh": "af825ee815fc",
  "ko": "아, 응, 확실히 이제 와서지… 미안해, 수업 진행이 서툴러서…"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 81,
  "jh": "6e7db4e02bac",
  "ko": "잠깐! 너무 괴롭히면 불쌍하잖아!"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 81,
  "jh": "7111a7fce630",
  "ko": "선생님, 신경 쓰지 말고 계속하세요"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 28,
  "jh": "a1e540f30064",
  "ko": "으, 응. 고마워…"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 28,
  "jh": "f5f5a3843f24",
  "ko": "드롭 아이템이란 건 그 몬스터가 갖고 있던 거거나"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 28,
  "jh": "647349327095",
  "ko": "혹은 몬스터 몸의 일부이기도 한데"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 28,
  "jh": "030c9b9c138c",
  "ko": "조합할 때 아주 귀중한 재료가 되니까 연금술사에겐 정말 중요해"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 107,
  "jh": "879cc759a2bf",
  "ko": "우린 연금술사가 아니지만… 전투기술과고"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 83,
  "jh": "85dbe8fff13a",
  "ko": "혹시 연금술과랑 착각한 거 아니에요?"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 28,
  "jh": "ad35b55f4beb",
  "ko": "어? 아, 아아아! 그랬지… 그러니까 그러니까… 맞다!"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 28,
  "jh": "606bab48997d",
  "ko": "너희가 전투의 프로가 됐을 땐 드롭 아이템이 귀중한 수입원이 되니까"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 28,
  "jh": "eb180ca1a2f8",
  "ko": "결코 쓸데없지 않아, 응!"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 107,
  "jh": "e8e613dc8683",
  "ko": "억지로 얼버무렸네…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 28,
  "jh": "604bf488eada",
  "ko": "그러니까, 그래서 오늘 과제 말인데…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 28,
  "jh": "f3b51c6eb952",
  "ko": "채석장에서 드롭 아이템을 잔뜩 모아 왔으면 해"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 28,
  "jh": "f9102e964acf",
  "ko": "평가 대상이 되는 건 어디까지나 드롭 아이템뿐이야"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 28,
  "jh": "2835d4fbcb4f",
  "ko": "참고로 드롭 아이템은 특정 스킬 효과 같은 걸로 얻기 쉬워지니까"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 28,
  "jh": "6a7c541b18db",
  "ko": "그 밖에도 짧은 시간에 전투를 끝내는 것도 유효하고… 아, 아무튼 힘내!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 7,
  "jh": "2e59488a7c08",
  "ko": "도망치듯 나가 버렸네… 전엔 좀 더 평범했는데"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "9d57b2194c72",
  "ko": "이상한 학생들뿐이라 무서워진 거 아닐까?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 7,
  "jh": "b6d96fc870ac",
  "ko": "이상한 학생? 누구 말이야?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 0,
  "jh": "5a4ad65fea0c",
