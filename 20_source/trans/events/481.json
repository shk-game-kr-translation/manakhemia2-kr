[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "b294c92aac5e",
  "ko": "모처럼 둘만 있으니 뭔가 얘기해야… 아아 그래도 뭘 얘기하지…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "b58bd7f8ab0d",
  "ko": "뭘 중얼거리시는 거예요?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "c1abc064b161",
  "ko": "아, 아무 말도 안 했어! 너야말로 뭔가 얘기해"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 3,
  "jh": "9399e052381d",
  "ko": "주인을 즐겁게 할 세련된 토크 하나 못 해서야 종자 실격이야!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 0,
  "jh": "ee694a5733e9",
  "ko": "갑자기 그러셔도… 음~…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 3,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 3,
  "jh": "996cdda98142",
  "ko": "(이렇게 어색한 분위기가 될 줄이야… 이 침묵을 깨려면 어떻게…!?)"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 0,
  "jh": "c809918abe9d",
  "ko": "아, 맞다"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 3,
  "jh": "25f1ead186f8",
  "ko": "뭐, 뭐야!? 뭐든 좋으니까 말해 봐!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 0,
  "jh": "eaa69def2e8d",
  "ko": "옛날에도 이런 일 있었죠. 아가씨랑 둘이서 저택 근처 숲에 나갔던…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 3,
  "jh": "286cdf377fb2",
  "ko": "옛날…? 아아! 있었지!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "3f406e3144eb",
  "ko": "아가씨 댁에서 일하게 된 첫날이었던가요"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 0,
  "jh": "3e58260242a1",
  "ko": "「오늘부터 너는 내 하인이니까 말 잘 들어!」라는 말을 듣고"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "defaa971a08b",
  "ko": "그래서 억지로 밖으로 끌려 나갔죠…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "8141a51f0394",
  "ko": "그, 그런 말 했던가. 뭐, 처음에 주종의 구분을 확실히 하는 건 중요하지. 응"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "a339fe533922",
  "ko": "길은 기억하고 있다! 하면서 막 나아가다가 아니나 다를까 길을 잃고…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "571b480c4c32",
  "ko": "으… 아, 맞다 맞다!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "3af4298c0708",
  "ko": "그 뒤에 들개한테 습격당해서 네가 멋지게 날 지켜 줬지"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "d8613059b43e",
  "ko": "아뇨, 흠씬 두들겨 맞았는데요…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "74c955008298",
  "ko": "어머? 그랬던가…?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "80710c57b199",
  "ko": "아가씨는 대성통곡, 저는 큰 부상. 구하러 와 주신 주인어른께는 크게 혼나고…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 3,
  "jh": "a20be7aa634c",
  "ko": "그렇게 말하니 그랬던 것도 같고… 꽤 자세히 기억하네"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 0,
  "jh": "a0730b5b3546",
  "ko": "가벼운 트라우마가 됐거든요"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 3,
  "jh": "c8a52549de5a",
  "ko": "…그건 돌려서 날 탓하는 거야?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "e907ae5f3bc9",
  "ko": "그럴 생각은 없어요"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 3,
  "jh": "1ce82e06806e",
  "ko": "정말! 이왕이면 좀 더 나은 걸 떠올리면 좋을 텐데"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "fb40c5ddb7c9",
  "ko": "나은 거요… 음~… 아~… 그러니까…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "811cecee349b",
  "ko": "그렇게 필사적이지 않으면 생각이 안 나…?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 0,
  "jh": "0c86c93f46b0",
  "ko": "아아, 맞다. 아가씨, 제 이름 말할 수 있게 되셨어요?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "a66e2c03133f",
  "ko": "어? 뭐, 뭐야. 갑자기 이름으로 불러 달라니… 늘 로제라고 부르잖…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 0,
  "jh": "27e0e62782fe",
  "ko": "그게 아니라, 로제릭스라고 제대로 된 이름으로"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "79f677b818df",
  "ko": "어릴 땐 잘 못 불러서 말하기 어려우니까 로제라고 부를래~ 라고…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 3,
  "jh": "05d58c1f41ca",
  "ko": "아, 그런 거… 뭐, 어릴 땐 어려웠지만 지금은 제대로 부를 수 있어"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 3,
  "jh": "948f0893275e",
  "ko": "흠흠… 로제릭큣…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 3,
  "jh": "846b6d9e39e7",
  "ko": "바, 방금 건 연습이야! 한 번 더… 로졔릿…!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 0,
  "jh": "f16dbaa33fcd",
  "ko": "죄송해요. 무리한 말을 한 것 같네요"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 3,
  "jh": "c9b7d5232de0",
  "ko": "전혀 무리 아니거든! 로졔릭…! 로제릭큐…읏!!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 0,
  "jh": "f2d2a40e658a",
  "ko": "푸흡… 정말 이제 됐으니까요"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 3,
  "jh": "106ec4c60e2f",
  "ko": "앗, 웃었지! 너 좀 심술궂어진 거 아니야?"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 0,
  "jh": "8474e349ba01",
  "ko": "죄송해요, 왠지 웃겨서…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 3,
  "jh": "c11d7a5653d2",
  "ko": "흥! 이제 몰라!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 0,
  "jh": "4c72ba45f901",
  "ko": "죄송하다니까요. 기분 푸세요"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 3,
  "jh": "c143f37133e1",
  "ko": "(아… 왠지 엄청 좋은 분위기… 이대로도 충분히 행복할지도…)"
 },
 {
  "key": "m45",
  "kind": 0,
  "chr": 3,
  "jh": "a7f4448a0f11",
  "ko": "(중지! 작전은 중지야!)"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 0,
  "jh": "e61e7368b25e",
  "ko": "왜 그러세요? 갑자기 춤을 추시고"
 },
 {
  "key": "m47",
  "kind": 0,
  "chr": 3,
  "jh": "cee641df3c4b",
  "ko": "아, 아무것도 아니야! 잠깐 몸을 움직이고 싶었을 뿐. 자, 가자"
 },
 {
  "key": "m48",
  "kind": 0,
  "chr": 11,
  "jh": "084f469223ad",
  "ko": "방금 건… 작전 결행 신호! 걱정 마세요, 빈틈없어요. 아가씨!"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 3,
  "jh": "76378b8eca61",
  "ko": "………"
 },
