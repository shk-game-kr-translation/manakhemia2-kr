[
 {
  "key": "m0",
  "kind": 2,
  "chr": 24,
  "jh": "c75059ef6ff0",
  "ko": "흐윽… 훌쩍… 흑…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 7,
  "jh": "6ad7fc58d49d",
  "ko": "자자, 그만 울어. 이제 무서운 언니는 없으니까. 응?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 24,
  "jh": "63a21ca325ed",
  "ko": "더럽혀졌어… 이제 장가 못 가…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 4,
  "jh": "a4e26f25dd89",
  "ko": "개한테 물렸다 치고 포기해라"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 22,
  "jh": "ade7f0362254",
  "ko": "사부로! 무사하냐!?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 24,
  "jh": "319a77ab7e81",
  "ko": "타로 형, 지로 형… 으아아아앙!!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 23,
  "jh": "d86da46a817a",
  "ko": "미안해, 사부로… 우리가 조금만 더 빨리 왔더라면…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 24,
  "jh": "a0ae2ba4da17",
  "ko": "이제 싫어… 인간은 무서워. 시골로 돌아가고 싶어…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 22,
  "jh": "5bcc8bac1e2f",
  "ko": "그런 말 마라. 이것도 다 푸니요를 위해서…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 24,
  "jh": "c4e1e5c86609",
  "ko": "푸니요는 아직 못 찾았어?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 23,
  "jh": "458e8a31795f",
  "ko": "응, 교내는 샅샅이 찾았는데…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 22,
  "jh": "fbdea7d3c91a",
  "ko": "그럼 아직 학교 밖에?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 24,
  "jh": "5623cedc81ae",
  "ko": "지금쯤 나보다 더 험한 꼴을 당하고 있을지도… 빨리 찾으러 가자!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 7,
  "jh": "b804fa3ec3bf",
  "ko": "음… 우리도 도와줄까?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 23,
  "jh": "1f188b8a7816",
  "ko": "괜찮으시겠어요?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 7,
  "jh": "3f48b02aad2f",
  "ko": "응. 우리가 이 근처를 더 잘 아니까. 그치?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "3e7f87036764",
  "ko": "그치? 라고 해도…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 4,
  "jh": "62621424efc7",
  "ko": "도울 의리는 없다고 보는데"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "352ee0c849a4",
  "ko": "아니. 도울 거야"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "dc99de48318b",
  "ko": "아가씨…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "1734b5218908",
  "ko": "눈앞에 곤란한 푸니푸니가 있는데 못 본 척할 수 있을 리가 없잖아"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "1b91b9e50dc3",
  "ko": "윤, 너도 돕는 거야. 알았지?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 4,
  "jh": "979d475c42e9",
  "ko": "…알겠다"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 23,
  "jh": "8822fe4772cb",
  "ko": "고마워요, 살았어요!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 24,
  "jh": "b080d9602b9a",
  "ko": "무서운 사람인 줄 알았는데, 사실은 좋은 사람이었나…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "f946fe7c6a5b",
  "ko": "…여동생… 푸니푸니 여동생…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 3,
  "jh": "10c4de5603f0",
  "ko": "여자애 푸니푸니라면 그 말랑함이란… 우후, 우후후…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 11,
  "jh": "66f92d8478c3",
  "ko": "그런 말은 안 들리게 하시는 게 좋을 것 같은데요…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "ae3155dd17c4",
  "ko": "거짓말! 소리 냈어!? 큭… 들켜 버렸으면 어쩔 수 없지"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 3,
  "jh": "6f70e750d13d",
  "ko": "이렇게 된 이상 한시라도 빨리 여동생을 내 손에!"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 22,
  "jh": "4172cb967f68",
  "ko": "안 돼! 저 여자가 먼저 찾아내면 푸니요는…!"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 4,
  "jh": "eae915c0865e",
  "ko": "…서로 귀찮은 주인을 섬기는군"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "d33d3df74f79",
  "ko": "난 좋아서 섬기는 게 아니지만…"
 },
