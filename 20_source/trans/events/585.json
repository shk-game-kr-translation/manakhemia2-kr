[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "3c82b5e88b82",
  "ko": "아~ 정말! 왜 이렇게 숙제를 많이 내는 거야, 토니 선생님은!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "ec0865c3351e",
  "ko": "…울리카가 수업 중에 졸아서"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "3a19dfa0f36e",
  "ko": "윽… 그래도 바로 머리 맞고 일어났잖아"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 2,
  "jh": "e895e54c13c1",
  "ko": "일어난 뒤엔 우류랑 놀다가 혼나고…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 2,
  "jh": "1e3788d855a4",
  "ko": "그 불똥으로 다들 숙제 산더미…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 8,
  "jh": "d9b03d39301c",
  "ko": "떠들면 언제까지고 안 끝난다. 도와주고 있으니까 성실하게 해"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "42186a88d3f1",
  "ko": "아아! 벌써 시간이… 페페론, 이 조합 계속 부탁해! 난 재료 캐 올게!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "2107a54ce286",
  "ko": "식은 죽 먹기지!"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 6,
  "jh": "ea060443317d",
  "ko": "자자… 여기서 누나 기대 이상의 걸 만들어 내는 게 능력 있는 요정 씨지"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 6,
  "jh": "f59fcb6d947e",
  "ko": "이것저것 어레인지를 더하면서… 그렇지. 어제 남은 것도 겸사겸사 처분해 버리자"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 6,
  "jh": "c7415d16697f",
  "ko": "이걸로 오케이! 마무리로 이 몸의 애정을 듬뿍 담아서… 하고"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 6,
  "jh": "eaef657c6ab8",
  "ko": "어, 어라? 왠지 너무 향기로운 냄새가… 오오오오오!"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 1,
  "jh": "d315904106fb",
  "ko": "생각보다 빨리 끝났네. 이제 페페론한테 맡긴 약만 완성되면…"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 2,
  "jh": "898b167a48eb",
  "ko": "…이상한 냄새가 나"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 1,
  "jh": "172605326391",
  "ko": "아, 진짜다… 뭐야? 이 연기"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 9,
  "jh": "f8fe5ac9f655",
  "ko": "아틀리에 쪽에서 나는 것 같은데… 설마…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "7045d65f185d",
  "ko": "넌 왜 쓸데없는 짓을 하는 거야!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 6,
  "jh": "a690b102280c",
  "ko": "미, 미안해. 이 몸은 그저 누나가 기뻐해 줬으면 하는 마음에…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "f3c9fe0e89e3",
  "ko": "그래서 쓸데없는 일만 늘리면 견딜 수가 없잖아!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 8,
  "jh": "56f2fad27200",
  "ko": "요정 씨인데 조합도 제대로 못 하다니 문제 있는 거 아니냐?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 2,
  "jh": "c5051055309a",
  "ko": "존재 가치가 없네…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "1db935a2efa5",
  "ko": "그, 그렇게까지 말 안 해도!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "61a94095008d",
  "ko": "이래선 오늘 아틀리에 못 쓰겠네… 벌로 넌 혼자 여기 청소해!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "603b9c5161f7",
  "ko": "…토니 선생님한테 숙제 못 한 변명하러 가야겠네…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 9,
  "jh": "fed1302d446b",
  "ko": "하하하. 엄청나게 혼났군"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 6,
  "jh": "8eac3248c5cb",
  "ko": "으으으… 아무리 이 몸이라도 하트브레이크야…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 9,
  "jh": "7504be486e30",
  "ko": "풀 죽은 얼굴은 안 어울려. 한 번 더 힘내서 보란 듯이 해 주면 되잖아"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 6,
  "jh": "eb2b937277ab",
  "ko": "그래도 멋대로 했다가 또 실패하면…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 9,
  "jh": "cee18cdca7f7",
  "ko": "겁쟁이는 아무것도 못 만들어. 실패를 겁내지 않고 도전하는 자만이 성공을 얻는 거야"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "5e261d7ec8eb",
  "ko": "오오! 그건 누구의 말이야?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 9,
  "jh": "1204e4b8cca2",
  "ko": "후후, 즉흥으로 그럴듯하게 말해 본 내 말이야"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 6,
  "jh": "75557ece948b",
  "ko": "왠지 용기가 솟아났어. …좋아, 이 몸 한 번 더 해 볼게!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 9,
  "jh": "2c98bfef81d5",
  "ko": "그 기세다. 그래야 내 평생의 라이벌이지"
 },
 {
  "key": "g0s0",
