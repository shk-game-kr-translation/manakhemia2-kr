[
 {
  "key": "m0",
  "kind": 0,
  "chr": 63,
  "jh": "a74a2833f2be",
  "ko": "하하하. 완전히 체념해서 말도 안 나오나?"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 63,
  "jh": "3503e0ede0fc",
  "ko": "입 다물어도 소용없다. 돌아가면 실컷 심문해 주지!"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 63,
  "jh": "f168482a7bba",
  "ko": "아아, 너희. 봐 줘, 드디어 잡았어! 이 녀석도 체념해서 무저항 그대로야!"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 6,
  "jh": "2a29b81a72ae",
  "ko": "저건…"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 1,
  "jh": "82a8c843ada9",
  "ko": "고토의 탈인형, 이지?"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 2,
  "jh": "fa6034cc2724",
  "ko": "뭔가 형편 좋게 착각해 주는 것 같아…"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 63,
  "jh": "06577a476836",
  "ko": "그럼 난 이만 실례하지. 이 녀석을 연행해야 해서"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 63,
  "jh": "f21599318eda",
  "ko": "이야~ 오늘 밤은 맛있는 술을 마실 수 있겠군!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "c3d48a8c8f27",
  "ko": "에~… 그 정도로 속은 거야…?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 8,
  "jh": "55073d92e9ff",
  "ko": "우리 고생은 뭐였을까…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "a19d870126de",
  "ko": "헛수고만 하고 지치기만 했다는 게 바로 이거…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 6,
  "jh": "6567b61f8ff8",
  "ko": "모처럼 검은 누나가 드물게 남을 도왔는데"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 2,
  "jh": "c07c26ff0495",
  "ko": "…다음 타깃은 요정 씨로 결정…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 6,
  "jh": "581827ed98a9",
  "ko": "에에에? 무, 무슨 타깃이야?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "aaeec56dbbe8",
  "ko": "하아… 왠지 확 지쳤어… 그렇게 달아올랐는데 바보 같아"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 2,
  "jh": "f1d37d0ab420",
  "ko": "정말… 이제 돌아가서 잘래…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "5e60aed85c09",
  "ko": "뭐, 무사히 해결됐으니까 됐다고 하자. 그럼 오늘은 해산!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 9,
  "jh": "261c1f4ce91e",
  "ko": "…페페론. 그 남자는 며칠쯤 속을 것 같아?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 6,
  "jh": "1a1320195d81",
  "ko": "음~ 내일이면 눈치채지 않을까"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 9,
  "jh": "649dd223cfa8",
  "ko": "그렇게 되면 그는 또 금방 이 학원에 오겠지"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 9,
  "jh": "ebf46a2fc28a",
  "ko": "내가 너와… 너희와 지내고 싶다고 생각하는 한 몇 번이고"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "26b6a8831bf0",
  "ko": "널 위해서라면 이 몸은 몇 번이고 싸울 수 있어!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 9,
  "jh": "89a06f61c55b",
  "ko": "든든하군. 하지만 난 가능하면 네가 편안한 나날을 보냈으면 해"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 6,
  "jh": "65d9d5e43283",
  "ko": "어디 가?"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 9,
  "jh": "52c81e89749d",
  "ko": "매듭을 지으러. 모든 건 내 잘못이 원인이니까"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 6,
  "jh": "0f3787496162",
  "ko": "그래… 어쩌면 내일은 네 탈옥을 돕게 되려나"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 9,
  "jh": "2432ec05eec7",
  "ko": "하하하. 그렇게 안 되도록 빌어 줘"
 },
