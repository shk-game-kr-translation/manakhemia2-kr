[
 {
  "key": "m0",
  "kind": 0,
  "chr": 11,
  "jh": "e2aaa56da5ed",
  "ko": "아… 사람이, 사람이 쓰러져 있어요!"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 0,
  "jh": "8f65a2ba739c",
  "ko": "이 녀석은 분명… 우리 반 녀석이군"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 7,
  "jh": "4625ff9831e9",
  "ko": "거짓말? 나 이런 사람 몰라. 이름이 뭔데?"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 0,
  "jh": "189416ee53d5",
  "ko": "…나도 이름은 기억 안 나"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 107,
  "jh": "381c2900947e",
  "ko": "볼프야! 이름 정도는 기억해 줘!"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 7,
  "jh": "7e3ce6ef7955",
  "ko": "아, 움직였다"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 3,
  "jh": "cb9baf1961a5",
  "ko": "뭐야, 멀쩡하잖아. 이런 데서 뭐 하는 거야?"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 107,
  "jh": "2f9990e77ab6",
  "ko": "뭐 하긴 군나르 선생님 수업으로… 앗! 그러고 보니 너희 없었지!?"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 0,
  "jh": "4403e6656a56",
  "ko": "…이런저런 사정이 있었어"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 8,
  "jh": "f4d5c0e27412",
  "ko": "수업으로 왔다는 건 돌아가는 길은 알아?"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 107,
  "jh": "2611e16f2ef0",
  "ko": "아니… 몬스터한테 쫓겨서 정신없이 도망쳐 와서…"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 7,
  "jh": "8a902d3f3dfe",
  "ko": "그렇구나. 그럼 우리랑 같이 갈래? 미아끼리 사이좋게"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 107,
  "jh": "a6f2a34f5778",
  "ko": "그렇게 말해 주는 건 고마운데… 다리를 다쳐서 말이야"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 107,
  "jh": "a5183ada7335",
  "ko": "짐이 되긴 싫어. …두고 가 줘"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 3,
  "jh": "3cade99f4db8",
  "ko": "그래. 그럼"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 107,
  "jh": "9019cca761a4",
  "ko": "기다려! 그렇게 쉽게 버리지 마!"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 3,
  "jh": "d4dd99cee9c3",
  "ko": "정말! 뭐야! 같이 오고 싶은 거야? 아닌 거야? 확실히 해!"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 107,
  "jh": "e727f353fb48",
  "ko": "그게… 여러분이 무사히 돌아가면 데리러 와 주시면 기쁘겠습니다…"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 0,
  "jh": "be24b9aeed9c",
  "ko": "알았어. 생각해 둘게"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 107,
  "jh": "7b3cb1a0ce4e",
  "ko": "생각해 둔다가 아니라. 거기선 맡겨 둬! 정도는 말해 줬으면…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 11,
  "jh": "6ce3dd7cdd6a",
  "ko": "근처에 저희가 쓰던 동굴이 있어요. 거기서 쉬고 계세요"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 107,
  "jh": "568ba315a56c",
  "ko": "아, 응. 그렇게 할게… 아, 맞다"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 3,
  "jh": "0d651677ece9",
  "ko": "아직 뭐가 있어?"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 107,
  "jh": "9edc6d244f2c",
  "ko": "이번 특별 수업용 몬스터… 그 녀석을 조심해"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 107,
  "jh": "110a304781ac",
  "ko": "무려 이 내가 전혀 상대가 안 됐을 정도니까"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 0,
  "jh": "17b94592f5b6",
  "ko": "저 녀석이 상대가 안 됐다고 해도 말이지…"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 7,
  "jh": "fec68c4e3aae",
  "ko": "솔직히 센 건지 약한 건지 모르겠네"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 4,
  "jh": "7972f76e6847",
  "ko": "뭐, 주의해서 나쁠 건 없겠지"
 },
 {
