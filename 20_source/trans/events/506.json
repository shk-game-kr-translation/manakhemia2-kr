[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "832b693c42a0",
  "ko": "하아, 하아… 로제… 어디 있는 거야…?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 3,
  "jh": "736b11031497",
  "ko": "내가 잘못했으니까 돌아와… 섣부른 짓 하지 마…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "db4abd9a5d03",
  "ko": "…어머? 여기 어디지? 정신없이 달려와서 길을 모르겠…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 3,
  "jh": "3e4a8424fc9c",
  "ko": "왠지 전에도 비슷한 일이 있었던 것 같은데…"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 3,
  "jh": "745517d40f60",
  "ko": "여, 역시~!"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 0,
  "jh": "1c6dc0467937",
  "ko": "방금 목소리… 저쪽인가!"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 3,
  "jh": "443be7d41ced",
  "ko": "오, 오지 마! 날 먹어도… 분명 맛있긴 하겠지만"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 58,
  "jh": "962f8399313d",
  "ko": "키샤~~!"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 3,
  "jh": "2966e22d194c",
  "ko": "꺅! 하필 이럴 때 윔도 윤도… 로제…"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 3,
  "jh": "89ecdd1c9b90",
  "ko": "시, 싫어… 싫어어어어!"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 0,
  "jh": "10749a035115",
  "ko": "늦지 않았나!"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 3,
  "jh": "0aee9fa526b2",
  "ko": "로제!?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "3b1b453cb7c1",
  "ko": "물러나 계세요. 빨리!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 3,
  "jh": "680903a65609",
  "ko": "으, 응…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "30d4f2379b5a",
  "ko": "하아아아앗!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 0,
  "jh": "29573f0e2c5d",
  "ko": "후우… 이 정도 적이라 다행인가…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 3,
  "jh": "f749477599e5",
  "ko": "저, 저기… 로제…?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 0,
  "jh": "1df3d0eec9e5",
  "ko": "이걸로 몇 번째예요? 정말…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "f8c74101c5c5",
  "ko": "그, 그치만… 로제가 가출해 버려서 걱정돼서…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "63d69b6e6ee0",
  "ko": "휴가 좀 받았다고 왜 가출을 해야 하는데요"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "7a78597778d9",
  "ko": "어? 제대로 알고 있었어?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "f52040abce5f",
  "ko": "아가씨가 꼬인 말투로밖에 말 못 하는 건 잘 알고 있으니까요"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 3,
  "jh": "c288f8fb5aac",
  "ko": "음… 그렇게 말 안 해도…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 0,
  "jh": "7c15f324083e",
  "ko": "덕분에 모처럼의 휴가가 엉망이에요"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 3,
  "jh": "67b66aa3a15d",
  "ko": "으으… 뭐야, 그럼 안 오면 됐잖아"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "c19f7da11832",
  "ko": "그럴 수도 없잖아요. 아가씨가 다치기라도 하는 날엔…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 3,
  "jh": "189b745f6819",
  "ko": "아… 역시 내가 걱정돼서…?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "83132886d4fd",
  "ko": "주인어른께 혼나서 진짜로 해고될지도 모르니까요"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "788b9774d151",
  "ko": "아… 그래. 그런 거구나…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 0,
  "jh": "cfdcb4c5acf0",
  "ko": "응? 왜 풀이 죽으셨어요?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "31263703fc07",
  "ko": "…역시 클로에 씨 말대로였어… 나 같은 건…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 0,
  "jh": "5d21bd00a2f8",
  "ko": "중얼거리지 말고 빨리 돌아가요. 또 언제 몬스터가 나올지…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 3,
  "jh": "88219241bbca",
  "ko": "돌아가고 싶으면 혼자 돌아가! 난 내버려 둬!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 0,
  "jh": "eac651c5ad83",
  "ko": "이번엔 화를 내시고… 오늘은 유난히 이상하시네요"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 3,
  "jh": "19c31e1b47d4",
  "ko": "그래! 어차피 난 이상한 여자야! 그러니까… 그러니까 싫은 거지!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 0,
  "jh": "0ff81eb8bd0c",
  "ko": "싫다니… 제가 아가씨를요?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 3,
  "jh": "02d5f326456d",
  "ko": "그래. 억지로 일하고 내 제멋대로인 말만 들어 주고… 좋아할 리가…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 0,
  "jh": "8f66edef2229",
  "ko": "또 풀이 죽으셨네… 저기요"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 0,
  "jh": "1f4d8b6851a6",
  "ko": "좋아하는지는 둘째 치고, 싫은 사람 밑에서 10년이나 일할 만큼 별난 사람은 아니에요"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 3,
  "jh": "22da077753a2",
  "ko": "거짓말! 달리 갈 데가 없으니까 어쩔 수 없이 일한 거잖아!?"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 0,
  "jh": "c21c340f7c32",
  "ko": "어릴 때라면 몰라도 저 혼자 먹고사는 것쯤 어떻게든 돼요"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 3,
  "jh": "8f90af2d2ce8",
  "ko": "으, 듣고 보니… 그럼 왜?"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 0,
  "jh": "bcb6fff00fdb",
  "ko": "…아무래도 좋잖아요, 그런 거"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 3,
  "jh": "25d8188fa8ae",
  "ko": "안 돼! 꽤 중요한 거니까 제대로 대답해!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 0,
  "jh": "440765acb9bb",
  "ko": "…오늘은 휴가니까 아가씨 명령을 들을 필요는 없죠"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 3,
  "jh": "558c28eaea19",
  "ko": "그럼 휴가 끝! 이제 충분히 쉬었잖아!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 0,
  "jh": "a03826efc668",
  "ko": "반나절도 안 쉬었는데요"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 3,
  "jh": "a6c9b78b3165",
  "ko": "됐으니까! 빨리 대답해!"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 0,
  "jh": "0bd01c83d8c5",
  "ko": "하아… 어쩔 수 없군. 확실히 옛날엔 싫어서 견딜 수 없었죠"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 0,
  "jh": "9c2460be893e",
  "ko": "왜 내가 이런 데서 일해야 하나 하고 계속 생각했어요. 그래도…"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 3,
  "jh": "dd7a2ae63fb2",
  "ko": "그래도?"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 0,
  "jh": "27179dc5f404",
  "ko": "그러니까 그… 제멋대로인 말 듣는 것도 나쁘지 않나 싶어서… 그런 거예요"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 3,
  "jh": "f9944cf3889b",
  "ko": "무슨 소리야. 그래선 모르겠어!"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 0,
  "jh": "c69b9a37f3ac",
  "ko": "이제 됐잖아요. 제가 받는 월급으론 말할 수 있는 건 여기까지예요"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 0,
  "jh": "6167afc4ed9a",
  "ko": "자, 안 움직이시면 두고 돌아갈 거예요"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 3,
  "jh": "06f105772a8f",
  "ko": "아, 기다려! 하나만 더…"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 0,
  "jh": "d3030fa28b23",
  "ko": "이번엔 뭐예요?"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 3,
  "jh": "337195ba5dc6",
  "ko": "다리가, 그… 업어…"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 0,
  "jh": "60a384a12a1b",
  "ko": "네?"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 3,
  "jh": "2257e6eeed76",
  "ko": "…다리가 풀렸으니까 업어 달라고! 자, 빨리!"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 0,
  "jh": "781214959937",
  "ko": "…하아아"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 3,
  "jh": "1a2743272c82",
  "ko": "왜 한숨 쉬는 거야! 이 나를 업을 수 있는데? 안 기뻐!"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 0,
  "jh": "045f5021f153",
  "ko": "네네. 기뻐서 눈물이 날 것 같네요. 자, 타세요"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 3,
  "jh": "bd6a452aff94",
  "ko": "처음부터 솔직하게 그렇게 말하면 되잖아"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]