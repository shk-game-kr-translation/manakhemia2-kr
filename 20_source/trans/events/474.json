[
 {
  "key": "m0",
  "kind": 2,
  "chr": 9,
  "jh": "f4209569f886",
  "ko": "안 오네, 둘 다… 이건 역시…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 6,
  "jh": "4772dc96de39",
  "ko": "아까운 사람을 잃었어. 또 새 주인을 찾아야 하나…"
 },
 {
  "key": "m2",
  "kind": 5,
  "chr": 1,
  "jh": "0e9475d0f369",
  "ko": "어이~ 멋대로 죽이지 말아 줄래?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 6,
  "jh": "da8727d5e2f4",
  "ko": "우왓! 누나!?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 8,
  "jh": "85772d7309a6",
  "ko": "무사했던 거야?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "a3b978fb5529",
  "ko": "솔직히 나도 놀랐어… 어제도 벌벌 떨면서 거의 못 잤고"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 9,
  "jh": "e21eab4792ad",
  "ko": "그렇게 정신적으로 괴롭히는 작전으로 바꿨다거나…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "df7b57f6194e",
  "ko": "음~ 클로에는 성격 나쁘지만 직접 손을 쓰는 타입이라 그건 아닐 것 같은데…"
 },
 {
  "key": "m8",
  "kind": 5,
  "chr": 2,
  "jh": "e0fdae40d9c7",
  "ko": "너무한 말…"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 1,
  "jh": "fab9a0a46282",
  "ko": "와! 클로에!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 6,
  "jh": "0bff156a8120",
  "ko": "방금 험담한 건 형이야! 이 몸은 아무 말도 안 했어!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 8,
  "jh": "e794cc49237c",
  "ko": "너 이 자식! 비겁하다!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 9,
  "jh": "0959c373c595",
  "ko": "응? 옷이 더러워졌군. 여기저기 상처투성이고…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "82e1cbdc03bb",
  "ko": "…오는 길에 푸니푸니를 밟고 넘어졌어"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "ee85db5ac908",
  "ko": "그런데 넘어진 데가 하필 계단이라 기세 좋게 아래까지 굴러떨어져서…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 8,
  "jh": "37b41bb139c3",
  "ko": "…잘도 그 정도 상처로 끝났네"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 2,
  "jh": "27e95858ecd5",
  "ko": "계단 아래선 백 마리 넘는 개랑 고양이가 처절하게 싸우고 있어서 휩쓸려서…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 2,
  "jh": "bec6fed0b866",
  "ko": "정신 차려 보니 들고 있던 가방도 없어졌어…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 9,
  "jh": "0d1114e4e70a",
  "ko": "거기까지 가면 이제 예술적이군…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 6,
  "jh": "e1f831f54367",
  "ko": "신기한 일도 다 있네. 불행해지는 건 누나 쪽일 줄 알았는데"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "d7dc02a0e695",
  "ko": "뭐, 솔직히 나도 그렇게 생각했지만…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "e0eede792b36",
  "ko": "내가 절친인 울리카한테 그런 짓을 할 리가 없잖아…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "9ff7a099d031",
  "ko": "눈 피하면서 말하지 마… 그래서, 진짜론 뭘 하려고 했어?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "b5e31ac1e945",
  "ko": "…말해도 화 안 내?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "e641d9c4e4a9",
  "ko": "그건 듣고 나서 정할게"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "d6691ace1be9",
  "ko": "…실은 어제…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 2,
  "jh": "1958fb285cf7",
  "ko": "하나를 박는 건 아버지를 위해… 둘을 박는 건 어머니를 위해… 후, 후, 후후후후후…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 2,
  "jh": "726d816be702",
  "ko": "마지막 마무리… 정성껏 주술을 건 이 못을 박으면…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 2,
  "jh": "db8c1b84fc63",
  "ko": "난 손을 더럽히지 않고 멀리서 바라보기만 하면… 후후후후…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 2,
  "jh": "ac8f3a47ca84",
  "ko": "아얏… 손가락 베였다. ………아. 이거 위험할지도…?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 9,
  "jh": "5084dcf29620",
  "ko": "즉, 아가씨를 저주하려다가 그만 자기가… 라는 건가?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 2,
  "jh": "240241925c4b",
  "ko": "…데헷"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "289247d212c7",
  "ko": "데헷이 아니야~! 뭐야, 자업자득이잖아!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 2,
  "jh": "2d6f27b322a0",
  "ko": "그만 충동적으로… 그리고 저주가 아니라 주술…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 6,
  "jh": "cb582285a7d5",
  "ko": "여전히 거기엔 집착하네"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 2,
  "jh": "e1c4fedaf552",
  "ko": "이 주술의 굉장한 점은 주변 사람까지 휘말리게 한다는 거야…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 8,
  "jh": "6b657f45b517",
  "ko": "…뭐? 야, 농담이지? 얼른 풀어, 그런 저주"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 2,
  "jh": "214c7c5622c6",
  "ko": "풀고 싶은데… 주술 책을 잃어버려서…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 2,
  "jh": "a3e65df54650",
  "ko": "아마 어제 그 장소… 무너져 가는 잔도에 두고 온 것 같아…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 9,
  "jh": "554b24f4fced",
  "ko": "매번 생각하지만 넌 푸는 법을 먼저 조사해 둬야 하지 않을까…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 2,
  "jh": "ba0bbef9b34b",
  "ko": "처음부터 풀 생각으로 주술 같은 거 안 해…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 1,
  "jh": "66845f91c909",
  "ko": "옳은 말이지만 네가 하면 화나네… 뭐, 됐어. 그럼 빨리 찾으러 가자"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 2,
  "jh": "a0ab511d6888",
  "ko": "도와줄 거야…?"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 1,
  "jh": "eca02279e60d",
  "ko": "지금 클로에 혼자선 위험하잖아. 너희도 갈 거지?"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 8,
  "jh": "d02803bbd696",
  "ko": "아니, 난… 휘말리는 건 사양이고…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 6,
  "jh": "11a9deb10591",
  "ko": "검은 누나는 저주받는 아픔을 한 번 알아 두는 게 좋을 것 같은데"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 9,
  "jh": "83a5384bbdf8",
  "ko": "여자의 부탁을 거절하는 건 마음에 걸리지만, 이후에 데이트 약속이 있어서"
 },
 {
  "key": "m47",
  "kind": 0,
  "chr": 2,
  "jh": "7a5e20862305",
  "ko": "이럴 때 인간의 본성이 나오지…"
 },
 {
  "key": "m48",
  "kind": 0,
  "chr": 1,
  "jh": "47983b1015c3",
  "ko": "마음은 알겠지만… 지금 클로에를 버리면 나중이 무서울걸"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 8,
  "jh": "33d7d0b426b5",
  "ko": "어쩔 수 없지. 이번만은 어울려 줄게"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 9,
  "jh": "a8f6a0ea8bb9",
  "ko": "데이트는 언제든 할 수 있지만, 검은 아가씨를 도울 수 있는 건 지금뿐이지"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 6,
  "jh": "78dc6c879843",
  "ko": "요정 씨로서 곤란한 사람은 내버려 둘 수 없지"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 2,
  "jh": "a68034be105a",
  "ko": "정말, 인간의 본성이 나와…"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 1,
  "jh": "254dc2fc9628",
  "ko": "그럼 일단 어제 책을 두고 왔다는 장소에 가 보자"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]