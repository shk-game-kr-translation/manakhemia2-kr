[
 {
  "key": "m0",
  "kind": 0,
  "chr": 61,
  "jh": "5a169ee38856",
  "ko": "자, 조용히 시작됐습니다, 고토 VS 페페론, 학원이 자랑하는 2대 진수의 대결!"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 61,
  "jh": "08d0a7f96c49",
  "ko": "이곳 시합장엔 소문을 들은 눈치 빠른 학생들이 달려와 있습니다"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "61ff6d40c683",
  "ko": "…왜 사람이 모여 있는 거야?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 2,
  "jh": "31d28e423294",
  "ko": "내가 모았어… 탈인형 씨는 사람들이 보고 있어야 진심을 내는 타입이라…"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 9,
  "jh": "17b8dc23fe99",
  "ko": "유감이군… 친구인 네가 지는 모습을 공중 앞에 드러내게 되다니"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 6,
  "jh": "796bb0620e5c",
  "ko": "너야말로 괜찮았어? 여자애들이 네 참혹한 모습에 실망하지 않을까"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 9,
  "jh": "700f51927169",
  "ko": "말이 늘었군. 하지만 너에게 승산은 없어"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 9,
  "jh": "35b0a199e392",
  "ko": "무엇보다 내 기술과 검은 아가씨의 두뇌가 하나가 되었으니까"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 6,
  "jh": "7e9b8b6947bb",
  "ko": "그렇게 치면 이 몸의 괴력과 누나의 바보 힘도 있거든!"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 61,
  "jh": "a8f4e859e6af",
  "ko": "벌써부터 격렬한 설전이 펼쳐지고 있습니다"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 61,
  "jh": "52d6bac7f650",
  "ko": "또한 해설로는 혼자 한가해 보이던 에나 군을 모셨습니다"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 61,
  "jh": "00bd4555aed9",
  "ko": "오늘 잘 부탁드립니다"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 8,
  "jh": "e51ee873798c",
  "ko": "가능하면 내버려 뒀으면 했는데…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "e0c7d6d9a78f",
  "ko": "하아, 이렇게 일이 커질 줄이야…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 30,
  "jh": "782691fd020d",
  "ko": "이것도 저쪽 작전이다. 이쪽 집중을 흐트러뜨리려는 거지"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 6,
  "jh": "d2aa9ab35138",
  "ko": "이 몸은 침착하니까 괜찮아. 그렇지 않으면 그를 못 이기니까…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 30,
  "jh": "d8420686e669",
  "ko": "좋은 얼굴이다. 알겠냐, 힘이라면 압도적으로 네가 위다"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 30,
  "jh": "e5ff9096453b",
  "ko": "한 방만 넣으면 반드시 가라앉힐 수 있다!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 30,
  "jh": "cbbaaff543ed",
  "ko": "이봐, 세컨드인 당신이 시무룩한 얼굴을 하면 어쩌냐"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "a29a49e4d5bc",
  "ko": "아니… 역시 신경 쓰여. 저쪽에 클로에가 붙어 있는 게…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 9,
  "jh": "80dd7463a3e3",
  "ko": "네가 우리 편이라 정말 다행이야. 이런 악마 같은 책략을 주다니…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 2,
  "jh": "3aebf6f935eb",
  "ko": "…이제 탈인형 씨 하기 나름이니까"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 9,
  "jh": "08b841196164",
  "ko": "후후후. 네가 승리의 여신이길 빌겠어!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 2,
  "jh": "642c4b093eb1",
  "ko": "…방금 악마라고 불러 놓고"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 6,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 9,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 61,
  "jh": "2ad07e2bfee5",
  "ko": "양자, 아까와는 딴판으로 말없이 상대를 노려보고 있습니다! 그야말로 일촉즉발!"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 61,
  "jh": "6e61052c9d9a",
  "ko": "에나 씨, 이 승부 어떻게 될 것 같습니까?"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 8,
  "jh": "8a16a739b1a2",
  "ko": "센 쪽이 이기지 않겠냐?"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 61,
  "jh": "a7f5bdb262b9",
  "ko": "과연! 정말 옳으신 말씀!"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 61,
  "jh": "8e57935b68b1",
  "ko": "회장의 열기도 최고조에 달해… 지금, 운명의 공이 울렸다아!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 6,
  "jh": "89985ef35797",
  "ko": "각오오오오!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 9,
  "jh": "70baf7b568a2",
  "ko": "후훗, 기세만으로 이길 수 있다고 생각하지 마!!"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 6,
  "jh": "348f276c5ab8",
  "ko": "어, 어라? 왜… 공격이 전혀 안 맞아"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 9,
  "jh": "31ef9ecf0299",
  "ko": "후후후… 이제 와서 깨달아도 늦었어. 넌 이미 함정에 걸려 있으니까…"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 61,
  "jh": "e44a66d145a4",
  "ko": "대단하다! 고토 선수, 모든 공격을 완벽하게 피하고 있습니다!"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 8,
  "jh": "2e3278c19d88",
  "ko": "피한다기보다 페페론이 스스로 빗맞히는 것처럼 보이는데…"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 61,
  "jh": "a350de9ffc58",
  "ko": "오오이런! 에나 군의 입에서 해설다운 말이 튀어나왔다~!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 30,
  "jh": "f079452365ed",
  "ko": "뭐 하는 거냐 페페론! 제대로 노려서 쳐!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 6,
  "jh": "b9082a189fd3",
  "ko": "노리고 있어! 그래도 안 맞아서… 응? 손이 미끌미끌해…? 설마!?"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 9,
  "jh": "de109e88976b",
  "ko": "그래, 탈인형에 기름을 먹여 왔지. 검은 아가씨의 아이디어로"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 6,
  "jh": "dbcc7bc8081a",
  "ko": "그, 그런… 그렇지 않아도 네 피부는 실크처럼 매끈매끈한데…"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 9,
  "jh": "eb7f4ecdbc31",
  "ko": "그야말로 범에 날개, 실크에 기름… 지금의 나를 상처 입히는 건 누구도 불가능!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 1,
  "jh": "a0baa9fd2926",
  "ko": "역시 클로에네. 이런 걸 생각해 내다니…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 30,
  "jh": "f0700db4d2b2",
  "ko": "감탄할 때가 아니야! 어떻게든… 어떻게든 해야 해!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 9,
  "jh": "2b7d15ad4cb8",
  "ko": "자, 그럼 이번엔 이쪽에서 공격해 볼까…"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 9,
  "jh": "8c2eb9ae9a16",
  "ko": "나의 오일 공격, 피할 수 있으면 피해 봐!"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 6,
  "jh": "538dc285a93a",
  "ko": "으, 으아… 당한다!?"
 },
 {
  "key": "m49",
  "kind": 0,
  "chr": 6,
  "jh": "e936ef8f7f0d",
  "ko": "어, 어라?"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 9,
  "jh": "808b371bfe44",
  "ko": "음…!?"
 },
 {
  "key": "m51",
  "kind": 0,
  "chr": 61,
  "jh": "3bb02cf94ed7",
  "ko": "오오이런! 페페론 선수, 고토 선수의 장기를 빼앗는 듯한 훌륭한 풋워크!"
 },
 {
  "key": "m52",
  "kind": 0,
  "chr": 61,
  "jh": "bb649e9288f0",
  "ko": "모든 공격을 종이 한 장 차이로 피하고 있다!"
 },
 {
  "key": "m53",
  "kind": 0,
  "chr": 8,
  "jh": "fe3df3a62438",
  "ko": "아니. 피하는 게 아니라… 됐다, 귀찮아"
 },
 {
  "key": "m54",
  "kind": 0,
  "chr": 61,
  "jh": "5d30530198b2",
  "ko": "예상 밖의 시합 전개에 에나 군도 손을 들어 버렸다~!"
 },
 {
  "key": "m55",
  "kind": 0,
  "chr": 61,
  "jh": "447c196fb1a8",
  "ko": "과연 이후 승부는 어떻게 움직일 것인가!?"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 6,
  "jh": "c21c57a91c90",
  "ko": "왜, 왜 그래? 이 몸은 한 발짝도 안 움직였는데…?"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 9,
  "jh": "1b51809538ea",
  "ko": "이건… 아차! 기름투성이인 이 손으론 너를 만질 수가 없어…!"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 6,
  "jh": "4b4011bfd493",
  "ko": "뭐, 뭐라고오오오!"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 1,
  "jh": "5df4e4083b0d",
  "ko": "클로에, 너…"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 2,
  "jh": "61d7a96d0f7c",
  "ko": "…작전 실수. 데헷"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 9,
  "jh": "ef592ba6c9a6",
  "ko": "귀엽게 웃어도 말이지… 자, 곤란하군. 어떻게 할까…"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 30,
  "jh": "395d95344af0",
  "ko": "잘 모르겠지만 이건 기회가 굴러들어왔다는 거냐?"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 1,
  "jh": "7c1d4490bf51",
  "ko": "그렇다고도 할 수 없잖아. 이쪽 공격도 전혀 안 맞으니까"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 30,
  "jh": "d41c2b827ca0",
  "ko": "그럼 어떻게 하라는 거냐!?"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 1,
  "jh": "567a83fc83e0",
  "ko": "그러니까 나한테 묻지 마! 아, 그래도… 기름이라. 뭔가 약점이 있었던 것 같은데…"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 9,
  "jh": "b6985923052e",
  "ko": "이대로면 서로 막다른 길이군…"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 6,
  "jh": "68fcbed6657f",
  "ko": "그럼 여기서 끝낼까?"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 9,
  "jh": "815fb54a076a",
  "ko": "그건 무리한 상담이군"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 9,
  "jh": "09badb2b7a02",
  "ko": "왜냐하면 온몸이 기름투성이인 넌 눈을 뗄 수 없을 만큼 빛나고 있으니까"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 6,
  "jh": "baef5678a895",
  "ko": "이 몸도 같은 생각을 하고 있었어… 이렇게 된 이상 결판이 날 때까지!"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 9,
  "jh": "986bb655a8a6",
  "ko": "아아! 몇 시간이든 서로 미끌미끌하게 치고받자고!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]