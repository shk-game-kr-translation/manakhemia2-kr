[
 {
  "key": "m0",
  "kind": 2,
  "chr": 4,
  "jh": "48335718490b",
  "ko": "예정보다 빨리 끝났군. 고맙다"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "4b0799a08a5f",
  "ko": "당연하지, 이 정도 일이면"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 4,
  "jh": "ce0566c338b7",
  "ko": "이대로면 오늘 중에 일을 하나 더 할 수 있겠군"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 0,
  "jh": "00a807dd7dfa",
  "ko": "아직 일해?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 4,
  "jh": "0eb4eb341635",
  "ko": "안심해라. 더 어울리라고는 안 한다"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "fce5f460d88a",
  "ko": "부탁받아도 사양이야. 쯧, 그렇게 벌어서 뭐 하려고"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 4,
  "jh": "c0370de3df8a",
  "ko": "알고 싶으면 대가를 치르라고 하지 않았나?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "23dc5aaac5bd",
  "ko": "방금 노동은 대가가 안 되는 거야?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 4,
  "jh": "4a3cf99ae827",
  "ko": "네 입으로 말했잖아. 이 정도 일, 이라고. 정보료로는 부족하군"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "110fb18161a5",
  "ko": "…말솜씨도 좋구나"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 4,
  "jh": "13f90ee3c9cd",
  "ko": "직업상 협상도 일상다반사라서"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "24fb794193d2",
  "ko": "뭐, 됐어. 몇 번이고 말하지만 무리해서 듣고 싶은 건 아니야"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 4,
  "jh": "855357be9031",
  "ko": "이쪽도 딱히 숨기고 싶은 건 아니다만. 뭐, 내키면 얘기하지"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 0,
  "jh": "d880c6ac5be0",
  "ko": "그럼 뜸 들이지 마"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 4,
  "jh": "20154a0cddaf",
  "ko": "이야기 흐름상 그만. 자, 그럼 다음 일하러 가겠다"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 0,
  "jh": "1844c17e39f3",
  "ko": "종잡을 수 없는 녀석이군…"
 },
 {
  "key": "m16",
  "kind": 5,
  "chr": 7,
  "jh": "8c1aa67c264d",
  "ko": "찾았다~! 로제 발견!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 0,
  "jh": "20e873d788d2",
  "ko": "으악, 전원 다 왔네"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "f02bfa6aecf4",
  "ko": "윤은? 안 보이는데"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "c0dfa9b4d9a3",
  "ko": "일이 있다고 어딘가 갔어요"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "2bdec2842248",
  "ko": "그래? 로제가 윤에 대해 알고 싶어 한다길래 일부러 왔는데…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "b6f04f430b5f",
  "ko": "그 건이라면 이미 해결됐어요"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 7,
  "jh": "052ea231bc97",
  "ko": "에~ 벌써 들었어? 치사해 치사해~!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 0,
  "jh": "61436c107a5b",
  "ko": "넌 관심 없는 거 아니었냐?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 7,
  "jh": "db7271aee4fe",
  "ko": "관심 엄청 많거든! 있잖아~ 나한테도 알려 줘~"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "b79d311d27d3",
  "ko": "어머… 난 로제가 알고 싶어 한다고 해서 왔는데?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 7,
  "jh": "20eec09921c3",
  "ko": "그런 건 당연히 핑계지… 앗! 아니, 그게, 저…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 5,
  "jh": "540040807188",
  "ko": "푸니니니~"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 23,
  "jh": "c4930562cabf",
  "ko": "푸니요는 에토 씨가 그렇게 말해서 따랐을 뿐… 이라며 시치미 떼고 있어요"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 7,
  "jh": "ebb0ecaf4db1",
  "ko": "아~ 너무해 푸니요! 혼자만!"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 3,
  "jh": "0c13832366d5",
  "ko": "날 속이려 하다니 배짱 좋네… 안에서 천천히 얘기 좀 할까"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 7,
  "jh": "24dfed51a84b",
  "ko": "아… 눈이 무서운데? 있잖아, 진정하고 내 변명을… 싫어어어어어!"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 11,
  "jh": "8951fde7bf2a",
  "ko": "…뭐, 남의 비밀을 캐려는 건 좋지 않다는 거네요"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 5,
  "jh": "ee00abd1cc2f",
  "ko": "푸니!"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 0,
  "jh": "d9a264a5deb7",
  "ko": "너희가 할 말이냐, 너희가"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 0,
  "jh": "4174e85f5d9b",
  "ko": "그래도… 오히려 좀 궁금해졌네…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
