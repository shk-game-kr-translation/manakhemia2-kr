 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 0,
  "jh": "e1f7eccbe695",
  "ko": "뭐야. 적한테 잡힌 거 아니었냐"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 7,
  "jh": "e4f00affd111",
