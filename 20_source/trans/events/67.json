 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "8a6509365441",
  "ko": "우리 편째로 이 「소녀의 눈물 폭탄」의 먹잇감으로 만들어 주겠어!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 11,
  "jh": "a1aee5290dae",
  "ko": "아, 결국 그런 이름이 됐군요"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "0fb1bac62d17",
  "ko": "에잇, 받아라아아!!"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 1,
  "jh": "a7eeb17d965d",
  "ko": "뭐야 이거… 앗! 아파! 눈이 따가워!"
 },
 {
  "key": "m23",
  "kind": 5,
  "chr": 3,
  "jh": "ae59fd5f6f21",
  "ko": "적이 움츠러들었어! 일망타진해!"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 3,
  "jh": "c33e362765d0",
  "ko": "후후후, 그야말로 압승이네… 그 시골뜨기는 어디 있어!?"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 0,
  "jh": "4da23fed1356",
  "ko": "안 보이네요… 벌써 도망쳤나…"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 4,
  "jh": "9038a9847624",
