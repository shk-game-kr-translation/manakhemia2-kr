[
 {
  "key": "m0",
  "kind": 2,
  "chr": 4,
  "jh": "d7891afa6905",
  "ko": "자… 나도 여자에 대해 잘 아는 편은 아니라서"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 4,
  "jh": "7bb178e9fd76",
  "ko": "주워들은 정도의 지식과 추측에 의한 얘기가 될 거다. 그래도 괜찮나?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 0,
  "jh": "65202cf81919",
  "ko": "뭐, 당신도 그쪽 얘기엔 어두워 보이니까"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 7,
  "jh": "36f3515d93f6",
  "ko": "뭐든 좋으니까 들려줘 들려줘!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 4,
  "jh": "b3dd6ba39a8b",
  "ko": "그럼… 일반적으로 남자는 순종적이고 순수하고 때 묻지 않은 여성에게 약하다고 한다"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 4,
  "jh": "ea13f8169c23",
  "ko": "내향적이고 실제 연애 경험이 적은 남자일수록 그 경향이 뚜렷하지"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 4,
  "jh": "e1e2ccd09ff1",
  "ko": "외모 취향은 개인마다 천차만별이라 한마디로 말할 순 없지만…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 4,
  "jh": "b797d16e04ec",
  "ko": "분명 네 동생은 푸니푸니의 여동생과 친했지"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 4,
  "jh": "82f76c4d3d01",
  "ko": "그 점에서 생각하면 미인 누나 계열보다 연하 여동생 계열이 취향이라 봐도 틀림없겠지"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 7,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 4,
  "jh": "30401913dd8b",
  "ko": "왜 그러지? 입 다물지 말고 맞장구라도 치는 게 어떠냐"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "fa03b4b5f327",
  "ko": "아니… 이래저래 압도돼서…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 7,
  "jh": "b2ea405ff40b",
  "ko": "대단해! 윤은 이런 거 잘 아는구나. 깜짝 놀랐어!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 4,
  "jh": "75741d14cf4e",
  "ko": "오래 살다 보면 알고 싶지 않은 지식도 저절로 늘어나는 법이다"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 4,
  "jh": "f51bd3df1cb0",
  "ko": "자, 계속해도 되나?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "4c032e45defa",
  "ko": "…아아, 이제 마음껏 얘기해"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 4,
  "jh": "d8eb9f39d7eb",
  "ko": "그럼… 연하 여동생 계열을 좋아하는 남자에 대해서다만"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 4,
  "jh": "eaa160b0a190",
  "ko": "이런 남자는 대개 자존심이 강하고 응석을 받아 주는 데서 기쁨을 느끼는 모양이다"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 4,
  "jh": "c42c9c11cd86",
  "ko": "구체적으로는 오빠, 주인님 같은 호칭이 유효하다고 한다"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 0,
  "jh": "7a4e67b3ada5",
  "ko": "주인님이라…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 11,
  "jh": "e35acd2cdc2a",
  "ko": "아, 네! 윤 씨!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 4,
  "jh": "ed306d712f71",
  "ko": "뭔데?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 11,
  "jh": "ab085e47b8b0",
  "ko": "그럼 저 같은 건 엄청 에나 씨 취향이려나요?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 4,
  "jh": "c909b11b8169",
  "ko": "메이드인가… 메이드에 환상을 품던 시기는 나에게도 있었다만"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 4,
  "jh": "5d7d5a6c090c",
  "ko": "막상 실물을 눈앞에 두니 말이지. …후우"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 11,
  "jh": "d69deff83477",
  "ko": "왜, 왜 거기서 한숨이에요!?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 7,
  "jh": "df76207ac25f",
  "ko": "어렵네… 에나는 내 주인님도 아니고 오빠도 아니고…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 4,
  "jh": "eba16856173b",
  "ko": "음. 친누나한테 오빠 소리 듣는 것만큼 기분 나쁜 건 없으니까"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 4,
  "jh": "f452923b11b0",
  "ko": "발상을 바꿔 보자. 애초에 왜 동생이 연하 취향이 됐는가"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 4,
  "jh": "682ed0d1665d",
  "ko": "그건 오랜 세월에 걸친 네가 동생을 대하는 방식이 원인일 거다"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 7,
  "jh": "3868c7f51cec",
  "ko": "내 탓?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 4,
  "jh": "b81096c8941f",
  "ko": "눈앞의 누나… 즉 연상 여성이 난폭하고 다정함이라곤 없는 존재였다…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 4,
  "jh": "6b1b9b156977",
  "ko": "그렇다면 아직 못 본 연하 여성에게 과도한 환상을 품게 되는 건 무리도 아니지"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 7,
  "jh": "94fecdcbd837",
  "ko": "우~ 또 어려운 말을… 그럼 어떻게 하면 돼?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 4,
  "jh": "5db7ef56108e",
  "ko": "그렇군, 지금 생각할 수 있는 작전은 하나…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 4,
  "jh": "18049a6e2828",
  "ko": "정숙하고 마음씨 고운 누나를 연기해서 갭 모에를 노려 봐라"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 7,
  "jh": "7752260f535a",
  "ko": "갭 모에라고요!?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 0,
  "jh": "c637fecb8a20",
  "ko": "…당신, 절대 그런 취미 있지?"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 4,
  "jh": "955359722e58",
  "ko": "몇 번이나 말하게 하지 마. 어디까지나 일반론이다"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 4,
  "jh": "69e02fe61d40",
  "ko": "자, 그럼 실제로 시뮬레이션을 해 볼까"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 7,
  "jh": "3cd48d60926a",
  "ko": "어? 시뮬레이션?"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 4,
  "jh": "fe5bc6a8a9b3",
  "ko": "실제 현장을 상정한 훈련이다. 노력 없이 몸에 익는 모에 따윈 없으니까"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 4,
  "jh": "a8daedc9eb4d",
  "ko": "엄하게 갈 테니 각오해라!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 7,
  "jh": "958dbedc9e96",
  "ko": "네, 넷!"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 4,
  "jh": "d2547fe7c7ae",
  "ko": "틀렸다! 시선은 더 올려다보듯이! 아래에서 사선 45도를 의식해라!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 7,
  "jh": "13006b04f6e2",
  "ko": "우~ 이, 이렇게?"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 4,
  "jh": "55841c27f6a7",
  "ko": "목소리가 너무 아양 떤다! 더 자연스럽게, 그러면서 남자 마음을 간질이듯!"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 7,
  "jh": "2352e77e8923",
  "ko": "네, 네~ 이렇게요~?"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 4,
  "jh": "cd5f6bd4f502",
  "ko": "웃는 법은 특히 중요하다. 날 따라서 해 봐라"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 4,
  "jh": "0a9dbe47414d",
  "ko": "간다! 우훗. 꺄하☆. 데헷♪"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 7,
  "jh": "cf2fff4991f6",
  "ko": "우, 우후후후. 꺄하하하. 데헤~…"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 4,
  "jh": "7344848039c5",
  "ko": "뭐, 이 정도인가. 얕은 지식이라 얼마나 도움이 될지는 미지수다만"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 7,
  "jh": "66876366ec08",
  "ko": "아뇨… 이제 충분해요… 감사했습니다…"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 4,
  "jh": "e3593edb3c16",
  "ko": "남용은 주의해라. 사람에 따라선 혐오감을 보이는 경우도 있으니까"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 7,
  "jh": "f73d63e5edc8",
  "ko": "네, 넷…"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 0,
  "jh": "73872f925588",
  "ko": "오늘부터 당신을 보는 눈이 달라질 것 같아…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
