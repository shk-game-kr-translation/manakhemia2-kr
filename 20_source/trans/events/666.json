[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "af1c7c44c34f",
  "ko": "후우, 하아… 의외로 무거웠네…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 2,
  "jh": "4e1ea9a93db3",
  "ko": "입고 왔으면 편했을지도… 난 절대 입기 싫지만"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 1,
  "jh": "343202126655",
  "ko": "나도 싫어. 자, 저쪽은 잘되고 있으려나"
 },
 {
  "key": "m3",
  "kind": 5,
  "chr": 8,
  "jh": "ba2f953bf5c4",
  "ko": "아니, 미안… 놓쳤어"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "25bd60eb78cc",
  "ko": "놓쳤어? 정말, 뭐 하는 거야!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 8,
  "jh": "1e9b1415b0a2",
  "ko": "어쩔 수 없잖아. 설마 그렇게 빨리 움직일 줄은 몰랐어"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 6,
  "jh": "b39c3b2f9650",
  "ko": "미안해. 진심일 때 그의 대단함을 잊고 있었어"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "088ca78c45b1",
  "ko": "음… 뭐 됐어. 이럴 때를 위해 탈인형을 인질로 잡은 거니까"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 2,
  "jh": "07b721715030",
  "ko": "더러운 방법이지만…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "5509836ad7ab",
  "ko": "시, 시끄러워. 애초에 이렇게라도 안 하면 안 알려 주는 그 녀석이 나쁜 거야!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "ca5142a6f09b",
  "ko": "심한 책임 전가…"
 },
 {
  "key": "m11",
  "kind": 5,
  "chr": 9,
  "jh": "6ae6390072e0",
  "ko": "정말이지, 아가씨의 제멋대로에도 곤란하군"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 1,
  "jh": "6768763564fd",
  "ko": "음, 어디야? 나와!"
 },
 {
  "key": "m13",
  "kind": 5,
  "chr": 9,
  "jh": "ba61e02aacf0",
  "ko": "페페론, 설마 너까지 같이 이런 짓을 할 줄이야"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 6,
  "jh": "459447017ae4",
  "ko": "으… 친구로서 네 모습을 보고 싶었어"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 6,
  "jh": "a704356ff97e",
  "ko": "왜냐면 넌 이 몸을 아는데… 치사해!"
 },
 {
  "key": "m16",
  "kind": 5,
  "chr": 9,
  "jh": "90cb953bf0dc",
  "ko": "나도 아주 조금 화가 나 버렸어. 여자애한테 손대는 건 마음에 걸리지만"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 1,
  "jh": "423fc1c033a4",
  "ko": "허세 부려도 소용없어. 이쪽엔 인질이 있으니까. 숨지 말고 나와!"
 },
 {
  "key": "m18",
  "kind": 5,
  "chr": 9,
  "jh": "7bd98080bf8f",
  "ko": "인질? 후후후, 아가씨는 무르군. 실로 스위트해"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 1,
  "jh": "fa887249d536",
  "ko": "뭐, 뭐라고!?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "5590ff801110",
  "ko": "어?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 8,
  "jh": "64302c203141",
  "ko": "뭐, 왜?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 6,
  "jh": "87a4cbe13f2d",
  "ko": "이, 이건 설마… 분신술!?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 9,
  "jh": "c76ee8bbc3e4",
  "ko": "남달리 멋에 신경 쓰는 내가 갈아입을 옷을 안 갖고 있을 줄 알았나?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 2,
  "jh": "9b2b745780c1",
  "ko": "울리카는 머리가 약한 애라서…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "81dbce071e96",
  "ko": "시, 시끄러워! 너희도 몰랐잖아!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 9,
  "jh": "ef5f6e8f6df1",
  "ko": "게다가 말이지, 내 탈인형은 마니아 사이에서도 인기가 높아서"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 9,
  "jh": "473913ae9d56",
  "ko": "약간의 방범 장치가 설치돼 있어"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "fd33b30d98a5",
  "ko": "방범 장치?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 8,
  "jh": "0298ee5f7c23",
  "ko": "그러고 보니 뭔가 움직이는 소리가 나네…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 9,
  "jh": "7526d3739710",
  "ko": "남의 비밀을 캐려는 녀석은 시한폭탄의 업화에 타 버려라… by 고토"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "58c47475d176",
  "ko": "그 결정 대사는 좀 어감이 별로인데…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 9,
  "jh": "b14defbcf0c1",
  "ko": "아디오스, 아틀리에의 동료들!"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 1,
  "jh": "b54375b2b114",
  "ko": "어, 잠깐! 기다려…"
 },
 {
  "key": "m34",
  "kind": 5,
  "chr": 1,
  "jh": "a146e342bf06",
  "ko": "꺄아아아아아!"
 },
 {
  "key": "m35",
  "kind": 5,
  "chr": 8,
  "jh": "ac36dc70ac48",
  "ko": "으아아아아아!"
 },
 {
  "key": "m36",
  "kind": 5,
  "chr": 6,
  "jh": "9f72961ef650",
  "ko": "갸아아아아아!"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 9,
  "jh": "2b545887ada4",
  "ko": "음… 좀 지나쳤나. 나도 참 어른스럽지 못하군"
 },
 {
  "key": "m38",
  "kind": 5,
  "chr": 2,
  "jh": "5a1f119e7e7f",
  "ko": "…가끔은 좋은 약이라고 생각해"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 9,
  "jh": "ccbbce65975f",
  "ko": "…어디서 나온 거지?"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 2,
  "jh": "c1756f27fe25",
  "ko": "옮길 때 이상한 소리가 들려서 미리 대피로를 확보…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 9,
  "jh": "f9b29af054ce",
  "ko": "이런이런, 네가 한 수 위인가. 장래에 네 상대가 될 남자가 안쓰럽군"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 2,
  "jh": "58bd8755817e",
  "ko": "그건 괜찮아… 이래 봬도 꽤 헌신하는 타입"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 9,
  "jh": "0cae9decb6d6",
  "ko": "기억해 두지. 그래서, 아직 나한테 볼일이 있나?"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 2,
  "jh": "49b156c54f20",
  "ko": "왜 그렇게 얼굴 보이는 게 싫어…?"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 9,
  "jh": "7f66eb422f83",
  "ko": "…오래 살다 보면 이런저런 일이 있어. 진정한 의미로 사람과 접하는 게 무서워졌지"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 2,
  "jh": "e8a4d632ea03",
  "ko": "그래도 여자애는 꼬시잖아…"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 9,
  "jh": "f3a61b49098c",
  "ko": "그건 그거고. 사람에겐 저마다 딱 좋은 거리감이라는 게 있으니까"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 2,
  "jh": "ac96bfbf45fe",
  "ko": "…잘 모르겠어"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 9,
  "jh": "e9792475a2ba",
  "ko": "모르는 게 좋아. 모른다는 건 마음에 상처가 없다는 거니까"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 2,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m51",
  "kind": 0,
  "chr": 9,
  "jh": "d03f507c7235",
  "ko": "이제 됐나?"
 },
 {
  "key": "m52",
  "kind": 0,
  "chr": 2,
  "jh": "521cdc5b3a89",
  "ko": "…원래 그렇게 관심 있었던 것도 아니니까"
 },
 {
  "key": "m53",
  "kind": 0,
  "chr": 9,
  "jh": "54f09d4d0222",
  "ko": "친구들 치료해 줄 생각은 안 하나"
 },
 {
  "key": "m54",
  "kind": 0,
  "chr": 2,
  "jh": "388512f1e7a4",
  "ko": "…다들 쓸데없이 생명력이 강하니까 괜찮아"
 },
 {
  "key": "m55",
  "kind": 0,
  "chr": 9,
  "jh": "92e09e1dfd76",
  "ko": "설득력 있는 의견이군. 자, 그럼 나도 이만 실례할까…"
 },
 {
  "key": "m56",
  "kind": 5,
  "chr": 1,
  "jh": "786473b4b06d",
  "ko": "크… 두고 봐… 반드시 언젠가 정체를 폭로해 줄 거야…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]