[
 {
  "key": "m0",
  "kind": 0,
  "chr": 11,
  "jh": "655ac806f8e7",
  "ko": "로제 씨! 늦었잖아요!"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 0,
  "jh": "449131138ee1",
  "ko": "미안… 아가씨는?"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 11,
  "jh": "de03f267657e",
  "ko": "저기요. 정말, 빨리 어떻게 좀 해 주세요"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 3,
  "jh": "f0573ab3afee",
  "ko": "이날을 위해 이것저것 생각했는데… 역시 나 같은 건 아무래도…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "6502cb1b8988",
  "ko": "후후, 가엾어라. 혼자 들떠서는… 지금의 나에겐 아무 존재 가치도…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "1dfd136e285e",
  "ko": "…중증이군"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 11,
  "jh": "512a9d4df240",
  "ko": "로제 씨 탓이에요. 제대로 책임지세요"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "f766d30888ea",
  "ko": "아무리 그래도 이건 내 손에 벅찬데…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 11,
  "jh": "4498f90efeab",
  "ko": "됐으니까, 자!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "2fa785e26927",
  "ko": "아아, 알았으니까 밀지 마! 저… 아가씨?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 3,
  "jh": "b1bd0b307582",
  "ko": "…어머? …안 되겠어. 결국 로제 환영까지 보이게 돼서…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 11,
  "jh": "895684a38cad",
  "ko": "아가씨, 진짜예요! 진짜 로제 씨라고요!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 3,
  "jh": "39416da67f8f",
  "ko": "어… 진, 짜…? 어? 어?"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 0,
  "jh": "e073802c6283",
  "ko": "저기… 너무 마구 만지지 말아 주셨으면 하는데요…"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 3,
  "jh": "14c806b3f0f1",
  "ko": "아… 오오… 확실히 진짜… 앗!? 시, 싫어! 나도 참…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "411aa82124bd",
  "ko": "저, 정말! 늦었잖아! 대체 몇 시간을 기다리게 할 셈이야!?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "43f278c0ce35",
  "ko": "죄송합니다…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "5b7480be7951",
  "ko": "뭐, 뭐 됐어! 오늘은 특별히 용서해 줄게. 자, 그럼 둘이서 느긋하게…"
 },
 {
  "key": "m18",
  "kind": 5,
  "chr": 12,
  "jh": "7fca6d580a4a",
  "ko": "아~ 아~ 들리나"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 0,
  "jh": "40f5b94024cf",
  "ko": "응? 이 목소리는…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 11,
  "jh": "ae116c29222f",
  "ko": "교감 선생님 목소리네요"
 },
 {
  "key": "m21",
  "kind": 5,
  "chr": 12,
  "jh": "564e7be1d146",
  "ko": "각자 학원제를 즐기고 있는 모양이군. 이 몸도 고생한 보람이 있다는 것…"
 },
 {
  "key": "m22",
  "kind": 5,
  "chr": 12,
  "jh": "c843bd0f8ca5",
  "ko": "하지만 올해 학원제는 이걸로 끝이 아니다"
 },
 {
  "key": "m23",
  "kind": 5,
  "chr": 12,
  "jh": "f4c04843f47d",
  "ko": "이제부터 드디어 메인 이벤트의 시작이다!"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 3,
  "jh": "d426241fd4a1",
  "ko": "뭐!? 아직 하나도 못 즐겼어! 이제 겨우 시작되려는 참에…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 7,
  "jh": "5d69c029d036",
  "ko": "와~ 메인 이벤트래! 뭘까? 뭐 하려나?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 5,
  "jh": "d7c62f75273f",
  "ko": "푸니~?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 18,
  "jh": "bd3a31155cca",
  "ko": "메인 이벤트…? 교장, 뭔가 들은 거 있나요?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 13,
  "jh": "204f8ae83622",
  "ko": "아뇨, 저는 아무것도…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 18,
  "jh": "86d20e4ecd9b",
  "ko": "또 뭔가 무모한 일을 시작할 생각은 아니겠죠…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 13,
  "jh": "91a6a258de88",
  "ko": "군나르가 하는 일이니 무모한 게 뻔하다고 생각하는데요"
 },
 {
  "key": "m31",
  "kind": 5,
  "chr": 12,
  "jh": "b946a933edea",
  "ko": "궁금한 메인 이벤트의 내용은… 바로! 학생 전원의 배틀 로열이다!"
 },
 {
  "key": "m32",
  "kind": 5,
  "chr": 12,
  "jh": "176723e1d5d4",
  "ko": "지금부터 네놈들에겐 학생끼리 피로 피를 씻는 싸움을 벌여 받겠다!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 13,
  "jh": "b067510a9d60",
  "ko": "거봐요, 역시 무모하잖아. 그쵸, 내 말대로죠?"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 18,
  "jh": "8a376ebd9a7f",
  "ko": "뭘 기뻐하고 있어요! 빨리 가서 말리세요!!"
 },
 {
  "key": "m35",
  "kind": 5,
  "chr": 12,
  "jh": "3f0e87be32fa",
  "ko": "싸움은 2인 1조 팀끼리 하게 된다"
 },
 {
  "key": "m36",
  "kind": 5,
  "chr": 12,
  "jh": "0ce01cf9d81b",
  "ko": "물론 혼자 싸우고 싶다면 그래도 상관없다"
 },
 {
  "key": "m37",
  "kind": 5,
  "chr": 12,
  "jh": "6715d84d62d5",
  "ko": "각자 제한 시간 내에 10번 전투를 해서 가장 많이 이긴 자를 우승으로 한다"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 1,
  "jh": "05fbf93732b2",
  "ko": "또 살벌한 걸 생각해 냈네…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 8,
  "jh": "bb0e926fd90b",
  "ko": "봐줘라… 끝날 때까지 어디 숨어 있을까"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 2,
  "jh": "de6403e785d2",
  "ko": "숨어도 들켜서 쓰러질 거야… 나한테…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 8,
  "jh": "3c180fd20efc",
  "ko": "누나한테냐고!?"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 6,
  "jh": "55141190dbc4",
  "ko": "배틀 로열이라… 이 몸, 불타오르는걸!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 9,
  "jh": "f9b306f99469",
  "ko": "하하하, 이건 오랜만에 나랑 페페론의 골든 콤비가 부활하려나"
 },
 {
  "key": "m44",
  "kind": 5,
  "chr": 12,
  "jh": "a4d57fe160cf",
  "ko": "참가 자격이 있는 건 본교 학생뿐"
 },
 {
  "key": "m45",
  "kind": 5,
  "chr": 12,
  "jh": "b04acceb39b8",
  "ko": "떠돌이 마나나 요정 씨, 탈인형 부류는 참가 불가다"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 6,
  "jh": "1f121088d48f",
  "ko": "그, 그런!?"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 9,
  "jh": "6a92d6448a17",
  "ko": "이런… 꽤나 핀포인트인 참가 금지령이군"
 },
 {
  "key": "m48",
  "kind": 0,
  "chr": 11,
  "jh": "86f0a8fd5e63",
  "ko": "저는 떠돌이 마나가 아니니까 문제없죠"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 5,
  "jh": "0738d4a7bd34",
  "ko": "푸니! 푸니니~!?"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 23,
  "jh": "5481a4667727",
  "ko": "탈것으로 삼고 있는 형제는 어떻게 되냐고!? 여동생이 묻고 있는데요~!!"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 0,
  "jh": "d4089f73529f",
  "ko": "있잖아, 여기서 소리쳐 봤자 들릴 리가…"
 },
 {
  "key": "m52",
  "kind": 5,
  "chr": 12,
  "jh": "f8a77f3e75eb",
  "ko": "그렇군. 탈것으로 삼은 형제나 푸니푸니에 관해서는 특별히 허가해 주마"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 4,
  "jh": "b642fcff0a22",
  "ko": "들렸던 모양이군"
 },
 {
  "key": "m54",
  "kind": 5,
  "chr": 12,
  "jh": "1559933b7749",
  "ko": "우승자에겐 학원 최강의 명예와 이 몸이 준비한 비장의 부상을 선물해 주마"
 },
 {
  "key": "m55",
  "kind": 5,
  "chr": 12,
  "jh": "57b8bfed2a8d",
  "ko": "항의, 불만은 일절 받지 않는다. 이상이다… 자, 마음껏 싸워라!"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 7,
  "jh": "60b76dd3fa25",
  "ko": "오오오… 재밌겠다!! 달아오른다아아아!"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 5,
  "jh": "b1ceedf1fefc",
  "ko": "푸니이이이이이이!!"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 0,
  "jh": "a4234f1a1a13",
  "ko": "시끄러워, 소리 지르지 마"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 7,
  "jh": "b3f99434cfff",
  "ko": "흥분하지 않을 수가 없어! 이게 바로 축제야! 피의 축제야!"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 0,
  "jh": "66d0901d2c51",
  "ko": "살벌한 단어 쓰지 마"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 3,
  "jh": "108ee55c1116",
  "ko": "크… 결국 로제랑은 아무것도 못 한 채…"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 11,
  "jh": "738dac10683c",
  "ko": "자자. 2인 1조로 참가라니까 이건 기회 아닌가요?"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 3,
  "jh": "371313261dce",
  "ko": "그, 그래, 확실히… 로제랑 합법적으로 단둘이 될 기회…"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 3,
  "jh": "a0c9a65a04a5",
  "ko": "로제, 넌 누구랑 참가할 거야? 답은 뻔하지만 일단 물어볼게"
 },
 {
  "key": "m65",
  "kind": 0,
  "chr": 0,
  "jh": "22f85765d26c",
  "ko": "참가 거부라는 건…"
 },
 {
  "key": "m66",
  "kind": 0,
  "chr": 7,
  "jh": "b828ba3a910d",
  "ko": "안 돼!"
 },
 {
  "key": "m67",
  "kind": 0,
  "chr": 5,
  "jh": "21c75df62cf7",
  "ko": "푸니니!"
 },
 {
  "key": "m68",
  "kind": 0,
  "chr": 3,
  "jh": "262449a8e955",
  "ko": "기각!!"
 },
 {
  "key": "m69",
  "kind": 0,
  "chr": 0,
  "jh": "43378b4d03ee",
  "ko": "뭐, 그렇겠지… 후우…"
 },
 {
  "key": "m70",
  "kind": 5,
  "chr": -1,
  "jh": "dd90b5633120",
  "ko": "누구와 짝을 짓겠습니까?"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "d38243531462",
  "ko": "아가씨와 짝짓기"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "27e3752bf01f",
  "ko": "푸니요와 짝짓기"
 },
 {
  "key": "g0s2",
  "kind": "sel",
  "jh": "c52a27bd1e8b",
  "ko": "에토와 짝짓기"
 },
 {
  "key": "g0s3",
  "kind": "sel",
  "jh": "0549249bf78c",
  "ko": "윤과 짝짓기"
 }
]