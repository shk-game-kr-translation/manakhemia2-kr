 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 28,
  "jh": "98f11854dc58",
  "ko": "아~ 그, 그런 사적인 질문엔 대답할 수 없어요…"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 28,
  "jh": "d4469e189752",
  "ko": "그러니까, 무슨 얘기 하고 있었더라…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 28,
  "jh": "9991607bd5a2",
  "ko": "맞다, 바로 탐색학의 기본인 「채취」를 해 봤으면 하는데"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 28,
  "jh": "792709290b22",
