 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 89,
  "jh": "09baca2265db",
  "ko": "쭈뼛거리는 게 왠지 귀여울지도…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 87,
  "jh": "ce8e7fb07e91",
  "ko": "어? 너 저런 게 취향이야?"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 28,
  "jh": "06cddf26364c",
  "ko": "아, 저기. 수업 중엔 잡담하지 말아 줘. 그래서, 그러니까…"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 28,
  "jh": "cecb712cb993",
  "ko": "탐색학이란 간단히 말하면 그 땅을 돌아다니며 조사하는 거예요"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 28,
  "jh": "b09300027509",
