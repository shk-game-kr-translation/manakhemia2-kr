 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 28,
  "jh": "332c9e7ceb32",
  "ko": "오늘은 배움의 다리에 있는 채취지 중, 그러니까… 4곳에서 재료를 캐 왔으면 해요"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 28,
  "jh": "bc847df47031",
  "ko": "채취지 위치는 지도를 보면 알 수 있게 돼 있어요"
 },
 {
  "key": "m20",
