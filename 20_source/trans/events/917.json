 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 28,
  "jh": "dd16b709428f",
  "ko": "그런 의미에선 수수하지만 아주 중요한 수업이에요… 아마"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 87,
  "jh": "8b665c928bcb",
  "ko": "네~ 질문. 선생님 여자친구 있어요?"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 28,
  "jh": "78d9ee3c9abd",
