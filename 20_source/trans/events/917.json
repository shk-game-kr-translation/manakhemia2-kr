 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "8eafc8443d67",
  "ko": "배움의 다리에서 아이템 채취라… 배움의 다리가 어디였더라?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
