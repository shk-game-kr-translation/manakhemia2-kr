[
 {
  "key": "m0",
  "kind": 2,
  "chr": 0,
  "jh": "826515f533d4",
  "ko": "아가씨, 병문안 왔어요"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "aa3657a649f8",
  "ko": "반쯤 협박당해서 억지로 오게 됐어요. 들어가도 될까요?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 23,
  "jh": "9bbb1bd109b6",
  "ko": "그렇게 대놓고 비꼬지 않아도… 라며 여동생이 입을 삐죽이고 있어요"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 11,
  "jh": "c6b703bedf8c",
  "ko": "대답이 없네요"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "c5441132d720",
  "ko": "자는 건지 쓰러진 건지… 일단 돌아가도 되냐?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 11,
  "jh": "82929bbaac80",
  "ko": "자자. 상태 보고 올 테니까 잠깐 기다려 주세요"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 11,
  "jh": "118a18f933c9",
  "ko": "민망한 차림으로 주무시고 계실지도 모르니까요"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 3,
  "jh": "d8dae51385d6",
  "ko": "아아… 역시 좋아…"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 3,
  "jh": "c5932446457a",
  "ko": "온몸이 말랑말랑… 설령 백 마리의 푸니푸니에 둘러싸여도 이 감각은 못 느껴…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 11,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 3,
  "jh": "38413b28defc",
  "ko": "아아, 점프할 때마다 온몸이 떨려! 이 얼마나 쾌감인지…!"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 11,
  "jh": "4cd32aa3a972",
  "ko": "저… 아가씨…?"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 3,
  "jh": "5590ff801110",
  "ko": "어?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 11,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 11,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "92e357c7ade8",
  "ko": "꺄아아아아! 왜, 왜 있어!? 언제부터!? 노크 정도는 해!!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 11,
  "jh": "a7b262111421",
  "ko": "여러 번 했는데요… 정신이 팔려서 못 들으셨군요"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "de080f0ef9ec",
  "ko": "으, 윽…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 11,
  "jh": "ef03245eacb3",
  "ko": "이상하다 했어요. 아가씨가 푸니푸니가 된 정도로 풀 죽다니"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "4a708cd557c2",
  "ko": "시, 시끄러워! 아무튼 이건 로제한텐 절대 비밀…"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 0,
  "jh": "5185f13ce54c",
  "ko": "아~ 죄송해요… 똑똑히 봤어요"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 3,
  "jh": "b135b9b7c3bd",
  "ko": "아… 싫어어어어! 보, 보면 안 돼! 지금 아무것도 안 입었단 말이야~!!"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 11,
  "jh": "a0c7b41aab6e",
  "ko": "푸니푸니 모습이면 상관없잖아요… 정말, 지난번엔 그렇게 난리 쳤으면서"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 3,
  "jh": "6b11b0f1c990",
  "ko": "그, 그치만… 언제든 돌아갈 수 있다는 걸 알고 나니 그만…"
 },
 {
  "key": "m26",
  "kind": 5,
  "chr": 2,
  "jh": "74b60f9d5c26",
  "ko": "거기서 안타까운 소식입니다…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "49d6571c0433",
  "ko": "으악! 너, 왜 여기에…?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 2,
  "jh": "22d8da3defdb",
  "ko": "깜박하고 말 안 한 게 있어서 주의 주러 왔어…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 3,
  "jh": "6d4c0c5782bc",
  "ko": "주의?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 2,
  "jh": "57106a860e57",
  "ko": "그 주술 말인데… 세 번 이상 하면 원래대로 못 돌아오나 봐…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 3,
  "jh": "03332827593b",
  "ko": "세, 번…?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 2,
  "jh": "4ff6483f20ef",
  "ko": "응, 세 번…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 11,
  "jh": "baebe6e04e5b",
  "ko": "혹시 몰라서 여쭙는데요… 아직 두 번째죠?"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 3,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 11,
  "jh": "d9746b4b6c7a",
  "ko": "설마…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 3,
  "jh": "70a80b98bcec",
  "ko": "시… 시… 싫어어어어어어!!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 2,
  "jh": "aef25c90dd7d",
  "ko": "늦었다… 뭐, 푸니푸니로 사는 것도 나쁘지 않을 거야…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 3,
  "jh": "3ca13e4841ba",
  "ko": "싫어! 싫다고! 푸니푸니는 어디까지나 취미인걸! 삶의 방식으로 삼고 싶진 않아!!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 3,
  "jh": "efa2914c54ec",
  "ko": "있잖아, 농담이지!? 날 놀래키려는 거지? 그렇지!!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 2,
  "jh": "6c4ddb2fc462",
  "ko": "…진심으로 애도를 표합니다"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 3,
  "jh": "eab8c414f3e6",
  "ko": "아아아아아아아아!!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 11,
  "jh": "7a8de06eca5e",
  "ko": "그럼 이제 아가씨는…"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 0,
  "jh": "1a83e3e9aa46",
  "ko": "화를 내야 할지 어이없어해야 할지…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "64b421d17a3d",
  "ko": "으으으… 이제 됐어, 이제 됐어. 난 푸니푸니로 살아갈 거야…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 3,
  "jh": "4f8b7977383c",
  "ko": "울음소리도 연습해야지… 푸니이, 푸니이이~"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 5,
  "jh": "ee00abd1cc2f",
  "ko": "푸니!"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 23,
  "jh": "c9466c2e48bf",
  "ko": "발음이 나쁘다! 그래선 상대 마음에 닿지 않아! 라며 여동생이 꾸짖고 있어요"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 3,
  "jh": "57c4debce4d2",
  "ko": "푸니이이~…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 11,
  "jh": "80726c14bdc1",
  "ko": "아가씨… 가엾어라…"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 0,
  "jh": "a43050b09249",
  "ko": "…이봐, 정말로 이제 어떻게 할 수 없는 거냐?"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 2,
  "jh": "4e4bd1efffe0",
  "ko": "…다른 주술로 상쇄하면 어쩌면…"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 0,
  "jh": "e97240f5b47a",
  "ko": "있으면 빨리 말해"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 2,
  "jh": "22020a131228",
  "ko": "보고 있으니 재밌어서 그만…"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 2,
  "jh": "0f2218762ee5",
  "ko": "다만 해 본 적 없는 주술이라 성공할지 어떨지…"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 3,
  "jh": "5ecd65124a3d",
  "ko": "푸니이~, 푸니니이~!"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 11,
  "jh": "80a5e48af498",
  "ko": "아가씨, 거기선 제대로 말해 주세요"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 3,
  "jh": "5a5087773847",
  "ko": "그 방법밖에 없다면… 해 볼게! 부탁해, 클로에 씨!"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 2,
  "jh": "408ab7fdc109",
  "ko": "…개인적인 취향을 말하자면 이대로가 형편이 좋은데"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 3,
  "jh": "87a2e42fe65b",
  "ko": "잠깐!!"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 2,
  "jh": "cd1af37aa594",
  "ko": "농담… 할 수 있는 데까진 해 볼게"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 11,
  "jh": "06e36a6ab7d1",
  "ko": "부탁드려요… 저도 푸니푸니를 모시는 건 괴로우니까요"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 2,
  "jh": "9faa239ae786",
  "ko": "준비해 둘 테니까 재료를 캐 왔으면 해…"
 },
