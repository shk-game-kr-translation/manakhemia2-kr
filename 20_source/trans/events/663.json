[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "0e15e6fbd7e6",
  "ko": "그런 이유니까 정체를 보여 줘"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 9,
  "jh": "7a12cd1d3322",
  "ko": "뭐야, 느닷없이"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "e2efbc03b53e",
  "ko": "말한 대로야. 네 탈인형 속을 보여 줘. 지금 당장. 자!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 9,
  "jh": "c5938d7f20ed",
  "ko": "그건 이 자리에서 벗으라는 건가? 대담하군"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "823e4ef82ead",
  "ko": "아, 아니야! 탈인형을 벗으면 된다고, 탈인형을!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 9,
  "jh": "b9e936456679",
  "ko": "같은 거야. 탈인형 밑은 실오라기 하나 안 걸친 태어난 그대로의 모습이니까"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 2,
  "jh": "ea0acc66b134",
  "ko": "알몸으로 입고 있었구나… 울리카도 참, 천박해…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "b6fd88894d05",
  "ko": "아니라니까! 알몸 같은 건 아무래도 좋아! 정체를 보이라고 하는 거야!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 9,
  "jh": "0bcf86211b72",
  "ko": "모르는군. 남자는 조금은 미스터리한 편이 매력적이잖아?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "4034a0ef2b86",
  "ko": "넌 조금이 아니잖아. 자, 됐으니까 벗어"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 9,
  "jh": "6c963d2e8215",
  "ko": "이런이런. 이대로면 홀랑 벗겨지겠군… 페페론, 뒤는 맡겼다!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 6,
  "jh": "b7db985cdb7c",
  "ko": "맡겨 줘!"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 1,
  "jh": "f335e8ef85e7",
  "ko": "앗, 기다려! 페페론, 방해하지 마!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 6,
  "jh": "caa6226fd3ea",
  "ko": "안 돼, 누나. 사람은 누구나 알려지고 싶지 않은 게 있는 거야?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "bd69db86aa8d",
  "ko": "음, 페페론 주제에 옳은 말을. 그야 넌 속을 아니까 괜찮겠지만"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 6,
  "jh": "67f0e636a04f",
  "ko": "아니. 이 몸도 몰라?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 8,
  "jh": "34e3b81e9b9c",
  "ko": "어? 그래?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 6,
  "jh": "4247c8f399df",
  "ko": "처음 만났을 땐 너구리 차림이었고, 다음에 만났을 땐 펭귄이었고…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 2,
  "jh": "422c58b48566",
  "ko": "그건 그거대로 좀 보고 싶어…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "450fadf3f35c",
  "ko": "넌 알고 싶지 않아? 고토의 맨얼굴"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 6,
  "jh": "70a6e04dc155",
  "ko": "음~… 조금 궁금해진 것 같기도…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "7c64f90aead1",
  "ko": "맨얼굴도 모른다면 절친이라고 할 수 없지…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 6,
  "jh": "719763a7a05e",
  "ko": "읏! 그, 그래도…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "ae34cf313c58",
  "ko": "숨기는 게 좀 있어도 맨얼굴조차 안 보여 주다니…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 6,
  "jh": "8baeaeb549f9",
  "ko": "음… 으으으…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "e44bec63c539",
  "ko": "사실 절친이라고 생각하는 건 요정 씨 쪽뿐이었다거나…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 6,
  "jh": "9dc3bcba161a",
  "ko": "으, 으, 으아아아아아!! 그랬던 거구나아아아!!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 8,
  "jh": "7b6034eb6aa0",
  "ko": "이럴 때 그 누나 말은 강력하네"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "4d1aef188fb4",
  "ko": "응. 지금만큼 클로에가 든든해 보인 적은 없어"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "146503c3bb31",
  "ko": "좋아… 알았어! 이 몸도 협력할게!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 2,
  "jh": "6987e71985ea",
  "ko": "알아줘서 기뻐… 우후후후후…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "be5974881d96",
  "ko": "좋아, 그럼 바로 작전 회의야. 반드시 정체를 폭로해 줄 거야!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]