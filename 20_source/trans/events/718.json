[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "32fa9af35d7f",
  "ko": "아, 페페론. 잠깐 도와줬으면 하는데 괜찮아?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 6,
  "jh": "2a124cd691ef",
  "ko": "어? 아, 응…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "4a2f25a868d7",
  "ko": "뭐야, 그 얼굴. 돕기 싫어?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 6,
  "jh": "f8793c5e0872",
  "ko": "그, 그런 게 아니라, 그게…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "1c8ce8044c4e",
  "ko": "뭘 쭈뼛거려. 할 말 있으면 똑바로 말해"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 6,
  "jh": "734a9e98289d",
  "ko": "실은, 그… 옷이 꽉 끼게 돼서 부끄러워…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "773559e54e23",
  "ko": "옷이? 빨래해서 줄었어?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "fd729f63742a",
  "ko": "그럴 리가 없어. 최근 반년은 빨래 안 했으니까"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "c9ad02195ee2",
  "ko": "으악! 더러워! 잠깐, 더 다가오지 마"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "d4759958b9eb",
  "ko": "그, 그런! 상처받은 이 몸한테 너무 잔인한 말!!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 6,
  "jh": "615d213118cc",
  "ko": "그래도 왜 옷이 작아졌을까…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 9,
  "jh": "95554c63bb38",
  "ko": "하하하, 그런 건 생각할 것도 없잖아"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 9,
  "jh": "ea0a1899fdd0",
  "ko": "옷이 줄어든 게 아니라 네가 커진 거야"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 6,
  "jh": "c0cad3d203de",
  "ko": "아, 아아! 그렇구나!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 6,
  "jh": "3686a189690e",
  "ko": "모르는 사이에 더 파워풀해졌구나, 이 몸은!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 9,
  "jh": "a1d2ebf0133a",
  "ko": "넌 아직 성장기니까. 먹고 자고 특훈을 거듭하면 아직 더 커질 거야"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 6,
  "jh": "6d7066b0f391",
  "ko": "그럼 큰 옷을 다시 만들어야겠네. 도와줄래?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 9,
  "jh": "e0a5e8d464ca",
  "ko": "물론이지. 네 피부를 감싸는 옷… 내가 안 만들면 누가 만들겠어"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 6,
  "jh": "d82a28199cb6",
  "ko": "너라면 그렇게 말해 줄 줄 알았어. 그럼 바로 가자!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 8,
  "jh": "21c92a033c6f",
  "ko": "…저 녀석, 더 커지는 거냐?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 2,
  "jh": "8baf150770db",
  "ko": "…그렇지 않아도 쓸데없이 커서 방해되는데…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "bb0f3d59edb9",
  "ko": "응… 앗! 내 일 돕는 거 빼먹었어. 이놈, 돌아와~!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
