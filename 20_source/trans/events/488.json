 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "20959805b850",
  "ko": "응, 상관없어. 그러려고 부른 거니까"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 2,
  "jh": "45dfe886417d",
  "ko": "그럼 말할게… 까놓고 말해서 남자가 보는 건 얼굴이랑 몸뿐이라고 생각해…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 3,
  "jh": "7ee68f135c96",
