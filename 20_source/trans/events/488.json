 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 3,
  "jh": "c820cafe7cd1",
  "ko": "큭…! 너, 너도 나랑 별 차이 없잖아!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 2,
  "jh": "2bd4f2a79cb1",
