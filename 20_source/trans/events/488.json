 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 2,
  "jh": "013d533d56ad",
  "ko": "…못 믿겠으면 딱히 상관없지만"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "31c04b5b63b5",
