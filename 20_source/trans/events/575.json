[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "be106f59884c",
  "ko": "결국 끌려왔네… 그래서, 뭘 시킬 건데?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 30,
  "jh": "cedba63dabdd",
  "ko": "뻔하잖냐. 우선 맨손으로 곰을 쓰러뜨리고 와"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 6,
  "jh": "b7a06d599b2e",
  "ko": "하하하! 식은 죽 먹기지!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "e1e5c559889b",
  "ko": "무리! 절대 무리!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 30,
  "jh": "132aa3c33610",
  "ko": "뭐야. 요즘 젊은 인간은 곰도 못 쓰러뜨리냐"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "5e9d63cf3e9a",
  "ko": "요즘이 아니어도 무리거든! 애초에 곰이랑 요정 씨 수행이랑 상관없잖아!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 30,
  "jh": "57df2f2a2374",
  "ko": "무슨 소리냐. 곰과 맨손으로 싸워서 마음을 칼날처럼 갈고닦는 거 아니냐"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "60c5adf58eb1",
  "ko": "이 몸 정도 되면 맨손은커녕 알몸으로 곰과 싸울 수 있지만"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "57ee9c2e7885",
  "ko": "알몸은 상관없어! 애초에 그런 수행을 하니까 쓸데없이 힘이 붙어서 물건을 부수는 거야!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 30,
  "jh": "616987ac54f9",
  "ko": "음, 그건 일리가 있군… 생각지도 못한 맹점이었다"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 6,
  "jh": "b207d73d8abd",
  "ko": "어, 어떡하지. 이 몸의 존재 이유가 전부 부정당했어…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 30,
  "jh": "aa44840fde54",
  "ko": "바보 자식! 요정 씨라면 항상 밝음을 잊지 마라!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 6,
  "jh": "fd90049714fd",
  "ko": "으, 응… 그래도 다른 수행 같은 거 이 몸은 전혀 생각이 안 나…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 30,
  "jh": "ded38e7083ff",
  "ko": "아아, 도무지 짐작도 안 간다… 젠장, 처음부터 막히다니!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "474c7736daa9",
  "ko": "페페론뿐만 아니라 스승 쪽도 꽤 문제가 있는 것 같네…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 30,
  "jh": "0ee233a34cdc",
  "ko": "뭐라고! 그럼 당신은 뭔가 아이디어가 있다는 거냐?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "886cf3e33364",
  "ko": "어, 갑자기 그래도… 글쎄, 요정 씨 일이라면 보통 조합 돕기랑…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 30,
  "jh": "8648db9e3818",
  "ko": "맨손으로 곰을 쓰러뜨리고 오는 거지"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "e35e8fe8c172",
  "ko": "곰에서 좀 벗어나! 보통은 조합 돕기랑 재료 캐 오는 거잖아!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 30,
  "jh": "856285915974",
  "ko": "재료 캐기라고? 어이어이, 페페론. 우리 요정 씨도 무시당했구나"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 6,
  "jh": "adaf24cb1182",
  "ko": "정말이야. 재료 캐기라니, 세 살짜리 애도 아니고"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "8be7338da978",
  "ko": "우와, 열받아… 그렇게까지 말하는 걸 보니 꽤 자신 있나 보네"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 6,
  "jh": "ace92524c916",
  "ko": "호오, 그건 이 몸에 대한 도전이구나?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "73e0eb2432e1",
  "ko": "왜 그렇게 해석하는 건데!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 30,
  "jh": "7ec0ed40406a",
  "ko": "심판은 내가 맡아 주마. 제한 시간 안에 재료를 더 많이 캐 온 쪽이 이기는 거다"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "90c76fc9d02f",
  "ko": "뭘 척척 진행하고 있는 거야!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 6,
  "jh": "619bc9fda034",
  "ko": "하하하. 누나라고 봐주지 않을 거야"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "1d6c871c3ab1",
  "ko": "큭, 완전히 저쪽 페이스에… 알았어! 하면 되잖아! 하면!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]