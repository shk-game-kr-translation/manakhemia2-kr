 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "e071f248702f",
  "ko": "음~ 왠지 구슬려진 것 같은 기분도 드는데"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "b182646e54d7",
