  "kind": 2,
  "chr": 1,
  "jh": "6c157a8a4aac",
  "ko": "늦어! 이러는 동안에도 우류는… 자, 얼른 출발하자!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 9,
  "jh": "9c7e3af95425",
