 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "a916d914f605",
  "ko": "뭐야! 아직도 뭐가 있어!?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 9,
  "jh": "b314d46f6066",
  "ko": "그렇게 화난 얼굴로 우류 앞에 가면 그 애 또 울어 버릴 거야?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "6d4a9bcea0e2",
