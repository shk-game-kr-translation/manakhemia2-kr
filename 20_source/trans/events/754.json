  "kind": 0,
  "chr": 28,
  "jh": "cecb712cb993",
  "ko": "탐색학이란 간단히 말하면 그 땅을 돌아다니며 조사하는 거예요"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 28,
  "jh": "442b13a47f33",
