  "kind": 0,
  "chr": 28,
  "jh": "5a682d6a1ea0",
  "ko": "몬스터 퇴치업자가 됐을 때 알아 두면 편리할지도 몰라요"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 106,
  "jh": "e462032beb39",
