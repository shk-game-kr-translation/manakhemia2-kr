 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 28,
  "jh": "b72002879187",
  "ko": "아아아, 싸우면 안 돼, 싸우면…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 28,
  "jh": "4d397b48c6a1",
  "ko": "그러니까, 그럼 바로 탐색학의 기본인 「채취」를 해 봤으면 하는데"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 28,
  "jh": "792709290b22",
