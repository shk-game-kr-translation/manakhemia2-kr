[
 {
  "key": "m0",
  "kind": 2,
  "chr": 7,
  "jh": "b7bc158a963e",
  "ko": "선생님, 다녀왔어~!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 28,
  "jh": "6054902fddbb",
  "ko": "으악! 어, 어서 와… 빠, 빨랐네?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 7,
  "jh": "725d992438bf",
  "ko": "그렇게 놀라지 않아도 되는데. 상처받네~"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 28,
  "jh": "584bd183aeb9",
  "ko": "에에? 미, 미안. 그럴 생각은…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 0,
  "jh": "fb728421b04e",
  "ko": "일일이 이 녀석 상대 안 하셔도 돼요"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 28,
  "jh": "a0da227f1bed",
  "ko": "아, 그래? 후우, 요즘 젊은 애들은 무슨 생각을 하는지 도통…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 0,
  "jh": "24e05abb1680",
  "ko": "그렇게 심각하게 생각 안 하셔도…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 28,
  "jh": "e7555aabe5f0",
  "ko": "아아아, 상관없는 얘기를 했네. 자, 이번 과제 평가인데…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 28,
  "jh": "671d86131917",
  "ko": "이건 또… 꽤 많이 모았네. 응, 대단해. 훌륭해"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 7,
  "jh": "76ceef996bfb",
  "ko": "에헤헤~ 몬스터 잔뜩 쓰러뜨렸으니까!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 0,
  "jh": "d7ddf4e8eab3",
  "ko": "…뭐, 너한테 맞는 과제였을지도. 목적은 달랐지만"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 28,
  "jh": "d98f0bcd5523",
  "ko": "학생이 이렇게 열심히 하니까 나도 열심히 해야겠네…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 28,
  "jh": "1cb6695c0a1c",
  "ko": "아, 맞다. 평가 도장 찍어야지. 그럼 수고했어"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 28,
  "jh": "a1ac8efddd21",
  "ko": "응, 꽤 괜찮네. 조금만 더 모아 왔으면 만점을 줄 수 있었는데…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 7,
  "jh": "765082b2abb3",
  "ko": "에에? 이걸론 부족했어?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 28,
  "jh": "a1c742b278f1",
  "ko": "정말 조금만 더였는데…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "a0a118e5e061",
  "ko": "너무 일찍 끝냈나… 실패했군"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 28,
  "jh": "e91a423d6d96",
  "ko": "아, 그래도 신경 쓸 정도는 아니야. 다만… 다음엔 좀 더 힘내"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 28,
  "jh": "2e74bd9a8fd5",
  "ko": "음~… 보통이네. 좋게도 나쁘게도"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "da3618e3294f",
  "ko": "보통, 인가요"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 28,
  "jh": "08375d4117a4",
  "ko": "응, 그래서 보통 평가밖에 못 주는데…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 7,
  "jh": "8ffc0cc89502",
  "ko": "에에~! 그런~!!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 28,
  "jh": "0bb2a7c70c04",
  "ko": "와, 미안! 소리 지르지 마!!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 7,
  "jh": "61ca38722f25",
  "ko": "어, 딱히 소리 안 질렀는데…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 28,
  "jh": "231da8d975bc",
  "ko": "아무튼 이번 평가는 가로… 다음엔 더 힘내"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 28,
  "jh": "b8635fd305bd",
  "ko": "아무래도 이래선 평가를 줄 수 없겠네…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 0,
  "jh": "e05152a946e3",
  "ko": "아아, 역시…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 28,
  "jh": "6c186ed6f092",
  "ko": "역시라니, 알면서 보고하러 온 거야? 그, 그런…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 0,
  "jh": "991e3293cb6a",
  "ko": "아니, 방금 건 그런 뜻이 아니라…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 28,
  "jh": "95c3cacd38ee",
  "ko": "그렇지, 내 수업 같은 건 성실하게 듣고 싶지 않겠지. 하아아…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 7,
  "jh": "3355d0a00eb8",
  "ko": "아~아, 풀 죽었다. 로제가 괴롭히니까"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 0,
  "jh": "c381bb198d7c",
