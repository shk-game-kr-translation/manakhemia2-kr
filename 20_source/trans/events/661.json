[
 {
  "key": "m0",
  "kind": 2,
  "chr": 8,
  "jh": "de7af41b7362",
  "ko": "…있잖아, 작전 마지막 부분 아직 못 들었지"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 9,
  "jh": "347c8ea4682c",
  "ko": "응. 안 알려 주는 편이 즐거움이 늘 것 같아서"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 8,
  "jh": "37aa14a30145",
  "ko": "이런 인적 없는 데로 유인해서 뭘 하려는 거야?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 9,
  "jh": "c0c05283ec0b",
  "ko": "이상한 걸 묻는군. 사람 눈은 적은 편이 좋은 게 당연하잖아"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 8,
  "jh": "3f6fb5b9eb73",
  "ko": "그러니까 그 사람 눈이 적은 데서 뭘 하냐고 묻는 거야!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 9,
  "jh": "32d1592c9fac",
  "ko": "그렇지. 순서대로 설명하자면…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 9,
  "jh": "f2ebf883a31c",
  "ko": "날 발견한 경찰은 머리에 피가 솟아서 돌진해 오겠지"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 9,
  "jh": "5cfd94342aec",
  "ko": "거기서 살짝 몸을 피하고, 그다음 등을 가볍게 밀면 THE END야"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 8,
  "jh": "2ca923c79ab7",
  "ko": "야! 완벽한 범죄잖아!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 9,
  "jh": "2c8879c7c52f",
  "ko": "괜찮아, 아래서 페페론이 받아 줄 거니까. 아마 기절하는 정도로 끝날 거야"
 },
 {
  "key": "m10",
  "kind": 5,
  "chr": 6,
  "jh": "fc75b4af0fc4",
  "ko": "하하하. 이 몸한테 맡기면 완벽해!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 8,
  "jh": "10076377110c",
  "ko": "기절시키기만 할 거면 이렇게까지 공들일 필요 없잖아"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 9,
  "jh": "a20d9a37d165",
  "ko": "강한 공포를 줘 두면 쉬워지거든… 기억을 만지는 게"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 8,
  "jh": "73883bb5ad16",
  "ko": "뭐? 야, 방금 슬쩍 엄청난 소리 하지 않았냐?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 9,
  "jh": "ac41e8cc066a",
  "ko": "자자, 무슨 소린지…"
 },
 {
  "key": "m15",
  "kind": 5,
  "chr": 63,
  "jh": "4fe67c44efc4",
  "ko": "꽤 걸었는데 아직 안 도착했어?"
 },
 {
  "key": "m16",
  "kind": 5,
  "chr": 1,
  "jh": "e00f9a67136b",
  "ko": "조금만 더. 봐, 그 앞 트인 곳에서…"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 9,
  "jh": "f61bc1e15ae7",
  "ko": "이런, 온 것 같군. 자, 넌 숨어"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 8,
  "jh": "6e5d234611b4",
  "ko": "…어떻게 되든 난 모른다"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 63,
  "jh": "ab3aad8d6788",
  "ko": "아아! 네놈! 드디어… 드디어 찾았다!"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 9,
  "jh": "3330da92d4a2",
  "ko": "응? 어디서 만났었나? 미안하지만 남자 얼굴은 안 외우는 주의라서"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 63,
  "jh": "88d659709fb3",
  "ko": "네놈이 기억 못 해도 난 평생 안 잊는다… 얌전히 포박받아라!"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 9,
  "jh": "2a8953d3188c",
  "ko": "이런, 그렇게 달리면… 위험해"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 63,
  "jh": "c3d0d6961a9c",
  "ko": "어? 어라…? 으, 으아아아아!"
 },
 {
  "key": "m24",
  "kind": 5,
  "chr": 63,
  "jh": "d1ed8312af14",
  "ko": "구호옥!!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 8,
  "jh": "6936d90bf147",
  "ko": "어, 야! 위험한 소리 나지 않았냐…?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "d5ea8401071b",
  "ko": "괜찮은 거겠지…?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 9,
  "jh": "5e2529e9d0bf",
  "ko": "아~ 어떨까… 어이~ 페페론?"
 },
 {
  "key": "m28",
  "kind": 5,
  "chr": 6,
  "jh": "61f2e20398bc",
  "ko": "아, 으… 괘, 괜찮아! 이 몸이 완벽하게 받았어!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 2,
  "jh": "952d5d3e52fc",
  "ko": "명백히 땅에 격돌한 소리였는데…"
 },
 {
  "key": "m30",
  "kind": 5,
  "chr": 64,
  "jh": "efc92ea12613",
  "ko": "아~ 으음… 그래… 이놈 고토 놈! 이 원한은 잊지 않겠다~!"
 },
 {
  "key": "m31",
  "kind": 5,
  "chr": 6,
  "jh": "da4acdd0d84f",
  "ko": "봐, 제대로 살아 있어!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "6a5d5ca606ad",
  "ko": "아무리 들어도 네 목소리잖아!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 9,
  "jh": "757880d7abf2",
  "ko": "이런이런. 쓸데없는 일이 늘었군. 서둘러 다녀올게"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "776284d8dda1",
  "ko": "나도 같이 갈게"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 9,
  "jh": "fd7904890336",
  "ko": "기다리는 게 좋아. 여자애가 볼 만한 게 아닐 가능성도 있으니까"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 1,
  "jh": "6b10bd0cc937",
  "ko": "으… 그럼 관둘게. 너한테 할 말이 있을 뿐이니까"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 9,
  "jh": "73eb2b802f18",
  "ko": "나한테? 음~ 마음은 기쁘지만 좀 더 때와 장소를 가려 주면…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 1,
  "jh": "65394b922f41",
  "ko": "얼버무리지 마. 그 사람한테 얘기 들었어. 아무리 들어도 네가 잘못했지?"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 9,
  "jh": "03407d0823ea",
  "ko": "…그렇지. 그에겐 미안한 짓을 했다고 생각해"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 9,
  "jh": "89896c2222b6",
  "ko": "하지만 지금은 잡힐 수 없어. 페페론한테 널 부탁받았거든"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 1,
  "jh": "9f174f93043f",
  "ko": "나를…?"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 9,
  "jh": "a7c18df107d2",
  "ko": "더는 비밀이야. 자, 서두르지 않으면 그가 과다 출혈로 큰일 나겠군"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 1,
  "jh": "48583e3fea36",
  "ko": "앗, 기다려! 지금은이라는 건 언젠간 잡혀도 된다는 거야?"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 9,
  "jh": "66094bcbfdb6",
  "ko": "음~ 내가 잡히면 전 세계 여성이 슬퍼할 테니까…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 1,
  "jh": "dc04bd6c8ce5",
  "ko": "역시 전혀 반성 안 하잖아. 앗, 이놈! 기다려!"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 1,
  "jh": "2a2b8b378980",
  "ko": "정말… 뭐야. 그런 식으로 말하면 신경 쓰이잖아…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]