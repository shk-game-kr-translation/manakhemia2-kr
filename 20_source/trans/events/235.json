[
 {
  "key": "m0",
  "kind": 2,
  "chr": 6,
  "jh": "c5534e971a75",
  "ko": "아, 이 몸들은 밖에서 기다릴게"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 9,
  "jh": "26c8b133cd3c",
  "ko": "그렇지. 외부인이 선생님들 앞에 너무 얼굴을 내미는 건 좋지 않으니까"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "35354d604905",
  "ko": "이제 와서 뭘 사양해? 교장 선생님 방엔 그냥 들어왔잖아"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 9,
  "jh": "95718bfbc63f",
  "ko": "후… 좋은 남자란 과거에 얽매이지 않는 법이지"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "307f0bdf5670",
  "ko": "왠지 수상하네… 뭐 됐어, 얌전히 기다려"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 20,
  "jh": "955e6b303f5b",
  "ko": "응? 뭐냐 너희, 쉬는 날까지"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 2,
  "jh": "03642f08f6e9",
  "ko": "아… 군나르 선생님이 있어…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 12,
  "jh": "26b44fcb0d44",
  "ko": "특별 수업 아이디어를 찾고 있다. 이 녀석 방엔 악취미스러운 책이 잔뜩 있거든"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 20,
  "jh": "8602820787a1",
  "ko": "누가 악취미냐. 덥고 답답하니까 빨리 나가"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 12,
  "jh": "02d820d2cade",
  "ko": "음, 이 군대물 얘기는 괜찮아 보이는군…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 20,
  "jh": "d526dbb579e2",
  "ko": "아아, 그거. 악마 교관이 맛깔나지"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 20,
  "jh": "59a27450266b",
  "ko": "그래서, 너흰 뭐 하러 왔냐?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "56c898b1b920",
  "ko": "아, 맞다 맞다…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 20,
  "jh": "ae22d2ece538",
  "ko": "마나 특훈이라… 또 즉흥적으로 이상한 걸 시작하기는…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "50c467419e84",
  "ko": "즉흥 아니에요! 곰곰이 숙고한 끝에…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 2,
  "jh": "c1aec3d9dd53",
  "ko": "…토니 선생님한테까지 다 들키다니 울리카는 엄청 단순하구나…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 20,
  "jh": "cd53047ded78",
  "ko": "그건 울리카를 바보 취급하는 거냐? 아니면 날 바보 취급하는 거냐?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 12,
  "jh": "f36c0aa8f1a5",
  "ko": "뭐 좋지 않나. 특훈. 참으로 기분 좋은 울림이다"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "73117c68933c",
  "ko": "그쵸 그쵸! 그래서 어떻게 하면 될까요?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 12,
  "jh": "8278c232d368",
  "ko": "특훈이라 하면 산속 수행으로 정해져 있다. 그러니 산으로 가면 된다!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "c0c3ab367dec",
  "ko": "산에 가서 뭘요?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 12,
  "jh": "ebed206ad6a0",
  "ko": "모른다. 산에 가면 어떻게든 된다"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 2,
  "jh": "c904e75d88df",
  "ko": "너무 대충…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 20,
  "jh": "79afb58c15f9",
  "ko": "아아. 산에 갈 거면 겸사겸사 래디시 좀 캐 와라"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 20,
  "jh": "d8cfbb6ddff8",
  "ko": "방학 끝나고 수업에 쓸 거니까"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "3070c3ba825f",
  "ko": "아니. 우리 심부름 가는 거 아닌데…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 20,
  "jh": "91b91bc442c9",
  "ko": "좋잖아. 재료 캐는 것도 특훈의 하나다. 그럼 부탁한다"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "ec683852a11c",
  "ko": "왠지 이제 특훈이고 뭐고 아무래도 좋아졌어…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 2,
  "jh": "a867f17d1bdc",
  "ko": "원래 즉흥적인 행동이었으니까…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 8,
  "jh": "fe65058c971b",
  "ko": "안 갈 거면 난 간다. 재료 캐는 거 땡땡이쳐도 혼나는 건 누나고"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 2,
  "jh": "aa907e1b666f",
  "ko": "알았지? 토니 선생님한테 혼나면 울리카 명령이었다고 말하는 거야…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 5,
  "jh": "ee00abd1cc2f",
  "ko": "푸니!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "dc593d005cde",
  "ko": "뭘 불어넣는 거야! 안 돼, 연대 책임이니까! 다 같이 가자!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "b5231fa47160",
  "ko": "흥, 좋아! 원래 특훈할 생각이었으니까!"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 15,
  "jh": "481bb810eabf",
  "ko": "학교 밖으로 가는 모양이네… 드디어 기회 도래!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]