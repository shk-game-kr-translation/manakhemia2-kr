[
 {
  "key": "m0",
  "kind": 0,
  "chr": 18,
  "jh": "bcfdd5f9551d",
  "ko": "흠흠. 학부모 여러분, 바쁘신 와중에 와 주셔서 대단히 감사합니다"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 18,
  "jh": "5b4ff4ed32b0",
  "ko": "오늘은 저희 학교의 1년간 교육 성과를 보여 드리고자 이런 자리를 마련…"
 },
 {
  "key": "m2",
  "kind": 5,
  "chr": 12,
  "jh": "fe019b17fa1f",
  "ko": "시시한 서두는 거기까지다. 비켜라 비켜!"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 18,
  "jh": "d5d57bf10a28",
  "ko": "뭐, 뭐예요!? 지금 제가 인사를…"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 12,
  "jh": "80062a694329",
  "ko": "기뻐해라! 오늘도 네놈들을 위해 특별한 수업을 준비해 줬다"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 95,
  "jh": "83cb661a41b9",
  "ko": "으아… 또야…"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 106,
  "jh": "a83b7d082e40",
  "ko": "봐줘라. 아버지가 보러 왔다고…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 20,
  "jh": "c8f39ed497cc",
  "ko": "너무 멋대로 하게 두는 거 아냐?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 13,
  "jh": "6af5f021a051",
  "ko": "그렇게 말해도… 내가 말릴 수는 없잖아"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 20,
  "jh": "2bcc83c36da8",
  "ko": "이사장이 얌전해졌는데 이래서야 역효과로군"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 13,
  "jh": "4ff64a14fff4",
  "ko": "말씀하신 대로… 면목 없어"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 20,
  "jh": "ef1384bb48b3",
  "ko": "그래서, 특별 수업이란 건 이번엔 무슨 짓을 하는 거야?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 13,
  "jh": "105ba48b72a0",
  "ko": "나도 내용은 못 들었어. 기세로 허가해 버렸는데… 괜찮겠지?"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 20,
  "jh": "78375a6afe4e",
  "ko": "…어떻게 돼도 난 모른다"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 12,
  "jh": "fbfa55f827ad",
  "ko": "이것저것 생각했다만, 학부모 앞에서 너무 거친 수업도 좀 그런 것 같아서…"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 12,
  "jh": "213fcf02ce1f",
  "ko": "그래서 이번엔 이거다!"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 12,
  "jh": "83cacbc41728",
  "ko": "「거대 몬스터 습격!? 학생들이여 일어서라. 학원을 지키기 위해!!」"
 },
 {
  "key": "m17",
  "kind": 5,
  "chr": 39,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m18",
  "kind": 5,
  "chr": 40,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 12,
  "jh": "4de170260271",
  "ko": "그럼 수업 시작!!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "967ec36e8743",
  "ko": "자, 잠깐만! 그것만으로는 무슨 소린지 전혀 모르겠잖아!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 12,
  "jh": "193a409c3cae",
  "ko": "이해력이 부족한 녀석이군"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 12,
  "jh": "a7f46c116607",
  "ko": "즉, 이날을 위해 이 몸이 몬스터 한 마리를 준비했다는 거다"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 12,
  "jh": "f47f8e131369",
  "ko": "무시무시하게 튼튼한 녀석이라. 한두 번 싸운 정도로는 절대 쓰러뜨릴 수 없다"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 12,
  "jh": "c8f51f31fc4e",
  "ko": "그 녀석이 지금 학원을 향해 진격해 오고 있다. 멋지게 막으면 네놈들의 승리다"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 12,
  "jh": "41564182a3d1",
  "ko": "하지만 만약 실패하면 이 학원은 몬스터에 의해 파괴되고 만다…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 12,
  "jh": "a32950dc7cfa",
  "ko": "어떠냐? 꽤 스릴 있는 수업이지"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 18,
  "jh": "86a30594db8a",
  "ko": "뭐, 뭐… 무슨 바보 같은 짓을!! 중지예요! 당장 중지하세요!!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 12,
  "jh": "0856767beca5",
  "ko": "그게 튼튼하게 만든 만큼 머리가 좀 나빠져서 말이다. 전혀 제어가 안 된다"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 12,
  "jh": "e4ca6653f3f4",
  "ko": "녀석을 막으려면 쓰러뜨리는 수밖에 없다"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 18,
  "jh": "5c40ce59957a",
  "ko": "뭣… 그럼 만약 못 쓰러뜨리면…?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 12,
  "jh": "66275bf9e6ed",
  "ko": "몇 번이나 말하게 하지 마라. 이 학원이 파괴될 뿐이다"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 18,
  "jh": "434641bc4e3f",
  "ko": "으~음…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 13,
  "jh": "b3e6948a2085",
  "ko": "이사장님! 정신 차리세요!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 12,
  "jh": "5b263945391a",
  "ko": "자, 시간이 별로 없다. 녀석은 겨울 고요의 설산에서 이 학원으로 오고 있다!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 12,
  "jh": "25b56b58c284",
  "ko": "서둘러 현장으로 가서 몸을 던져 몬스터를 막고 오는 거다!!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 3,
  "jh": "a1336f63a5bd",
  "ko": "매번 매번 변변찮은 걸 생각해 내네"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 4,
  "jh": "c718979a5058",
  "ko": "개인적으로는 어느 정도의 적이 준비됐는지 흥미가 있다만"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 11,
  "jh": "43dae854c0b4",
  "ko": "자자, 아가씨. 내버려 두면 주인어른께도 위험이 미치니까요…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 7,
  "jh": "f78b06a8ab6d",
  "ko": "왠지 불타오른다~! 가자, 다들! 학원을 지키기 위해!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 5,
  "jh": "8632c07b5b98",
  "ko": "푸니! 푸니! 푸~!"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 0,
  "jh": "0ef292551176",
  "ko": "…가끔은 너희의 단순함이 부러워진다"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 0,
  "jh": "3e0d0db4c490",
  "ko": "학생 전원이 몬스터를 쓰러뜨린다라… 그럼 혼란을 틈타서…"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 3,
  "jh": "32bdcd18cc31",
  "ko": "왜 그래 로제? 빨리 와"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 0,
  "jh": "38bfba775ed5",
  "ko": "아, 죄송합니다… 잠깐, 무슨 생각을 하는 거야, 난. 미쳤군…"
 },
