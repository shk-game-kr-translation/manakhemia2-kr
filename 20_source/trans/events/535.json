[
 {
  "key": "m0",
  "kind": 0,
  "chr": 4,
  "jh": "d5e2a15efb2a",
  "ko": "잠깐 괜찮나?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "75e33150124f",
  "ko": "응? 애는 어쩌고?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 4,
  "jh": "0e8e2fb19599",
  "ko": "일단 돌려보냈다. 이틀 연속 재울 수는 없으니까"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 0,
  "jh": "1fc8f23423bd",
  "ko": "재우는 것쯤 상관없잖아. 천천히 얘기 들어 주면 좋았을 텐데"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 4,
  "jh": "66d7383a3a82",
  "ko": "게다가 나도 어떻게 대해야 할지 모르겠단 말이다!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 4,
  "jh": "e0a789a9d3a0",
  "ko": "당연히 미움받는 줄 알았는데, 갑자기 그런 말을 들어도"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 0,
  "jh": "1ec8e4ab1ac9",
  "ko": "그렇게 말했어? 그 애한테"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 4,
  "jh": "eef60ff9c9be",
  "ko": "아아. 그랬더니 그 녀석 쪽에서 시간을 좀 주겠다고"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 0,
  "jh": "1757a5403f39",
  "ko": "…누가 어른인지 모르겠군"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 4,
  "jh": "fe746bb64018",
  "ko": "말하지 마라. …그래서, 어떻게 하면 되지?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 0,
  "jh": "5bbf534ce14a",
  "ko": "나한테 묻지 마. 당신네 부녀 문제잖아"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 4,
  "jh": "c7a523c6d5f1",
  "ko": "절반은 네 탓이잖나!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "70ef15c398ec",
  "ko": "나한테 묻기 전에 당신은 어떻게 하고 싶은데"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 4,
  "jh": "c58ee11b6e76",
  "ko": "나, 난… 물론 당장이라도 돌아가고 싶지만, 마음의 준비가…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 4,
  "jh": "50c2c83d620d",
  "ko": "게다가 주인과의 계약도 아직 남아 있고"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 0,
  "jh": "49f27bf21539",
  "ko": "뭐랄까… 뭐, 딱 좋지 않아? 슬슬 계약도 끝날 거잖아"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "6cb5a1d72cc8",
  "ko": "그때까지 각오를 다져 두라고"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 4,
  "jh": "90a75aacfa9a",
  "ko": "각오, 라… 으음…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 0,
  "jh": "7e466757e61c",
  "ko": "자, 그럼 자 볼까. 당신 고민하는 얼굴 보고 있어 봤자 소용없고"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 4,
  "jh": "62aebe07d152",
  "ko": "기, 기다려! 조금은 상담 좀 해 줘! 이봐!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
