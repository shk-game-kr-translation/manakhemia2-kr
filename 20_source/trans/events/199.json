[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "64f00c7bf5f2",
  "ko": "선생님, 재료 캐 왔어요~!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 20,
  "jh": "d03034ab2a86",
  "ko": "늦어. 너희가 마지막이다. 고작 재료 모으는 데 몇 시간이나 걸리는 거냐"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "2ee8abfd2684",
  "ko": "자자, 연약한 여자애 둘이었다는 걸로 여기선 한 번 봐주시고!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 20,
  "jh": "dbdd42d49587",
  "ko": "여자를 핑계 삼지 마. …뭐 됐다. 그럼 냉큼 조합하고 와"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "aa74e3548cdf",
  "ko": "네? 그런데… 조합하는 법 같은 건 모르는데요…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 20,
  "jh": "125ed68cee07",
  "ko": "아~… 그러고 보니 그랬지. 할 수 없군, 가르쳐 줄까… 귀찮지만"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "1cc92961f240",
  "ko": "귀찮다니, 그게 일이잖아요…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 20,
  "jh": "b1b5359c9d81",
  "ko": "뭐, 조합이라고 해 봤자 그렇게 어려운 건 아니니까"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 20,
  "jh": "b8d542dd79d8",
  "ko": "일단 설명해 줄 테니 우선 해 봐라"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "e181772b50db",
  "ko": "와… 됐다! 됐어요, 선생님!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 20,
  "jh": "a69a17ba9b0f",
  "ko": "당연하지. 내가 가르쳐 준 거니까. 생각보다 간단하지?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "fd5735243945",
  "ko": "응, 이거라면 나 혼자서도 할 수 있겠어"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 20,
  "jh": "7ec836842a00",
  "ko": "너무 우쭐하지 마라"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 20,
  "jh": "fa22c4b03497",
  "ko": "리퓨얼 포트 따위 재료만 갖추면 꼬맹이도 만들어"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "a077ce05ce3e",
  "ko": "으… 그렇구나…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 2,
  "jh": "d2ccd4bbaf73",
  "ko": "그럼 이걸로 수업은 끝…?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 20,
  "jh": "583e1c24a2cc",
  "ko": "그래. 지금 도장 찍어 주마"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "3270930f9ed9",
  "ko": "좋~아! 드디어 끝났다! 생각보다 간단했어"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 20,
  "jh": "d7d4f2ba34c8",
  "ko": "간단한 건 처음뿐이다. 수업 내용은 점점 어려워질 거다"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 20,
  "jh": "f177bc8588a9",
  "ko": "학생과에서 받을 땐 내용을 잘 확인해라"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "14fce21e4da0",
  "ko": "학생과? 그게 뭐예요?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 20,
  "jh": "bad680e47a70",
  "ko": "아~ 그것도 설명 안 했나… 어쩔 수 없지, 따라와"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 20,
  "jh": "65134a13ce7d",
  "ko": "하아아… 귀찮다…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "3676655155ae",
  "ko": "그렇게 진심으로 말하지 않아도…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "1ad4c94cf588",
  "ko": "헤에~ 여기가 학생과…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 20,
  "jh": "73c25ec4afb6",
  "ko": "그래, 수업 접수는 여기서 한다. 잘 기억해 둬라"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 20,
  "jh": "14017e9a253f",
  "ko": "이걸로 더 설명할 건 없겠지… 그럼 난 간다"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "da76b54dfb39",
  "ko": "앗, 잠깐만요! 아직 선생님한테 물어볼 게!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 20,
  "jh": "48485c820e47",
  "ko": "응? 물어볼 거?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "65ca282921dc",
  "ko": "응. 이 돌 말인데…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 20,
  "jh": "7032d0492337",
  "ko": "이 돌이 왜?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "d258c3a85eac",
  "ko": "후훗훗. 숨길 것 없이 이 돌은… 마나의 알이에요!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 20,
  "jh": "c8169cc8388a",
  "ko": "하아… 그거 대단하네. 그럼"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "ed158c82aaf6",
  "ko": "아~! 그 태도는 뭐예요! 선생님, 안 믿죠!?"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 20,
  "jh": "66751bff819b",
  "ko": "당연하지. 마나가 돌에서 태어난다는 건 들어 본 적이 없다"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "c121d748308a",
  "ko": "그럼 뭐에서 태어나는데요?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 20,
  "jh": "6d2b1749b3a9",
  "ko": "그야 너… 모르지만"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 1,
  "jh": "b12f3850363c",
  "ko": "모르는구나… 선생님 주제에…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 20,
  "jh": "87da104c8096",
  "ko": "시, 시끄러워! 마나라는 건 수수께끼가 많아!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "f840ff2bf6b5",
  "ko": "으으… 그래도 이거 마법 같은 거 나와요? 쫘악! 하고"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 20,
  "jh": "0b07e3d95982",
  "ko": "잘됐네. 마법석으로선 조금은 가치가 있을지도 모르겠다"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 1,
  "jh": "c4fb2e0c6206",
  "ko": "그런… 아아, 그런…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 2,
  "jh": "77be7017bdd5",
  "ko": "일찍 알아서 다행이잖아…"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 1,
  "jh": "f0dd0119f350",
  "ko": "비싼 입학금까지 내고 왔는데… 그런…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 2,
  "jh": "27ddfa757e96",
  "ko": "그 돌 팔면 조금은 본전 뽑을 수 있어…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 1,
  "jh": "b2581448bbb3",
  "ko": "이게 진짜였다면, 마나였다면…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 1,
  "jh": "cf67fa420f0b",
  "ko": "난 대단한 연금술사가 돼서 떵떵거리며 살 수 있었는데에!"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 2,
  "jh": "4639aad29f37",
  "ko": "세상은 그렇게 만만하지 않아…"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 1,
  "jh": "94c1bf3d776a",
  "ko": "으으… 아니! 이건 절대 진짜야! 선생님이 틀린 거야!"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 2,
  "jh": "ad87b2352242",
  "ko": "포기를 모르네…"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 1,
  "jh": "8d547c817a21",
  "ko": "왜냐면 그 선생님, 머리 나빠 보이는 얼굴이었잖아!"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 2,
  "jh": "433f28700c49",
  "ko": "그건 부정할 수 없지만…"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 1,
  "jh": "ceeaf74712a6",
  "ko": "그치! 그렇게 생각하지! 그럼 결정. 선생님이 틀렸어. 응"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 2,
  "jh": "100e0ae8825d",
  "ko": "…알았어. 이제 아무 말 안 할게…"
 },
 {
  "key": "m54",
  "kind": 5,
  "chr": -1,
  "jh": "ff4c352af0d9",
  "ko": "앞으로의 {CLRE}과제{CLNR}는 이 {CLRE}학생과{CLNR}에서 선택하게 됩니다."
 },
 {
  "key": "m55",
  "kind": 5,
  "chr": -1,
  "jh": "e0862e8afccd",
  "ko": "과제를 받을 때는 {CLRE}오른쪽 {CLRE}카운터{CLNR}의 접수원에게 말을 거세요."
 },
 {
  "key": "m56",
  "kind": 5,
  "chr": -1,
  "jh": "319f038edee9",
  "ko": "접수원이 받을 수 있는 과제를 소개해 줍니다."
 },
 {
  "key": "m57",
  "kind": 5,
  "chr": -1,
  "jh": "02a454e420fd",
  "ko": "단, 한 번 받은 과제는 {CLRE}취소할 수 없으니{CLNR} 주의하세요."
 },
 {
  "key": "m58",
  "kind": 5,
  "chr": -1,
  "jh": "b1e7aa09b349",
  "ko": "또 과제에는 성적이 있어서, 높은 평가를 계속 받으면 {CLRE}수업 일부가 면제{CLNR}됩니다."
 },
 {
  "key": "m59",
  "kind": 5,
  "chr": -1,
  "jh": "520f43ef5d64",
  "ko": "수업이 면제되면 그만큼 {CLRE}원하는 일에 시간을 {CLRE}쓸 수{CLNR} 있게 됩니다."
 },
 {
  "key": "m60",
  "kind": 5,
  "chr": -1,
  "jh": "93966307ad67",
  "ko": "열심히 해서 과제에서 높은 평가를 노려 보세요."
 },
 {
  "key": "m61",
  "kind": 5,
  "chr": -1,
  "jh": "976bb101559a",
  "ko": "학생과에 대한 도움말을 보시겠습니까?"
 },
 {
  "key": "m62",
  "kind": 5,
  "chr": -1,
  "jh": "ab92e3df0bbc",
  "ko": "「{CLRE}도움말{CLNR}」의 「{CLRE}퀘스트{CLNR}」에 새로운 항목이 추가되었습니다."
 },
 {
  "key": "m63",
  "kind": 5,
  "chr": -1,
  "jh": "79da7c8bf517",
  "ko": "「{CLRE}도움말{CLNR}」은 메뉴의 「{CLRE}도감{CLNR}」에서 확인할 수 있습니다."
 },
 {
  "key": "m64",
  "kind": 5,
  "chr": -1,
  "jh": "b60cc258162d",
  "ko": "레시피 「{CLGR}처음 하는 연금술{CLNR}」을 손에 넣었습니다."
 },
 {
  "key": "m65",
  "kind": 5,
  "chr": -1,
  "jh": "4439de7ac04c",
  "ko": "「{CLGR}리퓨얼 포트{CLNR}」「{CLGR}연마제{CLNR}」「{CLGR}니크로 천{CLNR}」"
 },
 {
  "key": "m66",
  "kind": 5,
  "chr": -1,
  "jh": "8366d483a65f",
  "ko": "「{CLGR}제텔{CLNR}」을 조합할 수 있게 되었습니다."
 },
 {
  "key": "m67",
  "kind": 5,
  "chr": -1,
  "jh": "2a726a2a2e4d",
  "ko": "아이템을 조합하려면 {CLRE}아이템 레시피{CLNR}가 필요합니다."
 },
 {
  "key": "m68",
  "kind": 5,
  "chr": -1,
  "jh": "cee248e5d8d3",
  "ko": "{CLRE}아이템 레시피{CLNR}는 {CLRE}던전{CLNR}에서 얻거나 {CLRE}매점{CLNR}에서 살 수 있습니다."
 },
 {
  "key": "m69",
  "kind": 5,
  "chr": -1,
  "jh": "e6659df23179",
  "ko": "적극적으로 모아서 아이템을 마구 조합해 보세요."
 },
 {
  "key": "m70",
  "kind": 5,
  "chr": -1,
  "jh": "2b164fb0f248",
  "ko": "{CLRE}그로우북{CLNR}을 사용할 수 있게 되었습니다."
 },
 {
  "key": "m71",
  "kind": 5,
  "chr": -1,
  "jh": "126ab05b02f6",
  "ko": "메뉴를 {IM03}버튼으로 열고 {CLRE}그로우북{CLNR}을 확인하세요."
 },
 {
  "key": "g0s0",
