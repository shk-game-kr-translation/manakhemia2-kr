 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "5222fc9e51d3",
  "ko": "와!? 뭐, 뭐야? 큰 소리 내고?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 6,
  "jh": "67b24326b504",
  "ko": "서운하잖아! 왜 이 몸한테 말 안 해 줬어?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "bf449642b694",
  "ko": "그러니까 뭘"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 6,
  "jh": "7e702af4246d",
  "ko": "생일 말이야! 오늘 누나 생일이지?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "7c35adbbe3b3",
  "ko": "내 생일…? 아아, 듣고 보니!?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 6,
  "jh": "cda90a85dd09",
  "ko": "잊고 있었어? 누나는 덜렁이네"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "9da219c86645",
  "ko": "시, 시끄러워! 요즘 정신없었으니까 어쩔 수 없잖아!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 6,
  "jh": "de081f23b971",
  "ko": "그렇게 화내지 마"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "9270ddfbb3d9",
  "ko": "이 몸, 누나를 위해서 선물을 준비해 왔으니까"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "73e29e0740fd",
  "ko": "어? 선물? 나한테?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 6,
  "jh": "7b80fb5d6b7f",
  "ko": "응. 그야말로 최고의, 세상에 하나뿐인 선물이야!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "c6dcb5f2f003",
  "ko": "와, 뭘까… 뜸 들이지 말고 빨리 알려 줘"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 6,
  "jh": "b8f3c97a696c",
  "ko": "후후… 그 선물이란! 숨길 것 없이 바로 이 몸 자신이야!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "3c8975808d18",
  "ko": "………뭐?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 6,
  "jh": "d563c6ce1f3f",
  "ko": "그러니까 오늘 하루는 이 몸을 마음대로 해도 돼!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 6,
  "jh": "fc57610448d8",
  "ko": "옷 갈아입히며 놀아도 좋고, 껴안고 같이 자도 좋고!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "43d77ab4c7cc",
  "ko": "…필요 없어. 그럼"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 6,
  "jh": "06b93028cb9c",
  "ko": "에에에? 왜 서둘러 가 버리려는 거야? 잠깐, 누나!!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "43faeb0674ee",
