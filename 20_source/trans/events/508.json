[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "dd81d08640c3",
  "ko": "여기까진 순조롭네… 조금 다른 재료도 시험해 볼까. 그러니까…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 11,
  "jh": "bba63aae4469",
  "ko": "뭘 찾으세요?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "ffe2c1f38276",
  "ko": "응. 재료 몇 가지를… 없네. 갑자기 떠오른 거라 어쩔 수 없지만"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 11,
  "jh": "4a632e1e6cce",
  "ko": "그렇다면 제가 채취해 올까요?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "dc1aaaf55b9d",
  "ko": "그러게…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 3,
  "jh": "09d635051f37",
  "ko": "윤. 다녀와 줄래?"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 11,
  "jh": "112fce482a30",
  "ko": "뭣!?"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 4,
  "jh": "11c4cb5e12c8",
  "ko": "알았다"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 11,
  "jh": "af49e42c50c2",
  "ko": "그, 그런… 로제 씨! 어떻게 생각하세요? 저거!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "8fb0293c4858",
  "ko": "어떻게라니, 뭘?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 11,
  "jh": "eb2cc95150a5",
  "ko": "아가씨요! 저랑 로제 씨를 제쳐 두고 윤 씨한테 일을 맡기다니…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "f650e3ebe491",
  "ko": "편해서 좋잖아"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 11,
  "jh": "7329010517fe",
  "ko": "뭐, 편하긴 편하지만… 윤 씨도 윤 씨예요!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 11,
  "jh": "8aff0b40c1ff",
  "ko": "신참은 그 나름대로 눈치를 보는 게 이 세계의 예의인데!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "882301566403",
  "ko": "뭐야, 이 세계라니…"
 },
 {
  "key": "m15",
  "kind": 5,
  "chr": 4,
  "jh": "ea32714e5392",
  "ko": "공교롭게도 그런 예의는 갖추고 있지 않아서 말이다"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 11,
  "jh": "d12190955bc4",
  "ko": "꺅! 윤 씨!?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 0,
  "jh": "3aefa762acf2",
  "ko": "벌써 끝났어?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 4,
  "jh": "b58484e0cd3a",
  "ko": "대단한 일은 아니었으니까"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "e44449649610",
  "ko": "여전히 일이 빠르네. 고마워"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 11,
  "jh": "5ad4fd07022b",
  "ko": "저라면 더 빨리 다녀올 수 있었지만요!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "adcf4edbcde6",
  "ko": "…뭐? 갑자기 무슨 소리야?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 11,
  "jh": "41bee96f0813",
  "ko": "그러니까 저라면 윤 씨보다 빨리 일을…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "dc9500ae491b",
  "ko": "하지도 못할 말을 입에 담지 마. 정말…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 11,
  "jh": "0e7139d51427",
  "ko": "그런! 아가씨가 경멸하는 눈으로 절 보고 있어…!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 4,
  "jh": "cde7536410f3",
  "ko": "뭘 흥분하는지 모르겠다만, 누구에게나 잘하는 것과 못하는 것이 있다"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 4,
  "jh": "36b770044573",
  "ko": "이번엔 너한테 안 맞는 일이었을 뿐이다"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 11,
  "jh": "b71bbca6fbe4",
  "ko": "저는 그렇다 쳐도! 로제 씨도 재료 모으기는 잘한다고요!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 0,
  "jh": "a63b8acff7c8",
  "ko": "야, 거기서 날 끌어들이지 마"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 3,
  "jh": "0b4ec88a6419",
  "ko": "그렇지. 윔이라면 몰라도 로제가 윤한테 질 리가 없어"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 0,
  "jh": "7c91e9dcadd8",
  "ko": "아가씨도 편승하지 마세요…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 4,
  "jh": "bdd8199088f7",
  "ko": "딱히 이 녀석이 못하다고 할 생각은 없다. 내가 뛰어날 뿐이다"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "a458e54466ac",
  "ko": "당신도 맞받아치지 마. 제발…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 3,
  "jh": "d6f0bad960b0",
  "ko": "그렇다면 승부로 정하자! 승부 장소는 물이 사는 숲이면 되겠지"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 11,
  "jh": "10826f932e68",
  "ko": "네, 바라던 바예요!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 0,
  "jh": "0d3bf3153419",
  "ko": "내 의사는 상관없나…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]