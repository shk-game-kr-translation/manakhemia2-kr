[
 {
  "key": "m0",
  "kind": 2,
  "chr": 29,
  "jh": "c00db5df80ee",
  "ko": "응, 왜 그래? 아직 과제 도중이잖아?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 29,
  "jh": "56fd299aef6d",
  "ko": "아, 그래? 아~아, 모처럼 마지막이라 쉬운 과제로 했는데"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "a02e322d9028",
  "ko": "그래? 그럼 역시 하고 올게…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 29,
  "jh": "307f0072e96a",
  "ko": "이런, 안 돼. 한번 포기한다고 했으니까 취소는 안 돼"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "aa487360a8f1",
  "ko": "그, 그런 차가운 말 하지 마!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 29,
  "jh": "58b517663da7",
  "ko": "안 된다면 안 돼. 그럼 이번 평가는 불가라는 걸로. 아쉽게 됐네"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "bbf215bb0d5c",
  "ko": "우~ 아무래도 포기가 너무 빨랐나…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 29,
  "jh": "db1cfeda62ad",
  "ko": "수고했어. 과제는 끝내고 온 것 같네"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "8def59cb0443",
  "ko": "응, 완벽해!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 29,
  "jh": "fc1286037469",
  "ko": "왠지 자신 있어 보이네. 그럼 바로 평가해 볼까"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 29,
  "jh": "10e5134463c5",
  "ko": "어라? 제대로 됐네? 오야오야…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "770cf649eb87",
  "ko": "왜 그렇게 놀라는 거야"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 29,
  "jh": "fcd2e1e1e373",
  "ko": "아니~ 네가 자신만만할 땐 대개 실수했다는 이미지가 있어서"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "26c2456952ee",
  "ko": "뭣! 왜 그런 이미지가!?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "620f75d50544",
  "ko": "아주 틀린 건 아니지만…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 29,
  "jh": "8f68a19ed8b5",
  "ko": "아니, 미안 미안. 이건 흠잡을 데 없어. 자, 우 평가"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 29,
  "jh": "3a695748d4b3",
  "ko": "마지막에 제대로 된 성적을 받아 주니 기쁘네. 수고했습니다"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 29,
  "jh": "0c9912c218b1",
  "ko": "흠흠… 호오호오… 헤에에…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "02e123045103",
  "ko": "뜸 들이지 말고 빨리 알려 줘. 어때, 이번 평가는?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 29,
  "jh": "6b3aa8461a6e",
  "ko": "뭐, 생각보다는 제대로 했네"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "2d24e0de87a2",
  "ko": "그치… 어라? 생각보다라는 건…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 29,
  "jh": "9f8cf6efe77f",
  "ko": "응. 나쁘진 않은데 백 점 만점이라곤 할 수 없네"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "f0e6b86c8172",
  "ko": "에~ 마지막인데 조금쯤 덤으로 줘도 되잖아?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 29,
  "jh": "eb1be8708406",
  "ko": "덤으로 줘서 이 평가인데. 불만이면 덤 만큼 빼도…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "f8450dc7e418",
  "ko": "와, 그만 그만!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 29,
  "jh": "d8c9c835c21e",
  "ko": "뭐, 마지막까지 허술한 게 정말 너답네. 그럼 도장 찍을게"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "e79b931ca32e",
  "ko": "우~ 왠지 무시당하는 것 같아…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 29,
  "jh": "a7c99693f933",
  "ko": "왠지 일단 쓰러뜨리고 왔다는 느낌이네"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "59a035598d8c",
  "ko": "응. 일단 쓰러뜨리고 왔으니까"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 29,
  "jh": "29a2fcaae8c3",
  "ko": "그렇게 당당하게 나오면… 이래선 별로 좋은 평가는 못 줘?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "511dd94419fb",
  "ko": "에에? 왜. 제대로 쓰러뜨리고 왔는데"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 29,
  "jh": "2dce87341312",
  "ko": "쓰러뜨리면 되는 게 아니라… 뭐, 네가 남의 말 안 듣는 건 늘 있는 일인가"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "3d39be04daf0",
  "ko": "그, 그렇지 않아! 제대로 들었어!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 2,
  "jh": "f28726880194",
  "ko": "들어도 족족 잊어버릴 뿐이지…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "ad50cdf00bdf",
  "ko": "아니야! 이번엔 우연히 못 들어서…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 29,
  "jh": "78254e12f197",
  "ko": "네네, 떠들 거면 돌아가서 해. 자, 도장은 찍어 뒀으니까"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 29,
  "jh": "b526ccbdcd1f",
  "ko": "…라고 생각했는데, 안 되겠네, 이건"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 1,
  "jh": "a2db4a00cdd8",
  "ko": "에에? 안 된다니, 뭐가?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 29,
  "jh": "32b72edc0276",
  "ko": "시간이 너무 걸렸어. 그러니까 안 돼"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "27d681d3a571",
  "ko": "으, 그건 확실히 그럴지도 모르지만…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 29,
  "jh": "6cf372ed86c6",
  "ko": "그렇지? 빨리 쓰러뜨리는 것도 과제의 일부니까"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 29,
  "jh": "72ee33d747a3",
  "ko": "그런 이유로 이번엔 평가 없음. 아쉽게 됐네"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 1,
  "jh": "4ea66d3dbb24",
  "ko": "그런~…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "397f298da56e",
  "ko": "아무것도 아니다"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "9bb7d130052b",
  "ko": "과제를 포기한다"
 }
]