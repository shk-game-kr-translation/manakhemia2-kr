[
 {
  "key": "m0",
  "kind": 2,
  "chr": 0,
  "jh": "685056f277eb",
  "ko": "…제대로 기다리고 있었군"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 14,
  "jh": "7b412a42bbe5",
  "ko": "난 약속은 지키는 남자라니까. 그래서 뭐야? 묻고 싶은 거라는 게"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 0,
  "jh": "63cfba66ceee",
  "ko": "뻔하잖아. 반지에 관한 거다"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 14,
  "jh": "60107ad41dfd",
  "ko": "응, 반지의 뭐?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 0,
  "jh": "f5cc42171acc",
  "ko": "안 빠져. 어떻게 하면 뺄 수 있지?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 14,
  "jh": "501101670b48",
  "ko": "그래? 난 그냥 빠지는데. 봐"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 0,
  "jh": "9b7ab1c88199",
  "ko": "뭐? 그럼 왜 내 건…!?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 14,
  "jh": "b7e0611bc13e",
  "ko": "진정해. 안 빠지면 억지로 빼려고 안 해도 되지 않아?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 0,
  "jh": "1050b802e225",
  "ko": "…짜증이 난다고, 미칠 듯이. 이 반지 때문에"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 14,
  "jh": "c89633d5a37d",
  "ko": "짜증이 난다라… 그건 역시 마나를 볼 때?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 14,
  "jh": "69e6cbb1e876",
  "ko": "그럼 말이야, 시험 삼아 한번 마나를 베어 보면 되지 않을까?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "48bd45905091",
  "ko": "뭐라고…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 14,
  "jh": "d1dba8e2b908",
  "ko": "원래 그걸 위한 반지잖아. 일을 안 시켜 주니까 반지도 삐졌을지도"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "a4384f88c5c6",
  "ko": "난 진지하게 얘기하고 있어"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 14,
  "jh": "4c386b8606ce",
  "ko": "나도 진지해. 좋잖아. 마나를 보면 짜증 난다며?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 14,
  "jh": "9e19d77772d2",
  "ko": "울리카라고 했던가. 그 애 마나라면 딱 좋지 않아?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 0,
  "jh": "f1ed69a57ee6",
  "ko": "왜 그 녀석을 알고 있는 거야!?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 14,
  "jh": "4ee5f49bf4b8",
  "ko": "뭐, 직업상 말이야. 자, 고민은 해결됐나? 그럼 난 이만"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "a246e4b77e4a",
  "ko": "야, 기다려!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 14,
  "jh": "f3e6ea6a4017",
  "ko": "그 애 마나가 무리라면 다른 거라도 될 것 같은데. 네 곁에도 있으니까"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 0,
  "jh": "d128968e6ca4",
  "ko": "뭐… 웃기지 마!? 그런 걸 할 수 있을 리가…"
 },
 {
  "key": "m22",
  "kind": 5,
  "chr": 0,
  "jh": "f066a3a4415e",
  "ko": "그런 걸… 할 수 있을 리가…"
 },
