[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "1d068ece3f3d",
  "ko": "넌 틈만 나면 기계 만지작거리네"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 8,
  "jh": "3c0c8e5b91c7",
  "ko": "딱히 상관없잖아. 누구한테 폐 끼치는 것도 아니고"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "afba3c4b2689",
  "ko": "나쁘진 않지만 건강에 안 좋아. 남자애니까 조금은 밖에서 놀면 좋을 텐데"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 2,
  "jh": "3c92edd38e2f",
  "ko": "왠지 음침하네. 에나 군은…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 8,
  "jh": "06754caaee1f",
  "ko": "당신한테만은 듣고 싶지 않은데. 이건 놀이로 하는 게 아니야"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 8,
  "jh": "7ad9937ff374",
  "ko": "장래엔 아버지 일을 이어야 하니까"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "1637ae422519",
  "ko": "헤에. 너네 아버지 기계 가게 해?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 8,
  "jh": "145c78eff205",
  "ko": "뭐야, 기계 가게라니… 무기 장인이야, 기계 장치 무기를 만들어서 팔아"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 2,
  "jh": "2e680762dad2",
  "ko": "무기 장인… 죽음의 상인…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 8,
  "jh": "6c1812c13e7d",
  "ko": "싫은 말투 쓰지 마!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 6,
  "jh": "913bc0a5dd50",
  "ko": "형은 대단하네. 장래를 위해 매일 기계 공부라니"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 8,
  "jh": "e97a2c698978",
  "ko": "그것도 있지만 꼼꼼히 손질 안 하면 기분이 나빠지거든"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 6,
  "jh": "c015c535d13e",
  "ko": "그런 꾸준하고 수수한 면은 형한테 엄청 잘 어울린다고 생각해"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "88e5acc53f3c",
  "ko": "군나르 선생님 같은 건 절대 안 할 것 같아…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 8,
  "jh": "e8238527af96",
  "ko": "응? 왜 거기서 교감이 나와?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "ea2703fdb85b",
  "ko": "그 사람도 이상한 무기 쓰잖아. 기계검이라고 했던가?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 8,
  "jh": "1a77b70c3ce8",
  "ko": "기계검? 정말이야!?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "1d6e5a44cab0",
  "ko": "우와. 왜 그렇게 덥석 무는 거야"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 8,
  "jh": "dad0e73acaf0",
  "ko": "그치만 기계검이잖아!? 나 진짜를 본 적이 없어"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 8,
  "jh": "10d2a531d6e3",
  "ko": "마이너 무기라서 쓰는 녀석이 거의 없거든"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 2,
  "jh": "4a28c0aebd97",
  "ko": "그렇게 눈을 반짝이고… 오타쿠 같아"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 8,
  "jh": "b3b603be134c",
  "ko": "뭐라고 하든 상관없어. 잠깐 교감한테 다녀올게!"
 },
 {
  "key": "g0s0",
