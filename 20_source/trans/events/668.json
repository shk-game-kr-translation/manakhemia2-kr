[
 {
  "key": "m0",
  "kind": 5,
  "chr": 18,
  "jh": "8dd2a530da4d",
  "ko": "실례할게요"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "509a73e0baed",
  "ko": "헉! 이사장!?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 18,
  "jh": "87142851b828",
  "ko": "…슬슬 그런 반응은 그만둬 주셨으면 하네요"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "449c7f7b673b",
  "ko": "아, 아하하. 그만 버릇이…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 6,
  "jh": "1918886cac14",
  "ko": "무슨 볼일이야? 이 몸은 최근 사흘쯤 혼날 짓은 안 했어"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 2,
  "jh": "fc98d3aacf4f",
  "ko": "고작 사흘로 으스대는 건 좀…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 18,
  "jh": "3328279f602f",
  "ko": "설교하러 온 게 아니에요. …고토 님, 잠깐 괜찮으세요?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 9,
  "jh": "3b2a65af0c31",
  "ko": "아아, 상관없어. 오야, 그 보자기는…?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 18,
  "jh": "e97c4dd5996f",
  "ko": "그… 오랜만에 요리에 도전했는데 아무래도 너무 많이 만든 것 같아서…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 18,
  "jh": "e309c69d78bc",
  "ko": "입에 맞을지 모르겠지만 괜찮으시다면 그, 드셔 주시지 않을까 해서…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 9,
  "jh": "8608c508fa92",
  "ko": "…손가락이 붕대투성이잖아. 괜찮은 거야?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 18,
  "jh": "fe14ad61db85",
  "ko": "아, 부끄러워라… 식칼 같은 걸 든 게 몇 년 만이라. …그럼 실례할게요!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 8,
  "jh": "6e896aa8cead",
  "ko": "…봤냐? 방금 이사장 얼굴"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "50061450de9b",
  "ko": "응… 완전 딴사람이네"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "bd6e0e2db865",
  "ko": "귀엽다고 해야 할지… 징그럽다고 해야 할지…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 6,
  "jh": "bb59854c5662",
  "ko": "일부러 손수 만든 요리를 가져오다니 꽤 너한테 푹 빠졌나 보네"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 9,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 6,
  "jh": "efedb2dfe871",
  "ko": "응? 왜 그래, 표정이 안 좋네"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "64d7fa1e1e17",
  "ko": "역시 이사장 요리는 싫다든가?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 9,
  "jh": "a0b6dfa2479a",
  "ko": "설마, 이 이상 없을 만큼 감격하고 있어"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 9,
  "jh": "a899a5cbd53d",
  "ko": "다만 좀 놀랐어. 그녀가 이렇게 적극적인 행동에 나서다니…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "ef1cc8b8ce11",
  "ko": "우리가 보고 있는데… 체면 안 가리는 느낌…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 9,
  "jh": "5fc1b184012a",
  "ko": "응… 무슨 일이 있었는지도 모르겠군"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 6,
  "jh": "df540cd6b22b",
  "ko": "무슨 일이라니?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 9,
  "jh": "fed46731ce4c",
  "ko": "소녀의 마음이란 늘 흔들리는 거니까. 마치 큰 파도에 흔들리는 작은 배처럼"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 9,
  "jh": "bf8e716564ca",
  "ko": "불안정한 시기엔 이래저래 신경 써 줘야지"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "2c8f776b0fc1",
  "ko": "흐응… 그런 거야?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 8,
  "jh": "ba3f01880683",
  "ko": "남자인 나한테 소녀 마음을 묻지 마…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 9,
  "jh": "ab740b648f34",
  "ko": "이런 정보는 여자애들이 더 잘 알겠지. 잠깐 물어보고 올까"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "41186e61b41c",
  "ko": "아, 나도 갈래. 한가하고 이사장 소문도 궁금하고"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 9,
  "jh": "5c7b6e230791",
  "ko": "남의 소문 얘기를 듣고 싶어 하는 건 좋은 취미라곤 할 수 없지만"
 },
 {
  "key": "g0s0",
