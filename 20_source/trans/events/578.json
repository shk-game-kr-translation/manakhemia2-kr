[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "83a4248459bc",
  "ko": "너희, 노닥거리지 말고 좀 도와"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 6,
  "jh": "38c092b129cc",
  "ko": "오오이런. 미안해, 누나"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 9,
  "jh": "3a7b6f9fdd28",
  "ko": "그만 옛날얘기에 꽃이 피어서"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 2,
  "jh": "4ec29308a29c",
  "ko": "둘은 정말 사이가 좋구나… 징그러울 만큼…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 6,
  "jh": "7470cde8298e",
  "ko": "그야 10년 지기니까"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 9,
  "jh": "0ae9fb73b2ec",
  "ko": "10년은커녕 그건 20년… 아니, 30년 전이 되려나?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 8,
  "jh": "2bf235397b09",
  "ko": "너희 몇 살이야…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "45569e0275f8",
  "ko": "이런, 안 돼. 마스코트 캐릭터에게 나이를 묻는 건 국제 규칙 위반이야"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 9,
  "jh": "e974a3d5565e",
  "ko": "분명 처음 만났을 때 넌 혹독한 수행에서 도망치던 중이었지"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "48508cbc19be",
  "ko": "그러는 넌 위험한 남자의 애인한테 손대서 쫓기던 중이었잖아"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "2041d36210b5",
  "ko": "둘의 과거엔 관심 없으니까 아무래도 좋아…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 6,
  "jh": "af8003e105f8",
  "ko": "한눈에 느꼈지… 이 녀석은 평생의 라이벌이 될 게 틀림없다고"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 9,
  "jh": "fb6a76b80d8c",
  "ko": "아아… 영원한 미의 라이벌로"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 9,
  "jh": "8766eba7fcc8",
  "ko": "이 녀석은 언젠가 내 앞을 가로막는다… 그렇게 느낀 난 무심코 주먹을 날렸지"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 9,
  "jh": "705ec4742459",
  "ko": "이야, 지금 생각하면 젊었었지"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 6,
  "jh": "6cea0f838650",
  "ko": "이 몸은 울적해서 상대가 누구든 상관없었던 느낌이려나"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "e9128db61610",
  "ko": "하아… 그래서 주먹다짐 끝에 우정이 싹텄다고"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 9,
  "jh": "85b7fbd778bd",
  "ko": "그렇다네. 너덜너덜해져 쓰러진 페페론에게 내가 손을 내밀어서…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 6,
  "jh": "16ded63e6b55",
  "ko": "무슨 소리야? 그때 이긴 건 이 몸이잖아"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 6,
  "jh": "77c916bf4b28",
  "ko": "이 몸의 초크 슬리퍼로 15라운드 아슬아슬하게 KO승이었을걸!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 9,
  "jh": "1ad634c3b30f",
  "ko": "아니잖아? 그땐 나의 화려한 상단 돌려차기가 네 턱에 들어가서…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 9,
  "jh": "299037e20685",
  "ko": "하하~ 머리를 세게 부딪혀서 기억이 이상해진 건가"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 6,
  "jh": "fcec80945ceb",
  "ko": "그 다리로 이 몸 턱에 닿을 리가 없잖아! 이긴 건 이 몸이야!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 9,
  "jh": "a3b4ffe6527d",
  "ko": "너야말로 내 목 어디에 초크 슬리퍼가 들어갔다는 거지?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 6,
  "jh": "b232060e4556",
  "ko": "처음 만났을 때 넌 너구리 모습이었잖아!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "ce8a2a70dd75",
  "ko": "아 정말, 됐잖아. 그런 옛날 일로 싸우지 않아도"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 6,
  "jh": "6fdc4fa965e9",
  "ko": "아니! 이것만은 양보 못 해!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 9,
  "jh": "eee7e44ad331",
  "ko": "그렇지. 여자애가 끼어들 일이 아니야"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 2,
  "jh": "a64e5b514d15",
  "ko": "…페미니스트인 탈인형 씨가 그렇게까지 말한다는 건…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 8,
  "jh": "649b7c5ec185",
  "ko": "꽤 진심이겠지… 듣는 입장에선 시시한 일이지만"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 6,
  "jh": "c35e10da4c25",
  "ko": "좋아, 이렇게 된 이상…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 9,
  "jh": "1b7e480271e0",
  "ko": "아아. 새삼 결판을 내자고!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 6,
  "jh": "29c9e7b0c2eb",
  "ko": "바라던 바야! 이 몸은 누나를 세컨드로 붙이겠어!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "c69324988b32",
  "ko": "…뭐? 잠깐, 왜 내가…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 9,
  "jh": "3a3b9817a03b",
  "ko": "그럼 난 다른 한 여자애가 되겠군. 필연적으로"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 2,
  "jh": "a90fcc47700b",
  "ko": "…휘말렸다"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 6,
  "jh": "73980013914d",
  "ko": "그렇게 정해졌으면 바로 작전 회의야! 이 승부, 절대 질 수 없으니까!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 1,
  "jh": "2d02473cfd9c",
  "ko": "그보다 세컨드가 뭐야? 그런 거 필요 없잖아. 마음대로 치고받으면…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 6,
  "jh": "68ab6f11c03b",
  "ko": "스승님한테도 상담해야지! 자, 가자!"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 1,
  "jh": "7cec9ca87884",
  "ko": "그러니까 아무도 한다고는… 이놈! 놔~!"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 9,
  "jh": "9480981155d2",
  "ko": "이쪽도 그에 걸맞은 작전을 짜야겠군. 어설퍼선 그를 못 이겨"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 2,
  "jh": "1655a73d1fee",
  "ko": "…할 거면 반드시 이긴다"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 9,
  "jh": "83b7c74e0276",
  "ko": "후후, 너라면 그렇게 말해 줄 거라 믿었다!"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 8,
  "jh": "cc89c7533c68",
  "ko": "…나만 집 보기냐. 이건 이거대로 쓸쓸한 것 같기도…"
 },
 {
  "key": "g0s0",
