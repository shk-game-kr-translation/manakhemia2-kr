[
 {
  "key": "m0",
  "kind": 0,
  "chr": 20,
  "jh": "242f81386b39",
  "ko": "좋아, 오늘 수업은 끝… 야 잠깐, 아직 돌아가지 마."
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 20,
  "jh": "c1f4e9e7b446",
  "ko": "지금부터 중간고사 내용을 발표한다"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 87,
  "jh": "24c52f92ac5a",
  "ko": "네? 중간고사?"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 20,
  "jh": "ac64c217d271",
  "ko": "그래. 다음 주까지 요정 씨의 영수를 만들어 와라. 알겠지."
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 89,
  "jh": "aaaed73673f5",
  "ko": "갑자기 그러셔도… 만드는 법도 모르고…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 20,
  "jh": "5c71466769de",
  "ko": "모르면 조사해. 그리고 일단 말해 두는데"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 20,
  "jh": "cae34780e533",
  "ko": "절대 전투기술과… 군나르네 녀석들한테 지지 마라"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 20,
  "jh": "ba30c6cd3348",
  "ko": "만약 진 녀석은 생각할 수 있는 모든 지옥을 맛보게 해 주마…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "c7a156a1bb47",
  "ko": "저 눈, 진심이야… 어쩌지? 클로에 만드는 법 알아?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 2,
  "jh": "69e7d47a2e9e",
  "ko": "지옥이라… 후, 우후후후… 울리카가 꼬치에…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "acf559adda07",
  "ko": "이상한 상상 하지 마! …아, 맞다. 있잖아 있잖아"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 3,
  "jh": "997bed3d3105",
  "ko": "…뭐니? 함부로 말 걸지 말아 줬으면 하는데"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "d96ed60dad1e",
  "ko": "너라면 만드는 법 알지? 가르쳐 줘."
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 3,
  "jh": "e0fd38cc5e29",
  "ko": "왜 내가 너한테 가르쳐 줘야 하니?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "6fe0cb8f3648",
  "ko": "좋잖아. 어려울 땐 서로 돕는 거지"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 2,
  "jh": "07c2ee4ef1bb",
  "ko": "관두자… 이 사람한테 부탁하면 구두 밑창을 핥으렴 같은 소릴 들을 거야…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 3,
  "jh": "e494cc837037",
  "ko": "너, 날 대체 어떤 눈으로 보는 거니!?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 2,
  "jh": "d756c3ce1296",
  "ko": "…그 로제라는 사람한테 맨날 그런 요구를 하잖아…?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "b6935eb22d1f",
  "ko": "안 하거든! 오히려 해 보고 싶다고!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "f29f18e57b6a",
  "ko": "괴로운 표정을 지으며 내 구두 밑창을 핥는 로제… 잠깐 무슨 말을 시키는 거야!?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 2,
  "jh": "a8badd81f88c",
  "ko": "…봐, 위험한 사람이니까 가까이 안 가는 게 좋아"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "fe4e4eb2b939",
  "ko": "…그러네. 어쩔 수 없지, 토니 선생님한테 직접 물어볼까"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 3,
  "jh": "c797bc0d39f9",
  "ko": "자, 잠깐! 이상한 오해한 채로 가지 마!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]