 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "5d2a47860b4c",
  "ko": "어, 아가씨가요?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 11,
  "jh": "74d3875a41a7",
