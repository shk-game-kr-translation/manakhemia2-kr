 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 11,
  "jh": "039adb240972",
  "ko": "그… 특히 가슴 크기 차이라든가…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 3,
  "jh": "4c8cb6011c49",
  "ko": "뭐야앗!? 왜 가슴 얘기가 나오는 건데!? 응!?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 11,
  "jh": "95354979e12c",
