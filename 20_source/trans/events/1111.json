 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "4fc64aa9aff6",
  "ko": "그런 거라니 이 옷 말이에요? 딱히 좋지도 싫지도 않은데요"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "386db511d997",
  "ko": "그래. 그런 거였구나. …라이벌은 가까운 데 있었다는 거네…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 11,
  "jh": "9a30577d98da",
  "ko": "네? 왜, 왜 그렇게 무서운 눈으로 노려보세요?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 3,
  "jh": "c2ad6f0301f6",
