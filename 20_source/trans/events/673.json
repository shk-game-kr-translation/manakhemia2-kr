[
 {
  "key": "m0",
  "kind": 0,
  "chr": 18,
  "jh": "cd409fc67196",
  "ko": "후우… 안 되겠네. 전혀 집중이 안 돼. 금방 그 사람 생각을 해 버려서…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 18,
  "jh": "a5b9df71c27f",
  "ko": "정말이지, 열대여섯 살 여자애도 아니고…"
 },
 {
  "key": "m2",
  "kind": 5,
  "chr": 9,
  "jh": "56c1b7154c05",
  "ko": "헤앗! 누웅!"
 },
 {
  "key": "m3",
  "kind": 5,
  "chr": 6,
  "jh": "a5ca65a9a757",
  "ko": "토아! 아직이다아!"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 18,
  "jh": "a9eeec2f45ab",
  "ko": "어머…? 무슨 소리지"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 6,
  "jh": "788e5629c513",
  "ko": "누하아! 어때, 이 몸의 두꺼운 가슴판은"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 9,
  "jh": "e963e6c428e5",
  "ko": "좋아, 최고야… 가슴판도 좋지만 내 얼굴을 낀 이두박근이 또 끝내주는군…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "a733cc34acc7",
  "ko": "오오이런! 이 몸 육체미를 칭찬하면서 슬쩍 오른쪽 허벅지 안쪽으로 손을 돌렸네"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 9,
  "jh": "7aebd6d5fbdf",
  "ko": "후훗. 이대로 널 굴려서 사랑의 마운트 포지션으로 가져가 주지"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "34aa1becdce3",
  "ko": "매력적인 제안이네. 몸도 마음도 녹아웃될 것 같아…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 18,
  "jh": "021b6e211bcb",
  "ko": "저, 저기… 고토 님? 대체 뭘 하시는…?"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 9,
  "jh": "2370e9c16b9c",
  "ko": "응, 보면 모르겠어? 남자 둘이서 땀 냄새 나게 스모를 하고 있지"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 6,
  "jh": "d287bf3b59df",
  "ko": "이야~ 역시 살과 살의 부딪침은 최고로 엑스터시야!"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 18,
  "jh": "fb5035ca246d",
  "ko": "하아… 스, 스모인가요…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "9cc16b27b438",
  "ko": "…네가 말한 한 번 더 비틀기가 이거야?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 2,
  "jh": "a133700c2668",
  "ko": "응… 보통 사람이라면 이걸로 환멸할 거야…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 8,
  "jh": "409bc0fe5d22",
  "ko": "잘도 이런 걸 생각해 내네…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 2,
  "jh": "da2f1dc2900f",
  "ko": "여자애라면 누구나 생각해 내…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "ec53d700e25a",
  "ko": "난 절대 생각 못 해"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 2,
  "jh": "7d336cdffa2a",
  "ko": "…일부 여자애는 오히려 흥분해 버리는 양날의 검이기도 하지만…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 8,
  "jh": "134b607715ba",
  "ko": "그럼 안 되잖아…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "b6340920f8ec",
  "ko": "그걸 가려내기 위해서도 중요한 장면…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 6,
  "jh": "a1fdc143c075",
  "ko": "이야~ 기분 좋다. 그래도 이왕이면 네 땀을 맨살로 직접 느끼고 싶어…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 6,
  "jh": "a2ffcbab11e9",
  "ko": "옷 입고 스모하는 건 정신 위생상 안 좋지…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 9,
  "jh": "c3f9a28c8f0f",
  "ko": "우연이군, 나도 같은 생각을 하고 있었어…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 9,
  "jh": "8b70df8aa23f",
  "ko": "남자끼리 누구에게 부끄러워할 것도 없지. 알몸 하나로 살과 살을 비벼 대 볼까!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 18,
  "jh": "e8152260f3ea",
  "ko": "아, 알몸끼리!?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 9,
  "jh": "f878c1b7b159",
  "ko": "왜 그래, 그런 소리를 내고. 이런 건 싫어?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 18,
  "jh": "ecd4f20a525b",
  "ko": "으, 아… 흠흠. 스모하는 건 상관없지만 학생들 눈도 있어요"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 18,
  "jh": "e799df6fa9de",
  "ko": "이어서 하시는 건 부디 다른 곳에서 해 주세요!"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 9,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 6,
  "jh": "ccfc23996e9d",
  "ko": "후우, 잘됐다고 생각해도 되려나?"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 9,
  "jh": "f1c29d8497df",
  "ko": "아마도… 하지만 마음이 아프군"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 6,
  "jh": "0bca932c6964",
  "ko": "한 판 더 할래? 땀을 흘리면 싫은 일도 잊을 수 있어!"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 9,
  "jh": "0bdc8a699f31",
  "ko": "마음은 기쁘지만 사양할게. 이대로 계속하면 진심이 돼 버릴 것 같아"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "942cc0d5c81f",
  "ko": "어때? 어때? 그 반응은?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 2,
  "jh": "83d2a42d611e",
  "ko": "나쁘지 않은 것 같아… 그래도 한 방이 부족할지도… 뭔가 다른 방향으로…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 8,
  "jh": "c56aaf19c8a5",
  "ko": "방향이라…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 2,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 8,
  "jh": "9c00f1d85824",
  "ko": "응? 뭐야, 사람을 빤히 보고"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 2,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 8,
  "jh": "511e274fe1ed",
  "ko": "엄청 불길한 예감이… 그만둬! 그런 눈으로 날 보지 마!!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
