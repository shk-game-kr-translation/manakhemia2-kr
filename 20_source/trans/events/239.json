[
 {
  "key": "m0",
  "kind": 2,
  "chr": 2,
  "jh": "eebdc6fe8751",
  "ko": "있다, 래디시… 왜 그래, 울리카? 안 기뻐 보이는데…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "6c271e2b057e",
  "ko": "아니… 특훈하러 왔을 텐데 그냥 도착해 버렸네 싶어서"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 6,
  "jh": "9a25b4cbcef1",
  "ko": "뭐야~ 특훈하려고 했더니 누나가 방해했잖아"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "6e9b08336b17",
  "ko": "너희 건 도가 지나쳐. 뭐 됐어, 다 모으면 다시 특훈이야!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 5,
  "jh": "ee00abd1cc2f",
  "ko": "푸니!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 8,
  "jh": "db30ef8c6b6b",
  "ko": "왜 네가 의욕이 넘치는 건데"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 2,
  "jh": "ee9fde6a42e7",
  "ko": "다들, 입 말고 손을 움직이자… 특히 울리카랑 요정 씨"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "e4b2c1745471",
  "ko": "에에. 누나랑 한데 묶이는 건 억울한데"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "7286bf4ea35a",
  "ko": "그건 내가 할 소리야!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "94cd806e978c",
  "ko": "후우, 이만큼 캤으면 충분하네!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "942bfb00fc10",
  "ko": "푸니요, 지쳤어…? 그럼 돌아갈까…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "5ba45f87df0a",
  "ko": "자연스럽게 돌아가려 하지 마! 아까 그 의욕은 어디 갔어, 푸니 아가씨!?"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "e2580a3465fa",
  "ko": "…그렇게 특훈하고 싶으면 혼자 하면 될 텐데…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 8,
  "jh": "79540894c5de",
  "ko": "애초에 바보같이 특훈 특훈 하는 것치고 아직도 뭘 할지 안 정했잖아"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "fd34dc16bf05",
  "ko": "당연하지. 정했으면 진작 시작했지!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 2,
  "jh": "e1f9390c0a50",
  "ko": "배 째라네…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 6,
  "jh": "b9adc7f428f7",
  "ko": "어쩔 수 없네. 여기선 하나, 이 몸들이 격투기라도 가르쳐 줄까"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 9,
  "jh": "02a941e76694",
  "ko": "그렇지. 특훈이라 하면 기본은 남자와 남자, 몸과 몸의 부딪힘이니까"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 10,
  "jh": "ea065d8d41fd",
  "ko": "우?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "4be39be9f96a",
  "ko": "어머, 웬일로 멀쩡한 소리를 하네"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "ba54bad6fa06",
  "ko": "그리고 질투에 미친 두 남자는 특훈을 빙자해 우류를 없애 버리는데…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "43f281cc32e6",
  "ko": "뭐!? 그런 걸 꾸미고 있었어? 너희!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 6,
  "jh": "af6d339c4e04",
  "ko": "오, 오해야! 이상한 내레이션 붙이지 말아 줘!"
 },
 {
  "key": "m24",
  "kind": 5,
  "chr": 15,
  "jh": "6c57dea8f4b2",
  "ko": "드디어 따라잡았다아아!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 15,
  "jh": "ac66f237ef61",
  "ko": "하아, 하아… 자, 잘도 해 줬겠다…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "c89b951ffd74",
  "ko": "누구야 너? 방해하지 말아 줄래"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 2,
  "jh": "3b98cb27b956",
  "ko": "요정 씨들 아는 사람…?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 6,
  "jh": "b0395cf53cf6",
  "ko": "아니, 모르는 사람이야"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 9,
  "jh": "8fdfdcb8903c",
  "ko": "하하~ 혹시 나한테 첫눈에 반해서 쫓아와 버린 건가?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 15,
  "jh": "ad456e755f3f",
  "ko": "아니거든! …어머, 그래도 잘 보니 좋은 남자…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 15,
  "jh": "4dadd5bdbe41",
  "ko": "앗! 안 돼 안 돼, 나한텐 마음에 정한 사람이 있어"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 9,
  "jh": "2ceac80b0866",
  "ko": "내 멋짐을 알아본다는 건… 나쁜 사람은 아닌 것 같군. 응."
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 15,
  "jh": "e2114dd9b7bc",
  "ko": "정신 차려, 나. 좋은 남자한테 속으면 안 돼… 좋아!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 15,
  "jh": "baa66d8bb74a",
  "ko": "자, 이러쿵저러쿵 하지 말고 그 마나를 이리 내놔!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "1b6f7d7fcd5d",
  "ko": "뭐? 뭐, 뭐야 갑자기…?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 15,
  "jh": "00cddc118b79",
  "ko": "실컷 비겁한 짓 해 줬지만, 정면으로 싸우면 너희 따위한테 안 질 거야!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 2,
  "jh": "5de9f2ff7e2f",
  "ko": "…이번만큼은 정말로 난 아무것도 안 했는데…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 15,
  "jh": "c601277fee15",
  "ko": "변명은 필요 없어! 모든 건 나의 사랑을 위해… 자, 각오해!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "8dd10f5f875d",
  "ko": "아~ 정말! 영문을 모르겠어~!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 15,
  "jh": "b38b9ea1a8ad",
  "ko": "져, 졌다… 그런… 이 이상 결혼 적령기가 늦어지면…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 1,
  "jh": "1ed27d6329e5",
  "ko": "네 결혼이랑 우류가 대체 무슨 상관인데…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 2,
  "jh": "47687cb6b540",
  "ko": "얘기로 짐작하건대… 혼기 놓친 노처녀의 히스테리?"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 15,
  "jh": "33de4853307f",
  "ko": "아니야, 아니라고! 노처녀 아니야! 으아아아아앙!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 9,
  "jh": "7b40e4f03bc3",
  "ko": "여성을 울리는 건 좋지 않아, 검은 아가씨"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 2,
  "jh": "81ae70232513",
  "ko": "싸움을 걸어오는 쪽이 나빠… 게다가 약하고"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 15,
  "jh": "48f2fd5984da",
  "ko": "안 약해! 지쳐 있어서 진 거야! 컨디션이 완벽했으면 안 졌어!"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 8,
  "jh": "d2e36b5b5e7a",
  "ko": "확인 사살하지 마… 그래서, 어쩌냐? 이 녀석"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 6,
  "jh": "8149b5926fca",
  "ko": "네가 달래 주면 진정하지 않을까?"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 9,
  "jh": "07853b058253",
  "ko": "그러고 싶은 건 굴뚝같지만… 여성의 눈물엔 약해서…"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 1,
  "jh": "25e5792c3b2a",
  "ko": "곤란하네… 가능하면 깊이 엮이고 싶지 않은데"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 10,
  "jh": "9dc66ada9e64",
  "ko": "우!"
 },
 {
  "key": "m52",
  "kind": 0,
  "chr": 1,
  "jh": "e713e70aa4dd",
  "ko": "앗, 안 돼! 위험해!"
 },
 {
  "key": "m53",
  "kind": 0,
  "chr": 15,
  "jh": "077b9de0fd1b",
  "ko": "뭐, 뭐야…"
 },
 {
  "key": "m54",
  "kind": 0,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m55",
  "kind": 0,
  "chr": 15,
  "jh": "50435c649bdd",
  "ko": "화난 거야…? 흐, 흥. 그런 귀여운 눈으로 노려봐도…"
 },
 {
  "key": "m56",
  "kind": 0,
  "chr": 10,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m57",
  "kind": 0,
  "chr": 15,
  "jh": "cd31bd04d4f5",
  "ko": "뭐야, 대체 뭐냐고… 으으으으…"
 },
 {
  "key": "m58",
  "kind": 0,
  "chr": 15,
  "jh": "b48a277b00a2",
  "ko": "크, 오늘은 봐주겠어! 두고 봐~!"
 },
 {
  "key": "m59",
  "kind": 0,
  "chr": 8,
  "jh": "a9bad9e98e71",
  "ko": "우오, 엄청난 도망 속도네…"
 },
 {
  "key": "m60",
  "kind": 0,
  "chr": 2,
  "jh": "ded7ec78a7b9",
  "ko": "저만큼 기운이 있으면… 더 혼내 둘 걸 그랬어…"
 },
 {
  "key": "m61",
  "kind": 0,
  "chr": 6,
  "jh": "7e23de68f14f",
  "ko": "무서운 소리 하네… 이 몸, 검은 누나만큼은 적으로 돌리고 싶지 않아"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 1,
  "jh": "831400545c0a",
  "ko": "이 녀석! 위험한 짓 하면 안 되잖아!"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 9,
  "jh": "af5b55b2f679",
  "ko": "그런데 그녀… 왜 우류를 노린 걸까?"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 1,
  "jh": "26ddd4024736",
  "ko": "그런 거 모르지. …오늘은 그만 돌아가자. 왠지 기분이 안 좋아졌어"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 2,
  "jh": "fdd04f231e5b",
  "ko": "울리카… 심각한 얼굴 해도 전혀 안 어울려…?"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 1,
  "jh": "400ddc2afd4e",
  "ko": "쓸데없는 참견이야! 자, 얼른 돌아가자"
 },
 {
  "key": "m68",
  "kind": 0,
  "chr": 9,
  "jh": "793f96a17ae3",
  "ko": "그녀는 네가 걱정하던 일과 관계가 있는 걸까?"
 },
 {
  "key": "m69",
  "kind": 0,
  "chr": 6,
  "jh": "71ca3a67bb39",
  "ko": "글쎄… 뭐, 한동안은 누나 곁을 떠나지 않는 게 좋으려나"
 },
 {
  "key": "m70",
  "kind": 0,
  "chr": 9,
  "jh": "6b8db5f6df31",
  "ko": "흠… 그럼 밤엔 내가 침대 속에서 지켜볼까"
 },
 {
  "key": "m71",
  "kind": 0,
  "chr": 6,
  "jh": "d9e6ececf34b",
  "ko": "하하하. 그런 짓 하면 목숨은 보장 못 해"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]