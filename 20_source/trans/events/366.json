[
 {
  "key": "m0",
  "kind": 5,
  "chr": 1,
  "jh": "1f21d6fe655d",
  "ko": "와~~! 늦잠 잤다~~~!"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 2,
  "jh": "284bcf16b3b9",
  "ko": "빨리 안 하면 졸업식 시작해…"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 8,
  "jh": "09a2cf7e8ec0",
  "ko": "게다가 저쪽 형들도 기다리게 하고 있잖아"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 1,
  "jh": "5809ae6b14d5",
  "ko": "알고 있어! 왜 안 깨워 줬어! 너희는!"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 10,
  "jh": "462e025f0e9d",
  "ko": "우~! 우~!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 6,
  "jh": "a5492da4cc50",
  "ko": "으아아앙! 큰일이야, 누나!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 9,
  "jh": "a8dd35a2c32e",
  "ko": "응. 실로 곤란한 일이 생겼어"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "b3c6ff65e072",
  "ko": "뭐야!? 너희까지!?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 6,
  "jh": "2daf5a4c5208",
  "ko": "모처럼이니 턱시도로 쫙 빼입으려 했는데… 단추가 안 잠겨!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 9,
  "jh": "7b2725023663",
  "ko": "나도 비슷해. 탈인형 사이즈 턱시도는 어디서도 안 팔아서…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "b7e4c8b4cd88",
  "ko": "몰라! 그냥 평소 차림이면 되잖아!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 9,
  "jh": "65994df2e945",
  "ko": "아니, 하지만 말이야. 인생의 고비가 되는 의식에 평상복이란…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 6,
  "jh": "bb37ca6a6453",
  "ko": "맞아~ 이 몸도 가끔은 멋 부리고 싶다고!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "6f8a7971bed1",
  "ko": "…이제 두고 갈까"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 8,
  "jh": "dc3d776a3de5",
  "ko": "그러자…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "0679f002a5f4",
  "ko": "와~ 기다려! 금방 끝낼게!"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 3,
  "jh": "be4a6780b070",
  "ko": "…언제까지 기다리게 하는 거야! 그 시골뜨기는!"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 11,
  "jh": "14737dcb9126",
  "ko": "자자, 아가씨. 진정하세요…"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 7,
  "jh": "b1aaacf4396e",
  "ko": "그런데 뭘까? 일부러 식 전에 불러내다니"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 5,
  "jh": "d7c62f75273f",
  "ko": "푸니~?"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 4,
  "jh": "3eaec6e200a0",
  "ko": "글쎄. 시시한 일이 아니면 좋겠다만"
 },
 {
  "key": "m21",
  "kind": 5,
  "chr": 1,
  "jh": "35bf291dde7e",
  "ko": "미안~ 기다렸지~!"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 0,
  "jh": "746d323c0eef",
  "ko": "겨우 왔나…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "f2ab308c2e4c",
  "ko": "늦었어! 몇 분이나 기다렸는 줄 알아!?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "68386b9bec21",
  "ko": "그러니까 미안하다고 했잖아"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "292ed287a11f",
  "ko": "그래서, 무슨 볼일이야?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "506d6199e55e",
  "ko": "응. 에나가 말이야, 재밌는 걸 만들었어. 그게… 뭐라고 했더라?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 8,
  "jh": "167fc8a04ab7",
  "ko": "카메라야. 사진 찍는 기계"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "1d1add00e279",
  "ko": "그래, 그거! 모처럼이니까 다 같이 찍으면 어떨까 해서"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 3,
  "jh": "b82b8d13ab8a",
  "ko": "어머… 무슨 이상한 소릴 할까 했더니"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 11,
  "jh": "0d1cd6bceb6b",
  "ko": "멋진 제안이네요!"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "63c609bdf271",
  "ko": "그치! 그럼 바로. 자, 다들 줄 서 줄 서"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 2,
  "jh": "519d93d537f4",
  "ko": "영혼 빠져나가거나 하진 않겠지…?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 8,
  "jh": "e0218da0d7a0",
  "ko": "안 빠져. 안심해"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 7,
  "jh": "c2faf97303f4",
  "ko": "내가 한가운데 찜~!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 6,
  "jh": "0e4aa2e674de",
  "ko": "오오, 그것만은 양보 못 해!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 9,
  "jh": "ec05061d8798",
  "ko": "나를 한가운데 찍는 것만으로 예술적 가치가 몇십 배로…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 4,
  "jh": "b53dd198e44d",
  "ko": "키 큰 사람은 뒤다. 얼른 줄 서라"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 6,
  "jh": "720f98b2b6f3",
  "ko": "그, 그런!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 3,
  "jh": "bd3959b31719",
  "ko": "저, 저기… 나중에 로제랑 단둘이 사진 찍어 줘도 될까…?"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 8,
  "jh": "724776f9e49c",
  "ko": "응? 딱히 상관없는데"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 11,
  "jh": "2e839aa87701",
  "ko": "아가씨! 빨리 서지 않으면 자리 없어져요!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 3,
  "jh": "22a0dcf791c4",
  "ko": "알고 있어! 그럼 부탁해! 꼭이야!"
 },
 {
  "key": "m43",
  "kind": 5,
  "chr": 12,
  "jh": "8511c3d0a6ab",
  "ko": "호오… 꽤 재밌어 보이는 걸 하고 있군"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "d19736f84583",
  "ko": "어머, 선생님"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 12,
  "jh": "650eb955d4aa",
  "ko": "설마 이 몸을 빼놓고 사진을 찍겠다고는 안 하겠지"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 20,
  "jh": "5c068897e0b4",
  "ko": "흥, 날 찍을 땐 오른쪽 사선 45도로 부탁한다"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 1,
  "jh": "6e651ea5b9b1",
  "ko": "같이 찍힐 생각 만만이네"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 0,
  "jh": "153aa998bcfc",
  "ko": "뭐, 괜찮지 않아? 둘이 들어오면 더 붙어야겠는데…"
 },
 {
  "key": "m49",
  "kind": 5,
  "chr": 18,
  "jh": "6ebe2f022c68",
  "ko": "뭘 떠들고 있는 거예요! 곧 식이 시작돼요!"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 1,
  "jh": "ff8412f149f6",
  "ko": "으악, 시끄러운 사람이 왔다…"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 18,
  "jh": "de720e1653c4",
  "ko": "군나르 선생님에 토니 선생님까지 함께 대체 뭘…"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 9,
  "jh": "14de096e2005",
  "ko": "야아, 마루타. 좋은 데 왔군. 괜찮으면 같이 한 장 어때?"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 18,
  "jh": "496683de1e31",
  "ko": "네? 고토 님… 이건 사진 촬영인가요?"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 9,
  "jh": "14e061a00205",
  "ko": "아아. 지금 너의 아름다움을 영원히 가둬 두고 싶어… 안 될까?"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 18,
  "jh": "16d0916cb56f",
  "ko": "아, 으… 고토 님이 그렇게 말씀하신다면…"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 18,
  "jh": "6d4b7b202896",
  "ko": "화장은 괜찮겠지? 머리도… 응, 안 흐트러졌어"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 13,
  "jh": "60afb6803503",
  "ko": "저기~… 나도 들어가도 될까?"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 1,
  "jh": "58d9dad011f0",
  "ko": "물론이죠. 자, 서둘러요 서둘러"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 2,
  "jh": "fba36a6fa132",
  "ko": "완성된 사진을 보면… 교장 선생님만 안 찍혀 있다거나…"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 13,
  "jh": "6ac0d541ab7e",
  "ko": "무, 무서운 소리 하지 말아 줘!"
 },
 {
  "key": "m61",
  "kind": 5,
  "chr": 8,
  "jh": "a14d93579f83",
  "ko": "어이~ 이제 됐냐? 찍는다~"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 0,
  "jh": "99326df35496",
  "ko": "이제 괜찮은 것 같군… 언제든 좋아"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 8,
  "jh": "1ad5b1a11901",
  "ko": "좋~아, 그럼…"
 },
 {
  "key": "m64",
  "kind": 5,
  "chr": -1,
  "jh": "1e5ac13363e1",
  "ko": "이어서 연금술과 학생들에게 졸업장을 수여하겠습니다"
 },
 {
  "key": "m65",
  "kind": 0,
  "chr": 20,
  "jh": "32c12735f5d5",
  "ko": "좋아. 후딱 나눠 주마. 불린 녀석은 한 명씩 앞으로 나와라. 우선…"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 18,
  "jh": "3ce7dbf90b09",
  "ko": "후우… 드디어 졸업인가요…"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 13,
  "jh": "0774f94d4e69",
  "ko": "수고하셨습니다. 올해는 이래저래 힘들었죠"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 18,
  "jh": "1d100f7e6b3b",
  "ko": "당신이 데려온 신임 교감 선생님 덕분에요"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 13,
  "jh": "ac56195e128a",
  "ko": "아니 뭐, 그건… 아, 아하하하하"
 },
 {
  "key": "m70",
  "kind": 2,
  "chr": 18,
  "jh": "bd0fd2929487",
  "ko": "뭐 좋아요. 힘든 일도 있었지만 나름대로 즐거웠던 것도 사실이에요"
 },
 {
  "key": "m71",
  "kind": 2,
  "chr": 13,
  "jh": "07b83d5de389",
  "ko": "그렇게 말씀해 주시니…"
 },
 {
  "key": "m72",
  "kind": 2,
  "chr": 18,
  "jh": "e4de27668752",
  "ko": "하지만 올해는 예상 이상으로 예산을 써 버렸어요. 내년엔 엄격하게 갈 거예요"
 },
 {
  "key": "m73",
  "kind": 2,
  "chr": 13,
  "jh": "9ae9ff1fe9b6",
  "ko": "살살 부탁드립니다…"
 },
 {
  "key": "m74",
  "kind": 2,
  "chr": 20,
  "jh": "6051491d46f9",
  "ko": "이걸로 전원인가. 이러니저러니 해도 용케 이만큼이나 졸업했군"
 },
 {
  "key": "m75",
  "kind": 2,
  "chr": 20,
  "jh": "4a8214ee5ec7",
  "ko": "아~ 졸업했다고 해서 방심하지 마라"
 },
 {
  "key": "m76",
  "kind": 2,
  "chr": 20,
  "jh": "75ccc531a077",
  "ko": "연금술사란 건 자기 힘으로 돈을 벌게 되고부터가 진짜니까"
 },
 {
  "key": "m77",
  "kind": 2,
  "chr": 20,
  "jh": "de72ca788e7b",
  "ko": "뭐, 그게… 일단 관례니까 말해 주마. 졸업, 축하한다"
 },
 {
  "key": "m78",
  "kind": 5,
  "chr": -1,
  "jh": "bac88a69437b",
  "ko": "이어서 전투기술과 학생들에게 졸업장을 수여하겠습니다"
 },
 {
  "key": "m79",
  "kind": 0,
  "chr": 12,
  "jh": "99f918d5fc5a",
  "ko": "음!"
 },
 {
  "key": "m80",
  "kind": 2,
  "chr": 12,
  "jh": "77f1788ed88b",
  "ko": "자… 네놈들에겐 이 1년간 싸움이란 무엇인지 가르쳐 주었다만…"
 },
 {
  "key": "m81",
  "kind": 2,
  "chr": 12,
  "jh": "19ca265e440c",
  "ko": "…그렇기에 말 안 해도 알고 있겠지?"
 },
 {
  "key": "m82",
  "kind": 0,
  "chr": 83,
  "jh": "0ded5105682d",
  "ko": "어…?"
 },
 {
  "key": "m83",
  "kind": 0,
  "chr": 95,
  "jh": "0df3969acf70",
  "ko": "설마…?"
 },
 {
  "key": "m84",
  "kind": 0,
  "chr": 12,
  "jh": "f13ecffe2459",
  "ko": "그렇다. 이 졸업장, 공짜로 줄 수는 없다"
 },
 {
  "key": "m85",
  "kind": 0,
  "chr": 12,
  "jh": "7f9177e7b9b7",
  "ko": "원하는 놈은 이 몸과 싸워서 멋지게 쟁취해 봐라!!"
 },
 {
  "key": "m86",
  "kind": 0,
  "chr": 106,
  "jh": "8215c12f4958",
  "ko": "역시냐!!"
 },
 {
  "key": "m87",
  "kind": 0,
  "chr": 94,
  "jh": "bf79ce65cbeb",
  "ko": "그, 그런… 어떡해? 군나르 선생님이랑 싸우다니…"
 },
 {
  "key": "m88",
  "kind": 0,
  "chr": 107,
  "jh": "84a45ca13dea",
  "ko": "아니… 우리도 이 1년을 버텨 왔어. 지금이라면 어쩌면…"
 },
 {
  "key": "m89",
  "kind": 0,
  "chr": 81,
  "jh": "97ec1f5ebf7a",
  "ko": "그렇지… 게다가 이건 군나르 선생님한테 앙갚음할 마지막 기회잖아!"
 },
 {
  "key": "m90",
  "kind": 0,
  "chr": 18,
  "jh": "261d4d94a637",
  "ko": "무, 무슨 소리를 하는 거예요! 그만두세요! 엄숙한 졸업식에서 이런…"
 },
 {
  "key": "m91",
  "kind": 0,
  "chr": 13,
  "jh": "df19489086ac",
  "ko": "그, 그래! 토니 선생, 자네도 말려 줘!"
 },
 {
  "key": "m92",
  "kind": 0,
  "chr": 20,
  "jh": "20170e94ee5e",
  "ko": "아니~ 이건 이제 무리지…"
 },
 {
  "key": "m93",
  "kind": 0,
  "chr": 12,
  "jh": "545fd61ef32f",
  "ko": "자, 한 명씩이라고는 안 하마! 전원 한꺼번에 덤벼라!"
 },
 {
  "key": "m94",
  "kind": 5,
  "chr": 39,
  "jh": "286b0bd5d9fe",
  "ko": "우오오오오오오!!"
 },
 {
  "key": "m95",
  "kind": 2,
  "chr": 7,
  "jh": "18aee9466b38",
  "ko": "얍~! 일등~!"
 },
 {
  "key": "m96",
  "kind": 2,
  "chr": 12,
  "jh": "c4714b5ecf29",
  "ko": "오오, 날카로운 발차기로군. 하지만 아직 멀었다!!"
 },
 {
  "key": "m97",
  "kind": 2,
  "chr": 7,
  "jh": "577e738faa97",
  "ko": "으악, 큰일이다! 필살, 대타 배리어~!"
 },
 {
  "key": "m98",
  "kind": 2,
  "chr": 8,
  "jh": "76298e55dcdc",
  "ko": "야! 날 방패로 쓰지 마! 으, 으아아아!?"
 },
 {
  "key": "m99",
  "kind": 2,
  "chr": 18,
  "jh": "b701f57d3e40",
  "ko": "아아아… 졸업식이… 이런…"
 },
 {
  "key": "m100",
  "kind": 2,
  "chr": 13,
  "jh": "92b3e8fa457b",
  "ko": "와아!? 이사장님, 정신 차리세요!!"
 },
 {
  "key": "m101",
  "kind": 2,
  "chr": 20,
  "jh": "aaf0dac4ffc4",
  "ko": "칫, 재밌어 보이잖아… 야, 군나르! 나도 끼워라!"
 },
 {
  "key": "m102",
  "kind": 2,
  "chr": 12,
  "jh": "20f462879eed",
  "ko": "오, 네놈도 하겠나. 이 몸의 발목 잡지 마라!"
 },
 {
  "key": "m103",
  "kind": 2,
  "chr": 20,
  "jh": "7a97ea969285",
  "ko": "웃기지 마! 내가 누군 줄 알고!"
 },
 {
  "key": "m104",
  "kind": 2,
  "chr": 1,
  "jh": "c7f4e3ed9497",
  "ko": "토니 선생님도 하는구나… 이건 기회야! 가자, 클로에!"
 },
 {
  "key": "m105",
  "kind": 2,
  "chr": 2,
  "jh": "7521026a796a",
  "ko": "응… 그래도 이렇게 대인원이면 주술 쓰기 힘든데…"
 },
 {
  "key": "m106",
  "kind": 2,
  "chr": 5,
  "jh": "a51b46d90101",
  "ko": "푸니! 푸니니~!!"
 },
 {
  "key": "m107",
  "kind": 2,
  "chr": 23,
  "jh": "3c1101fa5bbd",
  "ko": "전투과 학생은 그대로 돌격! 연금술과 학생은 좌우로 돌아 들어가라!"
 },
 {
  "key": "m108",
  "kind": 2,
  "chr": 23,
  "jh": "b276287650bd",
  "ko": "라고 여동생이 지시하고 있어요~!"
 },
 {
  "key": "m109",
  "kind": 2,
  "chr": 6,
  "jh": "ece5dab98966",
  "ko": "우와아. 재밌겠다. 이 몸들도 가자~!"
 },
 {
  "key": "m110",
  "kind": 2,
  "chr": 9,
  "jh": "4fc254ba9066",
  "ko": "그래, 네 등은 내가 지킬게. 이제 전위 한 명만 더 있으면 든든할 텐데…"
 },
 {
  "key": "m111",
  "kind": 2,
  "chr": 4,
  "jh": "2cefde0b848a",
  "ko": "…알았다. 어울려 주면 되는 거겠지"
 },
 {
  "key": "m112",
  "kind": 2,
  "chr": 0,
  "jh": "12647f594a88",
  "ko": "끝까지 이 소동인가… 정말이지…"
 },
 {
  "key": "m113",
  "kind": 2,
  "chr": 3,
  "jh": "10296d96d96c",
  "ko": "로제, 뭘 멍하니 있어! 이대로면 졸업 못 해!"
 },
 {
  "key": "m114",
  "kind": 2,
  "chr": 11,
  "jh": "359823433ca0",
  "ko": "맞아요. 자, 저희도 도울게요"
 },
 {
  "key": "m115",
  "kind": 2,
  "chr": 0,
  "jh": "2999ac5f3d17",
  "ko": "이런이런… 뭐, 어차피 마지막이다. 마음껏 날뛰어 주마!"
 },
