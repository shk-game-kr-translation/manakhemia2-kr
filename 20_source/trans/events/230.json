[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "3e74006b585b",
  "ko": "다들 모여! 이 애 특훈에 대해 중요한 얘기가 있어!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "a0c3570c64cd",
  "ko": "특훈…? 그러고 보니 그런 말 했던 것 같기도… 그래서?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "1cceaf6cbdcc",
  "ko": "어떻게 특훈하면 좋을지 전혀 생각이 안 나"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "f7e7ab3929cb",
  "ko": "그래서 다들 아이디어를… 어라? 에나는 어디 갔어?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 2,
  "jh": "52f42574bcd6",
  "ko": "볼일 있대… 그게 아니어도 쉬는 날까지 얼굴 내밀기 싫대"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "de1429e95499",
  "ko": "해이하네. 의욕이 안 느껴져. 의욕이!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 2,
  "jh": "897a537da464",
  "ko": "…의욕에 대해 울리카한테 듣는 건 억울하겠지만…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "d39b6fd66ef2",
  "ko": "자자. 특훈이라면 이 몸에게 맡겨 줘. 스승님 밑에서 실컷 해 왔으니까"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 9,
  "jh": "88e716197d57",
  "ko": "페페론만큼은 아니지만 나도 특훈에 대해선 여러 경험이 있어"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "2cb0c8e90b61",
  "ko": "오, 웬일로 든든하네. 어떤 걸 해 왔어?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 9,
  "jh": "ca21f0340712",
  "ko": "우선 말이야, 꽃병이나 항아리 같은 도자기 파편을 잔뜩 준비해"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 9,
  "jh": "bba14779e415",
  "ko": "그걸 깔고 그 위에 누워서 많은 사람한테 밟히는 거야"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 9,
  "jh": "09d2c149195d",
  "ko": "조금이라도 방심하면 등이 구멍투성이가 되는 구조지"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "b4dc51c287b5",
  "ko": "그거 채용"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "b9b2e0fe4a9f",
  "ko": "아, 안 돼! 그런 거 하면 이 애가 아프잖아!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 9,
  "jh": "1e0c30210448",
  "ko": "괜찮아. 난 찰과상 하나 안 입었는걸"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "279f993de2f9",
  "ko": "넌 탈인형이니까 그렇지! 정말, 페페론은?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 6,
  "jh": "16c0b32006b0",
  "ko": "그렇지. 일단 큰 돌이 있으면 되려나"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 6,
  "jh": "14f51bf4379d",
  "ko": "그래서 그걸 몸에 묶고 연못 한가운데에 밀어 넣는 거야"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 6,
  "jh": "0a48a69cca2d",
  "ko": "기분은 살짝 DEAD or DIE!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 2,
  "jh": "e89fcf162672",
  "ko": "그걸로 결정"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "d6f0b80e180e",
  "ko": "안 되는 게 뻔하잖아! 애초에 그거 둘 다 죽었잖아!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 6,
  "jh": "3b3c3cf43747",
  "ko": "괜찮아. 이 몸은 멀쩡하고. 아, 그래도 착한 어린이는 따라 하지 마!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "efa20ccdc9c7",
  "ko": "그럼 처음부터 말하지 마! 아~ 역시 쓸모없어…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 2,
  "jh": "0c2a177e554d",
  "ko": "물어볼 상대를 잘못 고른 거야…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "0369e499f57e",
  "ko": "그래도 달리 물어볼 사람이라면… 선생님들한테라도 물어볼까"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 2,
  "jh": "0c8898748d07",
  "ko": "그것도 믿을 수 없을 것 같은데…"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 9,
  "jh": "d976d42299db",
  "ko": "50m 폭포에서 떨어졌을 땐 아무리 나라도 끝인 줄 알았어…"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 6,
  "jh": "b817b54b17dd",
  "ko": "이 몸은 매일 밥에 독이 조금씩 섞여 있어서…"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 6,
  "jh": "77adae5d4111",
  "ko": "뭐, 덕분에 편식이 없어졌지만!"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 1,
  "jh": "caef17b1e0f3",
  "ko": "언제까지 하는 거야! 두고 간다"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 2,
  "jh": "cd63bc971c0f",
  "ko": "말 걸지 말고 두고 가 버리면 됐을 텐데…"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 15,
  "jh": "61e5171f97fb",
  "ko": "저 녀석들이구나. 루가 말한 건… 별것 없어 보이잖아"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 15,
  "jh": "5d7141f1e504",
  "ko": "그래도 여기선 남의 눈에 띄겠네… 좀 상황을 보다가…"
 },
 {
