[
 {
  "key": "m0",
  "kind": 2,
  "chr": 7,
  "jh": "139fce9738d6",
  "ko": "좋은 아침~! 자, 오늘도 성실하게 공부하자~!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "1a153d4f14b3",
  "ko": "네가 공부하는 모습은 본 적이 없는데"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 7,
  "jh": "a169ad314d26",
  "ko": "뭘 모르네. 살아 있으면 하루하루가 공부인 거야"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 7,
  "jh": "4e65efe660ac",
  "ko": "오, 나 방금 좋은 말 했지?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 0,
  "jh": "2ffe74520785",
  "ko": "말이나 해라… 응?"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 35,
  "jh": "ebccc3e70347",
  "ko": "멈춰라"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 0,
  "jh": "147870607ad7",
  "ko": "뭐야, 넌… 마나, 인가?"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 35,
  "jh": "98ed0a754663",
  "ko": "여기를 지나가게 할 수는 없다. 순순히 돌아가면 그만. 그렇지 않으면…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 7,
  "jh": "356810fd37ae",
  "ko": "에? 에? 왜? 우린 여기…"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 35,
  "jh": "df4d807fff13",
  "ko": "물러서지 않겠다면 할 수 없지… 각오해라!"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 0,
  "jh": "5b524ccbe482",
  "ko": "쳇, 그쪽이 그럴 생각이라면!"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 7,
  "jh": "c274e389aac0",
  "ko": "우왓!? 그게 뭐야? 멋있다!"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 35,
  "jh": "8c26930117fe",
  "ko": "수상한 무기를 쓰는군… 기분 나쁜 빛이다"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 35,
  "jh": "ea61a3d6da82",
  "ko": "뭐지…? 정면으로 맞으면 위험한가…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "145b9f88df82",
  "ko": "젠장, 요리조리 빠져나가기는…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 7,
  "jh": "6491c923cb09",
  "ko": "있잖아 있잖아. 그 무기 뭐야!? 나도 갖고 싶어! 있잖아~!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "b19f8b489593",
  "ko": "너도 좀 진지하게 싸워!"
 },
 {
  "key": "m17",
  "kind": 5,
  "chr": 3,
  "jh": "3308bd2bee52",
  "ko": "어머, 무슨 소란이니?"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 0,
  "jh": "a3d0a2a9c2df",
  "ko": "아가씨"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 35,
  "jh": "dc28b302cb2f",
  "ko": "주인인가"
 },
 {
  "key": "m20",
  "kind": 5,
  "chr": 37,
  "jh": "612f6299e08c",
  "ko": "응?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "1f8fc7467418",
  "ko": "아~… 대충 짐작이 가네. 윤, 그 둘은 내 친구랑… 그… 시종이야"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 35,
  "jh": "01e9bb73a6af",
  "ko": "그런 건 미리 알려 줘. 하마터면 목숨을 주고받을 뻔했다"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "10ee960af920",
  "ko": "미안하다니까. 뭐 다행이야, 서로 다친 데도 없는 것 같고"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 0,
  "jh": "a12db0acf174",
  "ko": "아가씨, 대체 뭐예요? 이 녀석은"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 4,
  "jh": "5d110feccb39",
  "ko": "이 녀석이 아니다. 윤이라고 불러 줬으면 한다"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 3,
  "jh": "16d193b22344",
  "ko": "윤은 나랑 계약했어. 당분간 이 아틀리에에서 일하게 될 거야"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "6124775f67d7",
  "ko": "계약이라니, 아가씨에겐 이미…"
 },
 {
  "key": "m28",
  "kind": 5,
  "chr": 11,
  "jh": "28c15ca40fa6",
  "ko": "무무무무슨 말씀이세요! 아가씨!?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 11,
  "jh": "5a42ef121e95",
  "ko": "제가 있는데도 이런 어디서 굴러먹던 말 뼈다귀인지도 모를 마나와 계약이라니요!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "e1af75f329cf",
  "ko": "앗, 자, 잠깐! 진정해!"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 4,
  "jh": "5123e351d416",
  "ko": "누가 말 뼈다귀냐. 그리고 착각하지 마라. 난 돈으로 고용됐을 뿐이다"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 11,
  "jh": "afec01c211c3",
  "ko": "돈!? 지금 돈 얘기는 상관없어요! 애초에 당신이… 네, 돈으로 계약?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 3,
  "jh": "84dca0851024",
  "ko": "그래. 연금술사와 마나로서 계약한 게 아니니까 안심하렴"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 11,
  "jh": "e4d81a2f9e2c",
  "ko": "그, 그래도… 왜 돈 같은 걸?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 4,
  "jh": "3b02e5f498a8",
  "ko": "인간 세상을 살아가려면 필요하잖나? 설령 마나라 해도"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 11,
  "jh": "fa7e6bd035ce",
  "ko": "…하아. 깜짝 놀랐어요. 저는 이제 쫓겨나는 줄 알고…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 0,
  "jh": "d9fe696db889",
  "ko": "참고로 얼마에 고용하셨어요?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 3,
  "jh": "5e6c26576581",
  "ko": "500만 콜이야. 1년 계약으로"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 0,
  "jh": "ec59d427cb0f",
  "ko": "오백…!?"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 4,
  "jh": "2a6f9ff323a1",
  "ko": "당연히 각종 수당은 별도 지급이다"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 0,
  "jh": "0fe369947182",
  "ko": "당신, 나보다 몇 배를 받을 셈이야…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 0,
  "jh": "8ec668db89d1",
  "ko": "애초에 그런 거금을 들여 일손을 고용할 필요 없잖아요"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 3,
  "jh": "164daacf3969",
  "ko": "없다면 없지만… 그래도…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "06aab153607d",
  "ko": "그만큼 로제가 한가해지면 둘만의 시간이 더 생기지 않을까, 하는 생각도…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 0,
  "jh": "e7d90772b57a",
  "ko": "뭐예요? 확실히 말씀하세요"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 3,
  "jh": "43eada7b1677",
  "ko": "그러니까, 그건… 저기, 그게… 너, 너 혼자선 미덥지 못해서야!"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 0,
  "jh": "dc040b3997f2",
  "ko": "…그렇습니까. 미덥지 못한 시종이라 죄송하네요"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 3,
  "jh": "0dee8ca4622e",
  "ko": "아, 그게 아니라… 방금 건, 그만…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 7,
  "jh": "fd3637e661a8",
  "ko": "있잖아!!"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 0,
  "jh": "77efdadb8f50",
  "ko": "우왓!? 갑자기 소리 지르지 마!"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 7,
  "jh": "0832f7cafe44",
  "ko": "계속 무시하잖아! 있잖아, 아까 그 무기 뭐야!?"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 0,
  "jh": "270b4aeada0d",
  "ko": "어? 아니, 그건 말이지…"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 7,
  "jh": "6f5df458c5b3",
  "ko": "로제만 치사해! 나도 갖고 싶어!"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 0,
  "jh": "c41f191be85f",
  "ko": "그건 무기가 대단한 게 아니라, 그…"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 0,
  "jh": "248d774639c1",
  "ko": "그런 기술이야. 요전에 수업에서 배웠잖아"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 7,
  "jh": "cb0bac5ac0cc",
  "ko": "거짓말! 나 안 배웠어!"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 0,
  "jh": "9ef966e41bbe",
  "ko": "그건… 너, 졸고 있었으니까"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 7,
  "jh": "8f63fa2c8e49",
  "ko": "그래!? 우와~ 제대로 들을걸~!"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 7,
  "jh": "0546c17cdb6f",
  "ko": "로제, 나한테도 가르쳐 줘! 부탁이야!"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 0,
  "jh": "d98266c6b101",
  "ko": "아니, 나도 이제 막 할 수 있게 돼서…"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 3,
  "jh": "a6fad9b9577f",
  "ko": "잠깐. 둘이서 뭘 그렇게 신나 있는 거니?"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 7,
  "jh": "0fde00b19755",
  "ko": "정말, 방해하지 마! 볼일 있으면 그쪽 마나한테 부탁하면 되잖아"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 7,
  "jh": "26a0f49c469a",
  "ko": "로제는 미덥지 못하다며?"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 3,
  "jh": "da3c0879dc57",
  "ko": "아니, 그건 말이 헛나온 거라… 크… 왜 이렇게 되는 거야…"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 11,
  "jh": "667b8c4a88e5",
  "ko": "이런 걸 화는 입에서 나온다고 하죠"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 3,
  "jh": "bf68f0e9f10c",
  "ko": "사실은 로제를 조금이라도 편하게 해 주려던 건데… 이렇게 되다니… 흑흑…"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 11,
  "jh": "b0cd0de25443",
  "ko": "정신 차리세요. 자, 윤 씨도 멍하니 있지 말고요"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 11,
  "jh": "432dc24168dc",
  "ko": "풀 죽은 아가씨를 격려하는 것도 중요한 일이에요"
 },
 {
  "key": "m69",
  "kind": 2,
  "chr": 4,
  "jh": "4765fb979131",
  "ko": "그런 일은 내 취약 분야다만"
 },
 {
  "key": "m70",
  "kind": 0,
  "chr": 4,
  "jh": "65b63800f3d2",
  "ko": "하지만 신경 쓰이는군. 그 남자의 검…"
 },
 {
  "key": "m71",
  "kind": 5,
  "chr": -1,
  "jh": "d362711cca07",
  "ko": "「{CLRE}윤{CLNR}」이 동료가 되었습니다."
 },
 {
  "key": "m72",
  "kind": 5,
  "chr": -1,
  "jh": "3a86591804a4",
  "ko": "파티 멤버가 4명이 되어 {CLRE}대열{CLNR}을 변경할 수 있게 되었습니다."
 },
 {
  "key": "m73",
  "kind": 5,
  "chr": -1,
  "jh": "662d57b391b4",
  "ko": "{CLRE}대열{CLNR} 도움말을 보시겠습니까?"
 },
 {
  "key": "m74",
  "kind": 5,
  "chr": -1,
  "jh": "28e7f45a2a0a",
  "ko": "{CLRE}대열{CLNR}에서는 전투에 참가할 멤버를 전위와 서포트로 설정할 수 있습니다."
 },
 {
  "key": "m75",
  "kind": 5,
  "chr": -1,
  "jh": "9143ba221122",
  "ko": "전위 멤버는 처음부터 전투에 참가하는 멤버입니다."
 },
 {
  "key": "m76",
  "kind": 5,
  "chr": -1,
  "jh": "5db5b5aee40c",
  "ko": "최소 한 명의 멤버를 전위로 설정해야 합니다."
 },
 {
  "key": "m77",
  "kind": 5,
  "chr": -1,
  "jh": "0880bd93f3cf",
  "ko": "또 서포트로 설정된 멤버는 전위 멤버의 교대 요원이 되며,"
 },
 {
  "key": "m78",
  "kind": 5,
  "chr": -1,
  "jh": "cc097a288a2f",
  "ko": "{CLRE}서포트 액션{CLNR}으로 공방 중에 전위와 교대할 수 있습니다."
 },
 {
  "key": "m79",
  "kind": 5,
  "chr": -1,
  "jh": "61f5aa6677ef",
  "ko": "기본 구성은 {CLRE}전위에 세 명을 두고 나머지를 서포트로 하는{CLNR} 방법이지만,"
 },
 {
  "key": "m80",
  "kind": 5,
  "chr": -1,
  "jh": "97a8ce490b5b",
  "ko": "전투에 익숙해지면 다른 구성을 시험해 보는 것도 좋겠지요."
 },
 {
  "key": "m81",
  "kind": 5,
  "chr": -1,
  "jh": "406566478363",
  "ko": "{CLRE}서포트 액션{CLNR}에 대해서는 다음 전투에서 자세히 설명합니다."
 },
 {
  "key": "m82",
  "kind": 5,
  "chr": -1,
  "jh": "c6a550d79753",
  "ko": "「{CLRE}도움말{CLNR}」의 「{CLRE}시스템{CLNR}」에 새로운 항목이 추가되었습니다."
 },
 {
  "key": "m83",
  "kind": 5,
  "chr": -1,
  "jh": "79da7c8bf517",
  "ko": "「{CLRE}도움말{CLNR}」은 메뉴의 「{CLRE}도감{CLNR}」에서 확인할 수 있습니다."
 },
 {
  "key": "m84",
  "kind": 5,
  "chr": -1,
  "jh": "6c3c7e1e03e2",
  "ko": "대열은 메뉴에서 선택할 수 있습니다."
 },
 {
  "key": "m85",
  "kind": 5,
  "chr": -1,
  "jh": "0df8accc42c0",
  "ko": "대열을 고르면 선택한 멤버가 화면처럼 깜빡입니다."
 },
 {
  "key": "m86",
  "kind": 5,
  "chr": -1,
  "jh": "5e3646e5cb14",
  "ko": "멤버 얼굴이 {CLRE}왼쪽{CLNR}이면 전위, {CLRE}오른쪽{CLNR}이면 서포트입니다."
 },
 {
  "key": "m87",
  "kind": 5,
  "chr": -1,
  "jh": "dc1f97fd840d",
  "ko": "대열 전환은 바꿀 멤버에 맞춘 상태에서 방향키 좌우로 합니다."
 },
 {
  "key": "m88",
  "kind": 5,
  "chr": -1,
  "jh": "1fa1797d6864",
  "ko": "이렇게 전위와 서포트가 바뀝니다."
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]