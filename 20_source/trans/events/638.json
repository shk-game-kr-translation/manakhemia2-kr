[
 {
  "key": "m0",
  "kind": 2,
  "chr": 6,
  "jh": "9ef4b5ab110d",
  "ko": "흐음. 그래서 그렇게 필사적으로 기계를 정비하는 거야?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 8,
  "jh": "d72b21de1460",
  "ko": "아아. 두고 봐라 그 녀석들. 반드시 울상 짓게 해 줄 거다!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 2,
  "jh": "450b71d5ace4",
  "ko": "복수는 아무것도 낳지 않아… 남는 건 허무함뿐…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 6,
  "jh": "356e5631f7ef",
  "ko": "검은 누나가 말하니까 전혀 설득력이 없네"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 9,
  "jh": "8f351b1bc829",
  "ko": "그래도 앙갚음을 위해서라지만 너무 꼼꼼하게 정비하는 거 아닌가?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 8,
  "jh": "58be37c23957",
  "ko": "왠지 상태가 안 좋아. 제대로 안 움직여"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 2,
  "jh": "1aadb02d5622",
  "ko": "에나 군, 기계 없으면 아무것도 못 하는데…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 8,
  "jh": "0c5997f42bc6",
  "ko": "시끄러워! 그러니까 지금 고치고… 아아, 안 돼! 부품이 완전히 맛이 갔어!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 9,
  "jh": "efb1160477c2",
  "ko": "고칠 수 있겠나?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 8,
  "jh": "7a2ee7d46988",
  "ko": "시간이 걸려. 하필 제일 구하기 힘든 부품이… 젠장!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "1aadb02d5622",
  "ko": "에나 군, 기계 없으면 아무것도 못 하는데…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 8,
  "jh": "938eb17f6aea",
  "ko": "시끄러워! 두 번 말하지 마!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "d9fac4eadc8f",
  "ko": "그럼, 쓸모없는 애"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "646b6f3df377",
  "ko": "무능…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 6,
  "jh": "4fcad423bcbd",
  "ko": "밥벌레"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 9,
  "jh": "b0df0e870997",
  "ko": "능력 없는 남자"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 8,
  "jh": "b8eb02d7cebc",
  "ko": "으아~! 하고 싶은 말 다 하지 마!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 6,
  "jh": "fd1256eb7ac5",
  "ko": "애초에 기계로 앙갚음한다는 게 틀린 거 아닐까"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 6,
  "jh": "843482acec1d",
  "ko": "상대는 인원이 많았지만 무기는 안 갖고 있었잖아?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 8,
  "jh": "1810544eb3f2",
  "ko": "으… 그야 그렇지만… 그래도 그 인원을 상대하려면 역시…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 9,
  "jh": "4ea5857a137c",
  "ko": "상대가 비겁하다고 비겁한 수로 갚는 건 어리석음의 극치지"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "888474801017",
  "ko": "기계도 그런 식으로 쓰이는 건 싫지 않을까. 그래서 기분이 상한 거야"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 8,
  "jh": "f561311abeb7",
  "ko": "음… 그럼 어떻게 하라는 건데!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 6,
  "jh": "f7ee8d027929",
  "ko": "뻔하지. 몸을 단련해서 정정당당하게 앙갚음하면 되는 거야!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 9,
  "jh": "c3ee2c452b7c",
  "ko": "남자의 무기는 자기 자신의 육체라고 정해져 있으니까"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 8,
  "jh": "f0d7c6eeb420",
  "ko": "그래도 몸 움직이는 건 서툴러서…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 9,
  "jh": "e2bea3895f9c",
  "ko": "서툰 걸 서툰 채로 두면 미래는 열리지 않아"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 9,
  "jh": "04139ba55d01",
  "ko": "네가 누나를 못 이기는 것도 그런 게 원인 아닐까?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 8,
  "jh": "bd017cabb95a",
  "ko": "으…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "467bf984eb83",
  "ko": "몸을 단련한 데다 기계의 힘을 쓰면 범에 날개…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 6,
  "jh": "d5e3538db988",
  "ko": "형은 지상 최강의 생물이 될 수 있을지도 몰라"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 8,
  "jh": "c48666c287ac",
  "ko": "오오!? 그 발상은 없었어… 알았어! 날 단련시켜 줘!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 6,
  "jh": "32ba30e035dc",
  "ko": "좋아! 그럼 지금부터 우리를 사부라고 불러!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 9,
  "jh": "6e1904f5ca09",
  "ko": "그럼 가 볼까! 남자 셋이 살과 살을 부딪치는 수행의 여행으로!"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 1,
  "jh": "f29554b9c2e5",
  "ko": "역시 이상한 얘기가 됐네. 예상은 했지만"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 2,
  "jh": "f36c3f3c3e70",
  "ko": "저 둘한테 넘어가다니 에나 군도 아직 애야…"
 },
