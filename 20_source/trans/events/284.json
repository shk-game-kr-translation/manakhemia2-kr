[
 {
  "key": "m0",
  "kind": 5,
  "chr": 81,
  "jh": "9e397471ef30",
  "ko": "꺄아아아아!!"
 },
 {
  "key": "m1",
  "kind": 5,
  "chr": 94,
  "jh": "b4b65237421e",
  "ko": "저, 정신 차려. 상처는 얕아!!"
 },
 {
  "key": "m2",
  "kind": 5,
  "chr": 101,
  "jh": "c5571d5b4509",
  "ko": "젠장! 이 괴물들이!!"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 1,
  "jh": "e58ef580b5b0",
  "ko": "응? 무슨 소란이지?"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 2,
  "jh": "df62a84e887f",
  "ko": "못 들은 척하는 게 좋을 것 같은데…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 8,
  "jh": "9613f0f3addb",
  "ko": "신경 안 쓰는 게 낫지 않냐. 또 귀찮은 일에 휘말린다"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 1,
  "jh": "58626f3e1795",
  "ko": "좋아, 잠깐 보러 가자!"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 2,
  "jh": "92a3030c09b8",
  "ko": "남의 말을 하나도 안 듣는다니까…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 8,
  "jh": "e578c935290b",
  "ko": "라고 해도 안 듣네. 어쩔 수 없지…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "328a007f1ece",
  "ko": "벌써 끝이야? 손맛이 없네"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 9,
  "jh": "972b47433397",
  "ko": "역시 우린 너무 강한가 봐. 하물며 셋이 손을 잡았으니…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 4,
  "jh": "acc6969632c7",
  "ko": "후… 설마 이 학원에서 등을 맡길 수 있는 사내들을 만나게 될 줄이야"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 9,
  "jh": "ff782127b512",
  "ko": "이런, 새 손님이 오신 것 같군"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "695916d492a2",
  "ko": "너희! 뭐 하는 거야?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 4,
  "jh": "37811ce7de1b",
  "ko": "교감에게 고용되어 한바탕 일하고 있었을 뿐이다"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 9,
  "jh": "da398d9403ff",
  "ko": "이 싸움에 어울리지 않는 약한 학생들을 배제하라고 해서 말이야"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 6,
  "jh": "d3f5bf9f2329",
  "ko": "우리가 보기엔 약한 학생들뿐이지만!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 2,
  "jh": "331e6746d927",
  "ko": "…딱 그 선생님이 생각할 법한…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 8,
  "jh": "45a28121729d",
  "ko": "하필이면 이 셋을 짜게 한 거냐…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "e1f5f2589e34",
  "ko": "그 말은 즉… 우리랑도 싸운다는 거야?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 4,
  "jh": "9936aeecb6e4",
  "ko": "너희와는 여러모로 인연도 있으니. 봐줘도 되지만…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "72bb64d05689",
  "ko": "…가능하면 그 말에 기대고 싶지만…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 8,
  "jh": "1d2546d0d37f",
  "ko": "누나. 모처럼 이렇게 말해 주는데…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "9d192972cb65",
  "ko": "무슨 소리야. 좋잖아, 모처럼의 축제인데"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "35bd1cae62a5",
  "ko": "이런 기회가 아니면 너희랑 싸울 일은 없을 테니까"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 6,
  "jh": "fb8583d38060",
  "ko": "그래야지! 약한 상대만 있으면 우리도 맥이 빠지거든"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 9,
  "jh": "fcf9bbea0f74",
  "ko": "그럼 사양 않고… 진심으로 가겠어!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 6,
  "jh": "485404160662",
  "ko": "어, 어라? 져 버렸네?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "00643b5e70ec",
  "ko": "뭐야, 말만 번지르르하잖아"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 2,
  "jh": "8afe53198163",
  "ko": "솔직히 기대 이하… 허울만 좋아도 정도가 있지…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 8,
  "jh": "4df0c061230f",
  "ko": "왠지 생각보다 전혀 안 셌네…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 9,
  "jh": "34a137eed579",
  "ko": "…후, 훌륭했어. 진심은 아니었다지만 설마 우리를 쓰러뜨릴 줄이야"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 6,
  "jh": "bcadbcda845a",
  "ko": "어? 이 몸은 꽤 진심이었는데…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 9,
  "jh": "3113064f2b07",
  "ko": "쉿! 여기선 상대 역량을 가늠하면서 일부러 져 줬다는 설정으로 하는 거야"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 6,
  "jh": "54f9fe24f8df",
  "ko": "과, 과연! 그러면 왠지 폼이 나겠네!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 1,
  "jh": "09c527ce114c",
  "ko": "…다 들리거든"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 4,
  "jh": "6a48116fea65",
  "ko": "일단 말해 두지만 난 정말 진심이 아니었다"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 4,
  "jh": "e04a6f901766",
  "ko": "모든 학생을 쓰러뜨리라고 의뢰받은 것도 아니니까"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 1,
  "jh": "967e09640d9f",
  "ko": "네네, 그런 걸로 해 둘게"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 1,
  "jh": "32994dee0b66",
  "ko": "아~… 왠지 보통으로 져 버렸네…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 2,
  "jh": "67859219d715",
  "ko": "…이런 장난 같은 사람들이 보통으로 강하다니… 세상이 잘못됐어…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 8,
  "jh": "2a5ae9f259f5",
  "ko": "무슨 이상한 짓을 해 올까 했는데 보통으로 강했네…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 6,
  "jh": "833135771ad8",
  "ko": "그렇게 보통을 강조하지 않아도 되잖아~"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 9,
  "jh": "b85dc4188cc7",
  "ko": "뭐, 가끔은 우리도 할 땐 한다는 걸 보여 줘야지"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 4,
  "jh": "76294cb31e0b",
  "ko": "일단 말해 두지만 난 원래 보통이다. 이상한 건 이 녀석들 둘뿐이니까"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]