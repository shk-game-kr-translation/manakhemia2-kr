[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "3d84e5af6fc3",
  "ko": "으으… 하아… 어, 어때…?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 11,
  "jh": "90bc51b7e2df",
  "ko": "대단해요, 아가씨! 이 짧은 기간에 용케 여기까지…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "d1b918cfa1ba",
  "ko": "후, 우후후… 이 한 달 동안 거의 먹지도 마시지도 않았는걸…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 11,
  "jh": "0c6e265ebfae",
  "ko": "저도 힘들었어요… 아가씨가 배고픈 나머지 저를 깨물려고 하시고"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 11,
  "jh": "4294546fa0fd",
  "ko": "과자 먹는 학생한테 달려들려는 걸 필사적으로 말리고…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 3,
  "jh": "d0c1e16c6dc9",
  "ko": "그 고생도 오늘로 끝이야… 로제에게 아름다워진 내 모습을 보이면…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 0,
  "jh": "5a3c5f71eeac",
  "ko": "좋은 아침입니다"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 11,
  "jh": "2f0c2fba46b8",
  "ko": "아, 로제 씨! 마침 잘 오셨어요!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 0,
  "jh": "290066d7b9b4",
  "ko": "응? 무슨 볼일 있었어?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 11,
  "jh": "da75522d88c2",
  "ko": "제가 아니라요. 아가씨가… 자, 아가씨를 봐 주세요!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 3,
  "jh": "dc3407d51164",
  "ko": "후후, 로제… 어때, 지금 내 모습?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "c6eceb90076b",
  "ko": "어떠냐고 해도… 평소랑 똑같은데요?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 3,
  "jh": "c5880725ee39",
  "ko": "어…? 그, 그럴 리 없잖아! 자, 더 잘 봐!!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 11,
  "jh": "4f5ce1dcb66a",
  "ko": "봐요, 로제 씨. 전이랑 확실히 다르잖아요? 네?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "223f15addbd7",
  "ko": "그렇게 말해도… 아, 머리 자르셨어요?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "a6d4378b5fd4",
  "ko": "안 잘랐어!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "4784a389fda0",
  "ko": "음~ 그럼… 화장품 바꾸셨어요?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "e2eb7c31f082",
  "ko": "안 바꿨어! 자, 있잖아! 더 알기 쉬운 게!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 0,
  "jh": "590ebcf190ce",
  "ko": "알기 쉬운…? 아, 왠지 안색이 안 좋으시네요"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "6097a997d707",
  "ko": "뭐야, 몸이 안 좋아서 쉬고 싶다는 거예요? 그럼 그렇게 말씀하시지"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "10e9e224570a",
  "ko": "아, 아니야! 확실히 몸은 안 좋지만…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "53067f7bc163",
  "ko": "그럼 무리하지 말고 쉬세요. 다른 녀석들한텐 제가 말해 둘게요"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 3,
  "jh": "a8ec1a456a6d",
  "ko": "어… 어째서 살찐 건 알아채면서 빠진 건 모르는 거야…"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 11,
  "jh": "909985bf4136",
  "ko": "로제 씨의 둔감함은 저희 상상을 엇나가게 뛰어넘네요…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 11,
  "jh": "9bde67a66fb1",
  "ko": "아가씨!? 정신 차리세요!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "5bd001ecdbbc",
  "ko": "이, 이제 안 돼… 물을…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 11,
  "jh": "943a9e0a1a91",
  "ko": "바로 가져올게요! 그러니 제발 정신 차리세요!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
