  "chr": 1,
  "jh": "8648b3f32822",
  "ko": "자, 오긴 했는데… 그 녀석 잘 지내고 있으려나"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "cd6beea757dc",
  "ko": "이상하게 조용해… 기척이 없어…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 8,
  "jh": "0f3304dc9080",
  "ko": "삐쳐서 자고 있는 거 아니냐?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 1,
  "jh": "024ff11b6cef",
  "ko": "그런 귀여운 구석이 있을 것 같진 않은데… 응? 저기… 누가 쓰러져 있어!?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 9,
  "jh": "92953a617a9a",
  "ko": "페페론의 스승님이다!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "cb78f1eb1cc8",
  "ko": "왜 그래!? 괜찮아!?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 30,
  "jh": "bcbe608d3068",
  "ko": "으… 아아, 너희냐…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 9,
  "jh": "e34a4a0dfc09",
  "ko": "누구한테 당한 거지? 설마… 페페론은 어디에!?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 30,
  "jh": "6c529d0543fe",
  "ko": "내가 깜빡하고 있었다…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 30,
  "jh": "4ca9d62c51a8",
  "ko": "그 녀석은 남이 차갑게 대하면 외로움에 흉포해지는…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "054a3d96d06e",
  "ko": "민폐인 설정…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 8,
  "jh": "e56984545f30",
  "ko": "결국 지켜보든 눈을 떼든 문제를 일으키는구나"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 30,
  "jh": "4ac4fc76f35f",
  "ko": "탓하지 말아 줘… 그 녀석이 나쁜 게 아니야, 태어나고 자란 환경이… 나빴던 거야…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 30,
  "jh": "f1e194fdf695",
  "ko": "부탁한다. 그 녀석을 막아 줘… 막을 수 있는 건 당신밖에 없어…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "2dae1119b779",
  "ko": "뭐, 왜 나야?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 30,
  "jh": "766c78968d95",
  "ko": "부탁, 한…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 8,
  "jh": "0f21e6244db9",
  "ko": "…정신을 잃었네"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "f106c7045a81",
  "ko": "말하다가 기절이라니 정말 봐줬으면 좋겠어… 물이라도 끼얹을까"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 9,
  "jh": "2c71f527cde4",
  "ko": "자자, 부상자니까 온건하게"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 2,
  "jh": "b1650ccff744",
  "ko": "그리하여 세계의 평화는 한 소녀에게 맡겨졌던 것이었다…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "2bdf48bcceb6",
  "ko": "너 말이야, 이상한 내레이션 붙이는 거 그만…"
 },
 {
  "key": "m21",
  "kind": 5,
  "chr": 6,
  "jh": "0c3fba52577f",
  "ko": "그오오오오오오오오오!!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "87c2fd62dbbc",
  "ko": "방금 그거…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 9,
  "jh": "f3cdca44a3a9",
  "ko": "페페론 목소리군. 틀림없이"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 8,
  "jh": "d1b923562b0b",
  "ko": "…농담이지? 괴물 같은 목소리였는데?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "5c9ec9eb605d",
  "ko": "저걸 나보고 막으라고? …어떻게?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 9,
  "jh": "b7a99b2c15c0",
  "ko": "글쎄… 스승님이니까 그 자리 분위기로 대충 말했을지도 모르고"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "33c9cb81db90",
  "ko": "만약 그렇다면 내 입장은…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 2,
  "jh": "99e85c0c4cbf",
  "ko": "과연 소녀의 운명은 어떻게…!?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "4b69c17e0ecb",
  "ko": "그러니까 그거 그만하라고 했잖아!"
 },
