[
 {
  "key": "m0",
  "kind": 5,
  "chr": 81,
  "jh": "9e397471ef30",
  "ko": "꺄아아아아!!"
 },
 {
  "key": "m1",
  "kind": 5,
  "chr": 94,
  "jh": "b4b65237421e",
  "ko": "저, 정신 차려. 상처는 얕아!!"
 },
 {
  "key": "m2",
  "kind": 5,
  "chr": 101,
  "jh": "c5571d5b4509",
  "ko": "젠장! 이 괴물들이!!"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 0,
  "jh": "bd66e4100aa7",
  "ko": "무슨 소란이지?"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 3,
  "jh": "34de1ab794ef",
  "ko": "신경 쓰이네… 가 보자"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 5,
  "jh": "c855dcd1797b",
  "ko": "푸니~… 푸니!"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 23,
  "jh": "01cfdd0e85cb",
  "ko": "싸움의 기척이 난다… 안 갈 수 없지! 라고 여동생이 들뜬 마음을 억누르지 못하고 있어요"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 7,
  "jh": "9ef608a9361e",
  "ko": "왠지 재밌을 것 같은 예감… 가 보자!"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 0,
  "jh": "10185f9e7041",
  "ko": "내버려 두는 게 좋지 않을까… 라니, 가 버렸나. 어쩔 수 없군…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "328a007f1ece",
  "ko": "벌써 끝이야? 손맛이 없네"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 9,
  "jh": "972b47433397",
  "ko": "역시 우린 너무 강한가 봐. 하물며 셋이 손을 잡았으니…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 4,
  "jh": "acc6969632c7",
  "ko": "후… 설마 이 학원에서 등을 맡길 수 있는 사내들을 만나게 될 줄이야"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 9,
  "jh": "ff782127b512",
  "ko": "이런, 새 손님이 오신 것 같군"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 11,
  "jh": "accb2709cdc7",
  "ko": "윤 씨 아니에요? 그리고 다른 두 분은…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 5,
  "jh": "48a500235a7a",
  "ko": "푸니!? 푸니니~!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 23,
  "jh": "0d20d3464bcc",
  "ko": "뜻밖의 조합을 보고 여동생이 놀라고 있어요"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 7,
  "jh": "67d3571f4f18",
  "ko": "어라, 윤이다. 그리고 울리카네 아틀리에의…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 0,
  "jh": "ab42b693dae3",
  "ko": "뭘 하는 거야, 너희…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 4,
  "jh": "37811ce7de1b",
  "ko": "교감에게 고용되어 한바탕 일하고 있었을 뿐이다"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 9,
  "jh": "da398d9403ff",
  "ko": "이 싸움에 어울리지 않는 약한 학생들을 배제하라고 해서 말이야"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 6,
  "jh": "d3f5bf9f2329",
  "ko": "우리가 보기엔 약한 학생들뿐이지만!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "666e8ae7dc30",
  "ko": "딱 그 교감이 생각할 법한 일이네…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 5,
  "jh": "a8bb04758039",
  "ko": "푸니, 푸니니니… 푸니"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 23,
  "jh": "45ad58bd2622",
  "ko": "힘의 페페론, 기술의 윤, 그리고 수비의 고토…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 23,
  "jh": "d47288f03b92",
  "ko": "확실히 손을 잡으면 이보다 무서운 상대는 없다. 라고 여동생도 전율하고 있어요"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 7,
  "jh": "07602e6a3c30",
  "ko": "좋겠다~ 왠지 그쪽이 더 재밌어 보여…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 0,
  "jh": "6f1694eaa417",
  "ko": "그러니까 우리랑도 싸운다는 거냐?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 4,
  "jh": "9936aeecb6e4",
  "ko": "너희와는 여러모로 인연도 있으니. 봐줘도 되지만…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "fcb450b783ce",
  "ko": "어머, 꽤나 주인을 생각해 주네. 그런데 모욕당하는 것처럼 들리는 건 왜일까?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 5,
  "jh": "36af5a93ca88",
  "ko": "푸니! 푸니니니니!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 23,
  "jh": "f9571a8c331b",
  "ko": "얕보지 마! 푸니요는 상대가 강할수록 불타는 타입이다! 라고 여동생이 격분하고 있어요"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 7,
  "jh": "4b3ed310d010",
  "ko": "에~ 왜? 싸우자! 모처럼인데"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "04ccdfbecd98",
  "ko": "…유감이지만 이쪽은 의욕 만만인 모양이다"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 6,
  "jh": "fb8583d38060",
  "ko": "그래야지! 약한 상대만 있으면 우리도 맥이 빠지거든"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 9,
  "jh": "fcf9bbea0f74",
  "ko": "그럼 사양 않고… 진심으로 가겠어!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 6,
  "jh": "485404160662",
  "ko": "어, 어라? 져 버렸네?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 3,
  "jh": "8cf70bdcc9c0",
  "ko": "말만 번지르르하네. 뭐, 우리가 상대니 어쩔 수 없겠지만"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 5,
  "jh": "d0c0af3c06da",
  "ko": "푸니. 푸우~"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 23,
  "jh": "1f9cd5eccc9a",
  "ko": "기대 이하였다… 라고 여동생도 실망하고 있어요"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 7,
  "jh": "6734728b311f",
  "ko": "뭐~야. 별거 아니잖아. 기대해서 손해 봤다"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 9,
  "jh": "34a137eed579",
  "ko": "…후, 훌륭했어. 진심은 아니었다지만 설마 우리를 쓰러뜨릴 줄이야"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 6,
  "jh": "bcadbcda845a",
  "ko": "어? 이 몸은 꽤 진심이었는데…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 9,
  "jh": "3113064f2b07",
  "ko": "쉿! 여기선 상대 역량을 가늠하면서 일부러 져 줬다는 설정으로 하는 거야"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 6,
  "jh": "54f9fe24f8df",
  "ko": "과, 과연! 그러면 왠지 폼이 나겠네!"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 0,
  "jh": "a436b78b5df5",
  "ko": "다 들리거든…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 4,
  "jh": "6a48116fea65",
  "ko": "일단 말해 두지만 난 정말 진심이 아니었다"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 4,
  "jh": "e04a6f901766",
  "ko": "모든 학생을 쓰러뜨리라고 의뢰받은 것도 아니니까"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 0,
  "jh": "19c459bed8dc",
  "ko": "…당신도 꽤 지기 싫어하는군"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 0,
  "jh": "7980956d798a",
  "ko": "크… 보통으로 졌다…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 3,
  "jh": "5b0ad478fc3f",
  "ko": "그런… 이런 장난 같은 사람들이 보통으로 강하다니…"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 23,
  "jh": "33f538d6e5a4",
  "ko": "어떤 웃긴 공격을 해 올까 했더니 보통으로 강해서 깜짝 놀랐다…"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 23,
  "jh": "913acdf556f5",
  "ko": "라고 여동생이 놀란 감상을 말하고 있어요"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 7,
  "jh": "2846578e6f27",
  "ko": "우와~ 져 버렸다… 보통으로 세…"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 6,
  "jh": "833135771ad8",
  "ko": "그렇게 보통을 강조하지 않아도 되잖아~"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 9,
  "jh": "b85dc4188cc7",
  "ko": "뭐, 가끔은 우리도 할 땐 한다는 걸 보여 줘야지"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 4,
  "jh": "76294cb31e0b",
  "ko": "일단 말해 두지만 난 원래 보통이다. 이상한 건 이 녀석들 둘뿐이니까"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]