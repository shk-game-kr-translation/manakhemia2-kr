[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "a8c16b1995dc",
  "ko": "재료는 다 모였네. 자, 서둘러 마무리하자"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "0ef696925fa4",
  "ko": "대체 뭘 만들 생각이세요?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "42e7ed88b93d",
  "ko": "최루탄이야"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 5,
  "jh": "8b86926363e7",
  "ko": "푸니?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 23,
  "jh": "b5b499db6f11",
  "ko": "최루탄이란 건 연기로 상대를 울려 버리는 폭탄이야"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 4,
  "jh": "9ad3b231f07f",
  "ko": "대량의 적을 무력화하는 데 유효한 수단이군"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 11,
  "jh": "3f4dc1a88f28",
  "ko": "괜찮은 거예요? 학교 안에서 그런 걸 쓰다니…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 3,
  "jh": "870108fed3d3",
  "ko": "괜찮겠지. 독이 들어간 것도 아니고"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 4,
  "jh": "efb3d05d6b10",
  "ko": "조금쯤 넣는 편이 더 효과적일지도 모른다"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 11,
  "jh": "2845cf8a668c",
  "ko": "안 돼요! 에토 씨가 잡혀 있을지도 모른다고요?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 4,
  "jh": "30e78837431b",
  "ko": "가벼운 농담이다. 유머를 모르는 녀석이군"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 11,
  "jh": "198bd620dc83",
  "ko": "윤 씨한테 유머 얘길 들어도…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 3,
  "jh": "3ae4e3d2e0fb",
  "ko": "뭐, 이번엔 독 없이 갈게. 시간도 별로 없으니까…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 3,
  "jh": "7ef56f39e351",
  "ko": "다 됐어! 이름하여… 전술적 투척 최루탄 시제 1형!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "92386858c7f3",
  "ko": "…질실강건한 이름이네요"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 11,
  "jh": "123783bbd291",
  "ko": "여자애답지 않아요. 좀 더 귀여운 이름을 생각하는 게…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 4,
  "jh": "fd979ef6fd16",
  "ko": "여성스러움이 없는 게 오히려 주인답다고 생각한다만"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "8912dd39c54a",
  "ko": "그건 은근히 내가 여자답지 않다는 거니?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "b2899a4fe775",
  "ko": "흐음, 그럼… 「사랑스러운 그 애를 울려 버리는 폭탄」 같은 건 어때?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "eebbb76978a0",
  "ko": "………아가씨가 그걸로 좋으시다면"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 4,
  "jh": "d4365a0b48b9",
  "ko": "큰 소리로 그 이름을 외치면 적이 움츠러들지도 모르겠군. 다른 의미로"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 3,
  "jh": "762a79395d59",
  "ko": "뭐, 뭐야, 그 반응은! 네가 이상한 소리를 하니까!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 11,
  "jh": "46859d5ac7fc",
  "ko": "죄송해요. 제가 무리한 요구를 하는 바람에… 정말 죄송해요"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 3,
  "jh": "de4bc2679608",
  "ko": "사과하지 마! 오히려 비참해지잖아!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "1e1b6d27eabe",
  "ko": "됐어, 최루탄으로 해. 네네, 아무 꾸밈도 없는 이름이라 미안하네!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 11,
  "jh": "7fda9c556be0",
  "ko": "삐지지 마세요. 정말 제가 잘못했으니까요"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "39590db93a09",
  "ko": "그럼 마음 다잡고 가 볼까요…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 11,
  "jh": "5cfce9483c89",
  "ko": "왠지 미묘한 분위기가 돼 버렸네요…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 3,
  "jh": "4e1a81f8589c",
  "ko": "누구 때문이라고 생각하는 거야!"
 },
