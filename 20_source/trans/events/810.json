 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 20,
  "jh": "c0a6a9ae4d8d",
  "ko": "차가운 녀석이군. 아아, 그렇지, 넌 군나르 학생이니까"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 20,
