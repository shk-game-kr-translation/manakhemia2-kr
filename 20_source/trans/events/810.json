 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 20,
  "jh": "f7654058670a",
  "ko": "말 안 해도 알아. 오늘 수업은 커먼 스킬에 대해서다"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 20,
  "jh": "a3f677275cfe",
