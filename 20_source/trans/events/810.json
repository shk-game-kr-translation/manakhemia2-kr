 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 107,
  "jh": "01b95e97a979",
  "ko": "아아, 내용은 멀쩡하네… 다시 봤어, 토니 선생님"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 20,
  "jh": "5ab083e785a9",
  "ko": "흥, 당연하지. 군나르와 달리 이쪽은 오래 교사를 해 왔으니까"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 20,
  "jh": "5cef2e8d9c31",
  "ko": "자, 방금 걸 바탕으로 오늘 과제다"
