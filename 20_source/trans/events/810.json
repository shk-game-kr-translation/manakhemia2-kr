 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 20,
  "jh": "64877ec6c792",
  "ko": "전투기술과니까 더더욱 여러 싸움법을 할 줄 알아야 하는 거잖아"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 20,
  "jh": "4d872c4f4bfa",
