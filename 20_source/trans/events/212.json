[
 {
  "key": "m0",
  "kind": 2,
  "chr": 20,
  "jh": "506fc2adbe28",
  "ko": "…그래서, 진짜로 마나가 나왔다는 거냐"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "2a155b167cb1",
  "ko": "응! 봐요 봐요, 내 마나!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 10,
  "jh": "9dc66ada9e64",
  "ko": "우!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 20,
  "jh": "c6af6d90972e",
  "ko": "헤에, 신기한 일도 다 있군. 그래서, 시험 얘기 말인데…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "e02f073ea098",
  "ko": "선생님, 감동이 너무 없어요!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 2,
  "jh": "2e9724eb70d8",
  "ko": "자자, 어쩔 수 없어. 그렇게 큰소리치며 가짜라고 우겼으니까…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 6,
  "jh": "a77751e804e3",
  "ko": "그렇게 자신을 속이며 살아가는 거야. 넘어가 주자"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 20,
  "jh": "1106667c2754",
  "ko": "시, 시끄러워! 아무튼 시험 얘기다"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 20,
  "jh": "6535fb5a230c",
  "ko": "단도직입적으로 묻겠는데, 너희 뭘 넣었냐?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "e130a31edd91",
  "ko": "어, 딱히 아무것도… 별로 잘 안 됐어요?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "0a3a97bf85a3",
  "ko": "마지막에 정신없어서 제대로 못 봤고…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 20,
  "jh": "72b32db73b87",
  "ko": "완성도 자체는 그저 그런데"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 20,
  "jh": "051ef8b454ff",
  "ko": "잘 모르겠는 부가 효과가 붙어 있어서… 힐링계라고 할까 정신 안정 효과라고 할까"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 6,
  "jh": "3b37952fd467",
  "ko": "앗! 설마 이 몸이 풍기는 치유의 파동이 옮은 게…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "9e25c50c93df",
  "ko": "선생님이나 요정 씨가 힐링이라고 하면 엄청 수상해…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 20,
  "jh": "48dc6b16871a",
  "ko": "너희, 남의 얘기 진지하게 들을 생각 없지…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 20,
  "jh": "98e86e686060",
  "ko": "뭐, 우연의 산물이라는 건가. 재밌다면 재밌는데… 이건 평가 대상 외다"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "037979f63475",
  "ko": "윽! 그럼 우리 벌칙이에요?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 20,
  "jh": "2d68d453911e",
  "ko": "그래도 됐다만. 이번엔 봐주마"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 20,
  "jh": "4a4171bc41e6",
  "ko": "벌을 줘야 할 녀석이 예상보다 많아서 말이다"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "55d82ac7903b",
  "ko": "휴… 다행이다~"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "c54722b1f8a3",
  "ko": "받는 건 싫지만 보기만 하는 거라면 보고 싶었는데…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 20,
  "jh": "a0abd08aeb19",
  "ko": "보고 싶으면 보러 와도 상관없다"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "cedb35ffb13c",
  "ko": "…괜찮아요?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 20,
  "jh": "955ead788464",
  "ko": "그래, 똑똑히 봐 둬라. 나쁜 성적을 받은 녀석이 어떤 꼴을 당하는지를…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "ca9cf679f2dd",
  "ko": "두근두근…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 20,
  "jh": "ee618abc9289",
  "ko": "그럼 가 볼까. 슬슬 다들 군나르한테 붙잡혔을 테니까"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "b8fb117f1b44",
  "ko": "악취미라니까… 이 애한테 그런 교육상 안 좋은 걸 보여 줄 순 없지"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 10,
  "jh": "ea065d8d41fd",
  "ko": "우?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "eaa5ca113dc6",
  "ko": "그렇지. 아기한텐 이 몸처럼 팬시한 걸 보여 주며 키워야지"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "44d8f0c982d5",
  "ko": "넌 우류한테 접근 금지야. 가능하면 시야에도 들어오지 마"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 6,
  "jh": "97e0b148d457",
  "ko": "에에? 그건 접근 금지 수준이 아니잖아!?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 10,
  "jh": "55f72891b2c3",
  "ko": "우~…?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "db43c2a378e9",
  "ko": "아~ 안 돼. 너무 보면. 자, 아틀리에로 돌아가자~"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 6,
  "jh": "966e3dace62f",
  "ko": "잠깐만! 누나아아아!!"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 6,
  "jh": "2edc7bd27f2f",
  "ko": "너무해… 이 몸의 섬세한 하트가 상처받아… 그래도…"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 6,
  "jh": "ddb0bc33ffb6",
  "ko": "진짜로 마나가 나오다니… 큰일이 안 생기면 좋겠는데"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
