[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "bc12e4ae6e5e",
  "ko": "자, 아~ 해. 아~"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 24,
  "jh": "9aa167c50692",
  "ko": "괘, 괜찮아. 부끄러워. 게다가 난 인간 음식은 잘 못 먹어"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "1beac3514d09",
  "ko": "그래? 그럼 뭐 먹고 싶은 거 있어?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 24,
  "jh": "da8b82eec4a4",
  "ko": "우니푸니 푸딩이라면…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "6768020de1b7",
  "ko": "요리장! 우니푸니 푸딩 10인분! 최대한 빨리!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 24,
  "jh": "036f5aa59817",
  "ko": "그렇게 못 먹어!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "5a0988585e97",
  "ko": "사양하지 마. 잔뜩 먹고 더 말랑말랑해져야지"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 24,
  "jh": "b5ff023afdfa",
  "ko": "그리고 저기… 먹으면서 찌르는 거 그만해 줬으면 하는데…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 81,
  "jh": "cc4a7d19e774",
  "ko": "어라, 연금술과 릴리아 씨지…?"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 106,
  "jh": "2830b3bfd90b",
  "ko": "아아, 푸니푸니 페티시라는 소문이 진짜였구나…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 107,
  "jh": "09e9e73fd719",
  "ko": "아니 그보다 아무리 봐도 사귀는 거 아냐?"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 89,
  "jh": "9672cb3f0028",
  "ko": "사람들 앞에서 저렇게 꽁냥대다니… 천박해!"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 86,
  "jh": "9d06927eec07",
  "ko": "그래도 저 사람, 분명 남자 종자가 있었지?"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 98,
  "jh": "4b92315b04ee",
  "ko": "푸니푸니한테 뺏겼다는 건가… 불쌍하게도"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 7,
  "jh": "05f8f103a76c",
  "ko": "오오, 왠지 소문나고 있어"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 4,
  "jh": "2749c098b7c4",
  "ko": "악평이군… 이런이런. 다른 의뢰에 영향이 없으면 좋겠다만"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "719e14e1a759",
  "ko": "내 소문이 섞여 있는 게 몹시 불쾌한데… 이봐, 이제 돌아가도 되냐?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 11,
  "jh": "8f76a21c07d1",
  "ko": "아아아, 조금만. 조금만 더 참아 주세요"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 0,
  "jh": "5b6cc261c1e1",
  "ko": "왜 그렇게 붙잡으려는 거야?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 11,
  "jh": "9cd80d111f82",
  "ko": "그건 그게… 이래저래 사정이 있어서…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 5,
  "jh": "ee00abd1cc2f",
  "ko": "푸니!"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 24,
  "jh": "f466e4349868",
  "ko": "으으, 이제 돌아가고 싶어…"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 3,
  "jh": "cb02dff688c2",
  "ko": "그런 말 하지 마. 모처럼의 데이트인데. 자~ 푸니푸니푸니~"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 24,
  "jh": "6ae68b7de5d2",
  "ko": "데이트였어!? 아, 거긴 찌르지 마…"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 3,
  "jh": "993149438c73",
  "ko": "우후후후… 응? 푸니요 씨?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "8d107ae5a986",
  "ko": "로・제・질・렸・다. 다・음・행・동・으・로・옮・겨…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 3,
  "jh": "fb72302f4905",
  "ko": "뭐라고! 이렇게까지 했는데 안 된다는 거야!?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 24,
  "jh": "3231853d3486",
  "ko": "저, 저기… 무슨 일 있어?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "0527cfb6eab8",
  "ko": "그래도 이 이상 어떻게… 그래! 기분 전환하러 밖에라도 나가자!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 24,
  "jh": "46568355513b",
  "ko": "어? 그래도 밖은 위험하다고 요전에 로제 씨가"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "f497fe3cbe48",
  "ko": "그렇게 멀리 안 가니까 괜찮아. 자"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 7,
  "jh": "8b5c8eb8d5ae",
  "ko": "밖으로 가나 봐. 우와~ 야외 데이트다!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "39ef681e2793",
  "ko": "밖에? 요전에 그런 꼴을 당했는데… 저 아가씨는"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 4,
  "jh": "881628a76b5b",
  "ko": "어쩔 거냐? 아직 내버려 둘 건가"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 0,
  "jh": "171db9e14fba",
  "ko": "…당신, 꽤 성격 나쁘네"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 5,
  "jh": "ca8abfe217dc",
  "ko": "푸니~… 푸니"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 23,
  "jh": "006388b3bc45",
  "ko": "일단 작전 중지의 위기는 피했다… 라며 여동생이 땀을 닦고 있어요"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 11,
  "jh": "bfb4012fb82e",
  "ko": "로제 씨 마음의 움직임을 읽고 적확한 지시… 푸니요 씨, 보통이 아니네요…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
