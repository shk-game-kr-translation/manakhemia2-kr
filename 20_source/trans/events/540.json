  "jh": "49b334b27d9e",
  "ko": "푸니우~…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 11,
  "jh": "26351b7fff96",
  "ko": "아직 기운 없네요, 푸니요 씨"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 23,
  "jh": "0dcea54c57b8",
  "ko": "여동생은 책임감이 강한 아이예요. 여러분께 폐를 끼치는 게 괴로운 거겠죠"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 7,
  "jh": "9dbdca4c1c11",
  "ko": "서운하네~ 동료니까 아무리 폐를 끼쳐도 되는데"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "59da25756f08",
  "ko": "넌 폐를 너무 끼쳐… 앗"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 0,
  "jh": "7a2974897b62",
  "ko": "또 푸니푸니예요?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "f6bb28e29fd8",
  "ko": "응, 아주 희미한 기척이지만… 일단 가 보자"
 },
 {
  "key": "m7",
  "kind": 5,
  "chr": 3,
  "jh": "4d9feccd9974",
  "ko": "있다, 저기"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 56,
  "jh": "909b8584c3cb",
  "ko": "응…? 으아아!?"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 7,
  "jh": "a5432ccf9c33",
  "ko": "한 마리뿐? 왠지 맥 빠지네~"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 4,
  "jh": "3faf148ea3e5",
  "ko": "싸울 생각은… 없는 것 같군"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 56,
  "jh": "86ae03c16bb4",
  "ko": "네, 넷! 제발 봐주십쇼! 목숨만은!!"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 3,
  "jh": "eafb4d0045ac",
  "ko": "우리도 딱히 싸우고 싶은 건 아니고… 사정이 있으면 말해 봐"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 56,
  "jh": "6abba3a53081",
  "ko": "네, 실은… 동생이 행방불명돼서…"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 22,
  "jh": "7588e93b8be7",
  "ko": "동생이라고?"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 56,
  "jh": "2377748e97f5",
  "ko": "어제 싸움 이후로 안 보여서… 아직 어린애라 걱정돼서…"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 0,
  "jh": "272594af06a9",
  "ko": "혹시 몰라서 묻는데, 그 동생이라는 건 푸니푸니지?"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 56,
  "jh": "9f9bfd900dc8",
  "ko": "네. 물론입죠"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 7,
  "jh": "f208020924ac",
  "ko": "그 말은 작은 푸니푸니구나~ 누구 아는 사람?"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 4,
  "jh": "d82ad336d8c0",
  "ko": "기억에 없군. 싸우는 중이라 해도 아이 모습이면 알아봤을 텐데"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 22,
  "jh": "0a95b4f33ee2",
  "ko": "당연히 우리도 모른다"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 0,
  "jh": "c802454d0e27",
  "ko": "아무도 모른다면…"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 11,
  "jh": "31430c0774ff",
  "ko": "네. 용의자는 한 명밖에 없네요"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "099d05f000d2",
  "ko": "뭐… 왜 날 보는 거야!?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 11,
  "jh": "14619a0811f0",
  "ko": "아가씨… 아무리 상대가 푸니푸니라도 유괴까지 하시다니…!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "47e6947a89a5",
  "ko": "몰라! 멋대로 범인으로 몰지 마!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 4,
  "jh": "b8323338bda2",
  "ko": "인간 세계에선 자수하면 죄가 가벼워진다고 들었다만"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 7,
  "jh": "fd07231bc4d5",
  "ko": "잠깐 마가 낀 거지? 릴리아는 나쁜 애가 아니니까"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 5,
  "jh": "7ea7b0907d7f",
  "ko": "푸니~!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 23,
  "jh": "004cc5ae3b5b",
  "ko": "푸니 유괴라니 인간의 탈을 쓰고 할 짓이 아니다! 라며 여동생이 규탄하고 있어요"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "a39e01e809cf",
  "ko": "뭐, 뭐야. 다들… 로제! 넌 믿어 주지?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 0,
  "jh": "8e8cda6e016e",
  "ko": "어, 아~… 뭐…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 3,
  "jh": "7208222cccd1",
  "ko": "확실하게 부정해!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 11,
  "jh": "9bb041b7e262",
  "ko": "평소 행실이 나쁘니까 의심받는 거예요. 자, 체념하세요!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 3,
  "jh": "79977670908e",
  "ko": "큭, 오늘은 꽤 강하게 나오네… 모르는 건 모르는 거야!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 23,
  "jh": "8bbd5f982e38",
  "ko": "완강하게 혐의를 부인하고 있네요…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 7,
  "jh": "a9f8aa2bc3c3",
  "ko": "음~… 그럼 릴리아 방을 조사해 보자"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 3,
  "jh": "f90d7f1d07e3",
  "ko": "…뭐? 내 방을?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 4,
  "jh": "86be95780d18",
  "ko": "의심을 풀고 싶다면 순순히 협조하는 게 좋다"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 3,
  "jh": "aa067b626f47",
  "ko": "그, 그래도 여자 방을 조사하다니 그런… 로제도 보고 싶어? 내 방…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 0,
  "jh": "b86d56a44c22",
  "ko": "일단 조사하는 게 좋겠다고는 생각하는데요"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 3,
  "jh": "718e4593fa0b",
  "ko": "…알았어. 로제가 그렇게 말한다면… 자, 따라와!"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 56,
  "jh": "0a9ff2b8bc0a",
  "ko": "크크크크…"
 },
