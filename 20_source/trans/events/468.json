[
 {
  "key": "m0",
  "kind": 2,
  "chr": 9,
  "jh": "3caae5deb8ec",
  "ko": "있다. 페페론!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 6,
  "jh": "65e87f14a8e3",
  "ko": "으으으… 아아아아아!!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 9,
  "jh": "0c986b3d4e93",
  "ko": "말은 안 통하나…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 8,
  "jh": "1c331bc887a9",
  "ko": "누나, 그 약에 뭘 넣은 거야?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 2,
  "jh": "b57b045e4295",
  "ko": "…알고 싶어? 정말로?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 8,
  "jh": "63cdbfc9c140",
  "ko": "…아니, 역시 됐어"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 9,
  "jh": "cef2a12a9c16",
  "ko": "페페론… 설마 이런 형태로 너와 싸우게 될 줄이야"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "ccdeff69dce3",
  "ko": "그르르르르르…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 9,
  "jh": "dd319dd09174",
  "ko": "다들 방심하지 마. 지금의 페페론을 인간이라 생각해선 안 돼…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 2,
  "jh": "a760adadce15",
  "ko": "…원래 인간 아니지만"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "b1cdbb5f20e1",
  "ko": "꽤 성가시다는 거지. 아 정말, 손이 많이 가…"
 },
 {
  "key": "m11",
  "kind": 5,
  "chr": 20,
  "jh": "0a72c66f01c1",
  "ko": "기다려라. 여긴 나한테 맡겨 줘야겠다"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 2,
  "jh": "7f4d75e6598c",
  "ko": "토니 선생님…"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 20,
  "jh": "4d89c03d650a",
  "ko": "몸이 근질근질해… 날뛰고 싶어서 못 참겠어. 이런 기분 오랜만이다!"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 20,
  "jh": "c0147c89042f",
  "ko": "우오오오! 각오해라!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "03cd44562058",
  "ko": "그렇구나, 선생님도 같은 약을 마셨으니까… 어쩌면 이길지도?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 2,
  "jh": "3e8e2564fcb1",
  "ko": "…아니. 절대 무리"
 },
 {
  "key": "m17",
  "kind": 5,
  "chr": 20,
  "jh": "a458d129d155",
  "ko": "으아아아아악…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "513aebc81c32",
  "ko": "빨라! 벌써 당한 거야!?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 2,
  "jh": "26b711084682",
  "ko": "…기본 성능이 너무 달라"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "59de2a219fe4",
  "ko": "뭐, 어쩔 수 없나. 토니 선생님으로는…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 9,
  "jh": "d185722bd0e3",
  "ko": "조금이라도 대미지를 줬으면 좋았을 텐데"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 2,
  "jh": "8fac550c5aba",
  "ko": "…쓸모없는 남자"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 6,
  "jh": "660f701c30a1",
  "ko": "가아아아아아!!"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 8,
  "jh": "a583f43fdeca",
  "ko": "이쪽으로 온다!"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 9,
  "jh": "adfd426f99ea",
  "ko": "오히려 진심으로 만들어 버린 모양이군"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 1,
  "jh": "9ad4b7752c87",
  "ko": "어쩔 수 없네. 힘껏 두들겨 패서 정신 차리게 하자!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 6,
  "jh": "dd9764be71d6",
  "ko": "으으음… 어라라? 이 몸 대체 뭘…?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 9,
  "jh": "011a4d5aaec3",
  "ko": "후우. 정신이 든 모양이군"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "012d2632cb88",
  "ko": "무서운 꿈을 꿨어… 이 몸이 학원을 부수고 다니는 꿈…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 1,
  "jh": "3935d27c3de1",
  "ko": "꿈이면 좋았을 텐데…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 2,
  "jh": "9e957da2ad4f",
  "ko": "현실은 언제나 잔혹한 법…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 6,
  "jh": "dfb5e33f564c",
  "ko": "어? 무슨 뜻이야?"
 },
 {
  "key": "m33",
  "kind": 5,
  "chr": 103,
  "jh": "5c7e5f94a6af",
  "ko": "있습니다! 저기예요!"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 2,
  "jh": "5e72bd02b5fb",
  "ko": "마중이 온 것 같아…"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 6,
  "jh": "45a63d9b400c",
  "ko": "어? 어? 무슨 일이야? 이 몸, 뭐가 뭔지…"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 18,
  "jh": "ec5de808d0c0",
  "ko": "교내 파괴 활동 및 폭행 현행범으로 당신을 구속합니다. 자, 연행하세요"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 103,
  "jh": "11e35b8b36f3",
  "ko": "네!"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 6,
  "jh": "e0aaa9377eea",
  "ko": "자, 잠깐만! 이 몸은 아무 나쁜 짓도…"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 104,
  "jh": "229bba719c27",
  "ko": "변명은 취조실에서 듣겠다. 자, 냉큼 걸어!"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 103,
  "jh": "52e552106a83",
  "ko": "그만한 짓을 저질렀다. 쉽게 나올 수 있을 거라 생각 마라"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 6,
  "jh": "e05da150dd20",
  "ko": "에에에에!? 사, 살려 줘, 누나아아아!"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 18,
  "jh": "6c0b48ae4c4c",
  "ko": "저건 당신들 아틀리에에서 기르는 생물이었죠?"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 1,
  "jh": "f7181dec6447",
  "ko": "하아, 뭐… 기른다기보다 눌러산다고 할까…"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 18,
  "jh": "df6227463fad",
  "ko": "당신들에 대한 처분은 추후 전하겠습니다. 그럼"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 8,
  "jh": "79bd70c93133",
  "ko": "끌려가 버렸네…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 2,
  "jh": "b55843c68450",
  "ko": "그만한 짓을 했으니 어쩔 수 없어…"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 8,
  "jh": "75fdbec44ada",
  "ko": "…자기가 모든 원인이란 걸 알고 하는 말이지?"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 9,
  "jh": "7dbcd7fa6bc3",
  "ko": "마루타에겐 나중에 내가 얘기해 두지. 처분도, 페페론 일도"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 1,
  "jh": "611a936ed5ff",
  "ko": "응, 부탁해. 너도 좀 반성해"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 2,
  "jh": "4c1a62c3df9f",
  "ko": "이번엔 꽤 만족했으니까 당분간은 자제할게… 응"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 1,
  "jh": "e76d8cdc254e",
  "ko": "그 말을 믿을 수 있으면 좋겠는데…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]