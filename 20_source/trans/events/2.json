[
 {
  "key": "m0",
  "kind": 5,
  "chr": 21,
  "jh": "e82553184b7f",
  "ko": "오늘부터 이 집 신세를 지게 될 거다"
 },
 {
  "key": "m1",
  "kind": 5,
  "chr": 0,
  "jh": "43fec0d8d987",
  "ko": "응…"
 },
 {
  "key": "m2",
  "kind": 5,
  "chr": 21,
  "jh": "0629899410c1",
  "ko": "너랑 나이가 비슷한 아가씨도 계시니까 실례하지 않도록 해라"
 },
 {
  "key": "m3",
  "kind": 5,
  "chr": 0,
  "jh": "43fec0d8d987",
  "ko": "응…"
 },
 {
  "key": "m4",
  "kind": 5,
  "chr": 21,
  "jh": "766688912cf1",
  "ko": "…싫으냐?"
 },
 {
  "key": "m5",
  "kind": 5,
  "chr": 0,
  "jh": "d9b54edcc598",
  "ko": "딱히, 싫지는…않아"
 },
 {
  "key": "m6",
  "kind": 5,
  "chr": 21,
  "jh": "a4523ab7d772",
  "ko": "미안하다. 너 하나쯤은 내가 훌륭하게 키워 줄 생각이었다만…"
 },
 {
  "key": "m7",
  "kind": 5,
  "chr": 0,
  "jh": "c4d9f0d0e96c",
  "ko": "할아버지는 잘못 없어! 왜냐면, 나쁜 건…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 3,
  "jh": "1d0133d93d3b",
  "ko": "어때? 그쪽은 끝났니?"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 11,
  "jh": "95ba329ad5b9",
  "ko": "셔츠 쪽은 어떻게든. 나머지는…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 3,
  "jh": "6e9b10c1aa90",
  "ko": "꾸물대지 말고 서두르렴. 깨어나 버리잖아"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 11,
  "jh": "d4a7c204af14",
  "ko": "네, 네. 그런데 저기…역시 바지도요?"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 3,
  "jh": "86b08e20c385",
  "ko": "당연하지. 바지만 잠옷으로 둘 생각이니?"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 11,
  "jh": "0c178586c5ba",
  "ko": "아, 알겠습니다"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 11,
  "jh": "0f7104ada65d",
  "ko": "아가씨의 명령이에요. 저를 원망하지 말아 주세요… 에잇!"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 3,
  "jh": "dfc5a5054cf5",
  "ko": "흐응, 어머어머…"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 11,
  "jh": "6465f1f9fa4c",
  "ko": "하아…그렇군요. 이런 걸 입고 계셨군요…"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 3,
  "jh": "3a4947ad6df3",
  "ko": "잠깐, 뭘 그렇게 빤히 보는 거니!?"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 11,
  "jh": "478b85135032",
  "ko": "빤히 보지 않았어요! 아가씨야말로 그런 음흉한 눈으로…"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 0,
  "jh": "64ffb9fa1736",
  "ko": "으음…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 3,
  "jh": "69836bc3ad23",
  "ko": "앗! 쉿, 조용히…"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 11,
  "jh": "d2fb82566fd8",
  "ko": "…괜찮은 것 같네요. 그럼 마지막으로 벨트를 채우면…완성이에요!"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 0,
  "jh": "a9c6e2659cb7",
  "ko": "으으…?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 11,
  "jh": "adfbb259993d",
  "ko": "좋은 아침이에요, 로제 씨"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "26d221b47397",
  "ko": "정말이지, 나보다 늦게 일어나다니 시종 실격이야"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 0,
  "jh": "a7aeacaffc7d",
  "ko": "안녕하세요… 두 분 다 제 방에서 뭘…?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "7498c529f3c4",
  "ko": "응? 뭐지, 이 옷은…?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 3,
  "jh": "88f6a23cc4d4",
  "ko": "알레비스 학원의 교복이야"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 0,
  "jh": "d21d84147aa9",
  "ko": "알레비스 학원…? 아아, 다음 주부터 아가씨가 입학한다던…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 3,
  "jh": "8ece7c232db6",
  "ko": "너도 같이 입학하게 됐으니까"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 11,
  "jh": "761bb9c4226c",
  "ko": "교복 사이즈가 딱 맞아서 다행이에요"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "5f808156360f",
  "ko": "네…? 잠깐만요"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 0,
  "jh": "a4afa874c030",
  "ko": "알레비스 학원이라면 연금술 학교잖아요? 왜 제가…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 3,
  "jh": "854a41d97e3e",
  "ko": "안심하렴. 네가 가는 곳은 전투기술과라는 학과니까"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 11,
  "jh": "1d4462c25621",
  "ko": "올해 새로 생긴 학과래요. 타이밍이 딱 좋죠"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 0,
  "jh": "3f8af2b6edca",
  "ko": "아니 그래도, 갑자기 그러셔도…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 3,
  "jh": "bbda7ab40639",
  "ko": "이미 정해진 일이니까 이제 와서 불평하지 마. 출발은 내일 아침이야"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 3,
  "jh": "e61e9f36810b",
  "ko": "1년 동안은 돌아오지 못하니까 준비 단단히 하렴"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 11,
  "jh": "f422d7155e59",
  "ko": "그럼 이만 실례할게요"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 0,
  "jh": "689f42d2acdf",
  "ko": "그래서…1년 동안은 아가씨 얼굴을 안 봐도 될 줄 알았는데…"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 0,
  "jh": "b4b0a0661494",
  "ko": "하아, 곤란하게 됐군…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
