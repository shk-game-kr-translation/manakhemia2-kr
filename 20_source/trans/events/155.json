[
 {
  "key": "m0",
  "kind": 0,
  "chr": 14,
  "jh": "612f6299e08c",
  "ko": "응?"
 },
 {
  "key": "m1",
  "kind": 5,
  "chr": 21,
  "jh": "976a87abdb36",
  "ko": "영차!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 21,
  "jh": "f7e4f44a1293",
  "ko": "완전히 길을 잃었구먼… 모르는 곳을 대충 걷는 게 아니었어"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 14,
  "jh": "8d933a20b8ca",
  "ko": "어라… 당신은…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 21,
  "jh": "eb1b87c1750b",
  "ko": "응? 오오! 역시 너였구나. 찾았다, 루 꼬마"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 14,
  "jh": "a63958675d1d",
  "ko": "…용케 아셨네요. 제가 있다는 걸"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 21,
  "jh": "117273c51c68",
  "ko": "확신은 없었지만. 대충 걷다 보면 찾을까 싶어서"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 14,
  "jh": "ce431f2e0293",
  "ko": "그래서 있는 곳까지 냄새를 맡아 오셨다고요? 천문학적인 확률이네요"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 21,
  "jh": "0e1084ebdb39",
  "ko": "…뭐, 기척 같은 건 느끼고 있었으니까. 그 시절이랑 전혀 안 변했구먼"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 14,
  "jh": "ce27ec0b74c2",
  "ko": "그래요… 전 당신 기척을 전혀 못 느꼈어요. 쇠약해지셨네요"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 21,
  "jh": "b2487fe39465",
  "ko": "그야 이제 나이가 나이니까. 어쩔 수 없잖냐"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 14,
  "jh": "1b99fe79381c",
  "ko": "…그래서 무슨 볼일이세요. 가능하면 서로 만나고 싶지 않은 사이일 텐데요"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 21,
  "jh": "704e799b890b",
  "ko": "손자한테 뭘 했냐?"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 14,
  "jh": "8a6dc1d2df4b",
  "ko": "…반지를 줬을 뿐이에요. 아니…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 14,
  "jh": "f16f4ef36255",
  "ko": "원래 당신 거였으니까 돌려줬다는 게 더 정확하려나"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 21,
  "jh": "298eb1ad0323",
  "ko": "그것만이 아니잖냐. 쓸데없는 걸 불어넣은 거 아니냐?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 14,
  "jh": "5cdcd988bc0a",
  "ko": "글쎄요, 무슨 말씀이신지"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 21,
  "jh": "d6fcebc72354",
  "ko": "말할 생각은 없나… 방해했구먼"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 14,
  "jh": "549bd498562b",
  "ko": "어라? 여기선 힘으로라도! 가 되는 거 아니었어요?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 21,
  "jh": "8092f0c181a4",
  "ko": "지금의 너한테 이길 것 같지 않거든"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 14,
  "jh": "a22e3c3a6567",
  "ko": "그래요… 아, 그럼 대신 저한테 협력해 주세요"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 21,
  "jh": "fd1da0830f34",
  "ko": "협력이라고…? 사양이다. 다른 데 알아봐라"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 14,
  "jh": "b5216c3183ee",
  "ko": "당신만 할 수 있는 일이에요"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 14,
  "jh": "54a7104908a9",
  "ko": "게다가 저한테 못 이긴다고 방금 인정하셨잖아요. 거부는 못 해요"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 21,
  "jh": "4cc94eaa1922",
  "ko": "쳇… 혼자 만나러 온 건 역시 실수였군"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 14,
  "jh": "f90f2b87db6c",
  "ko": "딱히 당신이 뭘 할 필요는 없어요. 그저…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 14,
  "jh": "a9203be01781",
  "ko": "당신 신변에 무슨 일이 생기면 그도 진심이 될 수밖에 없지 않을까, 해서요…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 21,
  "jh": "5170f7e6ff9a",
  "ko": "…싱글거리는 얼굴로 터무니없는 소리를 하는구먼"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]