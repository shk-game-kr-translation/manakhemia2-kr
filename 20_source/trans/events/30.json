[
 {
  "key": "m0",
  "kind": 0,
  "chr": 0,
  "jh": "ed3f25d2babb",
  "ko": "뭐지, 이 인파는… 저건 교감이랑…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 23,
  "jh": "62c28eaa6da8",
  "ko": "형? 타로 형!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 12,
  "jh": "ac0088660c16",
  "ko": "이 몸의 공격을 여기까지 버텨 내다니… 네놈, 보통 푸니푸니가 아니구나"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 22,
  "jh": "9fa8060ac975",
  "ko": "뭐 하는 놈이냐… 푸니푸니계 굴지의 전사인 내가 완전히 놀아나고 있다…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 12,
  "jh": "0988a8bf5963",
  "ko": "아쉽지만 슬슬 결판을 내 볼까… 각오는 됐겠지?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 22,
  "jh": "bd75f62a9a5a",
  "ko": "이런 곳에서 쓰러질 수는… 이렇게 된 이상 옥쇄할 각오로…!"
 },
 {
  "key": "m6",
  "kind": 5,
  "chr": 13,
  "jh": "c3b344c7e2c5",
  "ko": "잠깐! 둘 다 기다려 줘!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 23,
  "jh": "8d947533f0ce",
  "ko": "형! 괜찮아?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 22,
  "jh": "085a95659c0f",
  "ko": "오오, 지로! 너도 무사했구나"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 12,
  "jh": "f69bc85866f6",
  "ko": "에잇, 왜 말리는 거냐!? 한 방이면 끝장낼 수 있었는데!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 13,
  "jh": "7f45e6fb8949",
  "ko": "아니, 그러니까 끝장나면 곤란하다고"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 13,
  "jh": "be95da66f4d6",
  "ko": "이 푸니푸니들은 말이지, 우리 학생의 보호자란 말이야"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "85d36bb93d61",
  "ko": "보호자?"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 13,
  "jh": "c1aced9c008f",
  "ko": "응. 이 푸니푸니들의 여동생이 올봄부터 입학했거든"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "ad8f56d7953a",
  "ko": "푸니푸니도 입학할 수 있는 거냐…?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 13,
  "jh": "61db26f5d7c2",
  "ko": "뭐… 우리 학원은 기본적으로 오는 사람 안 막으니까"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 12,
  "jh": "a4634dfc62a2",
  "ko": "그 방침은 대단히 좋다. 수상한 학생은 많으면 많을수록 좋으니까"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 12,
  "jh": "b05e6c3134f6",
  "ko": "하지만 이상하군. 오늘까지 교내에서 푸니푸니 모습은 전혀 못 봤는데"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 23,
  "jh": "0a5d9910e7da",
  "ko": "저희는 오늘 막 도착했거든요. 오는 길에 이런저런 문제가 있어서…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 22,
  "jh": "d542be04630e",
  "ko": "그리고 도착한 건 좋은데, 정작 여동생과 떨어져 버렸지"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 0,
  "jh": "d67274a9ada7",
  "ko": "그래서 교내를 찾아다녔다, 이건가…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 23,
  "jh": "40a50dcb2649",
  "ko": "형, 역시 우리끼리 움직이는 건 위험해. 이 사람이랑 같이 가자"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 23,
  "jh": "2997fa5d9bdd",
  "ko": "사정을 아는 사람이랑 같이면 안심이고, 이 사람은 믿을 수 있어"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 22,
  "jh": "650e08e1bb71",
  "ko": "흠… 알았다. 네가 그렇게 말한다면 그러지"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 0,
  "jh": "ef006636e302",
  "ko": "푸니푸니한테 신뢰받아도 별로 기쁘지 않군…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 12,
  "jh": "75aed34e8309",
  "ko": "기다려라. 네놈, 이름이 뭐냐?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 22,
  "jh": "9c87de67d71e",
  "ko": "푸니 타로다"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 12,
  "jh": "58fbc749934c",
  "ko": "좋은 이름이군. 오늘의 결판은 언젠가 내 주마. 그때까지 실력을 갈고닦아라"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 22,
  "jh": "9572c80a5d3c",
  "ko": "…바라던 바다"
 },
 {
  "key": "g0s0",
