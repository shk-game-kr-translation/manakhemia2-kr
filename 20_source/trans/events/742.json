 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "12ba31dabbb6",
  "ko": "좋잖아. 그렇게 말하면 누구라도 신경 쓰이지"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 12,
  "jh": "de3026b21e76",
  "ko": "이런이런, 역시 와 버렸나. 별난 녀석들이군"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 7,
  "jh": "a3b227736f6d",
