 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 0,
  "jh": "68110982f043",
  "ko": "어차피 와 주길 바라서 못 견뎠던 거죠?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "ff7b1cd1486f",
  "ko": "앗, 나왔다!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "4a4ecefb67f3",
  "ko": "와 주길 바라서 못 견뎠으면서 잘도 말하네…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 12,
  "jh": "2eed09416364",
  "ko": "아니, 이번만은 정말 오지 않길 바랐다만"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 12,
  "jh": "f4e4950c0d19",
  "ko": "아무래도 여긴 아직 제작 도중이라. 완성까진 좀 더 시간이 걸린다"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 0,
  "jh": "605f0ac2cd05",
  "ko": "그럼 왜 그런 말을 한 거야…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "f83457984e29",
  "ko": "그럼 그런 말 안 하면 되잖아"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 12,
  "jh": "16ea59dc4dcc",
  "ko": "뭐, 와 버린 건 어쩔 수 없다만, 아까도 말했듯이 여긴 아직 제작 도중이다"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 12,
  "jh": "799e3d481339",
  "ko": "그래도 도전하겠다면 다음 사항을 충분히 주의해라"
