 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 20,
  "jh": "04a1bb9214bd",
  "ko": "아…? 그렇군, 너도 나한테 불만을 다는구나. 그래 그래…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "5195465965b6",
