 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 20,
  "jh": "6e45403a2475",
  "ko": "어느 쪽이냐면 나쁜 축이군. 은근히 나빠. 중하다"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
