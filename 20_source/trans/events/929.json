 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 20,
  "jh": "0e0797a69287",
  "ko": "쯧, 일일이 끼어들지 마. 시간이 없는데"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "7f02507a4d29",
