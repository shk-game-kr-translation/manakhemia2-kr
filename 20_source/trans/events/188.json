 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 1,
  "jh": "9f50c2b136f7",
  "ko": "바, 바보 바보 하지 마! …앗"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 1,
  "jh": "caf476741653",
  "ko": "큰일 났다. 이봐, 거기 서~!"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 2,
  "jh": "0e9e4bc3e76a",
  "ko": "소중한 돌이라고 하는 것치고 취급이 막 하네…"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 35,
  "jh": "e6aaf97331e4",
  "ko": "여전히 알 수 없는 사람이야… 앗, 좀 서둘러야겠군"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 35,
  "jh": "f3d5f7dec471",
  "ko": "으악!!"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 1,
  "jh": "c0281f5d17e3",
  "ko": "아앗! 내 돌이! …다행이다. 멀쩡해"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 35,
  "jh": "e382593581a6",
  "ko": "…네 거냐? 그거…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "25fe517691bd",
  "ko": "응? 그런데? 예쁘지? 게다가 그냥 예쁘기만 한 게 아니라 이게 무려…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 35,
  "jh": "e3c4d2584bfa",
  "ko": "달리 할 말이 있을 텐데… 난 그 돌을 밟고 넘어졌다고?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "8089ef4cd6e5",
  "ko": "할 말…? 아, 맞다!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "9dc664e18a3d",
  "ko": "감히 남의 돌을 밟다니! 깨지면 어쩔 건데!?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 35,
  "jh": "a9d1e7e722c2",
  "ko": "왜 네가 화를 내! 사과 한마디 하라는 거잖아!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "c121eb89d0f6",
  "ko": "내가 왜 사과해야 하는데! 네가 멋대로 넘어진 거잖아"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 35,
  "jh": "c1aa621630ee",
  "ko": "그 돌을 굴린 건 너잖아!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 2,
  "jh": "617a8abcbb7d",
  "ko": "애들 말싸움이네…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "d4d931c5ce88",
  "ko": "이렇게 말하면 저렇게 말하고… 뭐야, 남자가 지난 일을 갖고 꽁해서는!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 35,
  "jh": "efb178536925",
  "ko": "멋대로 지난 일로 만들지 마!"
 },
 {
  "key": "m25",
  "kind": 5,
  "chr": 20,
  "jh": "7c16fa41e354",
  "ko": "야, 뭘 떠들고 있냐?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "ed051352fab6",
  "ko": "으악, 입학식에서 난동 부리던 선생님이다…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 35,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 20,
  "jh": "76bbf1d1fd60",
  "ko": "입학하자마자 기운이 넘치는구먼. 너희, 이름은?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "e726998bd13c",
  "ko": "울리카, 예요…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 0,
  "jh": "e96da9ae39d6",
