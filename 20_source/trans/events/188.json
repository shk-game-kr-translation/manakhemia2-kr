 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 1,
  "jh": "a9174e10c8fd",
  "ko": "그러면 뭐 한턱 쏠게"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 2,
  "jh": "4db83e0d00e0",
