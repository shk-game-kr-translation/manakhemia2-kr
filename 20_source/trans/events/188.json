 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 20,
  "jh": "d375d531e87e",
  "ko": "울리카에 로제류… 부르기 힘드네. 로제면 되겠지"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 20,
  "jh": "089795078375",
  "ko": "똑똑히 기억해 두마. 자, 얼른 교실로 가"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "2c30a7cd31af",
  "ko": "네~…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 2,
  "jh": "14ee26941559",
  "ko": "입학 첫날부터 선생님한테 찍혀 버렸네…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 1,
  "jh": "30413ab53dd6",
  "ko": "왜 혼자만 도망친 거야! 아~ 정말, 전부 그 로제인가 하는 남자 탓이야!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 2,
  "jh": "85b0aa6a7c0a",
