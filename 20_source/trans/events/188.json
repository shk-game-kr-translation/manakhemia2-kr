 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 1,
  "jh": "17f68dd27a31",
  "ko": "왜, 왜!? 백 번 양보해도 반은 저쪽이 나쁘잖아?"
 },
 {
  "key": "m39",
  "kind": 5,
  "chr": 20,
  "jh": "eb70a1f3676d",
