[
 {
  "key": "m0",
  "kind": 0,
  "chr": 78,
  "jh": "d344fcd90135",
  "ko": "으아아아! 와, 왔다아아!"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 79,
  "jh": "d7b2d2b7e78d",
  "ko": "빨리 도망쳐야… 비켜! 방해야!"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 78,
  "jh": "b4cebcc0f8b4",
  "ko": "딸은!? 딸은 무사한가!?"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 18,
  "jh": "9b36707c9d4f",
  "ko": "도, 도망치면 안 돼요! 몸을 던져서라도 교사를 지켜 주세요!"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 13,
  "jh": "e4acae8792ea",
  "ko": "이사장님! 진정하세요! 아아아, 학부모 여러분도 줄을 흐트러뜨리지 마시고…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 12,
  "jh": "235f90ff43cf",
  "ko": "하하하! 그야말로 지옥도로군"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 20,
  "jh": "5a60913b4d02",
  "ko": "웃을 일이 아니야! 이제 됐잖아, 네가 어떻게 좀 해!"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 12,
  "jh": "2460cb20cc77",
  "ko": "이 몸이 나설 자리는 없다. 좀 더 학생들을 믿어 주는 게 어떠냐"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 20,
  "jh": "27937a907b90",
  "ko": "뭐라고?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "5f04697f2c23",
  "ko": "있다! 으악, 벌써 교사 바로 앞이잖아"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 3,
  "jh": "38fa69cb648a",
  "ko": "여기서 끝장낼 거야! 그쪽으로 돌아 들어가!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 6,
  "jh": "08b94d8e57f9",
  "ko": "응! 발묶음은 이 몸에게 맡겨 줘!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 9,
  "jh": "64aacb84fc0e",
  "ko": "하하하. 너 혼자 보내진 않아!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 4,
  "jh": "d0e06d886f75",
  "ko": "이쪽은 정면에서 몰아넣겠다. 아직 움직일 수 있지?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 7,
  "jh": "a05a3c39873f",
  "ko": "당연하지! 이번에야말로 쓰러뜨릴 거야!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 5,
  "jh": "4cacd6119e6a",
  "ko": "푸니~!!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 2,
  "jh": "2ec79494f149",
  "ko": "…다들, 파이팅"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 8,
  "jh": "85cb175ff5f8",
  "ko": "야! 땡땡이치지 말고 움직여!"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 0,
  "jh": "1332cea91951",
  "ko": "이런 시시한 일에 언제까지 어울려 줄 수 있겠냐… 여기서 끝내 주마!"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 12,
  "jh": "d22345c94cb7",
  "ko": "강대한 적을 앞에 두고 그동안 반목해 온 학생들의 마음은 하나가 되었다"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 12,
  "jh": "b2c18a9e6e04",
  "ko": "일치단결한 학생들은 멋지게 적을 무찌르고 학원의 평화를 되찾았던 것이다… 끝"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 12,
  "jh": "031222bb2dc6",
  "ko": "어떠냐, 꽤 감동적인 결말이지"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 20,
  "jh": "7ff37380345e",
  "ko": "…그렇게 깔끔하게 끝날 리가 있냐. 봐라"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 12,
  "jh": "4470573f8cf6",
  "ko": "음?"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 79,
  "jh": "832a4af942ae",
  "ko": "우리 애는!? 우리 애가 아직 안 돌아왔는데요!?"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 78,
  "jh": "3557d1b1fa27",
  "ko": "무슨 수업을 하는 거야, 이 학교는!?"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 72,
  "jh": "eff1d16593c2",
  "ko": "이래서야 원조 얘기도 다시 생각해야겠군요"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 18,
  "jh": "7afe69dad24e",
  "ko": "그, 그런! 이건 교감이 독단으로 멋대로 한 일이라…"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 8,
  "jh": "e0a981704bd1",
  "ko": "야, 엄마는 어디 갔어?"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 73,
  "jh": "46205389b9e4",
  "ko": "또 길을 잃었나… 찾는 쪽 입장도 좀 생각해 줬으면 하는데"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 5,
  "jh": "7adf9ba468d3",
  "ko": "푸니! 푸니~!"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 23,
  "jh": "147f126ed772",
  "ko": "아빠가 누구한테 베였어! 라고 여동생이 호소하고 있어요"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 79,
  "jh": "2b90e439a9e3",
  "ko": "우리 아이를 이렇게 위험한 꼴을… 정식으로 고소하겠어요!"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 78,
  "jh": "42c26c3843b6",
  "ko": "책임자 나와! 책임자!"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 12,
  "jh": "9b40304657b6",
  "ko": "으음, 모처럼 이 몸이 깔끔하게 정리했는데…"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 13,
  "jh": "4161a1854699",
  "ko": "어, 어쩔 거야? 이대로면…"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 12,
  "jh": "c8b562973f64",
  "ko": "흥이 깨졌다. 뒷처리는 맡기마"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 13,
  "jh": "f3e0c4fc0bdf",
  "ko": "응? 나한테?"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 13,
  "jh": "b292667863af",
  "ko": "잠깐, 곤란해! 기다려…"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 78,
  "jh": "e13b7e90a3b1",
  "ko": "자, 어떻게 책임질 거냐!?"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 79,
  "jh": "233a39727a63",
  "ko": "당신이 교장이죠! 어떻게 좀 해 주세요!"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 18,
  "jh": "782c52223c62",
  "ko": "빨리 어떻게 좀 하세요!"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 13,
  "jh": "2e2871224239",
  "ko": "저, 저한테 그러셔도…"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 20,
  "jh": "7a4e44b20b28",
  "ko": "뭐, 그 녀석을 풀어놓고 키운 건 당신이니까… 힘내라"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 13,
  "jh": "3b7df136058b",
  "ko": "그런! 버리지 마, 응!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]