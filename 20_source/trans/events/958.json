[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "3cbfe3e9fc95",
  "ko": "선생님~ 지도 만들어 왔어"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 28,
  "jh": "2a4e576f8f39",
  "ko": "아, 어서 와. 괜찮았니? 길 잃지는 않았니?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "b3a6c09e624d",
  "ko": "이제 와서 길 안 잃어. 그보다 봐, 빨리 봐 봐"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 28,
  "jh": "5570b3a4b439",
  "ko": "으, 응. 그럼…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 28,
  "jh": "0aae06906e48",
  "ko": "오오, 대단해! 완벽한 지도네. 이 짧은 시간에 용케 여기까지…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 1,
  "jh": "8fa4a4de7f15",
  "ko": "헤헤~ 대단하지. 이번엔 자신 있었어"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 2,
  "jh": "b68594240600",
  "ko": "이렇게 밖을 돌아다니는 계열은 잘하니까…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 28,
  "jh": "e0ff171701f4",
  "ko": "이 정도면 졸업 후에도 지도에 관해선 안심이네. 자, 그럼 도장 찍을게"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 28,
  "jh": "ff5d571ecd97",
  "ko": "음~… 여기까지 했으면 완벽한 지도로 마무리해 줬으면 했는데…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "36e55145e6bd",
  "ko": "어, 어라? 전부 걸었다고 생각했는데"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "d6a7686250c9",
  "ko": "울리카는 덜렁대니까… 저기만 더 돌았으면 완벽했는데…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "dd985e242c02",
  "ko": "알았으면 말해 줘!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 28,
  "jh": "ca6dc70c7deb",
  "ko": "자, 자자. 싸우지 마…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 28,
  "jh": "dea02d4faaf7",
  "ko": "성적으로는 이것도 충분하니까. 자, 그럼 도장 찍을게"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 28,
  "jh": "d157384af5bc",
  "ko": "음~… 꽤 구멍이 많은 지도네. 좀 더 힘내 줘야…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "6d4f7f44a308",
  "ko": "아, 역시 안 돼…?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 2,
  "jh": "aaa38e86c315",
  "ko": "대충 생각나는 대로 걸었을 뿐이니까…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 28,
  "jh": "4d2c621c880c",
  "ko": "뭐, 일단 평가는 주지만… 다음엔 더 확실히"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 28,
  "jh": "47f7904de2b8",
  "ko": "전혀 안 됐잖아… 아무래도 이래선 안 돼…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "b615ffe93c64",
  "ko": "아, 아하하… 역시 안 되겠지…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 28,
  "jh": "d212b7aa4206",
  "ko": "하아… 역시 나 같은 선생님 수업으론 의욕도 안 생기겠지…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "0ef67c840803",
  "ko": "어, 그런. 딱히 그런 뜻은…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 2,
  "jh": "b7279656a4d8",
  "ko": "풀 죽었다… 울리카 탓에…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "cd9e8fb236e9",
  "ko": "어떡하지… 내버려 두면 회복하려나?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 2,
  "jh": "9430f21b63ee",
  "ko": "글쎄…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
