[
 {
  "key": "m0",
  "kind": 0,
  "chr": 8,
  "jh": "91c2315bf62b",
  "ko": "그, 가, 고, 기기기기…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 12,
  "jh": "f133a7f86d54",
  "ko": "왔나. 아무래도 정상 작동하고 있는 것 같군"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 8,
  "jh": "892250ce34e0",
  "ko": "누갓! 하아, 하아… 뭐, 뭐였던 거야 방금…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 12,
  "jh": "e4994bf62afd",
  "ko": "좀 난폭한 호출이 돼 버렸군"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "53b533c90251",
  "ko": "잠깐, 에나한테 무슨 짓 한 거야!?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 12,
  "jh": "30a45259d5c0",
  "ko": "그건 나중에 설명해 주마. 어떠냐 꼬마. 기계 장치 솜씨는 늘었나?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 8,
  "jh": "38caded70fbb",
  "ko": "다, 당신이랑 상관없잖아…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 12,
  "jh": "dcf612b71db1",
  "ko": "크게 있다. 전에 공짜로 기계 지식을 준 걸 잊었나?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 8,
  "jh": "789d11d94ad8",
  "ko": "기계 지식…? 앗!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 8,
  "jh": "7abf3affabe5",
  "ko": "그거 당신 짓이었어!?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 12,
  "jh": "d6eea15c0620",
  "ko": "눈치 못 챘나? 아무래도 기계 외의 일엔 머리가 안 돌아가는 모양이군"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 12,
  "jh": "592cf19cfc1d",
  "ko": "뭐, 그건 됐다. 기뻐해라, 오늘부터 네놈을 이 몸의 부하로 삼아 주마"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 8,
  "jh": "66a3c927b2ff",
  "ko": "…부하?"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 12,
  "jh": "b7c74633d97e",
  "ko": "음. 이 몸의 세계 정복 야망을 위해선 한 명이라도 많은 두뇌가 필요하다"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 12,
  "jh": "348d8cdaf62e",
  "ko": "전투원과 달리 이것만은 단련한다고 되는 게 아니니까"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 9,
  "jh": "12c446e7c8d8",
  "ko": "이런이런, 무슨 말을 하나 했더니…"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 8,
  "jh": "7760f45efeeb",
  "ko": "못 어울려 주겠네… 돌아가자. 바보 같아"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 12,
  "jh": "6d6502520406",
  "ko": "훗, 거스를 수 있을 거라 생각하나?"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 8,
  "jh": "75e56470e109",
  "ko": "그! 그게! 고고고고고…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "de1ba9fb6847",
  "ko": "에나!? 그거 뭐야!?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 12,
  "jh": "447342d01c02",
  "ko": "특수한 칩을 머리에 심었을 뿐이다. 이 몸이 명령을 내리면 이대로다"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 8,
  "jh": "bf8e8739d8a5",
  "ko": "그가가가… 저는 군나르 님의 충실한 부하이옵니다…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 2,
  "jh": "33a2add76cad",
  "ko": "오오… 훌륭한 기술…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 6,
  "jh": "96ff4d6dfd75",
  "ko": "거긴 감탄할 데가 아닌 것 같은데"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 9,
  "jh": "6a4fe53784e0",
  "ko": "억지로 말을 듣게 하다니 스마트하지 않군"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 12,
  "jh": "efccd57006f6",
  "ko": "이 몸도 본의는 아니다만. 이 몸이 원하는 건 꼭두각시가 아니라"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 12,
  "jh": "21a6cf81d91f",
  "ko": "스스로의 의지로 이 몸을 위해 일해 줄 부하니까"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 8,
  "jh": "70852c0006c9",
  "ko": "읏! 하아, 하아…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 12,
  "jh": "5b8c5969377b",
  "ko": "거역해도 소용없다는 걸 알았겠지? 자, 얌전히 이 몸의 군문에 들어와라!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 8,
  "jh": "b724a2de841b",
  "ko": "…웃기지 마! 절대 네 부하 같은 거 안 될 거다!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 12,
  "jh": "b14ecc9480b2",
  "ko": "호오, 반항적이군. 좋아, 그쪽이 길들이는 보람이 있지…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 9,
  "jh": "6f037a90f87d",
  "ko": "그래 봤자 그 기계엔 거역할 수 없겠지…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "88fdf4b56ea2",
  "ko": "페페론, 네 차례야! 힘으로 뺏어!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 6,
  "jh": "aa3d6f3c89f0",
  "ko": "음~… 아무리 이 몸이라도 스승님이랑 저 선생님만은 이길 것 같지 않아"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 2,
  "jh": "3ac2779c3a4b",
  "ko": "…쓸모없어"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 12,
  "jh": "98e5de2ba129",
  "ko": "자, 다음엔 최대 출력으로 조종해 볼까. 두 번 다시 거역할 마음이 안 들도록…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 8,
  "jh": "1d5c3868c572",
  "ko": "크… 기다려! 나, 나랑 승부해!"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 12,
  "jh": "8edd8599e55b",
  "ko": "음… 승부라고?"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 8,
  "jh": "65a36302934f",
  "ko": "내가 지면 얌전히 당신 부하가 돼 주지"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 8,
  "jh": "b4a68380be31",
  "ko": "그 대신 내가 이기면 머릿속 기계를 빼!"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 12,
  "jh": "674982379ae2",
  "ko": "…재밌는 제안이다만 이 몸에겐 이점이 없군. 일부러 승부해 줄 의리도 없다"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 9,
  "jh": "ec32c8c2a1d2",
  "ko": "학생이 신청한 승부에서 도망쳤다면 주변 사람들이 널 어떻게 생각할까?"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 6,
  "jh": "9cc3d301ae79",
  "ko": "게다가 그 학생을 기계로 억지로 조종했다면 더더욱이지"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 12,
  "jh": "633d92d9b018",
  "ko": "으…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 1,
  "jh": "182394caed71",
  "ko": "아~ 그렇지. 교감으로서 체면이 완전 구겨지겠네"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 2,
  "jh": "a72583e442c6",
  "ko": "스스로 에나 군보다 약하다고 인정한 거나 마찬가지…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 12,
  "jh": "82de167a14b4",
  "ko": "후… 후후후. 좋다. 꼬마, 동료 덕에 살았군. 그 승부 받아 주마"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 8,
  "jh": "3a373b5afa9b",
  "ko": "정말이지?"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 12,
  "jh": "fec0aeee7a77",
  "ko": "사내에게 두말은 없다. 장소는 강당, 승부 방식은 일대일 주먹다짐"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 12,
  "jh": "77eeddc58be4",
  "ko": "내일까지 시간을 주마. 기계 손질이나 꼼꼼히 해 오도록"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 8,
  "jh": "3ec5278f3c16",
  "ko": "아아! 두고 봐라. 반드시 울상 짓게 해 줄 테니까!"
 },
 {
  "key": "m51",
  "kind": 5,
  "chr": 35,
  "jh": "4809c76f8f50",
  "ko": "…이런이런, 너도 별난 걸 좋아하네"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 12,
  "jh": "5fdb8d379dc0",
  "ko": "네놈인가. 엿듣기라니 여전히 좋은 취미군"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 12,
  "jh": "f5a3558a90af",
  "ko": "그런데 어떠냐? 꽤 그럴듯한 악역이었지"
 },
 {
  "key": "m54",
  "kind": 5,
  "chr": 35,
  "jh": "be389c6728b0",
  "ko": "30점이려나. 진짜 악역이라면 다짜고짜 기계로 말을 듣게 했겠지"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 12,
  "jh": "7ac3368f3ca1",
  "ko": "호오, 그런 건가. 이 몸도 아직 수행이 부족하군"
 },
 {
  "key": "m56",
  "kind": 5,
  "chr": 35,
  "jh": "94b8cee311d1",
  "ko": "뭐, 괜찮지 않아? 내일을 기대하고 있을게"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 12,
  "jh": "d2997c6c5fbb",
  "ko": "기다려라. 얘기를 들었다면 하나 협력해 줘야겠다"
 },
 {
  "key": "m58",
  "kind": 5,
  "chr": 35,
  "jh": "c63793d2b38f",
  "ko": "협력? 내키지 않는데. 넌 태연한 얼굴로 무리한 소릴 하니까"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 12,
  "jh": "248b6ab0dae4",
  "ko": "대단한 건 아니다. 그걸 움직일 수 있게 해 둬라"
 },
 {
  "key": "m60",
  "kind": 5,
  "chr": 35,
  "jh": "c8cd0e196344",
  "ko": "헤에, 그걸 쓸 생각이야? 별난 걸 넘어서 악취미네. 히힛히…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]