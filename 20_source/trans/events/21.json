[
 {
  "key": "m0",
  "kind": 2,
  "chr": 3,
  "jh": "f339ed522f79",
  "ko": "자, 재료는 다 모였네"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "fd6dd7c663f2",
  "ko": "네. 벌써 늦었으니 나머지는 내일이라도…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 3,
  "jh": "4a1ca639e2f5",
  "ko": "아니, 지금 당장 시작할 거야. 내일 아침 일찍 제출해야 하니까"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 7,
  "jh": "60fdd50e973e",
  "ko": "그렇게 서두르지 않아도. 저녁까지 내면 되잖아"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 3,
  "jh": "4f2e6992c411",
  "ko": "할 거면 항상 1등을 노리는 거야. 평가도 1등, 제출도 1등!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 7,
  "jh": "24f63051386e",
  "ko": "오오, 1등… 멋지다! 좋아, 하자! 나도 도울게!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 3,
  "jh": "8241a40d8065",
  "ko": "넌… 아무것도 안 해도 돼. 거기서 얌전히 있어"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 7,
  "jh": "f2c1d60da543",
  "ko": "그런!? 모처럼 의욕이 생겼는데!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 3,
  "jh": "da6ed3998342",
  "ko": "마음은 고맙지만 네가 도우면 오히려 방해가 된단 말이야"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 7,
  "jh": "61fca2495a90",
  "ko": "으~… 싫어 싫어! 돕는다면 도울 거야!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 3,
  "jh": "22561281958f",
  "ko": "이봐, 그만둬! 둘 다, 이 애 좀 붙잡고 있어!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 11,
  "jh": "ceaf9a6be07f",
  "ko": "네, 넵"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "c0865cb577ad",
  "ko": "쓸데없이 일 만들지 마"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 7,
  "jh": "9861ba38f1a2",
  "ko": "이거 놔~! 둘이서 덤비다니 비겁하다~! 앗! 방금 가슴 만졌지!?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "36427032007b",
  "ko": "어? 미, 미안…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 3,
  "jh": "bb72503129fb",
  "ko": "뭐… 가, 가슴을 만졌다고오!?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "c34b560d422c",
  "ko": "왜 아가씨가 화를 내세요"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "11878eb50e28",
  "ko": "그, 그렇게 큰 가슴이 좋으면 큰 가슴 있는 집 애가 되면 되잖아!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 11,
  "jh": "f0ad4b245706",
  "ko": "아가씨, 말이 엉망진창이에요"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 7,
  "jh": "6879f0584302",
  "ko": "찬스~! 이 틈에… 좋아, 재료 닥치는 대로 넣어 버리자!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "f0247b0dde6f",
  "ko": "앗, 그만둬! 너희, 제대로 붙잡고 있으라니까!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "ece942f86b15",
  "ko": "아가씨가 방해하셨잖아요"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 11,
  "jh": "8c0988752a7a",
  "ko": "아무래도 좋지만, 서두르지 않으면 날이 새 버려요?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 3,
  "jh": "76769bfd90ef",
  "ko": "아아 정말… 너희 전부 얌전히 있어!!"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 11,
  "jh": "68d2b859e6ec",
  "ko": "아가씨, 슬슬 주무시는 게…"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 3,
  "jh": "e525c8c42a53",
  "ko": "조금만 더야. 조금만 더 하면 끝나니까…"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 11,
  "jh": "a4bc21c09e3a",
  "ko": "그래도 밤샘은 몸에 해롭고… 안 그래도 요즘 피부 촉촉함이…"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 3,
  "jh": "6f276c582910",
  "ko": "아직 그럴 나이 아니야! 됐으니까 좀 조용히 해"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 3,
  "jh": "d591ff6da82e",
  "ko": "이제 수수 열매만 넣으면 완성… 응? 아아아아아아아!!"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 7,
  "jh": "193c4583debc",
  "ko": "앗!? 뭐, 무슨 일이야!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 0,
  "jh": "ff78424edebe",
  "ko": "왜 그러세요? 큰 소리를 내시고…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 3,
  "jh": "f80e5ed99028",
  "ko": "이 수수 열매, 시들었잖아! 누구야, 이런 걸 준비한 사람!?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 7,
  "jh": "aa816b34ccf6",
  "ko": "아, 저요 저요~! 나 나!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 3,
  "jh": "d456e37508fc",
  "ko": "뭘 신나서 손을 드는 거니!? 이런 거 못 쓰잖아!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 7,
  "jh": "7ea0f5446143",
  "ko": "아니~ 흐물흐물한 게 혀에 닿는 느낌이 좋을까 해서…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 3,
  "jh": "d96c489b926e",
  "ko": "혀에 닿는 느낌 이전의 문제야!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 7,
  "jh": "1093edbfc054",
  "ko": "그렇게 소리 안 질러도… 너무 화내면 잔주름 늘어나"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 3,
  "jh": "4d1ff4657568",
  "ko": "그러니까, 그럴 나이 아니라고 했잖아!"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 7,
  "jh": "202294341df8",
  "ko": "우와, 이렇게 화내다니… 혹시 정곡이었어?"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 3,
  "jh": "33a65be77a5c",
  "ko": "너랑은 한번 차분히 얘기를 해야겠구나…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 7,
  "jh": "01d274cafdc8",
  "ko": "우와, 왠지 무서워…? 아, 나머진 맡길게!"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 0,
  "jh": "41ceea7a1e63",
  "ko": "이, 이봐. 맡긴다 해도…"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 3,
  "jh": "fd610e7d02a5",
  "ko": "기다려!! …크, 할 수 없지. 로제, 서둘러 대신할 재료 좀 캐 와"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 0,
  "jh": "7248dc8e894b",
  "ko": "제가요?"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 3,
  "jh": "c221f986f0be",
  "ko": "어쩔 수 없잖아. 난 가마 앞을 떠날 수 없고…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 3,
  "jh": "dfbb071a6ee8",
  "ko": "너무 졸지 않도록 잘 조절해 둘 테니까 최대한 서둘러!"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 0,
  "jh": "04fc5fc02c96",
  "ko": "후우… 알겠습니다"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
