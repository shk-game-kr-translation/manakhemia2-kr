 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 11,
  "jh": "6b374efe6825",
  "ko": "아아아, 콧물이… 이걸로 닦으세요"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 7,
  "jh": "1b4cd32cf729",
  "ko": "으으으… 훌쩍… 에나한테 미움받았어…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 4,
  "jh": "ed6e582a90af",
  "ko": "오늘 처음 미움받은 것도 아닌데 이제 와서 뭘…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 7,
  "jh": "96e91ae77012",
  "ko": "그렇지 않은걸! 그렇게 면전에 대고 들은 적 없었는걸!"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 3,
  "jh": "9b25e8e41b45",
