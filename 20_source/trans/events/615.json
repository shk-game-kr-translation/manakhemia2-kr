 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 11,
  "jh": "69cb574618c7",
  "ko": "봐요, 대개 마지막엔 에나 씨가 기절당했으니까…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 3,
  "jh": "2a82e30f97d8",
  "ko": "아아, 그렇구나…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 22,
  "jh": "503069843694",
  "ko": "동생에게 미움받는 것만큼 괴로운 건 없지. 어떻게든 해 주고 싶다만…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 23,
  "jh": "1381b8248c17",
  "ko": "형은 남 걱정할 때가 아니라고 여동생이 중얼거리고 있어요"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 22,
  "jh": "cf612ec4a487",
  "ko": "그, 그건 무슨 뜻이냐!?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 3,
  "jh": "b1aa27e5dc44",
  "ko": "그래도 좋은 기회일지도 몰라"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 11,
  "jh": "4fb0aae21746",
  "ko": "무슨 말씀이세요?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 3,
  "jh": "8e3e19325524",
  "ko": "너도 좀 여자다움을 익혀야 해"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "15a1b905c8fb",
  "ko": "난폭하고 시끄럽고 생각 없고 덜렁대고 민폐에 방해꾼인 점만 고치면"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "87937f475c6b",
  "ko": "에나도 다시 봐 주지 않을까?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "e909a26609e8",
  "ko": "어수선한 틈에 하고 싶은 말 다 하시네요"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 7,
  "jh": "62cd9f6a91a7",
  "ko": "그렇구나… 그래도 여자다워지려면 어떻게 하면 돼?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 0,
  "jh": "d70e6388f225",
  "ko": "나한테 물어도… 다른 사람한테 물어"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 3,
  "jh": "3c3f7db9347b",
  "ko": "나를 본보기로 삼으면 틀림없어"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 5,
  "jh": "ee00abd1cc2f",
  "ko": "푸니!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 23,
  "jh": "76701366c396",
  "ko": "여자다움이라면 일가견이 있다! 라며 여동생은 자신만만해요"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 4,
  "jh": "dc9745f5efa7",
  "ko": "일반론이라도 괜찮다면 얘기해 줄 수 없는 것도 아니다만"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 7,
  "jh": "ddc4fee164b4",
  "ko": "오오오, 로제 말고 다들 든든해 보여…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 0,
  "jh": "338252ecc5b3",
  "ko": "미안하게 됐네. …뭐, 들어나 보는 게 좋지 않겠냐"
 },
