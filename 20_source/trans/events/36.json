 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 3,
  "jh": "33f50828dea6",
  "ko": "그, 그런! 푸니푸니랑 싸우다니…"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 4,
  "jh": "76873ce232c9",
  "ko": "푸니푸니 때문에 어린아이를 저버리는 건 사람의 도리에서 벗어나는 것 아닌가?"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 3,
  "jh": "6d4a9bcea0e2",
