 {
  "key": "m20",
  "kind": 0,
  "chr": 54,
  "jh": "d83743e8b5c8",
  "ko": "으억!?"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 7,
  "jh": "b411b6a6cc5e",
