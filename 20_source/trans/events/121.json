[
 {
  "key": "m0",
  "kind": 2,
  "chr": 12,
  "jh": "a4f2e89e056c",
  "ko": "수고했다. 꽤 좋은 싸움을 보여 줬다. 음, 실로 만족스럽다!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 3,
  "jh": "2a991e334bb3",
  "ko": "흥. 당신을 즐겁게 하려고 한 게 아니야"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 5,
  "jh": "2628b3ceed64",
  "ko": "푸니~! 푸니니!"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 23,
  "jh": "2c9695c6635c",
  "ko": "푸니요는 남을 즐겁게 하려고 싸운 게 아니다. 자기 자신을 위해 싸운 거다."
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 23,
  "jh": "c62986c1e14b",
  "ko": "…라고 여동생이 뾰로통한 표정으로 항의하고 있어요"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 7,
  "jh": "c4232d625991",
  "ko": "나야말로 즐거웠어요~!"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 12,
  "jh": "6386c3b0a43d",
  "ko": "하지만 싸움에는 항상 승자와 패자가 존재한다…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 12,
  "jh": "7967aebf7805",
  "ko": "승자에게는 아낌없는 찬사와 명예가 주어지지만, 패자에게 줄 것은 아무것도 없다"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 12,
  "jh": "438eb19e3c17",
  "ko": "그럼! 이번 우승자를 발표한다!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 12,
  "jh": "0a01765aac40",
  "ko": "우리 전투기술과의 에이스이자 이 몸의 수제자 로제!!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 12,
  "jh": "ea73eea1038b",
  "ko": "…와 그 외 한 명의 콤비다"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 12,
  "jh": "6da2e5c460e1",
  "ko": "우리 전투기술과가 자랑하는 2대 에이스! 로제와 에토가 압도적인 우승이다!!"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 0,
  "jh": "387642a6f7b5",
  "ko": "우리가 우승? 그보다 언제 내가 수제자가 된 거야…?"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 3,
  "jh": "cb4e6e80ec08",
  "ko": "뭐… 뭐야, 그 외 한 명이라니! 납득 못 해!"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 5,
  "jh": "7fb188ad387d",
  "ko": "푸니! 푸니~!!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 23,
  "jh": "9e2ae1ad3825",
  "ko": "푸니요를 그 외 취급하다니 무슨 짓이냐! 라고 여동생이 격노하고 있어요"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 24,
  "jh": "4d0a18a6bc8c",
  "ko": "푸니요는 그나마 나아. 우린 숫자에도 안 들어가…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 7,
  "jh": "8d14d01ec28a",
  "ko": "해… 해냈다~! 우승이래! 우와아아아! 굉장해 굉장해!"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 12,
  "jh": "39d14f141156",
  "ko": "떠들지 말고 빨리 이리 올라와라. 식이 진행이 안 되잖나"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "4dec89471b1a",
  "ko": "크… 그 교감이랑은 한번 차분히 얘기를 나눠야겠어…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 23,
  "jh": "d817ce12ed7a",
  "ko": "교감과는 나중에 차분히 얘기를 해야겠다… 라고 여동생은 아직 화가 덜 풀린 모양이에요"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 7,
  "jh": "b37c455faff2",
  "ko": "네~! 가자, 로제!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 12,
  "jh": "4078be7b0497",
  "ko": "잘했다. 네놈들은 현시점에서 틀림없는 학원 최강의 콤비가 된 거다"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 12,
  "jh": "09d93d162080",
  "ko": "자, 가슴을 펴고 성원에 응해 줘라!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "934ec087c6ea",
  "ko": "이런 건 질색인데…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 3,
  "jh": "edeb5dd64a88",
  "ko": "흥. 나랑 로제 둘이서 짰는데 질 리가 없잖아. 당연한 결과야"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 11,
  "jh": "086d6c2e7ba0",
  "ko": "저기~ 가끔은 저도 기억해 주세요…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 5,
  "jh": "2628b3ceed64",
  "ko": "푸니~! 푸니니!"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 23,
  "jh": "7d0553ce0d38",
  "ko": "거의 푸니요 혼자 힘으로 이긴 거나 마찬가지다! 라고 여동생이 큰소리치고 있어요"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 7,
  "jh": "024877072faa",
  "ko": "아, 아하하. 왠지 쑥스럽네. 나도 이런 거 익숙지 않고"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 12,
  "jh": "8501bc2980e2",
  "ko": "그리고 기다리던 이 몸의 부상이다. 자, 받아라"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "e03cd5729064",
  "ko": "이건, 수표…? 일, 십, 백, 천…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 3,
  "jh": "9cbbfb540461",
  "ko": "5000만? 꽤 큰 액수잖아"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 11,
  "jh": "2193cd2a32b3",
  "ko": "이런 금액을 어떻게 준비하셨을까요…"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 5,
  "jh": "473e42df498b",
  "ko": "푸니? 푸니니?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 23,
  "jh": "a093a7869d3f",
  "ko": "자릿수가 너무 많아서 모르겠어… 라고 여동생이 곤혹스러워하고 있어요"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 23,
  "jh": "e4e204250f3d",
  "ko": "있잖아, 이건 5000만이라고 쓰여 있는 거야"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 7,
  "jh": "737ed19246a8",
  "ko": "어… 어!? 5000만!? 굉장해!"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 0,
  "jh": "704900161ced",
  "ko": "아니, 잠깐. 단위가… GP? 뭐야 이건"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 12,
  "jh": "bae6b5e100e5",
  "ko": "군나르 포인트의 약자다"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 12,
  "jh": "5ed966a5e48c",
  "ko": "장래 전 세계에 전개할 예정인 군나르 그룹 가게라면 어디서든 쓸 수 있다"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 0,
  "jh": "21816ed83aa5",
  "ko": "군나르… 포인트?"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 3,
  "jh": "f207fc313b71",
  "ko": "시시해… 요컨대 지금은 아무 쓸모도 없다는 거잖아"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 11,
  "jh": "dbeb1ffdcf33",
  "ko": "영원히 쓸모없을 가능성도 높네요…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 23,
  "jh": "e4fdeeff0e2e",
  "ko": "그림의 떡이란 바로 이걸 말하는군… 이라며 역시 여동생도 어이없어하고 있어요"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 7,
  "jh": "f15f379cc277",
  "ko": "장래라는 건 지금은 못 쓴다는 거야? 뭐야~…"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 0,
  "jh": "6569ab6d4858",
  "ko": "뭐, 이럴 줄 알았지만…"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 12,
  "jh": "4372cc0323eb",
  "ko": "뭐냐, 감동이 부족하군. 더 온몸으로 기쁨을 표현해도 상관없다"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 0,
  "jh": "a0f2b32ed50e",
  "ko": "아뇨, 충분히 기뻐하고 있으니까요…"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 12,
  "jh": "48f258ef99f7",
  "ko": "그런가? 그렇다면 됐다"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 12,
  "jh": "31cd65c8f2f1",
  "ko": "이상으로 시상식은 종료다! 각자 얼마 남지 않은 학원제의 한때를 즐겨라!"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 12,
  "jh": "70652ccdfe01",
  "ko": "아~ 연금술과 울리카와 그 외 한 명이로군"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 0,
  "jh": "5986dee91ac5",
  "ko": "뭐… 그 녀석들한테 진 거야?"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 3,
  "jh": "d39e8c5bf251",
  "ko": "그런… 하필이면 그 시골뜨기한테!?"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m57",
  "kind": 2,
  "chr": 23,
  "jh": "8dce58c574f3",
  "ko": "울리카 씨한테 졌다면 어쩔 수 없다… 라고 여동생이 강한 척을 하고 있어요"
 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 7,
  "jh": "bc2257987cd0",
  "ko": "울리카한테 져 버렸구나~ 나중에 릴리아한테 혼나겠다…"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 12,
  "jh": "199b2c880429",
  "ko": "싸움 자체는 재밌었지만 결과는 대단히 유감이다"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 12,
  "jh": "b72528dc2e10",
  "ko": "이 몸의 전투기술과 녀석들이 설마 이 녀석들한테 뒤처질 줄이야…"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 1,
  "jh": "8dfe07ffc5f2",
  "ko": "잠깐! 좀 더 제대로 소개해! 모처럼 우승했는데!"
 },
 {
  "key": "m62",
  "kind": 2,
  "chr": 12,
  "jh": "4b00f2350af5",
  "ko": "다시 처음부터 단련시켜야겠군"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 12,
  "jh": "c886015f3248",
  "ko": "마침 곧 겨울방학도 시작되니…"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 0,
  "jh": "cdb8e84313e0",
  "ko": "자… 더 봐 봤자 소용없겠지"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 3,
  "jh": "ac0cb011b0fb",
  "ko": "그래. 그 시골뜨기가 기뻐하는 모습 따위 부탁해도 보기 싫어!"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m67",
  "kind": 2,
  "chr": 23,
  "jh": "3ceaf84b556b",
  "ko": "패자는 그저 떠날 뿐… 이라며 여동생이 작은 등에 애수를 풍기고 있어요"
 },
 {
  "key": "m68",
  "kind": 2,
  "chr": 7,
  "jh": "a80f8421be24",
  "ko": "분하다~ 다음에 기회가 있으면 꼭 우리가 우승하자"
 },
 {
  "key": "g0s0",
