[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "f40ffabc41ed",
  "ko": "자, 적은 어디야!? 내가 왔으니 각오해! …어, 아무도 없어?"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 2,
  "jh": "29ce09360296",
  "ko": "이거 혹시…"
 },
 {
  "key": "m2",
  "kind": 5,
  "chr": 4,
  "jh": "0b998b92988e",
  "ko": "그 말대로다. 너희는 보기 좋게 유인당한 거다"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 7,
  "jh": "d810dae0f93e",
  "ko": "윽! 윤!?"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 4,
  "jh": "04128af391f4",
  "ko": "어차피 오합지졸. 머리만 짓누르면 이 소동도 끝나겠지"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 1,
  "jh": "24c5db5cd5c7",
  "ko": "너 혼자서 이길 생각이야? 얕보였네"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 6,
  "jh": "34090f60daef",
  "ko": "맞아 맞아! 역으로 혼내 줄 거야!"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 4,
  "jh": "cdff78f1c859",
  "ko": "전보다 강해졌군… 조금 얕봤나"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 6,
  "jh": "ca3330da7f58",
  "ko": "하하하! 오늘 이 몸은 조금 진심을 냈거든"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 2,
  "jh": "ac48f050b0fb",
  "ko": "인질로 잡아서 고문하고… 아아, 기대돼…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 8,
  "jh": "30aa6b1d6716",
  "ko": "…이 누나는 진짜로 하니까. 도망치려면 지금이야"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 4,
  "jh": "c3eca182f98c",
  "ko": "확실히 이 자리는 도망칠 수밖에 없겠군. 하지만…"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 7,
  "jh": "9ebf35b4af56",
  "ko": "어? 크억! 커허억…"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 1,
  "jh": "3ae0b2c917cf",
  "ko": "에토!?"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 4,
  "jh": "f50795c01eb5",
  "ko": "최소한의 전리품이 없으면 주인을 볼 낯이 없어서 말이다"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 1,
  "jh": "6c651fbdcd48",
  "ko": "이봐, 기다려!"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 98,
  "jh": "a1d4ac2b20f3",
  "ko": "울리카 씨…"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 1,
  "jh": "46b886d22c77",
  "ko": "와와!? 잠깐, 방해하지 마! …어, 그 상처는 뭐야?"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 98,
  "jh": "03bcfc2446bb",
  "ko": "거기 있던 동지는 전원 붙잡혔습니다… 적은 그 기세로 이쪽에…"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 98,
  "jh": "0d697d831ccf",
  "ko": "적어도 울리카 씨만이라도 도망쳐서… 학원제의 희망의 불씨를…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 6,
  "jh": "fc2a9c38d417",
  "ko": "아아, 정신 차려! …여긴 이 몸의 전력 심장 마사지가 나설 차례인가!"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 8,
  "jh": "5226fe88fbf5",
  "ko": "전력이 뭔데! 전력이!"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 9,
  "jh": "a5d7120ce9c2",
  "ko": "으~음, 이건 패색이 짙군"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "a7ecbc6b5403",
  "ko": "앗! 맞다, 아직 이게 있었지… 여보세요!"
 },
 {
  "key": "m24",
  "kind": 5,
  "chr": 52,
  "jh": "bdd17c6ce941",
  "ko": "고전하는 모양이군. 벌써 기브업이냐?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "378b0d4cc97c",
  "ko": "무, 무슨 소리예요! 절대 포기 안 해요!"
 },
 {
  "key": "m26",
  "kind": 5,
  "chr": 52,
  "jh": "d009d3be06c4",
  "ko": "후, 그 기세다. 그럼 지하 하수도까지 도망쳐 와라"
 },
 {
  "key": "m27",
  "kind": 5,
  "chr": 52,
  "jh": "006c54c61472",
  "ko": "그다음 일은 이 몸이 어떻게든 해 주마"
 },
 {
  "key": "m28",
  "kind": 5,
  "chr": 52,
  "jh": "6ad5fd50f101",
  "ko": "그리고 탈인형은 있지? 그 녀석 바꿔라"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "90159cf83619",
  "ko": "어? 응… 고토. 너 바꾸래"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 9,
  "jh": "25258c041466",
  "ko": "네네. 야아… 응… 알았어. 그럼"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 6,
  "jh": "18e592a8d568",
  "ko": "무슨 얘기 했어?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 9,
  "jh": "48d01abcfa59",
  "ko": "뭘, 사소한 볼일이야. 그보다 빨리 안 가면 위험하지 않아?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 1,
  "jh": "32b4b94df38d",
  "ko": "앗, 그렇지. 다들, 서둘러 도망치자!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 8,
  "jh": "c916c95d92a1",
  "ko": "결국 패주냐… 앞으로 어떻게 되려나"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 2,
  "jh": "aae775d16664",
  "ko": "잘 돼야 퇴학이려나… 그땐 울리카한테 모든 책임을 떠넘겨야지…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 6,
  "jh": "8a5b944236a0",
  "ko": "넌 안 가?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 9,
  "jh": "b2966c6fdb21",
  "ko": "말했잖아, 사소한 볼일이라고. 뭐, 이쪽은 너한테 맡길게"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 6,
  "jh": "c2a0bf09baab",
  "ko": "으~음. 왠지 네가 맛있는 부분을 가져갈 것 같은 기분이 드는데"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 9,
  "jh": "920395b58ca8",
  "ko": "후후, 참아 줘. 그만큼 시대가 날 필요로 한다는 거야"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]