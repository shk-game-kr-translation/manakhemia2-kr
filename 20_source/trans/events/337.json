[
 {
  "key": "m0",
  "kind": 0,
  "chr": 1,
  "jh": "d1562ee3ca42",
  "ko": "완전히 놓쳤네… 이렇게 된 이상 감으로 나아갈 수밖에!"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 0,
  "jh": "ba1d400c8048",
  "ko": "…길을 잃었을 땐 움직이지 말고 가만히 있는 게 철칙이다"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 1,
  "jh": "2b8182b1e9d5",
  "ko": "길 잃은 거 아니니까 괜찮아. 음~… 아마 이쪽!"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 0,
  "jh": "d144d5147851",
  "ko": "어디까지 믿을 수 있을지…"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 14,
  "jh": "b1614b150a13",
  "ko": "…어라?"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 1,
  "jh": "6a575f4b5bcc",
  "ko": "아, 너!"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 0,
  "jh": "523339f43a67",
  "ko": "당신 쪽이 나왔나… 영감은 어디 있어?"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 14,
  "jh": "bee23ca40968",
  "ko": "영감…? 아~ 그 사람 말이구나. 아직 저쪽에서 자고 있지 않을까?"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 0,
  "jh": "bbe69f71fa14",
  "ko": "…그런가. 그럼 거기서 비켜. 네 상대는 나중에 해 주마"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 14,
  "jh": "cb9743aa1c5d",
  "ko": "해 주마…? 상대해 주는 건 내 쪽이잖아? 너 약하니까"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 0,
  "jh": "1e7594b6081c",
  "ko": "뭐…?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 14,
  "jh": "ceb2290a8ba0",
  "ko": "아무리 내가 부추겨도 계속 약한 채. 언젠간 강해질까 기대했는데"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 14,
  "jh": "babf967a6448",
  "ko": "정말 기대 이하야, 넌! 하, 아하하하하하!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "2d66e8e2e5d2",
  "ko": "뭐, 뭐야? 이 녀석… 왠지 무서운데…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 0,
  "jh": "cf02207b2565",
  "ko": "전에 만났을 땐 좀 더 멀쩡했는데"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "b240ce6cc935",
  "ko": "그래? 혹시 이 사람도 우류 때문에…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 14,
  "jh": "e98905279b84",
  "ko": "하하하… 왠지 점점 화가 나네. 너는 약하고, 그 사람도 약해졌고…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 14,
  "jh": "c84947ccfde4",
  "ko": "제일 강할 때 싸우고 싶었는데. …일부러 방해되는 마나까지 지워 줬는데…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 14,
  "jh": "9f6c15fa4d3d",
  "ko": "일부러 방해되는 마나까지 지워 줬는데, 완전히 맥이 빠져서는 말이야"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 0,
  "jh": "b2f76e321370",
  "ko": "마나를 지웠다…? 네가!?"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 14,
  "jh": "d33fcba0a884",
  "ko": "어라, 몰랐어? 아, 그렇구나. 알 리가 없지"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 14,
  "jh": "f3af20db09b3",
  "ko": "왜냐면 넌 아무것도 모르고 마나를 원망했으니까! 아하하, 아~하하하하!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 0,
  "jh": "8147014dbce6",
  "ko": "…야, 넌 저쪽 가 있어"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "abeeec10f791",
  "ko": "싫어"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 0,
  "jh": "0a515759c25f",
  "ko": "너랑 어울리는 건 영감 찾을 때까지라는 약속이었잖아"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "e16736bc5d58",
  "ko": "이 녀석, 우류를 검으로 찔렀어! 불평 한마디쯤은 하게 해 줘"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 0,
  "jh": "e07df29f35d8",
  "ko": "이쪽은 그런 수준 낮은 얘기 하는 게 아니야!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "35ef98245c93",
  "ko": "수준이 낮다니 무슨 뜻이야!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 14,
  "jh": "955ffa441f9f",
  "ko": "둘 한꺼번에라도 괜찮아. 귀찮으니까. 빨리 끝내자"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "fd8bdfa7eddf",
  "ko": "…게다가 이 녀석 짜증 나고. 한 대 패 주고 싶어"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 0,
  "jh": "723a23d1f443",
  "ko": "…발목만은 잡지 마!"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 0,
  "jh": "6500bea42789",
  "ko": "크…"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 1,
  "jh": "67e4275ed02e",
  "ko": "아파라… 뭐야, 이 녀석…"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 14,
  "jh": "a6e55eeb819f",
  "ko": "약해 약해. 아~ 약하다"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m35",
  "kind": 0,
  "chr": 14,
  "jh": "7384611a8bfc",
  "ko": "너무 약해서 재미없으니까 이제 끝장내 버리자. 우선 너부터…"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 0,
  "jh": "9015b82f349f",
  "ko": "그만둬!"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 14,
  "jh": "bb50681c0d7c",
  "ko": "안 그만둬. 자~!"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 1,
  "jh": "70d3ca91c008",
  "ko": "큭……!?"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 1,
  "jh": "b730bbd8aca3",
  "ko": "………어?"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 6,
  "jh": "8cf1be0b34d7",
  "ko": "후우. 위기일발이었네, 누나"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 1,
  "jh": "2f51792394a1",
  "ko": "페페론…? 왜…?"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 14,
  "jh": "6428a1b491e1",
  "ko": "넌 뭐야? 내 방해를 하는구나. 흐응…"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 6,
  "jh": "142dfeed7d7d",
  "ko": "자. 여긴 이 몸에게 맡기고 빨리 도망쳐!"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 0,
  "jh": "5080fc2ba425",
  "ko": "너 혼자서 어떻게 될 상대가 아니야"
 },
 {
  "key": "m45",
  "kind": 0,
  "chr": 6,
  "jh": "0faedff8d0a5",
  "ko": "하하하. 세계 제일 강하고 귀여운 이 몸이 진다는 거야?"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 1,
  "jh": "eb2cebddd853",
  "ko": "질 거야! 무조건!"
 },
 {
  "key": "m47",
  "kind": 0,
  "chr": 6,
  "jh": "3ea3a12f2716",
  "ko": "그렇게 힘차게 말 안 해도… 뭐, 잠깐 시간 버는 정도는 할 수 있어. 자, 빨리"
 },
 {
  "key": "m48",
  "kind": 0,
  "chr": 1,
  "jh": "b2b56a5004ae",
  "ko": "그래도…"
 },
 {
  "key": "m49",
  "kind": 0,
  "chr": 6,
  "jh": "41bbdcdc7489",
  "ko": "빨리!"
 },
 {
  "key": "m50",
  "kind": 0,
  "chr": 1,
  "jh": "d8a54a53b5c0",
  "ko": "으, 응… 미안해!"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 1,
  "jh": "6b13f9bdaa39",
  "ko": "왜 그래?"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 0,
  "jh": "a53853781493",
  "ko": "넌 이대로 도망쳐. 난 영감을 구하러 간다"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 1,
  "jh": "93bca2bcd5d1",
  "ko": "…설마 돌아가서 한 번 더 싸울 생각은 아니겠지"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 0,
  "jh": "bd4906de4a35",
  "ko": "그렇게까지 무모하진 않아"
 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 1,
  "jh": "ecd2b722ad30",
  "ko": "응, 그럼 됐어. 조심해!"
 },
 {
  "key": "m56",
  "kind": 2,
  "chr": 0,
  "jh": "d7f87cc0c40d",
  "ko": "너야말로"
 },
 {
  "key": "m57",
  "kind": 0,
  "chr": 1,
  "jh": "e2ca2d911179",
  "ko": "페페론… 꼭 돌아와야 해"
 },
 {
  "key": "m58",
  "kind": 0,
  "chr": 6,
  "jh": "4b41e7f35774",
  "ko": "순순히 보내 주다니 좀 의외였어. 생각보다 신사인가?"
 },
 {
  "key": "m59",
  "kind": 0,
  "chr": 14,
  "jh": "6eb2c623f874",
  "ko": "왜냐면 그 사람들보다 네가 더 강하잖아? 약한 사람 상대해 봤자 재미없고"
 },
 {
  "key": "m60",
  "kind": 0,
  "chr": 6,
  "jh": "01355711bf05",
  "ko": "후훗훗. 이 몸의 강함을 꿰뚫어 보다니 형씨도 상당한 실력자인가 보군"
 },
 {
  "key": "m61",
  "kind": 0,
  "chr": 14,
  "jh": "1f7d238efbe3",
  "ko": "됐으니까 빨리 진심을 내 줘. 난 지금 엄청 즐겁고, 엄청 짜증 나 있거든!"
 },
 {
  "key": "m62",
  "kind": 0,
  "chr": 6,
  "jh": "5a4e8b0f5474",
  "ko": "말 안 해도 그럴 생각이야!"
 },
 {
  "key": "m63",
  "kind": 2,
  "chr": 14,
  "jh": "45e7197787f0",
  "ko": "응…? 어라, 너 혹시…"
 },
 {
  "key": "m64",
  "kind": 2,
  "chr": 14,
  "jh": "c0456fbb1897",
  "ko": "뭐야. 내 검으로 베면 순식간에 승부가 나 버리잖아…"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 6,
  "jh": "a596ee62a320",
  "ko": "걱정 마. 이 몸은 인간도 마나도 아니야… 요정 씨거든!"
 },
 {
  "key": "m66",
  "kind": 2,
  "chr": 14,
  "jh": "e2300d12c090",
  "ko": "헤에? 그럼 시험해 볼까. 부탁이니까 날 실망시키지 말아 줘어어!!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]