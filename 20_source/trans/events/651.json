 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 2,
  "jh": "edf8d4361460",
  "ko": "다음에 몰래 만드는 법 물어볼까…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 6,
  "jh": "97669c3ca6d1",
  "ko": "그래도 형한테도 놀랐어. 설마 거기서 승부를 걸 줄이야!"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 8,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 9,
  "jh": "62c276d2a8df",
  "ko": "당연히 승산은 있는 거지? 뭐, 그렇지 않으면 그런 말 안 꺼냈겠지만"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "65b11a86a685",
  "ko": "그야 그렇지. 아무리 형이라도 거기까지 경솔하진 않아!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 8,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "2ed2d7f72e8f",
  "ko": "왜 가만히 있어. 너 설마…?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 8,
  "jh": "0cfc7e85086a",
  "ko": "어… 어떡하지!? 그만 기세로 그런 말을!! 이길 리가 없잖아! 아~!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "4f1ca89925ac",
  "ko": "우와~… 아까는 좀 멋있었는데…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 2,
  "jh": "f0ff63ee6158",
  "ko": "에나 군답다면 다운데…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 8,
  "jh": "03fce9f83d8a",
  "ko": "그렇게 말해도 달리 어쩔 수 없었잖아!?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 9,
  "jh": "cf7228d549b1",
  "ko": "자자, 진정해. 아까의 넌 꽤 훌륭했다고 생각해"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 9,
  "jh": "31c8eec14a52",
  "ko": "아무것도 안 했으면 그 자리에서 억지로 부하가 됐을 테니까"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 8,
  "jh": "9c08a545f180",
  "ko": "그, 그렇지. 나 틀리지 않았지?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 9,
  "jh": "7b354937c89e",
  "ko": "아아. 안 돼도 본전이라지만 모처럼의 기회를 얻었어"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 9,
  "jh": "a611fa39beae",
  "ko": "여기선 후회가 남지 않도록 죽을 각오로 맞설 수밖에 없지 않을까"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 8,
  "jh": "c2fb0edcef20",
  "ko": "…그렇지. 만일이라는 것도 있고, 해 보지 않으면 모르지!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 8,
  "jh": "ecbf1de87ce3",
  "ko": "좋아, 그렇게 정했으면 기계 정비다. 최고의 상태로 만들어야지!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "49103847e8dd",
  "ko": "…정말 단순하네. 에나는"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 2,
  "jh": "240c7c9a18cf",
  "ko": "이렇게 해서 몇 번이나 탈인형 씨한테 속아 왔는지…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 9,
  "jh": "91d2f8ae7b0b",
  "ko": "사람 듣기 나쁘게. 뭐, 저 단순함은 그의 장점이라고 생각해"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "1399c9518d87",
  "ko": "라기보다 너도 아무렇게나 말하고… 지면 교감한테 끌려간다고?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "f15f838a9a90",
  "ko": "에나 군이랑 있는 것도 오늘이 마지막… 이럴 줄 알았으면 더 잘해 줄걸…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 6,
  "jh": "2a1caca5c80c",
  "ko": "벌써 영영 이별 모드네"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 9,
  "jh": "b04163998871",
  "ko": "뭐, 그 교감이니까 쓸데없는 걱정으로 끝날 것 같기도 하지만"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "0c765c426ef2",
  "ko": "어? 무슨 뜻이야?"
 },
 {
  "key": "m29",
  "kind": 5,
  "chr": 8,
  "jh": "c7abfe1c9ee0",
