[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "0a7315f7d8d9",
  "ko": "자… 그럼 힘내!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 8,
  "jh": "2ebb28cb3451",
  "ko": "뭐? 나 혼자 하는 거야?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "e365718864a7",
  "ko": "당연하지. 저쪽도 혼자인데"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 8,
  "jh": "20fe0ffe93ef",
  "ko": "그게 아니라, 작전 같은 건 없냐고!?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "bceb92357051",
  "ko": "작전? 그런 거 필요 없잖아"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 8,
  "jh": "6d6619630af3",
  "ko": "대충도 정도가 있지…"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "2e5dfac602fe",
  "ko": "떼쓰지 마. 승부 판 깔아 준 것만으로도 감사해 줬으면 좋겠어"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 8,
  "jh": "21517d3b712c",
  "ko": "판은 무슨! 저건 억지로 휘말리게 했다고 하는 거야!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "f4b3337bff78",
  "ko": "뭐야! 네가 여자 이름은 싫다고 해서 협력해 줬는데!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 8,
  "jh": "cb7278186f6d",
  "ko": "말도 안 했고 부탁도 안 했어!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "01ea4b930d46",
  "ko": "정해진 걸 질질 끌기는… 이름만이 아니라 태도도 남자답지 못하네!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 8,
  "jh": "bb703687ca3b",
  "ko": "뭐, 뭐라고!?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 2,
  "jh": "206dd516c053",
  "ko": "그렇게 생각하면 어울릴지도… 에나 짱"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 6,
  "jh": "e1cc54d1f33c",
  "ko": "에나 누나… 응, 의외로 잘 맞네"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 8,
  "jh": "c218d6110723",
  "ko": "너희… 아아, 알았어! 남자답게 그 바보 누나를 날려 버리고 오지!"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 6,
  "jh": "e841e2289ba1",
  "ko": "야무진 것 같으면서 잘 넘어가는 성격이네"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 2,
  "jh": "454d9073b0df",
  "ko": "좋은 장난감을 손에 넣었을지도… 그래도 이길 수 있을까…?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 7,
  "jh": "475ca00a3090",
  "ko": "왠지 오랜만이네. 마지막으로 승부한 게 몇 년 전이었더라?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 8,
  "jh": "457ff01902d9",
  "ko": "…5년 전. 내가 전신 복합 골절됐을 때야"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 7,
  "jh": "137ace4e54e5",
  "ko": "아~ 굉장했지! 온몸에 붕대 칭칭 감아서 미라 남자 같았어~"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 8,
  "jh": "464c3de79d39",
  "ko": "이제 그때의 내가 아니야. 그 뒤로 오로지 기계 실력을 갈고닦았다고"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 7,
  "jh": "2c034a519d67",
  "ko": "그럼 빨리 시작하자. 안 오면 이쪽에서 간다"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 8,
  "jh": "f6dfd6da23a3",
  "ko": "좋아… 쌓이고 쌓인 원한, 지금이야말로 풀어 주마!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 7,
  "jh": "5c6f764fbdb8",
  "ko": "아야야… 우와~ 에나 강해졌네"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 8,
  "jh": "6a009f061301",
  "ko": "내가 밀어붙이고 있어…? 혹시 진짜로 이길 수 있어!?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "a59430fc3d31",
  "ko": "봐, 에나가 이길 것 같아! 저쪽은 손도 발도 못 쓰잖아!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 6,
  "jh": "385e4de6d211",
  "ko": "아니~ 손도 발도 못 쓴다기보다는…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 7,
  "jh": "6b2dd9d0f55c",
  "ko": "음~… 있잖아 로제. 역시 봐주면 재미없어~"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 0,
  "jh": "a044a7026b25",
  "ko": "좋은 승부가 되고 있잖아"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 7,
  "jh": "0bdf64fa74ea",
  "ko": "그래도 양손 양발 쓰면 안 되면 공격을 못 하잖아?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 0,
  "jh": "b23a3fac53c2",
  "ko": "…싸우기 시작할 때까지 몰랐던 너한테 놀라고 있어"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 8,
  "jh": "17af4d25f440",
  "ko": "뭐… 뭐라고!?"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 6,
  "jh": "0e1f129cb5ed",
  "ko": "양손발 안 쓰고 형 공격을 막아 내고 있었다니… 예상 이상의 실력 차네"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 2,
  "jh": "b5160756b764",
  "ko": "응… 게다가 예상 이상의 바보…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 7,
  "jh": "13b5cb6dd176",
  "ko": "우~… 역시 봐주기 그만! 모처럼의 승부니까 진심으로 해야지!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 8,
  "jh": "92b2e6cc6be8",
  "ko": "어? 야, 이봐… 기다려! 오, 오지 마아!"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 8,
  "jh": "ba4de7985192",
  "ko": "크… 커헉…"
 },
 {
  "key": "m37",
  "kind": 0,
  "chr": 7,
  "jh": "3953ef1687a5",
  "ko": "어라? 벌써 끝? 이제 막 시작했는데… 좀 더 놀자~"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 2,
  "jh": "c4ad85f52bfe",
  "ko": "…너무 압도적이야"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 6,
  "jh": "9330332be114",
  "ko": "그러니 이름도 뺏기지 싶을 만큼 멋지게 졌네…"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 1,
  "jh": "fb8af92ab9e8",
  "ko": "아, 아하하하… 왠지 나쁜 짓 해 버렸네. 결과적으로"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 2,
  "jh": "02b3dfccccd7",
  "ko": "…당한 본인은 웃을 일이 아닐 거야"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 7,
  "jh": "0fe71026c384",
  "ko": "에나~? 있잖아~"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 8,
  "jh": "cba9f84766d4",
  "ko": "그러니까, 이 녀석이랑은… 엮이고… 싶지 않았… 털썩"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 7,
  "jh": "ced0fe3768c9",
  "ko": "있잖아~ 더 놀자. 있잖아~"
 },
 {
  "key": "m45",
  "kind": 0,
  "chr": 8,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]