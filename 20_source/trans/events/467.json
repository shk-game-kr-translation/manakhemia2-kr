 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 2,
  "jh": "abb61ef01682",
  "ko": "괜찮다는 게 증명됐으니… 자, 요정 씨 몫"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "9e779d87d5aa",
  "ko": "에에에!? 이 몸 몫이 남아 있었어?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 2,
  "jh": "0282941191f4",
  "ko": "당연하지… 자"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 6,
  "jh": "a70b6408540b",
  "ko": "그, 그래도 이제 효과는 알았으니까 이 몸이 안 마셔도…"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 2,
  "jh": "3ce1cb255ccd",
  "ko": "토니 선생님으론 안 돼… 건강한 사람을 더 건강하게 하는 게 재밌어…"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 6,
  "jh": "f536ccd62f9f",
  "ko": "그, 그런… 누나! 뭐라고 좀 해 줘!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "78629efaabc8",
  "ko": "뭐, 이번 건 괜찮지 않아?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 8,
  "jh": "25862d3dee0f",
  "ko": "건강해질 뿐이잖아. 나에 비하면 훨씬 낫잖아"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 6,
  "jh": "425dd957e286",
  "ko": "그런~…"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 2,
  "jh": "f545ab56e3c5",
