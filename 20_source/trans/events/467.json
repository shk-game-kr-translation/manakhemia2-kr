 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 2,
  "jh": "385ceec63bb1",
  "ko": "체력이 다하면 알아서 멈출 거야…"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 9,
  "jh": "f12cfa53f29c",
  "ko": "체력이 다하면, 인가. 페페론의 체력은 보통이 아닌데"
 },
 {
  "key": "m61",
  "kind": 2,
  "chr": 1,
  "jh": "053cbbb6c01d",
