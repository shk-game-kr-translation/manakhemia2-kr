  "jh": "f9c69e43e96d",
  "ko": "으아아아아악…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "8963131bc673",
  "ko": "비명!? 방금 그거 토니 선생님 목소리…?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 9,
  "jh": "d7821b4607a4",
  "ko": "늦었나… 아까운 사람을 잃었군"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 8,
  "jh": "07a0d31ba5eb",
  "ko": "아직 그렇게 정해진 건 아니잖아! 서두르자"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 2,
  "jh": "5182d9585a80",
  "ko": "아, 다들…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 9,
  "jh": "d3d8ec08c232",
  "ko": "결국… 저질러 버렸구나"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 2,
  "jh": "44f64a6c6de4",
  "ko": "아니야… 내가 왔을 땐 이미 쓰러져 있었어…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "5cd42ab379ba",
  "ko": "선생님 입에서 초록 즙이 흐르는데?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 2,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 2,
  "jh": "1826198fcbb9",
  "ko": "울리카, 잠깐 이 병 좀 들고 있어…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "7c6162a78a1d",
  "ko": "어, 응…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "8e67b4151635",
  "ko": "이걸로 범인은 울리카라는 걸로…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "7e67d38a1418",
  "ko": "안 되거든!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 2,
  "jh": "f3308b512706",
  "ko": "칫… 그래도 괜찮아. 주술이 너무 잘 들었을 뿐이니까…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "b1e829170055",
  "ko": "깨어나면 전보다 건강해져 있을 거야… 아마"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 20,
  "jh": "5b7cb1d977da",
  "ko": "음, 으으으…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 8,
  "jh": "7390ccad2ac3",
  "ko": "오, 일단 살아는 있었나 보네…"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 20,
  "jh": "e28b94b42cfb",
  "ko": "으… 왜 이런 데서 자고 있는 거냐, 난…?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 2,
  "jh": "3374fdd2831b",
  "ko": "분명 과로… 틀림없어…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 20,
  "jh": "76b37479d2d2",
  "ko": "그런가…? 확실히 요즘 이래저래 일이 많았으니까…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 9,
  "jh": "26c999d0892c",
  "ko": "쓰러지기 직전 기억이 없어진 모양이군…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "0bc23d15e856",
  "ko": "응… 무섭다, 검은 누나의 저주!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 20,
  "jh": "d1a473b6e3dd",
  "ko": "후우… 왠지 머리가 개운하군. 머리뿐 아니라 몸도 왠지…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 20,
  "jh": "55319b13564c",
  "ko": "…왠지 가만히 못 있겠어! 근처 한 바퀴 뛰고 오마!"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 1,
  "jh": "8e612f807f35",
  "ko": "와!? 선생님…?"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 2,
  "jh": "32facbcf86b0",
  "ko": "다녀오세요…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 8,
  "jh": "d2572b4e0b04",
