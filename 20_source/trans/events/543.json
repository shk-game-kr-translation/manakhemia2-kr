[
 {
  "key": "m0",
  "kind": 0,
  "chr": 5,
  "jh": "2305f4f3b269",
  "ko": "푸니! 푸니!"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 22,
  "jh": "80283536f50a",
  "ko": "아니, 그러니까 푸니요. 그건…"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 5,
  "jh": "b9932bf38660",
  "ko": "푸니~, 니!"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 22,
  "jh": "5745f47bcbe8",
  "ko": "아아, 정말…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 7,
  "jh": "dd1bc82f4948",
  "ko": "뭐야 뭐야? 푸니요, 싸우는 거야?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 23,
  "jh": "4c5d59ae1a22",
  "ko": "싸운다기보다… 지난번 일 이후로 푸니요가 완전히 무투파가 돼 버려서"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 0,
  "jh": "0e96f103aeb3",
  "ko": "무투파?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 23,
  "jh": "a8ea1b9fa3eb",
  "ko": "네. 스스로 강해져야 한다고 마음먹은 것 같아서…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 23,
  "jh": "4ebdd64c1a10",
  "ko": "그걸 형이 필사적으로 달래고 있는 거예요"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 5,
  "jh": "0e7ce8354f46",
  "ko": "푸니! 푸니니니! 푸니!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 22,
  "jh": "791e0c6f9a5a",
  "ko": "뭣! 여동생이라 해도 그건 그냥 넘길 수 없다!"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 11,
  "jh": "583a6140f107",
  "ko": "방금 뭐라고 하셨어요?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 23,
  "jh": "2b169ee97f6b",
  "ko": "푸니요가 강해지는 게 안 된다면 그만큼 형이 강해지면 된다"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 23,
  "jh": "20119155d24f",
  "ko": "형이 약하니까 다들한테 폐를 끼친다, 고…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 7,
  "jh": "6ce814725a7c",
  "ko": "와, 독하다…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 24,
  "jh": "16e01609a964",
  "ko": "타로 형 진정해. 푸니요도 말이 지나쳐"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 22,
  "jh": "3854ec1bafb7",
  "ko": "으으음… 좋아, 네 말은 알았다"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 22,
  "jh": "bd3894b75793",
  "ko": "그렇다면 하나만, 빨리 강해지는 방법이 있다"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 24,
  "jh": "2a9c86634757",
  "ko": "그런 방법이 있어?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 22,
  "jh": "f21fd6ac8d89",
  "ko": "그건… 지로가 아니라 이 오빠를 타는 거다! 그러면 너의 전투력은 비약적으로…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 22,
  "jh": "9bbb0b889ddc",
  "ko": "왜, 왜냐! 왜 싫어하는 거냐!?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 24,
  "jh": "dac8c500a95a",
  "ko": "전부터 물어보려 했는데… 왜 타로 형을 타기 싫은 거야?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 5,
  "jh": "c53464e3c448",
  "ko": "푸니니니~. 푸니!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 22,
  "jh": "737377c4d90b",
  "ko": "뭐, 뭐라고!!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 23,
  "jh": "d274ebd75d1e",
  "ko": "푸니요, 그건…!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 7,
  "jh": "95b8de890c70",
  "ko": "뭐야 뭐야? 우리한테도 알려 줘~"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 24,
  "jh": "aaf6fb60bf0e",
  "ko": "타로 형은 근육질이라 딱딱해서 푸니요 엉덩이가 아프다고…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 0,
  "jh": "8ed633f31205",
  "ko": "근육질…? 푸니푸니인데?"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 3,
  "jh": "89aa0ff32ad5",
  "ko": "확실히 타로의 탄력은 다른 푸니푸니에 비해 몇 단계 떨어지지만…"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 11,
  "jh": "7e7fe4ea2681",
  "ko": "그 차이를 아는 인간은 아가씨뿐일 거예요"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 22,
  "jh": "90e9ebfcb2fe",
  "ko": "그런 이유였다니… 하, 하하하하하! 완전 피에로였군, 난…"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 24,
  "jh": "ae35a3925de1",
  "ko": "앗, 타로 형!"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 24,
  "jh": "e225a26d2237",
  "ko": "푸니요… 타로 형, 엄청 상처받았어?"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 5,
  "jh": "7ea7b0907d7f",
  "ko": "푸니~!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 23,
  "jh": "67c3433bafc6",
  "ko": "그런 건 푸니요가 알 바 아니다! 라며 여동생도 분개하고 있어요"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 7,
  "jh": "1b3b33e8ae3d",
  "ko": "그래도 왜 그렇게 충격받았을까?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 3,
  "jh": "fa5191659b35",
  "ko": "맞아. 탄력은 없어도 그건 그거대로 유일무이한 촉감인데"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 23,
  "jh": "f7e3cba372fc",
  "ko": "타로 형은… 옛날엔 푸니푸니계 제일의 찹쌀떡 피부를 가졌었어요"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 23,
  "jh": "b0d34a91c61b",
  "ko": "신축 자재로 유연하고, 그 극상의 부드러움은 모두의 동경의 대상이었죠…"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 3,
  "jh": "14f3a95e6696",
  "ko": "푸니푸니계 제일의 찹쌀떡 피부라고!? 그 얘기, 자세히…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 11,
  "jh": "e7a95196b801",
  "ko": "아가씨, 중요한 얘기 같으니까… 그래서, 왜 그게 근육질로?"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 23,
  "jh": "9306ea0d804c",
  "ko": "푸니요를 지키기 위해서예요… 푸니요가 아직 푸니푸니에 올라탈 수 없을 만큼 어렸을 때"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 23,
  "jh": "2a0d95a142e0",
  "ko": "형은 말 그대로 몸을 던져 푸니요를 계속 지켰어요"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 7,
  "jh": "25d400606ed8",
  "ko": "오오오… 좋은 얘기네…"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 23,
  "jh": "fec9833b2b38",
  "ko": "하지만 적의 공격을 받을 때마다 형의 몸은 조금씩 딱딱해져서… 다시는 돌아오지 않을 만큼"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 4,
  "jh": "894574fc6b17",
  "ko": "여동생을 생각해서 한 일이 결과적으로 여동생에게 미움받는 원인이 됐다는 건가"
 },
 {
  "key": "m47",
  "kind": 2,
  "chr": 5,
  "jh": "d4b10549c94e",
  "ko": "푸니니, 니?"
 },
 {
  "key": "m48",
  "kind": 2,
  "chr": 24,
  "jh": "426cdb739fc8",
  "ko": "응, 정말이야. 그래서 푸니요가 근육을 부정해서 슬펐던 게 아닐까"
 },
 {
  "key": "m49",
  "kind": 2,
  "chr": 5,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 23,
  "jh": "06036c01fb3f",
  "ko": "괜찮아. 형은 강한 사람이니까 금방 돌아올 거야"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 23,
  "jh": "523943a179bb",
  "ko": "그래도 돌아오면 제대로 사과해야 해"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 5,
  "jh": "a9c0158ea4cb",
  "ko": "푸니~…"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
