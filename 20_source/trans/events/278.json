  "jh": "9b666f52a9fd",
  "ko": "아, 거만녀!"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 3,
  "jh": "75c83a94974a",
  "ko": "음! 그 호칭은 그만두라고 했잖아, 시골뜨기!"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "2eae38fd0cbc",
  "ko": "너야말로 그만해! …응? 너 혼자야? 그 녀석은 같이 아니야?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 3,
  "jh": "69f944fbe06d",
  "ko": "시, 시끄러워. 너랑은 상관없잖아!"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 11,
  "jh": "6896777f0487",
  "ko": "저기, 아가씨 혼자가 아니라 일단 저도 있는데요…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 2,
  "jh": "be0190419521",
  "ko": "혹시 차인 거…?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 8,
  "jh": "949090e9536c",
  "ko": "설마 차인 건 아니겠지?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 11,
  "jh": "3e1433f71881",
  "ko": "아…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 3,
  "jh": "e896fda28023",
  "ko": "뭐, 라, 고…? 누가, 누구한테 차였다고…?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 1,
  "jh": "ea19efd0a32c",
  "ko": "왠지 정곡인 것 같은데…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 2,
  "jh": "e3b83d3645a3",
  "ko": "역시…"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 8,
  "jh": "4daf1079c774",
  "ko": "윽, 진짜냐… 농담이었는데…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 3,
  "jh": "392007062d6a",
  "ko": "크… 이제 용서 못 해… 이렇게 된 이상 너희한테 화풀이해 주겠어!!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 11,
  "jh": "6d141b3b0484",
  "ko": "아가씨, 말씀이 너무 한심해요"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "f41d400ac84d",
  "ko": "휘말리는 쪽은 민폐…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 8,
  "jh": "449ea27dd7c5",
  "ko": "아~… 왠지 화나게 해 버린 것 같네…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "3f0d9bb82687",
  "ko": "네 한마디가 원인이잖아. 상대 안 할 수도 없고… 할 수 없지"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "d322ac74f818",
  "ko": "으, 으으으…"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "10a2bb73e080",
  "ko": "아~ 그만 진심으로 해 버렸는데… 괜찮아?"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 3,
  "jh": "9c47988de72a",
  "ko": "로제한테 버림받고, 너희한테 두들겨 맞고… 너무 비참해…"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 11,
  "jh": "45a4ef886e15",
  "ko": "자자, 흔한 일이잖아요"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "e96b28c119d2",
  "ko": "무슨 뜻이야! 내가 맨날 이런 꼴을 당한다는 거니!?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 11,
  "jh": "33e6a68b50e1",
  "ko": "아야, 아야야! 죄, 죄송해요! 그만 말이 헛나와서…"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "ae6d4f6e70df",
  "ko": "…도망치려면 지금이야"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 8,
  "jh": "617d06c463fb",
  "ko": "야, 지금 도망치는 게 좋지 않겠냐?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "29ab6c6833ce",
  "ko": "그러네. 더 이상 어울려 줄 수 없어"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 3,
  "jh": "1ce2062b4bbc",
  "ko": "흥! 손맛도 없네… 뭐, 조금은 속이 풀렸어"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 3,
  "jh": "2a3723e8af90",
  "ko": "자, 이러고 있을 때가 아니야. 빨리 로제를 찾으러 가야지"
 },
 {
  "key": "m28",
  "kind": 2,
