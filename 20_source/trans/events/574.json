 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 6,
  "jh": "8a0622359543",
  "ko": "스승님은 옛날 사람이라 그런 거에 유난히 집착… 앗!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 30,
  "jh": "1575b79b3654",
  "ko": "또 저질렀냐…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 6,
  "jh": "167faa0d2aab",
  "ko": "으아, 화끈하게 저질렀어… 금방 치울게"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 30,
  "jh": "b532c52b1371",
  "ko": "쯧… 이봐, 저 녀석은 아틀리에에서도 이런 식이냐?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 1,
  "jh": "a0aa6fe05365",
  "ko": "뭐, 대체로 저런 느낌이야"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 8,
  "jh": "b45632fecd9d",
  "ko": "시험관이나 플라스크 같은 거 자주 쥐어 터뜨리지"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 9,
  "jh": "1ab878590564",
  "ko": "요전엔 기세가 넘쳐서 아틀리에 문을 부쉈었지"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "08f08195af6d",
  "ko": "바닥에 구멍도 냈어…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 30,
  "jh": "fd24031379bd",
  "ko": "…그게 요정 씨로서 도움이 되는 거냐?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "2d2fd2b320ad",
  "ko": "…솔직히 미묘해"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 8,
  "jh": "21067546f813",
  "ko": "경호원으로선 다소 도움이 될지도 모르지"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 2,
  "jh": "1bbf039be1b6",
  "ko": "분위기 띄우는 요원…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 30,
  "jh": "786a42d1545c",
  "ko": "뭐라고… 큭, 역시 아직 밖에 내보내기엔 일렀나. 요정 씨의 수치를…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 30,
  "jh": "53174eae9728",
  "ko": "이봐, 페페론! 잠깐 와라!"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 6,
  "jh": "eb79de005fd6",
  "ko": "뭐야? 아직 정리 안 끝났어"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 30,
  "jh": "1ef80ad59629",
  "ko": "그런 건 나중에 해도 돼. 지금 당장 수행 다시 한다!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 6,
  "jh": "cbeb680cd959",
  "ko": "오오, 수행! 오랜만이네!"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 30,
  "jh": "4628ca698d7b",
  "ko": "요정 씨란 무엇인지 다시 한번 가르쳐 주마! 당신도 같이 와!"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "fb758552bb8d",
  "ko": "어? 왜, 왜 나까지?"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 30,
  "jh": "9798ad605fe5",
  "ko": "겸사겸사 고용주의 마음가짐도 가르쳐 주지. 자, 시간이 아깝다! 가자!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 6,
  "jh": "929da120abc4",
  "ko": "오! 가자, 누나! 피와 땀과 선혈과 유혈의 수행으로!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "03761009c774",
  "ko": "피뿐이잖아! 싫어, 난 하기 싫어~!"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 2,
  "jh": "90db2e32bd5e",
  "ko": "두고 갔네… 우리도 갈래?"
 },
 {
