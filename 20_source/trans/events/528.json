[
 {
  "key": "m0",
  "kind": 0,
  "chr": 18,
  "jh": "39c45167e54e",
  "ko": "후우… 이번 달도 또 적자예요…"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 18,
  "jh": "93d34dcb021f",
  "ko": "정말이지, 그 교감이 오고 나서부터 쓸데없는 지출만 늘고!"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 18,
  "jh": "1aaf43f50544",
  "ko": "또 자금 원조처를 찾아야… 어머? 제 장부가 어디에…?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 32,
  "jh": "d2af7245204e",
  "ko": "와루타 백작한테서 2000만 콜 기부금"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 32,
  "jh": "305ced23b6fb",
  "ko": "절반은 수중에 남기고 나머지는 은행을 통해 반환…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 18,
  "jh": "56d13ad9c66e",
  "ko": "누, 누구예요!? 거기 있는 건!?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 32,
  "jh": "4ca75a75106e",
  "ko": "잉여 세수를 기부금으로 받아서 돈세탁을…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 32,
  "jh": "a385f70e88a7",
  "ko": "어른들의 세계는 더러워"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 18,
  "jh": "6d25073889a4",
  "ko": "아이? 왜 아이가 이런 곳에…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 18,
  "jh": "1aedefb8c51d",
  "ko": "읏, 그 장부는 당신이 볼 게 아니에요. 자, 돌려주세요!"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 32,
  "jh": "8923446e7ee1",
  "ko": "이거 돌려주면 그 자리에서 입막음할 셈이지. 그렇겐 안 돼"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 18,
  "jh": "91a1988947c3",
  "ko": "누가 그런 짓을 해요! 됐으니까 빨리…"
 },
 {
  "key": "m12",
  "kind": 5,
  "chr": 4,
  "jh": "334adf7a73c9",
  "ko": "이쪽인가, 아이 목소리가 나는 게"
 },
 {
  "key": "m13",
  "kind": 5,
  "chr": 0,
  "jh": "43ff8b5c0f24",
  "ko": "이사장실 쪽이군"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 32,
  "jh": "556aaa5a65d1",
  "ko": "추격자가 왔어. 튀어야지"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 18,
  "jh": "232fcd3836ba",
  "ko": "기다리세요! 그 장부는 두고 가세요!"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 32,
  "jh": "d7b3c9ec35d4",
  "ko": "안 돼. 신변 안전이 보장될 때까진 맡아 둘게"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 18,
  "jh": "2d147671f321",
  "ko": "알 수 없는 소리를… 이봐요! 기다리세요!"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 0,
  "jh": "1a8e27fd9405",
  "ko": "없네… 분명 목소리를 들었는데"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 4,
  "jh": "e4ad14236402",
  "ko": "방금 여기 아이가 오지 않았나?"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 18,
  "jh": "169352c3eef0",
  "ko": "아이는 있었지만… 앗! 그렇다면 전부 당신들이 꾸민 거군요!?"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 4,
  "jh": "0c20730ce63f",
  "ko": "꾸몄다? 무슨 소리지. 아이의 보호자인 건 틀림없다만…"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 18,
  "jh": "9d09318987e4",
  "ko": "역시!? 그 장부를 넘겨줄 순 없어요! 반드시 먼저 되찾겠어요!"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 0,
  "jh": "684f3bd0e133",
  "ko": "여기서도 뭔가 저지른 건가…"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 4,
  "jh": "2a47e699d084",
  "ko": "아아… 머리 아프다…"
 },
 {
  "key": "g0s0",
