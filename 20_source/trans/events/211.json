[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "6ba02671c2cc",
  "ko": "겨우 재료 다 모았다. 아~ 피곤해. 오늘은 그냥 잘까"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 2,
  "jh": "d85ddd2810cb",
  "ko": "제출 기한, 내일 저녁까지인데…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "7431ac9476ca",
  "ko": "거짓말! 언제 그렇게 됐어?"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 2,
  "jh": "5ebf7998c2bf",
  "ko": "여기저기서 시간이 걸렸으니까…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "2b457bf65cd4",
  "ko": "으으… 맞다. 페페론, 대신 만들어 줘"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 6,
  "jh": "0dde4bfb1a18",
  "ko": "괜찮아? 이 몸 마음대로 만들어도 정말 괜찮아?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 2,
  "jh": "232c560af931",
  "ko": "울리카가 괜찮다면 난 안 말리지만…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 1,
  "jh": "e109f42a32c4",
  "ko": "…알았어. 내가 만들게"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "1ed4c7d6b755",
  "ko": "으~… 피곤해… 질렸어…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 2,
  "jh": "61e8ea45b5a2",
  "ko": "조금만 더 하면 되니까 힘내자…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 6,
  "jh": "a49bdb4fde47",
  "ko": "이 몸 정도 근육이 있으면 2주는 불면불휴로 계속 일할 수 있어"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "c608277e893f",
  "ko": "근육 울리카… 좀 보고 싶기도…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "8ff9125ca5c3",
  "ko": "이제 안 돼… 페페론, 나 왠지 졸려졌어…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 6,
  "jh": "1f4f5a3a8a4d",
  "ko": "누나, 정신 차려! 좋아, 여기선 이 몸의 사랑의 따귀로…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 2,
  "jh": "28aa5b029d3d",
  "ko": "다른 의미로 의식이 날아가겠어…"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 1,
  "jh": "e438737d1665",
  "ko": "으~ 안 돼 안 돼. 더 정신 차려야지. 클로에, 그쪽 재료 줘"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 2,
  "jh": "c0f9a012fd4d",
  "ko": "…손이 떨리는데?"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 1,
  "jh": "e98e59bc1965",
  "ko": "괜찮아 괜찮아. 좋아, 이걸 콸콸 넣으면 완성… 앗"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 2,
  "jh": "98fdfc0a7426",
  "ko": "아"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 1,
  "jh": "b146a830e506",
  "ko": "크, 큰일이다! 내 돌이!"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 2,
  "jh": "0fa2650ba78e",
  "ko": "…이상한 거 넣지 마. 이상한 약이 돼 버려…"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 1,
  "jh": "280ff752cc9c",
  "ko": "이상한 거라고 하지 마! 빨리 꺼내야… 앗 뜨거!"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 6,
  "jh": "9599a977c69b",
  "ko": "더 빨리 주먹을 내지르는 거야! 끓어오르는 액체의 뜨거움을 느끼기보다 빨리!"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 1,
  "jh": "5fe178c89f54",
  "ko": "그런 달인 같은 짓 못 해!"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 2,
  "jh": "5875e7d229fd",
  "ko": "식은 다음에 꺼낼 수밖에 없겠네…"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 35,
  "jh": "658da3d97ec6",
  "ko": "뉴"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 1,
  "jh": "5590ff801110",
  "ko": "어?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 2,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 6,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 35,
  "jh": "ea065d8d41fd",
  "ko": "우?"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "5286156dd604",
  "ko": "설마… 설마설마설마!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 2,
  "jh": "85f242d5a2c3",
  "ko": "…약을 만들고 있었는데 왜 하얀 동물이 생긴 걸까…?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 6,
  "jh": "2197b2cfadc2",
  "ko": "연금술이란 이토록 신비한 것이지"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "bc7ba0d13cd5",
  "ko": "그게 아니잖아! 이건 분명… 아니! 절대 마나야, 그렇지?"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 35,
  "jh": "d76b3e714380",
  "ko": "…우!"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 2,
  "jh": "fc0a3912dd42",
  "ko": "설마… 그래도 진짜로 그 돌에서…?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 35,
  "jh": "9dc66ada9e64",
  "ko": "우!"
 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 1,
  "jh": "bc578e9667bf",
  "ko": "꺄~! 귀여워! 그러니까 말했잖아! 진짜 마나의 알이라고…"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 1,
  "jh": "e8184ff50665",
  "ko": "앗, 뜨거! 떠, 떨어져! 화상 입어어어!!"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 2,
  "jh": "681f900caa4a",
  "ko": "믿을 수 없어… 진짜로 마나가 나오다니…"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 6,
  "jh": "c556d52ad4e6",
  "ko": "감동적인 광경이네… 잘됐다! 누나!"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 1,
  "jh": "146eb7389b53",
  "ko": "태평하게 보고 있지 말고 사, 살려 줘어어!!"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 35,
  "jh": "47ccf57252e4",
  "ko": "…우~"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 35,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m45",
  "kind": 0,
  "chr": 6,
  "jh": "b7a2c6c3cb70",
  "ko": "누나. 마나가 엄청 쓸쓸한 얼굴을 하고 있어"
 },
 {
  "key": "m46",
  "kind": 0,
  "chr": 2,
  "jh": "0516b6c6acdf",
  "ko": "갓 태어난 마나한테 무슨 처사야…"
 },
 {
  "key": "m47",
  "kind": 0,
  "chr": 1,
  "jh": "f05b511f007f",
  "ko": "어? 앗, 미안! 기분 풀어. 응?"
 },
 {
  "key": "m48",
  "kind": 0,
  "chr": 35,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m49",
  "kind": 0,
  "chr": 1,
  "jh": "b47750ca21b9",
  "ko": "아아… 그런 얼굴도 귀여워! 좋아! 이제 화상 입어도 좋아!"
 },
 {
  "key": "m50",
  "kind": 2,
  "chr": 35,
  "jh": "049d66925904",
  "ko": "우! 우~!?"
 },
 {
  "key": "m51",
  "kind": 2,
  "chr": 1,
  "jh": "171b79e7eab4",
  "ko": "맞다, 너 말할 수 있어? 울리카, 라고 말해 봐. 응?"
 },
 {
  "key": "m52",
  "kind": 2,
  "chr": 35,
  "jh": "cf8f4d92040e",
  "ko": "우~? …우류이카?"
 },
 {
  "key": "m53",
  "kind": 2,
  "chr": 1,
  "jh": "c3c0e565b55b",
  "ko": "너… 너무 귀여워!! 좋아, 네 이름은 우류! 우류로 대결정!"
 },
 {
  "key": "m54",
  "kind": 2,
  "chr": 10,
  "jh": "b5b7aff05979",
