 },
 {
  "key": "m55",
  "kind": 2,
  "chr": 1,
  "jh": "5a03517cd12c",
  "ko": "그래, 우류! …잠깐, 역시 뜨거워! 무리, 더 이상 무리!"
 },
 {
  "key": "m56",
  "kind": 0,
  "chr": 6,
  "jh": "4f3d3b467751",
  "ko": "엄청난 하이텐션이네. 헛돌고 있지만"
 },
 {
  "key": "m57",
  "kind": 0,
  "chr": 2,
  "jh": "356a16e44b4c",
  "ko": "너무 들떠서 짜증 나… 그래도… 진짜로 마나가 나오다니…"
 },
 {
  "key": "g0s0",
