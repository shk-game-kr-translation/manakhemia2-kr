 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 23,
  "jh": "708915882c27",
  "ko": "푸니요. 멍하니 있으면 떨어진다?"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 5,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 11,
  "jh": "08d82531a41b",
  "ko": "그 뒤로 기운이 없네요, 푸니요 씨"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 7,
  "jh": "3b356535bdf1",
  "ko": "그래? 전부터 저런 느낌 아니었어?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 3,
  "jh": "92c2685e8b15",
  "ko": "자기가 푸니푸니가 아니란 걸 알고 충격이었겠지"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 22,
  "jh": "88e223da1615",
  "ko": "기회를 봐서 얘기하려 했는데, 설마 남한테 들통날 줄이야…"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 0,
  "jh": "824945ef8037",
  "ko": "지금까지 몰랐다는 게 오히려 놀랍지만"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 24,
  "jh": "3757944c91fc",
  "ko": "푸니요는 순수한 아이니까…"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 22,
  "jh": "a2efa7044632",
  "ko": "아아. 진실을 받아들이기엔 너무 어렸다. 언젠간 알아주리라 생각한다만…"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 11,
  "jh": "6173c7bd6d22",
  "ko": "어머, 손님일까요?"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 3,
  "jh": "a103b0a3ccec",
  "ko": "방금 푸니푸니 기척이 느껴진 것 같은데…"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 7,
  "jh": "db8e4cf2aae1",
  "ko": "어? 그 말은…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 3,
  "jh": "74e6aafa8da5",
  "ko": "누구였어?"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 11,
  "jh": "b93f88b411b8",
  "ko": "아무도 없었어요. 대신 이게"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 7,
  "jh": "957529d793e1",
  "ko": "뭐야 뭐야? 편지?"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 22,
  "jh": "89c550b3e740",
  "ko": "이건… 푸니요 앞인가?"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 5,
  "jh": "99b53751d8c9",
  "ko": "……푸니니"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 22,
  "jh": "091ebaada2cf",
  "ko": "아아, 그렇지. 푸니요는 아직 글을 못 읽었지. 그러니까…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 22,
  "jh": "5ce84c560f78",
  "ko": "이른 봄의 계절, 여러분 건강히 지내고 계십니까"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 22,
  "jh": "43935b29af98",
  "ko": "다름이 아니오라, 이번에 여러분과 마지막 승부에 임하고자 연락드립니다"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "7131140ca250",
  "ko": "이상하게 정중한 문장이네…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 22,
  "jh": "0f9f8cd50b3d",
  "ko": "푸니푸니의 긍지를 걸고 전통의 푸니푸니 순례를 행하고자 합니다"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 22,
  "jh": "9ed72284386c",
  "ko": "저희가 질 경우 두 번 다시 여러분께 손대지 않을 것을 약속합니다"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 22,
  "jh": "e38af8594850",
  "ko": "반드시 남매 네 분이 함께 참가해 주시길… 이, 이건…!?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 0,
  "jh": "eeca69b7169d",
  "ko": "뭐야? 이 푸니푸니 순례라는 건"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 22,
  "jh": "6793e7837710",
  "ko": "우리 전통 행사다… 서로 양보 못 할 주장이 있을 때 말 그대로 목숨 걸고 싸우는…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 23,
  "jh": "77fc30251550",
  "ko": "너무 위험해서 최근 수십 년은 열리지 않았는데요"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 11,
  "jh": "e83889b2e44e",
  "ko": "왠지 대단하네요. 이름은 귀여운데"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 3,
  "jh": "0c95dd2ffedf",
  "ko": "바보 같아. 설마 받아들일 생각은 아니겠지?"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 22,
  "jh": "c920d55627e7",
  "ko": "만약 거절하면 겁쟁이 낙인이 찍혀 두 번 다시 고향에 돌아갈 수 없을 거다"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 22,
  "jh": "fc06f1ef26f4",
  "ko": "푸니푸니는 무엇보다 긍지를 중시하는 종족이니까"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 0,
  "jh": "71b9a53e64cd",
  "ko": "그랬던 거야…?"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 22,
  "jh": "96db1f28bd3d",
  "ko": "푸니요. 위험한 싸움이 되겠지만… 반드시 지켜 주마!"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 5,
  "jh": "c528ed575135",
  "ko": "…싫어"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 22,
  "jh": "f8d169ffb117",
  "ko": "뭐, 뭐라고!?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 23,
  "jh": "ac7b4df5c5a5",
  "ko": "방금… 인간의 말을!?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 5,
  "jh": "d7f4f5f35b41",
  "ko": "푸뇨, 인간이니까… 안 가"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 24,
  "jh": "4400abb8df30",
  "ko": "그런… 그래도…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 22,
  "jh": "15c0c6d73ca4",
  "ko": "…그런가. 알았다"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 23,
  "jh": "bd6b06d246f5",
  "ko": "네? 그, 그래도 형!"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 22,
  "jh": "54b6ec81fbe8",
  "ko": "우리는 푸니요가 인간으로서 홀로 설 수 있도록 이 학원에 데려온 거다"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 22,
  "jh": "c99e59dfacad",
  "ko": "그렇다면 방금 말은 기쁘게 받아들여야겠지"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 23,
  "jh": "36a759b62704",
  "ko": "그건 그렇지만… 그래도…"
 },
 {
  "key": "m44",
  "kind": 2,
  "chr": 5,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m45",
  "kind": 2,
  "chr": 24,
  "jh": "37b09f06f407",
  "ko": "그래도 승부는 어떡해? 푸니요가 안 가면 인원이…"
 },
 {
  "key": "m46",
  "kind": 2,
  "chr": 22,
  "jh": "70b7ed626548",
  "ko": "녀석들도 납득하지 않겠지. 흠… 누군가 대역을 세울 수밖에 없나"
 },
 {
  "key": "m47",
  "kind": 0,
  "chr": 0,
  "jh": "50b471f1f433",
  "ko": "…왜 이쪽을 보는 거야? 야… 다가오지 마!"
 },
