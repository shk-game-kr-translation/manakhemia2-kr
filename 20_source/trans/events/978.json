[
 {
  "key": "m0",
  "kind": 2,
  "chr": 12,
  "jh": "0ce77c6a5293",
  "ko": "오, 돌아왔나. 어떠냐, 새로운 오의를 써 본 느낌은?"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 1,
  "jh": "448368b17cec",
  "ko": "음~ 솔직히 잘 모르겠을지도…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 12,
  "jh": "764a81cdbb8f",
  "ko": "그런가, 뭐 한두 번으로 오의의 진가를 알 리가 없으니까"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 12,
  "jh": "6761d3cd7321",
  "ko": "하지만 익혀 두면 언젠가 반드시 도움이 될 날이 올 거다"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 12,
  "jh": "73d7c6c06d8d",
  "ko": "자, 그럼 이번 평가다만…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 12,
  "jh": "6b2637bed192",
  "ko": "호오, 흠잡을 데 없는 완벽한 싸움이었던 모양이군"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "7e5aca1b91f6",
  "ko": "어? 그래? 아니~ 뭘 그 정도로"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 2,
  "jh": "cbc341e8b28c",
  "ko": "…평소처럼 대충 싸우고 왔을 뿐인데"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "f2d23da5a7e9",
  "ko": "그, 그렇지 않아! 제대로 성실하게 했다고… 일단"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 12,
  "jh": "6a42642ce17d",
  "ko": "흠, 그 정도 몬스터론 네놈들 상대도 안 된다는 건가"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 12,
  "jh": "74655850ab7b",
  "ko": "다음부턴 더 강한 적을 준비해 두마. 기대해라"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 12,
  "jh": "aa5b6cb94967",
  "ko": "나쁘진 않지만 좀 부족하다… 는 정도인가"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 1,
  "jh": "30e52744fd9a",
  "ko": "음~ 이것저것 익혀야 할 게 있어서 머리가 못 따라가서…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 12,
  "jh": "b78bacf0b7fe",
  "ko": "그건 익숙함의 문제다. 경험을 쌓으면 몸이 무의식중에 반응하게 된다"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 12,
  "jh": "b44beab722ba",
  "ko": "이번엔 그럭저럭 평가를 주겠지만 다음엔 더 분발하길 기대하겠다"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 12,
  "jh": "460b59cbff2d",
  "ko": "별로… 로군"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 12,
  "jh": "448e56c086d2",
  "ko": "모처럼 오의를 전수해 줬는데 이런 싸움밖에 못 하다니"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "5f27c9f0db90",
  "ko": "아하하… 역시 안 돼?"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 12,
  "jh": "1df8dd8e12ae",
  "ko": "안 되지. 뭐, 최소한의 평가는 주겠다만"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 12,
  "jh": "2fdce9ac1c66",
  "ko": "학원 수업 정도로 이 꼴이면 앞날이 걱정이다"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 12,
  "jh": "d55e566a00a5",
  "ko": "실전은 만만치 않다. 잘 명심해 둬라"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 1,
  "jh": "2c30a7cd31af",
  "ko": "네~…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 12,
  "jh": "14f27577052b",
  "ko": "…논외로군"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "4a9baea475d7",
  "ko": "왜, 왜? 제대로 적은 쓰러뜨리고 왔잖아"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 12,
  "jh": "d3a286076eaf",
  "ko": "이번 수업은 연계 방어를 써서 적에게 받는 대미지를 줄이는 게 목적이다"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 12,
  "jh": "6b8ff8987b6c",
  "ko": "그런데도 그렇게 대미지를 받아 와서는 평가할 수가 없다"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 2,
  "jh": "19fcdd6b2e03",
  "ko": "…깜짝이야. 설마 선생님 입에서 옳은 말이 나오다니…"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 12,
  "jh": "dd2485e866a3",
  "ko": "이해했으면 얼른 돌아가라. 이 몸은 이래 봬도 바쁘다"
 },
 {
  "key": "m28",
  "kind": 2,
