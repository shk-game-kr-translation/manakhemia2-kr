[
 {
  "key": "m0",
  "kind": 0,
  "chr": 30,
  "jh": "3304f3bbbe32",
  "ko": "오, 벌써 이런 시간인가. 혼자 있으면 그만 시간 감각이 없어진단 말이지"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 30,
  "jh": "aca1bfcfa3bb",
  "ko": "그 녀석이 있을 땐… 라니, 무슨 소리야, 난. 슬슬 밥 준비나…"
 },
 {
  "key": "m2",
  "kind": 5,
  "chr": 6,
  "jh": "75656798b2b8",
  "ko": "스승님~! 다녀왔어~!"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 30,
  "jh": "17ab3e7a0b4d",
  "ko": "앙?"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 6,
  "jh": "9024fbaa7aad",
  "ko": "지금부터 밥이야? 좋아, 이 몸이 만들 테니까 스승님은 앉아 있어"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 30,
  "jh": "70815cd2ccb9",
  "ko": "아니, 이봐…"
 },
 {
  "key": "m6",
  "kind": 5,
  "chr": 6,
  "jh": "66833ef48524",
  "ko": "역시 손에 익은 부엌이 좋네. 이 너무 낮은 설거지대가 정말 최고야!"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 30,
  "jh": "ad57b04ecf06",
  "ko": "…두 번 다시 얼굴 보이지 말라고 했지?"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 6,
  "jh": "a705b47d2bb1",
  "ko": "그런 매정한 소리 하지 마. 이 몸이랑 스승님 사이잖아"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 30,
  "jh": "1a8e88b12514",
  "ko": "…설마 인간한테 쫓겨나서 온 건 아니겠지"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 6,
  "jh": "6d63273173f7",
  "ko": "으… 실은…"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 6,
  "jh": "ab154b950f5e",
  "ko": "이 몸이 너무 귀엽고 게다가 우수하다 보니 누나들이 질투해서…"
 },
 {
  "key": "m12",
  "kind": 5,
  "chr": 1,
  "jh": "4bac0ea2dbd5",
  "ko": "무슨 거짓말을 하는 거야!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 6,
  "jh": "5910a07763e9",
  "ko": "뭐야. 부자지간 오붓한 시간 방해하지 마"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 1,
  "jh": "4c30e6d5296f",
  "ko": "이상한 소리 하니까 그렇지! 정말, 일부러 따라와 줬는데!"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 30,
  "jh": "d59c090cf876",
  "ko": "이봐, 너희…"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 6,
  "jh": "9acb1ab1dd8b",
  "ko": "따, 딱히 따라와 달라고 부탁 안 했잖아"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "f5c4a37873ef",
  "ko": "무슨 소리야. 큰소리치고 나와서 돌아가기 어렵다고 꿍얼댔으면서"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 30,
  "jh": "98afd65d95ee",
  "ko": "있잖아…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 6,
  "jh": "6481065cb341",
  "ko": "와~! 스승님 앞에서 까발리지 마!"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "96807445c7e8",
  "ko": "네가 거짓말하니까 그렇지! 이렇게 된 이상 있는 말 없는 말 다 일러바쳐서…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 30,
  "jh": "05b6a22f9fb5",
  "ko": "시끄러워! 닥쳐!!"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 30,
  "jh": "2b457f80a29d",
  "ko": "갑자기 남의 집에 쳐들어와서 말싸움 시작하지 마!"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "6f78eb9ffb9a",
  "ko": "그치만 페페론이…"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 6,
  "jh": "37b603661dff",
  "ko": "그치만 누나가…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 30,
  "jh": "7d2258b48b71",
  "ko": "변명하지 마! 페페론! 너 뭘 뻔뻔하게 돌아온 거야!"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 6,
  "jh": "5beb5d6bee3f",
  "ko": "스승님 보고 싶었어. 스승님도 쓸쓸했던 거 아니야?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 30,
  "jh": "6624c098fae3",
  "ko": "바, 바보 자식! 그럴 리가 있냐!"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "355f70d49aba",
  "ko": "아, 쑥스러워한다 쑥스러워한다"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "425631941f56",
  "ko": "하하하. 귀여운 데가 있지? 이 몸의 스승님"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 30,
  "jh": "09a8728346a8",
  "ko": "…놀리러 온 거면 당장 내쫓을 거다"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 6,
  "jh": "a4b6ee78a8b9",
  "ko": "잘못했어요"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 30,
  "jh": "182d970c1765",
  "ko": "쯧… 돌아올 거면 돌아오는 대로 그 나름의 예의라는 게 있잖냐"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 6,
  "jh": "72f4756acdf5",
  "ko": "예의? 예를 들면?"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 30,
  "jh": "203052c0d8a4",
  "ko": "그야 이렇게 고개를 숙이고 말이지. 그때는 건방진 소리 해서 죄송했습니다!"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 30,
  "jh": "50214ea1300f",
  "ko": "하고 사과하면서 슥 선물을 내밀고…"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 6,
  "jh": "c2234ac46dd1",
  "ko": "그렇구나. 즉 빈손으로 돌아와서 삐친 거구나?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 30,
  "jh": "e199076c3a58",
  "ko": "아니, 내가 하고 싶은 말은…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 6,
  "jh": "6d65536075c9",
  "ko": "좋아, 최고의 선물을 준비해 올게! 기대하고 기다려~!"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 1,
  "jh": "9968721700f2",
  "ko": "앗, 이놈. 기다려!"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 30,
  "jh": "69cb0c4859e9",
  "ko": "남의 말을 안 듣네… 여전하군"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
