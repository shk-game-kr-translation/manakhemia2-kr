 },
 {
  "key": "m38",
  "kind": 0,
  "chr": 54,
  "jh": "012593ea5f65",
  "ko": "이놈… 인간 놈들이!!"
 },
 {
  "key": "m39",
  "kind": 0,
  "chr": 22,
  "jh": "a5484d14465a",
  "ko": "아무래도 형세 역전인 것 같군"
 },
 {
  "key": "m40",
  "kind": 0,
  "chr": 5,
  "jh": "2801c58ba4f1",
  "ko": "푸니! 니~!"
 },
 {
  "key": "m41",
  "kind": 0,
  "chr": 23,
  "jh": "479cb1eac11e",
  "ko": "오빠들을 험한 꼴 당하게 한 것, 절대 용서 못 해… 라며 여동생은 분노에 불타고 있어요"
 },
 {
  "key": "m42",
  "kind": 0,
  "chr": 54,
  "jh": "f2ec37e107fc",
  "ko": "당장 쓰러질 것 같은 상태로 까불지 마라!"
 },
 {
  "key": "m43",
  "kind": 0,
  "chr": 54,
  "jh": "88dd788f4cf4",
  "ko": "이 푸니푸니 순례, 이 몸이 마지막 시련이 되어 네놈들의 숨통을 끊어 주마!"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 54,
  "jh": "83a04f70f86c",
  "ko": "자, 한꺼번에 덤벼라!"
 },
 {
  "key": "m45",
  "kind": 0,
  "chr": 54,
  "jh": "38bdb5138fcc",
