  "chr": 5,
  "jh": "7adf9ba468d3",
  "ko": "푸니! 푸니~!"
 },
 {
  "key": "m65",
  "kind": 2,
  "chr": 22,
  "jh": "ffe8ed1e064a",
  "ko": "자자. 여긴 여동생 하고 싶은 대로 하게 해 줘라"
