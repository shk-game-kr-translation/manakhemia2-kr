 },
 {
  "key": "m58",
  "kind": 2,
  "chr": 3,
  "jh": "0127d3d83710",
  "ko": "푸니요 씨? 거기 서 있으면 방해되는데…"
 },
 {
  "key": "m59",
  "kind": 2,
  "chr": 5,
  "jh": "68159c57be62",
  "ko": "푸니! 푸니니!"
 },
 {
  "key": "m60",
  "kind": 2,
  "chr": 23,
  "jh": "0af5d3a717fb",
  "ko": "로제 씨는 푸니요를 위해 싸워 줬으니까 푸니요가 업고 돌아가겠다!"
