[
 {
  "key": "m0",
  "kind": 0,
  "chr": 22,
  "jh": "7a8a6b157a26",
  "ko": "하아, 하아… 이봐, 아직 싸울 수 있냐?"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 0,
  "jh": "00b1708c5672",
  "ko": "푸니…"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 22,
  "jh": "7c0ad74a4143",
  "ko": "나? 슬슬 위험하군. 눈이 침침해졌다…"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 54,
  "jh": "a90d7ae65638",
  "ko": "설마 여기까지 버틸 줄이야… 하지만 슬슬 한계인가"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 54,
  "jh": "d09714bf90b2",
  "ko": "이야, 아깝군. 스무 명만 더 하면 천인 베기 달성이었는데"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 22,
  "jh": "b0501db20143",
  "ko": "호오, 스무 명 남았나… 천인 베기를 달성하면 살아서 전설이 되겠군"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 0,
  "jh": "7c47393e6cc1",
  "ko": "푸니… 푸니"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 22,
  "jh": "9ae3227766d1",
  "ko": "아아, 확실히 당해 버리면 명성 따위 아무 의미 없지"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 54,
  "jh": "6dabcb06e7e3",
  "ko": "자, 덤벼라! 조금만 더다!"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 54,
  "jh": "b4fcee7f8e73",
  "ko": "정말로 천인 베기를 달성해 버릴 줄이야… 괴물 놈"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 22,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 0,
  "jh": "76378b8eca61",
  "ko": "………"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 54,
  "jh": "26a2700341b3",
  "ko": "이제 말할 기력도 없나. 크크크, 꼴좋다"
 },
 {
  "key": "m13",
  "kind": 0,
  "chr": 54,
  "jh": "b93147854a01",
  "ko": "자, 이대로 푸니푸니 삼천인 베기를 계속해 줘야겠군!"
 },
 {
  "key": "m14",
  "kind": 5,
  "chr": 5,
  "jh": "7ea7b0907d7f",
  "ko": "푸니~!"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 22,
  "jh": "5e45764cff41",
  "ko": "푸, 푸니요…?"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 5,
  "jh": "cf81e7649d8c",
  "ko": "푸니! 푸니니니~!"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 54,
  "jh": "8a1b318a9896",
  "ko": "뭐… 이게 어떻게 된 거냐? 여동생이 둘?"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 0,
  "jh": "75007c1435f7",
  "ko": "바보 녀석. 이럴 때 와서 어쩌려고…"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 54,
  "jh": "cfa576699dc9",
  "ko": "그 목소리는… 네놈! 이 몸을 속였구나!"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 0,
  "jh": "9ab2fb70c9cf",
  "ko": "속인 건 피차일반이잖아"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 54,
  "jh": "9376fd52e6d6",
  "ko": "으으… 뭐 됐다"
 },
 {
  "key": "m22",
  "kind": 0,
  "chr": 54,
  "jh": "52a089453c69",
  "ko": "하마터면 진짜 여동생을 놓칠 뻔했는데 일부러 제 발로 와 줬으니까"
 },
 {
  "key": "m23",
  "kind": 0,
  "chr": 22,
  "jh": "6735c4ba57f2",
  "ko": "차라리 이대로 쓰러지는 게 편했을 텐데… 여동생 앞에서 추한 꼴은 못 보이지"
 },
 {
  "key": "m24",
  "kind": 0,
  "chr": 0,
  "jh": "46ad364a1c48",
  "ko": "어울려 주는 이쪽은 엄청난 민폐다"
 },
 {
  "key": "m25",
  "kind": 0,
  "chr": 24,
  "jh": "47a80316d42d",
  "ko": "우리도… 아직 싸울 수 있어, 타로 형"
 },
 {
  "key": "m26",
  "kind": 0,
  "chr": 22,
  "jh": "446910ead525",
  "ko": "사부로! 지로도… 너희, 그런 상처로…"
 },
 {
  "key": "m27",
  "kind": 0,
  "chr": 23,
  "jh": "ce2f45bcd448",
  "ko": "괜찮아. 게다가 내가 없으면 푸니요는 누굴 타야 하는데?"
 },
 {
  "key": "m28",
  "kind": 0,
  "chr": 54,
  "jh": "2d5ebef6e95c",
  "ko": "흥, 죽다 만 놈들이… 상관없다! 녀석들, 한꺼번에 해치워라!"
 },
 {
  "key": "m29",
  "kind": 0,
  "chr": 54,
  "jh": "79806e281c09",
  "ko": "응? 왜 그래? 이봐! 안 들리냐!?"
 },
 {
  "key": "m30",
  "kind": 0,
  "chr": 55,
  "jh": "856eaf6ffd6b",
  "ko": "혀, 형님… 이제 글렀슴다…"
 },
 {
  "key": "m31",
  "kind": 0,
  "chr": 54,
  "jh": "28c5cee1ae7c",
  "ko": "왜, 왜 그래? 이봐!?"
 },
 {
  "key": "m32",
  "kind": 0,
  "chr": 3,
  "jh": "3435b990e85d",
  "ko": "미안하지만 지원군은 안 와"
 },
 {
  "key": "m33",
  "kind": 0,
  "chr": 11,
  "jh": "283615c2547f",
  "ko": "전원 저희가 막고 있어요. 여기엔 한 마리도 못 오게 할 거예요"
 },
 {
  "key": "m34",
  "kind": 0,
  "chr": 4,
  "jh": "f9151b7f0598",
  "ko": "우리가라기보다 에토 혼자 날뛰고 있는 상황이다만"
