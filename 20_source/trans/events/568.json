 {
  "key": "m35",
  "kind": 5,
  "chr": 7,
  "jh": "83e597741dc8",
  "ko": "아하하하! 우랴~! 이걸로 이백 마리째!"
 },
 {
  "key": "m36",
  "kind": 0,
  "chr": 3,
  "jh": "79ec8fcb435a",
  "ko": "잠깐! 적이라고 푸니푸니한테 너무 거칠게 하지 마!"
 },
 {
  "key": "m37",
  "kind": 5,
  "chr": 7,
  "jh": "7fbd4f4a1705",
