[
 {
  "key": "m0",
  "kind": 2,
  "chr": 1,
  "jh": "32ab105403f8",
  "ko": "좋은 아침…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 6,
  "jh": "4a0fd569709a",
  "ko": "좋은 아침, 누나. 왠지 안색이 안 좋네?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 1,
  "jh": "9cf816d158b0",
  "ko": "응… 왠지 몸이 무거워"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 2,
  "jh": "f39a5c9e9e2c",
  "ko": "주술 효과는 어땠어…?"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 1,
  "jh": "3a06e5a6ed18",
  "ko": "아, 그건 완벽했어. 선생님 도와주고 용돈 받거나, 복도에서 동전 줍거나…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 2,
  "jh": "fad96f3d9cb4",
  "ko": "…얼마나 벌었어?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 1,
  "jh": "fc933a3e3e45",
  "ko": "응? 그게… 500콜쯤?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 2,
  "jh": "4e33a420eca9",
  "ko": "500콜… 500일분인가…"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 1,
  "jh": "480a0e628c8a",
  "ko": "…방금 뭔가 불길한 소리 했어?"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 2,
  "jh": "37fea88557b2",
  "ko": "아무 말도 안 했는데…?"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 1,
  "jh": "2686908631d7",
  "ko": "거짓말! 얼굴이 웃고 있어! 역시 뭔가 숨기고 있지!?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 2,
  "jh": "cc3679c2dde9",
  "ko": "…실은 말이야. 어제 주술, 부작용이 딱 하나 있어…"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 2,
  "jh": "02afbe1a10a3",
  "ko": "1콜 벌 때마다 수명이 하루 줄어드는…"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "828a6df8352a",
  "ko": "…네? 그건 즉…"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 8,
  "jh": "393b27a709e2",
  "ko": "누나 수명이 500일 줄었다는 거냐?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 6,
  "jh": "fc9a3d0420f9",
  "ko": "하루에 1콜이라. 하하하! 누나, 싼 인생이네"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 1,
  "jh": "4976165b4075",
  "ko": "웃을 일이 아니야~!! 너, 무슨 짓을!"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 2,
  "jh": "a3b716124721",
  "ko": "가벼운 농담이었어… 헤헷"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 1,
  "jh": "208cac643a96",
  "ko": "헤헷이 아니야~! 어쩔 거야, 내 수명!"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 2,
  "jh": "320d86fc7369",
  "ko": "주술에 그렇게 눈에 쌍심지 켜지 않아도… 어른스럽지 못해"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 1,
  "jh": "2a6f1ad6da97",
  "ko": "주술로 넘길 수준이 아니잖아! 이거 어떻게 되는 거겠지!?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 2,
  "jh": "eefb124cbd82",
  "ko": "이 주술을 풀려면… 받은 돈의 백 배를 강에 버리면 되나 봐…"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "dc218137ceee",
  "ko": "백 배? 농담이지!?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 2,
  "jh": "e9de135aba30",
  "ko": "울리카… 돈으로 목숨은 못 사는 거야?"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 1,
  "jh": "17b250d33b3b",
  "ko": "모든 원인인 네가 할 소리야! 다른 방법은 없어, 다른 방법은!?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 2,
  "jh": "cb64120f07d7",
  "ko": "떼쓰기는… 아, 땀 흘려서 같은 액수를 버는 방법도 있대…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 1,
  "jh": "58e74ea3dc5c",
  "ko": "땀 흘려서… 그쪽이 그나마 낫네"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 2,
  "jh": "d1dca5c69330",
  "ko": "게다가 배움의 다리에 있는 몬스터를 쓰러뜨려 버는 게 바람직하대…"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 6,
  "jh": "c5cfe8aa7073",
  "ko": "유난히 구체적인 지정이네…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 1,
  "jh": "b5f1d7168cf8",
  "ko": "그럼 얼른 거기 몬스터 쓰러뜨리러 가자"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 2,
  "jh": "8bdbb9c68abf",
  "ko": "몬스터의 피를 뒤집어쓰고 해주… 왠지 야만적…"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "c4fb2e4dbbb2",
  "ko": "아니잖아! 두들겨 패서 금품을 뜯어낼 뿐이야!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 8,
  "jh": "91f0e554e3ed",
  "ko": "…둘 다 별 차이 없지 않냐?"
 },
 {
  "key": "g0s0",
