[
 {
  "key": "m0",
  "kind": 2,
  "chr": 13,
  "jh": "e37015b3a4b5",
  "ko": "저, 이사장님… 이번 일로 교사가 꽤 부서져서, 그…"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 18,
  "jh": "5d1aee71664e",
  "ko": "알고 있어요. 보수에는 비용이 얼마나?"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 13,
  "jh": "45731ae15958",
  "ko": "대충 봐도 이 정도는 필요할 듯…"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 18,
  "jh": "dbef271ff6ef",
  "ko": "이렇게나!? 피해가 이렇게 커지다니…"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 13,
  "jh": "a9eee33cabaa",
  "ko": "반대파 학생들, 열심히 했으니까요…"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 13,
  "jh": "355be7810294",
  "ko": "이럴 바엔 순순히 학원제를 하는 게 더 쌌을지도 모르겠네요"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 18,
  "jh": "88fd9031d29b",
  "ko": "뭐라고 하셨나요!?"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 13,
  "jh": "0beed40e62ca",
  "ko": "아, 아뇨! 아무것도!"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 18,
  "jh": "998ab96adee4",
  "ko": "…뭐 좋아요. 이걸로 눈엣가시 같은 학생을 쫓아낼 수 있다면 싼 거죠…"
 },
 {
  "key": "m9",
  "kind": 5,
  "chr": 3,
  "jh": "ce173a65ba00",
  "ko": "실례하겠습니다"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 18,
  "jh": "7935ce3cd3a1",
  "ko": "어머, 릴리아 양. 대체 무슨 용건으로… 응?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 18,
  "jh": "6b88a842d91b",
  "ko": "왜 당신이 같이…? 이게 어떻게 된 거죠?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 3,
  "jh": "280bf0a24b1b",
  "ko": "조금 신경 쓰이는 소문을 들어서 이야기를 여쭈러 왔어요"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 1,
  "jh": "691632046786",
  "ko": "내년에 연금술과를 없애 버린다는 소문인데"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 18,
  "jh": "48fda90b147b",
  "ko": "뭣!? 누구한테 그런 얘길… 설마, 교장!?"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 13,
  "jh": "7aa6c659646e",
  "ko": "아, 아뇨아뇨! 저는 몰라요! 정말로!"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 18,
  "jh": "d0163eb1706f",
  "ko": "아… 흠흠. 그런 근거 없는 소문이 퍼지다니 곤란하네요"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 3,
  "jh": "4e225c95c94d",
  "ko": "네, 정말 곤란해요"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 3,
  "jh": "62926b9c91aa",
  "ko": "연금술과가 있기에 저희 아버님은 거액을 기부하고 계셨는데…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "4590e383d690",
  "ko": "실컷 부려 먹히고 돈까지 내다니 너도 고생이다"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 3,
  "jh": "7917dd6abf3c",
  "ko": "어머, 고생인 건 피차일반이잖아?"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 3,
  "jh": "ed85f2820ff0",
  "ko": "너도 입학금과 수업료를 뜯긴 끝에 퇴학당한다는 얘기던데?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 18,
  "jh": "65e9f14a2e9a",
  "ko": "뭐… 뭐뭐뭐!? 어디서 그런… 설마!? 그때 대화를!?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 1,
  "jh": "479dcdb62a7a",
  "ko": "에이~ 그냥 소문이에요, 소문"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 3,
  "jh": "638ce69b2f80",
  "ko": "뭐, 아니 땐 굴뚝에 연기 나랴 라고들 하지만…"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 3,
  "jh": "6a82e9d78968",
  "ko": "만약 이 소문이 전교생… 아니, 후원자 여러분 귀에 들어간다면 어떻게 될지…"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 18,
  "jh": "3916f04639f6",
  "ko": "잠깐만요! 그것만은!! …원하는 게 뭐죠?"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 3,
  "jh": "582e6b3739f6",
  "ko": "어머, 그렇게 말씀하시니 마치 저희가 협박하는 것 같네요?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 1,
  "jh": "39a7da4d07cb",
  "ko": "그러니까~ 소문이 진짜인지 물어보러 온 것뿐인데. 왠지 기분 나쁘다~"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 18,
  "jh": "f9610c319844",
  "ko": "무, 물론 거짓말이죠!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 18,
  "jh": "e06cd976062e",
  "ko": "연금술과가 없어지는 일도, 당신이 퇴학당하는 일도 없어요!"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "4c9a8bc1e65d",
  "ko": "다행이다, 한시름 놨어"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 3,
  "jh": "ea7ffd8641f3",
  "ko": "저도요. 아버님께 불쾌한 보고를 안 해도 되겠어요"
 },
 {
  "key": "m33",
  "kind": 2,
  "chr": 18,
  "jh": "0fadb77b9407",
  "ko": "그, 그거 다행이네요. 자, 볼일이 끝났으면 이제…"
 },
 {
  "key": "m34",
  "kind": 2,
  "chr": 1,
  "jh": "4165a3e8b6f9",
  "ko": "아, 하나 잊고 있었다"
 },
 {
  "key": "m35",
  "kind": 2,
  "chr": 18,
  "jh": "ddad2c14d4a8",
  "ko": "아직 뭐가 있어요!?"
 },
 {
  "key": "m36",
  "kind": 2,
  "chr": 1,
  "jh": "27b3b8d6a0e5",
  "ko": "이제 곧 학원제죠? 중지된다고 들었는데 어떻게 됐을까~?"
 },
 {
  "key": "m37",
  "kind": 2,
  "chr": 3,
  "jh": "cfbbb12ea44d",
  "ko": "아아, 그러고 보니. 중지되면 불만을 가진 학생도 많을 텐데…"
 },
 {
  "key": "m38",
  "kind": 2,
  "chr": 18,
  "jh": "94afe8b90b28",
  "ko": "크… 시치미를 떼기는…"
 },
 {
  "key": "m39",
  "kind": 2,
  "chr": 3,
  "jh": "85fe8679ca3a",
  "ko": "어머, 뭐라고 하셨나요?"
 },
 {
  "key": "m40",
  "kind": 2,
  "chr": 18,
  "jh": "1e0a1f43d6f1",
  "ko": "아니요 아무것도! 그렇죠, 학생들의 즐거움을 뺏는 건 본의가 아니니까…"
 },
 {
  "key": "m41",
  "kind": 2,
  "chr": 18,
  "jh": "fb57cd8e4cc5",
  "ko": "학원제, 좋잖아요. 꼭 합시다! 네 이제, 될 대로 되라예요!"
 },
 {
  "key": "m42",
  "kind": 2,
  "chr": 1,
  "jh": "0ed6b81dd950",
  "ko": "정말? 정말이지? 아싸아아아!"
 },
 {
  "key": "m43",
  "kind": 2,
  "chr": 3,
  "jh": "e8089060e93f",
  "ko": "그럼 좋은 대답도 받았으니 저희는 이만"
 },
 {
  "key": "m44",
  "kind": 0,
  "chr": 3,
  "jh": "4731f63cb9b5",
  "ko": "오래 실례했습니다"
 },
 {
  "key": "m45",
  "kind": 0,
  "chr": 18,
  "jh": "579fbe5ea610",
  "ko": "크… 으으으으! 그 계집애들이!!!"
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
]