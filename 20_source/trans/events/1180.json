[
 {
  "key": "m0",
  "kind": 2,
  "chr": 7,
  "jh": "b6f9269ced6a",
  "ko": "생각보다 빨리 과제 끝났네~"
 },
 {
  "key": "m1",
  "kind": 2,
  "chr": 0,
  "jh": "8974630f26f7",
  "ko": "그렇군. 이걸로 좀 느긋하게 지낼 수 있겠어…"
 },
 {
  "key": "m2",
  "kind": 2,
  "chr": 7,
  "jh": "a56e2ac43ba1",
  "ko": "느긋한 거 질렸어~! 있잖아, 어디 놀러 가자"
 },
 {
  "key": "m3",
  "kind": 2,
  "chr": 0,
  "jh": "5eefac408284",
  "ko": "넌 질리는 게 너무 빨라"
 },
 {
  "key": "m4",
  "kind": 2,
  "chr": 4,
  "jh": "2374670e9ac8",
  "ko": "그렇게 한가하면 아르바이트라도 하는 게 어떠냐?"
 },
 {
  "key": "m5",
  "kind": 2,
  "chr": 7,
  "jh": "23ebce12979f",
  "ko": "아르바이트?"
 },
 {
  "key": "m6",
  "kind": 2,
  "chr": 4,
  "jh": "826d14259f6a",
  "ko": "아아, 자유 시간이면 학생이라도 학생과에서 일을 받을 수 있다"
 },
 {
  "key": "m7",
  "kind": 2,
  "chr": 4,
  "jh": "36c8acef64ab",
  "ko": "심심풀이도 되고 돈도 벌 수 있다. 일석이조지?"
 },
 {
  "key": "m8",
  "kind": 2,
  "chr": 7,
  "jh": "fb57fa4caff3",
  "ko": "오오… 왠지 재밌겠다!"
 },
 {
  "key": "m9",
  "kind": 2,
  "chr": 0,
  "jh": "08611a0f7eb7",
  "ko": "아르바이트라… 난 하루 종일 아가씨 밑에서 일하는 거나 마찬가지니까…"
 },
 {
  "key": "m10",
  "kind": 2,
  "chr": 11,
  "jh": "425af2a23cdd",
  "ko": "그럼 로제 씨는 친구들이랑 노시는 게 어때요?"
 },
 {
  "key": "m11",
  "kind": 2,
  "chr": 0,
  "jh": "6ddea3d1f560",
  "ko": "…뭐? 친구들이랑 논다?"
 },
 {
  "key": "m12",
  "kind": 2,
  "chr": 11,
  "jh": "36d6ba25eb44",
  "ko": "그럼요. 모처럼의 학창 생활이잖아요. 청춘을 구가해야죠!"
 },
 {
  "key": "m13",
  "kind": 2,
  "chr": 0,
  "jh": "42a64f594f48",
  "ko": "아니, 그런 건 전혀 관심 없는데"
 },
 {
  "key": "m14",
  "kind": 2,
  "chr": 11,
  "jh": "cdd027a7c650",
  "ko": "안 돼요. 그렇지 않아도 무뚝뚝하고 사교성 없다고 소문났는데"
 },
 {
  "key": "m15",
  "kind": 2,
  "chr": 11,
  "jh": "5996a234f5f3",
  "ko": "시간 날 때 정도는 좀 놀아야죠"
 },
 {
  "key": "m16",
  "kind": 2,
  "chr": 0,
  "jh": "123d789c335f",
  "ko": "그런 소문이 났냐… 알았어, 생각해 둘게"
 },
 {
  "key": "m17",
  "kind": 2,
  "chr": 1,
  "jh": "92e6564ab979",
  "ko": "과제 끝난 건 좋은데 왠지 한가해졌네"
 },
 {
  "key": "m18",
  "kind": 2,
  "chr": 10,
  "jh": "54156cf69a36",
  "ko": "으~…"
 },
 {
  "key": "m19",
  "kind": 2,
  "chr": 1,
  "jh": "8d639bc60377",
  "ko": "뭐, 됐나. 하루 종일 우류랑 뒹굴뒹굴하면. 자, 이리 와~"
 },
 {
  "key": "m20",
  "kind": 2,
  "chr": 2,
  "jh": "162289d32202",
  "ko": "보는 쪽이 열받으니까 그만해…"
 },
 {
  "key": "m21",
  "kind": 2,
  "chr": 8,
  "jh": "428849961c19",
  "ko": "그렇게 한가하면 아르바이트라도 하면 되지 않아?"
 },
 {
  "key": "m22",
  "kind": 2,
  "chr": 1,
  "jh": "64d1bc2599ae",
  "ko": "아르바이트?"
 },
 {
  "key": "m23",
  "kind": 2,
  "chr": 8,
  "jh": "b36e06c5cfa8",
  "ko": "아아. 자유 시간에 학생과에 가면 받을 수 있대"
 },
 {
  "key": "m24",
  "kind": 2,
  "chr": 8,
  "jh": "403856d4c62d",
  "ko": "돈도 벌 수 있고 누나한텐 딱 좋지 않아?"
 },
 {
  "key": "m25",
  "kind": 2,
  "chr": 1,
  "jh": "be7825fc586d",
  "ko": "흐응, 아르바이트라… 그것도 좋을지도"
 },
 {
  "key": "m26",
  "kind": 2,
  "chr": 6,
  "jh": "823bbb806967",
  "ko": "잠깐, 누나! 자유 시간이라면 이 몸이랑 놀 절호의 기회야!"
 },
 {
  "key": "m27",
  "kind": 2,
  "chr": 1,
  "jh": "78e5dc3f3bcc",
  "ko": "…뭐? 왜 너랑 놀아야 하는데?"
 },
 {
  "key": "m28",
  "kind": 2,
  "chr": 6,
  "jh": "4f425bca6240",
  "ko": "우오, 그렇게 진심으로 싫은 얼굴 안 해도…"
 },
 {
  "key": "m29",
  "kind": 2,
  "chr": 6,
  "jh": "2a03d7fc4042",
  "ko": "그치만 그치만, 누나 평소엔 바빠서 전혀 안 놀아 주잖아!"
 },
 {
  "key": "m30",
  "kind": 2,
  "chr": 6,
  "jh": "aac3054c67d0",
  "ko": "가끔은 놀아 주지 않으면 싫어 싫어!"
 },
 {
  "key": "m31",
  "kind": 2,
  "chr": 1,
  "jh": "31e1b652e804",
  "ko": "잠, 큰 덩치로 날뛰지 마! 아틀리에 부서지잖아!"
 },
 {
  "key": "m32",
  "kind": 2,
  "chr": 1,
  "jh": "f1d301778a8a",
  "ko": "…알았어. 한가해서 어쩔 수 없을 때가 되면 생각해 줄게"
 },
 {
  "key": "m33",
  "kind": 5,
  "chr": -1,
  "jh": "ad80e7075c7b",
  "ko": "스케줄이 「{CLRE}자유 시간{CLNR}」이 되었습니다. 자유 시간에는 여러 가지를 할 수 있습니다."
 },
 {
  "key": "m34",
  "kind": 5,
  "chr": -1,
  "jh": "5ea5bbc85e63",
  "ko": "자유 시간에 대한 도움말을 보시겠습니까?"
 },
 {
  "key": "m35",
  "kind": 5,
  "chr": -1,
  "jh": "d7ef629b2ec4",
  "ko": "자유 시간 동안은 다음과 같은 것이 가능합니다."
 },
 {
  "key": "m36",
  "kind": 5,
  "chr": -1,
  "jh": "7ed73ce7a8aa",
  "ko": "동료와 친해지고 싶을 때는 아틀리에의 「{CLRE}게시판{CLNR}」에 접근하세요."
 },
 {
  "key": "m37",
  "kind": 5,
  "chr": -1,
  "jh": "f2d099b93e45",
  "ko": "게시판에 적힌 동료 이름을 고르면 {CLRE}캐릭터 스토리{CLNR}를 진행할 수 있습니다."
 },
 {
  "key": "m38",
  "kind": 5,
  "chr": -1,
  "jh": "28a74d714dce",
  "ko": "단, 장에 따라서는 그 이상 스토리가 진행되지 않는 경우도 있으니 주의하세요."
 },
 {
  "key": "m39",
  "kind": 5,
  "chr": -1,
  "jh": "e65cc48ec25a",
  "ko": "학생과에서는 아르바이트로 돈을 벌 수 있습니다."
 },
 {
  "key": "m40",
  "kind": 5,
  "chr": -1,
  "jh": "520dd2f77e94",
  "ko": "자세한 내용은 학생과 접수처에 물어보세요."
 },
 {
  "key": "m41",
  "kind": 5,
  "chr": -1,
  "jh": "870e721ed631",
  "ko": "자유 시간 동안은 이런 행동을 하면 시간이 경과합니다."
 },
 {
  "key": "m42",
  "kind": 5,
  "chr": -1,
  "jh": "3d22f9c51be4",
  "ko": "자신이 가장 하고 싶은 행동을 골라 자유 시간을 즐겨 주세요."
 },
 {
  "key": "m43",
  "kind": 5,
  "chr": -1,
  "jh": "5b1205610984",
  "ko": "「{CLRE}도움말{CLNR}」의 「{CLRE}시스템{CLNR}」에 새로운 항목이 추가되었습니다."
 },
 {
  "key": "m44",
  "kind": 5,
  "chr": -1,
  "jh": "55291ff330e5",
  "ko": "「{CLRE}도움말{CLNR}」은 메뉴의 「{CLRE}도감{CLNR}」에서 확인할 수 있습니다."
 },
 {
  "key": "g0s0",
  "kind": "sel",
  "jh": "c92b4cda8bdf",
  "ko": "예"
 },
 {
  "key": "g0s1",
  "kind": "sel",
  "jh": "f901585367d6",
  "ko": "아니요"
 }
