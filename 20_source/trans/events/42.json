[
 {
  "key": "m0",
  "kind": 0,
  "chr": 12,
  "jh": "0a0ecec92520",
  "ko": "전원 모인 모양이군"
 },
 {
  "key": "m1",
  "kind": 0,
  "chr": 12,
  "jh": "b4b500a061de",
  "ko": "그럼 지금부터 하계 휴가 특별 전투 훈련을 개시한다!"
 },
 {
  "key": "m2",
  "kind": 0,
  "chr": 83,
  "jh": "c8de85d8de39",
  "ko": "저, 저기 선생님…"
 },
 {
  "key": "m3",
  "kind": 0,
  "chr": 12,
  "jh": "56e2dff8339e",
  "ko": "선생님이 아니다! 이 몸을 교관이라 불러라!"
 },
 {
  "key": "m4",
  "kind": 0,
  "chr": 83,
  "jh": "3a812ec64678",
  "ko": "죄, 죄송합니다! 교관님! 저기, 뒤에 쓰러져 있는 사람들은 대체…"
 },
 {
  "key": "m5",
  "kind": 0,
  "chr": 12,
  "jh": "a8fbec9c8d9e",
  "ko": "탈주를 꾀한 어리석은 놈들이다. 본보기로 이 자리에 방치해 뒀다"
 },
 {
  "key": "m6",
  "kind": 0,
  "chr": 106,
  "jh": "74f6b9825f7d",
  "ko": "저 녀석들, 살아 있는 거야…"
 },
 {
  "key": "m7",
  "kind": 0,
  "chr": 107,
  "jh": "e41258348fb8",
  "ko": "농담이 아니야… 오늘 선생님 평소보다 더 이상해…"
 },
 {
  "key": "m8",
  "kind": 0,
  "chr": 81,
  "jh": "b9fc876eb1fc",
  "ko": "뭔가 이상한 책에 영향이라도 받았나…"
 },
 {
  "key": "m9",
  "kind": 0,
  "chr": 12,
  "jh": "dc75e09338a6",
  "ko": "누가 입을 열어도 된다고 했나!"
 },
 {
  "key": "m10",
  "kind": 0,
  "chr": 12,
  "jh": "89e54f9430e5",
  "ko": "잘 들어라. 네놈들은 벌레다, 구더기다!"
 },
 {
  "key": "m11",
  "kind": 0,
  "chr": 12,
  "jh": "65ea2a750b7f",
  "ko": "하지만 개만도 못한 네놈들을 이 몸이 어엿한 전투원으로 단련시켜 주마"
 },
 {
  "key": "m12",
  "kind": 0,
  "chr": 12,
  "jh": "fe82477e4ac2",
  "ko": "전투원이 못 되는 놈은 죽어라! 죽기 싫으면 훌륭한 전투원이 되어 봐라!"
 },
 {
  "key": "m13",
  "kind": 5,
  "chr": 39,
  "jh": "7aa6518280ca",
  "ko": "서! 예스 서!"
 },
 {
  "key": "m14",
  "kind": 0,
  "chr": 12,
  "jh": "11932f7c72e4",
  "ko": "대답만은 일인분이군. 좋아, 그럼 첫 훈련 내용을 발표한다!"
 },
 {
  "key": "m15",
  "kind": 0,
  "chr": 12,
  "jh": "bec6a22266ea",
  "ko": "…라고 하려 했다만, 그 전에 사전 준비가 필요하겠군"
 },
 {
  "key": "m16",
  "kind": 0,
  "chr": 12,
  "jh": "582a06d57be4",
  "ko": "우선 이 근처 몬스터를 전부 정리하고 와라"
 },
 {
  "key": "m17",
  "kind": 0,
  "chr": 83,
  "jh": "56c810ef18d3",
  "ko": "네… 저희끼리만요?"
 },
 {
  "key": "m18",
  "kind": 0,
  "chr": 12,
  "jh": "584ead2a556d",
  "ko": "당연하다. 그 외에 누가 있지?"
 },
 {
  "key": "m19",
  "kind": 0,
  "chr": 95,
  "jh": "4e79beabab96",
  "ko": "그, 그런. 무리예요! 아무리 그래도…"
 },
 {
  "key": "m20",
  "kind": 0,
  "chr": 12,
  "jh": "50679adbc1e8",
  "ko": "말대꾸는 용서 않는다! 당장 착수해라!"
 },
 {
  "key": "m21",
  "kind": 0,
  "chr": 12,
  "jh": "4dbfd81629bf",
  "ko": "땡땡이치는 놈이 보이면 연대 책임으로 전원에게 벌을 준다. 알겠나!!"
 },
 {
  "key": "m22",
  "kind": 5,
  "chr": 39,
  "jh": "7aa6518280ca",
  "ko": "서! 예스 서!"
 },
